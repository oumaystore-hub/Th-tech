---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>اتصل بنا - Th.Tech | تواصل معنا</title>

  <meta
    name="description"
    content="تواصل مع فريق Th.Tech للاستفسارات والاقتراحات والإبلاغ عن الأخطاء وفرص التعاون. نحن سعداء بسماع أفكارك."
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href="https://oumaystore-hub.github.io/Th-tech/contact/"
  />
</head>

<body>

  <Header />

  <main class="contact-page">

    <div class="container">

      <!-- =====================================================
           PAGE HEADER
      ====================================================== -->

      <div class="page-header">

        <div class="page-badge">
          <span class="badge-icon">✉</span>
          <span>تواصل مع Th-Tech</span>
        </div>

        <h1>اتصل بنا</h1>

        <p>
          لديك سؤال، اقتراح، ملاحظة أو فكرة للتعاون؟
          أرسل لنا رسالتك وسنكون سعداء بالتواصل معك.
        </p>

      </div>


      <!-- =====================================================
           CONTACT GRID
      ====================================================== -->

      <div class="contact-grid">


        <!-- =================================================
             CONTACT INFORMATION
        ================================================== -->

        <div class="contact-info">


          <!-- EMAIL -->

          <div class="info-card">

            <div class="icon email-icon">
              ✉
            </div>

            <h3>البريد الإلكتروني</h3>

            <a
              href="mailto:thtech.tech@gmail.com"
              class="main-contact-link"
            >
              thtech.tech@gmail.com
            </a>

            <p>
              للاستفسارات والاقتراحات والتعاون
            </p>

          </div>


          <!-- WEBSITE -->

          <div class="info-card">

            <div class="icon website-icon">
              🌐
            </div>

            <h3>الموقع الإلكتروني</h3>

            <a
              href="/Th-tech/"
              class="main-contact-link"
            >
              Th-Tech
            </a>

            <p>
              أدوات تقنية ومحتوى معرفي متاح على مدار الساعة
            </p>

          </div>


          <!-- SOCIAL -->

          <div class="info-card">

            <div class="icon social-icon">
              🔗
            </div>

            <h3>تابعنا على منصات التواصل</h3>

            <div class="social-links">

              <!-- X -->

              <a
                href="https://x.com/thtechma"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Th-Tech على X"
              >
                X
              </a>


              <!-- Facebook -->

              <a
                href="https://www.facebook.com/share/1PzewvX774/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Th-Tech على Facebook"
              >
                Facebook
              </a>


              <!-- Instagram -->

              <a
                href="https://www.instagram.com/thtech.ma"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Th-Tech على Instagram"
              >
                Instagram
              </a>


              <!-- LinkedIn -->

              <a
                href="https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438?utm_source=share_via&utm_content=profile&utm_medium=member_android"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Th-Tech على LinkedIn"
              >
                LinkedIn
              </a>


              <!-- YouTube -->

              <a
                href="https://www.youtube.com/@thtechma"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Th-Tech على YouTube"
              >
                YouTube
              </a>

            </div>

          </div>


          <!-- RESPONSE INFO -->

          <div class="response-card">

            <div class="response-icon">
              ✓
            </div>

            <div>

              <strong>نحن نقدر تواصلك معنا</strong>

              <p>
                نسعى للرد على الرسائل والاستفسارات
                في أقرب وقت ممكن.
              </p>

            </div>

          </div>

        </div>


        <!-- =================================================
             CONTACT FORM
        ================================================== -->

        <div class="contact-form-wrapper">

          <div class="form-header">

            <span class="form-icon">
              📝
            </span>

            <div>

              <h2>أرسل لنا رسالة</h2>

              <p>
                املأ النموذج التالي وسنتواصل معك.
              </p>

            </div>

          </div>


          <form
            class="contact-form"
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
          >

            <!-- NAME -->

            <div class="form-group">

              <label for="name">
                الاسم الكامل
                <span>*</span>
              </label>

              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="محمد أحمد"
              />

            </div>


            <!-- EMAIL -->

            <div class="form-group">

              <label for="email">
                البريد الإلكتروني
                <span>*</span>
              </label>

              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="example@email.com"
              />

            </div>


            <!-- SUBJECT -->

            <div class="form-group">

              <label for="subject">
                الموضوع
                <span>*</span>
              </label>

              <select
                id="subject"
                name="subject"
                required
              >

                <option value="">
                  اختر الموضوع...
                </option>

                <option value="general">
                  استفسار عام
                </option>

                <option value="suggestion">
                  اقتراح محتوى
                </option>

                <option value="error">
                  الإبلاغ عن خطأ
                </option>

                <option value="collaboration">
                  تعاون
                </option>

                <option value="tools">
                  اقتراح أداة
                </option>

                <option value="other">
                  أخرى
                </option>

              </select>

            </div>


            <!-- MESSAGE -->

            <div class="form-group">

              <label for="message">
                الرسالة
                <span>*</span>
              </label>

              <textarea
                id="message"
                name="message"
                rows="7"
                required
                placeholder="اكتب رسالتك هنا..."
              ></textarea>

            </div>


            <!-- HIDDEN SUBJECT -->

            <input
              type="hidden"
              name="_subject"
              value="رسالة جديدة من موقع Th-Tech"
            />


            <!-- SUBMIT -->

            <button
              type="submit"
              class="submit-btn"
            >

              <span>
                إرسال الرسالة
              </span>

              <span class="arrow">
                ←
              </span>

            </button>

            <p class="form-note">
              🔒 لن يتم استخدام بياناتك إلا لمعالجة رسالتك والتواصل معك.
            </p>

          </form>

        </div>

      </div>

    </div>

  </main>

  <Footer />

</body>
</html>


<style>

/* =====================================================
   VARIABLES
===================================================== */

:root {

  --bg: #f8fafc;
  --card: #ffffff;

  --text: #0f172a;
  --text-sec: #64748b;

  --primary: #0284c7;
  --primary-light: #38bdf8;

  --border: rgba(2,132,199,0.2);

  --shadow: rgba(0,0,0,0.08);

}


/* =====================================================
   DARK MODE
===================================================== */

html.dark-mode {

  --bg: #0b1120;
  --card: #1e293b;

  --text: #f1f5f9;
  --text-sec: #94a3b8;

  --primary: #38bdf8;
  --primary-light: #0ea5e9;

  --border: rgba(56,189,248,0.2);

  --shadow: rgba(0,0,0,0.3);

}


/* =====================================================
   BODY
===================================================== */

body {

  margin: 0;

  background: var(--bg);

  color: var(--text);

  font-family:
    "Cairo",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

}


/* =====================================================
   PAGE
===================================================== */

.contact-page {

  min-height: 70vh;

  max-width: 1200px;

  margin: 0 auto;

  padding:
    4.5rem 1.5rem
    6rem;

}


/* =====================================================
   PAGE HEADER
===================================================== */

.page-header {

  text-align: center;

  max-width: 780px;

  margin:
    0 auto
    3.5rem;

}


.page-badge {

  display: inline-flex;

  align-items: center;

  gap: 0.5rem;

  padding:
    0.45rem
    0.9rem;

  border-radius: 999px;

  background:
    rgba(2,132,199,0.08);

  border:
    1px solid var(--border);

  color: var(--primary);

  font-size: 0.85rem;

  font-weight: 700;

  margin-bottom: 1rem;

}


.badge-icon {

  font-size: 1rem;

}


.page-header h1 {

  margin: 0 0 1rem;

  font-size: clamp(
    2rem,
    5vw,
    3rem
  );

  line-height: 1.2;

  color: var(--text);

  font-weight: 800;

}


.page-header h1::after {

  content: "";

  display: block;

  width: 70px;

  height: 4px;

  margin:
    1rem auto
    0;

  border-radius: 10px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--primary-light)
    );

}


.page-header p {

  margin: 0;

  color: var(--text-sec);

  font-size: 1.05rem;

  line-height: 1.9;

}


/* =====================================================
   GRID
===================================================== */

.contact-grid {

  display: grid;

  grid-template-columns:
    0.9fr
    1.5fr;

  gap: 2.5rem;

  align-items: start;

}


/* =====================================================
   INFO CARDS
===================================================== */

.info-card {

  background: var(--card);

  border:
    1px solid var(--border);

  border-radius: 18px;

  padding: 1.7rem;

  text-align: center;

  margin-bottom: 1.2rem;

  box-shadow:
    0 8px 25px var(--shadow);

  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;

}


.info-card:hover {

  transform:
    translateY(-5px);

  border-color:
    var(--primary);

  box-shadow:
    0 14px 30px
    rgba(2,132,199,0.12);

}


.info-card .icon {

  width: 60px;

  height: 60px;

  margin:
    0 auto
    1rem;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      rgba(2,132,199,0.12),
      rgba(56,189,248,0.08)
    );

  font-size: 1.8rem;

}


.info-card h3 {

  margin:
    0 0 0.8rem;

  color: var(--primary);

  font-size: 1.1rem;

  font-weight: 800;

}


.main-contact-link {

  display: inline-block;

  color: var(--text);

  text-decoration: none;

  font-weight: 700;

  direction: ltr;

  font-size: 0.95rem;

  transition:
    color 0.3s ease;

}


.main-contact-link:hover {

  color: var(--primary);

}


.info-card p {

  margin:
    0.6rem 0 0;

  color: var(--text-sec);

  font-size: 0.85rem;

  line-height: 1.7;

}


/* =====================================================
   SOCIAL LINKS
===================================================== */

.social-links {

  display: flex;

  align-items: center;

  justify-content: center;

  flex-wrap: wrap;

  gap: 0.55rem;

}


.social-links a {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 38px;

  padding:
    0.45rem
    0.75rem;

  border:
    1px solid var(--border);

  border-radius: 9px;

  background: var(--bg);

  color: var(--text);

  text-decoration: none;

  font-size: 0.8rem;

  font-weight: 700;

  transition:
    all 0.3s ease;

}


.social-links a:hover {

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-light)
    );

  border-color:
    transparent;

  color: white;

  transform:
    translateY(-2px);

}


/* =====================================================
   RESPONSE CARD
===================================================== */

.response-card {

  display: flex;

  align-items: center;

  gap: 0.9rem;

  padding: 1.1rem 1.2rem;

  border-radius: 15px;

  background:
    rgba(34,197,94,0.07);

  border:
    1px solid
    rgba(34,197,94,0.2);

}


.response-icon {

  width: 40px;

  height: 40px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    rgba(34,197,94,0.12);

  color: #16a34a;

  font-weight: 900;

}


.response-card strong {

  display: block;

  margin-bottom: 0.2rem;

  color: var(--text);

  font-size: 0.9rem;

}


.response-card p {

  margin: 0;

  color: var(--text-sec);

  font-size: 0.78rem;

  line-height: 1.6;

}


/* =====================================================
   FORM WRAPPER
===================================================== */

.contact-form-wrapper {

  background: var(--card);

  border:
    1px solid var(--border);

  border-radius: 20px;

  padding: 2.3rem;

  box-shadow:
    0 10px 35px var(--shadow);

}


/* =====================================================
   FORM HEADER
===================================================== */

.form-header {

  display: flex;

  align-items: center;

  gap: 1rem;

  margin-bottom: 2rem;

  padding-bottom: 1.3rem;

  border-bottom:
    1px solid var(--border);

}


.form-icon {

  width: 50px;

  height: 50px;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-light)
    );

  color: white;

  font-size: 1.4rem;

}


.form-header h2 {

  margin: 0 0 0.2rem;

  color: var(--text);

  font-size: 1.35rem;

  font-weight: 800;

}


.form-header p {

  margin: 0;

  color: var(--text-sec);

  font-size: 0.85rem;

}


/* =====================================================
   FORM
===================================================== */

.form-group {

  margin-bottom: 1.35rem;

}


.form-group label {

  display: block;

  margin-bottom: 0.55rem;

  color: var(--text);

  font-size: 0.9rem;

  font-weight: 700;

}


.form-group label span {

  color: #ef4444;

}


.form-group input,
.form-group select,
.form-group textarea {

  width: 100%;

  padding:
    0.9rem
    1rem;

  border:
    1.5px solid var(--border);

  border-radius: 11px;

  background: var(--bg);

  color: var(--text);

  font-family: inherit;

  font-size: 0.95rem;

  outline: none;

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;

}


.form-group input::placeholder,
.form-group textarea::placeholder {

  color: var(--text-sec);

  opacity: 0.75;

}


.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {

  border-color:
    var(--primary);

  box-shadow:
    0 0 0 4px
    rgba(2,132,199,0.09);

}


.form-group textarea {

  resize: vertical;

  min-height: 150px;

  line-height: 1.8;

}


.form-group select {

  cursor: pointer;

}


/* =====================================================
   SUBMIT BUTTON
===================================================== */

.submit-btn {

  width: 100%;

  min-height: 55px;

  padding:
    0.9rem
    1.2rem;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 0.8rem;

  border: none;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-light)
    );

  color: white;

  font-family: inherit;

  font-size: 1rem;

  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 7px 20px
    rgba(2,132,199,0.22);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;

}


.submit-btn:hover {

  transform:
    translateY(-3px);

  box-shadow:
    0 12px 28px
    rgba(2,132,199,0.3);

}


.submit-btn:active {

  transform:
    translateY(-1px);

}


.submit-btn .arrow {

  font-size: 1.3rem;

  transition:
    transform 0.3s ease;

}


.submit-btn:hover .arrow {

  transform:
    translateX(-5px);

}


/* =====================================================
   FORM NOTE
===================================================== */

.form-note {

  margin:
    1rem 0 0;

  text-align: center;

  color: var(--text-sec);

  font-size: 0.75rem;

  line-height: 1.7;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 900px) {

  .contact-grid {

    grid-template-columns: 1fr;

    gap: 1.8rem;

  }

  .contact-info {

    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 1rem;

  }

  .info-card {

    margin-bottom: 0;

  }

  .response-card {

    grid-column:
      1 / -1;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  .contact-page {

    padding:
      3rem 1rem
      4rem;

  }

  .page-header {

    margin-bottom: 2.3rem;

  }

  .page-header h1 {

    font-size: 2rem;

  }

  .page-header p {

    font-size: 0.92rem;

  }

  .contact-info {

    grid-template-columns: 1fr;

  }

  .contact-form-wrapper {

    padding:
      1.3rem;

    border-radius: 16px;

  }

  .form-header {

    align-items: flex-start;

  }

  .form-header h2 {

    font-size: 1.15rem;

  }

  .social-links {

    gap: 0.4rem;

  }

  .social-links a {

    font-size: 0.75rem;

    padding:
      0.4rem 0.6rem;

  }

}


/* =====================================================
   VERY SMALL SCREENS
===================================================== */

@media (max-width: 380px) {

  .contact-page {

    padding-left: 0.8rem;

    padding-right: 0.8rem;

  }

  .contact-form-wrapper {

    padding:
      1rem;

  }

  .page-header h1 {

    font-size: 1.8rem;

  }

  .info-card {

    padding:
      1.3rem;

  }

}

</style>
