  <!-- ✅ كود التتبع الذكي (30 ثانية أو 70% تمرير) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const TRACK_TIME = 30;
      const SCROLL_THRESHOLD = 0.7;
      const currentPath = window.location.pathname;
      let isMarked = false;

      console.log('🔍 Tracking:', currentPath);

      function markAsRead() {
        if (isMarked) return;
        const readArticles = JSON.parse(localStorage.getItem('read_articles') || '[]');
        if (!readArticles.includes(currentPath)) {
          readArticles.push(currentPath);
          localStorage.setItem('read_articles', JSON.stringify(readArticles));
          console.log('✅ Marked:', currentPath);
        }
        isMarked = true;
      }

      if (JSON.parse(localStorage.getItem('read_articles') || '[]').includes(currentPath)) {
        console.log('ℹ️ Already read');
        return;
      }

      const timeTimer = setTimeout(markAsRead, TRACK_TIME * 1000);

      const checkScroll = () => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;
        const docHeight = Math.max(
          document.body.scrollHeight, document.documentElement.scrollHeight,
          document.body.offsetHeight, document.documentElement.offsetHeight
        );
        const scrollPercent = (scrollTop + windowHeight) / docHeight;
        
        if (scrollPercent >= SCROLL_THRESHOLD) {
          console.log(`📜 Scroll reached ${Math.round(scrollPercent*100)}%`);
          markAsRead();
          clearTimeout(timeTimer);
          window.removeEventListener('scroll', checkScroll, { passive: true });
        }
      };
      
      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();

      window.addEventListener('beforeunload', () => {
        clearTimeout(timeTimer);
        window.removeEventListener('scroll', checkScroll);
      });
    });
  </script>
</body>
