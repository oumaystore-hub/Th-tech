  <script is:inline>
    if (typeof window !== 'undefined') {
      window.addEventListener('DOMContentLoaded', function() {
        var TRACK_TIME = 30;
        var SCROLL_THRESHOLD = 0.7;
        var currentPath = window.location.pathname;
        var isMarked = false;

        console.log('🔍 Tracking:', currentPath);

        function markAsRead() {
          if (isMarked) return;
          try {
            var readArticles = JSON.parse(localStorage.getItem('read_articles') || '[]');
            if (!readArticles.includes(currentPath)) {
              readArticles.push(currentPath);
              localStorage.setItem('read_articles', JSON.stringify(readArticles));
              console.log('✅ Marked:', currentPath);
            }
            isMarked = true;
          } catch (e) { console.error('Tracking error:', e); }
        }

        try {
          var alreadyRead = JSON.parse(localStorage.getItem('read_articles') || '[]').includes(currentPath);
          if (alreadyRead) { console.log('ℹ️ Already read'); return; }
        } catch (e) {}

        var timeTimer = setTimeout(markAsRead, TRACK_TIME * 1000);

        function checkScroll() {
          try {
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            var windowHeight = window.innerHeight || document.documentElement.clientHeight;
            var docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
            var scrollPercent = (scrollTop + windowHeight) / docHeight;
            if (scrollPercent >= SCROLL_THRESHOLD) {
              console.log(' Scroll reached ' + Math.round(scrollPercent*100) + '%');
              markAsRead();
              clearTimeout(timeTimer);
              window.removeEventListener('scroll', checkScroll, { passive: true });
            }
          } catch (e) {}
        }
        
        window.addEventListener('scroll', checkScroll, { passive: true });
        checkScroll();

        window.addEventListener('beforeunload', function() {
          clearTimeout(timeTimer);
          window.removeEventListener('scroll', checkScroll);
        });

        // وقت القراءة
        setTimeout(function() {
          try {
            var timeElement = document.getElementById('calculatedReadingTime');
            var displayElement = document.getElementById('readingTimeDisplay');
            if (timeElement && displayElement) {
              var minutes = parseInt(timeElement.textContent);
              if (minutes < 1) displayElement.textContent = '⏱️ أقل من دقيقة';
              else if (minutes === 1) displayElement.textContent = '⏱️ دقيقة واحدة';
              else displayElement.textContent = '️ ' + minutes + ' دقائق';
            }
          } catch (e) {}
        }, 100);

        // الفهرس
        var tocBtn = document.getElementById('tocBtn');
        var tocModal = document.getElementById('tocModal');
        var tocClose = document.getElementById('tocClose');
        var tocNav = document.getElementById('tocNav');
        if (tocBtn && tocModal && tocNav) {
          var h3Elements = document.querySelectorAll('.article h3');
          h3Elements.forEach(function(h3) {
            var item = document.createElement('div');
            item.className = 'toc-item';
            item.textContent = h3.textContent;
            item.onclick = function(e) {
              e.preventDefault();
              h3.scrollIntoView({ behavior: 'smooth' });
              tocModal.classList.remove('active');
            };
            tocNav.appendChild(item);
          });
          tocBtn.onclick = function() { tocModal.classList.add('active'); };
          tocClose.onclick = function() { tocModal.classList.remove('active'); };
          tocModal.onclick = function(e) { if (e.target === tocModal) tocModal.classList.remove('active'); };
        }

        // العودة للأعلى
        var backBtn = document.getElementById('backToTop');
        if (backBtn) {
          window.addEventListener('scroll', function() {
            if (window.scrollY > 400) backBtn.classList.add('show');
            else backBtn.classList.remove('show');
          }, { passive: true });
          backBtn.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
        }
      });
    }
  </script>
