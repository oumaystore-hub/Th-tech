---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | محرر الأكواد الاحترافي</title>

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

      <div class="hero-text">

        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          TH.TECH
          <span>•</span>
          DEVELOPER TOOLS
        </div>

        <h1>
          محرر الأكواد
          <span>الاحترافي</span>
        </h1>

        <p>
          اكتب الكود، اختبره وشاهد النتيجة مباشرة من المتصفح.
        </p>

      </div>

      <div class="hero-actions">

        <div class="language-select-wrapper">

          <i id="languageSelectIcon" class="fab fa-python select-icon"></i>

          <select id="language" aria-label="اختيار لغة البرمجة">

            <option value="python">Python</option>
            <option value="javascript">JavaScript</option>
            <option value="html">HTML / CSS</option>
            <option value="java">Java</option>
            <option value="cpp">C++</option>
            <option value="csharp">C#</option>
            <option value="go">Go</option>
            <option value="ruby">Ruby</option>
            <option value="php">PHP</option>
            <option value="sql">SQL</option>
            <option value="typescript">TypeScript</option>

          </select>

          <i class="fas fa-chevron-down select-arrow"></i>

        </div>

      </div>

    </section>


    <!-- =====================================================
         WORKSPACE
    ====================================================== -->

    <section class="workspace" id="workspace">

      <!-- TOP BAR -->

      <div class="topbar">

        <div class="file-tab">

          <span id="fileIcon" class="file-icon">
            <i class="fab fa-python"></i>
          </span>

          <span id="fileName">main.py</span>

          <span id="dirty" class="dirty" title="تغييرات غير محفوظة">
            <i class="fas fa-circle"></i>
          </span>

          <span id="savedLabel" class="saved-label">
            <i class="fas fa-check"></i>
            محفوظ
          </span>

        </div>


        <div class="actions">

          <button
            id="search"
            class="tool-button"
            title="بحث داخل الكود"
            aria-label="بحث داخل الكود"
          >
            <i class="fas fa-magnifying-glass"></i>
          </button>


          <button
            id="copy"
            class="tool-button"
            title="نسخ الكود"
            aria-label="نسخ الكود"
          >
            <i class="far fa-copy"></i>
          </button>


          <button
            id="save"
            class="tool-button"
            title="حفظ الكود"
            aria-label="حفظ الكود"
          >
            <i class="far fa-floppy-disk"></i>
          </button>


          <button
            id="download"
            class="tool-button"
            title="تنزيل الملف"
            aria-label="تنزيل الملف"
          >
            <i class="fas fa-download"></i>
          </button>


          <button
            id="fontDown"
            class="tool-button font-button"
            title="تصغير حجم الخط"
            aria-label="تصغير حجم الخط"
          >
            <i class="fas fa-font"></i>
            <span>−</span>
          </button>


          <button
            id="fontUp"
            class="tool-button font-button"
            title="تكبير حجم الخط"
            aria-label="تكبير حجم الخط"
          >
            <i class="fas fa-font"></i>
            <span>+</span>
          </button>


          <button
            id="fullscreen"
            class="tool-button"
            title="ملء الشاشة"
            aria-label="ملء الشاشة"
          >
            <i class="fas fa-expand"></i>
          </button>


          <button
            id="reset"
            class="tool-button"
            title="إعادة تعيين الكود"
            aria-label="إعادة تعيين الكود"
          >
            <i class="fas fa-rotate-right"></i>
          </button>


          <button
            id="run"
            class="run"
            title="تشغيل الكود - Ctrl + Enter"
          >
            <i class="fas fa-play"></i>
            <span>تشغيل</span>
          </button>

        </div>

      </div>


      <!-- SEARCH -->

      <div id="searchBar" class="search-bar">

        <div class="search-icon">
          <i class="fas fa-magnifying-glass"></i>
        </div>

        <input
          id="searchInput"
          placeholder="ابحث داخل الكود..."
          autocomplete="off"
        />

        <span id="searchResult">0 نتيجة</span>

        <button id="closeSearch" title="إغلاق البحث" aria-label="إغلاق البحث">
          <i class="fas fa-xmark"></i>
        </button>

      </div>


      <!-- WORKSPACE BODY -->

      <div class="workspace-body">


        <!-- =================================================
             EDITOR
        ================================================== -->

        <div class="editor-panel">

          <div class="editor-head">

            <div class="editor-title">

              <span class="editor-status-dot"></span>

              <span>EDITOR</span>

            </div>

            <div class="language-badge">

              <span id="languageBadge">
                Python
              </span>

            </div>

          </div>


          <div class="editor">

            <div
              id="numbers"
              class="numbers"
              aria-hidden="true"
            >
              1
            </div>


            <textarea
              id="code"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="// اكتب الكود هنا..."
            ></textarea>

          </div>


          <!-- STATUS BAR -->

          <div class="status">

            <span id="cursor">
              Ln 1, Col 1
            </span>

            <span id="stats">
              1 line • 0 chars
            </span>

            <span>
              UTF-8
            </span>

            <span>
              Spaces: 4
            </span>

          </div>

        </div>


        <!-- =================================================
             OUTPUT
        ================================================== -->

        <div class="output-panel">

          <div class="output-head">

            <div class="output-tabs">

              <button
                class="active"
                id="consoleTab"
              >
                <i class="fas fa-terminal"></i>
                TERMINAL
              </button>

              <button id="previewTab">
                <i class="fas fa-display"></i>
                PREVIEW
              </button>

            </div>


            <button
              id="clear"
              class="clear"
              title="مسح النتائج"
            >
              <i class="fas fa-trash-can"></i>
              <span>مسح</span>
            </button>

          </div>


          <div id="output" class="output">

            <div class="welcome-terminal">

              <div class="terminal-logo">

                <i class="fas fa-terminal"></i>

              </div>

              <h3>
                Th.Tech Terminal
              </h3>

              <p>
                اضغط تشغيل لتنفيذ الكود
              </p>

              <small>
                <kbd>Ctrl</kbd>
                +
                <kbd>Enter</kbd>
              </small>

            </div>

          </div>


          <div id="preview" class="preview"></div>

        </div>

      </div>


      <!-- =================================================
           PYTHON INPUT
      ================================================== -->

      <div
        id="inputArea"
        class="input-area"
      >

        <div class="input-title">

          <div>

            <strong>
              <i class="fas fa-keyboard"></i>
              Input
            </strong>

            <span>
              قيم input() — كل قيمة في سطر
            </span>

          </div>

          <span class="input-badge">
            Python
          </span>

        </div>


        <textarea
          id="input"
          placeholder="مثال:
Ahmed
25"
        ></textarea>

      </div>

    </section>


    <!-- =====================================================
         FEATURES
    ====================================================== -->

    <section class="info">

      <div class="info-card">

        <span class="info-icon">
          <i class="fas fa-bolt"></i>
        </span>

        <div>
          <strong>تشغيل سريع</strong>
          <p>نتائج مباشرة داخل المتصفح</p>
        </div>

      </div>


      <div class="info-card">

        <span class="info-icon">
          <i class="fas fa-floppy-disk"></i>
        </span>

        <div>
          <strong>حفظ تلقائي</strong>
          <p>الكود محفوظ على جهازك</p>
        </div>

      </div>


      <div class="info-card">

        <span class="info-icon">
          <i class="fas fa-mobile-screen-button"></i>
        </span>

        <div>
          <strong>متجاوب</strong>
          <p>مصمم للهاتف والكمبيوتر</p>
        </div>

      </div>


      <div class="info-card">

        <span class="info-icon">
          <i class="fas fa-shield-halved"></i>
        </span>

        <div>
          <strong>محلي</strong>
          <p>التنفيذ يتم داخل المتصفح</p>
        </div>

      </div>

    </section>

  </main>


  <Footer />


<style>

/* =========================================================
   THEME SYSTEM
========================================================= */

:root {

  --bg: #080c12;
  --panel: #0d131b;
  --panel2: #111923;
  --bar: #151e29;

  --editor-bg: #080c11;
  --editor-numbers: #070b10;

  --input-bg: #0a1017;
  --status-bg: #0d141c;

  --border: #202c39;
  --border-soft: #2b3a49;

  --text: #e6edf3;
  --text-soft: #c5d0da;

  --muted: #7d8b99;
  --muted-dark: #536271;

  --blue: #38a8ff;
  --blue2: #168bd0;

  --green: #3fb950;
  --red: #f85149;
  --warning: #d29922;

  --shadow:
    0 25px 80px rgba(0,0,0,.35);

  --code: 15px;

  color-scheme: dark;
}


/* LIGHT */

html[data-theme="light"],
body.light,
body.light-mode,
.light-theme {

  --bg: #f5f8fb;
  --panel: #ffffff;
  --panel2: #f1f5f9;
  --bar: #edf2f7;

  --editor-bg: #fbfdff;
  --editor-numbers: #f1f5f9;

  --input-bg: #f7f9fc;
  --status-bg: #edf2f7;

  --border: #d9e2ea;
  --border-soft: #c8d4df;

  --text: #17212b;
  --text-soft: #334454;

  --muted: #667788;
  --muted-dark: #8795a3;

  --blue: #087fc5;
  --blue2: #087fc5;

  --green: #16883a;
  --red: #d92d27;
  --warning: #9a6700;

  --shadow:
    0 20px 60px rgba(31,55,75,.12);

  color-scheme: light;
}


/* =========================================================
   GLOBAL
========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  background: var(--bg);
  transition:
    background-color .25s ease,
    color .25s ease;
}

body {
  min-height: 100vh;

  font-family: 'Cairo', sans-serif;

  line-height: 1.6;

  background: var(--bg);
  color: var(--text);

  transition:
    background-color .25s ease,
    color .25s ease;
}

.page {
  width: min(1400px, calc(100% - 30px));

  margin: auto;

  padding:
    45px 0 70px;

  background: var(--bg);
}


/* =========================================================
   HERO
========================================================= */

.hero {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 25px;

  margin-bottom: 25px;
}

.hero-text {
  min-width: 0;
}

.eyebrow {

  display: flex;

  align-items: center;

  gap: 7px;

  color: var(--blue);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 1.5px;

  margin-bottom: 8px;
}

.eyebrow-dot {

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--blue);

  box-shadow:
    0 0 12px rgba(56,168,255,.55);
}

.hero h1 {

  color: var(--text);

  font-size:
    clamp(28px, 4vw, 46px);

  line-height: 1.2;

  font-weight: 800;
}

.hero h1 span {
  color: var(--blue);
}

.hero p {

  margin-top: 10px;

  color: var(--muted);

  font-size: 15px;
}


/* =========================================================
   LANGUAGE SELECT
========================================================= */

.hero-actions {
  display: flex;
  gap: 8px;
}

.language-select-wrapper {

  position: relative;

  display: flex;

  align-items: center;

  width: 205px;

  height: 46px;

  border:
    1px solid var(--border);

  border-radius: 10px;

  background: var(--panel);

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.language-select-wrapper:hover {

  border-color: var(--blue);

  box-shadow:
    0 0 0 3px rgba(56,168,255,.07);
}

.select-icon {

  position: absolute;

  right: 13px;

  color: var(--blue);

  font-size: 17px;

  pointer-events: none;

  z-index: 2;
}

.language-select-wrapper select {

  appearance: none;

  width: 100%;
  height: 100%;

  border: 0;
  outline: 0;

  padding:
    0 42px 0 38px;

  background: transparent;

  color: var(--text);

  font-family: inherit;

  font-size: 13px;

  font-weight: 700;

  cursor: pointer;
}

.language-select-wrapper option {
  background: var(--panel);
  color: var(--text);
}

.select-arrow {

  position: absolute;

  left: 13px;

  color: var(--muted);

  font-size: 10px;

  pointer-events: none;
}


/* =========================================================
   WORKSPACE
========================================================= */

.workspace {

  position: relative;

  background: var(--panel);

  border:
    1px solid var(--border);

  border-radius: 14px;

  overflow: hidden;

  box-shadow: var(--shadow);

  transition:
    background-color .25s ease,
    border-color .25s ease,
    box-shadow .25s ease;
}


/* =========================================================
   TOPBAR
========================================================= */

.topbar {

  min-height: 58px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  background: var(--bar);

  border-bottom:
    1px solid var(--border);

  padding:
    0 12px;

  gap: 10px;
}

.file-tab {

  height: 58px;

  display: flex;

  align-items: center;

  gap: 9px;

  padding:
    0 15px;

  border-right:
    1px solid var(--border);

  font-family:
    'Fira Code',
    monospace;

  font-size: 13px;

  color: var(--text);

  white-space: nowrap;
}

.file-icon {

  width: 24px;

  display: inline-flex;

  align-items: center;

  justify-content: center;
}

.file-icon i {
  color: var(--blue);
  font-size: 18px;
}

.dirty {

  color: var(--blue);

  font-size: 7px;

  transition: opacity .2s ease;
}

.saved-label {

  display: none;

  align-items: center;

  gap: 5px;

  color: var(--green);

  font-family: Cairo, sans-serif;

  font-size: 9px;

  font-weight: 600;
}

.saved-label i {
  font-size: 9px;
}


/* =========================================================
   ACTIONS
========================================================= */

.actions {

  display: flex;

  align-items: center;

  gap: 5px;

  min-width: 0;
}

.actions button {

  position: relative;

  height: 36px;

  min-width: 36px;

  padding:
    0 9px;

  border:
    1px solid var(--border);

  border-radius: 7px;

  background: transparent;

  color: var(--muted);

  cursor: pointer;

  font-family: inherit;

  font-size: 12px;

  transition:
    color .2s ease,
    border-color .2s ease,
    background .2s ease,
    transform .15s ease;
}

.actions button i {
  font-size: 13px;
}

.actions button:hover {

  color: var(--text);

  border-color:
    var(--border-soft);

  background:
    rgba(128,128,128,.08);

  transform:
    translateY(-1px);
}

.actions button:active {
  transform: translateY(0);
}

.actions button:focus-visible {

  outline:
    2px solid var(--blue);

  outline-offset: 2px;
}

.actions .run {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding:
    0 18px;

  border: 0;

  background:
    var(--blue2);

  color: white;

  font-weight: 700;

  box-shadow:
    0 5px 18px rgba(22,139,208,.22);
}

.actions .run:hover {

  background:
    var(--blue);

  color: white;

  border-color: transparent;

  box-shadow:
    0 7px 22px rgba(22,139,208,.30);
}

.actions .run:disabled {

  opacity: .6;

  cursor: not-allowed;

  transform: none;
}

.font-button {

  display: flex;

  align-items: center;

  gap: 4px;
}

.font-button span {
  font-weight: 800;
}


/* =========================================================
   SEARCH
========================================================= */

.search-bar {

  display: none;

  height: 50px;

  align-items: center;

  gap: 10px;

  padding:
    7px 12px;

  background:
    var(--input-bg);

  border-bottom:
    1px solid var(--border);
}

.search-bar.show {
  display: flex;
}

.search-icon {

  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;

  justify-content: center;

  color: var(--blue);
}

.search-bar input {

  flex: 1;

  min-width: 0;

  height: 35px;

  border:
    1px solid var(--border);

  border-radius: 7px;

  background:
    var(--panel);

  color:
    var(--text);

  padding:
    0 12px;

  outline: none;

  font-family: inherit;

  font-size: 12px;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.search-bar input:focus {

  border-color:
    var(--blue);

  box-shadow:
    0 0 0 3px rgba(56,168,255,.07);
}

.search-bar input::placeholder {
  color: var(--muted);
}

.search-bar span {

  color: var(--muted);

  font-size: 11px;

  white-space: nowrap;
}

.search-bar button {

  width: 32px;
  height: 32px;

  border: 0;

  background: transparent;

  color: var(--muted);

  cursor: pointer;

  border-radius: 6px;
}

.search-bar button:hover {

  background:
    rgba(128,128,128,.08);

  color:
    var(--red);
}


/* =========================================================
   WORKSPACE BODY
========================================================= */

.workspace-body {

  display: grid;

  grid-template-columns:
    1.15fr .85fr;

  min-height: 600px;
}

.editor-panel {

  min-width: 0;

  border-left:
    1px solid var(--border);
}

.output-panel {

  min-width: 0;

  background:
    var(--editor-bg);
}


/* =========================================================
   EDITOR HEADER / OUTPUT HEADER
========================================================= */

.editor-head,
.output-head {

  height: 43px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding:
    0 14px;

  background:
    var(--panel2);

  border-bottom:
    1px solid var(--border);

  color:
    var(--muted);

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .7px;
}

.editor-title {

  display: flex;

  align-items: center;

  gap: 8px;
}

.editor-status-dot {

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background:
    var(--green);

  box-shadow:
    0 0 9px rgba(63,185,80,.35);
}

.language-badge {

  padding:
    3px 8px;

  border:
    1px solid rgba(56,168,255,.15);

  border-radius: 5px;

  background:
    rgba(56,168,255,.07);

  color:
    var(--blue);

  font-size: 10px;

  letter-spacing: 0;
}


/* =========================================================
   EDITOR
========================================================= */

.editor {

  display: flex;

  height: 550px;

  background:
    var(--editor-bg);

  direction: ltr;
}

.numbers {

  width: 55px;

  flex: none;

  padding:
    18px 12px;

  background:
    var(--editor-numbers);

  border-right:
    1px solid var(--border);

  color:
    var(--muted-dark);

  font:
    var(--code) / 1.75
    'Fira Code',
    monospace;

  text-align: right;

  overflow: hidden;

  user-select: none;
}

#code {

  flex: 1;

  width: 100%;
  height: 100%;

  resize: none;

  border: 0;

  outline: 0;

  padding:
    18px;

  background:
    var(--editor-bg);

  color:
    var(--text);

  font:
    var(--code) / 1.75
    'Fira Code',
    monospace;

  white-space: pre;

  overflow: auto;

  tab-size: 4;

  transition:
    background-color .25s ease,
    color .25s ease;
}

#code::placeholder {
  color: var(--muted-dark);
}

#code::selection {
  background:
    rgba(56,168,255,.25);
}


/* =========================================================
   OUTPUT
========================================================= */

.output-tabs {

  display: flex;

  align-items: center;

  gap: 18px;

  height: 100%;
}

.output-tabs button {

  height: 43px;

  border: 0;

  background: transparent;

  color: var(--muted);

  cursor: pointer;

  font-family: inherit;

  font-size: 10px;

  font-weight: 700;

  display: flex;

  align-items: center;

  gap: 6px;

  position: relative;
}

.output-tabs button i {
  font-size: 10px;
}

.output-tabs button.active {

  color:
    var(--blue);
}

.output-tabs button.active::after {

  content: "";

  position: absolute;

  bottom: 0;

  right: 0;
  left: 0;

  height: 2px;

  background:
    var(--blue);

  border-radius:
    2px 2px 0 0;
}

.clear {

