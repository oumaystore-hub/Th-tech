---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | Code Playground</title>

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>

<body>

<Header />

<main class="page">

  <!-- TOP -->

  <section class="hero">

    <div class="hero-text">

      <div class="eyebrow">
        TH.TECH • DEVELOPER TOOLS
      </div>

      <h1>
        محرر الأكواد
        <span>الاحترافي</span>
      </h1>

      <p>
        اكتب الكود، اختبره وشاهد النتيجة مباشرة من المتصفح.
      </p>

    </div>

    <div class="hero-actions">

      <select id="language">

        <option value="python">
          🐍 Python
        </option>

        <option value="javascript">
          JS JavaScript
        </option>

        <option value="html">
          🌐 HTML / CSS
        </option>

      </select>

      <button id="themeButton" class="icon-button">
        ◐
      </button>

    </div>

  </section>


  <!-- WORKSPACE -->

  <section
    class="workspace"
    id="workspace"
  >

    <!-- TOP BAR -->

    <div class="topbar">

      <div class="file-tab">

        <span id="fileIcon">
          🐍
        </span>

        <span id="fileName">
          main.py
        </span>

        <span
          id="dirty"
          class="dirty"
        >
          ●
        </span>

      </div>


      <div class="actions">

        <button
          id="search"
          title="بحث"
        >
          🔎
        </button>

        <button
          id="copy"
          title="نسخ"
        >
          📋
        </button>

        <button
          id="save"
          title="حفظ"
        >
          💾
        </button>

        <button
          id="download"
          title="تنزيل"
        >
          ↓
        </button>

        <button
          id="fontDown"
          title="تصغير الخط"
        >
          A−
        </button>

        <button
          id="fontUp"
          title="تكبير الخط"
        >
          A+
        </button>

        <button
          id="fullscreen"
          title="ملء الشاشة"
        >
          ⛶
        </button>

        <button
          id="reset"
          title="إعادة"
        >
          ↻
        </button>

        <button
          id="run"
          class="run"
        >
          ▶ تشغيل
        </button>

      </div>

    </div>


    <!-- SEARCH -->

    <div
      id="searchBar"
      class="search-bar"
    >

      <input
        id="searchInput"
        placeholder="ابحث داخل الكود..."
      />

      <span id="searchResult">
        0 نتيجة
      </span>

      <button id="closeSearch">
        ×
      </button>

    </div>


    <!-- BODY -->

    <div class="workspace-body">

      <!-- EDITOR -->

      <div class="editor-panel">

        <div class="editor-head">

          <span>
            EDITOR
          </span>

          <span id="languageBadge">
            Python
          </span>

        </div>


        <div class="editor">

          <div
            id="numbers"
            class="numbers"
          >
            1
          </div>

          <textarea
            id="code"
            spellcheck="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
          ></textarea>

        </div>


        <!-- STATUS -->

        <div class="status">

          <span id="cursor">
            Ln 1, Col 1
          </span>

          <span id="stats">
            1 line • 0 chars
          </span>

          <span>
            UTF-8
          </span>

          <span>
            Spaces: 4
          </span>

        </div>

      </div>


      <!-- OUTPUT -->

      <div class="output-panel">

        <div class="output-head">

          <div class="output-tabs">

            <button
              class="active"
              id="consoleTab"
            >
              TERMINAL
            </button>

            <button
              id="previewTab"
            >
              PREVIEW
            </button>

          </div>

          <button
            id="clear"
            class="clear"
          >
            مسح
          </button>

        </div>


        <div
          id="output"
          class="output"
        >

          <div class="welcome-terminal">

            <div class="terminal-logo">
              &gt;_
            </div>

            <h3>
              Th.Tech Terminal
            </h3>

            <p>
              اضغط تشغيل لتنفيذ الكود
            </p>

            <small>
              Ctrl + Enter
            </small>

          </div>

        </div>


        <div
          id="preview"
          class="preview"
        ></div>

      </div>

    </div>


    <!-- PYTHON INPUT -->

    <div
      id="inputArea"
      class="input-area"
    >

      <div>

        <strong>
          Input
        </strong>

        <span>
          قيم input() — كل قيمة في سطر
        </span>

      </div>

      <textarea
        id="input"
        placeholder="مثال:
Ahmed
25"
      ></textarea>

    </div>

  </section>


  <!-- BOTTOM INFO -->

  <section class="info">

    <div>

      <span class="info-icon">
        ⚡
      </span>

      <div>
        <strong>تشغيل سريع</strong>
        <p>نتائج مباشرة داخل المتصفح</p>
      </div>

    </div>


    <div>

      <span class="info-icon">
        💾
      </span>

      <div>
        <strong>حفظ تلقائي</strong>
        <p>الكود محفوظ على جهازك</p>
      </div>

    </div>


    <div>

      <span class="info-icon">
        📱
      </span>

      <div>
        <strong>متجاوب</strong>
        <p>مصمم للهاتف والكمبيوتر</p>
      </div>

    </div>


    <div>

      <span class="info-icon">
        🔒
      </span>

      <div>
        <strong>محلي</strong>
        <p>التنفيذ يتم داخل المتصفح</p>
      </div>

    </div>

  </section>

</main>


<Footer />


<style>

:root {

  --bg:#080c12;
  --panel:#0d131b;
  --panel2:#111923;
  --bar:#151e29;

  --border:#202c39;

  --text:#e6edf3;
  --muted:#7d8b99;

  --blue:#38a8ff;
  --blue2:#168bd0;

  --green:#3fb950;
  --red:#f85149;

  --radius:14px;

  --code:15px;

}


* {

  box-sizing:border-box;

}


body {

  margin:0;

  background:

    radial-gradient(
      circle at 50% -20%,
      rgba(56,168,255,.08),
      transparent 40%
    ),

    var(--bg);

  color:var(--text);

  font-family:
    'Cairo',
    sans-serif;

}


.page {

  width:min(
    1400px,
    calc(100% - 30px)
  );

  margin:auto;

  padding:
    45px 0 70px;

}


/* HERO */

.hero {

  display:flex;

  align-items:end;

  justify-content:space-between;

  gap:25px;

  margin-bottom:25px;

}


.eyebrow {

  color:var(--blue);

  font-size:11px;

  font-weight:700;

  letter-spacing:1.5px;

  margin-bottom:8px;

}


.hero h1 {

  margin:0;

  font-size:
    clamp(28px,4vw,46px);

  line-height:1.2;

  font-weight:800;

}


.hero h1 span {

  color:var(--blue);

}


.hero p {

  margin:
    10px 0 0;

  color:var(--muted);

  font-size:15px;

}


.hero-actions {

  display:flex;

  gap:8px;

}


.hero-actions select {

  height:44px;

  padding:
    0 15px;

  border:
    1px solid var(--border);

  border-radius:9px;

  background:var(--panel);

  color:var(--text);

  font-family:inherit;

  font-weight:600;

  outline:none;

}


.icon-button {

  width:44px;

  height:44px;

  border:
    1px solid var(--border);

  border-radius:9px;

  background:var(--panel);

  color:var(--text);

  cursor:pointer;

}


/* WORKSPACE */

.workspace {

  background:var(--panel);

  border:
    1px solid var(--border);

  border-radius:var(--radius);

  overflow:hidden;

  box-shadow:
    0 25px 80px
    rgba(0,0,0,.35);

}


/* TOPBAR */

.topbar {

  height:58px;

  display:flex;

  align-items:center;

  justify-content:space-between;

  background:var(--bar);

  border-bottom:
    1px solid var(--border);

  padding:
    0 12px;

}


.file-tab {

  height:100%;

  display:flex;

  align-items:center;

  gap:9px;

  padding:
    0 15px;

  border-right:
    1px solid var(--border);

  font-family:
    'Fira Code',
    monospace;

  font-size:13px;

}


.dirty {

  color:var(--blue);

  font-size:8px;

}


.actions {

  display:flex;

  align-items:center;

  gap:5px;

}


.actions button {

  height:36px;

  min-width:36px;

  padding:0 9px;

  border:
    1px solid var(--border);

  border-radius:7px;

  background:transparent;

  color:var(--muted);

  cursor:pointer;

  font-family:inherit;

  font-size:12px;

}


.actions button:hover {

  color:white;

  border-color:
    #3a4d60;

  background:
    rgba(255,255,255,.03);

}


.actions .run {

  padding:
    0 18px;

  border:0;

  background:
    var(--blue2);

  color:white;

  font-weight:700;

}


.actions .run:hover {

  background:
    var(--blue);

}


/* SEARCH */

.search-bar {

  display:none;

  height:50px;

  align-items:center;

  gap:10px;

  padding:
    7px 12px;

  background:#0a1017;

  border-bottom:
    1px solid var(--border);

}


.search-bar.show {

  display:flex;

}


.search-bar input {

  flex:1;

  height:35px;

  border:
    1px solid var(--border);

  border-radius:7px;

  background:var(--panel);

  color:white;

  padding:
    0 12px;

  outline:none;

  font-family:inherit;

}


.search-bar span {

  color:var(--muted);

  font-size:12px;

}


.search-bar button {

  border:0;

  background:transparent;

  color:var(--muted);

  font-size:22px;

  cursor:pointer;

}


/* BODY */

.workspace-body {

  display:grid;

  grid-template-columns:
    1.15fr .85fr;

  min-height:600px;

}


.editor-panel {

  min-width:0;

  border-left:
    1px solid var(--border);

}


.editor-head,
.output-head {

  height:43px;

  display:flex;

  align-items:center;

  justify-content:space-between;

  padding:
    0 14px;

  background:
    #0e151d;

  border-bottom:
    1px solid var(--border);

  color:var(--muted);

  font-size:11px;

  font-weight:700;

  letter-spacing:.7px;

}


#languageBadge {

  color:var(--blue);

}


.editor {

  display:flex;

  height:550px;

  background:#080c11;

  direction:ltr;

}


.numbers {

  width:55px;

  flex:none;

  padding:
    18px 12px;

  background:#070b10;

  border-right:
    1px solid var(--border);

  color:#3d4a57;

  font:
    var(--code) /
    1.75
    'Fira Code',
    monospace;

  text-align:right;

  overflow:hidden;

  user-select:none;

}


#code {

  flex:1;

  width:100%;

  height:100%;

  resize:none;

  border:0;

  outline:0;

  padding:
    18px;

  background:#080c11;

  color:#d9e2ea;

  font:
    var(--code) /
    1.75
    'Fira Code',
    monospace;

  white-space:pre;

  overflow:auto;

  tab-size:4;

}


/* OUTPUT */

.output-panel {

  min-width:0;

  background:#080c11;

}


.output-tabs {

  display:flex;

  gap:18px;

}


.output-tabs button {

  height:43px;

  border:0;

  background:transparent;

  color:var(--muted);

  cursor:pointer;

  font-family:inherit;

  font-size:11px;

  font-weight:700;

}


.output-tabs button.active {

  color:var(--blue);

  border-bottom:
    2px solid var(--blue);

}


.clear {

  background:transparent;

  border:0;

  color:var(--muted);

  cursor:pointer;

  font-family:inherit;

}


.clear:hover {

  color:var(--red);

}


.output {

  height:550px;

  padding:20px;

  overflow:auto;

  font:
    14px /
    1.7
    'Fira Code',
    monospace;

}


.welcome-terminal {

  height:100%;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  text-align:center;

  color:var(--muted);

}


.terminal-logo {

  width:65px;

  height:65px;

  display:flex;

  align-items:center;

  justify-content:center;

  margin-bottom:15px;

  border:
    1px solid var(--border);

  border-radius:15px;

  background:var(--panel2);

  color:var(--blue);

  font:
    20px
    'Fira Code';

}


.welcome-terminal h3 {

  margin:
    0 0 4px;

  color:var(--text);

}


.welcome-terminal p {

  margin:0 0 5px;

}


.welcome-terminal small {

  color:#465563;

}


/* PREVIEW */

.preview {

  display:none;

  height:550px;

  background:white;

}


.preview iframe {

  width:100%;

  height:100%;

  border:0;

}


/* INPUT */

.input-area {

  padding:
    12px 15px;

  border-top:
    1px solid var(--border);

  background:#0a1017;

}


.input-area > div {

  display:flex;

  gap:8px;

  align-items:center;

  margin-bottom:7px;

}


.input-area strong {

  color:var(--blue);

  font-size:12px;

}


.input-area span {

  color:var(--muted);

  font-size:11px;

}


.input-area textarea {

  width:100%;

  min-height:55px;

  resize:vertical;

  border:
    1px solid var(--border);

  border-radius:7px;

  background:var(--panel);

  color:var(--text);

  padding:9px;

  outline:none;

  font:
    12px
    'Fira Code';

}


/* STATUS */

.status {

  height:31px;

  display:flex;

  align-items:center;

  justify-content:flex-end;

  gap:20px;

  padding:
    0 12px;

  background:#0d141c;

  border-top:
    1px solid var(--border);

  color:#647484;

  font-size:10px;

  direction:ltr;

}


/* INFO */

.info {

  display:grid;

  grid-template-columns:
    repeat(4,1fr);

  gap:12px;

  margin-top:18px;

}


.info > div {

  display:flex;

  align-items:center;

  gap:12px;

  padding:15px;

  border:
    1px solid var(--border);

  border-radius:11px;

  background:
    rgba(13,19,27,.7);

}


.info-icon {

  width:38px;

  height:38px;

  display:flex;

  align-items:center;

  justify-content:center;

  border-radius:9px;

  background:
    rgba(56,168,255,.08);

  color:var(--blue);

}


.info strong {

  display:block;

  font-size:12px;

}


.info p {

  margin:2px 0 0;

  color:var(--muted);

  font-size:10px;

}


/* LIGHT */

body.light {

  --bg:#f5f8fb;

  --panel:#fff;

  --panel2:#f0f5f9;

  --bar:#edf3f7;

  --border:#dce5ec;

  --text:#17212b;

  --muted:#667582;

}


body.light .editor,
body.light #code,
body.light .output,
body.light .preview {

  background:#fbfdff;

}


body.light .numbers {

  background:#f4f8fb;

  color:#9ba9b5;

}


body.light .editor-head,
body.light .output-head {

  background:#f1f5f8;

}


/* MOBILE */

@media(max-width:900px) {

  .workspace-body {

    grid-template-columns:1fr;

  }


  .editor-panel {

    border-left:0;

    border-bottom:
      1px solid var(--border);

  }


  .output-panel {

    min-height:400px;

  }


  .info {

    grid-template-columns:
      repeat(2,1fr);

  }

}


@media(max-width:650px) {

  .page {

    width:
      calc(100% - 16px);

    padding-top:25px;

  }


  .hero {

    flex-direction:column;

    align-items:stretch;

  }


  .hero-actions {

    width:100%;

  }


  .hero-actions select {

    flex:1;

  }


  .actions {

    overflow-x:auto;

    max-width:100%;

  }


  .actions button {

    flex:none;

  }


  .actions button:nth-child(
    1
  ),
  .actions button:nth-child(
    2
  ) {

    display:none;

  }


  .editor {

    height:430px;

  }


  .output {

    height:350px;

  }


  .preview {

    height:350px;

  }


  .status span:nth-child(
    2
  ),
  .status span:nth-child(
    3
  ) {

    display:none;

  }


  .info {

    grid-template-columns:1fr;

  }


  .file-tab {

    padding:0 8px;

  }

}

</style>


<script>

document.addEventListener(
  'DOMContentLoaded',
  () => {

    const code =
      document.getElementById('code');

    const numbers =
      document.getElementById('numbers');

    const output =
      document.getElementById('output');

    const preview =
      document.getElementById('preview');

    const inputArea =
      document.getElementById('inputArea');

    const input =
      document.getElementById('input');

    const language =
      document.getElementById('language');

    const fileName =
      document.getElementById('fileName');

    const fileIcon =
      document.getElementById('fileIcon');

    const badge =
      document.getElementById('languageBadge');

    const dirty =
      document.getElementById('dirty');

    const stats =
      document.getElementById('stats');

    const cursor =
      document.getElementById('cursor');

    const searchBar =
      document.getElementById('searchBar');

    const searchInput =
      document.getElementById('searchInput');

    const searchResult =
      document.getElementById('searchResult');


    let currentLanguage =
      'python';

    let fontSize = 15;

    let pyodide =
      null;


    /* EXAMPLES */

    const examples = {

      python:
`# Th.Tech Python Playground

name = input("أدخل اسمك: ")

print("مرحباً", name)

numbers = [1, 2, 3, 4, 5]

print("المجموع:", sum(numbers))`,



      javascript:
`// Th.Tech JavaScript Playground

console.log("مرحباً بالعالم!");

const numbers = [1, 2, 3, 4, 5];

const total = numbers.reduce(
  (a, b) => a + b,
  0
);

console.log("المجموع:", total);`,


      html:
`<!DOCTYPE html>

<html lang="ar">

<head>

<meta charset="UTF-8">

<style>

body {

  font-family: Arial;

  background: #f4f9fc;

  display: flex;

  justify-content: center;

  align-items: center;

  min-height: 100vh;

}

.card {

  background: white;

  padding: 40px;

  border-radius: 20px;

  text-align: center;

  box-shadow: 0 10px 30px rgba(0,0,0,.15);

}

h1 {

  color: #168bd0;

}

</style>

</head>

<body>

<div class="card">

<h1>مرحباً بك في Th.Tech 👋</h1>

<p>هذه معاينة HTML / CSS</p>

</div>

</body>

</html>`

    };


    const extensions = {

      python:'py',

      javascript:'js',

      html:'html'

    };


    const icons = {

      python:'🐍',

      javascript:'📜',

      html:'🌐'

    };


    /* STORAGE KEY */

    function storageKey() {

      return (
        'thtech-playground-' +
        currentLanguage
      );

    }


    /* LOAD */

    function loadCode() {

      const saved =
        localStorage.getItem(
          storageKey()
        );


      code.value =
        saved !== null
          ? saved
          : examples[currentLanguage];


      updateLines();

      updateStats();

    }


    /* LANGUAGE */

    function updateLanguage() {

      currentLanguage =
        language.value;


      fileName.textContent =
        'main.' +
        extensions[currentLanguage];


      fileIcon.textContent =
        icons[currentLanguage];


      badge.textContent =
        currentLanguage === 'javascript'
          ? 'JavaScript'
          : currentLanguage === 'html'
          ? 'HTML / CSS'
          : 'Python';


      inputArea.style.display =
        currentLanguage === 'python'
          ? 'block'
          : 'none';


      loadCode();

      clearOutput();

    }


    language.addEventListener(
      'change',
      updateLanguage
    );


    /* LINES */

    function updateLines() {

      const count =
        code.value.split('\n').length;


      let result = '';

      for (
        let i = 1;
        i <= count;
        i++
      ) {

        result += i + '\n';

      }


      numbers.textContent =
        result;

    }


    /* STATS */

    function updateStats() {

      const lines =
        code.value.split('\n').length;


      const chars =
        code.value.length;


      stats.textContent =
        `${lines} lines • ${chars} chars`;

    }


    /* CURSOR */

    function updateCursor() {

      const before =
        code.value.substring(
          0,
          code.selectionStart
        );


      const line =
        before.split('\n').length;


      const column =
        before.length -
        before.lastIndexOf('\n');


      cursor.textContent =
        `Ln ${line}, Col ${column}`;

    }


    code.addEventListener(
      'input',
      () => {

        updateLines();

        updateStats();

        updateCursor();

        dirty.style.display =
          'inline';

        clearTimeout(
          window.thSave
        );


        window.thSave =
          setTimeout(
            saveCode,
            600
          );

      }
    );


    code.addEventListener(
      'click',
      updateCursor
    );


    code.addEventListener(
      'keyup',
      updateCursor
    );


    /* SCROLL */

    code.addEventListener(
      'scroll',
      () => {

        numbers.scrollTop =
          code.scrollTop;

      }
    );


    /* TAB */

    code.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'Tab'
        ) {

          event.preventDefault();


          const start =
            code.selectionStart;

          const end =
            code.selectionEnd;


          code.value =
            code.value.substring(
              0,
              start
            ) +

            '    ' +

            code.value.substring(
              end
            );


          code.selectionStart =
            code.selectionEnd =
            start + 4;


          updateLines();

          updateStats();

        }


        if (
          event.ctrlKey &&
          event.key === 'Enter'
        ) {

          event.preventDefault();

          runCode();

        }


        if (
          event.ctrlKey &&
          event.key.toLowerCase() === 's'
        ) {

          event.preventDefault();

          saveCode();

        }

      }
    );


    /* SAVE */

    function saveCode() {

      localStorage.setItem(
        storageKey(),
        code.value
      );


      dirty.style.display =
        'none';

    }


    document
      .getElementById('save')
      .addEventListener(
        'click',
        saveCode
      );


    /* COPY */

    document
      .getElementById('copy')
      .addEventListener(
        'click',
        async () => {

          try {

            await navigator
              .clipboard
              .writeText(
                code.value
              );


            const button =
              document.getElementById(
                'copy'
              );


            button.textContent =
              '✓';


            setTimeout(
              () => {
                button.textContent =
                  '📋';
              },
              1000
            );

          } catch {}

        }
      );


    /* DOWNLOAD */

    document
      .getElementById('download')
      .addEventListener(
        'click',
        () => {

          const blob =
            new Blob(
              [code.value],
              {
                type:
                  'text/plain;charset=utf-8'
              }
            );


          const url =
            URL.createObjectURL(
              blob
            );


          const link =
            document.createElement(
              'a'
            );


          link.href = url;

          link.download =
            'main.' +
            extensions[currentLanguage];


          link.click();


          URL.revokeObjectURL(
            url
          );

        }
      );


    /* FONT */

    document
      .getElementById('fontUp')
      .addEventListener(
        'click',
        () => {

          fontSize =
            Math.min(
              24,
              fontSize + 1
            );


          code.style.fontSize =
            fontSize + 'px';

          numbers.style.fontSize =
            fontSize + 'px';

        }
      );


    document
      .getElementById('fontDown')
      .addEventListener(
        'click',
        () => {

          fontSize =
            Math.max(
              10,
              fontSize - 1
            );


          code.style.fontSize =
            fontSize + 'px';

          numbers.style.fontSize =
            fontSize + 'px';

        }
      );


    /* SEARCH */

    document
      .getElementById('search')
      .addEventListener(
        'click',
        () => {

          searchBar.classList.add(
            'show'
          );

          searchInput.focus();

        }
      );


    document
      .getElementById('closeSearch')
      .addEventListener(
        'click',
        () => {

          searchBar.classList.remove(
            'show'
          );

          searchInput.value = '';

        }
      );


    searchInput.addEventListener(
      'input',
      () => {

        const value =
          searchInput.value;


        if (!value) {

          searchResult.textContent =
            '0 نتيجة';

          return;

        }


        const matches =
          code.value
            .toLowerCase()
            .split(value.toLowerCase())
            .length - 1;


        searchResult.textContent =
          `${matches} نتيجة`;


        const index =
          code.value
            .toLowerCase()
            .indexOf(
              value.toLowerCase()
            );


        if (index >= 0) {

          code.focus();

          code.setSelectionRange(
            index,
            index + value.length
          );

        }

      }
    );


    /* CLEAR */

    function clearOutput() {

      output.innerHTML = `

        <div class="welcome-terminal">

          <div class="terminal-logo">
            >_
          </div>

          <h3>
            Th.Tech Terminal
          </h3>

          <p>
            اضغط تشغيل لتنفيذ الكود
          </p>

          <small>
            Ctrl + Enter
          </small>

        </div>

      `;

    }


    document
      .getElementById('clear')
      .addEventListener(
        'click',
        clearOutput
      );


    /* PYODIDE */

    async function getPython() {

      if (pyodide) {

        return pyodide;

      }


      if (
        typeof window.loadPyodide !==
        'function'
      ) {

        throw new Error(
          'Python engine لم يتم تحميله.'
        );

      }


      pyodide =
        await window.loadPyodide({

          indexURL:
            'https://cdn.jsdelivr.net/pyodide/v0.24.1/full/'

        });


      return pyodide;

    }


    /* PYTHON */

    async function executePython(
      source
    ) {

      const py =
        await getPython();


      let result = '';

      const values =
        input.value
          .split(/\r?\n/);


      let position = 0;


      py.setStdin({

        stdin: () => {

          return (
            position <
            values.length
          )
            ? values[position++]
            : '';

        }

      });


      py.setStdout({

        batched: text => {

          result += text;

        }

      });


      py.setStderr({

        batched: text => {

          result += text;

        }

      });


      await py.runPythonAsync(
        source
      );


      return result;

    }


    /* JAVASCRIPT */

    function executeJavaScript(
      source
    ) {

      const logs = [];


      const consoleAPI = {

        log: (...args) => {

          logs.push(
            args
              .map(format)
              .join(' ')
          );

        },


        warn: (...args) => {

          logs.push(
            '⚠️ ' +
            args
              .map(format)
              .join(' ')
          );

        },


        error: (...args) => {

          logs.push(
            '❌ ' +
            args
              .map(format)
              .join(' ')
          );

        }

      };


      const fn =
        new Function(
          'console',
          source
        );


      fn(consoleAPI);


      return logs.join('\n');

    }


    function format(value) {

      if (
        typeof value === 'object' &&
        value !== null
      ) {

        try {

          return JSON.stringify(
            value,
            null,
            2
          );

        } catch {

          return String(value);

        }

      }


      return String(value);

    }


    /* HTML */

    function executeHTML(
      source
    ) {

      preview.innerHTML = '';


      const iframe =
        document.createElement(
          'iframe'
        );


      iframe.setAttribute(
        'sandbox',
        'allow-scripts'
      );


      preview.appendChild(
        iframe
      );


      const doc =
        iframe.contentDocument;


      doc.open();

      doc.write(source);

      doc.close();

    }


    /* RUN */

    async function runCode() {

      const source =
        code.value.trim();


      if (!source) {

        return;

      }


      const button =
        document.getElementById(
          'run'
        );


      button.disabled = true;

      button.textContent =
        '⏳ تشغيل...';


      try {

        if (
          currentLanguage === 'html'
        ) {

          executeHTML(source);

          showPreview();

          return;

        }


        output.innerHTML =
          `<span style="color:#7d8b99">
            ⏳ جاري التنفيذ...
          </span>`;


        let result = '';


        if (
          currentLanguage === 'python'
        ) {

          result =
            await executePython(
              source
            );

        }


        if (
          currentLanguage === 'javascript'
        ) {

          result =
            executeJavaScript(
              source
            );

        }


        if (result.trim()) {

          output.textContent =
            result;

        } else {

          output.innerHTML = `

            <div style="
              color:#3fb950;
              text-align:center;
              padding:60px;
              direction:rtl;
            ">

              ✓ تم التنفيذ بنجاح

              <br>

              <small>
                لا توجد مخرجات
              </small>

            </div>

          `;

        }

      } catch(error) {

        output.innerHTML = `

          <div style="
            color:#f85149;
            white-space:pre-wrap;
            direction:ltr;
            text-align:left;
          ">

            ❌ Error

            ${escapeHTML(
              error.message ||
              String(error)
            )}

          </div>

        `;

      } finally {

        button.disabled =
          false;

        button.textContent =
          '▶ تشغيل';

      }

    }


    document
      .getElementById('run')
      .addEventListener(
        'click',
        runCode
      );


    /* TABS */

    const consoleTab =
      document.getElementById(
        'consoleTab'
      );

    const previewTab =
      document.getElementById(
        'previewTab'
      );


    function showConsole() {

      consoleTab.classList.add(
        'active'
      );

      previewTab.classList.remove(
        'active'
      );

      output.style.display =
        'block';

      preview.style.display =
        'none';

    }


    function showPreview() {

      previewTab.classList.add(
        'active'
      );

      consoleTab.classList.remove(
        'active'
      );

      output.style.display =
        'none';

      preview.style.display =
        'block';

    }


    consoleTab.addEventListener(
      'click',
      showConsole
    );


    previewTab.addEventListener(
      'click',
      showPreview
    );


    /* FULLSCREEN */

    document
      .getElementById('fullscreen')
      .addEventListener(
        'click',
        () => {

          document
            .getElementById(
              'workspace'
            )
            .classList.toggle(
              'fullscreen'
            );

        }
      );


    /* RESET */

    document
      .getElementById('reset')
      .addEventListener(
        'click',
        () => {

          if (
            !confirm(
              'إعادة الكود إلى المثال الأصلي؟'
            )
          ) {

            return;

          }


          localStorage.removeItem(
            storageKey()
          );


          loadCode();

          clearOutput();

        }
      );


    /* THEME */

    document
      .getElementById('themeButton')
      .addEventListener(
        'click',
        () => {

          document.body.classList.toggle(
            'light'
          );

        }
      );


    /* ESCAPE */

    function escapeHTML(value) {

      return String(value)

        .replaceAll(
          '&',
          '&amp;'
        )

        .replaceAll(
          '<',
          '&lt;'
        )

        .replaceAll(
          '>',
          '&gt;'
        );

    }


    /* START */

    updateLanguage();

    updateCursor();

  }

);

</script>

</body>
</html>
