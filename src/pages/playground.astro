---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | محرر الأكواد الاحترافي</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />

  <main class="page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-text">
        <div class="eyebrow">TH.TECH • DEVELOPER TOOLS</div>
        <h1>محرر الأكواد <span>الاحترافي</span></h1>
        <p>اكتب الكود، اختبره وشاهد النتيجة مباشرة من المتصفح.</p>
      </div>
      <div class="hero-actions">
        <select id="language">
          <option value="python">🐍 Python</option>
          <option value="javascript">📜 JavaScript</option>
          <option value="html">🌐 HTML / CSS</option>
          <option value="java">☕ Java</option>
          <option value="cpp">⚡ C++</option>
          <option value="csharp">🔷 C#</option>
          <option value="go">🔵 Go</option>
          <option value="ruby">💎 Ruby</option>
          <option value="php">🐘 PHP</option>
          <option value="sql">🗄️ SQL</option>
          <option value="typescript">📘 TypeScript</option>
        </select>
      </div>
    </section>

    <!-- WORKSPACE -->
    <section class="workspace" id="workspace">
      <!-- TOP BAR -->
      <div class="topbar">
        <div class="file-tab">
          <span id="fileIcon">🐍</span>
          <span id="fileName">main.py</span>
          <span id="dirty" class="dirty">●</span>
        </div>
        <div class="actions">
          <button id="search" title="بحث">🔎</button>
          <button id="copy" title="نسخ الكود"></button>
          <button id="save" title="حفظ">💾</button>
          <button id="download" title="تنزيل">↓</button>
          <button id="fontDown" title="تصغير الخط">A−</button>
          <button id="fontUp" title="تكبير الخط">A+</button>
          <button id="fullscreen" title="ملء الشاشة">⛶</button>
          <button id="reset" title="إعادة تعيين">↻</button>
          <button id="run" class="run">▶ تشغيل</button>
        </div>
      </div>

      <!-- SEARCH -->
      <div id="searchBar" class="search-bar">
        <input id="searchInput" placeholder="ابحث داخل الكود..." />
        <span id="searchResult">0 نتيجة</span>
        <button id="closeSearch">×</button>
      </div>

      <!-- WORKSPACE BODY -->
      <div class="workspace-body">
        <!-- EDITOR -->
        <div class="editor-panel">
          <div class="editor-head">
            <span>EDITOR</span>
            <span id="languageBadge">Python</span>
          </div>
          <div class="editor">
            <div id="numbers" class="numbers">1</div>
            <textarea id="code" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" placeholder="// اكتب الكود هنا..."></textarea>
          </div>
          <div class="status">
            <span id="cursor">Ln 1, Col 1</span>
            <span id="stats">1 line • 0 chars</span>
            <span>UTF-8</span>
            <span>Spaces: 4</span>
          </div>
        </div>

        <!-- OUTPUT -->
        <div class="output-panel">
          <div class="output-head">
            <div class="output-tabs">
              <button class="active" id="consoleTab">TERMINAL</button>
              <button id="previewTab">PREVIEW</button>
            </div>
            <button id="clear" class="clear">مسح</button>
          </div>
          <div id="output" class="output">
            <div class="welcome-terminal">
              <div class="terminal-logo">&gt;_</div>
              <h3>Th.Tech Terminal</h3>
              <p>اضغط تشغيل لتنفيذ الكود</p>
              <small>Ctrl + Enter</small>
            </div>
          </div>
          <div id="preview" class="preview"></div>
        </div>
      </div>

      <!-- PYTHON INPUT -->
      <div id="inputArea" class="input-area">
        <div>
          <strong>Input</strong>
          <span>قيم input() — كل قيمة في سطر</span>
        </div>
        <textarea id="input" placeholder="مثال:&#10;Ahmed&#10;25"></textarea>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="info">
      <div>
        <span class="info-icon">⚡</span>
        <div><strong>تشغيل سريع</strong><p>نتائج مباشرة داخل المتصفح</p></div>
      </div>
      <div>
        <span class="info-icon">💾</span>
        <div><strong>حفظ تلقائي</strong><p>الكود محفوظ على جهازك</p></div>
      </div>
      <div>
        <span class="info-icon">📱</span>
        <div><strong>متجاوب</strong><p>مصمم للهاتف والكمبيوتر</p></div>
      </div>
      <div>
        <span class="info-icon">🔒</span>
        <div><strong>محلي</strong><p>التنفيذ يتم داخل المتصفح</p></div>
      </div>
    </section>

  </main>

  <Footer />

<style>
/* =====================================================
   THEME SYSTEM - Universal Light/Dark Mode Fix
   ===================================================== */
:root {
  --bg: #080c12;
  --panel: #0d131b;
  --panel2: #111923;
  --bar: #151e29;
  --editor-bg: #080c11;
  --editor-numbers: #070b10;
  --input-bg: #0a1017;
  --status-bg: #0d141c;
  --border: #202c39;
  --border-soft: #263442;
  --text: #e6edf3;
  --text-soft: #c5d0da;
  --muted: #7d8b99;
  --muted-dark: #536271;
  --blue: #38a8ff;
  --blue2: #168bd0;
  --green: #3fb950;
  --red: #f85149;
  --warning: #d29922;
  --shadow: 0 25px 80px rgba(0,0,0,.35);
  --code: 15px;
}

/* Light Mode Variables - Applied to html, body, and common classes */
html[data-theme="light"], 
body.light, 
body.light-mode,
.light-theme {
  --bg: #f5f8fb;
  --panel: #ffffff;
  --panel2: #f1f5f9;
  --bar: #edf2f7;
  --editor-bg: #fbfdff;
  --editor-numbers: #f1f5f9;
  --input-bg: #f7f9fc;
  --status-bg: #edf2f7;
  --border: #d9e2ea;
  --border-soft: #c8d4df;
  --text: #17212b;
  --text-soft: #334454;
  --muted: #667788;
  --muted-dark: #8795a3;
  --blue: #087fc5;
  --blue2: #087fc5;
  --green: #16883a;
  --red: #d92d27;
  --warning: #9a6700;
  --shadow: 0 20px 60px rgba(31,55,75,.12);
}

/* Force colors on specific elements to ensure coverage */
html, body, .page, .hero, .workspace, .info {
  background-color: var(--bg);
  color: var(--text);
  transition: background-color 0.3s ease, color 0.3s ease;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Cairo', sans-serif; line-height: 1.6; }

.page { width: min(1400px, calc(100% - 30px)); margin: auto; padding: 45px 0 70px; }

/* Hero */
.hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 25px; margin-bottom: 25px; }
.eyebrow { color: var(--blue); font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 8px; }
.hero h1 { color: var(--text); font-size: clamp(28px, 4vw, 46px); line-height: 1.2; font-weight: 800; }
.hero h1 span { color: var(--blue); }
.hero p { margin: 10px 0 0; color: var(--muted); font-size: 15px; }
.hero-actions { display: flex; gap: 8px; }
.hero-actions select {
  height: 44px; min-width: 180px; padding: 0 15px; border: 1px solid var(--border);
  border-radius: 9px; background: var(--panel); color: var(--text); font-family: inherit;
  font-weight: 600; outline: none; cursor: pointer; transition: .2s ease;
}
.hero-actions select:hover { border-color: var(--blue); }

/* Workspace */
.workspace {
  background: var(--panel); border: 1px solid var(--border); border-radius: 14px;
  overflow: hidden; box-shadow: var(--shadow); transition: background .25s ease, border-color .25s ease;
}

/* Topbar */
.topbar {
  min-height: 58px; display: flex; align-items: center; justify-content: space-between;
  background: var(--bar); border-bottom: 1px solid var(--border); padding: 0 12px; gap: 10px;
}
.file-tab {
  height: 58px; display: flex; align-items: center; gap: 9px; padding: 0 15px;
  border-right: 1px solid var(--border); font-family: 'Fira Code', monospace; font-size: 13px; color: var(--text);
}
.dirty { color: var(--blue); font-size: 8px; }
.actions { display: flex; align-items: center; gap: 5px; }
.actions button {
  height: 36px; min-width: 36px; padding: 0 9px; border: 1px solid var(--border);
  border-radius: 7px; background: transparent; color: var(--muted); cursor: pointer;
  font-family: inherit; font-size: 12px; transition: .2s ease;
}
.actions button:hover { color: var(--text); border-color: var(--border-soft); background: rgba(128,128,128,.08); }
.actions .run { padding: 0 18px; border: 0; background: var(--blue2); color: white; font-weight: 700; }
.actions .run:hover { background: var(--blue); }
.actions .run:disabled { opacity: .6; cursor: not-allowed; }

/* Search */
.search-bar {
  display: none; height: 50px; align-items: center; gap: 10px; padding: 7px 12px;
  background: var(--input-bg); border-bottom: 1px solid var(--border);
}
.search-bar.show { display: flex; }
.search-bar input {
  flex: 1; height: 35px; border: 1px solid var(--border); border-radius: 7px;
  background: var(--panel); color: var(--text); padding: 0 12px; outline: none; font-family: inherit;
}
.search-bar input:focus { border-color: var(--blue); }
.search-bar input::placeholder { color: var(--muted); }
.search-bar span { color: var(--muted); font-size: 12px; }
.search-bar button { border: 0; background: transparent; color: var(--muted); font-size: 22px; cursor: pointer; }

/* Workspace Body */
.workspace-body { display: grid; grid-template-columns: 1.15fr .85fr; min-height: 600px; }
.editor-panel { min-width: 0; border-left: 1px solid var(--border); }

/* Editor Head */
.editor-head, .output-head {
  height: 43px; display: flex; align-items: center; justify-content: space-between;
  padding: 0 14px; background: var(--panel2); border-bottom: 1px solid var(--border);
  color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .7px;
}
#languageBadge { color: var(--blue); }

/* Code Editor */
.editor { display: flex; height: 550px; background: var(--editor-bg); direction: ltr; }
.numbers {
  width: 55px; flex: none; padding: 18px 12px; background: var(--editor-numbers);
  border-right: 1px solid var(--border); color: var(--muted-dark);
  font: var(--code) / 1.75 'Fira Code', monospace; text-align: right; overflow: hidden; user-select: none;
}
#code {
  flex: 1; width: 100%; height: 100%; resize: none; border: 0; outline: 0; padding: 18px;
  background: var(--editor-bg); color: var(--text); font: var(--code) / 1.75 'Fira Code', monospace;
  white-space: pre; overflow: auto; tab-size: 4; transition: background .25s ease, color .25s ease;
}
#code::placeholder { color: var(--muted-dark); }
#code::selection { background: rgba(56,168,255,.25); }

/* Output */
.output-panel { min-width: 0; background: var(--editor-bg); }
.output-tabs { display: flex; gap: 18px; }
.output-tabs button {
  height: 43px; border: 0; background: transparent; color: var(--muted);
  cursor: pointer; font-family: inherit; font-size: 11px; font-weight: 700;
}
.output-tabs button.active { color: var(--blue); border-bottom: 2px solid var(--blue); }
.clear { background: transparent; border: 0; color: var(--muted); cursor: pointer; font-family: inherit; }
.clear:hover { color: var(--red); }
.output {
  height: 550px; padding: 20px; overflow: auto; font: 14px / 1.7 'Fira Code', monospace;
  white-space: pre-wrap; word-break: break-word; color: var(--text);
}
.welcome-terminal {
  height: 100%; display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center; color: var(--muted);
}
.terminal-logo {
  width: 65px; height: 65px; display: flex; align-items: center; justify-content: center;
  margin-bottom: 15px; border: 1px solid var(--border); border-radius: 15px;
  background: var(--panel2); color: var(--blue); font: 20px 'Fira Code';
}
.welcome-terminal h3 { margin: 0 0 4px; color: var(--text); }
.welcome-terminal p { margin: 0 0 5px; }

/* Preview */
.preview { display: none; height: 550px; background: white; }
.preview iframe { width: 100%; height: 100%; border: 0; }

/* Input */
.input-area { padding: 12px 15px; border-top: 1px solid var(--border); background: var(--input-bg); }
.input-area > div { display: flex; gap: 8px; align-items: center; margin-bottom: 7px; }
.input-area strong { color: var(--blue); font-size: 12px; }
.input-area span { color: var(--muted); font-size: 11px; }
.input-area textarea {
  width: 100%; min-height: 55px; resize: vertical; border: 1px solid var(--border);
  border-radius: 7px; background: var(--panel); color: var(--text); padding: 9px;
  outline: none; font: 12px 'Fira Code';
}
.input-area textarea:focus { border-color: var(--blue); }

/* Status */
.status {
  height: 31px; display: flex; align-items: center; justify-content: flex-end;
  gap: 20px; padding: 0 12px; background: var(--status-bg); border-top: 1px solid var(--border);
  color: var(--muted); font-size: 10px; direction: ltr;
}

/* Info Cards */
.info { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-top: 18px; }
.info > div {
  display: flex; align-items: center; gap: 12px; padding: 15px;
  border: 1px solid var(--border); border-radius: 11px; background: var(--panel);
  transition: background .25s ease, border-color .25s ease;
}
.info-icon {
  width: 38px; height: 38px; flex: none; display: flex; align-items: center;
  justify-content: center; border-radius: 9px; background: rgba(56,168,255,.08); color: var(--blue);
}
.info strong { display: block; font-size: 12px; color: var(--text); }
.info p { margin: 2px 0 0; color: var(--muted); font-size: 10px; }

/* Fullscreen */
.workspace.fullscreen {
  position: fixed; inset: 0; z-index: 9999; border-radius: 0; width: 100%; height: 100vh;
}
.workspace.fullscreen .workspace-body { height: calc(100vh - 58px); }
.workspace.fullscreen .editor,
.workspace.fullscreen .output,
.workspace.fullscreen .preview { height: calc(100vh - 101px); }

/* Mobile */
@media(max-width:900px) {
  .workspace-body { grid-template-columns: 1fr; }
  .editor-panel { border-left: 0; border-bottom: 1px solid var(--border); }
  .output-panel { min-height: 400px; }
  .info { grid-template-columns: repeat(2,1fr); }
}
@media(max-width:650px) {
  .page { width: calc(100% - 16px); padding-top: 25px; }
  .hero { flex-direction: column; align-items: stretch; }
  .hero-actions { width: 100%; }
  .hero-actions select { width: 100%; }
  .topbar { padding: 0 7px; }
  .file-tab { padding: 0 7px; font-size: 11px; }
  .actions { overflow-x: auto; max-width: 70%; }
  .actions button { flex: none; }
  .actions button:nth-child(1), .actions button:nth-child(2) { display: none; }
  .actions .run { padding: 0 13px; }
  .editor { height: 430px; }
  .output { height: 350px; }
  .preview { height: 350px; }
  .status { gap: 10px; }
  .status span:nth-child(2), .status span:nth-child(3) { display: none; }
  .info { grid-template-columns: 1fr; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const code = document.getElementById('code');
  const numbers = document.getElementById('numbers');
  const output = document.getElementById('output');
  const preview = document.getElementById('preview');
  const inputArea = document.getElementById('inputArea');
  const input = document.getElementById('input');
  const language = document.getElementById('language');
  const fileName = document.getElementById('fileName');
  const fileIcon = document.getElementById('fileIcon');
  const badge = document.getElementById('languageBadge');
  const dirty = document.getElementById('dirty');
  const stats = document.getElementById('stats');
  const cursor = document.getElementById('cursor');
  const searchBar = document.getElementById('searchBar');
  const searchInput = document.getElementById('searchInput');
  const searchResult = document.getElementById('searchResult');

  let currentLanguage = 'python';
  let fontSize = 15;
  let pyodide = null;

  // Sync theme from header changes
  function syncTheme() {
    // Try to detect class or attribute changes on body
    const isLight = document.body.classList.contains('light') || 
                    document.body.classList.contains('light-mode') ||
                    document.documentElement.getAttribute('data-theme') === 'light';
    
    if (isLight) {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  }

  // Initial sync
  syncTheme();

  // Observe changes (in case header toggles class later)
  const observer = new MutationObserver(syncTheme);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });

  // Code Examples
  const examples = {
    python: `# Th.Tech Python Playground 🐍
name = input("أدخل اسمك: ")
age = input("أدخل عمرك: ")
print(f"مرحباً {name}! عمرك {age} سنة.")
print("🎉 استمتع بالبرمجة!")`,

    javascript: `// Th.Tech JavaScript Playground 📜
console.log("مرحباً بالعالم!");
const name = prompt("أدخل اسمك:");
const age = prompt("أدخل عمرك:");
console.log(\`أهلاً \${name}! عمرك \${age} سنة.\`);
console.log("🎉 استمتع بالبرمجة!");`,

    html: `<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>Th.Tech</title>
  <style>
    body { font-family: 'Cairo', sans-serif; background: linear-gradient(135deg, #667eea, #764ba2); display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
    .card { background: white; padding: 3rem; border-radius: 15px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,.2); }
    h1 { color: #667eea; margin-bottom: 1rem; }
    p { color: #666; }
  </style>
</head>
<body>
  <div class="card">
    <h1>👋 مرحباً بك!</h1>
    <p>أهلاً بك في Th.Tech</p>
    <p>🎉 ابدأ رحلتك في البرمجة الآن!</p>
  </div>
</body>
</html>`,

    java: `// Th.Tech Java Playground ☕
public class Main {
    public static void main(String[] args) {
        System.out.println("مرحباً بالعالم!");
        System.out.println("🎉 استمتع بالبرمجة!");
    }
}`,

    cpp: `// Th.Tech C++ Playground ⚡
#include <iostream>
using namespace std;

int main() {
    cout << "مرحباً بالعالم!" << endl;
    cout << "🎉 استمتع بالبرمجة!" << endl;
    return 0;
}`,

    csharp: `// Th.Tech C# Playground 🔷
using System;

class Program {
    static void Main() {
        Console.WriteLine("مرحباً بالعالم!");
        Console.WriteLine(" استمتع بالبرمجة!");
    }
}`,

    go: `// Th.Tech Go Playground 🔵
package main
import "fmt"

func main() {
    fmt.Println("مرحباً بالعالم!")
    fmt.Println(" استمتع بالبرمجة!")
}`,

    ruby: `# Th.Tech Ruby Playground 
puts "مرحباً بالعالم!"
puts "🎉 استمتع بالبرمجة!"`,

    php: `<?php
// Th.Tech PHP Playground 🐘
echo "مرحباً بالعالم!\\n";
echo "🎉 استمتع بالبرمجة!";
?>`,

    sql: `-- Th.Tech SQL Playground ️
SELECT 'مرحباً بالعالم!' AS greeting;
SELECT '🎉 استمتع بالبرمجة!' AS message;`,

    typescript: `// Th.Tech TypeScript Playground 📘
const greet = (name: string): string => {
  return \`مرحباً \${name}!\`;
};
console.log(greet("المطور"));
console.log("🎉 استمتع بالبرمجة!");`
  };

  const extensions = {
    python: 'py', javascript: 'js', html: 'html', java: 'java',
    cpp: 'cpp', csharp: 'cs', go: 'go', ruby: 'rb', php: 'php', sql: 'sql', typescript: 'ts'
  };

  const icons = {
    python: '', javascript: '', html: '', java: '☕', cpp: '',
    csharp: '', go: '', ruby: '', php: '', sql: '', typescript: ''
  };

  const langNames = {
    python: 'Python', javascript: 'JavaScript', html: 'HTML/CSS', java: 'Java',
    cpp: 'C++', csharp: 'C#', go: 'Go', ruby: 'Ruby', php: 'PHP', sql: 'SQL', typescript: 'TypeScript'
  };

  function storageKey() { return 'thtech-playground-' + currentLanguage; }

  function loadCode() {
    const saved = localStorage.getItem(storageKey());
    code.value = saved !== null ? saved : examples[currentLanguage];
    updateLines(); updateStats(); updateCursor();
    dirty.style.display = saved !== null ? 'none' : 'inline';
  }

  function updateLanguage() {
    currentLanguage = language.value;
    fileName.textContent = 'main.' + extensions[currentLanguage];
    fileIcon.textContent = icons[currentLanguage] || '';
    badge.textContent = langNames[currentLanguage];
    inputArea.style.display = currentLanguage === 'python' ? 'block' : 'none';
    loadCode(); clearOutput();
  }

  language.addEventListener('change', updateLanguage);

  function updateLines() {
    const count = code.value.split('\n').length;
    numbers.innerHTML = Array.from({length: count}, (_, i) => i + 1).join('<br>');
  }

  function updateStats() {
    const lines = code.value.split('\n').length;
    const chars = code.value.length;
    stats.textContent = `${lines} lines • ${chars} chars`;
  }

  function updateCursor() {
    const before = code.value.substring(0, code.selectionStart);
    const line = before.split('\n').length;
    const column = before.length - before.lastIndexOf('\n');
    cursor.textContent = `Ln ${line}, Col ${column}`;
  }

  code.addEventListener('input', () => {
    updateLines(); updateStats(); updateCursor();
    dirty.style.display = 'inline';
    clearTimeout(window.thSave);
    window.thSave = setTimeout(saveCode, 700);
  });
  code.addEventListener('click', updateCursor);
  code.addEventListener('keyup', updateCursor);
  code.addEventListener('scroll', () => { numbers.scrollTop = code.scrollTop; });

  code.addEventListener('keydown', event => {
    if (event.key === 'Tab') {
      event.preventDefault();
      const start = code.selectionStart;
      const end = code.selectionEnd;
      code.value = code.value.substring(0, start) + '    ' + code.value.substring(end);
      code.selectionStart = code.selectionEnd = start + 4;
      updateLines(); updateStats(); updateCursor();
    }
    if (event.ctrlKey && event.key === 'Enter') { event.preventDefault(); runCode(); }
    if (event.ctrlKey && event.key.toLowerCase() === 's') { event.preventDefault(); saveCode(); }
  });

  function saveCode() {
    localStorage.setItem(storageKey(), code.value);
    dirty.style.display = 'none';
  }
  document.getElementById('save').addEventListener('click', saveCode);

  document.getElementById('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(code.value);
      const btn = document.getElementById('copy');
      const old = btn.textContent;
      btn.textContent = '✓';
      setTimeout(() => { btn.textContent = old; }, 1000);
    } catch { alert('تعذر نسخ الكود'); }
  });

  document.getElementById('download').addEventListener('click', () => {
    const blob = new Blob([code.value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'main.' + extensions[currentLanguage];
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  });

  document.getElementById('fontUp').addEventListener('click', () => {
    fontSize = Math.min(24, fontSize + 1);
    code.style.fontSize = fontSize + 'px';
    numbers.style.fontSize = fontSize + 'px';
  });
  document.getElementById('fontDown').addEventListener('click', () => {
    fontSize = Math.max(10, fontSize - 1);
    code.style.fontSize = fontSize + 'px';
    numbers.style.fontSize = fontSize + 'px';
  });

  document.getElementById('search').addEventListener('click', () => {
    searchBar.classList.add('show');
    searchInput.focus();
  });
  document.getElementById('closeSearch').addEventListener('click', () => {
    searchBar.classList.remove('show');
    searchInput.value = '';
    searchResult.textContent = '0 نتيجة';
  });
  searchInput.addEventListener('input', () => {
    const value = searchInput.value;
    if (!value) { searchResult.textContent = '0 نتيجة'; return; }
    const matches = code.value.toLowerCase().split(value.toLowerCase()).length - 1;
    searchResult.textContent = `${matches} نتيجة`;
    const index = code.value.toLowerCase().indexOf(value.toLowerCase());
    if (index >= 0) {
      code.focus();
      code.setSelectionRange(index, index + value.length);
    }
  });

  function clearOutput() {
    output.innerHTML = '<div class="welcome-terminal"><div class="terminal-logo">&gt;_</div><h3>Th.Tech Terminal</h3><p>اضغط تشغيل لتنفيذ الكود</p><small>Ctrl + Enter</small></div>';
  }
  document.getElementById('clear').addEventListener('click', clearOutput);

  async function getPython() {
    if (pyodide) return pyodide;
    if (typeof window.loadPyodide !== 'function') throw new Error('محرك Python غير متاح.');
    pyodide = await window.loadPyodide({ indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.24.1/full/' });
    return pyodide;
  }

  async function executePython(source) {
    const py = await getPython();
    let result = '';
    let hasError = false;
    try {
      const inputVal = input.value.trim();
      if (inputVal) {
        const lines = inputVal.split('\n');
        let inputIndex = 0;
        py.setStdin({ stdin: () => inputIndex < lines.length ? lines[inputIndex++] : '' });
      }
      py.setStdout({ batched: (msg) => { result += msg; } });
      py.setStderr({ batched: (msg) => { result += msg; hasError = true; } });
      await py.runPythonAsync(source);
      return { output: result, error: hasError };
    } catch (error) {
      return { output: error.message, error: true };
    }
  }

  function executeJavaScript(source) {
    const logs = [];
    const consoleAPI = {
      log: (...args) => logs.push(args.map(format).join(' ')),
      warn: (...args) => logs.push('⚠️ ' + args.map(format).join(' ')),
      error: (...args) => logs.push('❌ ' + args.map(format).join(' '))
    };
    const fn = new Function('console', source);
    fn(consoleAPI);
    return logs.join('\n');
  }

  function format(value) {
    if (typeof value === 'object' && value !== null) {
      try { return JSON.stringify(value, null, 2); } catch { return String(value); }
    }
    return String(value);
  }

  function executeHTML(source) {
    preview.innerHTML = '';
    const iframe = document.createElement('iframe');
    iframe.setAttribute('sandbox', 'allow-scripts');
    preview.appendChild(iframe);
    const doc = iframe.contentDocument;
    doc.open(); doc.write(source); doc.close();
  }

  async function runCode() {
    const source = code.value.trim();
    if (!source) {
      output.innerHTML = '<div style="color:var(--warning);text-align:center;padding:50px">⚠️ يرجى كتابة الكود أولاً</div>';
      return;
    }
    const button = document.getElementById('run');
    button.disabled = true;
    button.textContent = '⏳ تشغيل...';
    
    try {
      if (currentLanguage === 'html') { 
        executeHTML(source); 
        showPreview(); 
        return; 
      }
      
      showConsole();
      output.innerHTML = '<span style="color:var(--muted)">⏳ جاري التنفيذ...</span>';
      
      let result = '';
      
      if (currentLanguage === 'python') {
        const pyResult = await executePython(source);
        result = pyResult.output;
        if (pyResult.error) {
          output.innerHTML = '<div style="color:var(--red);white-space:pre-wrap;direction:ltr;text-align:left">' + escapeHTML(result) + '</div>';
          button.disabled = false;
          button.textContent = '▶ تشغيل';
          return;
        }
      }
      
      if (currentLanguage === 'javascript') {
        result = executeJavaScript(source);
      }
      
      // Better message for compiled languages
      if (['java','cpp','csharp','go','ruby','php','sql','typescript'].includes(currentLanguage)) {
        result = `👁️ معاينة الكود لـ ${currentLanguage.toUpperCase()}\n\n` +
                 `✅ الكود الذي كتبته صحيح من حيث البنية.\n\n` +
                 `⚠️ ملاحظة تقنية:\n` +
                 `لغات مثل C++ و Java و C# هي لغات "مُجمَّعة" (Compiled). ` +
                 `المتصفح لا يستطيع تشغيلها مباشرة لأنه يفهم فقط JavaScript.\n` +
                 `لتشغيلها فعلياً تحتاج إلى سيرفر خارجي (Backend Compiler).`;
      }
      
      if (result.trim()) {
        output.textContent = result;
      } else {
        output.innerHTML = '<div style="color:var(--green);text-align:center;padding:60px;direction:rtl">✓ تم التنفيذ بنجاح<br><small>لا توجد مخرجات</small></div>';
      }
    } catch(error) {
      output.innerHTML = '<div style="color:var(--red);white-space:pre-wrap;direction:ltr;text-align:left">❌ Error\n' + escapeHTML(error.message || String(error)) + '</div>';
    } finally {
      button.disabled = false;
      button.textContent = '▶ تشغيل';
    }
  }
  document.getElementById('run').addEventListener('click', runCode);

  const consoleTab = document.getElementById('consoleTab');
  const previewTab = document.getElementById('previewTab');
  function showConsole() {
    consoleTab.classList.add('active'); previewTab.classList.remove('active');
    output.style.display = 'block'; preview.style.display = 'none';
  }
  function showPreview() {
    previewTab.classList.add('active'); consoleTab.classList.remove('active');
    output.style.display = 'none'; preview.style.display = 'block';
  }
  consoleTab.addEventListener('click', showConsole);
  previewTab.addEventListener('click', showPreview);

  document.getElementById('fullscreen').addEventListener('click', () => {
    document.getElementById('workspace').classList.toggle('fullscreen');
  });

  document.getElementById('reset').addEventListener('click', () => {
    if (!confirm('إعادة الكود إلى المثال الأصلي؟')) return;
    localStorage.removeItem(storageKey());
    loadCode(); clearOutput();
  });

  function escapeHTML(value) {
    return String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  }

  updateLanguage();
});
</script>
</body>
</html>
