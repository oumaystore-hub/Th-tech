---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | مختبر الأكواد</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
</head>
<body>
  <Header />
  
  <main class="main-wrapper">
    <section class="playground-section">
      <div class="container">
        <div class="playground-header">
          <div>
            <h1>مختبر الأكواد التفاعلي</h1>
            <p>بيئة تنفيذ آمنة لـ JavaScript، Python، و HTML/CSS</p>
          </div>
          <div class="header-actions">
            <button id="theme-toggle" class="theme-btn" aria-label="تبديل الوضع">
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
            <a href="/Th-tech/" class="btn-back">العودة للرئيسية</a>
          </div>
        </div>

        <div class="editor-container">
          <div class="editor-toolbar">
            <div class="lang-tabs">
              <button class="lang-tab active" data-lang="javascript" onclick="switchLang('javascript')">JavaScript</button>
              <button class="lang-tab" data-lang="python" onclick="switchLang('python')">Python</button>
              <button class="lang-tab" data-lang="html" onclick="switchLang('html')">HTML/CSS</button>
            </div>
            <div class="toolbar-actions">
              <button class="action-btn" onclick="copyCode()" title="نسخ">📋</button>
              <button class="action-btn" onclick="resetCode()" title="إعادة">🔄</button>
              <button class="btn-run" id="runBtn" onclick="runCode()">▶ تشغيل</button>
            </div>
          </div>

          <div class="editor-body">
            <div class="code-pane">
              <div class="pane-header">
                <span id="fileName">script.js</span>
                <span class="lang-badge" id="langBadge">JS</span>
              </div>
              <div class="editor-area">
                <div class="line-numbers" id="lineNumbers">1</div>
                <textarea id="codeEditor" class="code-input" spellcheck="false" placeholder="// اكتب الكود هنا..." oninput="updateLines()" onscroll="syncScroll()" onkeydown="handleTab(event)"></textarea>
              </div>
            </div>
            
            <div class="output-pane">
              <div class="pane-header">
                <span>المخرجات</span>
                <button class="btn-clear" onclick="clearOutput()">مسح</button>
              </div>
              <div id="output" class="output-content">
                <div class="placeholder">اضغط "تشغيل" لرؤية النتيجة</div>
              </div>
            </div>
          </div>

          <div class="status-bar">
            <span id="status">✅ جاهز</span>
            <span id="py-status" style="display:none; color: #f59e0b;">⏳ تحميل Python...</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #ffffff;
    --bg-secondary: #f8fafc;
    --bg-tertiary: #f1f5f9;
    --text: #0f172a;
    --text-muted: #64748b;
    --border: #e2e8f0;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --success: #10b981;
    --danger: #ef4444;
    --editor-bg: #1e293b;
    --editor-text: #e2e8f0;
    --editor-gutter: #0f172a;
    --shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }

  [data-theme="dark"] {
    --bg: #0b1120;
    --bg-secondary: #0f172a;
    --bg-tertiary: #1e293b;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --border: #334155;
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --editor-bg: #0d1117;
    --editor-text: #c9d1d9;
    --editor-gutter: #010409;
    --shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Cairo', sans-serif; line-height: 1.6; transition: background 0.3s, color 0.3s; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  section { padding: 4rem 0; }

  .playground-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .playground-header h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.3rem; }
  .playground-header p { color: var(--text-muted); }
  .header-actions { display: flex; gap: 1rem; align-items: center; }

  .theme-btn { width: 40px; height: 40px; border-radius: 8px; background: var(--bg-tertiary); border: 1px solid var(--border); cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--text); transition: 0.2s; }
  .theme-btn:hover { border-color: var(--primary); }
  .icon-moon { display: none; }
  [data-theme="dark"] .icon-sun { display: none; }
  [data-theme="dark"] .icon-moon { display: block; }

  .btn-back { padding: 0.7rem 1.5rem; border-radius: 8px; background: var(--bg-tertiary); color: var(--primary); text-decoration: none; font-weight: 600; border: 1px solid var(--border); transition: 0.2s; }
  .btn-back:hover { background: var(--primary); color: white; border-color: var(--primary); }

  .editor-container { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
  .editor-toolbar { display: flex; justify-content: space-between; padding: 1rem 1.5rem; background: var(--bg-tertiary); border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 1rem; }
  .lang-tabs { display: flex; gap: 0.5rem; }
  .lang-tab { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-family: inherit; font-weight: 600; transition: 0.2s; }
  .lang-tab:hover { border-color: var(--primary); color: var(--text); }
  .lang-tab.active { background: var(--primary); color: white; border-color: var(--primary); }

  .toolbar-actions { display: flex; gap: 0.5rem; align-items: center; }
  .action-btn { width: 36px; height: 36px; border-radius: 6px; background: var(--bg); border: 1px solid var(--border); cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
  .action-btn:hover { border-color: var(--primary); }
  .btn-run { background: var(--success); color: white; border: none; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: 0.2s; }
  .btn-run:hover { filter: brightness(1.1); }
  .btn-run:disabled { opacity: 0.6; cursor: not-allowed; }

  .editor-body { display: grid; grid-template-columns: 1fr 1fr; min-height: 500px; }
  .code-pane { border-left: 1px solid var(--border); }
  .pane-header { display: flex; justify-content: space-between; padding: 0.7rem 1.2rem; background: var(--bg-tertiary); border-bottom: 1px solid var(--border); font-size: 0.9rem; font-weight: 600; }
  .lang-badge { background: var(--primary); color: white; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.75rem; }
  .btn-clear { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.85rem; }
  .btn-clear:hover { color: var(--danger); }

  .editor-area { display: flex; background: var(--editor-bg); }
  .line-numbers { width: 50px; background: var(--editor-gutter); color: #4b5563; font-family: 'Fira Code', monospace; font-size: 0.9rem; line-height: 1.6; padding: 1rem 0.8rem; text-align: left; user-select: none; overflow: hidden; }
  .code-input { flex: 1; background: var(--editor-bg); color: var(--editor-text); border: none; padding: 1rem; font-family: 'Fira Code', monospace; font-size: 0.95rem; line-height: 1.6; resize: none; tab-size: 2; }
  .code-input:focus { outline: none; }
  .code-input::placeholder { color: #4b5563; }

  .output-content { flex: 1; background: var(--editor-bg); padding: 1rem; font-family: 'Fira Code', monospace; font-size: 0.9rem; overflow-y: auto; color: var(--editor-text); white-space: pre-wrap; }
  .placeholder { color: #4b5563; text-align: center; padding: 4rem 1rem; }

  .status-bar { padding: 0.6rem 1.5rem; background: var(--bg-tertiary); border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--text-muted); display: flex; gap: 1rem; }

  @media (max-width: 900px) { .editor-body { grid-template-columns: 1fr; } .code-pane { border-left: none; border-bottom: 1px solid var(--border); } }
  @media (max-width: 600px) { .playground-header { flex-direction: column; text-align: center; } .header-actions { width: 100%; justify-content: center; } .editor-toolbar { flex-direction: column; align-items: stretch; } .lang-tabs { justify-content: center; } .toolbar-actions { justify-content: center; } .btn-run { width: 100%; justify-content: center; } }
</style>

<script>
  const examples = {
    javascript: { default: `console.log("مرحباً بالعالم!");\nconst a = 10, b = 5;\nconsole.log(\`المجموع: \${a + b}\`);` },
    python: { default: `print("مرحباً بالعالم!")\na, b = 10, 5\nprint(f"المجموع: {a + b}")` },
    html: { default: `<h1 style="color:#3b82f6; text-align:center;">مرحباً</h1>\n<p style="color:#64748b; text-align:center;">بيئة HTML/CSS تفاعلية</p>` }
  };

  let currentLang = 'javascript';
  let pyodide = null;

  function init() {
    document.getElementById('codeEditor').value = examples.javascript.default;
    updateLines();
    loadPyodide();
    
    // Load theme
    const saved = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', saved);
  }

  // Theme Toggle
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  async function loadPyodide() {
    const status = document.getElementById('py-status');
    try {
      pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/" });
      status.style.display = 'none';
    } catch(e) { status.textContent = 'فشل التحميل'; }
  }

  function switchLang(lang) {
    currentLang = lang;
    document.querySelectorAll('.lang-tab').forEach(t => t.classList.toggle('active', t.dataset.lang === lang));
    document.getElementById('fileName').textContent = lang === 'javascript' ? 'script.js' : lang === 'python' ? 'script.py' : 'index.html';
    document.getElementById('langBadge').textContent = lang === 'javascript' ? 'JS' : lang === 'python' ? 'PY' : 'HTML';
    document.getElementById('codeEditor').value = examples[lang].default;
    updateLines();
    clearOutput();
    document.getElementById('status').textContent = '✅ جاهز';
  }

  document.querySelectorAll('.lang-tab').forEach(tab => tab.addEventListener('click', () => switchLang(tab.dataset.lang)));

  function updateLines() {
    const lines = document.getElementById('codeEditor').value.split('\n').length;
    document.getElementById('lineNumbers').innerHTML = Array(lines).fill(0).map((_, i) => i + 1).join('<br>');
  }

  function syncScroll() {
    document.getElementById('lineNumbers').scrollTop = document.getElementById('codeEditor').scrollTop;
  }

  function handleTab(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = e.target.selectionStart;
      e.target.value = e.target.value.substring(0, start) + '  ' + e.target.value.substring(e.target.selectionEnd);
      e.target.selectionStart = e.target.selectionEnd = start + 2;
      updateLines();
    }
  }

  async function runCode() {
    const code = document.getElementById('codeEditor').value;
    const output = document.getElementById('output');
    const btn = document.getElementById('runBtn');
    if (!code.trim()) return;

    output.textContent = 'جاري التنفيذ...';
    btn.disabled = true;

    try {
      if (currentLang === 'javascript') {
        const logs = [];
        const fn = new Function('console', code);
        fn({ log: (...args) => logs.push(args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ')) });
        output.textContent = logs.join('\n') || '✅ تم التنفيذ (بدون مخرجات)';
      } else if (currentLang === 'html') {
        output.innerHTML = code;
      } else if (currentLang === 'python') {
        if (!pyodide) await loadPyodide();
        let res = '';
        pyodide.setStdout({ batched: m => res += m });
        await pyodide.runPythonAsync(code);
        output.textContent = res || '✅ تم التنفيذ (بدون مخرجات)';
      }
      document.getElementById('status').textContent = '✅ تم التنفيذ';
    } catch (err) {
      output.innerHTML = `<span style="color:var(--danger)">❌ خطأ: ${err.message}</span>`;
      document.getElementById('status').textContent = '❌ خطأ';
    } finally {
      btn.disabled = false;
    }
  }

  function clearOutput() { document.getElementById('output').innerHTML = '<div class="placeholder">اضغط "تشغيل" لرؤية النتيجة</div>'; document.getElementById('status').textContent = '✅ جاهز'; }
  function resetCode() { document.getElementById('codeEditor').value = examples[currentLang].default; updateLines(); clearOutput(); }
  async function copyCode() { await navigator.clipboard.writeText(document.getElementById('codeEditor').value); document.getElementById('status').textContent = '📋 تم النسخ'; setTimeout(() => document.getElementById('status').textContent = '✅ جاهز', 2000); }

  document.addEventListener('keydown', (e) => { if (e.target.id === 'codeEditor' && e.ctrlKey && e.key === 'Enter') runCode(); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
</script>
