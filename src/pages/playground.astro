</style>


<script>

document.addEventListener('DOMContentLoaded', () => {

  /* =====================================================
     ELEMENTS
  ====================================================== */

  const code =
    document.getElementById('code');

  const numbers =
    document.getElementById('numbers');

  const output =
    document.getElementById('output');

  const preview =
    document.getElementById('preview');

  const inputArea =
    document.getElementById('inputArea');

  const input =
    document.getElementById('input');

  const language =
    document.getElementById('language');

  const languageSelectIcon =
    document.getElementById('languageSelectIcon');

  const fileName =
    document.getElementById('fileName');

  const fileIcon =
    document.getElementById('fileIcon');

  const badge =
    document.getElementById('languageBadge');

  const dirty =
    document.getElementById('dirty');

  const savedLabel =
    document.getElementById('savedLabel');

  const stats =
    document.getElementById('stats');

  const cursor =
    document.getElementById('cursor');

  const searchBar =
    document.getElementById('searchBar');

  const searchInput =
    document.getElementById('searchInput');

  const searchResult =
    document.getElementById('searchResult');


  let currentLanguage =
    'python';

  let fontSize =
    15;

  let pyodide =
    null;


  /* =====================================================
     LANGUAGE DATA
  ====================================================== */

  const examples = {

    python: `# Th.Tech Python Playground
name = input("أدخل اسمك: ")
age = input("أدخل عمرك: ")

print(f"مرحباً {name}! عمرك {age} سنة.")
print("استمتع بالبرمجة!")`,

    javascript: `// Th.Tech JavaScript Playground

console.log("مرحباً بالعالم!");

const name = prompt("أدخل اسمك:");
const age = prompt("أدخل عمرك:");

console.log(\`أهلاً \${name}! عمرك \${age} سنة.\`);
console.log("استمتع بالبرمجة!");`,

    html: `<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>Th.Tech</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
