}`,

    cpp: `// Th.Tech C++ Playground

#include <iostream>

using namespace std;

int main() {

    cout << "مرحباً بالعالم!" << endl;
    cout << "استمتع بالبرمجة!" << endl;

    return 0;
}`,

    csharp: `// Th.Tech C# Playground

using System;

class Program {

    static void Main() {

        Console.WriteLine("مرحباً بالعالم!");
        Console.WriteLine("استمتع بالبرمجة!");

    }
}`,

    go: `// Th.Tech Go Playground

package main

import "fmt"

func main() {

    fmt.Println("مرحباً بالعالم!")
    fmt.Println("استمتع بالبرمجة!")

}`,

    ruby: `# Th.Tech Ruby Playground

puts "مرحباً بالعالم!"
puts "استمتع بالبرمجة!"`,

    php: `<?php

// Th.Tech PHP Playground

echo "مرحباً بالعالم!\\n";
echo "استمتع بالبرمجة!";

?>`,

    sql: `-- Th.Tech SQL Playground

SELECT 'مرحباً بالعالم!' AS greeting;

SELECT 'استمتع بالبرمجة!' AS message;`,

    typescript: `// Th.Tech TypeScript Playground

const greet = (name: string): string => {

  return \`مرحباً \${name}!\`;

};

console.log(greet("المطور"));
console.log("استمتع بالبرمجة!");`

  };


  const extensions = {

    python: 'py',
    javascript: 'js',
    html: 'html',
    java: 'java',
    cpp: 'cpp',
    csharp: 'cs',
    go: 'go',
    ruby: 'rb',
    php: 'php',
    sql: 'sql',
    typescript: 'ts'

  };


  const icons = {

    python:
      '<i class="fab fa-python"></i>',

    javascript:
      '<i class="fab fa-js"></i>',

    html:
      '<i class="fab fa-html5"></i>',

    java:
      '<i class="fab fa-java"></i>',

    cpp:
      '<i class="fas fa-code"></i>',

    csharp:
      '<i class="fas fa-cube"></i>',

    go:
      '<i class="fab fa-golang"></i>',

    ruby:
      '<i class="far fa-gem"></i>',

    php:
      '<i class="fab fa-php"></i>',

    sql:
      '<i class="fas fa-database"></i>',

    typescript:
      '<i class="fab fa-js"></i>'

  };


  const selectIcons = {

    python:
      'fab fa-python',

    javascript:
      'fab fa-js',

    html:
      'fab fa-html5',

    java:
      'fab fa-java',

    cpp:
      'fas fa-code',

    csharp:
      'fas fa-cube',

    go:
      'fab fa-golang',

    ruby:
      'far fa-gem',

    php:
      'fab fa-php',

    sql:
      'fas fa-database',

    typescript:
      'fab fa-js'

  };


  const langNames = {

    python: 'Python',
    javascript: 'JavaScript',
    html: 'HTML/CSS',
    java: 'Java',
    cpp: 'C++',
    csharp: 'C#',
    go: 'Go',
    ruby: 'Ruby',
    php: 'PHP',
    sql: 'SQL',
    typescript: 'TypeScript'

  };


  /* =====================================================
     THEME
  ====================================================== */

  function syncTheme() {

    const body =
      document.body;

    const html =
      document.documentElement;

    const bodyLight =
      body.classList.contains('light') ||
      body.classList.contains('light-mode');

    const htmlTheme =
      html.getAttribute('data-theme');

    const isLight =
      bodyLight ||
      htmlTheme === 'light';

    html.setAttribute(
      'data-theme',
      isLight ? 'light' : 'dark'
    );
  }


  syncTheme();


  const themeObserver =
    new MutationObserver(() => {

      syncTheme();

    });


  themeObserver.observe(
    document.documentElement,
    {
      attributes: true,
      attributeFilter: ['data-theme']
    }
  );


  themeObserver.observe(
    document.body,
    {
      attributes: true,
      attributeFilter: ['class']
    }
  );


  /* =====================================================
     STORAGE
  ====================================================== */

  function storageKey() {

    return 'thtech-playground-' +
      currentLanguage;

  }


  function showSaved() {

    dirty.style.display =
      'none';

    savedLabel.style.display =
      'inline-flex';

    clearTimeout(
      window.thSavedTimer
    );

    window.thSavedTimer =
      setTimeout(() => {

        savedLabel.style.display =
          'none';

      }, 1800);

  }


  function loadCode() {

    const saved =
      localStorage.getItem(
        storageKey()
      );

    code.value =
      saved !== null
        ? saved
        : examples[currentLanguage];

    updateLines();
    updateStats();
    updateCursor();

    if (saved !== null) {

      dirty.style.display =
        'none';

    } else {

      dirty.style.display =
        'inline';

    }

  }


  /* =====================================================
     LANGUAGE
  ====================================================== */

  function updateLanguage() {

    currentLanguage =
      language.value;

    fileName.textContent =
      'main.' +
      extensions[currentLanguage];

    fileIcon.innerHTML =
      icons[currentLanguage] || '';

    badge.textContent =
      langNames[currentLanguage];

    inputArea.style.display =
      currentLanguage === 'python'
        ? 'block'
        : 'none';


    languageSelectIcon.className =
      selectIcons[currentLanguage] ||
      'fas fa-code';


    loadCode();

    clearOutput();

  }


  language.addEventListener(
    'change',
    updateLanguage
  );


  /* =====================================================
     LINE NUMBERS
  ====================================================== */

  function updateLines() {

    const count =
      code.value.split('\n').length;

    numbers.innerHTML =
      Array.from(
        { length: count },
        (_, i) => i + 1
      ).join('<br>');

  }


  /* =====================================================
     STATS
  ====================================================== */

  function updateStats() {

    const lines =
      code.value.split('\n').length;

    const chars =
      code.value.length;

    stats.textContent =
      `${lines} lines • ${chars} chars`;

  }


  /* =====================================================
     CURSOR
  ====================================================== */

  function updateCursor() {

    const before =
      code.value.substring(
        0,
        code.selectionStart
      );

    const line =
      before.split('\n').length;

    const column =
      before.length -
      before.lastIndexOf('\n');

    cursor.textContent =
      `Ln ${line}, Col ${column}`;

  }


  /* =====================================================
     CODE INPUT
  ====================================================== */

  code.addEventListener(
    'input',
    () => {

      updateLines();

      updateStats();

      updateCursor();

      dirty.style.display =
        'inline';

      savedLabel.style.display =
        'none';

      clearTimeout(
        window.thSave
      );

      window.thSave =
        setTimeout(
          saveCode,
          700
        );

    }
  );


  code.addEventListener(
    'click',
    updateCursor
  );

  code.addEventListener(
    'keyup',
    updateCursor
  );

  code.addEventListener(
    'select',
    updateCursor
  );


  code.addEventListener(
    'scroll',
    () => {

      numbers.scrollTop =
        code.scrollTop;

    }
  );


  /* =====================================================
     KEYBOARD
  ====================================================== */

  code.addEventListener(
    'keydown',
    event => {

      if (event.key === 'Tab') {

        event.preventDefault();

        const start =
          code.selectionStart;

        const end =
          code.selectionEnd;

        code.value =
          code.value.substring(
            0,
            start
          ) +
          '    ' +
          code.value.substring(
            end
          );

        code.selectionStart =
          code.selectionEnd =
            start + 4;

        updateLines();
        updateStats();
        updateCursor();

      }


      if (
        event.ctrlKey &&
        event.key === 'Enter'
      ) {

        event.preventDefault();

        runCode();

      }


      if (
        event.ctrlKey &&
        event.key.toLowerCase() === 's'
      ) {

        event.preventDefault();

        saveCode();

      }


      if (
        event.ctrlKey &&
        event.key.toLowerCase() === 'f'
      ) {

        event.preventDefault();

        searchBar.classList.add(
          'show'
        );

        searchInput.focus();

      }

    }
  );


  /* =====================================================
     SAVE
  ====================================================== */

  function saveCode() {

    localStorage.setItem(
      storageKey(),
      code.value
    );

    showSaved();

  }


  document
    .getElementById('save')
    .addEventListener(
      'click',
      saveCode
    );


  /* =====================================================
     COPY
  ====================================================== */

  document
    .getElementById('copy')
    .addEventListener(
      'click',
      async () => {

        try {

          await navigator.clipboard.writeText(
            code.value
          );

          const btn =
            document.getElementById(
              'copy'
            );

          const old =
            btn.innerHTML;

          btn.innerHTML =
            '<i class="fas fa-check"></i>';

          btn.style.color =
            'var(--green)';

          btn.style.borderColor =
            'var(--green)';

          showToast(
            'تم نسخ الكود بنجاح'
          );

          setTimeout(() => {

            btn.innerHTML =
              old;

            btn.style.color =
              '';

            btn.style.borderColor =
              '';

          }, 1200);

        } catch {

          showToast(
            'تعذر نسخ الكود'
          );

        }

      }
    );


  /* =====================================================
     DOWNLOAD
  ====================================================== */

  document
    .getElementById('download')
    .addEventListener(
      'click',
      () => {

        const blob =
          new Blob(
            [code.value],
            {
              type:
                'text/plain;charset=utf-8'
            }
          );

        const url =
          URL.createObjectURL(
            blob
          );

        const link =
          document.createElement(
            'a'
          );

        link.href =
          url;

        link.download =
          'main.' +
          extensions[currentLanguage];

        document.body.appendChild(
          link
        );

        link.click();

        link.remove();

        URL.revokeObjectURL(
          url
        );

        showToast(
          'تم تجهيز الملف للتنزيل'
        );

      }
    );


  /* =====================================================
     FONT SIZE
  ====================================================== */

  document
    .getElementById('fontUp')
    .addEventListener(
      'click',
      () => {

        fontSize =
          Math.min(
            24,
            fontSize + 1
          );

        code.style.fontSize =
          fontSize + 'px';

        numbers.style.fontSize =
          fontSize + 'px';

      }
    );


  document
    .getElementById('fontDown')
    .addEventListener(
      'click',
      () => {

        fontSize =
          Math.max(
            10,
            fontSize - 1
          );

        code.style.fontSize =
          fontSize + 'px';

        numbers.style.fontSize =
          fontSize + 'px';

      }
    );


  /* =====================================================
     SEARCH
  ====================================================== */

  document
    .getElementById('search')
    .addEventListener(
      'click',
      () => {

        searchBar.classList.add(
          'show'
        );

        searchInput.focus();

      }
    );


  document
    .getElementById('closeSearch')
    .addEventListener(
      'click',
      () => {

        searchBar.classList.remove(
          'show'
        );

        searchInput.value =
          '';

        searchResult.textContent =
          '0 نتيجة';

      }
    );


  searchInput.addEventListener(
    'input',
    () => {

      const value =
        searchInput.value;

      if (!value) {

        searchResult.textContent =
          '0 نتيجة';

        return;

      }


      const matches =
        code.value
          .toLowerCase()
          .split(
            value.toLowerCase()
          )
          .length - 1;


      searchResult.textContent =
        `${matches} نتيجة`;


      const index =
        code.value
          .toLowerCase()
          .indexOf(
            value.toLowerCase()
          );


      if (index >= 0) {

        code.focus();

        code.setSelectionRange(
          index,
          index + value.length
        );

      }

    }
  );


  /* =====================================================
     CLEAR OUTPUT
  ====================================================== */

  function clearOutput() {

    output.innerHTML = `

      <div class="welcome-terminal">

        <div class="terminal-logo">

          <i class="fas fa-terminal"></i>

        </div>

        <h3>
          Th.Tech Terminal
        </h3>

        <p>
          اضغط تشغيل لتنفيذ الكود
        </p>

        <small>
          <kbd>Ctrl</kbd>
          +
          <kbd>Enter</kbd>
        </small>

      </div>

    `;

  }


  document
    .getElementById('clear')
    .addEventListener(
      'click',
      clearOutput
    );


  /* =====================================================
     PYTHON
  ====================================================== */

  async function getPython() {

    if (pyodide)
      return pyodide;

    if (
      typeof window.loadPyodide !==
      'function'
    ) {

      throw new Error(
        'محرك Python غير متاح.'
      );

    }

    pyodide =
      await window.loadPyodide({
        indexURL:
          'https://cdn.jsdelivr.net/pyodide/v0.24.1/full/'
      });

    return pyodide;

  }


  async function executePython(
    source
  ) {

    const py =
      await getPython();

    let result =
      '';

    let hasError =
      false;


    try {

      const inputVal =
        input.value.trim();


      if (inputVal) {

        const lines =
          inputVal.split('\n');

        let inputIndex =
          0;

        py.setStdin({

          stdin: () => {

            return inputIndex <
              lines.length

              ? lines[inputIndex++]

              : '';

          }

        });

      }


      py.setStdout({

        batched: msg => {

          result += msg;

        }

      });


      py.setStderr({

        batched: msg => {

          result += msg;

          hasError =
            true;

        }

      });


      await py.runPythonAsync(
        source
      );


      return {
        output: result,
        error: hasError
      };


    } catch (error) {

      return {
        output:
          error.message,
        error: true
      };

    }

  }


  /* =====================================================
     JAVASCRIPT
  ====================================================== */

  function executeJavaScript(
    source
  ) {

    const logs = [];


    const consoleAPI = {

      log: (...args) => {

        logs.push(
          args
            .map(format)
            .join(' ')
        );

      },

      warn: (...args) => {

        logs.push(
          '⚠️ ' +
          args
            .map(format)
            .join(' ')
        );

      },

      error: (...args) => {

        logs.push(
          '❌ ' +
          args
            .map(format)
            .join(' ')
        );

      }

    };


    const fn =
      new Function(
        'console',
        source
      );

    fn(consoleAPI);

    return logs.join('\n');

  }


  function format(value) {

    if (
      typeof value === 'object' &&
      value !== null
    ) {

      try {

        return JSON.stringify(
          value,
          null,
          2
        );

      } catch {

        return String(value);

      }

    }

    return String(value);

  }


  /* =====================================================
     HTML
  ====================================================== */

  function executeHTML(source) {

    preview.innerHTML =
      '';

    const iframe =
      document.createElement(
        'iframe'
      );

    iframe.setAttribute(
      'sandbox',
      'allow-scripts'
    );

    preview.appendChild(
      iframe
    );

    const doc =
      iframe.contentDocument;

    doc.open();

    doc.write(source);

    doc.close();

  }


  /* =====================================================
     RUN
  ====================================================== */

  async function runCode() {

    const source =
      code.value.trim();


    if (!source) {

      output.innerHTML = `

        <div style="
          color:var(--warning);
          text-align:center;
          padding:50px;
        ">

          <i class="fas fa-triangle-exclamation"></i>

          يرجى كتابة الكود أولاً

        </div>

      `;

      return;

    }


    const button =
      document.getElementById(
        'run'
      );


    button.disabled =
      true;


    button.innerHTML = `

      <i class="fas fa-spinner fa-spin"></i>
      <span>تشغيل...</span>

    `;


    try {

      if (
        currentLanguage ===
        'html'
      ) {

        executeHTML(
          source
        );

        showPreview();

        return;

      }


      showConsole();


      output.innerHTML = `

        <span style="
          color:var(--muted)
        ">

          <i class="fas fa-spinner fa-spin"></i>

          جاري التنفيذ...

        </span>

      `;


      let result =
        '';


      if (
        currentLanguage ===
        'python'
      ) {

        const pyResult =
          await executePython(
            source
          );

        result =
          pyResult.output;


        if (pyResult.error) {

          output.innerHTML = `

            <div style="
              color:var(--red);
              white-space:pre-wrap;
              direction:ltr;
              text-align:left;
            ">

              <i class="fas fa-circle-exclamation"></i>

              ${escapeHTML(result)}

            </div>

          `;

          return;

        }

      }


      if (
        currentLanguage ===
        'javascript'
      ) {

        result =
          executeJavaScript(
            source
          );

      }


      if (
        [
          'java',
          'cpp',
          'csharp',
          'go',
          'ruby',
          'php',
          'sql',
          'typescript'
        ].includes(
          currentLanguage
        )
      ) {

        result =
          `معاينة الكود لـ ${currentLanguage.toUpperCase()}

✅ الكود الذي كتبته جاهز للمعاينة.

⚠️ ملاحظة تقنية:

هذه اللغة تحتاج إلى بيئة تنفيذ أو Compiler
خاص بها لتشغيل الكود فعلياً.

المتصفح يستطيع تنفيذ JavaScript
وPython عبر Pyodide وHTML/CSS مباشرة.

لتشغيل اللغات المجمعة فعلياً تحتاج إلى Backend Compiler.`;

      }


      if (result.trim()) {

        output.textContent =
          result;

      } else {

        output.innerHTML = `

          <div style="
            color:var(--green);
            text-align:center;
            padding:60px;
            direction:rtl;
          ">

            <i
              class="fas fa-circle-check"
              style="
                font-size:3rem;
                margin-bottom:1rem;
              "
            ></i>

            <br>

            ✓ تم التنفيذ بنجاح

            <br>

            <small>
              لا توجد مخرجات
            </small>

          </div>

        `;

      }


    } catch(error) {

      output.innerHTML = `

        <div style="
          color:var(--red);
          white-space:pre-wrap;
          direction:ltr;
          text-align:left;
        ">

          <i class="fas fa-circle-exclamation"></i>

          Error

          ${escapeHTML(
            error.message ||
            String(error)
          )}

        </div>

      `;

    } finally {

      button.disabled =
        false;

      button.innerHTML = `

        <i class="fas fa-play"></i>

        <span>تشغيل</span>

      `;

    }

  }


  document
    .getElementById('run')
    .addEventListener(
      'click',
      runCode
    );


  /* =====================================================
     TABS
  ====================================================== */

  const consoleTab =
    document.getElementById(
      'consoleTab'
    );

  const previewTab =
    document.getElementById(
      'previewTab'
    );


  function showConsole() {

    consoleTab.classList.add(
      'active'
    );

    previewTab.classList.remove(
      'active'
    );

    output.style.display =
      'block';

    preview.style.display =
      'none';

  }


  function showPreview() {

    previewTab.classList.add(
      'active'
    );

    consoleTab.classList.remove(
      'active'
    );

    output.style.display =
      'none';

    preview.style.display =
      'block';

  }


  consoleTab.addEventListener(
    'click',
    showConsole
  );

  previewTab.addEventListener(
    'click',
    showPreview
  );


  /* =====================================================
     FULLSCREEN
  ====================================================== */

  document
    .getElementById('fullscreen')
    .addEventListener(
      'click',
      () => {

        const workspace =
          document.getElementById(
            'workspace'
          );

        workspace.classList.toggle(
          'fullscreen'
        );


        const btn =
          document.getElementById(
            'fullscreen'
          );


        if (
          workspace.classList.contains(
            'fullscreen'
          )
        ) {

          btn.innerHTML =
            '<i class="fas fa-compress"></i>';

          btn.title =
            'الخروج من ملء الشاشة';

        } else {

          btn.innerHTML =
            '<i class="fas fa-expand"></i>';

          btn.title =
            'ملء الشاشة';

        }

      }
    );


  /* =====================================================
     RESET
  ====================================================== */

  document
    .getElementById('reset')
    .addEventListener(
      'click',
      () => {

        if (
          !confirm(
            'إعادة الكود إلى المثال الأصلي؟'
          )
        )
          return;


        localStorage.removeItem(
          storageKey()
        );


        loadCode();

        clearOutput();

        showToast(
          'تمت إعادة الكود إلى المثال الأصلي'
        );

      }
    );


  /* =====================================================
     TOAST
  ====================================================== */

  function showToast(message) {

    const old =
      document.querySelector(
        '.th-toast'
      );

    if (old)
      old.remove();


    const toast =
      document.createElement(
        'div'
      );


    toast.className =
      'th-toast';


    toast.innerHTML = `

      <i class="fas fa-circle-check"></i>

      <span>
        ${escapeHTML(message)}
      </span>

    `;


    document.body.appendChild(
      toast
    );


    requestAnimationFrame(() => {

      toast.classList.add(
        'show'
      );

    });


    setTimeout(() => {

      toast.classList.remove(
        'show'
      );

      setTimeout(
        () => toast.remove(),
        250
      );

    }, 1800);

  }


  /* =====================================================
     ESCAPE HTML
  ====================================================== */

  function escapeHTML(value) {

    return String(value)

      .replaceAll(
        '&',
        '&amp;'
      )

      .replaceAll(
        '<',
        '&lt;'
      )

      .replaceAll(
        '>',
        '&gt;'
      );

  }


  /* =====================================================
     TOAST STYLE
  ====================================================== */

  const toastStyle =
    document.createElement(
      'style'
    );


  toastStyle.textContent = `

    .th-toast {

      position:fixed;

      left:50%;

      bottom:28px;

      z-index:100000;

      transform:
        translate(-50%, 20px);

      display:flex;

      align-items:center;

      gap:9px;

      padding:
        10px 15px;

      border:
        1px solid var(--border);

      border-radius:9px;

      background:
        var(--panel);

      color:
        var(--text);

      box-shadow:
        0 12px 35px rgba(0,0,0,.20);

      font-family:
        Cairo,
        sans-serif;

      font-size:11px;

      opacity:0;

      pointer-events:none;

      transition:
        opacity .25s ease,
        transform .25s ease;

      direction:rtl;
    }

    .th-toast.show {

      opacity:1;

      transform:
        translate(-50%, 0);

    }

    .th-toast i {

      color:
        var(--green);

      font-size:13px;

    }

  `;


  document.head.appendChild(
    toastStyle
  );


  /* =====================================================
     INITIALIZE
  ====================================================== */

  updateLanguage();

});

</script>

</body>
</html>
