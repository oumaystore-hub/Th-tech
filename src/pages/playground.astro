---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>محرر الأكواد | Th.Tech</title>
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Cairo:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />

  <div style="max-width: 1000px; margin: 0 auto; padding: 2rem 1rem;">
    
    <!-- Header -->
    <div style="margin-bottom: 2rem;">
      <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">💻 محرر الأكواد</h1>
      <p style="color: #8b949e;">اكتب الكود وشغّله مباشرة</p>
    </div>

    <!-- Language Selector -->
    <div style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
      <select id="lang" onchange="changeLang()" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid #30363d; background: #161b22; color: #c9d1d9; font-family: inherit;">
        <option value="python">Python</option>
        <option value="javascript">JavaScript</option>
        <option value="html">HTML</option>
      </select>
      <a href="/Th-tech/" style="color: #58a6ff; text-decoration: none;">← الرئيسية</a>
    </div>

    <!-- Editor Box -->
    <div style="background: #161b22; border: 1px solid #30363d; border-radius: 8px; overflow: hidden;">
      
      <!-- Toolbar -->
      <div style="display: flex; justify-content: space-between; padding: 0.8rem 1rem; background: #21262d; border-bottom: 1px solid #30363d;">
        <span id="fname" style="font-family: 'Fira Code', monospace;">main.py</span>
        <div style="display: flex; gap: 0.5rem;">
          <button onclick="copy()" style="padding: 0.4rem 0.8rem; background: transparent; border: 1px solid #30363d; color: #8b949e; border-radius: 4px; cursor: pointer;">نسخ</button>
          <button onclick="run()" id="runBtn" style="padding: 0.4rem 1.2rem; background: #238636; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">▶ تشغيل</button>
        </div>
      </div>

      <!-- Code Area -->
      <textarea id="code" style="width: 100%; min-height: 300px; background: #0d1117; color: #e6edf3; border: none; padding: 1rem; font-family: 'Fira Code', monospace; font-size: 0.95rem; resize: vertical;" spellcheck="false"></textarea>

      <!-- Output -->
      <div style="border-top: 1px solid #30363d;">
        <div style="padding: 0.6rem 1rem; background: #21262d; border-bottom: 1px solid #30363d; display: flex; justify-content: space-between; font-weight: 600; font-size: 0.9rem;">
          <span> المخرجات</span>
          <button onclick="clearOut()" style="background: transparent; border: none; color: #8b949e; cursor: pointer;">مسح</button>
        </div>
        <div id="out" style="padding: 1rem; background: #0d1117; min-height: 150px; font-family: 'Fira Code', monospace; white-space: pre-wrap; color: #c9d1d9; font-size: 0.9rem;">
          <div style="text-align: center; color: #8b949e; padding: 2rem;">اضغط تشغيل لرؤية النتيجة</div>
        </div>
      </div>

    </div>

  </div>

  <Footer />

  <script>
    const examples = {
      python: 'print("مرحباً!")\nname = input("اسمك: ")\nprint("أهلاً " + name)',
      javascript: 'console.log("مرحباً!");\nconst name = prompt("اسمك:");\nconsole.log("أهلاً " + name);',
      html: '<h1 style="color:cyan;text-align:center">مرحباً!</h1>'
    };

    let pyodide = null;

    // Init
    window.onload = function() {
      document.getElementById('code').value = examples.python;
      loadPy();
    };

    // Load Python
    async function loadPy() {
      try {
        pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/" });
      } catch(e) { console.error(e); }
    }

    // Change Language
    function changeLang() {
      const l = document.getElementById('lang').value;
      document.getElementById('code').value = examples[l];
      document.getElementById('fname').textContent = l === 'html' ? 'index.html' : 'main.' + (l === 'javascript' ? 'js' : 'py');
      clearOut();
    }

    // Run Code
    async function run() {
      const code = document.getElementById('code').value;
      const lang = document.getElementById('lang').value;
      const out = document.getElementById('out');
      const btn = document.getElementById('runBtn');

      if (!code.trim()) {
        out.innerHTML = '<span style="color:orange">اكتب كود أولاً!</span>';
        return;
      }

      out.innerHTML = '<span style="color:#8b949e">جاري...</span>';
      btn.disabled = true;

      try {
        if (lang === 'javascript') {
          let logs = [];
          const cons = { log: (...a) => logs.push(a.join(' ')) };
          new Function('console', code)(cons);
          out.textContent = logs.join('\n') || '(لا مخرجات)';
        } else if (lang === 'html') {
          out.innerHTML = code;
        } else if (lang === 'python') {
          if (!pyodide) await loadPy();
          let res = '';
          pyodide.setStdout({ batched: m => res += m });
          await pyodide.runPythonAsync(code);
          out.textContent = res || '(لا مخرجات)';
        }
      } catch (err) {
        out.innerHTML = '<span style="color:#f85149">خطأ: ' + err.message + '</span>';
      }

      btn.disabled = false;
    }

    // Copy
    function copy() {
      navigator.clipboard.writeText(document.getElementById('code').value);
      alert('تم النسخ!');
    }

    // Clear
    function clearOut() {
      document.getElementById('out').innerHTML = '<div style="text-align:center;color:#8b949e;padding:2rem">اضغط تشغيل لرؤية النتيجة</div>';
    }
  </script>
</body>
</html>
