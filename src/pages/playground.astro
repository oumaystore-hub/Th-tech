---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | محرر الأكواد</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />

  <main style="padding: 2rem 1rem; max-width: 1200px; margin: 0 auto;">
    
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">💻 محرر الأكواد</h1>
        <p style="color: #8b949e;">اكتب وشغّل الكود مباشرة</p>
      </div>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <select id="langSelect" onchange="changeLang()" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid #30363d; background: #161b22; color: #c9d1d9;">
          <option value="python">Python</option>
          <option value="javascript">JavaScript</option>
          <option value="html">HTML</option>
        </select>
        <a href="/Th-tech/" style="color: #58a6ff; text-decoration: none; padding: 0.5rem 1rem; border: 1px solid #30363d; border-radius: 6px;">الرئيسية</a>
      </div>
    </div>

    <!-- Editor Box -->
    <div style="background: #161b22; border: 1px solid #30363d; border-radius: 12px; overflow: hidden;">
      
      <!-- Toolbar -->
      <div style="display: flex; justify-content: space-between; padding: 1rem; background: #21262d; border-bottom: 1px solid #30363d; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace;">
          <span id="fileIcon">🐍</span>
          <span id="fileName">main.py</span>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button onclick="copyCode()" style="padding: 0.5rem; background: transparent; border: 1px solid #30363d; color: #8b949e; border-radius: 6px; cursor: pointer;">📋</button>
          <button onclick="resetCode()" style="padding: 0.5rem; background: transparent; border: 1px solid #30363d; color: #8b949e; border-radius: 6px; cursor: pointer;">🔄</button>
          <button onclick="runCode()" id="runBtn" style="padding: 0.5rem 1.5rem; background: #238636; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">▶ تشغيل</button>
        </div>
      </div>

      <!-- Input Area -->
      <div id="inputArea" style="padding: 1rem; background: #0d1117; border-bottom: 1px solid #30363d;">
        <label style="color: #8b949e; font-size: 0.9rem; display: block; margin-bottom: 0.5rem;">المدخلات (لـ Python):</label>
        <input type="text" id="userInput" placeholder="أدخل القيمة هنا..." style="width: 100%; padding: 0.5rem; background: #161b22; border: 1px solid #30363d; color: #c9d1d9; border-radius: 6px; font-family: 'Fira Code', monospace;">
      </div>

      <!-- Code Editor -->
      <textarea id="editor" style="width: 100%; min-height: 300px; background: #0d1117; color: #e6edf3; border: none; padding: 1.5rem; font-family: 'Fira Code', monospace; font-size: 1rem; resize: vertical; outline: none;" spellcheck="false"></textarea>

      <!-- Output -->
      <div style="border-top: 1px solid #30363d;">
        <div style="padding: 0.8rem 1rem; background: #21262d; border-bottom: 1px solid #30363d; display: flex; justify-content: space-between; font-weight: 600;">
          <span> المخرجات</span>
          <button onclick="clearOutput()" style="background: transparent; border: none; color: #8b949e; cursor: pointer;">مسح</button>
        </div>
        <div id="output" style="padding: 1.5rem; background: #0d1117; min-height: 200px; font-family: 'Fira Code', monospace; white-space: pre-wrap; color: #c9d1d9;">
          <div style="text-align: center; color: #8b949e; margin-top: 3rem;">اضغط "تشغيل" لرؤية النتيجة</div>
        </div>
      </div>

    </div>

    <!-- Info -->
    <div style="margin-top: 2rem; padding: 1.5rem; background: #161b22; border: 1px solid #30363d; border-radius: 8px;">
      <h3 style="margin-bottom: 1rem; color: #58a6ff;">💡 اللغات المدعومة:</h3>
      <ul style="color: #8b949e; padding-right: 1.5rem; line-height: 2;">
        <li><strong>Python:</strong> يدعم print() و input()</li>
        <li><strong>JavaScript:</strong> يدعم console.log()</li>
        <li><strong>HTML:</strong> يعرض النتيجة مباشرة</li>
      </ul>
    </div>

  </main>

  <Footer />

  <script>
    // الكود الافتراضي
    const codes = {
      python: `print("مرحباً!")\nname = input("اسمك: ")\nprint("أهلاً " + name)`,
      javascript: `console.log("مرحباً!");\nconst name = prompt("اسمك:");\nconsole.log("أهلاً " + name);`,
      html: `<h1 style="color: cyan; text-align: center;">مرحباً!</h1>`
    };

    let pyodide = null;

    // التهيئة
    function init() {
      document.getElementById('editor').value = codes.python;
      loadPyodide();
    }

    // تحميل Python
    async function loadPyodide() {
      try {
        pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/" });
        console.log("Python loaded");
      } catch(e) { console.error(e); }
    }

    // تغيير اللغة
    function changeLang() {
      const lang = document.getElementById('langSelect').value;
      document.getElementById('editor').value = codes[lang];
      document.getElementById('fileName').textContent = lang === 'html' ? 'index.html' : 'main.' + (lang === 'javascript' ? 'js' : 'py');
      document.getElementById('fileIcon').textContent = lang === 'python' ? '🐍' : lang === 'javascript' ? '' : '🌐';
      document.getElementById('inputArea').style.display = lang === 'python' ? 'block' : 'none';
      clearOutput();
    }

    // تشغيل الكود
    async function runCode() {
      const code = document.getElementById('editor').value;
      const lang = document.getElementById('langSelect').value;
      const output = document.getElementById('output');
      const btn = document.getElementById('runBtn');
      
      if (!code.trim()) { output.innerHTML = '<span style="color: orange">اكتب كود أولاً!</span>'; return; }

      output.innerHTML = '<span style="color: #8b949e">جاري التنفيذ...</span>';
      btn.disabled = true;

      try {
        if (lang === 'javascript') {
          let logs = [];
          const cons = { log: (...a) => logs.push(a.join(' ')) };
          new Function('console', code)(cons);
          output.textContent = logs.join('\n') || '(لا مخرجات)';
        } 
        else if (lang === 'html') {
          output.innerHTML = code;
        } 
        else if (lang === 'python') {
          if (!pyodide) await loadPyodide();
          let res = '';
          const inputVal = document.getElementById('userInput').value;
          if (inputVal) pyodide.setStdin({ stdin: () => inputVal });
          pyodide.setStdout({ batched: m => res += m });
          await pyodide.runPythonAsync(code);
          output.textContent = res || '(لا مخرجات)';
        }
      } catch (err) {
        output.innerHTML = '<span style="color: #f85149">خطأ: ' + err.message + '</span>';
      }
      
      btn.disabled = false;
    }

    function clearOutput() {
      document.getElementById('output').innerHTML = '<div style="text-align: center; color: #8b949e; margin-top: 3rem;">اضغط "تشغيل" لرؤية النتيجة</div>';
    }

    function resetCode() {
      changeLang();
    }

    function copyCode() {
      navigator.clipboard.writeText(document.getElementById('editor').value);
      alert('تم النسخ!');
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
