---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | محرر الأكواد الاحترافي</title>

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Cairo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>

<body>

<Header />

<main class="playground-main">

<div class="container">

  <!-- PAGE HEADER -->
  <div class="page-header">

    <div>
      <h1>💻 محرر الأكواد الاحترافي</h1>

      <p>
        اكتب الكود، شغّله وشاهد النتيجة فوراً
      </p>
    </div>

    <div class="header-actions">

      <select id="langSelect">
        <option value="python">🐍 Python</option>
        <option value="javascript">📜 JavaScript</option>
        <option value="html">🌐 HTML / CSS</option>
      </select>

      <a href="/Th-tech/" class="btn-home">
        الرئيسية
      </a>

    </div>

  </div>


  <!-- EDITOR -->
  <div
    class="editor-container"
    id="editorContainer"
  >

    <!-- TOOLBAR -->
    <div class="toolbar">

      <div class="file-info">

        <span id="fileIcon">🐍</span>

        <span id="fileName">
          main.py
        </span>

        <span
          id="saveStatus"
          class="save-status"
        >
          محفوظ
        </span>

      </div>


      <div class="toolbar-buttons">

        <button
          class="btn-tool"
          id="searchBtn"
          title="بحث"
        >
          🔎
        </button>

        <button
          class="btn-tool"
          id="fontMinus"
          title="تصغير الخط"
        >
          A−
        </button>

        <button
          class="btn-tool"
          id="fontPlus"
          title="تكبير الخط"
        >
          A+
        </button>

        <button
          class="btn-tool"
          id="saveBtn"
          title="حفظ"
        >
          💾
        </button>

        <button
          class="btn-tool"
          id="downloadBtn"
          title="تنزيل"
        >
          📥
        </button>

        <button
          class="btn-tool"
          id="resetBtn"
          title="إعادة التعيين"
        >
          🔄
        </button>

        <button
          class="btn-tool"
          id="fullscreenBtn"
          title="ملء الشاشة"
        >
          ⛶
        </button>

        <button
          class="btn-run"
          id="runBtn"
        >
          ▶ تشغيل
        </button>

      </div>

    </div>


    <!-- SEARCH -->
    <div
      class="search-panel"
      id="searchPanel"
    >

      <input
        id="searchInput"
        type="text"
        placeholder="بحث داخل الكود..."
      />

      <button id="closeSearch">
        ✕
      </button>

    </div>


    <!-- PYTHON INPUT -->
    <div
      class="input-section"
      id="inputSection"
    >

      <label>
        المدخلات Input
      </label>

      <textarea
        id="userInput"
        placeholder="ضع قيم input() هنا، كل قيمة في سطر..."
      ></textarea>

    </div>


    <!-- CODE AREA -->
    <div class="editor-wrapper">

      <div
        id="lineNumbers"
        class="line-numbers"
      >
        1
      </div>

      <textarea
        id="codeEditor"
        class="code-editor"
        spellcheck="false"
      ></textarea>

    </div>


    <!-- OUTPUT -->
    <div class="output-section">

      <div class="output-header">

        <span>
          📤 Console / Preview
        </span>

        <div>

          <button
            id="clearBtn"
            class="console-button"
          >
            مسح
          </button>

        </div>

      </div>


      <div
        id="output"
        class="output-content"
      >

        <div class="output-placeholder">

          <div class="terminal-icon">
            ▶_
          </div>

          <p>
            اضغط على "تشغيل" لرؤية النتيجة
          </p>

          <small>
            Ctrl + Enter لتشغيل الكود
          </small>

        </div>

      </div>

    </div>

  </div>


  <!-- FEATURES -->

  <section class="features-section">

    <h2>
      ✨ أدوات Th.Tech
    </h2>

    <div class="features-grid">

      <div class="feature-card">

        <span>🐍</span>

        <div>
          <h3>Python</h3>

          <p>
            تشغيل Python داخل المتصفح باستخدام Pyodide.
          </p>
        </div>

      </div>


      <div class="feature-card">

        <span>📜</span>

        <div>
          <h3>JavaScript</h3>

          <p>
            تشغيل JavaScript ومشاهدة console مباشرة.
          </p>
        </div>

      </div>


      <div class="feature-card">

        <span>🌐</span>

        <div>
          <h3>HTML / CSS</h3>

          <p>
            معاينة صفحات الويب داخل Preview مستقل.
          </p>
        </div>

      </div>


      <div class="feature-card">

        <span>💾</span>

        <div>
          <h3>حفظ تلقائي</h3>

          <p>
            يتم حفظ آخر نسخة من الكود تلقائياً.
          </p>
        </div>

      </div>


      <div class="feature-card">

        <span>📥</span>

        <div>
          <h3>تنزيل</h3>

          <p>
            تنزيل الكود مباشرة كملف مناسب للغة.
          </p>
        </div>

      </div>


      <div class="feature-card">

        <span>📱</span>

        <div>
          <h3>متجاوب</h3>

          <p>
            يعمل على الهاتف والتابلت والكمبيوتر.
          </p>
        </div>

      </div>

    </div>

  </section>

</div>

</main>

<Footer />


<style>

:root {

  --bg-primary:#0d1117;

  --bg-secondary:#161b22;

  --bg-tertiary:#21262d;

  --border:#30363d;

  --text:#c9d1d9;

  --muted:#8b949e;

  --accent:#58a6ff;

  --success:#238636;

  --success-hover:#2ea043;

  --danger:#f85149;

  --warning:#d29922;

  --code:#e6edf3;

}


* {

  box-sizing:border-box;

}


body {

  margin:0;

  background:var(--bg-primary);

  color:var(--text);

  font-family:'Cairo',sans-serif;

}


.playground-main {

  min-height:90vh;

  padding:35px 15px 60px;

}


.container {

  max-width:1250px;

  margin:auto;

}


/* HEADER */

.page-header {

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:20px;

  margin-bottom:25px;

  padding-bottom:20px;

  border-bottom:1px solid var(--border);

}


.page-header h1 {

  margin:0 0 6px;

  color:var(--accent);

  font-size:30px;

  font-weight:800;

}


.page-header p {

  margin:0;

  color:var(--muted);

}


.header-actions {

  display:flex;

  gap:10px;

}


#langSelect {

  background:var(--bg-secondary);

  color:var(--text);

  border:1px solid var(--border);

  border-radius:9px;

  padding:10px 15px;

  font-family:inherit;

  cursor:pointer;

}


.btn-home {

  text-decoration:none;

  color:var(--accent);

  border:1px solid var(--border);

  border-radius:9px;

  padding:10px 16px;

}


.btn-home:hover {

  background:var(--bg-secondary);

}


/* EDITOR */

.editor-container {

  background:var(--bg-secondary);

  border:1px solid var(--border);

  border-radius:14px;

  overflow:hidden;

  box-shadow:0 20px 60px rgba(0,0,0,.3);

}


/* TOOLBAR */

.toolbar {

  min-height:65px;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:15px;

  padding:10px 15px;

  background:var(--bg-tertiary);

  border-bottom:1px solid var(--border);

}


.file-info {

  display:flex;

  align-items:center;

  gap:9px;

  font-family:'Fira Code',monospace;

}


.file-info > span:first-child {

  font-size:20px;

}


.save-status {

  font-family:'Cairo',sans-serif;

  font-size:11px;

  color:#3fb950;

  background:rgba(63,185,80,.1);

  padding:3px 7px;

  border-radius:5px;

}


.toolbar-buttons {

  display:flex;

  align-items:center;

  gap:6px;

}


.btn-tool {

  height:40px;

  min-width:40px;

  border:1px solid var(--border);

  border-radius:8px;

  background:transparent;

  color:var(--muted);

  cursor:pointer;

  transition:.2s;

}


.btn-tool:hover {

  color:white;

  background:var(--bg-secondary);

  border-color:var(--accent);

}


.btn-run {

  height:40px;

  padding:0 20px;

  border:0;

  border-radius:8px;

  background:var(--success);

  color:white;

  font-family:inherit;

  font-weight:700;

  cursor:pointer;

}


.btn-run:hover {

  background:var(--success-hover);

}


.btn-run:disabled {

  opacity:.6;

  cursor:not-allowed;

}


/* SEARCH */

.search-panel {

  display:none;

  align-items:center;

  gap:8px;

  padding:10px 15px;

  background:#11161d;

  border-bottom:1px solid var(--border);

}


.search-panel.active {

  display:flex;

}


.search-panel input {

  flex:1;

  background:var(--bg-secondary);

  color:var(--text);

  border:1px solid var(--border);

  border-radius:7px;

  padding:9px 12px;

  outline:none;

  font-family:inherit;

}


.search-panel button {

  width:35px;

  height:35px;

  border:0;

  border-radius:7px;

  background:var(--danger);

  color:white;

  cursor:pointer;

}


/* INPUT */

.input-section {

  padding:12px 15px;

  background:#0a0e13;

  border-bottom:1px solid var(--border);

}


.input-section label {

  display:block;

  margin-bottom:6px;

  color:var(--muted);

  font-size:13px;

  font-weight:600;

}


.input-section textarea {

  width:100%;

  min-height:60px;

  resize:vertical;

  background:var(--bg-secondary);

  color:var(--text);

  border:1px solid var(--border);

  border-radius:8px;

  padding:10px;

  outline:none;

  font-family:'Fira Code',monospace;

}


/* EDITOR */

.editor-wrapper {

  display:flex;

  direction:ltr;

  background:var(--bg-primary);

  min-height:430px;

}


.line-numbers {

  width:55px;

  padding:18px 12px;

  background:#090d12;

  border-right:1px solid var(--border);

  color:#484f58;

  font-family:'Fira Code',monospace;

  font-size:14px;

  line-height:1.7;

  text-align:right;

  user-select:none;

  overflow:hidden;

}


.code-editor {

  flex:1;

  min-width:0;

  min-height:430px;

  resize:vertical;

  padding:18px;

  border:0;

  outline:0;

  background:var(--bg-primary);

  color:var(--code);

  font-family:'Fira Code',monospace;

  font-size:14px;

  line-height:1.7;

  tab-size:4;

  white-space:pre;

  overflow:auto;

}


/* OUTPUT */

.output-section {

  border-top:1px solid var(--border);

}


.output-header {

  height:52px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  padding:0 15px;

  background:var(--bg-tertiary);

  border-bottom:1px solid var(--border);

  font-weight:700;

}


.console-button {

  background:transparent;

  color:var(--muted);

  border:0;

  cursor:pointer;

  font-family:inherit;

}


.console-button:hover {

  color:var(--danger);

}


.output-content {

  min-height:230px;

  background:#090d12;

  padding:20px;

  color:var(--code);

  font-family:'Fira Code',monospace;

  white-space:pre-wrap;

  overflow:auto;

}


.output-placeholder {

  text-align:center;

  color:var(--muted);

  padding:45px 10px;

  direction:rtl;

}


.terminal-icon {

  display:inline-flex;

  align-items:center;

  justify-content:center;

  width:60px;

  height:60px;

  margin-bottom:15px;

  border-radius:15px;

  background:var(--bg-tertiary);

  color:var(--accent);

  font-size:20px;

}


.output-placeholder p {

  margin:0 0 5px;

}


.output-placeholder small {

  color:#484f58;

}


/* PREVIEW */

.preview-frame {

  width:100%;

  min-height:400px;

  border:0;

  background:white;

}


/* FEATURES */

.features-section {

  margin-top:25px;

  padding:25px;

  background:var(--bg-secondary);

  border:1px solid var(--border);

  border-radius:14px;

}


.features-section h2 {

  margin:0 0 20px;

  color:var(--accent);

  font-size:21px;

}


.features-grid {

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(250px,1fr));

  gap:15px;

}


.feature-card {

  display:flex;

  gap:13px;

  padding:17px;

  background:var(--bg-primary);

  border:1px solid var(--border);

  border-radius:10px;

}


.feature-card > span {

  font-size:25px;

}


.feature-card h3 {

  margin:0 0 4px;

  font-size:16px;

}


.feature-card p {

  margin:0;

  color:var(--muted);

  font-size:13px;

}


/* FULLSCREEN */

.editor-container.fullscreen {

  position:fixed;

  inset:0;

  z-index:99999;

  width:100%;

  height:100vh;

  border-radius:0;

}


.editor-container.fullscreen .editor-wrapper {

  height:calc(100vh - 65px);

}


.editor-container.fullscreen .code-editor {

  height:100%;

}


/* MOBILE */

@media(max-width:800px) {

  .page-header {

    flex-direction:column;

    align-items:stretch;

  }


  .header-actions {

    flex-direction:column;

  }


  #langSelect,
  .btn-home {

    width:100%;

    text-align:center;

  }


  .toolbar {

    align-items:stretch;

    flex-direction:column;

  }


  .toolbar-buttons {

    flex-wrap:wrap;

  }


  .btn-run {

    flex:1;

  }


  .editor-wrapper {

    min-height:350px;

  }


  .code-editor {

    min-height:350px;

    font-size:12px;

  }


  .line-numbers {

    width:42px;

    padding-left:5px;

    padding-right:8px;

    font-size:12px;

  }


  .page-header h1 {

    font-size:23px;

  }

}


@media(max-width:480px) {

  .btn-tool {

    min-width:36px;

    height:38px;

    font-size:12px;

  }


  .btn-run {

    height:38px;

    padding:0 12px;

    font-size:13px;

  }


  .toolbar {

    padding:9px;

  }

}

</style>


<script>

document.addEventListener(
  'DOMContentLoaded',
  () => {

    /* ELEMENTS */

    const editor =
      document.getElementById(
        'codeEditor'
      );

    const lineNumbers =
      document.getElementById(
        'lineNumbers'
      );

    const output =
      document.getElementById(
        'output'
      );

    const langSelect =
      document.getElementById(
        'langSelect'
      );

    const inputSection =
      document.getElementById(
        'inputSection'
      );

    const userInput =
      document.getElementById(
        'userInput'
      );

    const runBtn =
      document.getElementById(
        'runBtn'
      );

    const saveBtn =
      document.getElementById(
        'saveBtn'
      );

    const resetBtn =
      document.getElementById(
        'resetBtn'
      );

    const downloadBtn =
      document.getElementById(
        'downloadBtn'
      );

    const clearBtn =
      document.getElementById(
        'clearBtn'
      );

    const searchBtn =
      document.getElementById(
        'searchBtn'
      );

    const searchPanel =
      document.getElementById(
        'searchPanel'
      );

    const searchInput =
      document.getElementById(
        'searchInput'
      );

    const closeSearch =
      document.getElementById(
        'closeSearch'
      );

    const fontPlus =
      document.getElementById(
        'fontPlus'
      );

    const fontMinus =
      document.getElementById(
        'fontMinus'
      );

    const fullscreenBtn =
      document.getElementById(
        'fullscreenBtn'
      );

    const editorContainer =
      document.getElementById(
        'editorContainer'
      );

    const fileName =
      document.getElementById(
        'fileName'
      );

    const fileIcon =
      document.getElementById(
        'fileIcon'
      );

    const saveStatus =
      document.getElementById(
        'saveStatus'
      );


    /* STATE */

    let currentLang =
      'python';

    let fontSize =
      14;

    let pyodideInstance =
      null;

    let pyodideLoading =
      null;


    /* EXAMPLES */

    const examples = {

      python: `# مرحباً بك في Th.Tech 🐍

name = input("أدخل اسمك: ")

print("مرحباً", name)

numbers = [1, 2, 3, 4, 5]

print("المجموع:", sum(numbers))`,


      javascript: `// مرحباً بك في Th.Tech 📜

console.log("مرحباً بالعالم!");

const numbers = [1, 2, 3, 4, 5];

console.log("الأرقام:", numbers);

const total = numbers.reduce(
  (a, b) => a + b,
  0
);

console.log("المجموع:", total);`,


      html: `<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<title>Th.Tech</title>

<style>

body {

  margin: 0;

  min-height: 100vh;

  display: flex;

  justify-content: center;

  align-items: center;

  font-family: Arial;

  background: linear-gradient(
    135deg,
    #58a6ff,
    #161b22
  );

}

.card {

  background: white;

  padding: 40px;

  border-radius: 20px;

  text-align: center;

}

h1 {

  color: #168acb;

}

</style>

</head>

<body>

<div class="card">

<h1>مرحباً بك في Th.Tech 👋</h1>

<p>هذه معاينة HTML / CSS</p>

</div>

</body>

</html>`

    };


    const extensions = {

      python:'py',

      javascript:'js',

      html:'html'

    };


    const icons = {

      python:'🐍',

      javascript:'📜',

      html:'🌐'

    };


    /* LINE NUMBERS */

    function updateLineNumbers() {

      const count =
        editor.value.split('\n').length;

      let numbers = '';

      for (
        let i = 1;
        i <= count;
        i++
      ) {

        numbers += i + '\n';

      }

      lineNumbers.textContent =
        numbers;

    }


    /* LOAD CODE */

    function loadCode() {

      const saved =
        localStorage.getItem(
          'thtech-code-' + currentLang
        );


      if (saved !== null) {

        editor.value = saved;

        saveStatus.textContent =
          'محفوظ';

      } else {

        editor.value =
          examples[currentLang];

        saveStatus.textContent =
          'مثال';

      }


      updateLineNumbers();

    }


    /* UPDATE INTERFACE */

    function updateInterface() {

      currentLang =
        langSelect.value;


      fileName.textContent =
        'main.' +
        extensions[currentLang];


      fileIcon.textContent =
        icons[currentLang];


      inputSection.style.display =
        currentLang === 'python'
          ? 'block'
          : 'none';


      loadCode();

      clearOutput();

    }


    /* PYODIDE */

    async function getPyodide() {

      if (pyodideInstance) {

        return pyodideInstance;

      }


      if (pyodideLoading) {

        return pyodideLoading;

      }


      if (
        typeof window.loadPyodide !==
        'function'
      ) {

        throw new Error(
          'لم يتم تحميل Python بعد.'
        );

      }


      pyodideLoading =
        window.loadPyodide({

          indexURL:
            'https://cdn.jsdelivr.net/pyodide/v0.24.1/full/'

        });


      pyodideInstance =
        await pyodideLoading;


      return pyodideInstance;

    }


    /* PYTHON */

    async function runPython(code) {

      const py =
        await getPyodide();


      let result = '';

      const values =
        userInput.value
          .split(/\r?\n/);


      let index = 0;


      py.setStdin({

        stdin: () => {

          if (
            index < values.length
          ) {

            return values[index++];

          }

          return '';

        }

      });


      py.setStdout({

        batched: (text) => {

          result += text;

        }

      });


      py.setStderr({

        batched: (text) => {

          result += text;

        }

      });


      await py.runPythonAsync(
        code
      );


      return result;

    }


    /* FORMAT */

    function formatValue(value) {

      if (
        typeof value === 'object' &&
        value !== null
      ) {

        try {

          return JSON.stringify(
            value,
            null,
            2
          );

        } catch {

          return String(value);

        }

      }


      return String(value);

    }


    /* JAVASCRIPT */

    function runJavaScript(code) {

      const logs = [];


      const customConsole = {

        log: (...args) => {

          logs.push(
            args
              .map(formatValue)
              .join(' ')
          );

        },


        warn: (...args) => {

          logs.push(
            '⚠️ ' +
            args
              .map(formatValue)
              .join(' ')
          );

        },


        error: (...args) => {

          logs.push(
            '❌ ' +
            args
              .map(formatValue)
              .join(' ')
          );

        }

      };


      const fn =
        new Function(
          'console',
          code
        );


      fn(customConsole);


      return logs.join('\n');

    }


    /* HTML */

    function runHTML(code) {

      output.innerHTML = '';


      const iframe =
        document.createElement(
          'iframe'
        );


      iframe.className =
        'preview-frame';


      iframe.setAttribute(
        'sandbox',
        'allow-scripts'
      );


      output.appendChild(
        iframe
      );


      const doc =
        iframe.contentDocument;


      doc.open();

      doc.write(code);

      doc.close();

    }


    /* RUN */

    async function runCode() {

      const code =
        editor.value.trim();


      if (!code) {

        output.innerHTML =
          '<span style="color:#d29922">⚠️ اكتب كوداً أولاً</span>';

        return;

      }


      runBtn.disabled =
        true;


      runBtn.textContent =
        '⏳ تشغيل...';


      try {

        if (
          currentLang === 'html'
        ) {

          runHTML(code);

          return;

        }


        output.textContent =
          '⏳ جاري التنفيذ...';


        let result = '';


        if (
          currentLang === 'python'
        ) {

          result =
            await runPython(
              code
            );

        }


        if (
          currentLang === 'javascript'
        ) {

          result =
            runJavaScript(
              code
            );

        }


        if (result.trim()) {

          output.textContent =
            result;

        } else {

          output.innerHTML = `

            <div style="
              color:#3fb950;
              text-align:center;
              padding:40px;
              direction:rtl;
            ">

              ✅ تم التنفيذ بنجاح

              <br>

              <small>
                لا توجد مخرجات
              </small>

            </div>

          `;

        }

      } catch (error) {

        output.innerHTML = `

          <div style="
            color:#f85149;
            direction:ltr;
            text-align:left;
            white-space:pre-wrap;
          ">

            ❌ Error

            ${escapeHTML(
              error.message ||
              String(error)
            )}

          </div>

        `;

      } finally {

        runBtn.disabled =
          false;

        runBtn.textContent =
          '▶ تشغيل';

      }

    }


    /* ESCAPE */

    function escapeHTML(value) {

      return String(value)

        .replaceAll(
          '&',
          '&amp;'
        )

        .replaceAll(
          '<',
          '&lt;'
        )

        .replaceAll(
          '>',
          '&gt;'
        )

        .replaceAll(
          '"',
          '&quot;'
        )

        .replaceAll(
          "'",
          '&#039;'
        );

    }


    /* SAVE */

    function saveCode() {

      localStorage.setItem(

        'thtech-code-' +
        currentLang,

        editor.value

      );


      saveStatus.textContent =
        'تم الحفظ ✓';


      setTimeout(() => {

        saveStatus.textContent =
          'محفوظ';

      }, 1500);

    }


    /* AUTO SAVE */

    let saveTimer;


    editor.addEventListener(
      'input',
      () => {

        updateLineNumbers();


        saveStatus.textContent =
          'جاري الحفظ...';


        clearTimeout(
          saveTimer
        );


        saveTimer =
          setTimeout(
            saveCode,
            700
          );

      }
    );


    /* DOWNLOAD */

    function downloadCode() {

      const blob =
        new Blob(
          [editor.value],
          {
            type:
              'text/plain;charset=utf-8'
          }
        );


      const url =
        URL.createObjectURL(
          blob
        );


      const link =
        document.createElement(
          'a'
        );


      link.href = url;


      link.download =
        'main.' +
        extensions[currentLang];


      link.click();


      URL.revokeObjectURL(
        url
      );

    }


    /* SEARCH */

    searchBtn.addEventListener(
      'click',
      () => {

        searchPanel.classList.add(
          'active'
        );

        searchInput.focus();

      }
    );


    closeSearch.addEventListener(
      'click',
      () => {

        searchPanel.classList.remove(
          'active'
        );

        searchInput.value = '';

      }
    );


    searchInput.addEventListener(
      'input',
      () => {

        const value =
          searchInput.value;


        if (!value) {

          return;

        }


        const index =
          editor.value.indexOf(
            value
          );


        if (index !== -1) {

          editor.focus();

          editor.setSelectionRange(
            index,
            index + value.length
          );

        }

      }
    );


    /* FONT SIZE */

    fontPlus.addEventListener(
      'click',
      () => {

        if (fontSize < 24) {

          fontSize += 1;

          editor.style.fontSize =
            fontSize + 'px';

        }

      }
    );


    fontMinus.addEventListener(
      'click',
      () => {

        if (fontSize > 10) {

          fontSize -= 1;

          editor.style.fontSize =
            fontSize + 'px';

        }

      }
    );


    /* RESET */

    resetBtn.addEventListener(
      'click',
      () => {

        const confirmReset =
          confirm(
            'هل تريد إعادة الكود إلى المثال الأصلي؟'
          );


        if (!confirmReset) {

          return;

        }


        localStorage.removeItem(
          'thtech-code-' +
          currentLang
        );


        editor.value =
          examples[currentLang];


        updateLineNumbers();

        clearOutput();

        saveStatus.textContent =
          'تمت الإعادة';

      }
    );


    /* CLEAR */

    clearBtn.addEventListener(
      'click',
      clearOutput
    );


    function clearOutput() {

      output.innerHTML = `

        <div class="output-placeholder">

          <div class="terminal-icon">
            ▶_
          </div>

          <p>
            اضغط على "تشغيل" لرؤية النتيجة
          </p>

          <small>
            Ctrl + Enter لتشغيل الكود
          </small>

        </div>

      `;

    }


    /* SAVE BUTTON */

    saveBtn.addEventListener(
      'click',
      saveCode
    );


    /* DOWNLOAD */

    downloadBtn.addEventListener(
      'click',
      downloadCode
    );


    /* LANGUAGE */

    langSelect.addEventListener(
      'change',
      updateInterface
    );


    /* RUN */

    runBtn.addEventListener(
      'click',
      runCode
    );


    /* FULLSCREEN */

    fullscreenBtn.addEventListener(
      'click',
      () => {

        editorContainer.classList.toggle(
          'fullscreen'
        );

      }
    );


    /* KEYBOARD */

    editor.addEventListener(
      'keydown',
      (event) => {

        /* TAB */

        if (
          event.key === 'Tab'
        ) {

          event.preventDefault();


          const start =
            editor.selectionStart;

          const end =
            editor.selectionEnd;


          editor.value =

            editor.value.substring(
              0,
              start
            ) +

            '    ' +

            editor.value.substring(
              end
            );


          editor.selectionStart =
            editor.selectionEnd =
            start + 4;


          updateLineNumbers();

        }


        /* CTRL ENTER */

        if (
          event.ctrlKey &&
          event.key === 'Enter'
        ) {

          event.preventDefault();

          runCode();

        }


        /* CTRL S */

        if (
          event.ctrlKey &&
          event.key.toLowerCase() === 's'
        ) {

          event.preventDefault();

          saveCode();

        }

      }
    );


    /* SCROLL */

    editor.addEventListener(
      'scroll',
      () => {

        lineNumbers.scrollTop =
          editor.scrollTop;

      }
    );


    /* INITIALIZE */

    updateInterface();

  }

);

</script>

</body>
</html>
