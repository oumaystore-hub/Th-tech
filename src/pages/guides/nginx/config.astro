---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ShareButtons from '../../../components/ShareButtons.astro';

export const title = "دليل Nginx والخوادم الشامل";
export const pubDate = "2026-08-21";

// ✅ متغيرات الأكواد (الطريقة الآمنة 100%)
const codeInstall = `sudo apt update
sudo apt install nginx -y
sudo systemctl enable nginx
sudo systemctl start nginx`;

const codeCheck = `sudo systemctl status nginx
nginx -v
curl -I http://localhost`;

const codeMkdir = `sudo mkdir -p /var/www/mywebsite
sudo chown -R www-data:www-data /var/www/mywebsite
sudo chmod -R 755 /var/www/mywebsite`;

const codeServer = `server {
    listen 80;
    server_name mywebsite.com www.mywebsite.com;
    root /var/www/mywebsite;
    index index.html;

    location / {
        try_files URI_PATH URI_PATH/ =404;
    }
}`;

const codeEnable = `sudo ln -s /etc/nginx/sites-available/mywebsite /etc/nginx/sites-enabled/
sudo nginx -t
sudo systemctl reload nginx`;

const codeProxy = `server {
    listen 80;
    server_name app.mywebsite.com;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade HTTP_UPGRADE_VAR;
        proxy_set_header Connection upgrade;
        proxy_set_header Host HOST_NAME_VAR;
    }
}`;

const codeCertbot = `sudo apt install certbot python3-certbot-nginx -y
sudo certbot --nginx -d mywebsite.com -d www.mywebsite.com`;

const codeSecurity = `server_tokens off;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
client_max_body_size 10M;`;

const codeGzip = `gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_types text/plain text/css application/json application/javascript text/xml;`;

const codeCache = `location ~* \\.(jpg|jpeg|png|gif|ico|css|js)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
}`;

const codeLoadBalance = `upstream backend_pool {
    least_conn;
    server 10.0.0.10;
    server 10.0.0.11;
    server 10.0.0.12 backup;
}

server {
    listen 80;
    server_name app.mywebsite.com;
    
    location / {
        proxy_pass http://backend_pool;
    }
}`;

const codeLogs = `# عرض السجلات مباشرة
tail -f /var/log/nginx/access.log

# عرض آخر 50 خطأ
tail -n 50 /var/log/nginx/error.log

# أكثر عناوين IP زيارة
awk '{print $1}' /var/log/nginx/access.log | sort | uniq -c | sort -nr | head`;

const codeLogFormat = `log_format custom 'REMOTE_ADDR - USER [TIME_LOCAL] "REQUEST" STATUS BODY_BYTES_SENT';
access_log /var/log/nginx/custom.log custom;`;

const codeTroubleshoot = `# التحقق من صحة الإعدادات
sudo nginx -t

# زيادة حجم الملفات المرفوعة (حل خطأ 413)
client_max_body_size 50M;

# إعادة التشغيل الآمن
sudo systemctl reload nginx`;

const codeQuickRef = `sudo nginx -t          # التحقق من الإعدادات
sudo systemctl restart nginx # إعادة التشغيل
sudo systemctl reload nginx  # إعادة تحميل التعديلات
nginx -v                   # عرض الإصدار
ls /etc/nginx/sites-enabled/ # عرض المواقع المفعلة`;
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <Header />
  
  <main class="linux-guide-main">
    
    <div class="page-header">
      <h1>⚙️ دليل Nginx والخوادم الشامل</h1>
      <p>من التثبيت إلى الاستضافة العكسية، SSL، والأمان</p>
    </div>

    <button class="toc-btn" id="tocBtn" aria-label="فتح الفهرس">📑</button>
    <div class="toc-modal" id="tocModal">
      <div class="toc-box">
        <div class="toc-head">
          <h3>فهرس الدليل</h3>
          <button class="toc-close" id="tocClose" aria-label="إغلاق الفهرس">✕</button>
        </div>
        <nav class="toc-nav" id="tocNav"></nav>
      </div>
    </div>

    <button class="back-to-top" id="backToTop" aria-label="العودة للأعلى">⬆️</button>

    <article class="guide-article">
      <span class="badge">دليل شامل</span>
      <h2>Nginx: من الصفر إلى الاحتراف</h2>
      <div class="meta"> 21 أغسطس 2026 | ️ 40 دقيقة قراءة</div>
      
      <p class="intro">
        Nginx هو خادم ويب عالي الأداء، يعمل كـ Reverse Proxy، وموازن حمل. يُستخدم من قبل أكبر المواقع في العالم لسرعته واستقراره.
      </p>

      <h3 id="part1"> الجزء الأول: مقدمة عن Nginx</h3>
      <p>يتميز Nginx ببنية غير متزامنة تعتمد على الأحداث.</p>
      <div class="conclusion-box"><h3>💡 خلاصة:</h3><ul><li>✅ Nginx سريع ومستقر.</li></ul></div>

      <h3 id="part2">🚀 الجزء الثاني: التثبيت</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeInstall}</code></pre></div>

      <h3 id="part3">📂 الجزء الثالث: إعداد المواقع</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeServer}</code></pre></div>

      <h3 id="part4">🔄 الجزء الرابع: الوكيل العكسي</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeProxy}</code></pre></div>

      <h3 id="part5">🔒 الجزء الخامس: SSL/HTTPS</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeCertbot}</code></pre></div>

      <h3 id="part6">🛡️ الجزء السادس: الأمان</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeSecurity}</code></pre></div>

      <h3 id="part7">⚡ الجزء السابع: الأداء</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeGzip}</code></pre></div>

      <h3 id="part8">⚖️ الجزء الثامن: موازنة الحمل</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeLoadBalance}</code></pre></div>

      <h3 id="part9">📊 الجزء التاسع: السجلات</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeLogs}</code></pre></div>

      <h3 id="part10">🔧 الجزء العاشر: استكشاف الأخطاء</h3>
      <div class="code-block"><div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div><pre><code>{codeTroubleshoot}</code></pre></div>

      <h3 id="part11">📋 الجزء الحادي عشر: الملخص السريع</h3>
      <p>جدول مرجعي سريع لأهم الأوامر والتوجيهات:</p>
      
      <!-- ✅ حاوية الجدول المتجاوبة -->
      <div class="table-responsive">
        <table class="cheat-sheet-table">
          <thead>
            <tr>
              <th>الأمر / التوجيه</th>
              <th>الوظيفة</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>sudo nginx -t</td><td>التحقق من صحة الإعدادات</td></tr>
            <tr><td>server_name</td><td>اسم النطاق (Domain)</td></tr>
            <tr><td>root</td><td>المسار الرئيسي للموقع</td></tr>
            <tr><td>proxy_pass</td><td>توجيه الطلبات للخادم الداخلي</td></tr>
            <tr><td>gzip on;</td><td>تفعيل ضغط البيانات</td></tr>
          </tbody>
        </table>
      </div>

      <p>أهم أوامر التحكم بالخدمة:</p>
      <div class="code-block">
        <div class="code-header"><button class="copy-btn" onclick="copyCode(this)">نسخ</button></div>
        <pre><code>{codeQuickRef}</code></pre>
      </div>

      <div class="conclusion-box">
        <h3>🎉 مبارك!</h3>
        <p style="margin-top: 0.5rem;">أصبحت الآن قادراً على إدارة خادم Nginx باحترافية عالية.</p>
      </div>

    </article>

    <ShareButtons />
  </main>
  
  <Footer />

  <script>
    function copyCode(btn) {
      const code = btn.closest('.code-block').querySelector('code').innerText;
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = 'تم النسخ!';
        setTimeout(() => btn.textContent = 'نسخ', 2000);
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var tocBtn = document.getElementById('tocBtn');
      var tocModal = document.getElementById('tocModal');
      var tocClose = document.getElementById('tocClose');
      var tocNav = document.getElementById('tocNav');
      
      if (tocBtn && tocModal && tocNav) {
        var headings = document.querySelectorAll('h3');
        headings.forEach(function(h3) {
          var item = document.createElement('div');
          item.className = 'toc-item';
          item.textContent = h3.textContent;
          item.addEventListener('click', function() {
            h3.scrollIntoView({ behavior: 'smooth' });
            tocModal.classList.remove('active');
          });
          tocNav.appendChild(item);
        });

        tocBtn.addEventListener('click', function() { tocModal.classList.add('active'); });
        tocClose.addEventListener('click', function() { tocModal.classList.remove('active'); });
        tocModal.addEventListener('click', function(e) {
          if (e.target === tocModal) tocModal.classList.remove('active');
        });
      }

      var backBtn = document.getElementById('backToTop');
      if (backBtn) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 400) backBtn.classList.add('show');
          else backBtn.classList.remove('show');
        });
        backBtn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });
  </script>
</body>
</html>

<style>
  :root { 
    --bg: #f8fafc; 
    --card: #ffffff; 
    --text: #0f172a; 
    --text-sec: #64748b; 
    --primary: #22c55e; 
    --primary-light: #4ade80; 
    --border: rgba(34,197,94,0.2); 
    --shadow: rgba(0,0,0,0.1); 
  }
  html.dark-mode { 
    --bg: #0f172a; 
    --card: #1e293b; 
    --text: #f1f5f9; 
    --text-sec: #94a3b8; 
    --primary: #22c55e; 
    --primary-light: #4ade80; 
    --border: rgba(34,197,94,0.3); 
    --shadow: rgba(0,0,0,0.4); 
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; line-height: 1.6; }
  
  .linux-guide-main { 
    max-width: 850px; 
    margin: 0 auto; 
    padding: 2rem 1rem; 
    position: relative; 
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-header { 
    text-align: center; 
    margin-bottom: 2rem; 
    padding: 2rem 1rem;
    width: 100%;
  }
  .page-header h1 { color: var(--primary); font-size: 2rem; margin-bottom: 0.5rem; font-weight: 800; }
  .page-header p { color: var(--text-sec); font-size: 1.1rem; }
  
  .guide-article { 
    background: var(--card); 
    border: 1px solid var(--border); 
    border-radius: 24px; 
    padding: 2.5rem; 
    margin-bottom: 2rem; 
    box-shadow: 0 8px 30px var(--shadow); 
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .badge { display: inline-block; background: linear-gradient(135deg,var(--primary),var(--primary-light)); color: white; padding: 0.4rem 1.2rem; border-radius: 50px; font-size: 0.85rem; margin-bottom: 1.5rem; }
  .guide-article h2 { color: var(--primary); font-size: 1.8rem; margin: 0 0 0.5rem; }
  .guide-article h3 { color: var(--text); font-size: 1.3rem; margin: 2.5rem 0 1rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; }
  .guide-article h4 { color: var(--text-sec); font-size: 1.1rem; margin: 1.5rem 0 0.5rem; font-weight: 600; }
  .meta { color: var(--text-sec); font-size: 0.85rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px dashed var(--border); }
  .intro { font-size: 1.1rem; color: var(--text-sec); margin-bottom: 2rem; padding: 1.5rem; background: rgba(34,197,94,0.05); border-right: 4px solid var(--primary); border-radius: 12px; line-height: 1.8; }
  .guide-article ul { padding-right: 1.5rem; margin: 1rem 0; color: var(--text-sec); }
  .guide-article li { margin-bottom: 0.6rem; line-height: 1.7; }
  .guide-article li strong { color: var(--primary); }
  
  .conclusion-box { background: linear-gradient(135deg,var(--primary),var(--primary-light)); color: white; padding: 1.5rem; border-radius: 16px; margin: 2rem 0; box-shadow: 0 4px 15px rgba(34,197,94,0.3); }
  .conclusion-box h3 { color: white; border: none; margin-bottom: 0.8rem; font-size: 1.1rem; }
  .conclusion-box ul { list-style: none; padding: 0; margin: 0; }
  .conclusion-box li { color: white; font-size: 1rem; margin: 0.5rem 0; line-height: 1.6; }

  .code-block { background: #1e293b; border-radius: 12px; margin: 1.5rem 0; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); }
  .code-header { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1rem; background: rgba(0,0,0,0.4); }
  .copy-btn { background: rgba(255,255,255,0.1); border: none; color: #94a3b8; padding: 0.3rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; }
  .copy-btn:hover { background: rgba(255,255,255,0.2); color: white; }
  .code-block pre { padding: 1.2rem; overflow-x: auto; direction: ltr; text-align: left; }
  .code-block code { background: none; padding: 0; color: #e2e8f0; font-size: 0.9rem; line-height: 1.6; }
  
  /* ✅ إصلاح الجدول المتجاوب */
  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--card);
  }
  .cheat-sheet-table {
    width: 100%;
    min-width: 300px; /* عرض مرن للجوال */
    border-collapse: collapse;
    text-align: right;
  }
  .cheat-sheet-table thead tr { background: var(--primary); color: white; }
  .cheat-sheet-table th, .cheat-sheet-table td { padding: 12px; border: 1px solid var(--border); }
  .cheat-sheet-table tbody tr { background: var(--card); }
  .cheat-sheet-table tbody tr:nth-child(even) { background: rgba(34, 197, 94, 0.05); }
  html.dark-mode .cheat-sheet-table tbody tr:nth-child(even) { background: rgba(34, 197, 94, 0.1); }
  .cheat-sheet-table td { font-family: monospace; color: var(--text); }

  .toc-btn { position: fixed; bottom: 25px; left: 25px; width: 50px; height: 50px; background: linear-gradient(135deg, var(--primary), var(--primary-light)); border: none; border-radius: 50%; color: white; font-size: 1.5rem; cursor: pointer; box-shadow: 0 4px 15px rgba(34,197,94,0.5); z-index: 1000; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; }
  .toc-btn:hover { transform: scale(1.1); }
  .toc-modal { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 1001; align-items: center; justify-content: center; padding: 1rem; }
  .toc-modal.active { display: flex; }
  .toc-box { background: var(--card); width: 100%; max-width: 400px; border-radius: 20px; box-shadow: 0 10px 30px var(--shadow); max-height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
  .toc-head { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); }
  .toc-head h3 { margin: 0; color: var(--primary); font-size: 1.1rem; }
  .toc-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-sec); }
  .toc-nav { padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }
  .toc-item { padding: 0.8rem 1rem; background: var(--bg); border-radius: 10px; cursor: pointer; color: var(--text); font-weight: 500; font-size: 0.9rem; }
  .toc-item:hover { background: rgba(34,197,94,0.1); color: var(--primary); }
  
  .back-to-top { position: fixed; bottom: 85px; left: 25px; width: 45px; height: 45px; background: var(--card); border: 2px solid var(--primary); border-radius: 50%; color: var(--primary); font-size: 1.2rem; cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(20px); transition: all 0.3s ease; z-index: 999; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px var(--shadow); }
  .back-to-top.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .back-to-top:hover { background: var(--primary); color: white; }

  @media (max-width: 768px) {
    .linux-guide-main { padding: 1rem 0.5rem; }
    .guide-article { padding: 1.5rem; border-radius: 16px; margin-bottom: 1rem; }
    .page-header { padding: 1.5rem 1rem; margin-bottom: 1rem; }
    .page-header h1 { font-size: 1.6rem; }
    .guide-article h2 { font-size: 1.4rem; }
    .guide-article h3 { font-size: 1.15rem; margin-top: 2rem; }
    .intro { padding: 1rem; font-size: 1rem; }
    .code-block pre { padding: 1rem; }
    .conclusion-box { padding: 1.2rem; }
    .cheat-sheet-table th, .cheat-sheet-table td { padding: 10px 8px; font-size: 0.9rem; }
  }
</style>
