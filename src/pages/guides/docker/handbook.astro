  <script>
    if (typeof window !== 'undefined') {
      document.addEventListener('DOMContentLoaded', function() {
        // ✅ زر الفهرس
        var tocBtn = document.getElementById('tocBtn');
        var tocModal = document.getElementById('tocModal');
        var tocClose = document.getElementById('tocClose');
        var tocNav = document.getElementById('tocNav');
        
        if (tocBtn && tocModal && tocNav) {
          document.querySelectorAll('.article h3').forEach(function(h3) {
            var item = document.createElement('div');
            item.className = 'toc-item';
            item.textContent = h3.textContent;
            item.onclick = function(e) {
              e.preventDefault();
              h3.scrollIntoView({ behavior: 'smooth' });
              tocModal.classList.remove('active');
            };
            tocNav.appendChild(item);
          });
          
          tocBtn.onclick = function() { tocModal.classList.add('active'); };
          tocClose.onclick = function() { tocModal.classList.remove('active'); };
          tocModal.onclick = function(e) { if (e.target === tocModal) tocModal.classList.remove('active'); };
        }

        // ✅ السهم المنبثق - تم تفعيله بشكل كامل
        var backBtn = document.getElementById('backToTop');
        if (backBtn) {
          window.addEventListener('scroll', function() {
            if (window.scrollY > 400) {
              backBtn.classList.add('show');
            } else {
              backBtn.classList.remove('show');
            }
          }, { passive: true });
          
          backBtn.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // ✅ التتبع الذكي
        var TRACK_TIME = 30;
        var SCROLL_THRESHOLD = 0.7;
        var currentPath = window.location.pathname;
        var isMarked = false;

        function markAsRead() {
          if (isMarked) return;
          try {
            var read = JSON.parse(localStorage.getItem('read_articles') || '[]');
            if (!read.includes(currentPath)) {
              read.push(currentPath);
              localStorage.setItem('read_articles', JSON.stringify(read));
            }
            isMarked = true;
          } catch (e) {}
        }

        try {
          if (JSON.parse(localStorage.getItem('read_articles') || '[]').includes(currentPath)) return;
        } catch (e) {}

        var timer = setTimeout(markAsRead, TRACK_TIME * 1000);
        function onScroll() {
          var percent = (window.scrollY + window.innerHeight) / document.body.scrollHeight;
          if (percent >= SCROLL_THRESHOLD) {
            markAsRead();
            clearTimeout(timer);
            window.removeEventListener('scroll', onScroll);
          }
        }
        window.addEventListener('scroll', onScroll);
        window.addEventListener('beforeunload', function() { clearTimeout(timer); window.removeEventListener('scroll', onScroll); });
      });
    }

    function copyCode(btn) {
      var code = btn.closest('.code-block').querySelector('code').textContent;
      navigator.clipboard.writeText(code).then(function() {
        btn.textContent = 'تم النسخ!';
        setTimeout(function() { btn.textContent = 'نسخ'; }, 2000);
      });
    }
  </script>
