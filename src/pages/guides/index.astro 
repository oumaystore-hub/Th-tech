---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "مجموعة شاملة من الأدلة السريعة، وأوامر Git و Linux، وحلول لمشاكل البرمجة الشائعة";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="guides-page">
    <div class="page-header">
      <h1>📚 أدلة ومرجعيات تقنية</h1>
      <p>حلول سريعة، أوامر جاهزة، ودليل عملي للمطورين</p>
    </div>

    <div class="cards-grid">
      <!-- بطاقة 1: Git -->
      <a href="/Th-tech/guides/git-cheatsheet/" class="guide-card">
        <span class="card-icon">🔧</span>
        <h3>أوامر Git المرجعية</h3>
        <p>دليل سريع لأهم 30 أمر في Git تحتاجها يومياً</p>
        <span class="badge">شائع</span>
      </a>

      <!-- بطاقة 2: Linux -->
      <a href="/Th-tech/guides/linux-commands/" class="guide-card">
        <span class="card-icon">🐧</span>
        <h3>أوامر Linux الأساسية</h3>
        <p>التصفح، إدارة الملفات، والصلاحيات في سطر الأوامر</p>
        <span class="badge">مهم</span>
      </a>

      <!-- بطاقة 3: Docker -->
      <a href="/Th-tech/guides/docker-quick/" class="guide-card">
        <span class="card-icon">🐳</span>
        <h3>Docker للمبتدئين</h3>
        <p>كيف تبني وتشغل الحاويات في دقائق</p>
        <span class="badge">جديد</span>
      </a>

      <!-- بطاقة 4: Nginx -->
      <a href="/Th-tech/guides/nginx-config/" class="guide-card">
        <span class="card-icon">⚙️</span>
        <h3>إعدادات Nginx الشائعة</h3>
        <p>ملفات الإعدادات الجاهزة للاستضافة العكسية والأمان</p>
      </a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  /* ✅ نفس متغيرات التصميم الحالية لضمان التطابق التام */
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
  }
  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
  }
  body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; }
  
  .guides-page { max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  
  .page-header { text-align: center; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 2px solid var(--border); }
  .page-header h1 { color: var(--primary); font-size: 2.2rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-sec); font-size: 1.1rem; }
  
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  
  .guide-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    position: relative;
    overflow: hidden;
  }
  
  .guide-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px var(--shadow);
    border-color: var(--primary);
  }
  
  .card-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .guide-card h3 { margin: 0; color: var(--text); font-size: 1.3rem; }
  .guide-card p { margin: 0; color: var(--text-sec); font-size: 0.95rem; line-height: 1.6; }
  
  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--primary);
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .guides-page { padding: 2rem 1rem 3rem !important; }
    .page-header h1 { font-size: 1.6rem !important; }
    .cards-grid { grid-template-columns: 1fr !important; }
  }
</style>
