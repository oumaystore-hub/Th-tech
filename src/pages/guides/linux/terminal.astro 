          <button class="copy-btn" onclick="copyCode(this)">نسخ</button>
        </div>
        <pre><code>#!/bin/bash
# backup.sh - نسخ احتياطي يومي

SOURCE="/home/ahmed/projects"
BACKUP_DIR="/mnt/backup"
DATE=$(date +%Y-%m-%d)
BACKUP_NAME="backup-$DATE.tar.gz"

# إنشاء مجلد النسخ إذا لم يوجد
mkdir -p "$BACKUP_DIR"

# تنفيذ النسخ
tar -czf "$BACKUP_DIR/$BACKUP_NAME" "$SOURCE"

# التحقق من النجاح
if [ $? -eq 0 ]; then
    echo "✅ Backup completed: $BACKUP_NAME"
    # حذف نسخ أقدم من 7 أيام
    find "$BACKUP_DIR" -name "backup-*.tar.gz" -mtime +7 -delete
else
    echo "❌ Backup failed!"
    exit 1
fi</code></pre>
