      <h4>8.1 أساسيات كتابة السكريبتات</h4>
      <p>
        Bash Scripting يسمح لك بأتمتة أي مهمة في Linux. إليك الهيكل الأساسي:
      </p>

      <div class="code-block">
        <div class="code-header">
          <span class="lang">bash</span>
          <button class="copy-btn" onclick="copyCode(this)">نسخ</button>
        </div>
        <pre><code>#!/bin/bash
# سطر Shebang يحدد المترجم

# تعليق: هذا سكريبت تجريبي
echo "مرحباً، $USER!"

# متغيرات
NAME="Ahmed"
echo "Hello, $NAME"

# مدخلات المستخدم
read -p "أدخل اسمك: " USERNAME
echo "أهلاً بك، $USERNAME"

# شروط
if [ "$USERNAME" == "admin" ]; then
    echo "مرحباً، أيها المسؤول!"
elif [ -z "$USERNAME" ]; then
    echo "لم تدخل اسماً!"
else
    echo "مرحباً، $USERNAME"
fi

# حلقات تكرار
for i in {1..5}; do
    echo "Iteration $i"
done

# معالجة الأوامر
FILES=$(ls *.txt)
for file in $FILES; do
    echo "Processing: $file"
done

# دوال
greet() {
    echo "Hello, $1!"
}
greet "World"

# الخروج برمز حالة
exit 0    # نجاح
exit 1    # خطأ</code></pre>
