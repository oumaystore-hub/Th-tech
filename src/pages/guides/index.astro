---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "أدلة ومرجعيات تقنية";
const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />

  <style>
    @media (max-width: 768px) {
      body * {
        box-sizing: border-box !important;
      }

      #mobile-grid {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0.6rem !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #mobile-grid .section-card {
        width: calc(50% - 0.3rem) !important;
        flex: 0 0 calc(50% - 0.3rem) !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0.8rem !important;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="guides-home">

    <div class="page-header">
      <h1>📚 أدلة ومرجعيات تقنية</h1>
      <p>
        16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين
      </p>
    </div>

    <div id="mobile-grid" class="sections-grid">

      <!-- 1. Git -->
      <a href="/Th-tech/guides/git/cheatsheet/" class="section-card">
        <span class="tech-icon git-icon" aria-label="Git">Git</span>
        <h3>Git وإدارة النسخ</h3>
        <p>أوامر، فروع، وسير عمل احترافي</p>
      </a>

      <!-- 2. Linux -->
      <a href="/Th-tech/guides/linux/terminal/" class="section-card">
        <span class="tech-icon linux-icon" aria-label="Linux">Linux</span>
        <h3>Linux وسطر الأوامر</h3>
        <p>أوامر أساسية، صلاحيات، وأتمتة</p>
      </a>

      <!-- 3. Docker -->
      <a href="/Th-tech/guides/docker/handbook/" class="section-card">
        <span class="tech-icon docker-icon" aria-label="Docker">Docker</span>
        <h3>Docker والحاويات</h3>
        <p>بناء، تشغيل، وإدارة الحاويات</p>
      </a>

      <!-- 4. Nginx -->
      <a href="/Th-tech/guides/nginx/config/" class="section-card">
        <span class="tech-icon nginx-icon" aria-label="Nginx">Nginx</span>
        <h3>Nginx والخوادم</h3>
        <p>إعدادات، استضافة عكسية، وأمان</p>
      </a>

      <!-- 5. VS Code -->
      <a href="/Th-tech/guides/vscode/setup/" class="section-card">
        <span class="tech-icon vscode-icon" aria-label="Visual Studio Code">
          VS<br />Code
        </span>
        <h3>VS Code والإنتاجية</h3>
        <p>اختصارات، إضافات، وإعدادات متقدمة</p>
      </a>

      <!-- 6. Shell -->
      <a href="/Th-tech/guides/shell/automation/" class="section-card">
        <span class="tech-icon shell-icon" aria-label="Shell">Shell</span>
        <h3>Shell Scripting</h3>
        <p>أتمتة المهام وسكربتات Bash</p>
      </a>

      <!-- 7. HTTP & APIs -->
      <a href="/Th-tech/guides/http-api/rest/" class="section-card">
        <span class="tech-icon http-icon" aria-label="HTTP API">API</span>
        <h3>HTTP &amp; APIs</h3>
        <p>رموز الحالة، REST، واختبار الطلبات</p>
      </a>

      <!-- 8. SQL -->
      <a href="/Th-tech/guides/sql/queries/" class="section-card">
        <span class="tech-icon sql-icon" aria-label="SQL">SQL</span>
        <h3>SQL وقواعد البيانات</h3>
        <p>استعلامات، ربط جداول، وتحسين الأداء</p>
      </a>

      <!-- 9. CSS -->
      <a href="/Th-tech/guides/css/layout/" class="section-card">
        <span class="tech-icon css-icon" aria-label="CSS">CSS</span>
        <h3>CSS وتخطيط الواجهات</h3>
        <p>Flexbox، Grid، وتجاوب الشاشات</p>
      </a>

      <!-- 10. JavaScript -->
      <a href="/Th-tech/guides/js/patterns/" class="section-card">
        <span class="tech-icon js-icon" aria-label="JavaScript">JS</span>
        <h3>JavaScript أنماط متقدمة</h3>
        <p>Async، Modules، وهياكل البيانات</p>
      </a>

      <!-- 11. Python -->
      <a href="/Th-tech/guides/python/automation/" class="section-card">
        <span class="tech-icon python-icon" aria-label="Python">Python</span>
        <h3>Python للأتمتة</h3>
        <p>سكربتات، مكتبات، ومعالجة البيانات</p>
      </a>

      <!-- 12. CI/CD -->
      <a href="/Th-tech/guides/cicd/pipeline/" class="section-card">
        <span class="tech-icon cicd-icon" aria-label="CI CD">CI/CD</span>
        <h3>CI/CD و DevOps</h3>
        <p>GitHub Actions، اختبار، ونشر تلقائي</p>
      </a>

      <!-- 13. Security -->
      <a href="/Th-tech/guides/security/crypto/" class="section-card">
        <span class="tech-icon security-icon" aria-label="Security">SSL</span>
        <h3>الأمان والتشفير</h3>
        <p>مفاتيح، HTTPS، وأفضل الممارسات</p>
      </a>

      <!-- 14. Networking -->
      <a href="/Th-tech/guides/networking/basics/" class="section-card">
        <span class="tech-icon networking-icon" aria-label="Networking">
          NET
        </span>
        <h3>أساسيات الشبكات</h3>
        <p>IP، DNS، منافذ، وأدوات الفحص</p>
      </a>

      <!-- 15. Regex -->
      <a href="/Th-tech/guides/regex/patterns/" class="section-card">
        <span class="tech-icon regex-icon" aria-label="Regular Expression">
          .*
        </span>
        <h3>Regex ومعالجة النصوص</h3>
        <p>أنماط، استبدال، وتحليل البيانات</p>
      </a>

      <!-- 16. Markdown -->
      <a href="/Th-tech/guides/markdown/docs/" class="section-card">
        <span class="tech-icon markdown-icon" aria-label="Markdown">
          MD
        </span>
        <h3>Markdown والتوثيق</h3>
        <p>تنسيق، جداول، وكتابة README احترافي</p>
      </a>

    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2, 132, 199, 0.2);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56, 189, 248, 0.2);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    line-height: 1.5;
  }

  .guides-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    width: 100%;
  }

  /* =========================
     HEADER
  ========================= */

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .page-header p {
    color: var(--text-sec);
    font-size: 0.95rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* =========================
     GRID
  ========================= */

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    width: 100%;
    list-style: none;
  }

  /* =========================
     CARDS
  ========================= */

  .section-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem;
    text-decoration: none !important;
    color: inherit !important;

    display: flex;
    flex-direction: column;
    gap: 0.6rem;

    min-height: 150px;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    border-color: var(--primary);
  }

  .section-card:active {
    transform: translateY(-1px);
  }

  /* =========================
     TECH BADGES
  ========================= */

  .tech-icon {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1.05;

    letter-spacing: -0.3px;

    text-align: center;

    flex-shrink: 0;

    border: 2px solid currentColor;

    box-shadow:
      0 3px 8px rgba(0, 0, 0, 0.08),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .section-card:hover .tech-icon {
    transform: scale(1.06);
    box-shadow:
      0 5px 12px rgba(0, 0, 0, 0.13),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* Git */
  .git-icon {
    background: #f05032;
    color: #ffffff;
  }

  /* Linux */
  .linux-icon {
    background: #111111;
    color: #ffffff;
  }

  /* Docker */
  .docker-icon {
    background: #2496ed;
    color: #ffffff;
  }

  /* Nginx */
  .nginx-icon {
    background: #009639;
    color: #ffffff;
  }

  /* VS Code */
  .vscode-icon {
    background: #007acc;
    color: #ffffff;
  }

  /* Shell */
  .shell-icon {
    background: #4eaa25;
    color: #ffffff;
  }

  /* HTTP/API */
  .http-icon {
    background: #6366f1;
    color: #ffffff;
  }

  /* SQL */
  .sql-icon {
    background: #336791;
    color: #ffffff;
  }

  /* CSS */
  .css-icon {
    background: #1572b6;
    color: #ffffff;
  }

  /* JavaScript */
  .js-icon {
    background: #f7df1e;
    color: #111111;
  }

  /* Python */
  .python-icon {
    background: #3776ab;
    color: #ffd343;
  }

  /* CI/CD */
  .cicd-icon {
    background: #24292f;
    color: #ffffff;
  }

  /* Security */
  .security-icon {
    background: #dc2626;
    color: #ffffff;
  }

  /* Networking */
  .networking-icon {
    background: #0ea5e9;
    color: #ffffff;
  }

  /* Regex */
  .regex-icon {
    background: #7c3aed;
    color: #ffffff;
    font-size: 1rem;
  }

  /* Markdown */
  .markdown-icon {
    background: #083fa1;
    color: #ffffff;
  }

  /* =========================
     CARD TEXT
  ========================= */

  .section-card h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-card p {
    margin: 0;
    color: var(--text-sec);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* =========================
     TABLET
  ========================= */

  @media (max-width: 900px) and (min-width: 769px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 768px) {
    .guides-home {
      padding: 1rem 0.5rem 3rem;
    }

    .page-header {
      margin-bottom: 1.2rem;
      padding-bottom: 1rem;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .page-header p {
      font-size: 0.8rem;
      line-height: 1.6;
      padding: 0 0.5rem;
    }

    .sections-grid {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 0.6rem !important;
      width: 100% !important;
    }

    .section-card {
      width: calc(50% - 0.3rem) !important;
      flex: 0 0 calc(50% - 0.3rem) !important;

      min-width: 0 !important;
      min-height: 145px;

      margin: 0 !important;
      padding: 0.8rem !important;

      border-radius: 12px;
      gap: 0.45rem;
    }

    .tech-icon {
      width: 42px;
      height: 42px;

      border-radius: 11px;

      font-size: 0.6rem;
    }

    .regex-icon {
      font-size: 0.9rem;
    }

    .section-card h3 {
      font-size: 0.82rem;
      line-height: 1.35;
    }

    .section-card p {
      font-size: 0.68rem;
      line-height: 1.45;
    }
  }

  /* =========================
     SMALL PHONES
  ========================= */

  @media (max-width: 380px) {
    #mobile-grid .section-card {
      width: 100% !important;
      flex: 0 0 100% !important;
    }

    .section-card {
      min-height: auto;
    }
  }

  /* =========================
     ACCESSIBILITY
  ========================= */

  .section-card:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card,
    .tech-icon {
      transition: none;
    }
  }
</style>
