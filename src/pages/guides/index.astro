---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";
---

<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>{title} - Th.Tech</title>

  <meta
    name="description"
    content={description}
  />

  <!-- Devicon 2.17.0 - نسخة ثابتة لضمان ظهور الأيقونات -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/devicon/2.17.0/devicon.min.css"
  />

  <style>
    @media (max-width: 768px) {
      body * {
        box-sizing: border-box !important;
      }

      #mobile-grid {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0.6rem !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #mobile-grid .section-card {
        width: calc(50% - 0.3rem) !important;
        flex: 0 0 calc(50% - 0.3rem) !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0.8rem !important;
      }
    }
  </style>
</head>

<body>

  <Header />

  <main class="guides-home">

    <div class="page-header">

      <h1>📚 أدلة ومرجعيات تقنية</h1>

      <p>
        16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين
      </p>

    </div>


    <div id="mobile-grid" class="sections-grid">


      <!-- =====================================
           1. GIT
      ====================================== -->

      <a
        href="/Th-tech/guides/git/cheatsheet/"
        class="section-card"
      >

        <div class="logo-box git-box">
          <i class="devicon-git-plain colored"></i>
        </div>

        <h3>Git وإدارة النسخ</h3>

        <p>
          أوامر، فروع، وسير عمل احترافي
        </p>

      </a>


      <!-- =====================================
           2. LINUX
      ====================================== -->

      <a
        href="/Th-tech/guides/linux/terminal/"
        class="section-card"
      >

        <div class="logo-box linux-box">
          <i class="devicon-linux-plain colored"></i>
        </div>

        <h3>Linux وسطر الأوامر</h3>

        <p>
          أوامر أساسية، صلاحيات، وأتمتة
        </p>

      </a>


      <!-- =====================================
           3. DOCKER
      ====================================== -->

      <a
        href="/Th-tech/guides/docker/handbook/"
        class="section-card"
      >

        <div class="logo-box docker-box">
          <i class="devicon-docker-plain colored"></i>
        </div>

        <h3>Docker والحاويات</h3>

        <p>
          بناء، تشغيل، وإدارة الحاويات
        </p>

      </a>


      <!-- =====================================
           4. NGINX
      ====================================== -->

      <a
        href="/Th-tech/guides/nginx/config/"
        class="section-card"
      >

        <div class="logo-box nginx-box">
          <i class="devicon-nginx-original colored"></i>
        </div>

        <h3>Nginx والخوادم</h3>

        <p>
          إعدادات، استضافة عكسية، وأمان
        </p>

      </a>


      <!-- =====================================
           5. VS CODE
      ====================================== -->

      <a
        href="/Th-tech/guides/vscode/setup/"
        class="section-card"
      >

        <div class="logo-box vscode-box">
          <i class="devicon-vscode-plain colored"></i>
        </div>

        <h3>VS Code والإنتاجية</h3>

        <p>
          اختصارات، إضافات، وإعدادات متقدمة
        </p>

      </a>


      <!-- =====================================
           6. BASH
      ====================================== -->

      <a
        href="/Th-tech/guides/shell/automation/"
        class="section-card"
      >

        <div class="logo-box bash-box">
          <i class="devicon-bash-plain colored"></i>
        </div>

        <h3>Shell Scripting</h3>

        <p>
          أتمتة المهام وسكربتات Bash
        </p>

      </a>


      <!-- =====================================
           7. HTTP / API
      ====================================== -->

      <a
        href="/Th-tech/guides/http-api/rest/"
        class="section-card"
      >

        <div class="logo-box api-box">

          <span class="api-symbol">
            API
          </span>

        </div>

        <h3>HTTP & APIs</h3>

        <p>
          رموز الحالة، REST، واختبار الطلبات
        </p>

      </a>


      <!-- =====================================
           8. SQL
      ====================================== -->

      <a
        href="/Th-tech/guides/sql/queries/"
        class="section-card"
      >

        <div class="logo-box sql-box">
          <i class="devicon-mysql-original colored"></i>
        </div>

        <h3>SQL وقواعد البيانات</h3>

        <p>
          استعلامات، ربط جداول، وتحسين الأداء
        </p>

      </a>


      <!-- =====================================
           9. CSS
      ====================================== -->

      <a
        href="/Th-tech/guides/css/layout/"
        class="section-card"
      >

        <div class="logo-box css-box">
          <i class="devicon-css3-plain colored"></i>
        </div>

        <h3>CSS وتخطيط الواجهات</h3>

        <p>
          Flexbox، Grid، وتجاوب الشاشات
        </p>

      </a>


      <!-- =====================================
           10. JAVASCRIPT
      ====================================== -->

      <a
        href="/Th-tech/guides/js/patterns/"
        class="section-card"
      >

        <div class="logo-box javascript-box">
          <i class="devicon-javascript-plain colored"></i>
        </div>

        <h3>JavaScript أنماط متقدمة</h3>

        <p>
          Async، Modules، وهياكل البيانات
        </p>

      </a>


      <!-- =====================================
           11. PYTHON
      ====================================== -->

      <a
        href="/Th-tech/guides/python/automation/"
        class="section-card"
      >

        <div class="logo-box python-box">
          <i class="devicon-python-plain colored"></i>
        </div>

        <h3>Python للأتمتة</h3>

        <p>
          سكربتات، مكتبات، ومعالجة البيانات
        </p>

      </a>


      <!-- =====================================
           12. CI/CD
      ====================================== -->

      <a
        href="/Th-tech/guides/cicd/pipeline/"
        class="section-card"
      >

        <div class="logo-box github-box">
          <i class="devicon-github-original colored"></i>
        </div>

        <h3>CI/CD و DevOps</h3>

        <p>
          GitHub Actions، اختبار، ونشر تلقائي
        </p>

      </a>


      <!-- =====================================
           13. SECURITY
           OpenSSL
      ====================================== -->

      <a
        href="/Th-tech/guides/security/crypto/"
        class="section-card"
      >

        <div class="logo-box security-box">

          <i class="devicon-openssl-plain colored"></i>

        </div>

        <h3>الأمان والتشفير</h3>

        <p>
          مفاتيح، HTTPS، وأفضل الممارسات
        </p>

      </a>


      <!-- =====================================
           14. NETWORKING
           Cisco - شعار رسمي احترافي
      ====================================== -->

      <a
        href="/Th-tech/guides/networking/basics/"
        class="section-card"
      >

        <div class="logo-box network-box">

          <i class="devicon-cisco-plain colored"></i>

        </div>

        <h3>أساسيات الشبكات</h3>

        <p>
          IP، DNS، منافذ، وأدوات الفحص
        </p>

      </a>


      <!-- =====================================
           15. REGEX
           Perl - شعار أصلي متاح في Devicon
      ====================================== -->

      <a
        href="/Th-tech/guides/regex/patterns/"
        class="section-card"
      >

        <div class="logo-box regex-box">

          <i class="devicon-perl-plain colored"></i>

        </div>

        <h3>Regex ومعالجة النصوص</h3>

        <p>
          أنماط، استبدال، وتحليل البيانات
        </p>

      </a>


      <!-- =====================================
           16. MARKDOWN
      ====================================== -->

      <a
        href="/Th-tech/guides/markdown/docs/"
        class="section-card"
      >

        <div class="logo-box markdown-box">

          <i class="devicon-markdown-original colored"></i>

        </div>

        <h3>Markdown والتوثيق</h3>

        <p>
          تنسيق، جداول، وكتابة README احترافي
        </p>

      </a>


    </div>

  </main>


  <Footer />

</body>
</html>


<style>

  /* =========================================
     VARIABLES
  ========================================= */

  :root {

    --bg: #f8fafc;

    --card: #ffffff;

    --text: #0f172a;

    --text-sec: #64748b;

    --primary: #0284c7;

    --border: rgba(2,132,199,0.20);

  }


  html.dark-mode {

    --bg: #0b1120;

    --card: #1e293b;

    --text: #f1f5f9;

    --text-sec: #94a3b8;

    --primary: #38bdf8;

    --border: rgba(56,189,248,0.20);

  }


  /* =========================================
     GLOBAL
  ========================================= */

  * {

    box-sizing: border-box;

    margin: 0;

    padding: 0;

  }


  html,
  body {

    width: 100%;

    min-height: 100%;

  }


  body {

    background: var(--bg);

    color: var(--text);

    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    line-height: 1.5;

    overflow-x: hidden;

  }


  /* =========================================
     MAIN
  ========================================= */

  .guides-home {

    max-width: 1200px;

    margin: 0 auto;

    padding: 2rem 1rem 4rem;

    width: 100%;

  }


  /* =========================================
     HEADER
  ========================================= */

  .page-header {

    text-align: center;

    margin-bottom: 2rem;

    padding-bottom: 1.5rem;

    border-bottom:
      2px solid
      var(--border);

  }


  .page-header h1 {

    color: var(--primary);

    font-size: 1.8rem;

    margin-bottom: 0.5rem;

    font-weight: 800;

  }


  .page-header p {

    color: var(--text-sec);

    font-size: 0.95rem;

    max-width: 600px;

    margin: 0 auto;

  }


  /* =========================================
     GRID
  ========================================= */

  .sections-grid {

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 1.2rem;

    width: 100%;

  }


  /* =========================================
     CARD
  ========================================= */

  .section-card {

    background: var(--card);

    border:
      2px solid
      var(--border);

    border-radius: 14px;

    padding: 1.2rem;

    text-decoration: none !important;

    color: inherit !important;

    display: flex;

    flex-direction: column;

    gap: 0.6rem;

    min-height: 150px;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;

  }


  .section-card:hover {

    transform:
      translateY(-4px);

    box-shadow:
      0 8px 22px
      rgba(0,0,0,0.10);

    border-color:
      var(--primary);

  }


  /* =========================================
     LOGO CONTAINER
  ========================================= */

  .logo-box {

    width: 54px;

    height: 54px;

    flex:
      0 0 54px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 15px;

    background: #f8fafc;

    border:
      1px solid
      rgba(15,23,42,0.08);

    box-shadow:
      0 4px 12px
      rgba(15,23,42,0.08);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

  }


  .section-card:hover .logo-box {

    transform:
      scale(1.05);

    box-shadow:
      0 7px 16px
      rgba(15,23,42,0.13);

  }


  /* =========================================
     DEVICON
  ========================================= */

  .logo-box i {

    display: inline-block;

    font-size: 34px;

    line-height: 1;

    font-style: normal;

  }


  /* =========================================
     BRAND BACKGROUNDS
  ========================================= */

  .git-box {

    background:
      rgba(240,80,50,0.10);

  }


  .linux-box {

    background:
      rgba(255,193,7,0.12);

  }


  .docker-box {

    background:
      rgba(36,150,237,0.11);

  }


  .nginx-box {

    background:
      rgba(0,150,57,0.10);

  }


  .vscode-box {

    background:
      rgba(0,122,204,0.11);

  }


  .bash-box {

    background:
      rgba(78,170,37,0.11);

  }


  .api-box {

    background:
      rgba(37,99,235,0.10);

  }


  .sql-box {

    background:
      rgba(68,121,161,0.11);

  }


  .css-box {

    background:
      rgba(21,114,182,0.11);

  }


  .javascript-box {

    background:
      rgba(247,223,30,0.18);

  }


  .python-box {

    background:
      rgba(55,118,171,0.11);

  }


  .github-box {

    background:
      rgba(36,41,47,0.10);

  }


  /* OpenSSL */

  .security-box {

    background:
      rgba(88,75,155,0.11);

  }


  /* Cisco */

  .network-box {

    background:
      rgba(4,113,187,0.12);

  }


  /* Perl */

  .regex-box {

    background:
      rgba(57,75,87,0.11);

  }


  .markdown-box {

    background:
      rgba(8,63,161,0.10);

  }


  /* =========================================
     API
  ========================================= */

  .api-symbol {

    font-family:
      "Courier New",
      monospace;

    font-size: 18px;

    font-weight: 900;

    color: #2563eb;

    letter-spacing: -1px;

  }


  /* =========================================
     TEXT
  ========================================= */

  .section-card h3 {

    margin: 0;

    color:
      var(--text);

    font-size:
      0.95rem;

    font-weight:
      700;

    line-height:
      1.3;

  }


  .section-card p {

    margin: 0;

    color:
      var(--text-sec);

    font-size:
      0.8rem;

    line-height:
      1.4;

  }


  /* =========================================
     DARK MODE
  ========================================= */

  html.dark-mode .logo-box {

    background:
      #0f172a;

    border-color:
      rgba(255,255,255,0.08);

    box-shadow:
      0 5px 14px
      rgba(0,0,0,0.25);

  }


  html.dark-mode .linux-box {

    background:
      rgba(255,193,7,0.10);

  }


  html.dark-mode .javascript-box {

    background:
      rgba(247,223,30,0.10);

  }


  html.dark-mode .github-box {

    background:
      rgba(255,255,255,0.07);

  }


  html.dark-mode .security-box {

    background:
      rgba(88,75,155,0.16);

  }


  html.dark-mode .network-box {

    background:
      rgba(4,113,187,0.16);

  }


  html.dark-mode .regex-box {

    background:
      rgba(57,75,87,0.16);

  }


  /* =========================================
     TABLET
  ========================================= */

  @media (max-width: 900px) {

    .sections-grid {

      grid-template-columns:
        repeat(2, 1fr);

    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media (max-width: 768px) {

    .guides-home {

      padding:
        1rem
        0.5rem
        3rem;

    }


    .page-header {

      margin-bottom:
        1.2rem;

      padding-bottom:
        1rem;

    }


    .page-header h1 {

      font-size:
        1.4rem;

    }


    .page-header p {

      font-size:
        0.82rem;

    }


    .sections-grid {

      display:
        flex !important;

      flex-wrap:
        wrap !important;

      gap:
        0.6rem !important;

    }


    .section-card {

      width:
        calc(50% - 0.3rem) !important;

      flex:
        0 0
        calc(50% - 0.3rem) !important;

      min-width:
        0 !important;

      padding:
        0.8rem !important;

      min-height:
        145px;

      border-radius:
        12px;

    }


    .logo-box {

      width:
        44px;

      height:
        44px;

      flex-basis:
        44px;

      border-radius:
        11px;

    }


    .logo-box i {

      font-size:
        27px;

    }


    .api-symbol {

      font-size:
        15px;

    }


    .section-card h3 {

      font-size:
        0.82rem;

    }


    .section-card p {

      font-size:
        0.68rem;

    }

  }


  /* =========================================
     SMALL PHONES
  ========================================= */

  @media (max-width: 380px) {

    #mobile-grid .section-card {

      width:
        100% !important;

      flex:
        0 0
        100% !important;

    }

  }


  /* =========================================
     TOUCH
  ========================================= */

  @media (hover: none) {

    .section-card:hover {

      transform:
        none;

      box-shadow:
        none;

    }


    .section-card:active {

      transform:
        scale(0.98);

    }

  }

</style>
