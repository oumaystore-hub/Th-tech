---

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />  <style>
    @media (max-width: 768px) {
      body * {
        box-sizing: border-box !important;
      }

      #mobile-grid {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0.6rem !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #mobile-grid .section-card {
        width: calc(50% - 0.3rem) !important;
        flex: 0 0 calc(50% - 0.3rem) !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0.8rem !important;
      }
    }
  </style></head><body>
  <Header />  <main class="guides-home"><div class="page-header">
  <h1>📚 أدلة ومرجعيات تقنية</h1>
  <p>16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين</p>
</div>

<div id="mobile-grid" class="sections-grid">

  <!-- 1 Git -->
  <a href="/Th-tech/guides/git/cheatsheet/" class="section-card">
    <span class="tech-logo git-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21.62 11.108 12.892 2.38a1.33 1.33 0 0 0-1.884 0L9.12 4.268l2.398 2.398c.572-.194 1.228-.064 1.683.391.457.457.585 1.114.39 1.687l2.31 2.31c.572-.195 1.23-.067 1.687.39.638.638.638 1.672 0 2.31-.638.638-1.672.638-2.31 0-.48-.48-.599-1.18-.36-1.774l-2.158-2.158v5.678c.157.078.3.182.423.305.638.638.638 1.672 0 2.31-.638.638-1.672.638-2.31 0-.638-.638-.638-1.672 0-2.31.158-.158.343-.28.54-.36V9.72a1.69 1.69 0 0 1-.54-.36c-.638-.638-.638-1.672 0-2.31L8.99 5.65 2.38 12.26a1.33 1.33 0 0 0 0 1.884l8.728 8.728a1.33 1.33 0 0 0 1.884 0l8.628-8.628a1.33 1.33 0 0 0 0-1.884Z"/>
      </svg>
    </span>
    <h3>Git وإدارة النسخ</h3>
    <p>أوامر، فروع، وسير عمل احترافي</p>
  </a>

  <!-- 2 Linux -->
  <a href="/Th-tech/guides/linux/terminal/" class="section-card">
    <span class="tech-logo linux-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.02 2C8.52 2 7.4 4.64 7.4 7.67c0 1.66.42 3.08-.92 4.52-.98 1.05-2.48 2.03-2.48 3.98 0 2.07 1.67 3.2 3.62 3.2.94 0 1.67-.3 2.34-.65.67-.35 1.28-.73 2.04-.73.77 0 1.38.38 2.05.73.67.35 1.4.65 2.34.65 1.95 0 3.62-1.13 3.62-3.2 0-1.95-1.5-2.93-2.48-3.98-1.34-1.44-.92-2.86-.92-4.52C16.61 4.64 15.5 2 12.02 2ZM9.7 8.1c.44 0 .8.36.8.8s-.36.8-.8.8-.8-.36-.8-.8.36-.8.8-.8Zm4.62 0c.44 0 .8.36.8.8s-.36.8-.8.8-.8-.36-.8-.8.36-.8.8-.8ZM8.4 12.3c.72 0 1.25.47 1.8.47.55 0 1.08-.47 1.8-.47.72 0 1.25.47 1.8.47.55 0 1.08-.47 1.8-.47-.2 1.35-1.28 2.25-3.6 2.25s-3.4-.9-3.6-2.25Z"/>
      </svg>
    </span>
    <h3>Linux وسطر الأوامر</h3>
    <p>أوامر أساسية، صلاحيات، وأتمتة</p>
  </a>

  <!-- 3 Docker -->
  <a href="/Th-tech/guides/docker/handbook/" class="section-card">
    <span class="tech-logo docker-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8.3h2.7v2.7H4V8.3Zm3.2 0h2.7v2.7H7.2V8.3Zm3.2 0h2.7v2.7h-2.7V8.3Zm3.2 0h2.7v2.7h-2.7V8.3ZM7.2 5.1h2.7v2.7H7.2V5.1Zm3.2 0h2.7v2.7h-2.7V5.1Zm3.2 0h2.7v2.7h-2.7V5.1Zm-6.4 6.4h2.7v2.7H7.2v-2.7Zm3.2 0h2.7v2.7h-2.7v-2.7Zm3.2 0h2.7v2.7h-2.7v-2.7Zm3.2 0h2.7v2.7h-2.7v-2.7ZM3.2 14.1h3.1v2.7H4.8c1.2 2.4 3.6 3.2 6.4 3.2 4.2 0 7.1-2.1 8.7-5.9.4-1 .6-2 .7-3h-3.1v-2h3.7c.2-.5.5-1 .9-1.4.2.8.2 1.4.2 1.9 0 4.9-3.2 10.9-10.9 10.9-3.6 0-6.5-1.7-8-4.4H2l1.2-2Z"/>
      </svg>
    </span>
    <h3>Docker والحاويات</h3>
    <p>بناء، تشغيل، وإدارة الحاويات</p>
  </a>

  <!-- 4 Nginx -->
  <a href="/Th-tech/guides/nginx/config/" class="section-card">
    <span class="tech-logo nginx-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.2 20.5 7v10L12 21.8 3.5 17V7L12 2.2Zm0 2.2L5.5 8v8L12 19.8l6.5-3.8V8L12 4.4Zm-3.1 4h1.5l3.8 5.1V8.4h1.5v7.2h-1.5l-3.8-5.1v5.1H8.9V8.4Z"/>
      </svg>
    </span>
    <h3>Nginx والخوادم</h3>
    <p>إعدادات، استضافة عكسية، وأمان</p>
  </a>

  <!-- 5 VS Code -->
  <a href="/Th-tech/guides/vscode/setup/" class="section-card">
    <span class="tech-logo vscode-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.5 2.4 10 9.2 6.2 6.1 3 7.9l5.3 4.4L3 16.7l3.2 1.8 3.8-3.1 7.5 6.8L21 20.7V3.3l-3.5-.9Zm.1 4.1v11l-5.2-4.9 5.2-6.1Z"/>
      </svg>
    </span>
    <h3>VS Code والإنتاجية</h3>
    <p>اختصارات، إضافات، وإعدادات متقدمة</p>
  </a>

  <!-- 6 Shell -->
  <a href="/Th-tech/guides/shell/automation/" class="section-card">
    <span class="tech-logo shell-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4h16v16H4V4Zm2 3.3v2.1l2.7 2.1L6 13.6v2.1l5-4.2-5-4.2Zm6.4 8.2h5v-1.8h-5v1.8Z"/>
      </svg>
    </span>
    <h3>Shell Scripting</h3>
    <p>أتمتة المهام وسكربتات Bash</p>
  </a>

  <!-- 7 HTTP -->
  <a href="/Th-tech/guides/http-api/rest/" class="section-card">
    <span class="tech-logo http-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 5h16v14H4V5Zm2 2v10h12V7H6Zm2 2h2.4c1.8 0 2.9.9 2.9 2.3 0 1-.6 1.8-1.6 2.1l2 2.1h-2.1l-1.7-2h-.1v2H8V9Zm1.8 1.5v1.6h.5c.7 0 1.1-.3 1.1-.8s-.4-.8-1.1-.8h-.5Z"/>
      </svg>
    </span>
    <h3>HTTP & APIs</h3>
    <p>رموز الحالة، REST، واختبار الطلبات</p>
  </a>

  <!-- 8 SQL -->
  <a href="/Th-tech/guides/sql/queries/" class="section-card">
    <span class="tech-logo sql-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 5.5C5 3.8 8.1 2.5 12 2.5s7 1.3 7 3v13c0 1.7-3.1 3-7 3s-7-1.3-7-3v-13Zm2 0c0 .5 1.8 1.2 5 1.2s5-.7 5-1.2-1.8-1.2-5-1.2-5 .7-5 1.2Zm0 4.3c1.2.8 3.1 1.2 5 1.2s3.8-.4 5-1.2V7.6c-1.3.7-3.1 1.1-5 1.1s-3.7-.4-5-1.1v2.2Zm0 4.4c1.2.8 3.1 1.2 5 1.2s3.8-.4 5-1.2V12c-1.3.7-3.1 1.1-5 1.1s-3.7-.4-5-1.1v2.2Zm0 4.3c1.2.8 3.1 1.2 5 1.2s3.8-.4 5-1.2v-2.2c-1.3.7-3.1 1.1-5 1.1s-3.7-.4-5-1.1v2.2Z"/>
      </svg>
    </span>
    <h3>SQL وقواعد البيانات</h3>
    <p>استعلامات، ربط جداول، وتحسين الأداء</p>
  </a>

  <!-- 9 CSS -->
  <a href="/Th-tech/guides/css/layout/" class="section-card">
    <span class="tech-logo css-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m4 3 1.4 15.7L12 21l6.6-2.3L20 3H4Zm12.7 5.2H8.3l.2 2.1h8l-.5 5.4-4 1.4-4-1.4-.3-3h2.1l.2 1.4 2 .7 2-.7.2-1.7H7.5L7 6.3h9.9l-.2 1.9Z"/>
      </svg>
    </span>
    <h3>CSS وتخطيط الواجهات</h3>
    <p>Flexbox، Grid، وتجاوب الشاشات</p>
  </a>

  <!-- 10 JavaScript -->
  <a href="/Th-tech/guides/js/patterns/" class="section-card">
    <span class="tech-logo js-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 3h18v18H3V3Zm8.8 12.7c0 1.7-1 2.5-2.5 2.5-1.3 0-2.2-.6-2.7-1.5l1.5-.9c.3.5.6.8 1.2.8.5 0 .8-.2.8-.9v-4.8h1.7v4.8Zm4.1 2.5c-1.4 0-2.4-.6-2.9-1.5l1.5-.9c.4.6.8.9 1.5.9.6 0 1-.3 1-.7 0-.5-.4-.7-1.1-1l-.4-.2c-1.2-.5-2-1.1-2-2.4 0-1.2.9-2.2 2.4-2.2 1.1 0 1.9.4 2.5 1.4l-1.5 1c-.3-.5-.6-.7-1-.7-.5 0-.8.2-.8.6 0 .4.3.6 1 .9l.4.2c1.4.6 2.1 1.2 2.1 2.5-.1 1.3-1.1 2.1-2.7 2.1Z"/>
      </svg>
    </span>
    <h3>JavaScript أنماط متقدمة</h3>
    <p>Async، Modules، وهياكل البيانات</p>
  </a>

  <!-- 11 Python -->
  <a href="/Th-tech/guides/python/automation/" class="section-card">
    <span class="tech-logo python-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11.8 2C8.2 2 6.1 3.4 6.1 5.8v1.7h5.8v.9H6.1C3.5 8.4 2 10 2 12.5s1.5 4.1 4.1 4.1h1.5v-2.1c0-1.5 1.3-2.7 2.8-2.7h5.7c1.3 0 2.3-1 2.3-2.3V5.8C18.4 3.3 15.9 2 11.8 2Zm-3.1 2.1c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1ZM12.2 22c3.6 0 5.7-1.4 5.7-3.8v-1.7h-5.8v-.9h5.8c2.6 0 4.1-1.6 4.1-4.1s-1.5-4.1-4.1-4.1h-1.5v2.1c0 1.5-1.3 2.7-2.8 2.7H8c-1.3 0-2.3 1-2.3 2.3v3.7c0 2.5 2.5 3.8 6.5 3.8Zm3.1-2.1c-.6 0-1-.4-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1Z"/>
      </svg>
    </span>
    <h3>Python للأتمتة</h3>
    <p>سكربتات، مكتبات، ومعالجة البيانات</p>
  </a>

  <!-- 12 CI/CD -->
  <a href="/Th-tech/guides/cicd/pipeline/" class="section-card">
    <span class="tech-logo cicd-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3 4.5 7.2v5.1c0 4.7 3.2 7.5 7.5 8.7 4.3-1.2 7.5-4 7.5-8.7V7.2L12 3Zm0 2.3 5.3 3v4c0 3.3-2 5.5-5.3 6.7-3.3-1.2-5.3-3.4-5.3-6.7v-4l5.3-3ZM8 11.5h8v1.7H8v-1.7Z"/>
      </svg>
    </span>
    <h3>CI/CD و DevOps</h3>
    <p>GitHub Actions، اختبار، ونشر تلقائي</p>
  </a>

  <!-- 13 Security -->
  <a href="/Th-tech/guides/security/crypto/" class="section-card">
    <span class="tech-logo security-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.5 20 5.7v5.7c0 5-3.1 8.7-8 10.1-4.9-1.4-8-5.1-8-10.1V5.7l8-3.2Zm0 2.2L6.2 7v4.4c0 3.6 2 6.5 5.8 7.8 3.8-1.3 5.8-4.2 5.8-7.8V7L12 4.7Zm0 3.2c-1.6 0-2.8 1.2-2.8 2.8v1.1H8v1.7h8v-1.7h-1.2v-1.1c0-1.6-1.2-2.8-2.8-2.8Zm0 1.7c.6 0 1.1.5 1.1 1.1v1.1h-2.2v-1.1c0-.6.5-1.1 1.1-1.1Z"/>
      </svg>
    </span>
    <h3>الأمان والتشفير</h3>
    <p>مفاتيح، HTTPS، وأفضل الممارسات</p>
  </a>

  <!-- 14 Networking -->
  <a href="/Th-tech/guides/networking/basics/" class="section-card">
    <span class="tech-logo network-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-7 12a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm14 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-7-4.8-4.2 3.1 1 1.3 3.2-2.4 3.2 2.4 1-1.3-4.2-3.1Z"/>
      </svg>
    </span>
    <h3>أساسيات الشبكات</h3>
    <p>IP، DNS، منافذ، وأدوات الفحص</p>
  </a>

  <!-- 15 Regex -->
  <a href="/Th-tech/guides/regex/patterns/" class="section-card">
    <span class="tech-logo regex-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10.5 4.5a6 6 0 1 0 3.8 10.6l3.9 3.9 1.2-1.2-3.9-3.9a6 6 0 0 0-5-9.4Zm0 1.8a4.2 4.2 0 1 1 0 8.4 4.2 4.2 0 0 1 0-8.4Zm-1 1.1v1.5H8v1.6h1.5V12h1.7v-1.5h1.5V8.9h-1.5V7.4H9.5Z"/>
      </svg>
    </span>
    <h3>Regex ومعالجة النصوص</h3>
    <p>أنماط، استبدال، وتحليل البيانات</p>
  </a>

  <!-- 16 Markdown -->
  <a href="/Th-tech/guides/markdown/docs/" class="section-card">
    <span class="tech-logo markdown-logo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm1.8 7.5V9.5h2.1l1.6 2 1.6-2h2.1v5h-1.8v-2.5l-1.9 2.2-1.9-2.2v2.5H6.8Zm10-5v3.2h-2l2.8 3 2.8-3h-2V9.5h-1.6Z"/>
      </svg>
    </span>
    <h3>Markdown والتوثيق</h3>
    <p>تنسيق، جداول، وكتابة README احترافي</p>
  </a>

</div>

  </main>  <Footer />
</body>
</html><style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .guides-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-sec);
    font-size: 0.95rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    width: 100%;
    list-style: none;
  }

  .section-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem;
    text-decoration: none !important;
    color: inherit !important;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 145px;
    transition: all 0.2s ease;
  }

  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.1);
    border-color: var(--primary);
  }

  /* =========================
     TECH LOGOS
     ========================= */

  .tech-logo {
    width: 46px;
    height: 46px;
    min-width: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    padding: 9px;
    background: #fff;
    border: 2px solid currentColor;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
  }

  .tech-logo svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  /* ألوان العلامات الرسمية/المعروفة */

  .git-logo {
    color: #F05032;
    background: #fff5f2;
  }

  .linux-logo {
    color: #111111;
    background: #fffbea;
  }

  .docker-logo {
    color: #2496ED;
    background: #eef8ff;
  }

  .nginx-logo {
    color: #009639;
    background: #effcf4;
  }

  .vscode-logo {
    color: #007ACC;
    background: #eef8ff;
  }

  .shell-logo {
    color: #333333;
    background: #f4f4f4;
  }

  .http-logo {
    color: #FF6C37;
    background: #fff5ee;
  }

  .sql-logo {
    color: #4479A1;
    background: #f0f7fb;
  }

  .css-logo {
    color: #1572B6;
    background: #eef7fc;
  }

  .js-logo {
    color: #F7DF1E;
    background: #fffde7;
  }

  .python-logo {
    color: #3776AB;
    background: #eef6fc;
  }

  .cicd-logo {
    color: #2088FF;
    background: #eff7ff;
  }

  .security-logo {
    color: #6C63FF;
    background: #f2f1ff;
  }

  .network-logo {
    color: #0078D4;
    background: #eef7ff;
  }

  .regex-logo {
    color: #8A2BE2;
    background: #f8f0ff;
  }

  .markdown-logo {
    color: #24292F;
    background: #f2f3f5;
  }

  .section-card h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-card p {
    margin: 0;
    color: var(--text-sec);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  @media (max-width: 768px) {

    .guides-home {
      padding: 1rem 0.5rem 3rem;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .sections-grid {
      gap: 0.6rem;
    }

    .section-card {
      padding: 0.8rem;
      min-height: 135px;
    }

    .tech-logo {
      width: 40px;
      height: 40px;
      min-width: 40px;
      padding: 8px;
      border-radius: 10px;
    }

    .section-card h3 {
      font-size: 0.85rem;
    }

    .section-card p {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 380px) {

    #mobile-grid .section-card {
      width: 100% !important;
      flex: 0 0 100% !important;
    }
  }
</style>
