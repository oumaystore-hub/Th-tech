---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="guides-home">
    <div class="page-header">
      <h1>📚 أدلة ومرجعيات تقنية</h1>
      <p>16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين</p>
    </div>

    <div class="sections-grid">
      <!-- 1. Git -->
      <a href="/guides/git/" class="section-card">
        <span class="icon">📦</span>
        <h3>Git وإدارة النسخ</h3>
        <p>أوامر، فروع، وسير عمل احترافي</p>
      </a>
      <!-- 2. Linux -->
      <a href="/guides/linux/" class="section-card">
        <span class="icon">🐧</span>
        <h3>Linux وسطر الأوامر</h3>
        <p>أوامر أساسية، صلاحيات، وأتمتة</p>
      </a>
      <!-- 3. Docker -->
      <a href="/guides/docker/" class="section-card">
        <span class="icon">🐳</span>
        <h3>Docker والحاويات</h3>
        <p>بناء، تشغيل، وإدارة الحاويات</p>
      </a>
      <!-- 4. Nginx -->
      <a href="/guides/nginx/" class="section-card">
        <span class="icon">🌐</span>
        <h3>Nginx والخوادم</h3>
        <p>إعدادات، استضافة عكسية، وأمان</p>
      </a>
      <!-- 5. VS Code -->
      <a href="/guides/vscode/" class="section-card">
        <span class="icon">💻</span>
        <h3>VS Code والإنتاجية</h3>
        <p>اختصارات، إضافات، وإعدادات متقدمة</p>
      </a>
      <!-- 6. Shell -->
      <a href="/guides/shell/" class="section-card">
        <span class="icon">⌨️</span>
        <h3>Shell Scripting</h3>
        <p>أتمتة المهام وسكربتات Bash</p>
      </a>
      <!-- 7. HTTP -->
      <a href="/guides/http-api/" class="section-card">
        <span class="icon">🔌</span>
        <h3>HTTP & APIs</h3>
        <p>رموز الحالة، REST، واختبار الطلبات</p>
      </a>
      <!-- 8. SQL -->
      <a href="/guides/sql/" class="section-card">
        <span class="icon">🗄️</span>
        <h3>SQL وقواعد البيانات</h3>
        <p>استعلامات، ربط جداول، وتحسين الأداء</p>
      </a>
      <!-- 9. CSS -->
      <a href="/guides/css/" class="section-card">
        <span class="icon">🎨</span>
        <h3>CSS وتخطيط الواجهات</h3>
        <p>Flexbox، Grid، وتجاوب الشاشات</p>
      </a>
      <!-- 10. JS -->
      <a href="/guides/js/" class="section-card">
        <span class="icon">⚡</span>
        <h3>JavaScript أنماط متقدمة</h3>
        <p>Async، Modules، وهياكل البيانات</p>
      </a>
      <!-- 11. Python -->
      <a href="/guides/python/" class="section-card">
        <span class="icon"></span>
        <h3>Python للأتمتة</h3>
        <p>سكربتات، مكتبات، ومعالجة البيانات</p>
      </a>
      <!-- 12. CI/CD -->
      <a href="/guides/cicd/" class="section-card">
        <span class="icon">🔄</span>
        <h3>CI/CD و DevOps</h3>
        <p>GitHub Actions، اختبار، ونشر تلقائي</p>
      </a>
      <!-- 13. Security -->
      <a href="/guides/security/" class="section-card">
        <span class="icon">️</span>
        <h3>الأمان والتشفير</h3>
        <p>مفاتيح، HTTPS، وأفضل الممارسات</p>
      </a>
      <!-- 14. Networking -->
      <a href="/guides/networking/" class="section-card">
        <span class="icon">📡</span>
        <h3>أساسيات الشبكات</h3>
        <p>IP، DNS، منافذ، وأدوات الفحص</p>
      </a>
      <!-- 15. Regex -->
      <a href="/guides/regex/" class="section-card">
        <span class="icon">🔍</span>
        <h3>Regex ومعالجة النصوص</h3>
        <p>أنماط، استبدال، وتحليل البيانات</p>
      </a>
      <!-- 16. Markdown -->
      <a href="/guides/markdown/" class="section-card">
        <span class="icon">📝</span>
        <h3>Markdown والتوثيق</h3>
        <p>تنسيق، جداول، وكتابة README احترافي</p>
      </a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc; --card: #ffffff; --text: #0f172a; --text-sec: #64748b;
    --primary: #0284c7; --border: rgba(2,132,199,0.2); --shadow: rgba(0,0,0,0.1);
  }
  html.dark-mode {
    --bg: #0b1120; --card: #1e293b; --text: #f1f5f9; --text-sec: #94a3b8;
    --primary: #38bdf8; --border: rgba(56,189,248,0.2); --shadow: rgba(0,0,0,0.3);
  }
  body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; }

  .guides-home { max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .page-header { text-align: center; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 2px solid var(--border); }
  .page-header h1 { color: var(--primary); font-size: 2.2rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-sec); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  /* ✅ شبكة إجبارية بثلاث أعمدة */
  .sections-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 1.5rem !important;
    width: 100%;
  }

  .section-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 1.8rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .section-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px var(--shadow);
    border-color: var(--primary);
  }

  .section-card .icon {
    font-size: 2.2rem;
    background: rgba(2,132,199,0.1);
    width: 50px; height: 50px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 12px;
  }

  .section-card h3 { margin: 0; color: var(--text); font-size: 1.15rem; font-weight: 700; }
  .section-card p { margin: 0; color: var(--text-sec); font-size: 0.9rem; line-height: 1.5; }

  /* ✅ تجاوب كامل */
  @media (max-width: 992px) {
    .sections-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 650px) {
    .sections-grid { grid-template-columns: 1fr !important; }
    .guides-home { padding: 2rem 1rem 4rem; }
    .page-header h1 { font-size: 1.6rem; }
  }
</style>
