---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />

  <!-- الحل النووي للجوال - يطبق فوراً -->
  <style>
    @media (max-width: 768px) {
      body * {
        box-sizing: border-box !important;
      }

      #mobile-grid {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0.6rem !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #mobile-grid .section-card {
        width: calc(50% - 0.3rem) !important;
        flex: 0 0 calc(50% - 0.3rem) !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0.8rem !important;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="guides-home">

    <div class="page-header">
      <h1>أدلة ومرجعيات تقنية</h1>
      <p>16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين</p>
    </div>

    <div id="mobile-grid" class="sections-grid">

      <!-- 1. Git -->
      <a href="/Th-tech/guides/git/cheatsheet/" class="section-card">
        <span class="icon icon-git" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M21.6 11.2 12.8 2.4a1.36 1.36 0 0 0-1.92 0l-8.8 8.8a1.36 1.36 0 0 0 0 1.92l8.8 8.8a1.36 1.36 0 0 0 1.92 0l8.8-8.8a1.36 1.36 0 0 0 0-1.92Z"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="m8 8 8 8M8 16l3-3m2-5 3-3"
              stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <h3>Git وإدارة النسخ</h3>
        <p>أوامر، فروع، وسير عمل احترافي</p>
      </a>

      <!-- 2. Linux -->
      <a href="/Th-tech/guides/linux/terminal/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="m7 8 3 3-3 3m5 0h4"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>Linux وسطر الأوامر</h3>
        <p>أوامر أساسية، صلاحيات، وأتمتة</p>
      </a>

      <!-- 3. Docker -->
      <a href="/Th-tech/guides/docker/handbook/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M3 13h18M5 9h3v3H5V9Zm4 0h3v3H9V9Zm4 0h3v3h-3V9ZM9 5h3v3H9V5Zm4 0h3v3h-3V5Z"
              stroke="currentColor" stroke-width="1.5"
              stroke-linejoin="round"/>
            <path d="M4 13c.7 4 3.2 6 7.4 6 4.5 0 7.1-1.8 8.6-5.5"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round"/>
          </svg>
        </span>
        <h3>Docker والحاويات</h3>
        <p>بناء، تشغيل، وإدارة الحاويات</p>
      </a>

      <!-- 4. Nginx -->
      <a href="/Th-tech/guides/nginx/config/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="8.5"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 16V8l8 8V8"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>Nginx والخوادم</h3>
        <p>إعدادات، استضافة عكسية، وأمان</p>
      </a>

      <!-- 5. VS Code -->
      <a href="/Th-tech/guides/vscode/setup/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m15 4 5 2.5v11L15 20l-9-7 9-9Z"
              stroke="currentColor" stroke-width="1.7"
              stroke-linejoin="round"/>
            <path d="m6 13 5-4 4 3v8M6 13l-2-1.5 2-2 9 7"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>VS Code والإنتاجية</h3>
        <p>اختصارات، إضافات، وإعدادات متقدمة</p>
      </a>

      <!-- 6. Shell -->
      <a href="/Th-tech/guides/shell/automation/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="4" width="18" height="16" rx="2.5"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="m7 9 3 3-3 3m5 0h5"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>Shell Scripting</h3>
        <p>أتمتة المهام وسكربتات Bash</p>
      </a>

      <!-- 7. HTTP & APIs -->
      <a href="/Th-tech/guides/http-api/rest/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 7h16M4 12h10M4 17h7"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round"/>
            <path d="m17 13 3 3-3 3m3-3h-6"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>HTTP & APIs</h3>
        <p>رموز الحالة، REST، واختبار الطلبات</p>
      </a>

      <!-- 8. SQL -->
      <a href="/Th-tech/guides/sql/queries/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <ellipse cx="12" cy="6" rx="7" ry="3"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"
              stroke="currentColor" stroke-width="1.7"/>
          </svg>
        </span>
        <h3>SQL وقواعد البيانات</h3>
        <p>استعلامات، ربط جداول، وتحسين الأداء</p>
      </a>

      <!-- 9. CSS -->
      <a href="/Th-tech/guides/css/layout/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m5 3 14 2-2 15-5 2-5-2L5 3Z"
              stroke="currentColor" stroke-width="1.7"
              stroke-linejoin="round"/>
            <path d="M8 8h8M8.5 12h7l-.5 4-3 1-3-1"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>CSS وتخطيط الواجهات</h3>
        <p>Flexbox، Grid، وتجاوب الشاشات</p>
      </a>

      <!-- 10. JavaScript -->
      <a href="/Th-tech/guides/js/patterns/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="2"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 16c0 1.1.8 2 2 2s2-.9 2-2c0-2-4-1.2-4-4 0-1.1.9-2 2-2 1.1 0 2 .7 2 1.7M15 10v6c0 1.2.8 2 2 2 .8 0 1.4-.3 2-.9"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round"/>
          </svg>
        </span>
        <h3>JavaScript أنماط متقدمة</h3>
        <p>Async، Modules، وهياكل البيانات</p>
      </a>

      <!-- 11. Python -->
      <a href="/Th-tech/guides/python/automation/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3c-3 0-4 1.3-4 3.5V9h4v2H7c-2.2 0-3.5 1-3.5 4s1.3 5 3.5 5h2v-3h-2"
              stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 21c3 0 4-1.3 4-3.5V15h-4v-2h5c2.2 0 3.5-1 3.5-4S19.2 4 17 4h-2v3h2"
              stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="9.5" cy="6.5" r=".7" fill="currentColor"/>
            <circle cx="14.5" cy="17.5" r=".7" fill="currentColor"/>
          </svg>
        </span>
        <h3>Python للأتمتة</h3>
        <p>سكربتات، مكتبات، ومعالجة البيانات</p>
      </a>

      <!-- 12. CI/CD -->
      <a href="/Th-tech/guides/cicd/pipeline/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="6" cy="6" r="2.5"
              stroke="currentColor" stroke-width="1.7"/>
            <circle cx="18" cy="18" r="2.5"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 7.5 16 16.5M6 8.5v5a4 4 0 0 0 4 4h5.5"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round"/>
            <path d="m16 5 3 3-3 3"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>CI/CD و DevOps</h3>
        <p>GitHub Actions، اختبار، ونشر تلقائي</p>
      </a>

      <!-- 13. Security -->
      <a href="/Th-tech/guides/security/crypto/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3 20 6v5c0 5-3.3 8.2-8 10-4.7-1.8-8-5-8-10V6l8-3Z"
              stroke="currentColor" stroke-width="1.7"
              stroke-linejoin="round"/>
            <rect x="8.5" y="10" width="7" height="6" rx="1"
              stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 10V8.8a2 2 0 0 1 4 0V10"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round"/>
          </svg>
        </span>
        <h3>الأمان والتشفير</h3>
        <p>مفاتيح، HTTPS، وأفضل الممارسات</p>
      </a>

      <!-- 14. Networking -->
      <a href="/Th-tech/guides/networking/basics/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="9" y="3" width="6" height="6" rx="1.5"
              stroke="currentColor" stroke-width="1.7"/>
            <rect x="3" y="15" width="6" height="6" rx="1.5"
              stroke="currentColor" stroke-width="1.7"/>
            <rect x="15" y="15" width="6" height="6" rx="1.5"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M12 9v3m0 0H6v3m6-3h6v3"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round"/>
          </svg>
        </span>
        <h3>أساسيات الشبكات</h3>
        <p>IP، DNS، منافذ، وأدوات الفحص</p>
      </a>

      <!-- 15. Regex -->
      <a href="/Th-tech/guides/regex/patterns/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="10.5" cy="10.5" r="6"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="m15 15 5 5M8 8l5 5m0-5-5 5"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round"/>
          </svg>
        </span>
        <h3>Regex ومعالجة النصوص</h3>
        <p>أنماط، استبدال، وتحليل البيانات</p>
      </a>

      <!-- 16. Markdown -->
      <a href="/Th-tech/guides/markdown/docs/" class="section-card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 5h16a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 20 19H4a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 4 5Z"
              stroke="currentColor" stroke-width="1.7"/>
            <path d="M6.5 15V9l3 3 3-3v6m2.5-6v6m0-6-2 2m2-2 2 2"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3>Markdown والتوثيق</h3>
        <p>تنسيق، جداول، وكتابة README احترافي</p>
      </a>

    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .guides-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-sec);
    font-size: 0.95rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* الكمبيوتر: 3 أعمدة */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    width: 100%;
    list-style: none;
  }

  .section-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem;
    text-decoration: none !important;
    color: inherit !important;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 130px;
    transition: all 0.2s ease;
  }

  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.1);
    border-color: var(--primary);
  }

  /* أيقونات SVG */
  .section-card .icon {
    font-size: 1.8rem;
    background: rgba(2,132,199,0.1);
    color: var(--primary);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .section-card .icon svg {
    width: 25px;
    height: 25px;
    display: block;
  }

  .section-card h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-card p {
    margin: 0;
    color: var(--text-sec);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* للجوال */
  @media (max-width: 768px) {

    .guides-home {
      padding: 1rem 0.5rem 3rem;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .sections-grid {
      gap: 0.6rem;
    }

    .section-card {
      padding: 0.8rem;
    }

    .section-card .icon {
      font-size: 1.5rem;
      width: 35px;
      height: 35px;
    }

    .section-card .icon svg {
      width: 21px;
      height: 21px;
    }

    .section-card h3 {
      font-size: 0.85rem;
    }

    .section-card p {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 380px) {

    #mobile-grid .section-card {
      width: 100% !important;
      flex: 0 0 100% !important;
    }
  }
</style>
