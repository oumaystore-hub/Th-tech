---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const title = "أدلة ومرجعيات تقنية";
export const description = "16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />

  <style>
    @media (max-width: 768px) {
      body * {
        box-sizing: border-box !important;
      }

      #mobile-grid {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0.6rem !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #mobile-grid .section-card {
        width: calc(50% - 0.3rem) !important;
        flex: 0 0 calc(50% - 0.3rem) !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0.8rem !important;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="guides-home">

    <div class="page-header">
      <h1>📚 أدلة ومرجعيات تقنية</h1>
      <p>
        16 قسماً متخصصاً يضم أدلة عملية، أوامر سريعة، ومرجعيات للمطورين
      </p>
    </div>

    <div id="mobile-grid" class="sections-grid">

      <!-- 1. Git -->
      <a href="/Th-tech/guides/git/cheatsheet/" class="section-card">
        <span class="icon" aria-label="Git">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.62 11.1 12.9 2.38a1.3 1.3 0 0 0-1.84 0l-1.8 1.8 2.28 2.28a1.55 1.55 0 0 1 1.96 1.98l2.2 2.2a1.55 1.55 0 1 1-.93.92l-2.06-2.06v5.43a1.55 1.55 0 1 1-1.27-.04V9.3a1.55 1.55 0 0 1-.84-2.03L8.32 5.04 2.38 10.98a1.3 1.3 0 0 0 0 1.84l8.72 8.72a1.3 1.3 0 0 0 1.84 0l8.68-8.6a1.3 1.3 0 0 0 0-1.84Z"/>
          </svg>
        </span>
        <h3>Git وإدارة النسخ</h3>
        <p>أوامر، فروع، وسير عمل احترافي</p>
      </a>

      <!-- 2. Linux -->
      <a href="/Th-tech/guides/linux/terminal/" class="section-card">
        <span class="icon" aria-label="Linux">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.1 2.1c-3.1 0-4.3 3.5-4.3 6.5 0 2.1-.5 3.2-1.4 4.3-.7.9-1.6 1.8-1.6 3.2 0 2.1 2.2 3.7 5.1 3.7 1.1 0 1.8-.2 2.2-.2.5 0 1.2.2 2.3.2 2.9 0 5.1-1.6 5.1-3.7 0-1.4-.9-2.3-1.6-3.2-.9-1.1-1.4-2.2-1.4-4.3 0-3-1.2-6.5-4.4-6.5Zm-2 8.1c-.6 0-1.1-.5-1.1-1.1S9.5 8 10.1 8s1.1.5 1.1 1.1-.5 1.1-1.1 1.1Zm3.8 0c-.6 0-1.1-.5-1.1-1.1S13.3 8 13.9 8 15 8.5 15 9.1s-.5 1.1-1.1 1.1ZM8.7 14c.9.8 2 1.2 3.3 1.2s2.4-.4 3.3-1.2c-.3 1.5-1.5 2.4-3.3 2.4S9 15.5 8.7 14Z"/>
          </svg>
        </span>
        <h3>Linux وسطر الأوامر</h3>
        <p>أوامر أساسية، صلاحيات، وأتمتة</p>
      </a>

      <!-- 3. Docker -->
      <a href="/Th-tech/guides/docker/handbook/" class="section-card">
        <span class="icon" aria-label="Docker">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.4 10.4c-.5-.4-1.4-.6-2.4-.4-.2-1.2-.8-2.1-1.7-2.8l-.5-.4-.4.5c-.6.8-.8 1.8-.7 2.8.1.5.3.9.6 1.3h-1.4V7.8h-2.5V6.1H10v1.7H7.5v1.7H5v1.9H2.8c-.1.9.1 2 .6 2.9.6 1.2 1.7 2.1 3 2.6 1.7.6 3.7.7 5.8.2 2.7-.6 5-2.2 6.4-4.3 1.1 0 2.1-.2 2.8-.8.7-.5 1.1-1.2 1.2-2.1l.1-.4-.3-.1ZM5.8 12.1h2v1.7h-2v-1.7Zm2.5 0h2v1.7h-2v-1.7Zm2.5 0h2v1.7h-2v-1.7Zm-2.5-2h2v1.6h-2v-1.6Zm2.5 0h2v1.6h-2v-1.6Z"/>
          </svg>
        </span>
        <h3>Docker والحاويات</h3>
        <p>بناء، تشغيل، وإدارة الحاويات</p>
      </a>

      <!-- 4. Nginx -->
      <a href="/Th-tech/guides/nginx/config/" class="section-card">
        <span class="icon" aria-label="Nginx">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 4h3l9 11.4V4h3v16h-3l-9-11.4V20h-3V4Z"/>
          </svg>
        </span>
        <h3>Nginx والخوادم</h3>
        <p>إعدادات، استضافة عكسية، وأمان</p>
      </a>

      <!-- 5. VS Code -->
      <a href="/Th-tech/guides/vscode/setup/" class="section-card">
        <span class="icon" aria-label="Visual Studio Code">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.6 3.2 10 10.8 6.7 7.5 4 9l4.7 3-4.7 3 2.7 1.5L10 13.2l7.6 7.6L20 19.5v-15l-2.4-1.3ZM17 7v10l-5-5 5-5Z"/>
          </svg>
        </span>
        <h3>VS Code والإنتاجية</h3>
        <p>اختصارات، إضافات، وإعدادات متقدمة</p>
      </a>

      <!-- 6. Bash -->
      <a href="/Th-tech/guides/shell/automation/" class="section-card">
        <span class="icon" aria-label="Bash">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2.2 2.3 1.4-1 3.1 3.7-3.1 3.7-1.4-1 2.3-2.7-2.3-2.7Zm5.2 5.1h3.8v1.5h-3.8v-1.5Z"/>
          </svg>
        </span>
        <h3>Shell Scripting</h3>
        <p>أتمتة المهام وسكربتات Bash</p>
      </a>

      <!-- 7. API -->
      <a href="/Th-tech/guides/http-api/rest/" class="section-card">
        <span class="icon" aria-label="API">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 5h10v3H7V5Zm-2 5h14v3H5v-3Zm2 5h10v3H7v-3Z"/>
          </svg>
        </span>
        <h3>HTTP &amp; APIs</h3>
        <p>رموز الحالة، REST، واختبار الطلبات</p>
      </a>

      <!-- 8. SQL -->
      <a href="/Th-tech/guides/sql/queries/" class="section-card">
        <span class="icon" aria-label="SQL">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3c-3.9 0-7 1.3-7 3s3.1 3 7 3 7-1.3 7-3-3.1-3-7-3Zm-7 5v4c0 1.7 3.1 3 7 3s7-1.3 7-3V8c-1.5 1.3-4.1 2-7 2s-5.5-.7-7-2Zm0 6v4c0 1.7 3.1 3 7 3s7-1.3 7-3v-4c-1.5 1.3-4.1 2-7 2s-5.5-.7-7-2Z"/>
          </svg>
        </span>
        <h3>SQL وقواعد البيانات</h3>
        <p>استعلامات، ربط جداول، وتحسين الأداء</p>
      </a>

      <!-- 9. CSS -->
      <a href="/Th-tech/guides/css/layout/" class="section-card">
        <span class="icon" aria-label="CSS">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 3h16l-1.5 17-6.5 2-6.5-2L4 3Zm3.2 3 .2 2h8.2l-.2 2H7.6l.2 2h7.4l-.3 3.2-2.9.8-2.9-.8-.2-1.7H7l.3 3.2 4.2 1.3 4.2-1.3L17 6H7.2Z"/>
          </svg>
        </span>
        <h3>CSS وتخطيط الواجهات</h3>
        <p>Flexbox، Grid، وتجاوب الشاشات</p>
      </a>

      <!-- 10. JavaScript -->
      <a href="/Th-tech/guides/js/patterns/" class="section-card">
        <span class="icon" aria-label="JavaScript">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 3h18v18H3V3Zm8.2 13.1c0 .9-.4 1.4-1.2 1.4-.7 0-1.1-.4-1.3-1l-1.5.9c.5 1 1.5 1.6 2.9 1.6 1.8 0 3-1 3-2.9v-4.8h-1.9v4.8Zm4.7-4.8c-1.7 0-2.8 1-2.8 2.5 0 1.6 1 2.2 2.4 2.8.9.4 1.3.6 1.3 1.1 0 .5-.4.8-1 .8-.8 0-1.3-.4-1.7-1.1l-1.5.9c.5 1.1 1.5 1.7 3.1 1.7 1.9 0 3-1 3-2.6 0-1.6-1-2.2-2.5-2.9-.8-.3-1.2-.5-1.2-.9 0-.4.3-.7.9-.7.6 0 1 .3 1.3.8l1.5-.9c-.5-1-1.3-1.5-2.8-1.5Z"/>
          </svg>
        </span>
        <h3>JavaScript أنماط متقدمة</h3>
        <p>Async، Modules، وهياكل البيانات</p>
      </a>

      <!-- 11. Python -->
      <a href="/Th-tech/guides/python/automation/" class="section-card">
        <span class="icon" aria-label="Python">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11.8 3c-3.1 0-3.8 1.6-3.8 3.6V9h5.6v1H6.2C4.3 10 3 11.2 3 13.5c0 2.3 1.2 4.5 3.6 4.5H9v-2.8c0-2.1 1.7-3.7 3.8-3.7h4c1.8 0 3.2-1.5 3.2-3.3V6.6C20 4.5 18.1 3 15.7 3h-3.9ZM9.8 5c.6 0 1 .5 1 1s-.4 1-1 1-1-.5-1-1 .4-1 1-1Zm2.4 16c3.1 0 3.8-1.6 3.8-3.6V15h-5.6v-1h7.4c1.9 0 3.2-1.2 3.2-3.5 0-2.3-1.2-4.5-3.6-4.5H15v2.8c0 2.1-1.7 3.7-3.8 3.7h-4C5.4 12.5 4 14 4 15.8v1.6C4 19.5 5.9 21 8.3 21h3.9Zm2-2c-.6 0-1-.5-1-1s.4-1 1-1 1 .5 1 1-.4 1-1 1Z"/>
          </svg>
        </span>
        <h3>Python للأتمتة</h3>
        <p>سكربتات، مكتبات، ومعالجة البيانات</p>
      </a>

      <!-- 12. GitHub Actions -->
      <a href="/Th-tech/guides/cicd/pipeline/" class="section-card">
        <span class="icon" aria-label="GitHub Actions">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.8.8.1-.6.4-1.1.6-1.3-2.2-.3-4.5-1.1-4.5-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.5 9.5 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.5 4.9.4.4.7 1 .7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/>
          </svg>
        </span>
        <h3>CI/CD و DevOps</h3>
        <p>GitHub Actions، اختبار، ونشر تلقائي</p>
      </a>

      <!-- 13. Security -->
      <a href="/Th-tech/guides/security/crypto/" class="section-card">
        <span class="icon" aria-label="Security">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2 4 5v6c0 5.2 3.4 9.8 8 11 4.6-1.2 8-5.8 8-11V5l-8-3Zm0 4.1 5 1.9v3c0 3.7-2.2 7.1-5 8.2-2.8-1.1-5-4.5-5-8.2V8l5-1.9Zm-1.2 3.2v4.2l-2-1.8-1.3 1.4 3.3 3 5.4-5.2-1.4-1.4-4 3.8V9.3h-1.2Z"/>
          </svg>
        </span>
        <h3>الأمان والتشفير</h3>
        <p>مفاتيح، HTTPS، وأفضل الممارسات</p>
      </a>

      <!-- 14. Networking -->
      <a href="/Th-tech/guides/networking/basics/" class="section-card">
        <span class="icon" aria-label="Networking">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM5 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm14 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-6-7.2v3.5l4 2.3.9-1.6-3-1.7V7.8h-1.9Zm-2 3.5v-3.5H9.1v3.5l-3 1.7.9 1.6 4-2.3Zm-1 4.2v-1.8h4v1.8h-4Z"/>
          </svg>
        </span>
        <h3>أساسيات الشبكات</h3>
        <p>IP، DNS، منافذ، وأدوات الفحص</p>
      </a>

      <!-- 15. Regex -->
      <a href="/Th-tech/guides/regex/patterns/" class="section-card">
        <span class="icon" aria-label="Regex">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10.5 3a7.5 7.5 0 0 0 0 15c1.8 0 3.4-.6 4.7-1.7l3.8 3.8 1.4-1.4-3.8-3.8a7.5 7.5 0 0 0-6.1-11.9Zm0 2a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Z"/>
            <path d="M8.5 8h1.5v1.5h1.5V8H13v1.5h1.5V11H13v1.5h-1.5V11H10v1.5H8.5V11H7V9.5h1.5V8Z"/>
          </svg>
        </span>
        <h3>Regex ومعالجة النصوص</h3>
        <p>أنماط، استبدال، وتحليل البيانات</p>
      </a>

      <!-- 16. Markdown -->
      <a href="/Th-tech/guides/markdown/docs/" class="section-card">
        <span class="icon" aria-label="Markdown">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2v10h16V7H4Zm2 7V9h2.5l1.5 2 1.5-2H14v5h-2v-2.3L10 14l-2-2.3V14H6Zm9-5 3 3h-2v2h-2v-2h-2l3-3Z"/>
          </svg>
        </span>
        <h3>Markdown والتوثيق</h3>
        <p>تنسيق، جداول، وكتابة README احترافي</p>
      </a>

    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
    --icon-bg: rgba(2,132,199,0.08);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
    --icon-bg: rgba(56,189,248,0.08);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .guides-home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .page-header h1 {
    color: var(--primary);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-sec);
    font-size: 0.95rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    width: 100%;
    list-style: none;
  }

  .section-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem;
    text-decoration: none !important;
    color: inherit !important;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 130px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.1);
    border-color: var(--primary);
  }

  /* حاوية الشعارات */
  .section-card .icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--icon-bg);
    color: var(--primary);
    flex-shrink: 0;
  }

  /* جميع الشعارات SVG باللون الأزرق */
  .section-card .icon svg {
    width: 25px;
    height: 25px;
    display: block;
    fill: currentColor;
  }

  .section-card h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .section-card p {
    margin: 0;
    color: var(--text-sec);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  @media (max-width: 768px) {

    .guides-home {
      padding: 1rem 0.5rem 3rem;
    }

    .page-header {
      margin-bottom: 1.2rem;
      padding-bottom: 1rem;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .page-header p {
      font-size: 0.8rem;
      padding: 0 0.5rem;
    }

    .sections-grid {
      gap: 0.6rem;
    }

    .section-card {
      padding: 0.8rem;
      min-height: 125px;
    }

    .section-card .icon {
      width: 35px;
      height: 35px;
      border-radius: 9px;
    }

    .section-card .icon svg {
      width: 21px;
      height: 21px;
    }

    .section-card h3 {
      font-size: 0.85rem;
    }

    .section-card p {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 380px) {
    #mobile-grid .section-card {
      width: 100% !important;
      flex: 0 0 100% !important;
    }
  }
</style>
