---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export const title = "أوامر Git المرجعية: دليل المطور السريع";
export const pubDate = "2026-08-05";
export const description = "أهم 30 أمر Git يحتاجها كل مطور يومياً، مع أمثلة عملية وشرح مبسط";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Th.Tech</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="git commands, git cheatsheet, أوامر جيت, version control, github" />
</head>
<body>
  <Header />
  
  <main class="guide-article">
    <div class="page-header">
      <h1>🔧 أوامر Git المرجعية</h1>
      <p>دليل سريع لأهم الأوامر التي تحتاجها يومياً في إدارة النسخ</p>
    </div>

    <article class="article" id="art1">
      <span class="badge">مرجع سريع</span>
      <h2>أهم 30 أمر Git للمطورين</h2>
      <div class="meta">📅 5 أغسطس 2026 | ⏱️ 10 دقائق قراءة</div>
      
      <p class="intro">
        Git هو أداة التحكم في النسخ الأكثر استخداماً في عالم البرمجة. في هذا الدليل المرجعي، جمعنا لك أهم الأوامر التي ستستخدمها يومياً، مع أمثلة عملية وشرح مبسط.
      </p>

      <!-- قسم: البداية -->
      <h3 id="part1">🚀 البدء بمشروع جديد</h3>
      <div class="command-box">
        <code>git init</code>
        <p>تهيئة مستودع Git جديد في المجلد الحالي</p>
      </div>
      
      <div class="command-box">
        <code>git clone https://github.com/user/repo.git</code>
        <p>نسخ مستودع بعيد إلى جهازك المحلي</p>
      </div>

      <div class="command-box">
        <code>git clone git@github.com:user/repo.git</code>
        <p>نسخ باستخدام SSH (موصى به للأمان)</p>
      </div>

      <!-- قسم: العمل اليومي -->
      <h3 id="part2">📝 العمل اليومي والتعديل</h3>
      
      <table class="commands-table">
        <thead>
          <tr>
            <th>الأمر</th>
            <th>الوظيفة</th>
            <th>مثال</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>git status</code></td>
            <td>عرض حالة الملفات المعدلة</td>
            <td>-</td>
          </tr>
          <tr>
            <td><code>git add &lt;file&gt;</code></td>
            <td>إضافة ملف للمرحلة التالية</td>
            <td><code>git add main.py</code></td>
          </tr>
          <tr>
            <td><code>git add .</code></td>
            <td>إضافة جميع الملفات المعدلة</td>
            <td>-</td>
          </tr>
          <tr>
            <td><code>git commit -m "msg"</code></td>
            <td>حفظ التغييرات مع رسالة</td>
            <td><code>git commit -m "fix: login bug"</code></td>
          </tr>
          <tr>
            <td><code>git commit -am "msg"</code></td>
            <td>إضافة وحفظ الملفات المتابعة معاً</td>
            <td>-</td>
          </tr>
        </tbody>
      </table>

      <!-- قسم: الفروع -->
      <h3 id="part3">🌿 إدارة الفروع (Branches)</h3>
      
      <div class="command-box">
        <code>git branch</code>
        <p>عرض جميع الفروع المحلية</p>
      </div>
      
      <div class="command-box">
        <code>git branch -a</code>
        <p>عرض جميع الفروع (محلية وبعيدة)</p>
      </div>
      
      <div class="command-box">
        <code>git checkout -b &lt;branch-name&gt;</code>
        <p>إنشاء فرع جديد والانتقال إليه</p>
        <p><small>مثال: <code>git checkout -b feature/login</code></small></p>
      </div>
      
      <div class="command-box">
        <code>git switch &lt;branch-name&gt;</code>
        <p>الانتقال لفرع موجود (أحدث من checkout)</p>
      </div>
      
      <div class="command-box">
        <code>git merge &lt;branch-name&gt;</code>
        <p>دمج فرع آخر مع الفرع الحالي</p>
      </div>
      
      <div class="command-box">
        <code>git branch -d &lt;branch-name&gt;</code>
        <p>حذف فرع محلي (بعد الدمج)</p>
      </div>

      <!-- قسم: المزامنة مع البعيد -->
      <h3 id="part4">🔄 المزامنة مع المستودع البعيد</h3>
      
      <table class="commands-table">
        <thead>
          <tr>
            <th>الأمر</th>
            <th>الوظيفة</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>git remote -v</code></td>
            <td>عرض عناوين المستودعات البعيدة</td>
          </tr>
          <tr>
            <td><code>git push origin &lt;branch&gt;</code></td>
            <td>رفع الفرع إلى البعيد</td>
          </tr>
          <tr>
            <td><code>git pull origin &lt;branch&gt;</code></td>
            <td>سحب التحديثات من البعيد ودمجها</td>
          </tr>
          <tr>
            <td><code>git fetch origin</code></td>
            <td>جلب التحديثات بدون دمج</td>
          </tr>
          <tr>
            <td><code>git push --force</code></td>
            <td>رفع بالقوة (استخدم بحذر!)</td>
          </tr>
        </tbody>
      </table>

      <!-- قسم: التراجع والإصلاح -->
      <h3 id="part5">↩️ التراجع وإصلاح الأخطاء</h3>
      
      <div class="command-box">
        <code>git reset --soft HEAD~1</code>
        <p>التراجع عن آخر commit مع حفظ التغييرات في staging</p>
      </div>
      
      <div class="command-box">
        <code>git reset --hard HEAD~1</code>
        <p>التراجع عن آخر commit وحذف التغييرات (خطير!)</p>
      </div>
      
      <div class="command-box">
        <code>git revert &lt;commit-hash&gt;</code>
        <p>إنشاء commit جديد يعكس تغييرات commit سابق (آمن)</p>
      </div>
      
      <div class="command-box">
        <code>git restore &lt;file&gt;</code>
        <p>استعادة ملف إلى حالته في آخر commit</p>
      </div>
      
      <div class="command-box">
        <code>git clean -fd</code>
        <p>حذف جميع الملفات غير المتابعة (untracked)</p>
      </div>

      <!-- قسم: الاستعلام والتاريخ -->
      <h3 id="part6">🔍 الاستعلام وعرض التاريخ</h3>
      
      <table class="commands-table">
        <thead>
          <tr>
            <th>الأمر</th>
            <th>الوظيفة</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>git log</code></td>
            <td>عرض سجل commits</td>
          </tr>
          <tr>
            <td><code>git log --oneline</code></td>
            <td>عرض سجل مختصر بسطر لكل commit</td>
          </tr>
          <tr>
            <td><code>git log -p</code></td>
            <td>عرض سجل مع تفاصيل التغييرات</td>
          </tr>
          <tr>
            <td><code>git diff</code></td>
            <td>عرض التعديلات غير المحفوظة</td>
          </tr>
          <tr>
            <td><code>git diff --staged</code></td>
            <td>عرض التعديلات في staging area</td>
          </tr>
          <tr>
            <td><code>git show &lt;commit&gt;</code></td>
            <td>عرض تفاصيل commit محدد</td>
          </tr>
        </tbody>
      </table>

      <!-- قسم: نصائح سريعة -->
      <h3 id="part7">💡 نصائح واحترافية</h3>
      <ul>
        <li>✅ استخدم <code>git commit -m "type: description"</code> لرسائل واضحة (مثل: <code>fix: login error</code>, <code>feat: add search</code>).</li>
        <li>✅ أنشئ ملف <code>.gitignore</code> لاستبعاد الملفات غير الضرورية (node_modules/, .env, etc.).</li>
        <li>✅ استخدم <code>git stash</code> لحفظ التغييرات مؤقتاً عند التبديل بين المهام.</li>
        <li>✅ راجع <code>git status</code> قبل كل commit لتتجنب رفع ملفات بالخطأ.</li>
        <li>✅ استخدم الفروع (branches) لكل ميزة جديدة لتسهيل المراجعة والدمج.</li>
      </ul>

      <div class="conclusion" style="background:linear-gradient(135deg,#0284c7,#00d4ff);color:white;padding:2rem;border-radius:12px;margin:2rem 0">
        <h3>🎯 الخلاصة:</h3>
        <ul style="list-style:none;padding:0">
          <li>✅ احفظ هذا الدليل كمرجع سريع في عملك اليومي.</li>
          <li>✅ تدرب على الأوامر الأساسية حتى تصبح تلقائية.</li>
          <li>✅ استخدم <code>git --help &lt;command&gt;</code> لمعرفة تفاصيل أي أمر.</li>
          <li>✅ شارك هذا الدليل مع فريقك لتحسين سير العمل.</li>
        </ul>
      </div>
    </article>

    <ShareButtons />
  </main>
  
  <Footer />
</body>
</html>

<style>
  /* ✅ نفس متغيرات التصميم الحالية */
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
    --code-bg: #1e293b;
    --code-text: #e2e8f0;
  }
  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
    --code-bg: #0f172a;
    --code-text: #f1f5f9;
  }
  body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; margin: 0; line-height: 1.6; }
  
  .guide-article { max-width: 950px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .page-header { text-align: center; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 2px solid var(--border); }
  .page-header h1 { color: var(--primary); font-size: 2.2rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-sec); font-size: 1.1rem; }
  
  .article { background: var(--card); border: 2px solid var(--border); border-radius: 16px; padding: 2.5rem 2rem; margin-bottom: 3rem; }
  .badge { display: inline-block; background: var(--primary); color: white; padding: 0.4rem 1.2rem; border-radius: 50px; font-size: 0.85rem; margin-bottom: 1rem; }
  .article h2 { color: var(--primary); font-size: 1.8rem; margin: 2rem 0 1rem; }
  .article h3 { color: var(--text); font-size: 1.4rem; margin: 2rem 0 1rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; }
  .meta { color: var(--text-sec); font-size: 0.9rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px dashed var(--border); }
  .intro { font-size: 1.1rem; color: var(--text-sec); margin-bottom: 2.5rem; padding: 1.5rem; background: rgba(2,132,199,0.05); border-right: 4px solid var(--primary); border-radius: 8px; }
  
  /* ✅ تنسيق صناديق الأوامر */
  .command-box {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 1.2rem;
    border-radius: 10px;
    margin: 1rem 0;
    border-left: 4px solid var(--primary);
    font-family: 'Fira Code', monospace;
    font-size: 0.95rem;
  }
  .command-box code {
    display: block;
    font-weight: 700;
    color: #60a5fa;
    margin-bottom: 0.5rem;
    direction: ltr;
    text-align: left;
  }
  .command-box p {
    margin: 0;
    color: var(--text-sec);
    font-size: 0.9rem;
    font-family: system-ui, sans-serif;
  }
  .command-box small {
    color: var(--text-sec);
    opacity: 0.8;
  }

  /* ✅ تنسيق الجداول */
  .commands-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    background: var(--card);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .commands-table thead {
    background: linear-gradient(135deg, var(--primary), #0ea5e9);
    color: white;
  }
  .commands-table th,
  .commands-table td {
    padding: 1rem;
    text-align: right;
    border-bottom: 1px solid var(--border);
  }
  .commands-table th {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .commands-table td {
    font-size: 0.9rem;
    color: var(--text-sec);
  }
  .commands-table td code {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    direction: ltr;
    display: inline-block;
  }
  .commands-table tr:last-child td {
    border-bottom: none;
  }
  .commands-table tr:hover {
    background: rgba(2,132,199,0.05);
  }

  /* ✅ القائمة */
  .article ul {
    padding-right: 1.5rem;
    margin: 1rem 0;
  }
  .article li {
    margin-bottom: 0.6rem;
    color: var(--text-sec);
    line-height: 1.7;
  }
  .article li code {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.9rem;
    direction: ltr;
  }

  .conclusion ul { list-style: none !important; padding: 0; }
  .conclusion li { color: white !important; font-size: 1rem; margin: 0.6rem 0; line-height: 1.7; }

  @media (max-width: 768px) {
    .guide-article { padding: 2rem 1rem 3rem !important; }
    .page-header h1 { font-size: 1.6rem !important; }
    .article { padding: 1.5rem 1.2rem !important; }
    .commands-table { font-size: 0.85rem; }
    .commands-table th,
    .commands-table td { padding: 0.8rem 0.5rem; }
    .command-box { font-size: 0.9rem; padding: 1rem; }
  }
</style>

<script>
  // ✅ تتبع القراءة (نفس الكود المستخدم في المقالات الأخرى)
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', function() {
      const TRACK_TIME = 30;
      const SCROLL_THRESHOLD = 0.7;
      const currentPath = window.location.pathname;
      let isMarked = false;

      function markAsRead() {
        if (isMarked) return;
        try {
          const read = JSON.parse(localStorage.getItem('read_articles') || '[]');
          if (!read.includes(currentPath)) {
            read.push(currentPath);
            localStorage.setItem('read_articles', JSON.stringify(read));
          }
          isMarked = true;
        } catch (e) {}
      }

      try {
        if (JSON.parse(localStorage.getItem('read_articles') || '[]').includes(currentPath)) return;
      } catch (e) {}

      const timer = setTimeout(markAsRead, TRACK_TIME * 1000);
      function onScroll() {
        const percent = (window.scrollY + window.innerHeight) / document.body.scrollHeight;
        if (percent >= SCROLL_THRESHOLD) {
          markAsRead();
          clearTimeout(timer);
          window.removeEventListener('scroll', onScroll);
        }
      }
      window.addEventListener('scroll', onScroll);
      window.addEventListener('beforeunload', function() { 
        clearTimeout(timer); 
        window.removeEventListener('scroll', onScroll); 
      });
    });
  }
</script>
