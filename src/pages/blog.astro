---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>المدونة | Th.Tech</title>
</head>
<body>
  <Header />
  
  <main class="blog-page">
    <div class="container">
      <h1>📚 المدونة</h1>
      <p class="subtitle">شروحات ومقالات في البرمجة والتقنية</p>

      <div class="articles-grid">
        <article class="article-card">
          <div class="article-badge">جديد</div>
          <h3>كيف تتعلم Python في 30 يوم؟</h3>
          <p>خطة عملية خطوة بخطوة للمبتدئين لتعلم لغة Python من الصفر</p>
          <div class="article-meta">
            <span>⏱️ 10 دقائق</span>
            <span>📅 28 أغسطس 2026</span>
          </div>
          <a href="#" class="read-more">اقرأ المزيد ←</a>
        </article>

        <article class="article-card">
          <div class="article-badge popular">شائع</div>
          <h3>أفضل 10 مشاريع للمبتدئين</h3>
          <p>مشاريع عملية تساعدك على تطبيق ما تعلمته وبناء portfolio قوي</p>
          <div class="article-meta">
            <span>⏱️ 8 دقائق</span>
            <span>📅 25 أغسطس 2026</span>
          </div>
          <a href="#" class="read-more">اقرأ المزيد ←</a>
        </article>

        <article class="article-card">
          <h3>فهم الذكاء الاصطناعي للمبتدئين</h3>
          <p>شرح مبسط لمفاهيم AI و Machine Learning مع أمثلة عملية</p>
          <div class="article-meta">
            <span>⏱️ 12 دقيقة</span>
            <span>📅 20 أغسطس 2026</span>
          </div>
          <a href="#" class="read-more">اقرأ المزيد ←</a>
        </article>

        <article class="article-card">
          <h3>دليلك الشامل لـ HTML/CSS</h3>
          <p>كل ما تحتاج معرفته لبناء مواقع ويب احترافية من الصفر</p>
          <div class="article-meta">
            <span>⏱️ 15 دقيقة</span>
            <span>📅 15 أغسطس 2026</span>
          </div>
          <a href="#" class="read-more">اقرأ المزيد ←</a>
        </article>
      </div>

      <div class="newsletter-section">
        <h2>📬 اشترك في نشرتنا</h2>
        <p>احصل على أحدث المقالات والشروحات مباشرة في بريدك</p>
        <form class="newsletter-form">
          <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
          <button type="submit" class="btn">اشترك الآن</button>
        </form>
      </div>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .blog-page {
    min-height: 100vh;
    background: var(--bg, #080c12);
    color: var(--text, #e6edf3);
    padding: 3rem 1.5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text, #e6edf3);
  }

  .subtitle {
    color: var(--muted, #7d8b99);
    margin-bottom: 3rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .article-card {
    background: var(--panel, #0d131b);
    border: 1px solid var(--border, #202c39);
    border-radius: 12px;
    padding: 2rem;
    position: relative;
    transition: all 0.3s;
  }

  .article-card:hover {
    transform: translateY(-5px);
    border-color: var(--blue, #38a8ff);
    box-shadow: 0 10px 30px rgba(56, 168, 255, 0.1);
  }

  .article-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--green, #3fb950);
    color: white;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .article-badge.popular {
    background: var(--warning, #d29922);
  }

  .article-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: var(--text, #e6edf3);
  }

  .article-card p {
    color: var(--muted, #7d8b99);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .article-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--muted, #7d8b99);
  }

  .read-more {
    color: var(--blue, #38a8ff);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .read-more:hover {
    gap: 0.6rem;
    transition: gap 0.3s;
  }

  .newsletter-section {
    background: linear-gradient(135deg, var(--panel, #0d131b), var(--panel2, #111923));
    border: 1px solid var(--border, #202c39);
    border-radius: 16px;
    padding: 3rem;
    text-align: center;
  }

  .newsletter-section h2 {
    margin-bottom: 1rem;
  }

  .newsletter-section p {
    color: var(--muted, #7d8b99);
    margin-bottom: 2rem;
  }

  .newsletter-form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 250px;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--border, #202c39);
    border-radius: 8px;
    background: var(--bg, #080c12);
    color: var(--text, #e6edf3);
    font-family: inherit;
  }

  .newsletter-form input:focus {
    outline: none;
    border-color: var(--blue, #38a8ff);
  }

  .btn {
    padding: 0.8rem 2rem;
    background: var(--blue, #38a8ff);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn:hover {
    background: var(--blue2, #168bd0);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
    
    .newsletter-form {
      flex-direction: column;
    }
    
    .newsletter-form input {
      width: 100%;
    }
  }
</style>
