---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>التصنيفات - Th.Tech</title>
</head>
<body>
  <Header />
  
  <main class="category-page">
    <div class="page-header">
      <!-- ✅ العنوان: سطر واحد + أيقونة -->
      <h1 class="page-title">
        <span class="title-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
        </span>
        <span>استكشف التصنيفات</span>
      </h1>
      <p>اختر المجال التقني الذي يهمك للدخول إلى مقالاته المتخصصة</p>
    </div>

    <div class="categories-grid">
      <!-- الذكاء الاصطناعي -->
      <a href="/Th-tech/ai/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <h3>الذكاء الاصطناعي</h3>
        <p>تعلم الآلة، الشبكات العصبية، والنماذج التوليدية</p>
      </a>

      <!-- البرمجة -->
      <a href="/Th-tech/programming/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3>البرمجة والتطوير</h3>
        <p>لغات البرمجة، أطر العمل، وهندسة البرمجيات</p>
      </a>

      <!-- علم البيانات -->
      <a href="/Th-tech/data-science/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <h3>علم البيانات</h3>
        <p>تحليل البيانات، التعلم الآلي، والذكاء الأعمال</p>
      </a>

      <!-- إنترنت الأشياء -->
      <a href="/Th-tech/iot/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <h3>إنترنت الأشياء</h3>
        <p>الأجهزة الذكية، المنازل الذكية، والمدن المتصلة</p>
      </a>

      <!-- DevOps -->
      <a href="/Th-tech/devops/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
        </div>
        <h3>DevOps</h3>
        <p>التكامل المستمر، النشر، والأتمتة</p>
      </a>

      <!-- تطوير الجوال -->
      <a href="/Th-tech/mobile/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
        </div>
        <h3>تطوير الجوال</h3>
        <p>تطبيقات iOS، Android، Flutter و React Native</p>
      </a>

      <!-- الشبكات -->
      <a href="/Th-tech/networks/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <h3>الشبكات</h3>
        <p>إدارة الشبكات، بروتوكولات الاتصال، والأمان الشبكي</p>
      </a>

      <!-- الحوسبة السحابية -->
      <a href="/Th-tech/cloud/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
          </svg>
        </div>
        <h3>الحوسبة السحابية</h3>
        <p>AWS، Azure، Google Cloud، والبنية التحتية الحديثة</p>
      </a>

      <!-- الأمن السيبراني -->
      <a href="/Th-tech/security/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3>الأمن السيبراني</h3>
        <p>حماية البيانات، الاختراق الأخلاقي، والتشفير</p>
      </a>

      <!-- البلوك تشين -->
      <a href="/Th-tech/blockchain/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <h3>البلوك تشين</h3>
        <p>العملات الرقمية، العقود الذكية، وتطبيقات Web3</p>
      </a>

      <!-- ✅ Windows - شعار رسمي واقعي جداً -->
      <a href="/Th-tech/windows/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 12V6.75l6-1.05v6.3H3m7-7.4l11-1.9v9.35H10V4.6m-7 8.4h6v6.3l-6-1.05V13m7-6.35h11v9.35l-11-1.9v-7.45z"/>
          </svg>
        </div>
        <h3>نظام Windows</h3>
        <p>من الأساسيات إلى PowerShell وإدارة الأنظمة</p>
      </a>

      <!-- ✅ Android - روبوت كامل واقعي جداً -->
      <a href="/Th-tech/android/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.608 10.565l2.174-3.765a.27.27 0 00-.465-.27l-2.2 3.808a8.24 8.24 0 00-5.117 0l-2.2-3.808a.27.27 0 00-.465.27l2.174 3.765A8.21 8.21 0 007 12.27v5.848a.37.37 0 00.37.37h.46a.37.37 0 00.37-.37v-3.52a.37.37 0 00-.37-.37H7.54a.37.37 0 00-.37.37v3.89a3.86 3.86 0 003.86 3.86h1.94a3.86 3.86 0 003.86-3.86v-3.89a.37.37 0 00-.37-.37h-.37a.37.37 0 00-.37.37v3.52a.37.37 0 00.37.37h.46a.37.37 0 00.37-.37V12.27a8.21 8.21 0 00-5.117-1.705zM9.33 8.27a.65.65 0 110-1.3.65.65 0 010 1.3zm5.34 0a.65.65 0 110-1.3.65.65 0 010 1.3z"/>
          </svg>
        </div>
        <h3>نظام Android</h3>
        <p>من Kotlin إلى Jetpack Compose والتطوير</p>
      </a>

      <!-- ✅ iOS - شعار آبل رسمي واقعي جداً -->
      <a href="/Th-tech/ios/" class="cat-card">
        <div class="cat-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.21-1.98 1.07-3.11-1.05.05-2.31.72-3.05 1.58-.68.78-1.28 2.03-1.12 3.13 1.19.09 2.38-.78 3.1-1.6z"/>
          </svg>
        </div>
        <h3>نظام iOS</h3>
        <p>من SwiftUI إلى النشر على App Store</p>
      </a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root { 
    --bg: #f8fafc; 
    --card: #ffffff; 
    --text: #0f172a; 
    --text-sec: #64748b; 
    --primary: #0284c7; 
    --border: rgba(2,132,199,0.2); 
  }
  
  html.dark-mode { 
    --bg: #0b1120; 
    --card: #1e293b; 
    --text: #f1f5f9; 
    --text-sec: #94a3b8; 
    --primary: #38bdf8; 
    --border: rgba(56,189,248,0.2); 
  }
  
  body { 
    background: var(--bg); 
    color: var(--text); 
    font-family: system-ui, sans-serif; 
    margin: 0; 
  }
  
  .category-page { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 4rem 1.5rem 6rem; 
  }
  
  .page-header { 
    text-align: center; 
    margin-bottom: 3.5rem; 
  }

  /* ✅ تنسيق العنوان الجديد (سطر واحد + أيقونة) */
  .page-title { 
    color: var(--primary); 
    font-size: 2.5rem; 
    margin-bottom: 0.8rem; 
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem; /* مسافة بين الأيقونة والنص */
    white-space: nowrap; /* إجبار النص على البقاء في سطر واحد */
  }

  /* تنسيق أيقونة العنوان */
  .title-icon {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0; /* منع الأيقونة من الانكماش */
  }
  
  .page-header p { 
    color: var(--text-sec); 
    font-size: 1.15rem; 
  }
  
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .cat-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .cat-card:hover {
    transform: translateY(-8px);
    border-color: var(--primary);
    box-shadow: 0 10px 30px rgba(2,132,199,0.2);
  }
  
  .cat-icon { 
    width: 4rem;
    height: 4rem;
    margin-bottom: 1rem;
    color: var(--primary); /* ✅ الأيقونة زرقاء دائماً */
  }

  .cat-icon svg {
    width: 100%;
    height: 100%;
  }
  
  .cat-card h3 { 
    color: var(--primary); 
    font-size: 1.3rem; 
    margin-bottom: 0.8rem; 
  }
  
  .cat-card p { 
    color: var(--text-sec); 
    font-size: 0.95rem; 
    line-height: 1.6; 
    margin-bottom: 0; /* تعديل لأننا حذفنا العداد */
  }

  /* ✅ تم حذف تنسيق .cat-count نهائياً */
  
  @media (max-width: 768px) {
    .categories-grid { 
      grid-template-columns: 1fr; 
    }
    .category-page { 
      padding: 3rem 1rem 4rem; 
    }
    .cat-icon {
      width: 3.5rem;
      height: 3.5rem;
    }
    /* تعديل العنوان للموبايل لضمان عدم الخروج عن الشاشة */
    .page-title {
      font-size: 1.8rem;
      gap: 0.5rem;
    }
    .title-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
