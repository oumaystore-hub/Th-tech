---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>التصنيفات - Th.Tech</title>
</head>
<body>
  <Header />
  
  <main class="category-page">
    <div class="page-header">
      <h1 class="page-title">
        <span class="title-icon">📂</span>
        <span>استكشف التصنيفات</span>
      </h1>
      <p>اختر المجال التقني الذي يهمك للدخول إلى مقالاته المتخصصة</p>
    </div>

    <div class="categories-grid">
      <!-- علم البيانات -->
      <a href="/Th-tech/data-science/" class="cat-card">
        <div class="cat-icon">📊</div>
        <h3>علم البيانات</h3>
        <p>تحليل البيانات، التعلم الآلي، والذكاء الأعمال</p>
      </a>

      <!-- البرمجة والتطوير -->
      <a href="/Th-tech/programming/" class="cat-card">
        <div class="cat-icon">&lt;&gt;</div>
        <h3>البرمجة والتطوير</h3>
        <p>لغات البرمجة، أطر العمل، وهندسة البرمجيات</p>
      </a>

      <!-- الذكاء الاصطناعي -->
      <a href="/Th-tech/ai/" class="cat-card">
        <div class="cat-icon">🤖</div>
        <h3>الذكاء الاصطناعي</h3>
        <p>تعلم الآلة، الشبكات العصبية، والنماذج التوليدية</p>
      </a>

      <!-- تطوير الجوال -->
      <a href="/Th-tech/mobile/" class="cat-card">
        <div class="cat-icon">📱</div>
        <h3>تطوير الجوال</h3>
        <p>تطبيقات Flutter، Android، iOS و React Native</p>
      </a>

      <!-- DevOps -->
      <a href="/Th-tech/devops/" class="cat-card">
        <div class="cat-icon">🔄</div>
        <h3>DevOps</h3>
        <p>التكامل المستمر، النشر، والأتمتة</p>
      </a>

      <!-- إنترنت الأشياء -->
      <a href="/Th-tech/iot/" class="cat-card">
        <div class="cat-icon">📡</div>
        <h3>إنترنت الأشياء</h3>
        <p>الأجهزة الذكية، المنازل الذكية، والمدن المتصلة</p>
      </a>

      <!-- الأمن السيبراني -->
      <a href="/Th-tech/security/" class="cat-card">
        <div class="cat-icon">🛡️</div>
        <h3>الأمن السيبراني</h3>
        <p>حماية البيانات، الاختراق الأخلاقي، والتشفير</p>
      </a>

      <!-- الحوسبة السحابية -->
      <a href="/Th-tech/cloud/" class="cat-card">
        <div class="cat-icon">☁️</div>
        <h3>الحوسبة السحابية</h3>
        <p>AWS، Azure، Google Cloud، والبنية التحتية الحديثة</p>
      </a>

      <!-- الشبكات -->
      <a href="/Th-tech/networks/" class="cat-card">
        <div class="cat-icon"></div>
        <h3>الشبكات</h3>
        <p>إدارة الشبكات، بروتوكولات الاتصال، والأمان الشبكي</p>
      </a>

      <!-- الحوسبة الطرفية -->
      <a href="/Th-tech/edge-computing/" class="cat-card">
        <div class="cat-icon">🖥️</div>
        <h3>الحوسبة الطرفية</h3>
        <p>معالجة البيانات بالقرب من المصدر مع إنترنت الأشياء</p>
      </a>

      <!-- الحوسبة الكمية -->
      <a href="/Th-tech/quantum-computing/" class="cat-card">
        <div class="cat-icon">⚛️</div>
        <h3>الحوسبة الكمية</h3>
        <p>الكيوبتات، التراكب الكمي، والخوارزميات المتقدمة</p>
      </a>

      <!-- البلوك تشين -->
      <a href="/Th-tech/blockchain/" class="cat-card">
        <div class="cat-icon"></div>
        <h3>البلوك تشين</h3>
        <p>العملات الرقمية، العقود الذكية، وتطبيقات Web3</p>
      </a>

      <!-- نظام Android -->
      <a href="/Th-tech/android/" class="cat-card">
        <div class="cat-icon">🤖</div>
        <h3>نظام Android</h3>
        <p>من Kotlin إلى Jetpack Compose والتطوير</p>
      </a>

      <!-- نظام Windows -->
      <a href="/Th-tech/windows/" class="cat-card">
        <div class="cat-icon">🪟</div>
        <h3>نظام Windows</h3>
        <p>من الأساسيات إلى PowerShell وإدارة الأنظمة</p>
      </a>

      <!-- تقنية 5G المتقدمة -->
      <a href="/Th-tech/5g-technology/" class="cat-card">
        <div class="cat-icon"></div>
        <h3>تقنية 5G المتقدمة</h3>
        <p>الجيل الخامس، Network Slicing، والتطبيقات الذكية</p>
      </a>

      <!-- نظام iOS -->
      <a href="/Th-tech/ios/" class="cat-card">
        <div class="cat-icon">🍎</div>
        <h3>نظام iOS</h3>
        <p>من SwiftUI إلى النشر على App Store</p>
      </a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root { 
    --bg: #f8fafc; 
    --card: #ffffff; 
    --text: #0f172a; 
    --text-sec: #64748b; 
    --primary: #0284c7; 
    --border: rgba(2,132,199,0.2); 
  }
  
  html.dark-mode { 
    --bg: #0b1120; 
    --card: #1e293b; 
    --text: #f1f5f9; 
    --text-sec: #94a3b8; 
    --primary: #38bdf8; 
    --border: rgba(56,189,248,0.2); 
  }
  
  body { 
    background: var(--bg); 
    color: var(--text); 
    font-family: system-ui, sans-serif; 
    margin: 0; 
  }
  
  .category-page { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 4rem 1.5rem 6rem; 
  }
  
  .page-header { 
    text-align: center; 
    margin-bottom: 3.5rem; 
  }

  .page-title { 
    color: var(--primary); 
    font-size: 2.5rem; 
    margin-bottom: 0.8rem; 
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem; 
    white-space: nowrap; 
  }

  .title-icon {
    font-size: 3.5rem;
    flex-shrink: 0; 
  }
  
  .page-header p { 
    color: var(--text-sec); 
    font-size: 1.15rem; 
  }
  
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  /* ✅ حواف حادة تماماً مثل المكعب */
  .cat-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 4px !important; /* ✅ حواف حادة جداً */
    padding: 2.5rem 2rem;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .cat-card:hover {
    transform: translateY(-8px);
    border-color: var(--primary);
    box-shadow: 0 10px 30px rgba(2,132,199,0.2);
  }
  
  .cat-icon { 
    font-size: 4rem;
    margin-bottom: 1rem;
  }
  
  .cat-card h3 { 
    color: var(--primary); 
    font-size: 1.3rem; 
    margin-bottom: 0.8rem; 
  }
  
  .cat-card p { 
    color: var(--text-sec); 
    font-size: 0.95rem; 
    line-height: 1.6; 
    margin-bottom: 0; 
  }
  
  @media (max-width: 768px) {
    .categories-grid { 
      grid-template-columns: 1fr; 
    }
    .category-page { 
      padding: 3rem 1rem 4rem; 
    }
    .cat-icon {
      font-size: 3.5rem;
    }
    .page-title {
      font-size: 1.8rem;
      gap: 0.5rem;
    }
    .title-icon {
      font-size: 2.5rem;
    }
  }
</style>
