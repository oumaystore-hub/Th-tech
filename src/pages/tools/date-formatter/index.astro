---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Date Formatter - تنسيق التاريخ أونلاين مجاناً | Th.Tech";

const description =
  "أداة Date Formatter مجانية لتنسيق وتحويل التاريخ إلى عدة صيغ مثل ISO وUTC والتاريخ المحلي، مع إمكانية النسخ مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة Date Formatter؟",
    a: "هي أداة تساعدك على تحويل التاريخ والوقت إلى صيغ مختلفة ومنظمة مثل ISO 8601 وUTC والتاريخ المحلي."
  },
  {
    q: "هل يتم إرسال التاريخ إلى الخادم؟",
    a: "لا. تتم جميع عمليات معالجة التاريخ داخل المتصفح باستخدام JavaScript ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "ما هو تنسيق ISO 8601؟",
    a: "ISO 8601 هو معيار شائع لتمثيل التاريخ والوقت، ويستخدم بكثرة في APIs وقواعد البيانات وتطبيقات الويب."
  },
  {
    q: "هل يمكن استخدام الأداة مع مشاريع البرمجة؟",
    a: "نعم. يمكن استخدام النتائج في JavaScript وAPIs وقواعد البيانات والأنظمة التي تعتمد على صيغ التاريخ القياسية."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/date-formatter/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const syncTheme = () => {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          };

          syncTheme();

          window.addEventListener("themeChange", syncTheme);

          document.addEventListener("click", (event) => {
            const button = event.target.closest("#theme-btn");

            if (button) {
              setTimeout(syncTheme, 0);
            }
          });
        } catch {}
      })();
    </script>

    <style>
      :root {
        --bg: #f5f7fb;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #e4e8f0;
        --text: #172033;
        --muted: #697386;

        --primary: #7c3aed;
        --primary-2: #9333ea;
        --primary-soft: rgba(124, 58, 237, 0.1);

        --success: #16a34a;
        --success-soft: rgba(22, 163, 74, 0.1);

        --warning: #d97706;
        --warning-soft: rgba(217, 119, 6, 0.1);

        --shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
        --radius: 22px;
      }

      html.dark-mode {
        --bg: #080a12;
        --surface: #10131f;
        --surface-2: #151927;
        --border: #252b3b;
        --text: #edf1f7;
        --muted: #8d96aa;

        --primary: #a855f7;
        --primary-2: #c084fc;
        --primary-soft: rgba(168, 85, 247, 0.13);

        --success: #22c55e;
        --success-soft: rgba(34, 197, 94, 0.1);

        --warning: #f59e0b;
        --warning-soft: rgba(245, 158, 11, 0.1);

        --shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 15% 10%,
            var(--primary-soft),
            transparent 25%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      button,
      input,
      select {
        font: inherit;
      }

      .container {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 54px 0 44px;
        border-bottom: 1px solid var(--border);
      }

      .hero::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        left: -160px;
        top: -210px;
        border-radius: 50%;
        background: var(--primary-soft);
        filter: blur(10px);
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 34px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: 0.2s;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 10px;
      }

      .hero-content {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .hero-icon {
        width: 104px;
        height: 104px;
        flex: 0 0 104px;
        border-radius: 30px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        color: white;
        background:
          linear-gradient(
            145deg,
            var(--primary),
            var(--primary-2)
          );
        box-shadow:
          0 18px 35px rgba(124, 58, 237, 0.28),
          inset 0 1px 0 rgba(255, 255, 255, 0.25);
        transform: rotate(-3deg);
      }

      .hero-icon i {
        font-size: 34px;
      }

      .hero-icon span {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        opacity: 0.9;
      }

      .hero-text {
        flex: 1;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      h1 {
        margin: 0 0 9px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero-text > p {
        margin: 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.9;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }

      .tags span {
        padding: 6px 11px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
      }

      /* TOOL */

      .tool-section {
        padding: 45px 0 25px;
      }

      .formatter-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .topbar {
        min-height: 62px;
        padding: 0 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .window-dots {
        display: flex;
        gap: 6px;
      }

      .window-dots span {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--border);
      }

      .tool-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 700;
        font-size: 14px;
      }

      .tool-title i {
        color: var(--primary);
      }

      .local-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--success);
        font-size: 11px;
        font-family: "JetBrains Mono", monospace;
      }

      .workspace {
        padding: 25px;
      }

      .input-layout {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 18px;
        align-items: stretch;
      }

      .field-card {
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
        background: var(--surface-2);
      }

      .field-label {
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 15px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
        font-weight: 700;
      }

      .field-label div {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .field-label i {
        color: var(--primary);
      }

      .field-label span {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        font-weight: 500;
      }

      .date-input {
        width: 100%;
        min-height: 92px;
        padding: 20px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 18px;
      }

      .date-input::-webkit-calendar-picker-indicator {
        cursor: pointer;
        opacity: 0.7;
      }

      .format-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .format-btn {
        width: 100%;
        min-height: 43px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        text-align: right;
        padding: 0 12px;
        font-size: 12px;
        transition: 0.2s;
      }

      .format-btn:hover,
      .format-btn.active {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-soft);
      }

      .format-btn strong {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        margin-bottom: 2px;
      }

      .format-btn small {
        color: var(--muted);
      }

      .action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
      }

      .actions-left,
      .actions-right {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
      }

      .btn {
        border: 0;
        min-height: 43px;
        padding: 0 15px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        transition:
          transform 0.2s,
          box-shadow 0.2s,
          background 0.2s;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        color: white;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.2);
      }

      .btn-secondary {
        color: var(--text);
        background: var(--surface-2);
        border: 1px solid var(--border);
      }

      /* RESULTS */

      .results {
        margin-top: 22px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 13px;
      }

      .result-card {
        position: relative;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface-2);
      }

      .result-card.primary-result {
        grid-column: 1 / -1;
        border-color: rgba(124, 58, 237, 0.3);
        background: var(--primary-soft);
      }

      .result-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: var(--muted);
        font-size: 11px;
      }

      .result-label i {
        color: var(--primary);
        margin-left: 5px;
      }

      .copy-mini {
        border: 0;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font-size: 11px;
      }

      .copy-mini:hover {
        color: var(--primary);
      }

      .result-value {
        direction: ltr;
        text-align: left;
        word-break: break-word;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        line-height: 1.8;
        color: var(--text);
      }

      .primary-result .result-value {
        font-size: 18px;
        color: var(--primary);
        font-weight: 600;
      }

      .status {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 17px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--success-soft);
        color: var(--success);
        font-size: 12px;
      }

      /* STATS */

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 18px;
      }

      .stat {
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 10px;
        margin-bottom: 7px;
      }

      .stat-top i {
        color: var(--primary);
      }

      .stat strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 17px;
      }

      /* NOTE */

      .privacy-note {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 18px;
        padding: 15px;
        border-radius: 15px;
        background: var(--warning-soft);
        color: var(--text);
      }

      .privacy-note-icon {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: rgba(217, 119, 6, 0.12);
        color: var(--warning);
      }

      .privacy-note strong {
        display: block;
        font-size: 12px;
        margin-bottom: 4px;
      }

      .privacy-note p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* CONTENT SECTIONS */

      .info-section,
      .how-section,
      .faq-section {
        padding: 55px 0;
      }

      .section-heading {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 30px;
      }

      .section-heading > span {
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 7px 0;
        font-size: clamp(24px, 4vw, 32px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.9;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .info-card {
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s;
      }

      .info-card:hover {
        transform: translateY(-4px);
      }

      .info-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        color: var(--primary);
        background: var(--primary-soft);
        margin-bottom: 17px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* STEPS */

      .steps {
        max-width: 850px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .step {
        position: relative;
        padding: 25px 20px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
      }

      .step-number {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--primary);
        color: white;
        font-weight: 800;
        margin-bottom: 18px;
      }

      .step h3 {
        margin: 0 0 7px;
        font-size: 15px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 10px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        list-style: none;
        cursor: pointer;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        font-size: 13px;
        font-weight: 700;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: transform 0.2s;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        margin: 0;
        padding: 0 20px 18px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 800px) {
        .hero {
          padding: 35px 0;
        }

        .hero-content {
          align-items: flex-start;
        }

        .hero-icon {
          width: 82px;
          height: 82px;
          flex-basis: 82px;
          border-radius: 23px;
        }

        .hero-icon i {
          font-size: 27px;
        }

        .input-layout {
          grid-template-columns: 1fr;
        }

        .format-list {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        .container {
          width: min(100% - 22px, 1120px);
        }

        .hero-content {
          flex-direction: column;
        }

        .hero-icon {
          width: 76px;
          height: 76px;
          flex-basis: 76px;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text > p {
          font-size: 14px;
        }

        .workspace {
          padding: 15px;
        }

        .topbar {
          padding: 0 14px;
        }

        .window-dots {
          display: none;
        }

        .action-row {
          flex-direction: column-reverse;
          align-items: stretch;
        }

        .actions-left,
        .actions-right {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
        }

        .btn {
          width: 100%;
          padding: 0 8px;
        }

        .results {
          grid-template-columns: 1fr;
        }

        .result-card.primary-result {
          grid-column: auto;
        }

        .primary-result .result-value {
          font-size: 14px;
        }

        .format-list {
          grid-template-columns: 1fr 1fr;
        }

        .stats {
          grid-template-columns: 1fr 1fr;
        }

        .privacy-note {
          padding: 12px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 40px 0;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Date Formatter</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-regular fa-calendar-days"></i>
              <span>DATE</span>
            </div>

            <div class="hero-text">
              <div class="badge">
                <i class="fa-solid fa-code"></i>
                Developer Tools
              </div>

              <h1>Date Formatter</h1>

              <p>
                نسّق التاريخ وحوّله إلى صيغ متعددة مناسبة للمشاريع
                البرمجية وواجهات API.
              </p>

              <div class="tags">
                <span>ISO 8601</span>
                <span>UTC</span>
                <span>Local</span>
                <span>JavaScript</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="formatter-card">
            <div class="topbar">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="tool-title">
                <i class="fa-regular fa-calendar-days"></i>
                Date Formatter
              </div>

              <div class="local-badge">
                <i class="fa-solid fa-shield-halved"></i>
                LOCAL
              </div>
            </div>

            <div class="workspace">
              <div class="input-layout">
                <div class="field-card">
                  <div class="field-label">
                    <div>
                      <i class="fa-solid fa-calendar"></i>
                      التاريخ والوقت
                    </div>
                    <span>INPUT</span>
                  </div>

                  <input
                    id="dateInput"
