                      نسخ
                    </button>
                  </div>

                  <div id="formattedOutput" class="result-value">
                    —
                  </div>
                </div>

                <div class="result-card">
                  <div class="result-label">
                    <div>
                      <i class="fa-solid fa-code"></i>
                      ISO 8601
                    </div>

                    <button class="copy-mini" data-copy="iso">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </div>

                  <div id="isoOutput" class="result-value">
                    —
                  </div>
                </div>

                <div class="result-card">
                  <div class="result-label">
                    <div>
                      <i class="fa-solid fa-globe"></i>
                      UTC
                    </div>

                    <button class="copy-mini" data-copy="utc">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </div>

                  <div id="utcOutput" class="result-value">
                    —
                  </div>
                </div>

                <div class="result-card">
                  <div class="result-label">
                    <div>
                      <i class="fa-solid fa-location-dot"></i>
                      Local
                    </div>

                    <button class="copy-mini" data-copy="local">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </div>

                  <div id="localOutput" class="result-value">
                    —
                  </div>
                </div>

                <div class="result-card">
                  <div class="result-label">
                    <div>
                      <i class="fa-solid fa-calendar-day"></i>
                      Date Only
                    </div>

                    <button class="copy-mini" data-copy="date">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </div>

                  <div id="dateOutput" class="result-value">
                    —
                  </div>
                </div>
              </div>

              <div class="status" id="status">
                <i class="fa-solid fa-circle-check"></i>
                <span id="statusText">
                  اختر تاريخاً واضغط على تنسيق للبدء.
                </span>
              </div>

              <!-- STATS -->
              <div class="stats">
                <div class="stat">
                  <div class="stat-top">
                    <span>YEAR</span>
                    <i class="fa-regular fa-calendar"></i>
                  </div>
                  <strong id="statYear">—</strong>
                </div>

                <div class="stat">
                  <div class="stat-top">
                    <span>MONTH</span>
                    <i class="fa-solid fa-calendar-days"></i>
                  </div>
                  <strong id="statMonth">—</strong>
                </div>

                <div class="stat">
                  <div class="stat-top">
                    <span>DAY</span>
                    <i class="fa-solid fa-calendar-day"></i>
                  </div>
                  <strong id="statDay">—</strong>
                </div>

                <div class="stat">
                  <div class="stat-top">
                    <span>TIMEZONE</span>
                    <i class="fa-solid fa-earth-americas"></i>
                  </div>
                  <strong id="statZone">LOCAL</strong>
                </div>
              </div>

              <div class="privacy-note">
                <div class="privacy-note-icon">
                  <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                  <strong>معالجة محلية وآمنة</strong>
                  <p>
                    تتم عملية تنسيق التاريخ بالكامل داخل المتصفح باستخدام
                    JavaScript. لا يتم إرسال التاريخ إلى أي خادم خارجي.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>DATE FORMATTER</span>
            <h2>تنسيق التاريخ بسهولة</h2>
            <p>
              حوّل التاريخ إلى الصيغة التي يحتاجها مشروعك خلال ثوانٍ.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>ISO 8601</h3>

              <p>
                صيغة قياسية وشائعة في APIs وتطبيقات الويب وقواعد البيانات.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <h3>UTC</h3>

