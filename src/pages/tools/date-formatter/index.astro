            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-laptop"></i>
              </div>

              <h3>معالجة محلية</h3>

              <p>
                لا تحتاج إلى رفع أي بيانات. تتم المعالجة مباشرة داخل متصفحك.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>HOW IT WORKS</span>
            <h2>كيفية استخدام Date Formatter</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>

              <h3>اختر التاريخ</h3>

              <p>
                حدد التاريخ والوقت الذي تريد تنسيقه من حقل الإدخال.
              </p>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <h3>اختر الصيغة</h3>

              <p>
                اختر ISO أو UTC أو Local أو التاريخ فقط.
              </p>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <h3>انسخ النتيجة</h3>

              <p>
                اضغط على نسخ لاستخدام النتيجة مباشرة في مشروعك.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>FAQ</span>
            <h2>الأسئلة الشائعة</h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const dateInput = document.getElementById("dateInput");

        const formattedOutput =
          document.getElementById("formattedOutput");

        const isoOutput =
          document.getElementById("isoOutput");

        const utcOutput =
          document.getElementById("utcOutput");

        const localOutput =
          document.getElementById("localOutput");

        const dateOutput =
          document.getElementById("dateOutput");

        const statusText =
          document.getElementById("statusText");

        const statYear =
          document.getElementById("statYear");

        const statMonth =
          document.getElementById("statMonth");

        const statDay =
          document.getElementById("statDay");

        const statZone =
          document.getElementById("statZone");

        const formatButtons =
          document.querySelectorAll(".format-btn");

        let selectedFormat = "iso";

        function pad(value) {
          return String(value).padStart(2, "0");
        }

        function getDate() {
          if (!dateInput.value) return null;

          const date = new Date(dateInput.value);

          if (Number.isNaN(date.getTime())) {
            return null;
          }

          return date;
        }

        function formatLocal(date) {
          const year = date.getFullYear();
          const month = pad(date.getMonth() + 1);
          const day = pad(date.getDate());

          const hours = pad(date.getHours());
          const minutes = pad(date.getMinutes());
          const seconds = pad(date.getSeconds());

          return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
        }

        function formatDateOnly(date) {
          return [
            date.getFullYear(),
            pad(date.getMonth() + 1),
            pad(date.getDate())
          ].join("-");
        }

        function getFormattedValue(date) {
          switch (selectedFormat) {
            case "utc":
              return date.toUTCString();

            case "local":
              return formatLocal(date);

            case "date":
              return formatDateOnly(date);

            case "iso":
            default:
              return date.toISOString();
          }
        }

        function updateStats(date) {
          statYear.textContent = date.getFullYear();
          statMonth.textContent = pad(date.getMonth() + 1);
          statDay.textContent = pad(date.getDate());

          const offset = -date.getTimezoneOffset();
          const sign = offset >= 0 ? "+" : "-";
          const absolute = Math.abs(offset);

          const hours = Math.floor(absolute / 60);
          const minutes = absolute % 60;

          statZone.textContent =
            `UTC${sign}${pad(hours)}:${pad(minutes)}`;
        }

        function formatDate() {
          const date = getDate();

          if (!date) {
            formattedOutput.textContent = "—";
            isoOutput.textContent = "—";
            utcOutput.textContent = "—";
            localOutput.textContent = "—";
            dateOutput.textContent = "—";

            statYear.textContent = "—";
            statMonth.textContent = "—";
            statDay.textContent = "—";
            statZone.textContent = "LOCAL";

            statusText.textContent =
              "أدخل تاريخاً صحيحاً للبدء.";

            return;
          }

          const iso = date.toISOString();
          const utc = date.toUTCString();
          const local = formatLocal(date);
          const onlyDate = formatDateOnly(date);

          formattedOutput.textContent =
            getFormattedValue(date);

          isoOutput.textContent = iso;
          utcOutput.textContent = utc;
          localOutput.textContent = local;
          dateOutput.textContent = onlyDate;

          updateStats(date);

          statusText.textContent =
            "تم تنسيق التاريخ بنجاح — المعالجة تمت داخل المتصفح.";
        }

        function setNow() {
          const now = new Date();

          const year = now.getFullYear();
          const month = pad(now.getMonth() + 1);
          const day = pad(now.getDate());
          const hours = pad(now.getHours());
          const minutes = pad(now.getMinutes());

          dateInput.value =
            `${year}-${month}-${day}T${hours}:${minutes}`;

          formatDate();
        }

        async function copyText(text) {
          if (!text || text === "—") return;

          try {
            await navigator.clipboard.writeText(text);

            statusText.textContent =
              "تم نسخ النتيجة إلى الحافظة.";

          } catch {
            const textarea =
              document.createElement("textarea");

            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);
            textarea.select();

            document.execCommand("copy");
            textarea.remove();

            statusText.textContent =
              "تم نسخ النتيجة إلى الحافظة.";
          }
        }

        function getOutput(type) {
          if (type === "formatted") {
            return formattedOutput.textContent;
          }

          if (type === "iso") {
            return isoOutput.textContent;
          }

          if (type === "utc") {
            return utcOutput.textContent;
          }

          if (type === "local") {
            return localOutput.textContent;
          }

          if (type === "date") {
            return dateOutput.textContent;
          }

          return "";
        }

        formatButtons.forEach((button) => {
          button.addEventListener("click", () => {
            formatButtons.forEach((item) => {
              item.classList.remove("active");
            });

            button.classList.add("active");

            selectedFormat =
              button.dataset.format || "iso";

            formatDate();
          });
        });

        document
          .getElementById("formatBtn")
          .addEventListener("click", formatDate);

        document
          .getElementById("nowBtn")
          .addEventListener("click", setNow);

        document
          .getElementById("copyBtn")
          .addEventListener("click", () => {
            copyText(formattedOutput.textContent);
          });

        document
          .getElementById("clearBtn")
          .addEventListener("click", () => {
            dateInput.value = "";

            formattedOutput.textContent = "—";
            isoOutput.textContent = "—";
            utcOutput.textContent = "—";
            localOutput.textContent = "—";
            dateOutput.textContent = "—";

            statYear.textContent = "—";
            statMonth.textContent = "—";
            statDay.textContent = "—";
            statZone.textContent = "LOCAL";

            statusText.textContent =
              "تم مسح البيانات. اختر تاريخاً جديداً.";
          });

        document.querySelectorAll(".copy-mini").forEach((button) => {
          button.addEventListener("click", () => {
            const type = button.dataset.copy;
            copyText(getOutput(type));
          });
        });

        dateInput.addEventListener("change", formatDate);

        document.addEventListener("keydown", (event) => {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {
            formatDate();
          }
        });

        setNow();
      })();
    </script>
  </body>
</html>
