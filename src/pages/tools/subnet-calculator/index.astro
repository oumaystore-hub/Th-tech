---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Subnet Calculator - حاسبة الشبكات الفرعية أونلاين مجاناً | Th.Tech";

const description =
  "Subnet Calculator مجانية لحساب Network Address وBroadcast وSubnet Mask ونطاق الأجهزة وعدد العناوين والشبكات الفرعية مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة Subnet Calculator؟",
    a: "Subnet Calculator تساعدك على تقسيم شبكة IPv4 إلى شبكات فرعية وحساب عنوان الشبكة والـBroadcast والـSubnet Mask ونطاق عناوين الأجهزة وعدد العناوين."
  },
  {
    q: "ما الفرق بين Subnet Calculator وCIDR Calculator؟",
    a: "CIDR Calculator تركز على تحليل شبكة محددة باستخدام Prefix، بينما Subnet Calculator تضيف إمكانية تحديد عدد الشبكات الفرعية أو عدد الأجهزة المطلوبة وحساب الـPrefix المناسب."
  },
  {
    q: "هل الحسابات تتم على الخادم؟",
    a: "لا. جميع الحسابات تتم داخل المتصفح باستخدام JavaScript ولا يتم إرسال عناوين IP أو البيانات إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام الأداة لتقسيم شبكة كبيرة؟",
    a: "نعم. يمكنك إدخال شبكة أساسية وتحديد عدد الـSubnet Bits أو Prefix الجديد للحصول على معلومات الشبكات الفرعية الناتجة."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/subnet-calculator/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          } else {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=tools">
    أدوات تقنية
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">Subnet Calculator - حاسبة الشبكات الفرعية أونلاين مجاناً</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->

      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Subnet Calculator</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-solid fa-network-wired"></i>
            </div>

            <div class="hero-text">
              <div class="tool-badge">
                <i class="fa-solid fa-shield-halved"></i>
                Network & Subnetting
              </div>

              <h1>Subnet Calculator</h1>

              <p>
                حاسبة احترافية للشبكات الفرعية لحساب Network Address وBroadcast
                وSubnet Mask ونطاق الأجهزة وعدد العناوين بسرعة ودقة.
              </p>

              <div class="tags">
                <span>IPv4</span>
                <span>Subnetting</span>
                <span>Network</span>
                <span>CIDR</span>
                <span>Local</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="tool-section">
        <div class="container">
          <div class="tool-card">
            <div class="tool-topbar">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="tool-name">
                <i class="fa-solid fa-network-wired"></i>
                Subnet Calculator
              </div>

              <div class="secure">
                <i class="fa-solid fa-lock"></i>
                معالجة محلية
              </div>
            </div>

            <div class="actionbar">
              <button class="action-btn" id="exampleBtn">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                مثال
              </button>

              <button class="action-btn" id="clearBtn">
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

              <button class="action-btn" id="copyBtn">
                <i class="fa-regular fa-copy"></i>
                نسخ النتائج
              </button>

              <button class="action-btn primary" id="calculateBtn">
                <i class="fa-solid fa-calculator"></i>
                احسب
              </button>
            </div>

            <div class="editor-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-sliders"></i>
                  إعدادات الشبكة
                </div>

                <span>IPv4 / CIDR</span>
              </div>

              <div class="input-grid">
                <div class="field">
                  <label for="networkInput">
                    <i class="fa-solid fa-globe"></i>
                    عنوان الشبكة
                  </label>

                  <input
                    id="networkInput"
                    type="text"
                    value="192.168.1.0"
                    placeholder="192.168.1.0"
                    autocomplete="off"
                    spellcheck="false"
                  />

                  <small>أدخل عنوان IPv4 مثل 192.168.1.0</small>
                </div>

                <div class="field">
                  <label for="prefixInput">
                    <i class="fa-solid fa-slash"></i>
                    Prefix Length
                  </label>

                  <div class="prefix-wrap">
                    <span>/</span>
                    <input
                      id="prefixInput"
                      type="number"
                      min="0"
                      max="32"
                      value="24"
                      inputmode="numeric"
                    />
                  </div>

                  <small>من /0 إلى /32</small>
                </div>

                <div class="field">
                  <label for="subnetPrefixInput">
                    <i class="fa-solid fa-code-branch"></i>
                    Prefix الجديد
                  </label>

                  <div class="prefix-wrap">
                    <span>/</span>
                    <input
                      id="subnetPrefixInput"
                      type="number"
                      min="0"
                      max="32"
                      value="26"
                      inputmode="numeric"
                    />
                  </div>

                  <small>يجب أن يكون أكبر أو يساوي Prefix الأصلي</small>
                </div>
              </div>
            </div>

            <div class="examples">
              <div class="examples-title">
                <i class="fa-solid fa-bolt"></i>
                أمثلة سريعة
              </div>

              <div class="example-list">
                <button data-example="192.168.1.0|24|26">
                  192.168.1.0/24 → /26
                </button>

                <button data-example="10.0.0.0|8|16">
                  10.0.0.0/8 → /16
                </button>

                <button data-example="172.16.0.0|16|24">
                  172.16.0.0/16 → /24
                </button>

                <button data-example="192.168.10.0|24|27">
                  192.168.10.0/24 → /27
                </button>

                <button data-example="10.10.0.0|16|20">
                  10.10.0.0/16 → /20
                </button>
              </div>
            </div>

            <div class="status-box ready" id="statusBox">
              <div class="status-icon">
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div>
                <strong id="statusTitle">جاهز للحساب</strong>
                <p id="statusText">
                  أدخل بيانات الشبكة ثم اضغط على احسب.
                </p>
              </div>
            </div>

            <div class="results" id="results">
              <div class="results-header">
                <div>
                  <i class="fa-solid fa-chart-network"></i>
                  نتائج الحساب
                </div>

                <span id="networkLabel">192.168.1.0/24</span>
              </div>

              <div class="result-grid">
                <div class="result-card highlight">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-diagram-project"></i>
                  </div>

                  <div class="result-card-content">
                    <span>Network Address</span>
                    <strong id="networkAddress">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="networkAddress">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>

                <div class="result-card">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-bullseye"></i>
                  </div>

                  <div class="result-card-content">
                    <span>Broadcast Address</span>
                    <strong id="broadcastAddress">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="broadcastAddress">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>

                <div class="result-card">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-mask-face"></i>
                  </div>

                  <div class="result-card-content">
                    <span>Subnet Mask</span>
                    <strong id="subnetMask">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="subnetMask">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>

                <div class="result-card">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-eraser"></i>
                  </div>

                  <div class="result-card-content">
                    <span>Wildcard Mask</span>
                    <strong id="wildcardMask">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="wildcardMask">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>

                <div class="result-card">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-arrow-right"></i>
                  </div>

                  <div class="result-card-content">
                    <span>First Host</span>
                    <strong id="firstHost">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="firstHost">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>

                <div class="result-card">
                  <div class="result-card-icon">
                    <i class="fa-solid fa-arrow-left"></i>
                  </div>

                  <div class="result-card-content">
                    <span>Last Host</span>
                    <strong id="lastHost">—</strong>
                  </div>

                  <button class="mini-copy" data-copy="lastHost">
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>
              </div>

              <div class="subnet-summary">
                <div class="summary-title">
                  <i class="fa-solid fa-network-wired"></i>
                  معلومات الشبكات الفرعية
                </div>

                <div class="summary-grid">
                  <div class="summary-item">
                    <span>Prefix الأصلي</span>
                    <strong id="originalPrefix">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>Prefix الجديد</span>
                    <strong id="newPrefix">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>Subnet Bits</span>
                    <strong id="subnetBits">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>Host Bits</span>
                    <strong id="hostBits">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>عدد Subnets</span>
                    <strong id="subnetCount">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>العناوين لكل Subnet</span>
                    <strong id="addressesPerSubnet">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>Usable Hosts</span>
                    <strong id="usableHosts">—</strong>
                  </div>

                  <div class="summary-item">
                    <span>نوع الشبكة</span>
                    <strong id="networkType">—</strong>
                  </div>
                </div>
              </div>

              <div class="subnets-panel">
                <div class="subnets-header">
                  <div>
                    <i class="fa-solid fa-table-list"></i>
                    الشبكات الفرعية
                  </div>

                  <span id="subnetsCountLabel">0 شبكات</span>
                </div>

                <div class="subnets-table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Network</th>
                        <th>First Host</th>
                        <th>Last Host</th>
                        <th>Broadcast</th>
                      </tr>
                    </thead>

                    <tbody id="subnetsBody"></tbody>
                  </table>
                </div>
              </div>

              <div class="stats-grid">
                <div class="stat">
                  <span>Prefix الأصلي</span>
                  <strong id="statOriginalPrefix">/24</strong>
                </div>

                <div class="stat">
                  <span>Prefix الجديد</span>
                  <strong id="statNewPrefix">/26</strong>
                </div>

                <div class="stat">
                  <span>Subnet Bits</span>
                  <strong id="statSubnetBits">2</strong>
                </div>

                <div class="stat">
                  <span>Host Bits</span>
                  <strong id="statHostBits">6</strong>
                </div>

                <div class="stat">
                  <span>عدد Subnets</span>
                  <strong id="statSubnetCount">4</strong>
                </div>

                <div class="stat">
                  <span>Hosts / Subnet</span>
                  <strong id="statHosts">62</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>لماذا Subnet Calculator؟</span>
            <h2>كل ما تحتاجه لتقسيم الشبكات</h2>
            <p>
              احسب الشبكات الفرعية بسرعة دون الحاجة إلى أدوات خارجية أو إرسال
              بياناتك إلى أي خادم.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>حساب فوري</h3>

              <p>
                تظهر النتائج مباشرة أثناء تعديل عنوان الشبكة والـPrefix.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <h3>خصوصية كاملة</h3>

              <p>
                جميع العمليات تتم داخل المتصفح ولا يتم إرسال عناوين الشبكات
                إلى خادم خارجي.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-table-cells-large"></i>
              </div>

              <h3>عرض الشبكات</h3>

              <p>
                شاهد Network وFirst Host وLast Host وBroadcast لكل Subnet في
                جدول واضح.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>طريقة الاستخدام</span>
            <h2>احسب الشبكات في 3 خطوات</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>أدخل الشبكة</h3>
                <p>
                  اكتب عنوان IPv4 الأساسي وحدد Prefix مثل
                  <code>192.168.1.0/24</code>.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>حدد Prefix الجديد</h3>
                <p>
                  اختر Prefix أكبر لتقسيم الشبكة إلى عدد أكبر من الشبكات
                  الفرعية.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>راجع النتائج</h3>
                <p>
                  ستظهر جميع الشبكات الفرعية مع عناوين Network وHosts وBroadcast.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>الأسئلة الشائعة</span>
            <h2>Subnet Calculator FAQ</h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    









