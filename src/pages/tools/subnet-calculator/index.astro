        align-items: center;
        gap: 24px;
      }

      .hero-icon {
        width: 82px;
        height: 82px;
        flex: 0 0 82px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 32px;
        background:
          linear-gradient(
            145deg,
            var(--primary),
            var(--primary-2)
          );
        box-shadow:
          0 15px 35px rgba(8, 166, 199, 0.24);
      }

      .tool-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        letter-spacing: -1px;
      }

      .hero-text p {
        margin: 0;
        color: var(--muted);
        max-width: 760px;
        line-height: 1.9;
        font-size: 15px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .tags span {
        padding: 6px 11px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        background: var(--surface);
        font-size: 11px;
      }

      .tool-section {
        padding: 20px 0 70px;
      }

      .tool-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .tool-topbar {
        min-height: 62px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .window-dots {
        display: flex;
        gap: 7px;
      }

      .window-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border);
      }

      .tool-name {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
        font-size: 14px;
      }

      .tool-name i {
        color: var(--primary);
      }

      .secure {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--success);
        font-size: 12px;
        font-weight: 700;
      }

      .actionbar {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        padding: 15px 20px;
        border-bottom: 1px solid var(--border);
      }

      .action-btn {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        border-radius: 11px;
        padding: 9px 13px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: 0.2s ease;
      }

      .action-btn:hover {
        transform: translateY(-1px);
        border-color: var(--primary);
        color: var(--primary);
      }

      .action-btn.primary {
        margin-right: auto;
        color: white;
        border-color: transparent;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );
      }

      .action-btn.primary:hover {
        color: white;
        box-shadow: 0 8px 22px rgba(8, 166, 199, 0.22);
      }

      .editor-section {
        padding: 24px 24px 10px;
      }

      .editor-header,
      .results-header,
      .subnets-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      .editor-header > div,
      .results-header > div,
      .subnets-header > div {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
      }

      .editor-header i,
      .results-header i,
      .subnets-header i {
        color: var(--primary);
      }

      .editor-header span,
      .results-header span,
      .subnets-header span {
        color: var(--muted);
        font-size: 11px;
      }

      .input-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 14px;
      }

      .field label {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 800;
      }

      .field label i {
        color: var(--primary);
        margin-left: 5px;
      }

      .field input {
        width: 100%;
        height: 48px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-2);
        color: var(--text);
        outline: none;
        padding: 0 14px;
        direction: ltr;
        font-family: "JetBrains Mono", monospace;
        transition: 0.2s ease;
      }

      .field input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px var(--primary-soft);
      }

      .field small {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-top: 7px;
      }

      .prefix-wrap {
        display: flex;
        direction: ltr;
        align-items: center;
        height: 48px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-2);
        overflow: hidden;
      }

      .prefix-wrap span {
        padding-left: 14px;
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-weight: 700;
      }

      .prefix-wrap input {
        border: 0;
        background: transparent;
        box-shadow: none;
      }

      .examples {
        padding: 18px 24px 22px;
      }

      .examples-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 10px;
      }

      .examples-title i {
        color: var(--primary);
      }

      .example-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .example-list button {
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--muted);
        border-radius: 9px;
        padding: 7px 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        transition: 0.2s ease;
      }

      .example-list button:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .status-box {
        margin: 0 24px 24px;
        padding: 15px 16px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        border: 1px solid var(--border);
      }

      .status-box.ready {
        background: var(--primary-soft);
      }

      .status-box.success {
        background: rgba(11, 155, 114, 0.09);
        border-color: rgba(11, 155, 114, 0.22);
      }

      .status-box.error {
        background: rgba(229, 72, 77, 0.08);
        border-color: rgba(229, 72, 77, 0.2);
      }

      .status-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--surface);
        color: var(--primary);
      }

      .success .status-icon {
        color: var(--success);
      }

      .error .status-icon {
        color: var(--danger);
      }

      .status-box strong {
        display: block;
        font-size: 12px;
        margin-bottom: 2px;
      }

      .status-box p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      .results {
        display: none;
        padding: 24px;
        border-top: 1px solid var(--border);
        background: var(--surface-2);
      }

      .result-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .result-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        border-radius: 15px;
        border: 1px solid var(--border);
        background: var(--surface);
        min-width: 0;
      }

      .result-card.highlight {
        border-color: rgba(8, 166, 199, 0.35);
        box-shadow: 0 8px 25px rgba(8, 166, 199, 0.07);
      }

      .result-card-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: var(--primary-soft);
        color: var(--primary);
      }

      .result-card-content {
        min-width: 0;
        padding-left: 26px;
      }

      .result-card-content span {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-bottom: 4px;
      }

      .result-card-content strong {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        direction: ltr;
        text-align: right;
        overflow-wrap: anywhere;
      }

      .mini-copy {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 29px;
        height: 29px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--muted);
      }

      .mini-copy:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .subnet-summary {
        margin-top: 18px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface);
      }

      .summary-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 15px;
      }

      .summary-title i {
        color: var(--primary);
      }

      .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
      }

      .summary-item {
        padding: 12px;
        border-radius: 11px;
        background: var(--surface-2);
        border: 1px solid var(--border);
      }

      .summary-item span {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-bottom: 5px;
      }

      .summary-item strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
      }

      .subnets-panel {
        margin-top: 18px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface);
        overflow: hidden;
      }

      .subnets-header {
        padding: 17px 18px;
        margin: 0;
        border-bottom: 1px solid var(--border);
      }

      .subnets-table-wrap {
        overflow-x: auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        min-width: 680px;
      }

      th,
      td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        text-align: right;
        font-size: 11px;
      }

      th {
        color: var(--muted);
        background: var(--surface-2);
        font-weight: 800;
      }

      td {
        color: var(--text);
      }

      td code {
        direction: ltr;
        display: inline-block;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      tbody tr:last-child td {
        border-bottom: 0;
      }

      tbody tr:hover {
        background: var(--primary-soft);
      }

      .more-row {
        text-align: center;
        color: var(--muted);
        font-size: 10px;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        margin-top: 18px;
      }

      .stat {
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        text-align: center;
      }

      .stat span {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-bottom: 5px;
      }

      .stat strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
      }

      .info-section,
      .how-section,
      .faq-section {
        padding: 70px 0;
      }

      .how-section {
        background: var(--surface-2);
        border-block: 1px solid var(--border);
      }

      .section-heading {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 34px;
      }

      .section-heading > span {
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .section-heading h2 {
        margin: 7px 0 10px;
        font-size: clamp(24px, 4vw, 32px);
      }

      .section-heading p {
        color: var(--muted);
        margin: 0;
        font-size: 13px;
        line-height: 1.9;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .info-card {
        padding: 25px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
      }

      .info-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--primary-soft);
        color: var(--primary);
        margin-bottom: 15px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        display: flex;
        gap: 15px;
        padding: 22px;
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 18px;
      }

      .step-number {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );
        color: white;
        font-weight: 800;
      }

      .step h3 {
        margin: 0 0 6px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      .step code {
        font-family: "JetBrains Mono", monospace;
        color: var(--primary);
      }

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 10px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        padding: 17px 18px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        font-size: 12px;
        font-weight: 800;
        list-style: none;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: transform 0.2s ease;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        padding: 0 18px 18px;
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 11px;
      }

      @media (max-width: 900px) {
        .input-grid {
          grid-template-columns: 1fr 1fr;
        }

        .input-grid .field:first-child {
          grid-column: 1 / -1;
        }

        .summary-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .stats-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .hero-content {
          align-items: flex-start;
        }

        .hero-icon {
          width: 65px;
          height: 65px;
          flex-basis: 65px;
          border-radius: 18px;
          font-size: 25px;
        }

        .tool-topbar {
          padding: 0 14px;
        }

        .secure {
          display: none;
        }

        .editor-section,
        .examples,
        .results {
          padding-inline: 15px;
        }

        .status-box {
          margin-inline: 15px;
        }

        .result-grid {
          grid-template-columns: 1fr;
        }

        .action-btn.primary {
          margin-right: 0;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero {
          padding-top: 25px;
        }

        .breadcrumb {
          margin-bottom: 20px;
        }

        .hero-content {
          gap: 14px;
        }

        .hero-icon {
          display: none;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text p {
          font-size: 13px;
        }

        .input-grid {
          grid-template-columns: 1fr;
        }

        .input-grid .field:first-child {
          grid-column: auto;
        }

        .summary-grid {
          grid-template-columns: 1fr 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .actionbar {
          padding: 12px 15px;
        }

        .action-btn {
          flex: 1;
          justify-content: center;
        }

        .action-btn.primary {
          flex-basis: 100%;
        }

        .example-list {
          overflow-x: auto;
          flex-wrap: nowrap;
          padding-bottom: 4px;
        }

        .example-list button {
          white-space: nowrap;
        }

        .section-heading h2 {
          font-size: 25px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 55px 0;
        }
      }
    </style>
  </body>
</html>
