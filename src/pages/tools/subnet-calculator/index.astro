    <script is:inline>
      const networkInput = document.getElementById("networkInput");
      const prefixInput = document.getElementById("prefixInput");
      const subnetPrefixInput = document.getElementById("subnetPrefixInput");

      const calculateBtn = document.getElementById("calculateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const statusBox = document.getElementById("statusBox");
      const statusTitle = document.getElementById("statusTitle");
      const statusText = document.getElementById("statusText");

      const results = document.getElementById("results");

      const networkAddress = document.getElementById("networkAddress");
      const broadcastAddress = document.getElementById("broadcastAddress");
      const subnetMask = document.getElementById("subnetMask");
      const wildcardMask = document.getElementById("wildcardMask");
      const firstHost = document.getElementById("firstHost");
      const lastHost = document.getElementById("lastHost");

      const originalPrefix = document.getElementById("originalPrefix");
      const newPrefix = document.getElementById("newPrefix");
      const subnetBits = document.getElementById("subnetBits");
      const hostBits = document.getElementById("hostBits");
      const subnetCount = document.getElementById("subnetCount");
      const addressesPerSubnet = document.getElementById("addressesPerSubnet");
      const usableHosts = document.getElementById("usableHosts");
      const networkType = document.getElementById("networkType");

      const networkLabel = document.getElementById("networkLabel");
      const subnetsBody = document.getElementById("subnetsBody");
      const subnetsCountLabel = document.getElementById("subnetsCountLabel");

      const statOriginalPrefix = document.getElementById("statOriginalPrefix");
      const statNewPrefix = document.getElementById("statNewPrefix");
      const statSubnetBits = document.getElementById("statSubnetBits");
      const statHostBits = document.getElementById("statHostBits");
      const statSubnetCount = document.getElementById("statSubnetCount");
      const statHosts = document.getElementById("statHosts");

      let hasResults = false;

      function ipToNumber(ip) {
        const parts = ip.trim().split(".");

        if (parts.length !== 4) return null;

        const nums = parts.map(Number);

        if (
          nums.some(
            (n, i) =>
              !Number.isInteger(n) ||
              n < 0 ||
              n > 255 ||
              parts[i] === ""
          )
        ) {
          return null;
        }

        return (
          (((nums[0] * 256 + nums[1]) * 256 + nums[2]) * 256 + nums[3]) >>> 0
        );
      }

      function numberToIp(number) {
        number = number >>> 0;

        return [
          (number >>> 24) & 255,
          (number >>> 16) & 255,
          (number >>> 8) & 255,
          number & 255
        ].join(".");
      }

      function cidrToMask(prefix) {
        if (prefix === 0) return 0;

        return (0xffffffff << (32 - prefix)) >>> 0;
      }

      function wildcardFromMask(mask) {
        return (~mask) >>> 0;
      }

      function formatNumber(number) {
        return new Intl.NumberFormat("en-US").format(number);
      }

      function getNetworkType(ip) {
        const n = ipToNumber(ip);

        if (n === null) return "Unknown";

        const first = (n >>> 24) & 255;

        if (n === 0) return "Unspecified";
        if (first === 10) return "Private";
        if (first === 127) return "Loopback";
        if (first === 169 && ((n >>> 16) & 255) === 254) {
          return "Link-local";
        }

        if (
          first === 172 &&
          ((n >>> 16) & 255) >= 16 &&
          ((n >>> 16) & 255) <= 31
        ) {
          return "Private";
        }

        if (first === 192 && ((n >>> 16) & 255) === 168) {
          return "Private";
        }

        if (first >= 224 && first <= 239) {
          return "Multicast";
        }

        if (
          first === 192 &&
          ((n >>> 16) & 255) === 0 &&
          ((n >>> 8) & 255) === 2
        ) {
          return "Documentation";
        }

        if (
          first === 198 &&
          ((n >>> 16) & 255) === 51 &&
          ((n >>> 8) & 255) === 100
        ) {
          return "Documentation";
        }

        if (
          first === 203 &&
          ((n >>> 16) & 255) === 0 &&
          ((n >>> 8) & 255) === 113
        ) {
          return "Documentation";
        }

        return "Public";
      }

      function showStatus(type, title, text) {
        statusBox.className = `status-box ${type}`;
        statusTitle.textContent = title;
        statusText.textContent = text;
      }

      function showReady() {
        showStatus(
          "ready",
          "جاهز للحساب",
          "أدخل بيانات الشبكة ثم اضغط على احسب."
        );
      }

      function showSuccess(text) {
        showStatus("success", "تم الحساب بنجاح", text);
      }

      function showError(text) {
        showStatus("error", "بيانات غير صحيحة", text);
      }

      function resetResults() {
        results.style.display = "none";
        hasResults = false;

        networkAddress.textContent = "—";
        broadcastAddress.textContent = "—";
        subnetMask.textContent = "—";
        wildcardMask.textContent = "—";
        firstHost.textContent = "—";
        lastHost.textContent = "—";

        originalPrefix.textContent = "—";
        newPrefix.textContent = "—";
        subnetBits.textContent = "—";
        hostBits.textContent = "—";
        subnetCount.textContent = "—";
        addressesPerSubnet.textContent = "—";
        usableHosts.textContent = "—";
        networkType.textContent = "—";

        subnetsBody.innerHTML = "";
      }

      function calculate() {
        const ip = networkInput.value.trim();

        let oldPrefix = Number(prefixInput.value);
        let newPrefixValue = Number(subnetPrefixInput.value);

        const ipNumber = ipToNumber(ip);

        if (ipNumber === null) {
          resetResults();
          showError("يرجى إدخال عنوان IPv4 صحيح مثل 192.168.1.0.");
          return;
        }

        if (
          !Number.isInteger(oldPrefix) ||
          oldPrefix < 0 ||
          oldPrefix > 32
        ) {
          resetResults();
          showError("Prefix الأصلي يجب أن يكون بين /0 و /32.");
          return;
        }

        if (
          !Number.isInteger(newPrefixValue) ||
          newPrefixValue < 0 ||
          newPrefixValue > 32
        ) {
          resetResults();
          showError("Prefix الجديد يجب أن يكون بين /0 و /32.");
          return;
        }

        if (newPrefixValue < oldPrefix) {
          resetResults();
          showError(
            "Prefix الجديد يجب أن يكون أكبر من أو يساوي Prefix الأصلي."
          );
          return;
        }

        /*
         * Limit extremely large subnet lists so the browser stays responsive.
         * The calculator still computes the exact count, but displays up to 256
         * subnet rows.
         */
        const bitsAdded = newPrefixValue - oldPrefix;
        const totalSubnets = Math.pow(2, bitsAdded);

        const mask = cidrToMask(oldPrefix);
        const network = (ipNumber & mask) >>> 0;
        const broadcast = (network | wildcardFromMask(mask)) >>> 0;

        const newMask = cidrToMask(newPrefixValue);
        const newWildcard = wildcardFromMask(newMask);

        const totalAddressesPerSubnet = Math.pow(
          2,
          32 - newPrefixValue
        );

        let usablePerSubnet;

        if (newPrefixValue === 32) {
          usablePerSubnet = 1;
        } else if (newPrefixValue === 31) {
          usablePerSubnet = 2;
        } else {
          usablePerSubnet = Math.max(totalAddressesPerSubnet - 2, 0);
        }

        const subnetBitsValue = bitsAdded;
        const hostBitsValue = 32 - newPrefixValue;

        const subnetNetwork = network;
        const subnetBroadcast = broadcast;

        let first;
        let last;

        if (oldPrefix === 32) {
          first = subnetNetwork;
          last = subnetNetwork;
        } else if (oldPrefix === 31) {
          first = subnetNetwork;
          last = subnetBroadcast;
        } else if (oldPrefix === 0) {
          first = subnetNetwork + 1;
          last = subnetBroadcast - 1;
        } else {
          first = subnetNetwork + 1;
          last = subnetBroadcast - 1;
        }

        networkAddress.textContent = numberToIp(subnetNetwork);
        broadcastAddress.textContent = numberToIp(subnetBroadcast);
        subnetMask.textContent = numberToIp(newMask);
        wildcardMask.textContent = numberToIp(newWildcard);

        firstHost.textContent =
          first <= subnetBroadcast ? numberToIp(first) : "N/A";

        lastHost.textContent =
          last >= subnetNetwork ? numberToIp(last) : "N/A";

        originalPrefix.textContent = `/${oldPrefix}`;
        newPrefix.textContent = `/${newPrefixValue}`;
        subnetBits.textContent = subnetBitsValue;
        hostBits.textContent = hostBitsValue;
        subnetCount.textContent = formatNumber(totalSubnets);
        addressesPerSubnet.textContent =
          formatNumber(totalAddressesPerSubnet);
        usableHosts.textContent = formatNumber(usablePerSubnet);
        networkType.textContent = getNetworkType(numberToIp(network));

        networkLabel.textContent =
          `${numberToIp(network)}/${oldPrefix}`;

        statOriginalPrefix.textContent = `/${oldPrefix}`;
        statNewPrefix.textContent = `/${newPrefixValue}`;
        statSubnetBits.textContent = subnetBitsValue;
        statHostBits.textContent = hostBitsValue;
        statSubnetCount.textContent = formatNumber(totalSubnets);
        statHosts.textContent = formatNumber(usablePerSubnet);

        subnetsBody.innerHTML = "";

        const maxRows = Math.min(totalSubnets, 256);

        for (let i = 0; i < maxRows; i++) {
          const currentNetwork =
            (network + i * totalAddressesPerSubnet) >>> 0;

          const currentBroadcast =
            (
              currentNetwork +
              totalAddressesPerSubnet -
              1
            ) >>> 0;

          let currentFirst;
          let currentLast;

          if (newPrefixValue === 32) {
            currentFirst = currentNetwork;
            currentLast = currentNetwork;
          } else if (newPrefixValue === 31) {
            currentFirst = currentNetwork;
            currentLast = currentBroadcast;
          } else {
            currentFirst = currentNetwork + 1;
            currentLast = currentBroadcast - 1;
          }

          const row = document.createElement("tr");

          row.innerHTML = `
            <td>${i + 1}</td>
            <td><code>${numberToIp(currentNetwork)}/${newPrefixValue}</code></td>
            <td><code>${numberToIp(currentFirst)}</code></td>
            <td><code>${numberToIp(currentLast)}</code></td>
            <td><code>${numberToIp(currentBroadcast)}</code></td>
          `;

          subnetsBody.appendChild(row);
        }

        if (totalSubnets > maxRows) {
          const row = document.createElement("tr");

          row.innerHTML = `
            <td colspan="5" class="more-row">
              يتم عرض أول ${formatNumber(maxRows)} شبكة فقط من أصل
              ${formatNumber(totalSubnets)} شبكة للحفاظ على سرعة المتصفح.
            </td>
          `;

          subnetsBody.appendChild(row);
        }

        subnetsCountLabel.textContent =
          `${formatNumber(totalSubnets)} ${totalSubnets === 1 ? "شبكة" : "شبكات"}`;

        results.style.display = "block";
        hasResults = true;

        showSuccess(
          `تم تقسيم ${numberToIp(network)}/${oldPrefix} إلى ${formatNumber(
            totalSubnets
          )} شبكة فرعية باستخدام /${newPrefixValue}.`
        );
      }

      function clearAll() {
        networkInput.value = "";
        prefixInput.value = "24";
        subnetPrefixInput.value = "26";

        resetResults();
        showReady();
        networkInput.focus();
      }

      function loadExample() {
        networkInput.value = "192.168.1.0";
        prefixInput.value = "24";
        subnetPrefixInput.value = "26";

        calculate();
      }

      async function copyText(text, button) {
        if (!text || text === "—") return;

        try {
          await navigator.clipboard.writeText(text);

          const oldHTML = button.innerHTML;

          button.innerHTML =
            '<i class="fa-solid fa-check"></i>';

          setTimeout(() => {
            button.innerHTML = oldHTML;
          }, 1200);
        } catch {
          showError("تعذر نسخ النتيجة إلى الحافظة.");
        }
      }

      async function copyAll() {
        if (!hasResults) {
          showError("قم بالحساب أولاً ثم حاول نسخ النتائج.");
          return;
        }

        const text = [
          `Network Address: ${networkAddress.textContent}`,
          `Broadcast Address: ${broadcastAddress.textContent}`,
          `Subnet Mask: ${subnetMask.textContent}`,
          `Wildcard Mask: ${wildcardMask.textContent}`,
          `First Host: ${firstHost.textContent}`,
          `Last Host: ${lastHost.textContent}`,
          `Original Prefix: ${originalPrefix.textContent}`,
          `New Prefix: ${newPrefix.textContent}`,
          `Subnet Bits: ${subnetBits.textContent}`,
          `Host Bits: ${hostBits.textContent}`,
          `Subnet Count: ${subnetCount.textContent}`,
          `Addresses / Subnet: ${addressesPerSubnet.textContent}`,
          `Usable Hosts: ${usableHosts.textContent}`,
          `Network Type: ${networkType.textContent}`
        ].join("\n");

        try {
          await navigator.clipboard.writeText(text);

          const oldHTML = copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = oldHTML;
          }, 1400);
        } catch {
          showError("تعذر نسخ النتائج إلى الحافظة.");
        }
      }

      calculateBtn.addEventListener("click", calculate);
      exampleBtn.addEventListener("click", loadExample);
      clearBtn.addEventListener("click", clearAll);
      copyBtn.addEventListener("click", copyAll);

      [networkInput, prefixInput, subnetPrefixInput].forEach((input) => {
        input.addEventListener("input", () => {
          if (hasResults) calculate();
        });

        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            calculate();
          }
        });
      });

      document.querySelectorAll("[data-example]").forEach((button) => {
        button.addEventListener("click", () => {
          const [ip, oldPrefix, newPrefixValue] =
            button.dataset.example.split("|");

          networkInput.value = ip;
          prefixInput.value = oldPrefix;
          subnetPrefixInput.value = newPrefixValue;

          calculate();
        });
      });

      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", () => {
          const target = document.getElementById(
            button.dataset.copy
          );

          copyText(target?.textContent?.trim(), button);
        });
      });

      resetResults();
      showReady();
    </script>

