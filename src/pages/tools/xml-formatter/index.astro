        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-dark)
        );
        color: white;
        font: 700 14px "JetBrains Mono", monospace;
      }

      .step h3 {
        margin: 0 0 4px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        display: grid;
        gap: 10px;
      }

      .faq-item {
        overflow: hidden;
        border-radius: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
      }

      .faq-item summary {
        padding: 17px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--primary);
        font-size: 11px;
        transition: transform 0.2s ease;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
      }

      .faq-answer {
        padding: 0 18px 18px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* MOBILE */

      @media (max-width: 850px) {
        .editors {
          grid-template-columns: 1fr;
        }

        .editor-wrap {
          min-height: 330px;
        }

        textarea {
          height: 330px;
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .hero {
          padding: 25px 14px 28px;
        }

        .tool-section {
          padding: 0 10px 35px;
        }

        .formatter-card {
          border-radius: 18px;
        }

        .card-topbar {
          padding: 0 13px;
        }

        .actionbar {
          padding: 11px;
        }

        .action-btn {
          flex: 1 1 calc(50% - 9px);
        }

        .action-btn.primary {
          order: -1;
          flex-basis: 100%;
          margin-right: 0;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          padding: 0 11px 11px;
        }

        .result-box {
          margin: 12px;
        }

        .editor-header {
          padding: 9px 11px;
        }

        .editor-wrap {
          grid-template-columns: 38px 1fr;
          min-height: 300px;
        }

        textarea {
          height: 300px;
          padding: 15px 12px;
          font-size: 12px;
        }

        .line-numbers {
          padding-right: 7px;
          font-size: 11px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 32px 14px;
        }

        .info-card {
          padding: 20px;
        }

        .hero h1 {
          font-size: 30px;
        }

        .hero p {
          font-size: 13px;
        }
      }

      @media (max-width: 390px) {
        .action-btn {
          font-size: 11px;
          padding: 0 9px;
        }

        .topbar-title {
          font-size: 11px;
        }

        .topbar-type {
          font-size: 9px;
        }
      }
    </style>
  </body>
</html>
