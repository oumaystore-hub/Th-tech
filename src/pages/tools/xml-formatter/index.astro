        function escapeText(value) {
          return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        }

        function escapeAttribute(value) {
          return value
            .replace(/&/g, "&amp;")
            .replace(/"/g, "&quot;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        }

        function formatAttributes(element) {
          let result = "";

          for (const attr of element.attributes) {
            result += ` ${attr.name}="${escapeAttribute(attr.value)}"`;
          }

          return result;
        }

        function hasElementChildren(element) {
          return Array.from(element.childNodes).some(
            (node) => node.nodeType === Node.ELEMENT_NODE
          );
        }

        function serializeNode(node, level = 0) {
          const indent = "  ".repeat(level);

          if (node.nodeType === Node.ELEMENT_NODE) {
            const element = node;
            const name = element.tagName;
            const attrs = formatAttributes(element);
            const children = Array.from(element.childNodes);

            const meaningfulChildren = children.filter((child) => {
              if (child.nodeType === Node.TEXT_NODE) {
                return child.nodeValue.trim() !== "";
              }

              return true;
            });

            if (meaningfulChildren.length === 0) {
              return `${indent}<${name}${attrs}/>`;
            }

            const elementChildren = hasElementChildren(element);

            if (!elementChildren) {
              let content = "";

              for (const child of meaningfulChildren) {
                if (child.nodeType === Node.TEXT_NODE) {
                  content += escapeText(child.nodeValue);
                } else if (child.nodeType === Node.CDATA_SECTION_NODE) {
                  content += `<![CDATA[${child.nodeValue}]]>`;
                } else if (child.nodeType === Node.COMMENT_NODE) {
                  content += `<!--${child.nodeValue}-->`;
                }
              }

              return `${indent}<${name}${attrs}>${content}</${name}>`;
            }

            const childOutput = meaningfulChildren
              .map((child) => serializeNode(child, level + 1))
              .join("\n");

            return `${indent}<${name}${attrs}>\n${childOutput}\n${indent}</${name}>`;
          }

          if (node.nodeType === Node.COMMENT_NODE) {
            return `${indent}<!--${node.nodeValue}-->`;
          }

          if (node.nodeType === Node.CDATA_SECTION_NODE) {
            return `${indent}<![CDATA[${node.nodeValue}]]>`;
          }

          if (node.nodeType === Node.PROCESSING_INSTRUCTION_NODE) {
            return `${indent}<?${node.target}${node.data ? " " + node.data : ""}?>`;
          }

          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.nodeValue.trim();

            if (!text) return "";

            return `${indent}${escapeText(text)}`;
          }

          return "";
        }

        function updateInputStats() {
          const value = input.value || "";

          const lines = value
            ? value.split(/\r?\n/).length
            : 1;

          inputStats.textContent = `${value.length.toLocaleString()} حرف`;

          inputLines.textContent = Array.from(
            { length: lines },
            (_, i) => i + 1
          ).join("\n");
        }

        function updateOutputStats() {
          const value = output.value || "";

          const lines = value
            ? value.split(/\r?\n/).length
            : 1;

          outputStats.textContent = `${value.length.toLocaleString()} حرف`;

          outputLines.textContent = Array.from(
            { length: lines },
            (_, i) => i + 1
          ).join("\n");
        }

        function showResult(success, title, message) {
          resultBox.classList.remove("hidden", "error-result");

          if (success) {
            resultIcon.className = "fa-solid fa-check";
            resultTitle.textContent = title;
            resultMessage.textContent = message;
          } else {
            resultBox.classList.add("error-result");
            resultIcon.className = "fa-solid fa-triangle-exclamation";
            resultTitle.textContent = title;
            resultMessage.textContent = message;
          }
        }

        function formatXML() {
          const source = input.value.trim();

          if (!source) {
            output.value = "";

            outputStatus.textContent = "فارغ";
            outputStatus.classList.remove("success");

            statusText.innerHTML =
              '<i class="fa-solid fa-circle-info"></i> أدخل XML أولاً';

            resultBox.classList.remove("hidden");
            resultBox.classList.add("error-result");

            resultIcon.className =
              "fa-solid fa-triangle-exclamation";

            resultTitle.textContent = "لا يوجد XML";
            resultMessage.textContent =
              "أدخل كود XML في صندوق الإدخال ثم حاول مرة أخرى.";

            updateOutputStats();

            return;
          }

          const start = performance.now();

          try {
            const parser = new DOMParser();
            const documentXML = parser.parseFromString(
              source,
              "application/xml"
            );

            const parserError =
              documentXML.querySelector("parsererror");

            if (parserError) {
              throw new Error("XML غير صالح");
            }

            const declarationMatch = source.match(
              /^\s*(<\?xml[\s\S]*?\?>)/
            );

            const parts = [];

            if (declarationMatch) {
              parts.push(declarationMatch[1]);
            }

            for (const node of Array.from(documentXML.childNodes)) {
              if (
                node.nodeType === Node.ELEMENT_NODE ||
                node.nodeType === Node.COMMENT_NODE
              ) {
                const formatted = serializeNode(node, 0);

                if (formatted) {
                  parts.push(formatted);
                }
              }
            }

            const formattedXML = parts.join("\n");

            output.value = formattedXML;

            const elapsed = performance.now() - start;

            const elements =
              documentXML.querySelectorAll("*").length;

            const lines = formattedXML
              ? formattedXML.split(/\r?\n/).length
              : 0;

            statLines.textContent = lines.toLocaleString();
            statChars.textContent =
              formattedXML.length.toLocaleString();

            statElements.textContent =
              elements.toLocaleString();

            statTime.textContent =
              `${elapsed.toFixed(1)} ms`;

            outputStatus.textContent = "منسق";
            outputStatus.classList.add("success");

            statusText.innerHTML =
              '<i class="fa-solid fa-circle-check"></i> تم التنسيق بنجاح';

            showResult(
              true,
              "تم تنسيق XML بنجاح",
              `تم ترتيب ${elements.toLocaleString()} عنصر في ${elapsed.toFixed(1)} ms.`
            );

            updateOutputStats();
          } catch (error) {
            output.value = "";

            outputStatus.textContent = "خطأ";
            outputStatus.classList.remove("success");

            statusText.innerHTML =
              '<i class="fa-solid fa-circle-xmark"></i> XML غير صالح';

            showResult(
              false,
              "تعذر تنسيق XML",
              "تأكد من صحة بنية XML وإغلاق جميع العناصر والخصائص بشكل صحيح."
            );

            statLines.textContent = "0";
            statChars.textContent = "0";
            statElements.textContent = "0";
            statTime.textContent = "0 ms";

            updateOutputStats();
          }
        }

        function clearAll() {
          input.value = "";
          output.value = "";

          outputStatus.textContent = "جاهز";
          outputStatus.classList.remove("success");

          statusText.innerHTML =
            '<i class="fa-solid fa-circle-check"></i> في انتظار XML';

          resultBox.classList.add("hidden");

          statLines.textContent = "0";
          statChars.textContent = "0";
          statElements.textContent = "0";
          statTime.textContent = "0 ms";

          updateInputStats();
          updateOutputStats();

          input.focus();
        }

        async function copyOutput() {
          const value = output.value;

          if (!value) {
            statusText.innerHTML =
              '<i class="fa-solid fa-circle-info"></i> لا توجد نتيجة لنسخها';

            return;
          }

          try {
            await navigator.clipboard.writeText(value);

            statusText.innerHTML =
              '<i class="fa-solid fa-check"></i> تم نسخ XML';

            copyBtn.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(() => {
              copyBtn.innerHTML =
                '<i class="fa-solid fa-copy"></i> نسخ';
            }, 1500);
          } catch {
            output.select();
            document.execCommand("copy");
          }
        }

        exampleBtn.addEventListener("click", () => {
          input.value = exampleXML;

          updateInputStats();
          formatXML();
        });

        formatBtn.addEventListener("click", formatXML);

        clearBtn.addEventListener("click", clearAll);

        copyBtn.addEventListener("click", copyOutput);

        input.addEventListener("input", updateInputStats);

        input.addEventListener("keydown", (event) => {
          if (event.key === "Tab") {
            event.preventDefault();

            const start = input.selectionStart;
            const end = input.selectionEnd;

            input.value =
              input.value.substring(0, start) +
              "  " +
              input.value.substring(end);

            input.selectionStart = input.selectionEnd = start + 2;

            updateInputStats();
          }

          if (event.ctrlKey && event.key === "Enter") {
            event.preventDefault();
            formatXML();
          }
        });

        output.addEventListener("scroll", () => {
          outputLines.scrollTop = output.scrollTop;
        });

        input.addEventListener("scroll", () => {
          inputLines.scrollTop = input.scrollTop;
        });

        updateInputStats();
        updateOutputStats();
      })();
    </script>

