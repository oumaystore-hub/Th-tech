---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "HTML Validator - فحص HTML أونلاين مجاناً | Th.Tech";
const description =
  "أداة HTML Validator مجانية للتحقق من أخطاء HTML واكتشاف الوسوم غير المغلقة والمشكلات الشائعة مباشرة من المتصفح.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>HTML Validator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-circle-check"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              HTML Tools
            </span>

            <h1>
              HTML <span>Validator</span>
            </h1>

            <p>
              افحص كود HTML واكتشف الوسوم غير المغلقة
              والأخطاء الشائعة بسرعة مباشرة من المتصفح.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-code"></i>
              <span>HTML Validator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="formatBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-wand-magic-sparkles"></i>
                تنسيق
              </button>

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Editor -->

          <div class="editor-area">

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  كود HTML
                </div>

                <span id="inputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="input"
                  spellcheck="false"
                  placeholder='اكتب أو ألصق HTML هنا...

مثال:
<!DOCTYPE html>
<html>
  <head>
    <title>Th.Tech</title>
  </head>
  <body>
    <h1>Hello World</h1>
  </body>
</html>'
                ></textarea>

              </div>

            </div>

          </div>


          <!-- Main action -->

          <div class="main-actions">

            <button
              id="validateBtn"
              class="validate-btn"
              type="button"
            >
              <i class="fas fa-circle-check"></i>
              فحص HTML
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- Result -->

          <div id="result" class="result hidden">

            <div class="result-header">

              <div class="result-title">

                <div id="resultIcon" class="result-icon">
                  <i class="fas fa-circle-check"></i>
                </div>

                <div>
                  <h3 id="resultTitle">HTML صالح</h3>
                  <p id="resultDescription">
                    لم يتم العثور على أخطاء أساسية.
                  </p>
                </div>

              </div>

              <div class="result-count">

                <span id="errorCount">0</span>

                <small>أخطاء</small>

              </div>

            </div>


            <div
              id="issues"
              class="issues"
            ></div>

          </div>


          <!-- Statistics -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-file-code"></i>
              </div>

              <div>

                <span
                  class="stat-value"
                  id="lineCount"
                >
                  0
                </span>

                <span class="stat-label">
                  عدد الأسطر
                </span>

              </div>

            </div>


            <div class="stat">

              <div class="stat-icon error-stat">
                <i class="fas fa-circle-exclamation"></i>
              </div>

              <div>

                <span
                  class="stat-value"
                  id="totalErrors"
                >
                  0
                </span>

                <span class="stat-label">
                  الأخطاء
                </span>

              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">
                <i class="fas fa-check"></i>
              </div>

              <div>

                <span
                  class="stat-value"
                  id="validStatus"
                >
                  —
                </span>

                <span class="stat-label">
                  حالة HTML
                </span>

              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>فحص سريع</h3>

              <p>
                افحص الكود فوراً داخل المتصفح بدون الحاجة
                إلى رفع ملفات HTML إلى خادم خارجي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>خصوصية أفضل</h3>

              <p>
                تتم معالجة الكود محلياً داخل جهازك ولا يتم
                إرساله إلى خدمة خارجية.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bug"></i>
            </div>

            <div>

              <h3>اكتشاف الأخطاء</h3>

              <p>
                تساعدك الأداة على اكتشاف الوسوم غير المغلقة
                والمشكلات الشائعة في بنية HTML.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>HTML Validator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-paste"></i>
              </div>

              <h3>
                ألصق HTML
              </h3>

              <p>
                ضع كود HTML الذي تريد فحصه داخل محرر الكود.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-magnifying-glass"></i>
              </div>

              <h3>
                ابدأ الفحص
              </h3>

              <p>
                اضغط على زر فحص HTML لتحليل بنية الكود.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-wrench"></i>
              </div>

              <h3>
                أصلح الأخطاء
              </h3>

              <p>
                راجع الأخطاء الظاهرة وقم بتعديل الكود ثم أعد الفحص.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>HTML Validator</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو HTML Validator؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                هي أداة تساعد على فحص كود HTML واكتشاف
                بعض الأخطاء الشائعة في بنية الوسوم.
              </p>

            </details>


            <details>

              <summary>
                هل يتم إرسال الكود إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. عملية الفحص والتنسيق تتم محلياً
                باستخدام JavaScript داخل المتصفح.
              </p>

            </details>


            <details>

              <summary>
                ما الأخطاء التي تستطيع الأداة اكتشافها؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                تستطيع الأداة اكتشاف العديد من المشكلات
                الشائعة مثل الوسوم غير المغلقة، وإغلاق
                الوسوم بترتيب غير صحيح، وبعض الأخطاء في
                السمات وعلامات الاقتباس.
              </p>

            </details>


            <details>

              <summary>
                هل HTML الذي يحتوي على أخطاء يمكن للمتصفح عرضه؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. متصفحات الويب تحاول غالباً إصلاح أخطاء
                HTML تلقائياً، لذلك قد يعمل الموقع رغم وجود
                أخطاء في الكود. لذلك يظل فحص الكود مهماً.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;

      --primary: #16a34a;
      --primary-hover: #15803d;

      --blue: #2563eb;
      --green: #16a34a;
      --red: #dc2626;
      --orange: #ea580c;

      --border: rgba(15, 23, 42, .09);

      --shadow:
        0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;

      --primary: #22c55e;
      --primary-hover: #16a34a;

      --blue: #3b82f6;
      --green: #22c55e;
      --red: #ef4444;
      --orange: #f97316;

      --border:
        rgba(148, 163, 184, .12);

      --shadow:
        0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;

      background: var(--bg);
      color: var(--text);

      font-family: "Cairo", sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    textarea {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;

      margin: auto;

      padding:
        0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;

      overflow: hidden;

      padding:
        55px 0 65px;

      background: var(--bg2);

      border-bottom:
        1px solid var(--border);
    }


    .hero-bg {
      position: absolute;

      inset: 0;

      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(34, 197, 94, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(37, 99, 235, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 9px;

      margin-bottom: 28px;

      color: var(--muted);

      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;

      opacity: .6;
    }


    .hero-content {
      position: relative;

      display: flex;

      align-items: center;

      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);

      background:
        rgba(34, 197, 94, .10);

      border:
        1px solid rgba(34, 197, 94, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(34, 197, 94, .10);
    }


    .kicker {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;

      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size:
        clamp(2rem, 5vw, 3.2rem);

      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;

      margin: 0;

      color: var(--muted);

      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding:
        65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);

      border:
        1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom:
        1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;

      align-items: center;

      gap: 9px;

      font-size: .9rem;

      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;

      gap: 8px;

      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding:
        7px 13px;

      border-radius: 10px;

      border:
        1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;

      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color:
        rgba(34, 197, 94, .35);

      color: var(--primary);

      transform:
        translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);

      border-color:
        rgba(220, 38, 38, .25);
    }


    /* ================= EDITOR ================= */

    .editor-area {
      padding: 20px;
    }


    .editor-panel {
      overflow: hidden;

      border-radius: 16px;

      border:
        1px solid var(--border);

      background: var(--card2);
    }


    .panel-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      padding:
        12px 15px;

      border-bottom:
        1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;

      font-weight: 700;
    }


    .panel-header > div {
      display: flex;

      align-items: center;

      gap: 7px;
    }


    .panel-header i {
      color: var(--primary);
    }


    .editor-wrapper {
      height: 390px;
    }


    textarea {
      width: 100%;
      height: 100%;

      display: block;

      resize: vertical;

      outline: none;

      border: 0;

      padding: 18px;

      background: transparent;

      color: var(--text);

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .84rem;

      line-height: 1.8;
    }


    textarea::placeholder {
      color: var(--muted);

      opacity: .65;
    }


    /* ================= ACTION ================= */

    .main-actions {
      display: flex;

      justify-content: center;

      padding:
        0 20px 20px;
    }


    .validate-btn {
      min-width: 230px;

      min-height: 52px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      border: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #22c55e,
          #16a34a
        );

      color: white;

      font-family: inherit;

      font-size: .9rem;

      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px
        rgba(22, 163, 74, .22);

      transition: .25s ease;
    }


    .validate-btn:hover {
      transform:
        translateY(-3px);

      box-shadow:
        0 17px 35px
        rgba(22, 163, 74, .30);
    }


    /* ================= RESULT ================= */

    .result {
      margin:
        0 20px 20px;

      overflow: hidden;

      border-radius: 16px;

      border:
        1px solid var(--border);

      background: var(--card2);
    }


    .result.valid {
      border-color:
        rgba(34, 197, 94, .25);
    }


    .result.invalid {
      border-color:
        rgba(220, 38, 38, .25);
    }


    .result-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 18px;

      border-bottom:
        1px solid var(--border);
    }


    .result-title {
      display: flex;

      align-items: center;

      gap: 13px;
    }


    .result-icon {
      width: 45px;
      height: 45px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        rgba(34, 197, 94, .10);

      color: var(--green);
    }


    .result.invalid .result-icon {
      background:
        rgba(220, 38, 38, .10);

      color: var(--red);
    }


    .result-title h3 {
      margin: 0;

      font-size: .95rem;
    }


    .result-title p {
      margin: 3px 0 0;

      color: var(--muted);

      font-size: .72rem;
    }


    .result-count {
      min-width: 55px;

      text-align: center;
    }


    .result-count span {
      display: block;

      color: var(--red);

      font-size: 1.3rem;

      font-weight: 800;
    }


    .result-count small {
      color: var(--muted);

      font-size: .65rem;
    }


    .issues {
      padding: 14px;
    }


    .issue {
      display: flex;

      align-items: flex-start;

      gap: 11px;

      padding:
        12px 13px;

      margin-bottom: 8px;

      border-radius: 11px;

      background:
        rgba(220, 38, 38, .055);

      border:
        1px solid
        rgba(220, 38, 38, .12);
    }


    .issue:last-child {
      margin-bottom: 0;
    }


    .issue-icon {
      color: var(--red);

      margin-top: 3px;
    }


    .issue strong {
      display: block;

      margin-bottom: 2px;

      font-size: .75rem;
    }


    .issue span {
      color: var(--muted);

      font-size: .68rem;

      line-height: 1.7;
    }


    .issue.warning {
      background:
        rgba(234, 88, 12, .055);

      border-color:
        rgba(234, 88, 12, .12);
    }


    .issue.warning .issue-icon {
      color: var(--orange);
    }


    /* ================= STATISTICS ================= */

    .statistics {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 1px;

      background: var(--border);

      border-top:
        1px solid var(--border);
    }


    .stat {
      display: flex;

      align-items: center;

      justify-content: center;

      gap: 12px;

      padding: 22px 15px;

      background: var(--card);
    }


    .stat-icon {
      width: 43px;
      height: 43px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background:
        rgba(37, 99, 235, .09);

      color: var(--blue);
    }


    .stat-icon.error-stat {
      color: var(--red);

      background:
        rgba(220, 38, 38, .09);
    }


    .stat-icon.success {
      color: var(--green);

      background:
        rgba(34, 197, 94, .09);
    }


    .stat-value {
      display: block;

      color: var(--text);

      font-size: 1rem;

      font-weight: 800;

      direction: ltr;

      text-align: right;
    }


    .stat-label {
      display: block;

      color: var(--muted);

      font-size: .68rem;
    }


    /* ================= INFO ================= */

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border:
        1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform:
        translateY(-4px);

      border-color:
        rgba(34, 197, 94, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background:
        rgba(34, 197, 94, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;
    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* ================= STEPS ================= */

    .steps {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border:
        1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;

      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;

      align-items: center;
      justify-content: center;

      margin:
        0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background:
        rgba(34, 197, 94, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border:
        1px solid var(--border);
    }


    summary {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;

      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition:
        transform .2s ease;
    }


    details[open] summary i {
      transform:
        rotate(180deg);
    }


    details p {
      margin: 0;

      padding:
        0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* ================= HIDDEN ================= */

    .hidden {
      display: none !important;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 800px) {

      .tool-hero {
        padding:
          40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }


      .statistics {
        grid-template-columns: 1fr;
      }


      .stat {
        justify-content: flex-start;

        padding-right: 25px;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding:
          30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding:
          45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .editor-area {
        padding: 12px;
      }


      .editor-wrapper {
        height: 300px;
      }


      textarea {
        padding: 14px;

        font-size: .76rem;
      }


      .validate-btn {
        width: 100%;

        min-width: 0;
      }


      .result {
        margin:
          0 12px 12px;
      }


      .result-header {
        align-items: flex-start;
      }


      .result-title {
        align-items: flex-start;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement
              .classList
              .contains('dark-mode');

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      window.addEventListener(
        'storage',
        (event) => {

          if (event.key === 'theme') {

            applyTheme(
              event.newValue === 'dark'
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const input =
        document.getElementById('input');

      const validateBtn =
        document.getElementById('validateBtn');

      const formatBtn =
        document.getElementById('formatBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const inputSize =
        document.getElementById('inputSize');

      const lineCount =
        document.getElementById('lineCount');

      const totalErrors =
        document.getElementById('totalErrors');

      const validStatus =
        document.getElementById('validStatus');

      const result =
        document.getElementById('result');

      const resultIcon =
        document.getElementById('resultIcon');

      const resultTitle =
        document.getElementById('resultTitle');

      const resultDescription =
        document.getElementById('resultDescription');

      const errorCount =
        document.getElementById('errorCount');

      const issues =
        document.getElementById('issues');


      /* ================= SIZE ================= */

      const formatBytes = (bytes) => {

        if (!bytes) {
          return '0 B';
        }

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {

          return `${(
            bytes / 1024
          ).toFixed(2)} KB`;

        }

        return `${(
          bytes /
          (1024 * 1024)
        ).toFixed(2)} MB`;

      };


      const updateStats = () => {

        const value =
          input.value;

        const bytes =
          new Blob([value]).size;

        const lines =
          value
            ? value.split(/\r\n|\r|\n/).length
            : 0;

        inputSize.textContent =
          formatBytes(bytes);

        lineCount.textContent =
          lines;

      };


      /* ================= TAG PARSER ================= */

      const voidTags = new Set([
        'area',
        'base',
        'br',
        'col',
        'embed',
        'hr',
        'img',
        'input',
        'link',
        'meta',
        'param',
        'source',
        'track',
        'wbr'
      ]);


      const rawTags = new Set([
        'script',
        'style'
      ]);


      const getLineNumber = (
        text,
        index
      ) => {

        return (
          text
            .slice(0, index)
            .split(/\r\n|\r|\n/)
            .length
        );

      };


      const addIssue = (
        list,
        type,
        titleText,
        descriptionText
      ) => {

        list.push({
          type,
          title: titleText,
          description: descriptionText
        });

      };


      const validateHTML = (html) => {

        const foundIssues = [];

        if (!html.trim()) {

          addIssue(
            foundIssues,
            'error',
            'لا يوجد كود HTML',
            'أدخل كود HTML أولاً ثم اضغط على فحص HTML.'
          );

          return foundIssues;

        }


        /*
         * إزالة التعليقات مؤقتاً من التحليل.
         * نحتفظ بالمواقع الأصلية لأن الفحص يعتمد
         * على النص الأصلي عند حساب رقم السطر.
         */

        const withoutComments =
          html.replace(
            /<!--[\s\S]*?-->/g,
            ''
          );


        /*
         * اكتشاف التعليقات غير المغلقة.
         */

        const commentStart =
          html.indexOf('<!--');

        if (
          commentStart !== -1 &&
          html.indexOf(
            '-->',
            commentStart + 4
          ) === -1
        ) {

          addIssue(
            foundIssues,
            'error',
            'تعليق HTML غير مغلق',
            `المشكلة تقريباً في السطر ${getLineNumber(
              html,
              commentStart
            )}.`
          );

        }


        /*
         * فحص علامات HTML.
         */

        const tagRegex =
          /<\/?[A-Za-z][^>]*>/g;

        const stack = [];

        let match;


        while (
          (match =
            tagRegex.exec(
              withoutComments
            )) !== null
        ) {

          const tagText =
            match[0];

          const originalIndex =
            html.indexOf(
              tagText
            );

          const line =
            getLineNumber(
              html,
              originalIndex >= 0
                ? originalIndex
                : match.index
            );


          /*
           * تجاهل DOCTYPE.
           */

          if (
            /^<!doctype/i.test(
              tagText
            )
          ) {
            continue;
          }


          /*
           * تجاهل closing غير عادي.
           */

          const closing =
            /^<\//.test(
              tagText
            );


          const nameMatch =
            tagText.match(
              /^<\/?\s*([A-Za-z][A-Za-z0-9:-]*)/
            );


          if (!nameMatch) {
            continue;
          }


          const tagName =
            nameMatch[1].toLowerCase();


          /*
           * فحص الاقتباسات داخل السمات.
           */

          const openingPart =
            tagText
              .replace(
                /^<\/?/,
                ''
              )
              .replace(
                />$/,
                ''
              );


          const quoteCount =
            (
              openingPart.match(
                /"/g
              ) || []
            ).length;


          const singleQuoteCount =
            (
              openingPart.match(
                /'/g
              ) || []
            ).length;


          if (
            quoteCount % 2 !== 0 ||
            singleQuoteCount % 2 !== 0
          ) {

            addIssue(
              foundIssues,
              'error',
              `علامة اقتباس غير مغلقة في <${tagName}>`,
              `تم اكتشاف مشكلة في السمات بالقرب من السطر ${line}.`
            );

          }


          /*
           * الوسوم الذاتية الإغلاق.
           */

          const selfClosing =
            /\/\s*>$/.test(
              tagText
            );


          if (closing) {

            /*
             * البحث عن الوسم المطابق
             * داخل المكدس.
             */

            if (
              stack.length === 0
            ) {

              addIssue(
                foundIssues,
                'error',
                `وسم الإغلاق </${tagName}> بدون وسم فتح`,
                `تم العثور عليه في السطر ${line}.`
              );

              continue;

            }


            const last =
              stack[
                stack.length - 1
              ];


            if (
              last.name === tagName
            ) {

              stack.pop();

            } else {

              const position =
                stack
                  .map(
                    item =>
                      item.name
                  )
                  .lastIndexOf(
                    tagName
                  );


              if (
                position === -1
              ) {

                addIssue(
                  foundIssues,
                  'error',
                  `وسم الإغلاق </${tagName}> غير متطابق`,
                  `لا يوجد وسم <${tagName}> مفتوح في السطر ${line}.`
                );

              } else {

                /*
                 * توجد وسوم مفتوحة قبل الوسم الحالي.
                 */

                for (
                  let i =
                    stack.length - 1;
                  i >= position;
                  i--
                ) {

                  const unclosed =
                    stack[i];

                  addIssue(
                    foundIssues,
                    'error',
                    `ترتيب الوسوم غير صحيح: <${unclosed.name}>`,
                    `تم فتح <${unclosed.name}> في السطر ${unclosed.line} قبل إغلاق <${tagName}>.`
                  );

                }

                stack.splice(
                  position
                );

              }

            }

          } else if (
            !voidTags.has(tagName) &&
            !selfClosing
          ) {

            stack.push({
              name: tagName,
              line
            });

          }

        }


        /*
         * الوسوم التي بقيت مفتوحة.
         */

        if (stack.length) {

          stack
            .slice()
            .reverse()
            .forEach(
              item => {

                addIssue(
                  foundIssues,
                  'error',
                  `الوسم <${item.name}> غير مغلق`,
                  `تم فتح الوسم في السطر ${item.line} ولم يتم العثور على وسم إغلاق مطابق.`
                );

              }
            );

        }


        /*
         * تحذيرات شائعة.
         */

        if (
          /<img\b(?![^>]*\balt\s*=)/i.test(
            html
          )
        ) {

          addIssue(
            foundIssues,
            'warning',
            'صورة بدون خاصية alt',
            'يُنصح بإضافة alt إلى عناصر img لتحسين الوصول وSEO.'
          );

        }


        if (
          /<a\b[^>]*href\s*=\s*["'][^"']*["'][^>]*>\s*<\/a>/i.test(
            html
          )
        ) {

          addIssue(
            foundIssues,
            'warning',
            'رابط فارغ',
            'تم العثور على عنصر a لا يحتوي على محتوى واضح.'
          );

        }


        return foundIssues;

      };


      /* ================= SHOW RESULT ================= */

      const showResult = (
        foundIssues
      ) => {

        result.classList.remove(
          'hidden'
        );


        issues.innerHTML =
          '';


        const errors =
          foundIssues.filter(
            item =>
              item.type === 'error'
          );


        const warnings =
          foundIssues.filter(
            item =>
              item.type === 'warning'
          );


        errorCount.textContent =
          errors.length;


        totalErrors.textContent =
          errors.length;


        if (
          errors.length === 0
        ) {

          result.classList.remove(
            'invalid'
          );

          result.classList.add(
            'valid'
          );


          resultIcon.innerHTML =
            '<i class="fas fa-circle-check"></i>';


          resultTitle.textContent =
            'HTML صالح';


          if (
            warnings.length
          ) {

            resultDescription.textContent =
              `لم يتم العثور على أخطاء أساسية، ولكن توجد ${warnings.length} ملاحظات.`;

          } else {

            resultDescription.textContent =
              'لم يتم العثور على أخطاء أساسية في بنية HTML.';

          }


          validStatus.textContent =
            'صالح';

        } else {

          result.classList.remove(
            'valid'
          );

          result.classList.add(
            'invalid'
          );


          resultIcon.innerHTML =
            '<i class="fas fa-circle-exclamation"></i>';


          resultTitle.textContent =
            'توجد أخطاء في HTML';


          resultDescription.textContent =
            `تم العثور على ${errors.length} أخطاء تحتاج إلى المراجعة.`;

          validStatus.textContent =
            'غير صالح';

        }


        foundIssues.forEach(
          issue => {

            const item =
              document.createElement(
                'div'
              );


            item.className =
              `issue ${
                issue.type === 'warning'
                  ? 'warning'
                  : ''
              }`;


            const icon =
              issue.type === 'warning'
                ? 'fa-triangle-exclamation'
                : 'fa-circle-exclamation';


            item.innerHTML = `
              <div class="issue-icon">
                <i class="fas ${icon}"></i>
              </div>

              <div>
                <strong>${escapeHTML(issue.title)}</strong>
                <span>${escapeHTML(issue.description)}</span>
              </div>
            `;


            issues.appendChild(
              item
            );

          }
        );

      };


      /* ================= ESCAPE ================= */

      const escapeHTML = (
        text
      ) => {

        return String(text)
          .replace(
            /&/g,
            '&amp;'
          )
          .replace(
            /</g,
            '&lt;'
          )
          .replace(
            />/g,
            '&gt;'
          )
          .replace(
            /"/g,
            '&quot;'
          )
          .replace(
            /'/g,
            '&#039;'
          );

      };


      /* ================= VALIDATE ================= */

      const runValidation = () => {

        const html =
          input.value;

        updateStats();


        if (
          !html.trim()
        ) {

          showResult([
            {
              type: 'error',
              title: 'لا يوجد كود HTML',
              description:
                'أدخل كود HTML أولاً ثم حاول مرة أخرى.'
            }
          ]);

          return;

        }


        const foundIssues =
          validateHTML(
            html
          );


        showResult(
          foundIssues
        );

      };


      /* ================= FORMAT ================= */

      const formatHTML = () => {

        const html =
          input.value.trim();


        if (!html) {
          return;
        }


        /*
         * تنسيق بسيط وآمن للكود.
         * لا يعتمد على مكتبة خارجية.
         */

        const tokens =
          html
            .replace(
              />\s*</g,
              '><'
            )
            .replace(
              /\s+/g,
              ' '
            )
            .replace(
              />\s*</g,
              '><'
            )
            .split(/(<[^>]+>)/g)
            .filter(
              item =>
                item.trim()
            );


        let level = 0;

        const lines = [];


        tokens.forEach(
          token => {

            const value =
              token.trim();


            if (!value) {
              return;
            }


            if (
              /^<\//.test(value)
            ) {

              level =
                Math.max(
                  0,
                  level - 1
                );

            }


            lines.push(
              '  '.repeat(level) +
              value
            );


            if (
              /^<([A-Za-z][^>]*)(?<!\/)>$/.test(
                value
              ) &&
              !/^<(br|hr|img|input|meta|link|area|base|embed|source|track|wbr|param)\b/i.test(
                value
              ) &&
              !/^<!/.test(value)
            ) {

              if (
                !/^<\//.test(value) &&
                !/^<.*\/>$/.test(value)
              ) {

                level++;

              }

            }

          }
        );


        input.value =
          lines.join('\n');


        updateStats();

      };


      /* ================= COPY ================= */

      const copyHTML = async () => {

        const value =
          input.value;


        if (!value.trim()) {
          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          input.select();

          document.execCommand(
            'copy'
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        input.value = '';

        result.classList.add(
          'hidden'
        );

        issues.innerHTML =
          '';

        errorCount.textContent =
          '0';

        totalErrors.textContent =
          '0';

        validStatus.textContent =
          '—';

        updateStats();

        input.focus();

      };


      /* ================= EVENTS ================= */

      validateBtn.addEventListener(
        'click',
        runValidation
      );


      formatBtn.addEventListener(
        'click',
        formatHTML
      );


      copyBtn.addEventListener(
        'click',
        copyHTML
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      input.addEventListener(
        'input',
        () => {

          updateStats();

        }
      );


      input.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            runValidation();

          }

        }
      );


      /* ================= INITIAL ================= */

      updateStats();

    })();
  </script>

