---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/ascii-table/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ASCII Table | جدول ASCII | Th.Tech</title>

    <meta
      name="description"
      content="جدول ASCII تفاعلي لعرض رموز ASCII والقيم العشرية والثنائية والسداسية عشرية مع البحث والنسخ السريع."
    />

    <link rel="canonical" href={canonical} />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      :global(html),
      :global(body) {
        margin: 0;
        padding: 0;
        min-height: 100%;
      }

      :global(body) {
        font-family: "Cairo", sans-serif;
        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      :global(body.ascii-dark-theme) {
        background: #0b1120 !important;
        color: #e5edf8 !important;
        color-scheme: dark;
      }

      :global(body.ascii-light-theme) {
        background: #f5f9ff !important;
        color: #172033 !important;
        color-scheme: light;
      }

      .ascii-page {
        --page-bg: #0b1120;
        --page-text: #e5edf8;
        --muted: #9aa9bd;
        --muted-2: #7d8da3;

        --card: #111827;
        --card-2: #172033;
        --input: #172033;

        --border: #263449;
        --border-strong: #34445b;

        --primary: #38bdf8;
        --primary-2: #0ea5e9;

        --success: #22c55e;

        --shadow: 0 16px 45px rgba(0, 0, 0, 0.25);

        width: 100%;
        min-height: calc(100vh - 80px);
        box-sizing: border-box;

        background: var(--page-bg);
        color: var(--page-text);

        padding: 28px 16px 55px;

        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      .ascii-page.force-light {
        --page-bg: #f5f9ff;
        --page-text: #172033;
        --muted: #667085;
        --muted-2: #7a8799;

        --card: #ffffff;
        --card-2: #f7faff;
        --input: #ffffff;

        --border: #dbe5f0;
        --border-strong: #c6d4e4;

        --primary: #0284c7;
        --primary-2: #0369a1;

        --shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
      }

      .ascii-page.force-dark {
        --page-bg: #0b1120;
        --page-text: #e5edf8;
        --muted: #9aa9bd;
        --muted-2: #7d8da3;

        --card: #111827;
        --card-2: #172033;
        --input: #172033;

        --border: #263449;
        --border-strong: #34445b;

        --primary: #38bdf8;
        --primary-2: #0ea5e9;

        --shadow: 0 16px 45px rgba(0, 0, 0, 0.25);
      }

      .ascii-container {
        width: min(1150px, 100%);
        margin: 0 auto;
      }

      /* =========================
         HEADING
      ========================= */

      .tool-heading {
        text-align: center;
        margin: 5px auto 27px;
      }

      .tool-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--primary-2)
          );

        color: #fff;
        font-size: 27px;

        box-shadow:
          0 10px 28px rgba(14, 165, 233, 0.22);
      }

      .tool-heading h1 {
        margin: 0;

        color: var(--page-text);

        font-size: clamp(25px, 5vw, 36px);
        font-weight: 800;
      }

      .tool-heading p {
        max-width: 700px;
        margin: 8px auto 0;

        color: var(--muted);

        font-size: 15px;
        line-height: 1.9;
      }

      /* =========================
         TOOL CARD
      ========================= */

      .tool-card {
        background: var(--card);

        border: 1px solid var(--border);
        border-radius: 20px;

        box-shadow: var(--shadow);

        overflow: hidden;

        transition:
          background-color 0.25s ease,
          border-color 0.25s ease;
      }

      /* =========================
         CONTROLS
      ========================= */

      .controls {
        padding: 20px;

        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;

        gap: 14px;

        border-bottom: 1px solid var(--border);
      }

      .search-box {
        position: relative;
      }

      .search-box i {
        position: absolute;

        top: 50%;
        right: 15px;

        transform: translateY(-50%);

        color: var(--muted);
        pointer-events: none;
      }

      .search-box input,
      .type-select {
        width: 100%;
        height: 48px;

        box-sizing: border-box;

        border: 1px solid var(--border);
        border-radius: 12px;

        background: var(--input);
        color: var(--page-text);

        font-family: "Cairo", sans-serif;
        font-size: 14px;

        outline: none;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .search-box input {
        padding: 0 43px 0 14px;
      }

      .search-box input:focus,
      .type-select:focus {
        border-color: var(--primary);

        box-shadow:
          0 0 0 3px rgba(14, 165, 233, 0.13);
      }

      .type-select {
        padding: 0 13px;
        cursor: pointer;
      }

      /* =========================
         STATS
      ========================= */

      .stats {
        display: flex;
        flex-wrap: wrap;

        gap: 9px;

        padding: 15px 20px;

        border-bottom: 1px solid var(--border);
      }

      .stat {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 7px 11px;

        border-radius: 999px;

        background: var(--card-2);

        color: var(--muted);

        font-size: 12px;
        font-weight: 700;
      }

      .stat strong {
        color: var(--page-text);
      }

      .stat i {
        color: var(--primary);
      }

      /* =========================
         TABLE
      ========================= */

      .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        width: 100%;
        min-width: 650px;

        border-collapse: collapse;
      }

      thead {
        background: var(--card-2);
      }

      th {
        padding: 14px 12px;

        color: var(--page-text);

        font-size: 13px;
        font-weight: 800;

        white-space: nowrap;

        border-bottom: 1px solid var(--border);
      }

      td {
        padding: 12px;

        color: var(--muted);

        font-size: 13px;
        text-align: center;

        border-bottom: 1px solid var(--border);

        white-space: nowrap;
      }

      tbody tr {
        transition:
          background-color 0.15s ease,
          transform 0.15s ease;
      }

      tbody tr:hover {
        background: var(--card-2);
      }

      tbody tr:last-child td {
        border-bottom: 0;
      }

      .char-cell {
        width: 80px;
      }

      .char {
        width: 42px;
        height: 42px;

        margin: auto;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background: var(--card-2);

        color: var(--primary);

        font-family:
          "Courier New",
          monospace;

        font-size: 18px;
        font-weight: 800;
      }

      .char.control {
        font-size: 11px;
        color: var(--muted-2);
      }

      .code {
        color: var(--page-text);

        font-family:
          "Courier New",
          monospace;

        font-weight: 700;
      }

      .hex {
        color: var(--primary);

        font-family:
          "Courier New",
          monospace;

        font-weight: 700;
      }

      .binary {
        font-family:
          "Courier New",
          monospace;

        color: var(--muted);
        direction: ltr;
      }

      .copy-row {
        min-width: 72px;
      }

      .copy-btn {
        width: 36px;
        height: 36px;

        border: 1px solid var(--border);
        border-radius: 9px;

        background: var(--card-2);
        color: var(--muted);

        cursor: pointer;

        transition:
          color 0.18s ease,
          background-color 0.18s ease,
          border-color 0.18s ease;
      }

      .copy-btn:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .copy-btn.copied {
        color: var(--success);
        border-color: rgba(34, 197, 94, 0.4);
      }

      /* =========================
         EMPTY
      ========================= */

      .empty {
        display: none;

        padding: 50px 20px;

        text-align: center;
        color: var(--muted);
      }

      .empty i {
        margin-bottom: 12px;

        font-size: 36px;

        color: var(--muted-2);
      }

      .empty div {
        font-size: 14px;
        font-weight: 700;
      }

      /* =========================
         INFO
      ========================= */

      .info-grid {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 14px;

        margin-top: 18px;
      }

      .info-card {
        padding: 17px;

        background: var(--card);

        border: 1px solid var(--border);
        border-radius: 16px;

        box-shadow: var(--shadow);
      }

      .info-card h3 {
        display: flex;
        align-items: center;
        gap: 8px;

        margin: 0 0 8px;

        color: var(--page-text);

        font-size: 14px;
      }

      .info-card h3 i {
        color: var(--primary);
      }

      .info-card p {
        margin: 0;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.8;
      }

      /* =========================
         RESPONSIVE
      ========================= */

      @media (max-width: 760px) {
        .ascii-page {
          padding: 23px 12px 45px;
        }

        .controls {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        .ascii-page {
          padding: 20px 9px 38px;
        }

        .tool-heading {
          margin-bottom: 21px;
        }

        .tool-icon {
          width: 58px;
          height: 58px;

          border-radius: 16px;

          font-size: 24px;
        }

        .tool-heading h1 {
          font-size: 25px;
        }

        .tool-heading p {
          font-size: 13px;
        }

        .tool-card {
          border-radius: 17px;
        }

        .controls {
          padding: 14px;
          gap: 10px;
        }

        .search-box input,
        .type-select {
          height: 46px;
          font-size: 13px;
        }

        .stats {
          padding: 12px 14px;
          gap: 7px;
        }

        .stat {
          font-size: 11px;
          padding: 6px 9px;
        }

        th {
          padding: 12px 9px;
          font-size: 12px;
        }

        td {
          padding: 10px 8px;
          font-size: 12px;
        }

        .char {
          width: 38px;
          height: 38px;
          font-size: 16px;
        }

        .copy-btn {
          width: 34px;
          height: 34px;
        }

        .info-card {
          padding: 15px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="ascii-page force-dark" id="asciiPage">
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=tools">
    أدوات تقنية
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">Ascii Table</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->

      <div class="ascii-container">

        <section class="tool-heading">
          <div class="tool-icon">
            <i class="fa-solid fa-table"></i>
          </div>

          <h1>ASCII Table</h1>

          <p>
            جدول ASCII تفاعلي يعرض الرموز والقيم العشرية
            والثنائية والسداسية عشرية مع البحث والنسخ السريع.
          </p>
        </section>

        <section class="tool-card">

          <div class="controls">

            <div class="search-box">
              <i class="fa-solid fa-magnifying-glass"></i>

              <input
                id="searchInput"
                type="search"
                placeholder="ابحث برقم ASCII أو الحرف أو HEX..."
                autocomplete="off"
                spellcheck="false"
              />
            </div>

            <select
              id="typeSelect"
              class="type-select"
              aria-label="نوع رموز ASCII"
            >
              <option value="all">كل الرموز</option>
              <option value="control">رموز التحكم</option>
              <option value="printable">الرموز القابلة للطباعة</option>
              <option value="letters">الحروف</option>
              <option value="numbers">الأرقام</option>
              <option value="symbols">الرموز</option>
            </select>

          </div>

          <div class="stats">
            <div class="stat">
              <i class="fa-solid fa-list-ol"></i>
              إجمالي:
              <strong id="totalCount">128</strong>
            </div>

            <div class="stat">
              <i class="fa-solid fa-filter"></i>
              النتائج:
              <strong id="resultCount">128</strong>
            </div>

            <div class="stat">
              <i class="fa-solid fa-code"></i>
              الترميز:
              <strong>ASCII</strong>
            </div>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>الحرف</th>
                  <th>Decimal</th>
                  <th>Hex</th>
                  <th>Binary</th>
                  <th>الاسم</th>
                  <th>نسخ</th>
                </tr>
              </thead>

              <tbody id="asciiBody"></tbody>
            </table>

            <div
              class="empty"
              id="emptyState"
            >
              <i class="fa-solid fa-magnifying-glass"></i>

              <div>
                لم يتم العثور على نتائج مطابقة.
              </div>
            </div>
          </div>

        </section>

        <section class="info-grid">

          <article class="info-card">
            <h3>
              <i class="fa-solid fa-circle-info"></i>
              ما هو ASCII؟
            </h3>

            <p>
              ASCII هو معيار لترميز الأحرف باستخدام قيم رقمية،
              ويضم 128 قيمة من 0 إلى 127.
            </p>
          </article>

          <article class="info-card">
            <h3>
              <i class="fa-solid fa-terminal"></i>
              Decimal
            </h3>

            <p>
              القيمة العشرية هي الرقم المستخدم لتمثيل الحرف
              في نظام ASCII.
            </p>
          </article>

          <article class="info-card">
            <h3>
              <i class="fa-solid fa-hashtag"></i>
              Hex & Binary
            </h3>

            <p>
              يمكنك استخدام القيمة السداسية عشرية أو الثنائية
              عند التعامل مع البرمجة والأنظمة منخفضة المستوى.
            </p>
          </article>

        </section>

      </div>
    









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/ascii-converter/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Ascii Converter</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
  </div>
</section>

<style>
  /* =========================================
     Related Tools
     الوضع الافتراضي = فاتح
     ========================================= */

  .related-tools {
    width: min(1000px, 100%);
    margin: 40px auto 25px;
    padding: 22px;

    border-radius: 18px;

    background: #ffffff !important;
    color: #0f172a !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 8px 24px rgba(15, 23, 42, 0.06) !important;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .related-tools-header {
    margin-bottom: 17px;
  }

  .related-tools-label {
    display: inline-block;

    margin-bottom: 5px;

    color: #0284c7 !important;

    font-size: 0.78rem;
    font-weight: 800;
  }

  .related-tools h2 {
    margin: 0 0 5px;

    color: #0f172a !important;

    font-size: 1.3rem;
    line-height: 1.4;
    font-weight: 800;
  }

  .related-tools p {
    margin: 0;

    color: #64748b !important;

    font-size: 0.85rem;
  }

  /* =========================================
     Cards
     ========================================= */

  .related-tools-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;

    gap: 9px;

    min-height: 58px;

    padding: 9px 10px;

    border-radius: 12px;

    text-decoration: none !important;

    color: #0f172a !important;

    background: #f8fafc !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.035) !important;

    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-2px);

    color: #0f172a !important;

    background: #f0f9ff !important;

    border-color: #38bdf8 !important;

    box-shadow:
      0 6px 14px rgba(14, 165, 233, 0.10) !important;
  }

  /* =========================================
     SVG icon
     ========================================= */

  .related-tool-icon {
    display: grid;
    place-items: center;

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    border-radius: 9px;

    color: #0284c7 !important;

    background: rgba(14, 165, 233, 0.10) !important;
  }

  .related-tool-icon svg {
    width: 18px;
    height: 18px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;

    justify-content: center;

    gap: 2px;

    min-width: 0;
    flex: 1;
  }

  .related-tool-content strong {
    display: block;

    color: #0f172a !important;

    font-size: 0.84rem;
    line-height: 1.25;
    font-weight: 750;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    color: #64748b !important;

    font-size: 0.68rem;
    line-height: 1.2;
  }

  .related-tool-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    flex: 0 0 22px;

    color: #94a3b8 !important;

    font-size: 0.85rem;

    transition:
      transform 0.18s ease,
      color 0.18s ease;
  }

  .related-tool-card:hover .related-tool-arrow {
    color: #0284c7 !important;

    transform: translateX(-2px);
  }

  /* =========================================
     الوضع الليلي الحقيقي في المشروع
     يعتمد على class وليس data-theme
     ========================================= */

  html.dark-mode .related-tools,
  body.dark-mode .related-tools,
