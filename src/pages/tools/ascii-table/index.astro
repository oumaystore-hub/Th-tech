    <Footer />

    <script is:inline>
      (() => {
        /* =====================================================
           THEME SYNC
        ===================================================== */

        function getThemeState() {
          let stored = null;

          try {
            stored = localStorage.getItem("theme");
          } catch (e) {}

          const html = document.documentElement;
          const body = document.body;

          const htmlTheme =
            html.getAttribute("data-theme");

          const bodyTheme =
            body.getAttribute("data-theme");

          const htmlLight =
            htmlTheme === "light" ||
            html.classList.contains("light") ||
            html.classList.contains("light-theme");

          const bodyLight =
            bodyTheme === "light" ||
            body.classList.contains("light") ||
            body.classList.contains("light-theme");

          if (stored === "light") return "light";
          if (stored === "dark") return "dark";

          if (htmlLight || bodyLight) {
            return "light";
          }

          if (
            html.classList.contains("dark") ||
            html.classList.contains("dark-theme") ||
            body.classList.contains("dark") ||
            body.classList.contains("dark-theme")
          ) {
            return "dark";
          }

          return "dark";
        }

        function syncAsciiTheme() {
          const page =
            document.getElementById("asciiPage");

          if (!page) return;

          const light =
            getThemeState() === "light";

          page.classList.toggle(
            "force-light",
            light
          );

          page.classList.toggle(
            "force-dark",
            !light
          );

          document.body.classList.toggle(
            "ascii-light-theme",
            light
          );

          document.body.classList.toggle(
            "ascii-dark-theme",
            !light
          );
        }

        function watchTheme() {
          syncAsciiTheme();

          window.addEventListener(
            "storage",
            syncAsciiTheme
          );

          const observer =
            new MutationObserver(() => {
              syncAsciiTheme();
            });

          observer.observe(
            document.documentElement,
            {
              attributes: true,
              attributeFilter: [
                "class",
                "data-theme"
              ]
            }
          );

          observer.observe(
            document.body,
            {
              attributes: true,
              attributeFilter: [
                "class",
                "data-theme"
              ]
            }
          );
        }

        /* =====================================================
           ASCII DATA
        ===================================================== */

        const controlNames = {
          0: "NUL",
          1: "SOH",
          2: "STX",
          3: "ETX",
          4: "EOT",
          5: "ENQ",
          6: "ACK",
          7: "BEL",
          8: "BS",
          9: "TAB",
          10: "LF",
          11: "VT",
          12: "FF",
          13: "CR",
          14: "SO",
          15: "SI",
          16: "DLE",
          17: "DC1",
          18: "DC2",
          19: "DC3",
          20: "DC4",
          21: "NAK",
          22: "SYN",
          23: "ETB",
          24: "CAN",
          25: "EM",
          26: "SUB",
          27: "ESC",
          28: "FS",
          29: "GS",
          30: "RS",
          31: "US",
          127: "DEL"
        };

        const asciiData = [];

        for (let code = 0; code <= 127; code++) {
          const isControl =
            code < 32 || code === 127;

          const isUpper =
            code >= 65 && code <= 90;

          const isLower =
            code >= 97 && code <= 122;

          const isNumber =
            code >= 48 && code <= 57;

          let character = "";

          if (!isControl) {
            character =
              String.fromCharCode(code);
          }

          let name = "";

          if (isControl) {
            name =
              controlNames[code] ||
              "Control";
          } else if (code === 32) {
            name = "SPACE";
          } else if (isUpper) {
            name = "Uppercase Letter";
          } else if (isLower) {
            name = "Lowercase Letter";
          } else if (isNumber) {
            name = "Digit";
          } else {
            name = "Symbol";
          }

          let type = "symbols";

          if (isControl) {
            type = "control";
          } else if (isUpper || isLower) {
            type = "letters";
          } else if (isNumber) {
            type = "numbers";
          }

          asciiData.push({
            code,
            character,
            hex: code
              .toString(16)
              .toUpperCase()
              .padStart(2, "0"),
            binary: code
              .toString(2)
              .padStart(8, "0"),
            name,
            type,
            isControl
          });
        }

        /* =====================================================
           TOOL
        ===================================================== */

        function startAsciiTool() {
          const body =
            document.getElementById("asciiBody");

          const searchInput =
            document.getElementById("searchInput");

          const typeSelect =
            document.getElementById("typeSelect");

          const resultCount =
            document.getElementById("resultCount");

          const emptyState =
            document.getElementById("emptyState");

          function escapeHTML(value) {
            return value
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;")
              .replace(/'/g, "&#039;");
          }

          function getCharacter(data) {
            if (data.code === 32) {
              return "␠";
            }

            if (data.isControl) {
              return data.name;
            }

            return data.character;
          }

          function matchesSearch(item, query) {
            if (!query) return true;

            const q =
              query.toLowerCase().trim();

            const decimal =
              String(item.code);

            const hex =
              item.hex.toLowerCase();

            const hexWithPrefix =
              `0x${hex}`;

            const binary =
              item.binary;

            const character =
              item.character.toLowerCase();

            const name =
              item.name.toLowerCase();

            return (
              decimal.includes(q) ||
              hex.includes(q) ||
              hexWithPrefix.includes(q) ||
              binary.includes(q) ||
              character.includes(q) ||
              name.includes(q)
            );
          }

          function matchesType(item, type) {
            if (type === "all") {
              return true;
            }

            if (type === "printable") {
              return !item.isControl;
            }

            return item.type === type;
          }

          function render() {
            const query =
              searchInput.value;

            const type =
              typeSelect.value;

            const filtered =
              asciiData.filter((item) => {
                return (
                  matchesSearch(
                    item,
                    query
                  ) &&
                  matchesType(
                    item,
                    type
                  )
                );
              });

            resultCount.textContent =
              filtered.length;

            if (!filtered.length) {
              body.innerHTML = "";
              emptyState.style.display =
                "block";
              return;
            }

            emptyState.style.display =
              "none";

            body.innerHTML =
              filtered.map((item) => {
                const display =
                  getCharacter(item);

                const safeDisplay =
                  escapeHTML(display);

                const safeName =
                  escapeHTML(item.name);

                const controlClass =
                  item.isControl
                    ? " control"
                    : "";

                return `
                  <tr>
                    <td class="char-cell">
                      <div class="char${controlClass}">
                        ${safeDisplay}
                      </div>
                    </td>

                    <td class="code">
                      ${item.code}
                    </td>

                    <td class="hex">
                      0x${item.hex}
                    </td>

                    <td class="binary">
                      ${item.binary}
                    </td>

                    <td>
                      ${safeName}
                    </td>

                    <td class="copy-row">
                      <button
                        type="button"
                        class="copy-btn"
                        data-copy="${item.code}"
                        title="نسخ القيمة"
                        aria-label="نسخ القيمة ${item.code}"
                      >
                        <i class="fa-regular fa-copy"></i>
                      </button>
                    </td>
                  </tr>
                `;
              }).join("");
          }

          async function copyText(text, button) {
            try {
              await navigator.clipboard.writeText(
                text
              );
            } catch {
              const textarea =
                document.createElement("textarea");

              textarea.value = text;

              textarea.style.position =
                "fixed";

              textarea.style.opacity = "0";

              document.body.appendChild(
                textarea
              );

              textarea.select();

              document.execCommand("copy");

              textarea.remove();
            }

            if (button) {
              button.classList.add("copied");

              button.innerHTML =
                '<i class="fa-solid fa-check"></i>';

              setTimeout(() => {
                button.classList.remove(
                  "copied"
                );

                button.innerHTML =
                  '<i class="fa-regular fa-copy"></i>';
              }, 1000);
            }
          }

          body.addEventListener(
            "click",
            (event) => {
              const button =
                event.target.closest(
                  ".copy-btn"
                );

              if (!button) return;

              const value =
                button.dataset.copy;

              copyText(
                value,
                button
              );
            }
          );

          searchInput.addEventListener(
            "input",
            render
          );

          typeSelect.addEventListener(
            "change",
            render
          );

          render();
        }

        function init() {
          watchTheme();

          if (
            document.readyState ===
            "loading"
          ) {
            document.addEventListener(
              "DOMContentLoaded",
              startAsciiTool,
              { once: true }
            );
          } else {
            startAsciiTool();
          }
        }

        init();
      })();
    </script>
  </body>
</html>
