---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = base + '/tools/text-to-binary/';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Text to Binary | تحويل النص إلى Binary</title>

  <meta
    name="description"
    content="أداة احترافية لتحويل النصوص إلى Binary باستخدام UTF-8، مع دعم العربية والإنجليزية والنسخ والمعالجة المحلية."
  />

  <meta
    name="keywords"
    content="Text to Binary, تحويل النص إلى Binary, Binary Converter, UTF-8 Binary, نص إلى ثنائي"
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">

        <div class="breadcrumb">
          <a href={base + '/'}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>

          <a href={base + '/tools/'}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>

          <span>Text to Binary</span>
        </div>

        <div class="hero-icon">
          <i class="fa-solid fa-border-all"></i>
        </div>

        <h1>Text to Binary</h1>

        <p>
          حوّل أي نص إلى تمثيله الثنائي Binary بسهولة ودقة باستخدام ترميز
          UTF-8، مع دعم النصوص العربية والإنجليزية.
        </p>

        <div class="tags">
          <span>
            <i class="fa-solid fa-binary"></i>
            Binary
          </span>

          <span>
            <i class="fa-solid fa-language"></i>
            UTF-8
          </span>

          <span>
            <i class="fa-solid fa-bolt"></i>
            سريع
          </span>

          <span>
            <i class="fa-solid fa-shield-halved"></i>
            Local
          </span>
        </div>

      </div>
    </section>

    <!-- TOOL -->
    <section class="tool-section">
      <div class="tool-container">

        <div class="tool-card">

          <div class="toolbar">

            <div class="toolbar-title">

              <div class="toolbar-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <strong>Text to Binary Converter</strong>
                <small>تحويل النص إلى التمثيل الثنائي</small>
              </div>

            </div>

            <div class="toolbar-actions">

              <button id="sampleBtn" class="btn secondary">
                <i class="fa-solid fa-flask"></i>
                مثال
              </button>

              <button id="convertBtn" class="btn primary">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                تحويل إلى Binary
              </button>

            </div>

          </div>

          <!-- SETTINGS -->
          <div class="settings">

            <div class="setting-item">
              <i class="fa-solid fa-code-branch"></i>

              <div>
                <strong>Encoding</strong>
                <span>UTF-8</span>
              </div>
            </div>

            <div class="setting-item">
              <i class="fa-solid fa-circle-info"></i>

              <div>
                <strong>Format</strong>
                <span>8-bit Binary</span>
              </div>
            </div>

            <div class="setting-item">
              <i class="fa-solid fa-computer"></i>

              <div>
                <strong>Processing</strong>
                <span>داخل المتصفح</span>
              </div>
            </div>

          </div>

          <!-- EDITORS -->
          <div class="editor-grid">

            <!-- INPUT -->
            <div class="editor-panel">

              <div class="panel-head">

                <div>
                  <i class="fa-solid fa-font"></i>
                  النص
                </div>

                <span id="inputStatus">جاهز</span>

              </div>

              <textarea
                id="input"
                spellcheck="false"
                placeholder="اكتب النص الذي تريد تحويله إلى Binary...

مثال:
Hello World!"
              ></textarea>

              <div class="panel-footer">

                <span id="inputStats">
                  0 حرف · 0 بايت
                </span>

                <button id="clearBtn" class="mini-btn danger">
                  <i class="fa-solid fa-trash"></i>
                  مسح
                </button>

              </div>

            </div>

            <!-- OUTPUT -->
            <div class="editor-panel output-panel">

              <div class="panel-head">

                <div>
                  <i class="fa-solid fa-border-all"></i>
                  Binary Output
                </div>

                <span id="outputStatus">
                  لا توجد نتيجة
                </span>

              </div>

              <textarea
                id="output"
                spellcheck="false"
                readonly
                placeholder="ستظهر النتيجة الثنائية هنا..."
              ></textarea>

              <div class="panel-footer">

                <span id="outputStats">
                  0 بت · 0 بايت
                </span>

                <button id="copyBtn" class="mini-btn">
                  <i class="fa-regular fa-copy"></i>
                  نسخ
                </button>

              </div>

            </div>

          </div>

          <!-- ACTIONS -->
          <div class="main-actions">

            <button id="convertBtnBottom" class="action primary-action">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              تحويل إلى Binary
            </button>

            <button id="copyBtnBottom" class="action">
              <i class="fa-regular fa-copy"></i>
              نسخ النتيجة
            </button>

            <button id="clearBtnBottom" class="action">
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

          </div>

          <div id="message" class="message">
            <i class="fa-solid fa-circle-info"></i>
            أدخل نصاً ثم اضغط على «تحويل إلى Binary».
          </div>

        </div>

        <!-- STATS -->
        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-icon blue">
              <i class="fa-solid fa-font"></i>
            </div>

            <div>
              <strong id="statChars">0</strong>
              <span>الأحرف</span>
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-icon purple">
              <i class="fa-solid fa-database"></i>
            </div>

            <div>
              <strong id="statBytes">0</strong>
              <span>البايتات</span>
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-icon green">
              <i class="fa-solid fa-microchip"></i>
            </div>

            <div>
              <strong id="statBits">0</strong>
              <span>Bits</span>
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-icon orange">
              <i class="fa-solid fa-file-code"></i>
            </div>

            <div>
              <strong id="statBinaryLength">0</strong>
              <span>طول Binary</span>
            </div>

          </div>

        </div>

        <!-- PRIVACY -->
        <div class="privacy-card">

          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>المعالجة محلياً</h3>

            <p>
              يتم تحويل النص إلى Binary داخل متصفحك مباشرة، ولا يتم إرسال
              المحتوى إلى أي خادم.
            </p>
          </div>

          <div class="privacy-badge">
            <i class="fa-solid fa-check"></i>
            100% Local
          </div>

        </div>

        <!-- INFO -->
        <section class="info-section">

          <div class="section-title">

            <span>Text → Binary</span>

            <h2>تحويل النص إلى Binary بسهولة</h2>

            <p>
              أداة بسيطة وسريعة للمطورين والطلاب وكل من يحتاج إلى التعامل
              مع التمثيل الثنائي للنصوص.
            </p>

          </div>

          <div class="info-grid">

            <article class="info-card">

              <div class="info-icon">
                <i class="fa-solid fa-language"></i>
              </div>

              <h3>دعم UTF-8</h3>

              <p>
                يعتمد التحويل على UTF-8، لذلك يمكن التعامل مع النصوص العربية
                والإنجليزية واللغات المختلفة.
              </p>

            </article>

            <article class="info-card">

              <div class="info-icon">
                <i class="fa-solid fa-8"></i>
              </div>

              <h3>8-bit Binary</h3>

              <p>
                يتم تمثيل كل Byte على شكل ثمانية Bits مثل
                01001000 و01001001.
              </p>

            </article>

            <article class="info-card">

              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>تحويل سريع</h3>

              <p>
                تتم العملية فوراً داخل المتصفح دون الحاجة إلى رفع الملفات
                أو انتظار خادم خارجي.
              </p>

            </article>

            <article class="info-card">

              <div class="info-icon">
                <i class="fa-solid fa-copy"></i>
              </div>

              <h3>نسخ سريع</h3>

              <p>
                انسخ النتيجة الثنائية بضغطة واحدة لاستخدامها في مشاريعك
                أو دروسك البرمجية.
              </p>

            </article>

          </div>

        </section>

        <!-- HOW TO -->
        <section class="how-section">

          <div class="section-title">

            <span>طريقة الاستخدام</span>

            <h2>كيف تستخدم Text to Binary؟</h2>

          </div>

          <div class="steps">

            <div class="step">

              <div class="step-number">1</div>

              <div>
                <h3>اكتب النص</h3>

                <p>
                  أدخل النص الذي تريد تحويله إلى Binary.
                </p>
              </div>

            </div>

            <div class="step">

              <div class="step-number">2</div>

              <div>
                <h3>ابدأ التحويل</h3>

                <p>
                  اضغط على زر «تحويل إلى Binary» للحصول على النتيجة.
                </p>
              </div>

            </div>

            <div class="step">

              <div class="step-number">3</div>

              <div>
                <h3>انسخ النتيجة</h3>

                <p>
                  اضغط على نسخ لاستخدام Binary في المكان الذي تريده.
                </p>
              </div>

            </div>

          </div>

        </section>

        <!-- FAQ -->
        <section class="faq-section">

          <div class="section-title">

            <span>الأسئلة الشائعة</span>

            <h2>Text to Binary FAQ</h2>

          </div>

          <div class="faq-list">

            <details>
              <summary>
                ما هو Binary؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                Binary أو النظام الثنائي هو نظام عددي يستخدم رقمين فقط،
                هما 0 و1، ويستخدم بشكل أساسي لتمثيل البيانات داخل الحواسيب.
              </p>
            </details>

            <details>
              <summary>
                كيف يتم تحويل النص إلى Binary؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                يتم تحويل النص إلى Bytes باستخدام UTF-8، ثم يتم تمثيل كل
                Byte كسلسلة من ثمانية Bits تتكون من 0 و1.
              </p>
            </details>

            <details>
              <summary>
                هل الأداة تدعم اللغة العربية؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم. تستخدم الأداة UTF-8، ولذلك يمكنها التعامل مع الأحرف
                العربية وغيرها من الأحرف Unicode.
              </p>
            </details>

            <details>
              <summary>
                هل يتم إرسال النص إلى الخادم؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم عملية التحويل بالكامل داخل المتصفح، ولا يتم رفع
                النص إلى خادم خارجي.
              </p>
            </details>

            <details>
              <summary>
                هل يمكن تحويل Binary إلى Text؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم. لذلك ستجد في قائمة الأدوات أداة Binary to Text التي
                تقوم بالعملية العكسية.
              </p>
            </details>

          </div>

        </section>

      </div>
    </section>

  </main>

  <Footer />

  <style>
    :root {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --border: #e1eaf4;
      --text: #142235;
      --muted: #718096;

      --primary: #1689a8;
      --primary-dark: #08738f;
      --primary-soft: #e8f7fb;

      --success: #13a66b;
      --danger: #df5656;

      --shadow: 0 18px 50px rgba(24, 71, 120, 0.08);
    }

    html.dark-mode {
      --bg: #07111c;
      --surface: #0d1a28;
      --surface-2: #101f30;
      --border: #21364b;
      --text: #eaf4fb;
      --muted: #94a9bc;

      --primary: #25a9c9;
      --primary-dark: #1592af;
      --primary-soft: #0d3040;

      --shadow: 0 20px 55px rgba(0, 0, 0, 0.28);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
    }

    button,
    textarea {
      font-family: inherit;
    }

    .hero {
      padding: 42px 20px 72px;

      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(22, 137, 168, 0.13),
          transparent 32%
        ),
        radial-gradient(
          circle at 85% 25%,
          rgba(48, 190, 220, 0.11),
          transparent 30%
        );
    }

    .hero-inner {
      max-width: 1120px;
      margin: auto;
      text-align: center;
    }

    .breadcrumb {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;

      margin-bottom: 28px;

      color: var(--muted);
      font-size: 13px;
    }

    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
    }

    .breadcrumb i {
      font-size: 9px;
    }

    .hero-icon {
      width: 84px;
      height: 84px;

      display: grid;
      place-items: center;

      margin: 0 auto 20px;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          #1689a8,
          #42c2dc
        );

      color: #fff;

      font-size: 38px;

      box-shadow:
        0 18px 38px rgba(22, 137, 168, 0.25);
    }

    .hero h1 {
      margin: 0 0 13px;

      font-size: clamp(30px, 5vw, 48px);

      font-weight: 800;

      letter-spacing: -1px;
    }

    .hero p {
      max-width: 740px;

      margin: auto;

      color: var(--muted);

      font-size: 16px;

      line-height: 1.9;
    }

    .tags {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 9px;

      margin-top: 22px;
    }

    .tags span {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 8px 13px;

      background: var(--surface);
      border: 1px solid var(--border);

      border-radius: 30px;

      color: var(--muted);

      font-size: 12px;
    }

    .tags i {
      color: var(--primary);
    }

    .tool-section {
      padding: 0 20px 80px;

      margin-top: -20px;
    }

    .tool-container {
      max-width: 1120px;
      margin: auto;
    }

    .tool-card {
      padding: 22px;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 24px;

      box-shadow: var(--shadow);
    }

    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 18px;

      padding-bottom: 20px;

      border-bottom: 1px solid var(--border);
    }

    .toolbar-title {
      display: flex;
      align-items: center;

      gap: 13px;
    }

    .toolbar-icon {
      width: 45px;
      height: 45px;

      display: grid;
      place-items: center;

      border-radius: 13px;

      background: var(--primary-soft);

      color: var(--primary);
    }

    .toolbar-title strong {
      display: block;
      font-size: 15px;
    }

    .toolbar-title small {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 11px;
    }

    .toolbar-actions {
      display: flex;
      gap: 9px;
    }

    .btn,
    .action,
    .mini-btn {
      border: 0;

      cursor: pointer;

      transition: 0.2s ease;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      padding: 11px 16px;

      border-radius: 11px;

      font-size: 13px;
    }

    .btn.primary {
      background: var(--primary);
      color: white;
    }

    .btn.primary:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn.secondary {
      background: var(--primary-soft);
      color: var(--primary);
    }

    .btn.secondary:hover {
      transform: translateY(-1px);
    }

    .settings {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;

      padding: 18px 0;
    }

    .setting-item {
      display: flex;
      align-items: center;

      gap: 10px;

      padding: 9px 13px;

      border: 1px solid var(--border);

      border-radius: 11px;

      background: var(--surface-2);
    }

    .setting-item > i {
      color: var(--primary);
      font-size: 14px;
    }

    .setting-item strong {
      display: block;
      font-size: 10px;
    }

    .setting-item span {
      display: block;

      color: var(--muted);

      font-size: 10px;
    }

    .editor-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 16px;
    }

    .editor-panel {
      min-width: 0;

      overflow: hidden;

      background: var(--surface-2);

      border: 1px solid var(--border);

      border-radius: 16px;
    }

    .panel-head,
    .panel-footer {
      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 10px;

      padding: 11px 14px;
    }

    .panel-head {
      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: 12px;
    }

    .panel-head > div {
      display: flex;
      align-items: center;

      gap: 8px;
    }

    .panel-head i {
      color: var(--primary);
    }

    .panel-head span {
      padding: 4px 8px;

      border-radius: 20px;

      background: var(--primary-soft);

      color: var(--primary);

      font-size: 10px;
    }

    textarea {
      display: block;

      width: 100%;

      min-height: 370px;

      padding: 18px;

      border: 0;
      outline: 0;

      resize: vertical;

      background: transparent;

      color: var(--text);

      font-family: "JetBrains Mono", monospace;

      font-size: 13px;

      line-height: 1.9;

      direction: ltr;
      text-align: left;
    }

    textarea::placeholder {
      color: var(--muted);
      opacity: 0.75;
    }

    .panel-footer {
      border-top: 1px solid var(--border);

      color: var(--muted);

      font-size: 10px;
    }

    .mini-btn {
      display: inline-flex;
      align-items: center;

      gap: 6px;

      padding: 6px 10px;

      border: 1px solid var(--border);

      border-radius: 8px;

      background: var(--surface);

      color: var(--muted);

      font-size: 10px;
    }

    .mini-btn:hover {
      color: var(--primary);
      border-color: var(--primary);
    }

    .mini-btn.danger:hover {
      color: var(--danger);
      border-color: var(--danger);
    }

    .main-actions {
      display: flex;

      justify-content: center;

      flex-wrap: wrap;

      gap: 10px;

      padding-top: 18px;
    }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      padding: 11px 18px;

      border: 1px solid var(--border);

      border-radius: 11px;

      background: var(--surface-2);

      color: var(--text);

      font-size: 12px;
    }

    .action:hover {
      transform: translateY(-1px);
    }

    .primary-action {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .primary-action:hover {
      background: var(--primary-dark);
    }

    .message {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin-top: 15px;

      padding: 12px 15px;

      border-radius: 11px;

      background: var(--primary-soft);

      color: var(--primary);

      text-align: center;

      font-size: 12px;
    }

    .stats-grid {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 14px;

      margin-top: 18px;
    }

    .stat-card {
      display: flex;
      align-items: center;

      gap: 12px;

      padding: 17px;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 16px;
    }

    .stat-icon {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background: var(--primary-soft);

      color: var(--primary);

      flex-shrink: 0;
    }

    .stat-icon.purple {
      color: #8855d9;
      background: rgba(136, 85, 217, 0.1);
    }

    .stat-icon.green {
      color: #10a76a;
      background: rgba(16, 167, 106, 0.1);
    }

    .stat-icon.orange {
      color: #e08b28;
      background: rgba(224, 139, 40, 0.1);
    }

    .stat-card strong {
      display: block;
      font-size: 18px;
    }

    .stat-card span {
      display: block;

      color: var(--muted);

      font-size: 10px;
    }

    .privacy-card {
      display: flex;
      align-items: center;

      gap: 14px;

      margin-top: 18px;

      padding: 18px;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 17px;
    }

    .privacy-icon {
      width: 44px;
      height: 44px;

      display: grid;
      place-items: center;

      flex-shrink: 0;

      border-radius: 13px;

      background: rgba(18, 166, 106, 0.1);

      color: var(--success);
    }

    .privacy-card h3 {
      margin: 0 0 3px;

      font-size: 13px;
    }

    .privacy-card p {
      margin: 0;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.7;
    }

    .privacy-badge {
      margin-right: auto;

      white-space: nowrap;

      color: var(--success);

      font-size: 11px;
    }

    .privacy-badge i {
      margin-left: 4px;
    }

    .info-section,
    .how-section,
    .faq-section {
      margin-top: 80px;
    }

    .section-title {
      margin-bottom: 28px;

      text-align: center;
    }

    .section-title > span {
      color: var(--primary);

      font-size: 12px;

      font-weight: 700;
    }

    .section-title h2 {
      margin: 7px 0;

      font-size: 27px;
    }

    .section-title p {
      margin: 0;

      color: var(--muted);

      font-size: 13px;
    }

    .info-grid {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 14px;
    }

    .info-card {
      padding: 23px;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 17px;

      transition: 0.25s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);

      box-shadow: var(--shadow);
    }

    .info-icon {
      width: 45px;
      height: 45px;

      display: grid;
      place-items: center;

      margin-bottom: 17px;

      border-radius: 13px;

      background: var(--primary-soft);

      color: var(--primary);
    }

    .info-card h3 {
      margin: 0 0 8px;

      font-size: 14px;
    }

    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.9;
    }

    .steps {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 15px;
    }

    .step {
      display: flex;

      gap: 13px;

      padding: 20px;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 17px;
    }

    .step-number {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      flex-shrink: 0;

      border-radius: 50%;

      background: var(--primary);

      color: white;

      font-weight: 800;

      font-size: 13px;
    }

    .step h3 {
      margin: 0 0 5px;

      font-size: 13px;
    }

    .step p {
      margin: 0;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.7;
    }

    .faq-list {
      max-width: 850px;

      margin: auto;
    }

    details {
      margin-bottom: 10px;

      overflow: hidden;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 13px;
    }

    summary {
      display: flex;

      align-items: center;
      justify-content: space-between;

      padding: 16px 18px;

      cursor: pointer;

      font-size: 13px;

      font-weight: 700;

      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);

      transition: 0.2s;
    }

    details[open] summary i {
      transform: rotate(180deg);
    }

    details p {
      margin: 0;

      padding: 0 18px 17px;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    @media (max-width: 850px) {
      .editor-grid {
        grid-template-columns: 1fr 1fr;
      }

      .stats-grid,
      .info-grid {
        grid-template-columns: 1fr 1fr;
      }

      .steps {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .hero {
        padding-top: 28px;
      }

      .tool-section {
        padding-left: 12px;
        padding-right: 12px;
      }

      .tool-card {
        padding: 14px;

        border-radius: 18px;
      }

      .toolbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .toolbar-actions {
        width: 100%;
      }

      .toolbar-actions .btn {
        flex: 1;
      }

      .editor-grid {
        grid-template-columns: 1fr;
      }

      textarea {
        min-height: 285px;
      }

      .stats-grid,
      .info-grid {
        grid-template-columns: 1fr 1fr;
      }

      .privacy-card {
        align-items: flex-start;
      }

      .privacy-badge {
        display: none;
      }

      .section-title h2 {
        font-size: 23px;
      }
    }
  </style>

  <script is:inline>
    (() => {

      const input = document.getElementById("input");
      const output = document.getElementById("output");

      const convertBtn = document.getElementById("convertBtn");
      const convertBtnBottom = document.getElementById("convertBtnBottom");

      const sampleBtn = document.getElementById("sampleBtn");

      const copyBtn = document.getElementById("copyBtn");
      const copyBtnBottom = document.getElementById("copyBtnBottom");

      const clearBtn = document.getElementById("clearBtn");
      const clearBtnBottom = document.getElementById("clearBtnBottom");

      const message = document.getElementById("message");

      const inputStats = document.getElementById("inputStats");
      const outputStats = document.getElementById("outputStats");

      const statChars = document.getElementById("statChars");
      const statBytes = document.getElementById("statBytes");
      const statBits = document.getElementById("statBits");
      const statBinaryLength = document.getElementById("statBinaryLength");

      const inputStatus = document.getElementById("inputStatus");
      const outputStatus = document.getElementById("outputStatus");


      function getBytes(text) {
        return new TextEncoder().encode(text);
      }


      function bytesToBinary(bytes) {
        const parts = [];

        for (let i = 0; i < bytes.length; i++) {
          parts.push(
            bytes[i].toString(2).padStart(8, "0")
          );
        }

        return parts.join(" ");
      }


      function updateInputStats() {
        const text = input.value || "";

        const bytes = getBytes(text);

        inputStats.textContent =
          text.length + " حرف · " +
          bytes.length + " بايت";

        statChars.textContent = text.length;
        statBytes.textContent = bytes.length;
        statBits.textContent = bytes.length * 8;
      }


      function updateOutputStats() {
        const text = output.value || "";

        const cleanBinary = text.replace(/\s+/g, "");

        outputStats.textContent =
          cleanBinary.length + " بت · " +
          Math.floor(cleanBinary.length / 8) + " بايت";

        statBinaryLength.textContent =
          cleanBinary.length;
      }


      function showMessage(text, type) {

        message.textContent = text;

        if (type === "success") {

          message.style.background =
            "rgba(18,166,106,0.1)";

          message.style.color =
            "var(--success)";

        } else if (type === "error") {

          message.style.background =
            "rgba(224,82,82,0.1)";

          message.style.color =
            "var(--danger)";

        } else {

          message.style.background =
            "var(--primary-soft)";

          message.style.color =
            "var(--primary)";
        }
      }


      function convert() {

        const text = input.value;

        if (!text) {

          output.value = "";

          updateOutputStats();

          inputStatus.textContent = "فارغ";
          outputStatus.textContent = "لا توجد نتيجة";

          showMessage(
            "أدخل نصاً أولاً ثم اضغط على تحويل إلى Binary.",
            "error"
          );

          return;
        }

        try {

          const bytes = getBytes(text);

          const binary = bytesToBinary(bytes);

          output.value = binary;

          updateInputStats();
          updateOutputStats();

          inputStatus.textContent = "تم التحويل";
          outputStatus.textContent = "جاهز";

          showMessage(
            "تم تحويل النص إلى Binary بنجاح.",
            "success"
          );

        } catch {

          showMessage(
            "حدث خطأ أثناء تحويل النص.",
            "error"
          );
        }
      }


      async function copyOutput() {

        if (!output.value) {

          showMessage(
            "لا توجد نتيجة لنسخها.",
            "error"
          );

          return;
        }

        try {

          await navigator.clipboard.writeText(
            output.value
          );

          showMessage(
            "تم نسخ Binary إلى الحافظة.",
            "success"
          );

        } catch {

          output.select();

          document.execCommand("copy");

          showMessage(
            "تم نسخ النتيجة.",
            "success"
          );
        }
      }


      function loadSample() {

        input.value =
          "Hello World!";

        output.value = "";

        updateInputStats();
        updateOutputStats();

        inputStatus.textContent = "مثال محمل";
        outputStatus.textContent = "لا توجد نتيجة";

        showMessage(
          "تم تحميل مثال. اضغط على تحويل إلى Binary.",
          "info"
        );
      }


      function clearAll() {

        input.value = "";
        output.value = "";

        updateInputStats();
        updateOutputStats();

        inputStatus.textContent = "جاهز";
        outputStatus.textContent = "لا توجد نتيجة";

        showMessage(
          "تم مسح المحتوى وإعادة ضبط الأداة.",
          "info"
        );
      }


      convertBtn.addEventListener(
        "click",
        convert
      );

      convertBtnBottom.addEventListener(
        "click",
        convert
      );

      sampleBtn.addEventListener(
        "click",
        loadSample
      );

      copyBtn.addEventListener(
        "click",
        copyOutput
      );

      copyBtnBottom.addEventListener(
        "click",
        copyOutput
      );

      clearBtn.addEventListener(
        "click",
        clearAll
      );

      clearBtnBottom.addEventListener(
        "click",
        clearAll
      );


      input.addEventListener(
        "input",
        updateInputStats
      );


      input.addEventListener(
        "keydown",
        function(event) {

          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            convert();
          }
        }
      );


      updateInputStats();
      updateOutputStats();


      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");

          if (saved === "dark") {

            document.documentElement.classList.add(
              "dark-mode"
            );

          } else {

            document.documentElement.classList.remove(
              "dark-mode"
            );
          }

        } catch {}
      }


      syncTheme();

      window.addEventListener(
        "themeChange",
        syncTheme
      );


      const themeButton =
        document.getElementById("theme-btn");

      if (themeButton) {

        themeButton.addEventListener(
          "click",
          function() {

            setTimeout(
              syncTheme,
              0
            );

          }
        );
      }

    })();
  </script>

</body>
</html>
