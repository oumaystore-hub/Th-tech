---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "Code Formatter - تنسيق الأكواد أونلاين مجاناً | Th.Tech";

const description =
  "أداة Code Formatter مجانية لتنسيق وترتيب الأكواد البرمجية وتحسين قابليتها للقراءة مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو Code Formatter؟",
    a: "أداة تساعدك على تنسيق وترتيب الأكواد البرمجية وجعلها أكثر وضوحاً وقابلية للقراءة."
  },
  {
    q: "ما اللغات التي يمكن استخدامها؟",
    a: "يمكن للأداة التعامل مع الأكواد الشائعة مثل JavaScript وTypeScript وJSON وCSS وHTML وغيرها باستخدام تنسيق ذكي."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم معالجة الكود مباشرة داخل المتصفح، ولا تحتاج إلى رفع الكود إلى خادم خارجي."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم. الأداة مجانية ويمكن استخدامها مباشرة من المتصفح."
  }
];
