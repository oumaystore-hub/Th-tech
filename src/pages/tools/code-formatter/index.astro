      }


      .step p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          10px;

        line-height:
          1.8;

      }


      /* ======================================
         FAQ
      ======================================= */

      .faq-section {

        margin:
          55px auto 70px;

        max-width:
          850px;

      }


      .faq-list details {

        margin-bottom:
          9px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          14px;

        background:
          var(--surface);

      }


      .faq-list summary {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          15px;

        padding:
          16px 18px;

        cursor:
          pointer;

        list-style:
          none;

        font-size:
          12px;

        font-weight:
          700;

      }


      .faq-list summary::-webkit-details-marker {

        display:
          none;

      }


      .faq-list summary i {

        color:
          var(--muted);

        font-size:
          10px;

        transition:
          transform .2s ease;

      }


      .faq-list details[open]
      summary i {

        transform:
          rotate(180deg);

      }


      .faq-answer {

        padding:
          0 18px 17px;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         RESPONSIVE
      ======================================= */

      @media (max-width: 900px) {

        .editor-grid {

          grid-template-columns:
            1fr;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            repeat(2,1fr);

        }

      }


      @media (max-width: 700px) {

        .tool-stats {

          grid-template-columns:
            repeat(2,1fr);

        }


        .actionbar {

          flex-direction:
            column;

          align-items:
            stretch;

        }


        .action-group {

          width:
            100%;

        }


        .action {

          flex:
            1;

        }

      }


      @media (max-width: 600px) {

        .container {

          width:
            calc(100% - 20px);

        }


        .hero {

          padding:
            25px 0 32px;

        }


        .hero-icon {

          width:
            60px;

          height:
            60px;

          font-size:
            20px;

        }


        .hero p {

          font-size:
            12px;

        }


        .topbar {

          padding:
            14px;

        }


        .topbar-status {

          display:
            none;

        }


        .actionbar {

          padding:
            10px;

        }


        .action {

          padding:
            9px 7px;

          font-size:
            10px;

        }


        .editor-grid {

          padding:
            10px;

        }


        .code-area {

          height:
            330px;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            1fr;

        }


        .formatter-card {

          border-radius:
            18px;

        }

      }

    </style>

