    <script is:inline>
      (() => {

        const input =
          document.getElementById("inputCode");

        const output =
          document.getElementById("outputCode");

        const inputLines =
          document.getElementById("inputLines");

        const outputLines =
          document.getElementById("outputLines");

        const inputStats =
          document.getElementById("inputStats");

        const outputStats =
          document.getElementById("outputStats");

        const outputSize =
          document.getElementById("outputSize");

        const status =
          document.getElementById("status");

        const formatBtn =
          document.getElementById("formatBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const exampleBtn =
          document.getElementById("exampleBtn");


        /* ======================================
           EXAMPLE
        ======================================= */

        const exampleCode = `function calculateTotal(items) {
const prices = items.map(item => item.price);
const total = prices.reduce((sum, price) => sum + price, 0);
return total;
}

const products = [
{name: "Laptop", price: 7500},
{name: "Mouse", price: 250},
{name: "Keyboard", price: 500}
];

const result = calculateTotal(products);

console.log("Total:", result);`;


        /* ======================================
           STATS
        ======================================= */

        function updateEditorStats() {

          const inputValue =
            input.value;

          const outputValue =
            output.value;

          const inputLineCount =
            inputValue
              ? inputValue.split("\n").length
              : 1;

          const outputLineCount =
            outputValue
              ? outputValue.split("\n").length
              : 1;


          inputLines.textContent =
            Array.from(
              { length: inputLineCount },
              (_, i) => i + 1
            ).join("\n");


          outputLines.textContent =
            Array.from(
              { length: outputLineCount },
              (_, i) => i + 1
            ).join("\n");


          inputStats.textContent =
            `${inputValue.length} حرف`;


          outputStats.textContent =
            `${outputValue.length} حرف`;


          const bytes =
            new Blob([outputValue]).size;


          if (bytes < 1024) {

            outputSize.textContent =
              `${bytes} B`;

          } else {

            outputSize.textContent =
              `${(bytes / 1024).toFixed(1)} KB`;

          }

        }


        /* ======================================
           STATUS
        ======================================= */

        function setStatus(type, text) {

          status.className =
            `status ${type}`;

          status.innerHTML = `
            <span class="status-dot"></span>
            ${text}
          `;

        }


        /* ======================================
           PROTECT STRINGS
        ======================================= */

        function protectStrings(code) {

          const placeholders = [];

          const protectedCode =
            code.replace(
              /(["'`])(?:\\.|(?!\1)[\s\S])*?\1|\/\/[^\n]*|\/\*[\s\S]*?\*\//g,
              (match) => {

                const index =
                  placeholders.length;

                placeholders.push(match);

                return `___CODE_PLACEHOLDER_${index}___`;

              }
            );

          return {
            code: protectedCode,
            placeholders
          };

        }


        /* ======================================
           RESTORE STRINGS
        ======================================= */

        function restoreStrings(code, placeholders) {

          return code.replace(
            /___CODE_PLACEHOLDER_(\d+)___/g,
            (_, index) => {
              return placeholders[Number(index)];
            }
          );

        }


        /* ======================================
           FORMAT CODE
        ======================================= */

        function formatCodeSmart(code) {

          let result =
            code
              .replace(/\r\n/g, "\n")
              .replace(/\r/g, "\n")
              .trim();


          if (!result) {
            return "";
          }


          const protectedData =
            protectStrings(result);


          result =
            protectedData.code;


          /*
           * Normalize whitespace.
           */

          result =
            result
              .replace(/[ \t]+/g, " ")
              .replace(/[ \t]*([{}])[\t ]*/g, "$1")
              .replace(/[ \t]*;[ \t]*/g, ";");


          /*
           * Add readable spacing
           * around common operators.
           */

          result =
            result
              .replace(
                /\s*(===|!==|==|!=|=>|<=|>=|\+=|-=|\*=|\/=|&&|\|\||=|\+|-|\*|\/|<|>)\s*/g,
                " $1 "
              );


          /*
           * Normalize commas and colons.
           */

          result =
            result
              .replace(/\s*,\s*/g, ", ")
              .replace(/\s*:\s*/g, ": ");


          /*
           * Create structural lines.
           */

          result =
            result
              .replace(/\{/g, "{\n")
              .replace(/\}/g, "\n}\n")
              .replace(/;/g, ";\n");


          /*
           * Keep arrays and objects readable.
           */

          result =
            result
              .replace(/\[\s+/g, "[")
              .replace(/\s+\]/g, "]");


          /*
           * Remove excessive blank lines.
           */

          result =
            result
              .replace(/\n[ \t]+\n/g, "\n")
              .replace(/\n{3,}/g, "\n\n");


          const lines =
            result
              .split("\n")
              .map(line => line.trim())
              .filter(Boolean);


          let indent = 0;

          const formatted = [];


          for (let line of lines) {

            /*
             * Decrease indentation before
             * closing braces.
             */

            if (
              line.startsWith("}") ||
              line.startsWith("]") ||
              line.startsWith(")")
            ) {

              indent =
                Math.max(
                  0,
                  indent - 1
                );

            }


            formatted.push(
              "  ".repeat(indent) +
              line
            );


            const opens =
              (line.match(/\{/g) || []).length;

            const closes =
              (line.match(/\}/g) || []).length;


            indent +=
              opens - closes;


            indent =
              Math.max(
                0,
                indent
              );

          }


          result =
            formatted.join("\n");


          /*
           * Restore strings and comments.
           */

          result =
            restoreStrings(
              result,
              protectedData.placeholders
            );


          /*
           * Improve common syntax.
           */

          result =
            result
              .replace(
                /,\s+/g,
                ", "
              )
              .replace(
                /\(\s+/g,
                "("
              )
              .replace(
                /\s+\)/g,
                ")"
              )
              .replace(
                /\[\s+/g,
                "["
              )
              .replace(
                /\s+\]/g,
                "]"
              );


          /*
           * Improve control-flow formatting.
           */

          result =
            result
              .replace(
                /}\s+(else|catch|finally)/g,
                "}\n$1"
              )
              .replace(
                /;\s+(const|let|var|function|if|for|while|return)/g,
                ";\n$1"
              )
              .replace(
                /\n{3,}/g,
                "\n\n"
              );


          return result.trim();

        }


        /* ======================================
           FORMAT
        ======================================= */

        function formatCode() {

          const code =
            input.value.trim();


          if (!code) {

            output.value = "";

            updateEditorStats();

            setStatus(
              "warning",
              "أدخل الكود أولاً"
            );

            input.focus();

            return;

          }


          const started =
            performance.now();


          try {

            const formatted =
              formatCodeSmart(code);


            output.value =
              formatted;


            updateEditorStats();


            const elapsed =
              performance.now() - started;


            setStatus(
              "success",
              `تم التنسيق خلال ${elapsed.toFixed(1)} ms`
            );


          } catch (error) {

            output.value = "";

            updateEditorStats();

            setStatus(
              "error",
              "تعذر تنسيق الكود"
            );

          }

        }


        /* ======================================
           COPY
        ======================================= */

        async function copyOutput() {

          const value =
            output.value;


          if (!value) {

            setStatus(
              "warning",
              "لا يوجد كود لنسخه"
            );

            return;

          }


          try {

            await navigator.clipboard.writeText(
              value
            );


            const oldText =
              copyBtn.innerHTML;


            copyBtn.innerHTML = `
              <i class="fa-solid fa-check"></i>
              تم النسخ
            `;


            setStatus(
              "success",
              "تم نسخ الكود"
            );


            setTimeout(() => {

              copyBtn.innerHTML =
                oldText;

            }, 1500);


          } catch {

            output.select();

            document.execCommand("copy");

            setStatus(
              "success",
              "تم نسخ الكود"
            );

          }

        }


        /* ======================================
           CLEAR
        ======================================= */

        function clearAll() {

          input.value = "";

          output.value = "";

          updateEditorStats();

          setStatus(
            "idle",
            "جاهز"
          );

          input.focus();

        }


        /* ======================================
           EXAMPLE
        ======================================= */

        exampleBtn.addEventListener(
          "click",
          () => {

            input.value =
              exampleCode;

            updateEditorStats();

            formatCode();

            input.focus();

          }
        );


        /* ======================================
           EVENTS
        ======================================= */

        formatBtn.addEventListener(
          "click",
          formatCode
        );


        copyBtn.addEventListener(
          "click",
          copyOutput
        );


        clearBtn.addEventListener(
          "click",
          clearAll
        );


        input.addEventListener(
          "input",
          updateEditorStats
        );


        input.addEventListener(
          "scroll",
          () => {

            inputLines.scrollTop =
              input.scrollTop;

          }
        );


        output.addEventListener(
          "scroll",
          () => {

            outputLines.scrollTop =
              output.scrollTop;

          }
        );


        /* ======================================
           TAB + CTRL ENTER
        ======================================= */

        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();


              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;


              input.value =
                input.value.substring(
                  0,
                  start
                ) +
                "  " +
                input.value.substring(
                  end
                );


              input.selectionStart =
                input.selectionEnd =
                  start + 2;


              updateEditorStats();

            }


            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {

              event.preventDefault();

              formatCode();

            }

          }
        );


        /* ======================================
           INITIAL
        ======================================= */

        updateEditorStats();

      })();
    </script>


