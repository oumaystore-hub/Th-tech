---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/mime-type-lookup/`;

const mimeTypes = [
  ['.html','text/html','HTML','Web'],
  ['.htm','text/html','HTML','Web'],
  ['.css','text/css','CSS','Web'],
  ['.js','text/javascript','JavaScript','Web'],
  ['.mjs','text/javascript','JavaScript Module','Web'],
  ['.json','application/json','JSON','Data'],
  ['.xml','application/xml','XML','Data'],
  ['.csv','text/csv','CSV','Data'],
  ['.txt','text/plain','Plain Text','Text'],
  ['.md','text/markdown','Markdown','Text'],
  ['.rtf','application/rtf','Rich Text Format','Text'],

  ['.pdf','application/pdf','PDF','Document'],
  ['.doc','application/msword','Microsoft Word','Document'],
  ['.docx','application/vnd.openxmlformats-officedocument.wordprocessingml.document','Word Document','Document'],
  ['.xls','application/vnd.ms-excel','Microsoft Excel','Document'],
  ['.xlsx','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','Excel Spreadsheet','Document'],
  ['.ppt','application/vnd.ms-powerpoint','PowerPoint','Document'],
  ['.pptx','application/vnd.openxmlformats-officedocument.presentationml.presentation','PowerPoint Presentation','Document'],

  ['.jpg','image/jpeg','JPEG Image','Image'],
  ['.jpeg','image/jpeg','JPEG Image','Image'],
  ['.png','image/png','PNG Image','Image'],
  ['.gif','image/gif','GIF Image','Image'],
  ['.webp','image/webp','WebP Image','Image'],
  ['.svg','image/svg+xml','SVG Image','Image'],
  ['.ico','image/x-icon','Icon','Image'],
  ['.bmp','image/bmp','Bitmap Image','Image'],
  ['.avif','image/avif','AVIF Image','Image'],
  ['.tif','image/tiff','TIFF Image','Image'],
  ['.tiff','image/tiff','TIFF Image','Image'],

  ['.mp3','audio/mpeg','MP3 Audio','Audio'],
  ['.wav','audio/wav','WAV Audio','Audio'],
  ['.ogg','audio/ogg','Ogg Audio','Audio'],
  ['.oga','audio/ogg','Ogg Audio','Audio'],
  ['.m4a','audio/mp4','MPEG-4 Audio','Audio'],
  ['.aac','audio/aac','AAC Audio','Audio'],
  ['.flac','audio/flac','FLAC Audio','Audio'],
  ['.opus','audio/opus','Opus Audio','Audio'],

  ['.mp4','video/mp4','MPEG-4 Video','Video'],
  ['.webm','video/webm','WebM Video','Video'],
  ['.avi','video/x-msvideo','AVI Video','Video'],
  ['.mpeg','video/mpeg','MPEG Video','Video'],
  ['.mpg','video/mpeg','MPEG Video','Video'],
  ['.mov','video/quicktime','QuickTime Video','Video'],
  ['.mkv','video/x-matroska','Matroska Video','Video'],
  ['.ogv','video/ogg','Ogg Video','Video'],

  ['.zip','application/zip','ZIP Archive','Archive'],
  ['.rar','application/vnd.rar','RAR Archive','Archive'],
  ['.7z','application/x-7z-compressed','7-Zip Archive','Archive'],
  ['.tar','application/x-tar','TAR Archive','Archive'],
  ['.gz','application/gzip','GZIP Archive','Archive'],
  ['.bz','application/x-bzip','BZIP Archive','Archive'],
  ['.bz2','application/x-bzip2','BZIP2 Archive','Archive'],
  ['.xz','application/x-xz','XZ Archive','Archive'],

  ['.wasm','application/wasm','WebAssembly','Application'],
  ['.bin','application/octet-stream','Binary File','Application'],
  ['.apk','application/vnd.android.package-archive','Android Package','Application'],
  ['.jar','application/java-archive','Java Archive','Application'],
  ['.sql','application/sql','SQL','Application'],
  ['.graphql','application/graphql','GraphQL','Application'],

  ['.woff','font/woff','WOFF Font','Font'],
  ['.woff2','font/woff2','WOFF2 Font','Font'],
  ['.ttf','font/ttf','TrueType Font','Font'],
  ['.otf','font/otf','OpenType Font','Font'],

  ['.webmanifest','application/manifest+json','Web App Manifest','Web'],
  ['.rss','application/rss+xml','RSS','Data'],
  ['.atom','application/atom+xml','Atom Feed','Data'],

  ['.sh','application/x-sh','Shell Script','Code'],
  ['.php','application/x-httpd-php','PHP','Code'],
  ['.py','text/x-python','Python','Code'],
  ['.java','text/x-java-source','Java','Code'],
  ['.c','text/x-c','C Source','Code'],
  ['.cpp','text/x-c++','C++ Source','Code'],
  ['.h','text/x-c','C Header','Code'],
  ['.ts','video/mp2t','TypeScript','Code']
];

const categories = [
  ['all','الكل'],
  ['Web','Web'],
  ['Data','Data'],
  ['Document','Documents'],
  ['Text','Text'],
  ['Image','Images'],
  ['Audio','Audio'],
  ['Video','Video'],
  ['Archive','Archives'],
  ['Application','Applications'],
  ['Font','Fonts'],
  ['Code','Code']
];
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>MIME Type Lookup | البحث عن MIME Types - Th.Tech</title>

  <meta
    name="description"
    content="أداة MIME Type Lookup للبحث عن MIME Type حسب امتداد الملف ونوع المحتوى."
  />

  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#08111f" />

  <style is:global>
    :root {
      color-scheme: dark;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      background: #08111f;
      transition: background .25s ease, color .25s ease;
    }

    html.page-light,
    html.page-light body,
    body.page-light {
      background: #f4f8fc !important;
      color: #172033;
    }

    * {
      box-sizing: border-box;
    }

    .mime-page {
      min-height: 100vh;
      padding: 32px 14px 70px;
      background:
        radial-gradient(circle at 8% 5%, rgba(14,165,233,.15), transparent 28%),
        radial-gradient(circle at 92% 22%, rgba(59,130,246,.12), transparent 30%),
        #08111f;
      color: #e8eef8;
      transition: background .25s ease, color .25s ease;
    }

    .mime-page.light {
      background:
        radial-gradient(circle at 8% 5%, rgba(14,165,233,.08), transparent 28%),
        #f4f8fc;
      color: #172033;
    }

    .container {
      width: min(1120px,100%);
      margin: auto;
    }

    .hero {
      text-align: center;
      margin-bottom: 27px;
    }

    .icon-box {
      width: 76px;
      height: 76px;
      margin: auto auto 17px;
      border-radius: 22px;
      display: grid;
      place-items: center;
      background: rgba(14,165,233,.12);
      border: 1px solid rgba(14,165,233,.35);
    }

    .icon-box svg {
      width: 42px;
      height: 42px;
      stroke: #06b6d4;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(28px,5vw,42px);
      font-weight: 900;
    }

    .subtitle {
      max-width: 720px;
      margin: auto;
      color: #8190a5;
      font-size: 15px;
      line-height: 1.8;
    }

    .mime-page.light .subtitle {
      color: #64748b;
    }

    .lookup-box {
      padding: 18px;
      margin-bottom: 18px;
      border-radius: 24px;
      background: rgba(17,30,49,.84);
      border: 1px solid rgba(148,163,184,.17);
      box-shadow: 0 20px 50px rgba(0,0,0,.17);
    }

    .mime-page.light .lookup-box {
      background: rgba(255,255,255,.92);
      border-color: #dbe4ee;
      box-shadow: 0 15px 35px rgba(15,23,42,.07);
    }

    .search-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap svg {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      width: 21px;
      height: 21px;
      stroke: #718096;
    }

    #searchInput {
      width: 100%;
      height: 56px;
      padding: 0 50px 0 18px;
      border-radius: 15px;
      border: 1px solid #33445c;
      background: #0c1829;
      color: white;
      outline: none;
      font-family: inherit;
      font-size: 15px;
    }

    #searchInput:focus {
      border-color: #06b6d4;
      box-shadow: 0 0 0 3px rgba(6,182,212,.1);
    }

    .mime-page.light #searchInput {
      background: #f8fafc;
      color: #172033;
      border-color: #cbd5e1;
    }

    .clear-btn {
      height: 56px;
      padding: 0 18px;
      border-radius: 15px;
      border: 1px solid #33445c;
      background: #122238;
      color: #b7c3d4;
      font-family: inherit;
      cursor: pointer;
    }

    .mime-page.light .clear-btn {
      background: white;
      color: #475569;
      border-color: #d2dce8;
    }

    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 13px;
    }

    .category-btn {
      padding: 9px 13px;
      border-radius: 11px;
      border: 1px solid #33445c;
      background: #101e31;
      color: #91a0b5;
      font-family: inherit;
      font-size: 12px;
      cursor: pointer;
    }

    .category-btn.active {
      background: #0891b2;
      border-color: #22d3ee;
      color: white;
    }

    .mime-page.light .category-btn {
      background: white;
      color: #64748b;
      border-color: #d6e0eb;
    }

    .mime-page.light .category-btn.active {
      background: #0891b2;
      color: white;
      border-color: #0891b2;
    }

    .stats {
      display: flex;
      justify-content: space-between;
      margin-top: 13px;
      color: #748298;
      font-size: 12px;
    }

    .table-box {
      overflow: hidden;
      border-radius: 22px;
      border: 1px solid rgba(148,163,184,.17);
      background: rgba(17,30,49,.82);
    }

    .mime-page.light .table-box {
      background: white;
      border-color: #dbe4ee;
    }

    .table-head,
    .mime-row {
      display: grid;
      grid-template-columns: 1fr 2.4fr 1.4fr 1fr;
      gap: 12px;
      align-items: center;
      padding: 15px 18px;
    }

    .table-head {
      background: rgba(14,165,233,.07);
      border-bottom: 1px solid rgba(148,163,184,.15);
      color: #94a3b8;
      font-size: 12px;
      font-weight: 800;
    }

    .mime-row {
      border-bottom: 1px solid rgba(148,163,184,.1);
      transition: .18s;
    }

    .mime-row:hover {
      background: rgba(14,165,233,.045);
    }

    .extension {
      direction: ltr;
      text-align: right;
      color: #38bdf8;
      font: 800 14px "JetBrains Mono","Courier New",monospace;
    }

    .mime-value {
      direction: ltr;
      text-align: right;
      color: #cbd5e1;
      font: 12px "JetBrains Mono","Courier New",monospace;
      word-break: break-all;
    }

    .mime-page.light .mime-value {
      color: #334155;
    }

    .file-name {
      color: #e2e8f0;
      font-size: 13px;
    }

    .mime-page.light .file-name {
      color: #334155;
    }

    .type-badge {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 8px;
      background: rgba(14,165,233,.09);
      color: #67e8f9;
      border: 1px solid rgba(34,211,238,.17);
      font-size: 10px;
    }

    .mime-page.light .type-badge {
      color: #0e7490;
      background: #ecfeff;
      border-color: #a5f3fc;
    }

    .copy-btn {
      width: 33px;
      height: 33px;
      margin-inline-start: auto;
      display: grid;
      place-items: center;
      border: 1px solid rgba(148,163,184,.18);
      border-radius: 9px;
      background: rgba(100,116,139,.08);
      color: #94a3b8;
      cursor: pointer;
    }

    .copy-btn svg {
      width: 16px;
      height: 16px;
    }

    .empty {
      display: none;
      padding: 55px 20px;
      text-align: center;
      color: #718096;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 15px;
      margin-top: 35px;
    }

    .info-card {
      padding: 21px;
      border-radius: 20px;
      border: 1px solid rgba(148,163,184,.15);
      background: rgba(17,30,49,.65);
    }

    .mime-page.light .info-card {
      background: white;
      border-color: #dbe4ee;
    }

    .info-card h2 {
      margin: 0 0 9px;
      font-size: 17px;
    }

    .info-card p {
      margin: 0;
      color: #8290a4;
      font-size: 13px;
      line-height: 1.85;
    }

    @media(max-width:760px) {
      .table-head {
        display: none;
      }

      .mime-row {
        grid-template-columns: 90px 1fr auto;
        gap: 10px;
        padding: 16px 14px;
      }

      .mime-row .file-name {
        grid-column: 2;
        grid-row: 2;
      }

      .mime-row .type-badge {
        grid-column: 1;
        grid-row: 2;
      }

      .mime-row .copy-btn {
        grid-column: 3;
        grid-row: 1 / span 2;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }
    }

    @media(max-width:520px) {
      .search-row {
        grid-template-columns: 1fr;
      }

      .clear-btn {
        width: 100%;
      }

      .categories {
        display: grid;
        grid-template-columns: repeat(2,1fr);
      }

      .category-btn:first-child {
        grid-column: span 2;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="mime-page" id="mimePage">
    <div class="container">

      <section class="hero">
        <div class="icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
            <path d="M6 3h8l5 5v13H6z"/>
            <path d="M14 3v6h5"/>
            <path d="M9 13h6M9 17h5"/>
          </svg>
        </div>

        <h1>MIME Type Lookup</h1>

        <p class="subtitle">
          ابحث عن MIME Type لأي امتداد ملف واعرف نوع المحتوى المناسب له بسرعة
        </p>
      </section>

      <section class="lookup-box">

        <div class="search-row">
          <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-4-4"/>
            </svg>

            <input
              id="searchInput"
              type="search"
              placeholder="ابحث مثل: .json أو image/png أو PDF..."
              autocomplete="off"
              spellcheck="false"
            />
          </div>

          <button class="clear-btn" id="clearBtn" type="button">
            مسح البحث
          </button>
        </div>

        <div class="categories">
          {categories.map(category => (
            <button
              class:list={['category-btn', category[0] === 'all' && 'active']}
              data-category={category[0]}
              type="button"
            >
              {category[1]}
            </button>
          ))}
        </div>

        <div class="stats">
          <span id="resultText">عرض {mimeTypes.length} نوع</span>
          <span>MIME Type Reference</span>
        </div>

      </section>

      <section class="table-box">

        <div class="table-head">
          <div>الامتداد</div>
          <div>MIME Type</div>
          <div>الاسم</div>
          <div>الفئة</div>
        </div>

        <div id="mimeList">
          {mimeTypes.map(item => (
            <div
              class="mime-row"
              data-category={item[3]}
              data-search={`${item[0]} ${item[1]} ${item[2]} ${item[3]}`.toLowerCase()}
            >
              <div class="extension">{item[0]}</div>

              <div class="mime-value">{item[1]}</div>

              <div class="file-name">{item[2]}</div>

              <div>
                <span class="type-badge">{item[3]}</span>
              </div>

              <button
                class="copy-btn"
                type="button"
                data-copy={item[1]}
                aria-label={`نسخ ${item[1]}`}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="11" height="11" rx="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
              </button>
            </div>
          ))}
        </div>

      </section>

      <div class="empty" id="emptyState">
        لم يتم العثور على MIME Type مطابق.
      </div>

      <section class="info-grid">

        <article class="info-card">
          <h2>ما هو MIME Type؟</h2>
          <p>
            MIME Type يحدد طبيعة المحتوى الذي يتم نقله عبر الإنترنت،
            ويساعد المتصفح والخادم على معرفة كيفية التعامل مع الملف.
          </p>
        </article>

        <article class="info-card">
          <h2>أمثلة</h2>
          <p>
            HTML يستخدم text/html، وCSS يستخدم text/css،
            وJSON يستخدم application/json، والصور تستخدم image/png أو image/jpeg.
          </p>
        </article>

        <article class="info-card">
          <h2>Content-Type</h2>
          <p>
            يستخدم MIME Type بشكل أساسي في ترويسة HTTP
            المسماة Content-Type لتحديد نوع البيانات المرسلة.
          </p>
        </article>

      </section>

    </div>
  </main>

  <Footer />

  <script is:inline>
    const mimePage = document.getElementById('mimePage');
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearBtn');
    const rows = [...document.querySelectorAll('.mime-row')];
    const categoryButtons = [...document.querySelectorAll('.category-btn')];
    const resultText = document.getElementById('resultText');
    const emptyState = document.getElementById('emptyState');

    let activeCategory = 'all';

    function syncTheme() {
      const root = document.documentElement;

      const light =
        root.dataset.theme === 'light' ||
        root.classList.contains('light');

      root.classList.toggle('page-light', light);
      document.body.classList.toggle('page-light', light);
      mimePage.classList.toggle('light', light);

      root.style.colorScheme = light ? 'light' : 'dark';
    }

    syncTheme();

    new MutationObserver(syncTheme).observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: ['class', 'data-theme']
      }
    );

    function applyFilter() {
      const query = searchInput.value.trim().toLowerCase();

      let visible = 0;

      rows.forEach(row => {
        const matchesSearch =
          !query || row.dataset.search.includes(query);

        const matchesCategory =
          activeCategory === 'all' ||
          row.dataset.category === activeCategory;

        const show =
          matchesSearch && matchesCategory;

        row.style.display = show ? 'grid' : 'none';

        if (show) visible++;
      });

      resultText.textContent = `عرض ${visible} نوع`;

      emptyState.style.display =
        visible ? 'none' : 'block';
    }

    searchInput.addEventListener(
      'input',
      applyFilter
    );

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      activeCategory = 'all';

      categoryButtons.forEach(button => {
        button.classList.toggle(
          'active',
          button.dataset.category === 'all'
        );
      });

      applyFilter();
      searchInput.focus();
    });

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        activeCategory =
          button.dataset.category || 'all';

        categoryButtons.forEach(item => {
          item.classList.toggle(
            'active',
            item === button
          );
        });

        applyFilter();
      });
    });

    document.querySelectorAll('.copy-btn').forEach(button => {
      button.addEventListener('click', async () => {
        const value = button.dataset.copy || '';

        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const textarea =
            document.createElement('textarea');

          textarea.value = value;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(textarea);
          textarea.select();

          try {
            document.execCommand('copy');
          } catch {}

          textarea.remove();
        }

        const oldHTML = button.innerHTML;

        button.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2">
            <path d="m5 12 4 4L19 6"/>
          </svg>
        `;

        setTimeout(() => {
          button.innerHTML = oldHTML;
        }, 1100);
      });
    });

    applyFilter();
  </script>
</body>
</html>
