---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/mime-type-lookup/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>MIME Type Lookup | البحث عن نوع MIME</title>
  <meta
    name="description"
    content="أداة مجانية للبحث عن MIME Type انطلاقًا من امتداد الملف أو نوع MIME، مع إمكانية النسخ والبحث السريع."
  />
  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>
  <Header />

  <main class="mime-page">
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=tools">
    أدوات تقنية
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">Mime Type Lookup</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->


    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">
        <i class="fa-solid fa-file-code"></i>
        أداة المطورين
      </div>

      <h1>
        MIME Type
        <span>Lookup</span>
      </h1>

      <p>
        ابحث عن نوع MIME لأي امتداد ملف بسرعة، أو ابحث عن الامتداد
        انطلاقًا من نوع MIME.
      </p>

      <div class="hero-points">
        <span>
          <i class="fa-solid fa-bolt"></i>
          بحث سريع
        </span>

        <span>
          <i class="fa-solid fa-database"></i>
          قاعدة بيانات محلية
        </span>

        <span>
          <i class="fa-solid fa-copy"></i>
          نسخ بنقرة
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          بدون رفع ملفات
        </span>
      </div>
    </section>

    <!-- Tool -->
    <section class="tool-card">

      <div class="tool-top">
        <div class="tool-title">
          <div class="tool-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <div>
            <h2>البحث عن MIME Type</h2>
            <p>أدخل امتداد الملف أو MIME Type للعثور على المعلومات المناسبة.</p>
          </div>
        </div>

        <div class="status">
          <span class="status-dot"></span>
          يعمل محليًا
        </div>
      </div>

      <!-- Search -->
      <div class="search-box">
        <label for="mimeInput">
          <i class="fa-solid fa-search"></i>
          البحث
        </label>

        <div class="search-row">
          <div class="input-wrap">
            <i class="fa-solid fa-file-circle-question"></i>

            <input
              id="mimeInput"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="مثال: .json أو json أو application/json"
              dir="ltr"
            />

            <button id="clearBtn" class="clear-btn" type="button" title="مسح">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <button id="searchBtn" class="primary-btn" type="button">
            <i class="fa-solid fa-magnifying-glass"></i>
            بحث
          </button>
        </div>

        <div class="search-hint">
          <i class="fa-solid fa-circle-info"></i>
          يمكنك كتابة الامتداد مع أو بدون النقطة.
        </div>
      </div>

      <!-- Quick extensions -->
      <div class="quick-section">
        <div class="section-label">
          <i class="fa-solid fa-bolt"></i>
          بحث سريع
        </div>

        <div class="quick-list">
          <button data-query=".html">HTML</button>
          <button data-query=".css">CSS</button>
          <button data-query=".js">JavaScript</button>
          <button data-query=".json">JSON</button>
          <button data-query=".png">PNG</button>
          <button data-query=".jpg">JPG</button>
          <button data-query=".pdf">PDF</button>
          <button data-query=".zip">ZIP</button>
        </div>
      </div>

      <!-- Categories -->
      <div class="categories">
        <div class="section-label">
          <i class="fa-solid fa-layer-group"></i>
          التصنيف
        </div>

        <div class="category-list">
          <button class="category active" data-category="all">الكل</button>
          <button class="category" data-category="text">نصوص</button>
          <button class="category" data-category="web">ويب</button>
          <button class="category" data-category="image">صور</button>
          <button class="category" data-category="audio">صوت</button>
          <button class="category" data-category="video">فيديو</button>
          <button class="category" data-category="application">تطبيقات</button>
        </div>
      </div>

      <!-- Results -->
      <div class="results-header">
        <div>
          <span class="section-label">
            <i class="fa-solid fa-list"></i>
            النتائج
          </span>
          <span id="resultCount" class="result-count">0 نتيجة</span>
        </div>

        <button id="copyAllBtn" class="secondary-btn" type="button">
          <i class="fa-solid fa-copy"></i>
          نسخ النتائج
        </button>
      </div>

      <div id="results" class="results">
        <div class="empty-state">
          <div class="empty-icon">
            <i class="fa-solid fa-file-circle-question"></i>
          </div>

          <h3>ابدأ البحث</h3>
          <p>
            اكتب امتداد ملف أو MIME Type لعرض المعلومات.
          </p>
        </div>
      </div>

    </section>

    <!-- Features -->
    <section class="info-grid">

      <article class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>

        <h3>بحث بالامتداد</h3>
        <p>
          أدخل امتداد الملف مثل <code>.json</code> أو <code>png</code>
          للحصول على MIME Type المناسب.
        </p>
      </article>

      <article class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-code"></i>
        </div>

        <h3>بحث عكسي</h3>
        <p>
          يمكنك أيضًا إدخال MIME Type مثل
          <code>application/json</code> لمعرفة الامتدادات المرتبطة به.
        </p>
      </article>

      <article class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-copy"></i>
        </div>

        <h3>نسخ سريع</h3>
        <p>
          انسخ MIME Type أو معلومات النتائج إلى الحافظة بضغطة واحدة.
        </p>
      </article>

    </section>

    <!-- How to use -->
    <section class="content-card">
      <div class="content-heading">
        <span class="heading-icon">
          <i class="fa-solid fa-list-ol"></i>
        </span>

        <div>
          <h2>طريقة الاستخدام</h2>
          <p>ثلاث خطوات بسيطة للحصول على MIME Type.</p>
        </div>
      </div>

      <div class="steps">

        <div class="step">
          <span>01</span>
          <div>
            <h3>أدخل الامتداد</h3>
            <p>اكتب امتداد الملف مثل <code>json</code> أو <code>.pdf</code>.</p>
          </div>
        </div>

        <div class="step">
          <span>02</span>
          <div>
            <h3>ابدأ البحث</h3>
            <p>اضغط على زر البحث أو اختر أحد الامتدادات السريعة.</p>
          </div>
        </div>

        <div class="step">
          <span>03</span>
          <div>
            <h3>انسخ النتيجة</h3>
            <p>اضغط على زر النسخ بجانب MIME Type المطلوب.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Tip -->
    <section class="tip-card">
      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>
        <strong>نصيحة للمطورين</strong>
        <p>
          MIME Type يستخدم في HTTP Headers لتحديد نوع المحتوى الذي يتم
          إرساله أو استقباله، مثل <code>application/json</code> و
          <code>text/html</code> و <code>image/png</code>.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-card">
      <div class="content-heading">
        <span class="heading-icon">
          <i class="fa-solid fa-circle-question"></i>
        </span>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>معلومات سريعة حول MIME Types.</p>
        </div>
      </div>

      <div class="faq-list">

        <details>
          <summary>
            ما هو MIME Type؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            MIME Type هو قيمة تستخدم لتحديد نوع محتوى الملف، مثل
            <code>text/html</code> لملفات HTML و
            <code>image/png</code> لصور PNG.
          </p>
        </details>

        <details>
          <summary>
            ما الفرق بين امتداد الملف و MIME Type؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            امتداد الملف هو الجزء الموجود عادةً في نهاية اسم الملف،
            بينما MIME Type هو تعريف معياري لنوع المحتوى يستخدمه
            المتصفح والخادم والبرامج المختلفة.
          </p>
        </details>

        <details>
          <summary>
            هل يتم رفع ملفاتي إلى الخادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            لا. هذه الأداة تعمل بالكامل داخل المتصفح ولا تحتاج إلى
            رفع ملفاتك إلى خادم خارجي.
          </p>
        </details>

      </div>
    </section>

  </main>

  <Footer />

  <script>
    function init() {
      const mimeInput = document.getElementById('mimeInput');
      const searchBtn = document.getElementById('searchBtn');
      const clearBtn = document.getElementById('clearBtn');
      const results = document.getElementById('results');
      const resultCount = document.getElementById('resultCount');
      const copyAllBtn = document.getElementById('copyAllBtn');

      if (!mimeInput || !searchBtn || !results) return;

      const mimeData = [
        { ext: '.html', mime: 'text/html', name: 'HTML', category: 'web' },
        { ext: '.htm', mime: 'text/html', name: 'HTML', category: 'web' },

        { ext: '.css', mime: 'text/css', name: 'CSS', category: 'web' },

        { ext: '.js', mime: 'text/javascript', name: 'JavaScript', category: 'web' },
        { ext: '.mjs', mime: 'text/javascript', name: 'JavaScript Module', category: 'web' },

        { ext: '.json', mime: 'application/json', name: 'JSON', category: 'application' },
        { ext: '.xml', mime: 'application/xml', name: 'XML', category: 'text' },
        { ext: '.csv', mime: 'text/csv', name: 'CSV', category: 'text' },
        { ext: '.txt', mime: 'text/plain', name: 'Plain Text', category: 'text' },
        { ext: '.md', mime: 'text/markdown', name: 'Markdown', category: 'text' },

        { ext: '.png', mime: 'image/png', name: 'PNG Image', category: 'image' },
        { ext: '.jpg', mime: 'image/jpeg', name: 'JPEG Image', category: 'image' },
        { ext: '.jpeg', mime: 'image/jpeg', name: 'JPEG Image', category: 'image' },
        { ext: '.gif', mime: 'image/gif', name: 'GIF Image', category: 'image' },
        { ext: '.webp', mime: 'image/webp', name: 'WebP Image', category: 'image' },
        { ext: '.svg', mime: 'image/svg+xml', name: 'SVG Image', category: 'image' },
        { ext: '.ico', mime: 'image/x-icon', name: 'ICO Image', category: 'image' },
        { ext: '.bmp', mime: 'image/bmp', name: 'Bitmap Image', category: 'image' },
        { ext: '.avif', mime: 'image/avif', name: 'AVIF Image', category: 'image' },

        { ext: '.mp3', mime: 'audio/mpeg', name: 'MP3 Audio', category: 'audio' },
        { ext: '.wav', mime: 'audio/wav', name: 'WAV Audio', category: 'audio' },
        { ext: '.ogg', mime: 'audio/ogg', name: 'OGG Audio', category: 'audio' },
        { ext: '.oga', mime: 'audio/ogg', name: 'OGA Audio', category: 'audio' },
        { ext: '.flac', mime: 'audio/flac', name: 'FLAC Audio', category: 'audio' },
        { ext: '.aac', mime: 'audio/aac', name: 'AAC Audio', category: 'audio' },
        { ext: '.m4a', mime: 'audio/mp4', name: 'M4A Audio', category: 'audio' },

        { ext: '.mp4', mime: 'video/mp4', name: 'MP4 Video', category: 'video' },
        { ext: '.webm', mime: 'video/webm', name: 'WebM Video', category: 'video' },
        { ext: '.avi', mime: 'video/x-msvideo', name: 'AVI Video', category: 'video' },
        { ext: '.mov', mime: 'video/quicktime', name: 'QuickTime Video', category: 'video' },
        { ext: '.mpeg', mime: 'video/mpeg', name: 'MPEG Video', category: 'video' },
        { ext: '.mpg', mime: 'video/mpeg', name: 'MPEG Video', category: 'video' },

        { ext: '.pdf', mime: 'application/pdf', name: 'PDF Document', category: 'application' },
        { ext: '.zip', mime: 'application/zip', name: 'ZIP Archive', category: 'application' },
        { ext: '.rar', mime: 'application/vnd.rar', name: 'RAR Archive', category: 'application' },
        { ext: '.7z', mime: 'application/x-7z-compressed', name: '7-Zip Archive', category: 'application' },
        { ext: '.gz', mime: 'application/gzip', name: 'GZIP Archive', category: 'application' },
        { ext: '.tar', mime: 'application/x-tar', name: 'TAR Archive', category: 'application' },

        { ext: '.doc', mime: 'application/msword', name: 'Microsoft Word', category: 'application' },
        { ext: '.docx', mime: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', name: 'Word Document', category: 'application' },
        { ext: '.xls', mime: 'application/vnd.ms-excel', name: 'Microsoft Excel', category: 'application' },
        { ext: '.xlsx', mime: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', name: 'Excel Spreadsheet', category: 'application' },
        { ext: '.ppt', mime: 'application/vnd.ms-powerpoint', name: 'Microsoft PowerPoint', category: 'application' },
        { ext: '.pptx', mime: 'application/vnd.openxmlformats-officedocument.presentationml.presentation', name: 'PowerPoint Presentation', category: 'application' },

        { ext: '.wasm', mime: 'application/wasm', name: 'WebAssembly', category: 'application' },
        { ext: '.sql', mime: 'application/sql', name: 'SQL', category: 'application' },
        { ext: '.yaml', mime: 'application/yaml', name: 'YAML', category: 'application' },
        { ext: '.yml', mime: 'application/yaml', name: 'YAML', category: 'application' },
        { ext: '.bin', mime: 'application/octet-stream', name: 'Binary File', category: 'application' },
        { ext: '.exe', mime: 'application/vnd.microsoft.portable-executable', name: 'Windows Executable', category: 'application' },
        { ext: '.apk', mime: 'application/vnd.android.package-archive', name: 'Android Package', category: 'application' },
        { ext: '.epub', mime: 'application/epub+zip', name: 'EPUB Book', category: 'application' }
      ];

      let activeCategory = 'all';
      let currentResults = [];

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function normalize(value) {
        return String(value || '')
          .trim()
          .toLowerCase();
      }

      function categoryLabel(category) {
        const labels = {
          text: 'نصوص',
          web: 'ويب',
          image: 'صور',
          audio: 'صوت',
          video: 'فيديو',
          application: 'تطبيقات'
        };

        return labels[category] || category;
      }

      function search(value) {
        const query = normalize(value);

        let filtered = mimeData.filter(item => {
          const categoryMatch =
            activeCategory === 'all' ||
            item.category === activeCategory;

          if (!categoryMatch) return false;

          if (!query) return true;

          const q = query.replace(/^\./, '');

          return (
            item.ext.toLowerCase() === `.${q}` ||
            item.ext.toLowerCase().includes(q) ||
            item.mime.toLowerCase().includes(query) ||
            item.name.toLowerCase().includes(query)
          );
        });

        currentResults = filtered;
        renderResults(filtered, query);
      }

      function renderResults(items, query = '') {
        resultCount.textContent = `${items.length} نتيجة`;

        if (!items.length) {
          results.innerHTML = `
            <div class="empty-state">
              <div class="empty-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
              </div>

              <h3>لم يتم العثور على نتائج</h3>

              <p>
                جرّب امتدادًا آخر مثل
                <code>.json</code>
                أو
                <code>application/json</code>.
              </p>
            </div>
          `;

          return;
        }

        results.innerHTML = items.map((item, index) => `
          <article class="mime-result">
            <div class="result-number">
              ${String(index + 1).padStart(2, '0')}
            </div>

            <div class="result-main">

              <div class="result-name">
                <i class="fa-solid fa-file-code"></i>
                ${escapeHtml(item.name)}
              </div>

              <div class="result-values">

                <div class="value-box">
                  <span>الامتداد</span>
                  <code dir="ltr">${escapeHtml(item.ext)}</code>
                </div>

                <div class="value-box mime-value">
                  <span>MIME Type</span>
                  <code dir="ltr">${escapeHtml(item.mime)}</code>
                </div>

                <div class="value-box">
                  <span>التصنيف</span>
                  <strong>${escapeHtml(categoryLabel(item.category))}</strong>
                </div>

              </div>
            </div>

            <button
              class="copy-btn"
              type="button"
              data-copy="${escapeHtml(item.mime)}"
              title="نسخ MIME Type"
            >
              <i class="fa-solid fa-copy"></i>
              نسخ
            </button>
          </article>
        `).join('');

        results.querySelectorAll('.copy-btn').forEach(button => {
          button.addEventListener('click', async () => {
            const value = button.dataset.copy || '';

            try {
              await navigator.clipboard.writeText(value);

              const original = button.innerHTML;

              button.innerHTML = `
                <i class="fa-solid fa-check"></i>
                تم النسخ
              `;

              button.classList.add('copied');

              setTimeout(() => {
                button.innerHTML = original;
                button.classList.remove('copied');
              }, 1300);
            } catch {
              fallbackCopy(value);
            }
          });
        });
      }

      function fallbackCopy(value) {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';

        document.body.appendChild(textarea);
        textarea.select();

        try {
          document.execCommand('copy');
        } catch {}

        textarea.remove();
      }

      function copyAll() {
        if (!currentResults.length) return;

        const text = currentResults
          .map(item => `${item.ext}\t${item.mime}`)
          .join('\n');

        navigator.clipboard?.writeText(text).catch(() => fallbackCopy(text));

        const original = copyAllBtn.innerHTML;

        copyAllBtn.innerHTML = `
          <i class="fa-solid fa-check"></i>
          تم النسخ
        `;

        setTimeout(() => {
          copyAllBtn.innerHTML = original;
        }, 1300);
      }

      searchBtn.addEventListener('click', () => {
        search(mimeInput.value);
      });

      mimeInput.addEventListener('input', () => {
        search(mimeInput.value);
      });

      mimeInput.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          search(mimeInput.value);
        }
      });

      clearBtn.addEventListener('click', () => {
        mimeInput.value = '';
        search('');
        mimeInput.focus();
      });

      document.querySelectorAll('[data-query]').forEach(button => {
        button.addEventListener('click', () => {
          const value = button.dataset.query || '';

          mimeInput.value = value;
          activeCategory = 'all';

          document.querySelectorAll('.category').forEach(item => {
            item.classList.toggle(
              'active',
              item.dataset.category === 'all'
            );
          });

          search(value);
        });
      });

      document.querySelectorAll('.category').forEach(button => {
        button.addEventListener('click', () => {
          activeCategory = button.dataset.category || 'all';

          document.querySelectorAll('.category').forEach(item => {
            item.classList.toggle(
              'active',
              item === button
            );
          });

          search(mimeInput.value);
        });
      });

      copyAllBtn.addEventListener('click', copyAll);

      // Theme — نفس بنية Unicode Converter
      function getThemeState() {
        const html = document.documentElement;
        const stored = localStorage.getItem('theme');

        if (stored === 'light') return 'light';
        if (stored === 'dark') return 'dark';

        if (html.dataset.theme === 'light') return 'light';
        if (html.dataset.theme === 'dark') return 'dark';

        if (html.classList.contains('light')) return 'light';
        if (html.classList.contains('dark')) return 'dark';

        return 'dark';
      }

      function syncTheme() {
        const theme = getThemeState();
        const light = theme === 'light';

        document.body.classList.toggle('mime-light', light);
        document.body.classList.toggle('mime-dark', !light);
      }

      syncTheme();

      window.addEventListener('storage', event => {
        if (event.key === 'theme') syncTheme();
      });

      const themeObserver = new MutationObserver(() => {
        syncTheme();
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme']
      });

      // عرض جميع النتائج عند البداية
      search('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>

