---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = base + '/tools/markdown-formatter/';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Markdown Formatter | تنسيق Markdown أونلاين</title>
  <meta
    name="description"
    content="أداة احترافية لتنسيق Markdown وتنظيف المسافات والأسطر والعناوين والقوائم وكتل الأكواد بسهولة."
  />
  <meta
    name="keywords"
    content="Markdown Formatter, Markdown, تنسيق Markdown, Markdown Beautifier, Markdown Format"
  />
  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">

        <div class="breadcrumb">
          <a href={base + '/'}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={base + '/tools/'}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>Markdown Formatter</span>
        </div>

        <div class="hero-icon">
          <i class="fa-brands fa-markdown"></i>
        </div>

        <h1>Markdown Formatter</h1>

        <p>
          نسّق ونظّف كود Markdown تلقائياً، ونظّم العناوين والقوائم
          وكتل الأكواد والمسافات بطريقة احترافية.
        </p>

        <div class="tags">
          <span><i class="fa-brands fa-markdown"></i> Markdown</span>
          <span><i class="fa-solid fa-wand-magic-sparkles"></i> Formatter</span>
          <span><i class="fa-solid fa-broom"></i> Clean</span>
          <span><i class="fa-solid fa-shield-halved"></i> Local</span>
        </div>

      </div>
    </section>

    <!-- TOOL -->
    <section class="tool-section">
      <div class="tool-container">

        <div class="tool-card">

          <div class="toolbar">
            <div class="toolbar-title">
              <div class="toolbar-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>

              <div>
                <strong>Markdown Formatter</strong>
                <small>تنسيق تلقائي للكود</small>
              </div>
            </div>

            <div class="toolbar-actions">
              <button id="sampleBtn" class="btn secondary">
                <i class="fa-solid fa-flask"></i>
                مثال
              </button>

              <button id="formatBtn" class="btn primary">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                تنسيق Markdown
              </button>
            </div>
          </div>

          <div class="options">

            <label class="check-option">
              <input type="checkbox" id="trimLines" checked />
              <span class="check-box"></span>
              إزالة المسافات الزائدة
            </label>

            <label class="check-option">
              <input type="checkbox" id="normalizeHeadings" checked />
              <span class="check-box"></span>
              تنظيم العناوين
            </label>

            <label class="check-option">
              <input type="checkbox" id="normalizeLists" checked />
              <span class="check-box"></span>
              تنظيم القوائم
            </label>

            <label class="check-option">
              <input type="checkbox" id="normalizeBlankLines" checked />
              <span class="check-box"></span>
              تنظيم الأسطر الفارغة
            </label>

          </div>

          <div class="editor-grid">

            <!-- INPUT -->
            <div class="editor-panel">

              <div class="panel-head">
                <div>
                  <i class="fa-solid fa-pen-to-square"></i>
                  Markdown Input
                </div>

                <span id="inputStatus">جاهز</span>
              </div>

              <textarea
                id="input"
                spellcheck="false"
                placeholder="# اكتب Markdown هنا...

## عنوان فرعي

- عنصر أول
- عنصر ثاني

**نص مهم**

```js
console.log('Hello');
```"
              ></textarea>

              <div class="panel-footer">
                <span id="inputStats">0 حرف · 0 سطر</span>

                <button id="clearBtn" class="mini-btn danger">
                  <i class="fa-solid fa-trash"></i>
                  مسح
                </button>
              </div>

            </div>

            <!-- OUTPUT -->
            <div class="editor-panel output-panel">

              <div class="panel-head">
                <div>
                  <i class="fa-solid fa-code"></i>
                  Formatted Markdown
                </div>

                <span id="outputStatus">لا توجد نتيجة</span>
              </div>

              <textarea
                id="output"
                spellcheck="false"
                readonly
                placeholder="ستظهر النسخة المنسقة هنا..."
              ></textarea>

              <div class="panel-footer">
                <span id="outputStats">0 حرف · 0 سطر</span>

                <button id="copyBtn" class="mini-btn">
                  <i class="fa-regular fa-copy"></i>
                  نسخ
                </button>
              </div>

            </div>

          </div>

          <div class="main-actions">

            <button id="formatBtnBottom" class="action primary-action">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              تنسيق Markdown
            </button>

            <button id="copyBtnBottom" class="action">
              <i class="fa-regular fa-copy"></i>
              نسخ النتيجة
            </button>

            <button id="clearBtnBottom" class="action">
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

          </div>

          <div id="message" class="message">
            <i class="fa-solid fa-circle-info"></i>
            أدخل Markdown ثم اضغط على «تنسيق Markdown».
          </div>

        </div>

        <!-- STATS -->
        <div class="stats-grid">

          <div class="stat-card">
            <div class="stat-icon blue">
              <i class="fa-solid fa-font"></i>
            </div>
            <div>
              <strong id="statChars">0</strong>
              <span>الأحرف</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon purple">
              <i class="fa-solid fa-align-left"></i>
            </div>
            <div>
              <strong id="statLines">0</strong>
              <span>الأسطر</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon green">
              <i class="fa-solid fa-heading"></i>
            </div>
            <div>
              <strong id="statHeadings">0</strong>
              <span>العناوين</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon orange">
              <i class="fa-solid fa-list"></i>
            </div>
            <div>
              <strong id="statLists">0</strong>
              <span>عناصر القوائم</span>
            </div>
          </div>

        </div>

        <!-- PRIVACY -->
        <div class="privacy-card">

          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>خصوصيتك أولاً</h3>
            <p>
              تتم عملية التنسيق بالكامل داخل متصفحك.
              لا يتم إرسال محتوى Markdown إلى أي خادم.
            </p>
          </div>

          <div class="privacy-badge">
            <i class="fa-solid fa-check"></i>
            معالجة محلية
          </div>

        </div>

        <!-- FEATURES -->
        <section class="info-section">

          <div class="section-title">
            <span>لماذا تستخدم الأداة؟</span>
            <h2>تنسيق Markdown بطريقة أسهل</h2>
            <p>
              نظّم ملفات Markdown بسرعة وحافظ على بنية واضحة وسهلة القراءة.
            </p>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-broom"></i>
              </div>

              <h3>تنظيف تلقائي</h3>

              <p>
                إزالة المسافات غير الضرورية وتنظيف الأسطر للحصول على ملف أكثر
                ترتيباً.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-heading"></i>
              </div>

              <h3>تنظيم العناوين</h3>

              <p>
                توحيد صيغة عناوين Markdown والمحافظة على بنيتها بشكل واضح.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-list-check"></i>
              </div>

              <h3>تنسيق القوائم</h3>

              <p>
                توحيد علامات القوائم والمسافات البادئة لتحسين قابلية القراءة.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>الحفاظ على الكود</h3>

              <p>
                حماية كتل الأكواد والأسطر البرمجية أثناء عملية التنسيق.
              </p>
            </article>

          </div>

        </section>

        <!-- HOW TO -->
        <section class="how-section">

          <div class="section-title">
            <span>طريقة الاستخدام</span>
            <h2>كيف تستخدم Markdown Formatter؟</h2>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>
              <div>
                <h3>أدخل Markdown</h3>
                <p>الصق أو اكتب محتوى Markdown داخل المحرر.</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>
              <div>
                <h3>اختر الخيارات</h3>
                <p>حدد عناصر التنسيق التي تريد تطبيقها.</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>
              <div>
                <h3>نسخ النتيجة</h3>
                <p>اضغط على تنسيق ثم انسخ Markdown المنظم.</p>
              </div>
            </div>

          </div>

        </section>

        <!-- FAQ -->
        <section class="faq-section">

          <div class="section-title">
            <span>الأسئلة الشائعة</span>
            <h2>Markdown Formatter FAQ</h2>
          </div>

          <div class="faq-list">

            <details>
              <summary>
                ما هي Markdown؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                Markdown هي لغة ترميز خفيفة تستخدم لتنسيق النصوص بطريقة بسيطة
                وسهلة القراءة، وتستخدم على نطاق واسع في GitHub والوثائق التقنية.
              </p>
            </details>

            <details>
              <summary>
                ماذا تقوم الأداة بتنسيقه؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                تقوم الأداة بتنظيف المسافات والأسطر وتنظيم العناوين والقوائم
                والحفاظ على كتل الأكواد أثناء إعادة تنسيق المحتوى.
              </p>
            </details>

            <details>
              <summary>
                هل يتم إرسال المحتوى إلى الخادم؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم عملية التنسيق محلياً داخل المتصفح، لذلك لا تحتاج إلى
                رفع ملف Markdown إلى أي خادم.
              </p>
            </details>

            <details>
              <summary>
                هل يمكن استخدام الأداة مع ملفات GitHub؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يمكنك نسخ محتوى README أو أي ملف Markdown ولصقه داخل
                الأداة ثم نسخ النسخة المنسقة.
              </p>
            </details>

          </div>

        </section>

      </div>
    </section>
  </main>

  <Footer />

  <style>
    :root {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --border: #e3ebf5;
      --text: #122033;
      --muted: #68788c;
      --primary: #1677ff;
      --primary-dark: #075dcc;
      --primary-soft: #eaf3ff;
      --success: #12a66a;
      --danger: #e05252;
      --shadow: 0 18px 50px rgba(24, 71, 120, 0.08);
      --radius: 20px;
    }

    html.dark-mode {
      --bg: #07111f;
      --surface: #0d1a2b;
      --surface-2: #101f32;
      --border: #20334a;
      --text: #eaf3ff;
      --muted: #94a7bc;
      --primary: #45a0ff;
      --primary-dark: #1684ee;
      --primary-soft: #102d4c;
      --shadow: 0 20px 55px rgba(0, 0, 0, 0.28);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
    }

    button,
    textarea,
    input {
      font-family: inherit;
    }

    .hero {
      padding: 42px 20px 70px;
      background:
        radial-gradient(circle at 15% 20%, rgba(22, 119, 255, 0.12), transparent 32%),
        radial-gradient(circle at 85% 30%, rgba(55, 185, 255, 0.1), transparent 30%);
    }

    .hero-inner {
      max-width: 1120px;
      margin: auto;
      text-align: center;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: 13px;
    }

    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
    }

    .breadcrumb i {
      font-size: 9px;
    }

    .hero-icon {
      width: 82px;
      height: 82px;
      margin: 0 auto 20px;
      display: grid;
      place-items: center;
      border-radius: 24px;
      background: linear-gradient(135deg, #1677ff, #4ebdff);
      color: white;
      font-size: 38px;
      box-shadow: 0 15px 35px rgba(22, 119, 255, 0.25);
    }

    .hero h1 {
      margin: 0 0 14px;
      font-size: clamp(30px, 5vw, 48px);
      font-weight: 800;
      letter-spacing: -1px;
    }

    .hero p {
      max-width: 720px;
      margin: auto;
      color: var(--muted);
      line-height: 1.9;
      font-size: 16px;
    }

    .tags {
      margin-top: 22px;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 9px;
    }

    .tags span {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 13px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 30px;
      color: var(--muted);
      font-size: 12px;
    }

    .tags i {
      color: var(--primary);
    }

    .tool-section {
      padding: 0 20px 80px;
      margin-top: -20px;
    }

    .tool-container {
      max-width: 1120px;
      margin: auto;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 22px;
      box-shadow: var(--shadow);
    }

    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .toolbar-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .toolbar-title strong {
      display: block;
      font-size: 15px;
    }

    .toolbar-title small {
      color: var(--muted);
      font-size: 11px;
    }

    .toolbar-actions {
      display: flex;
      gap: 9px;
    }

    .btn,
    .action,
    .mini-btn {
      border: 0;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .btn {
      padding: 11px 16px;
      border-radius: 11px;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn.primary,
    .primary-action {
      background: var(--primary);
      color: white;
    }

    .btn.primary:hover,
    .primary-action:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn.secondary {
      background: var(--primary-soft);
      color: var(--primary);
    }

    .btn.secondary:hover {
      transform: translateY(-1px);
    }

    .options {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 0;
    }

    .check-option {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      font-size: 12px;
      cursor: pointer;
    }

    .check-option input {
      position: absolute;
      opacity: 0;
    }

    .check-box {
      width: 17px;
      height: 17px;
      border: 2px solid var(--border);
      border-radius: 5px;
      position: relative;
    }

    .check-option input:checked + .check-box {
      background: var(--primary);
      border-color: var(--primary);
    }

    .check-option input:checked + .check-box::after {
      content: "✓";
      position: absolute;
      color: white;
      font-size: 11px;
      left: 2px;
      top: -2px;
    }

    .editor-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .editor-panel {
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      background: var(--surface-2);
    }

    .panel-head,
    .panel-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 11px 14px;
    }

    .panel-head {
      border-bottom: 1px solid var(--border);
      font-size: 12px;
      color: var(--muted);
    }

    .panel-head > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel-head i {
      color: var(--primary);
    }

    .panel-head span {
      padding: 4px 8px;
      border-radius: 20px;
      background: var(--primary-soft);
      color: var(--primary);
      font-size: 10px;
    }

    textarea {
      display: block;
      width: 100%;
      min-height: 370px;
      padding: 18px;
      border: 0;
      outline: 0;
      resize: vertical;
      background: transparent;
      color: var(--text);
      font-family: "JetBrains Mono", monospace;
      font-size: 13px;
      line-height: 1.8;
      direction: ltr;
      text-align: left;
    }

    textarea::placeholder {
      color: var(--muted);
      opacity: 0.75;
    }

    .panel-footer {
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 10px;
    }

    .mini-btn {
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--surface);
      color: var(--muted);
      border: 1px solid var(--border);
      font-size: 10px;
    }

    .mini-btn:hover {
      color: var(--primary);
      border-color: var(--primary);
    }

    .mini-btn.danger:hover {
      color: var(--danger);
      border-color: var(--danger);
    }

    .main-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      padding-top: 18px;
    }

    .action {
      padding: 11px 18px;
      border-radius: 11px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .action:hover {
      transform: translateY(-1px);
    }

    .message {
      margin-top: 15px;
      padding: 12px 15px;
      border-radius: 11px;
      background: var(--primary-soft);
      color: var(--primary);
      text-align: center;
      font-size: 12px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-top: 18px;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 17px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
    }

    .stat-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .stat-icon.purple {
      color: #8855d9;
      background: rgba(136, 85, 217, 0.1);
    }

    .stat-icon.green {
      color: #10a76a;
      background: rgba(16, 167, 106, 0.1);
    }

    .stat-icon.orange {
      color: #e08b28;
      background: rgba(224, 139, 40, 0.1);
    }

    .stat-card strong {
      display: block;
      font-size: 18px;
    }

    .stat-card span {
      display: block;
      color: var(--muted);
      font-size: 10px;
    }

    .privacy-card {
      margin-top: 18px;
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 17px;
    }

    .privacy-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: rgba(18, 166, 106, 0.1);
      color: var(--success);
    }

    .privacy-card h3 {
      margin: 0 0 3px;
      font-size: 13px;
    }

    .privacy-card p {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    .privacy-badge {
      margin-right: auto;
      white-space: nowrap;
      color: var(--success);
      font-size: 11px;
    }

    .privacy-badge i {
      margin-left: 4px;
    }

    .info-section,
    .how-section,
    .faq-section {
      margin-top: 80px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 28px;
    }

    .section-title > span {
      color: var(--primary);
      font-size: 12px;
      font-weight: 700;
    }

    .section-title h2 {
      margin: 7px 0;
      font-size: 27px;
    }

    .section-title p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .info-card {
      padding: 23px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 17px;
      transition: 0.25s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
    }

    .info-icon {
      width: 45px;
      height: 45px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--primary-soft);
      color: var(--primary);
      margin-bottom: 17px;
    }

    .info-card h3 {
      margin: 0 0 8px;
      font-size: 14px;
    }

    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .step {
      display: flex;
      gap: 13px;
      padding: 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 17px;
    }

    .step-number {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--primary);
      color: white;
      font-weight: 800;
      font-size: 13px;
    }

    .step h3 {
      margin: 0 0 5px;
      font-size: 13px;
    }

    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    .faq-list {
      max-width: 850px;
      margin: auto;
    }

    details {
      margin-bottom: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 13px;
      overflow: hidden;
    }

    summary {
      padding: 16px 18px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 700;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);
      transition: 0.2s;
    }

    details[open] summary i {
      transform: rotate(180deg);
    }

    details p {
      margin: 0;
      padding: 0 18px 17px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    @media (max-width: 850px) {
      .editor-grid,
      .info-grid {
        grid-template-columns: 1fr 1fr;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .steps {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .hero {
        padding-top: 28px;
      }

      .tool-section {
        padding-left: 12px;
        padding-right: 12px;
      }

      .tool-card {
        padding: 14px;
        border-radius: 18px;
      }

      .toolbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .toolbar-actions {
        width: 100%;
      }

      .toolbar-actions .btn {
        flex: 1;
        justify-content: center;
      }

      .editor-grid,
      .info-grid {
        grid-template-columns: 1fr;
      }

      textarea {
        min-height: 280px;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .privacy-card {
        align-items: flex-start;
      }

      .privacy-badge {
        display: none;
      }

      .section-title h2 {
        font-size: 23px;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const input = document.getElementById("input");
      const output = document.getElementById("output");

      const formatBtn = document.getElementById("formatBtn");
      const formatBtnBottom = document.getElementById("formatBtnBottom");

      const sampleBtn = document.getElementById("sampleBtn");

      const copyBtn = document.getElementById("copyBtn");
      const copyBtnBottom = document.getElementById("copyBtnBottom");

      const clearBtn = document.getElementById("clearBtn");
      const clearBtnBottom = document.getElementById("clearBtnBottom");

      const message = document.getElementById("message");

      const inputStats = document.getElementById("inputStats");
      const outputStats = document.getElementById("outputStats");

      const statChars = document.getElementById("statChars");
      const statLines = document.getElementById("statLines");
      const statHeadings = document.getElementById("statHeadings");
      const statLists = document.getElementById("statLists");

      const trimLines = document.getElementById("trimLines");
      const normalizeHeadings = document.getElementById("normalizeHeadings");
      const normalizeLists = document.getElementById("normalizeLists");
      const normalizeBlankLines = document.getElementById("normalizeBlankLines");

      function countLines(text) {
        if (!text) return 0;
        return text.split(/\r?\n/).length;
      }

      function updateStats() {
        const text = input.value || "";

        const chars = text.length;
        const lines = countLines(text);

        const headings = text
          .split(/\r?\n/)
          .filter(function(line) {
            return /^ {0,3}#{1,6}\s+/.test(line);
          }).length;

        const lists = text
          .split(/\r?\n/)
          .filter(function(line) {
            return /^ {0,3}(?:[-*+]|\d+\.)\s+/.test(line);
          }).length;

        inputStats.textContent = chars + " حرف · " + lines + " سطر";

        statChars.textContent = chars;
        statLines.textContent = lines;
        statHeadings.textContent = headings;
        statLists.textContent = lists;
      }

      function updateOutputStats() {
        const text = output.value || "";

        outputStats.textContent =
          text.length + " حرف · " + countLines(text) + " سطر";
      }

      function formatMarkdown(text) {
        if (!text.trim()) return "";

        let lines = text.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");

        const result = [];
        let insideFence = false;
        let fenceMarker = "";

        for (let i = 0; i < lines.length; i++) {
          let line = lines[i];

          const fenceMatch = line.match(/^\s*(```+|~~~+)(.*)$/);

          if (fenceMatch) {
            if (!insideFence) {
              insideFence = true;
              fenceMarker = fenceMatch[1];

              const language = fenceMatch[2].trim();

              if (language) {
                result.push(fenceMarker + language);
              } else {
                result.push(fenceMarker);
              }
            } else {
              insideFence = false;
              result.push(fenceMarker);
              fenceMarker = "";
            }

            continue;
          }

          if (insideFence) {
            result.push(line.replace(/\s+$/g, ""));
            continue;
          }

          if (trimLines.checked) {
            line = line.replace(/[ \t]+$/g, "");
            line = line.replace(/^[ \t]+/g, function(spaces) {
              if (spaces.length <= 3) return spaces;
              return "   ";
            });
          }

          if (normalizeHeadings.checked) {
            const heading = line.match(/^\s*(#{1,6})\s*(.*?)\s*$/);

            if (heading) {
              const title = heading[2].trim();

              if (title) {
                line = heading[1] + " " + title;
              } else {
                line = heading[1];
              }
            }

            line = line.replace(/^(#{1,6})([^ #])/g, "$1 $2");
          }

          if (normalizeLists.checked) {
            line = line.replace(
              /^\s*[\*\+]\s+/,
              "- "
            );

            line = line.replace(
              /^(\s*)-\s{2,}/,
              "$1- "
            );

            line = line.replace(
              /^(\s*)(\d+)[\)]\s+/,
              "$1$2. "
            );

            line = line.replace(
              /^(\s*)(\d+)\.\s{2,}/,
              "$1$2. "
            );
          }

          result.push(line);
        }

        let formatted = result.join("\n");

        if (normalizeBlankLines.checked) {
          formatted = formatted.replace(/\n{3,}/g, "\n\n");
        }

        formatted = formatted
          .replace(/[ \t]+\n/g, "\n")
          .replace(/\n[ \t]+$/g, "\n")
          .trim();

        return formatted;
      }

      function showMessage(text, type) {
        message.textContent = text;

        if (type === "success") {
          message.style.background = "rgba(18,166,106,0.1)";
          message.style.color = "var(--success)";
        } else if (type === "error") {
          message.style.background = "rgba(224,82,82,0.1)";
          message.style.color = "var(--danger)";
        } else {
          message.style.background = "var(--primary-soft)";
          message.style.color = "var(--primary)";
        }
      }

      function format() {
        const source = input.value;

        if (!source.trim()) {
          output.value = "";
          updateOutputStats();

          showMessage(
            "أدخل محتوى Markdown أولاً ثم اضغط على تنسيق Markdown.",
            "error"
          );

          return;
        }

        const formatted = formatMarkdown(source);

        output.value = formatted;
        updateOutputStats();

        document.getElementById("inputStatus").textContent = "تمت المعالجة";
        document.getElementById("outputStatus").textContent = "منسق";

        showMessage(
          "تم تنسيق Markdown وتنظيفه بنجاح.",
          "success"
        );
      }

      async function copyOutput() {
        if (!output.value) {
          showMessage("لا توجد نتيجة لنسخها.", "error");
          return;
        }

        try {
          await navigator.clipboard.writeText(output.value);

          showMessage(
            "تم نسخ Markdown المنسق إلى الحافظة.",
            "success"
          );
        } catch {
          output.select();
          document.execCommand("copy");

          showMessage(
            "تم نسخ النتيجة.",
            "success"
          );
        }
      }

      function loadSample() {
        input.value =
`# مشروع Markdown

## المقدمة

هذا مثال على **ملف Markdown** يحتاج إلى بعض التنسيق.

### المميزات

* تنسيق العناوين
* تنظيف المسافات
* تنظيم القوائم

### مثال برمجي

\`\`\`javascript
function hello() {
  console.log("Hello Markdown");
}
\`\`\`

## الخاتمة

يمكنك استخدام هذه الأداة لتنظيف ملفات Markdown بسرعة.`;

        updateStats();
        output.value = "";
        updateOutputStats();

        document.getElementById("inputStatus").textContent = "مثال محمل";

        showMessage(
          "تم تحميل مثال Markdown. اضغط على تنسيق Markdown.",
          "info"
        );
      }

      function clearAll() {
        input.value = "";
        output.value = "";

        updateStats();
        updateOutputStats();

        document.getElementById("inputStatus").textContent = "جاهز";
        document.getElementById("outputStatus").textContent = "لا توجد نتيجة";

        showMessage(
          "تم مسح المحتوى.",
          "info"
        );
      }

      formatBtn.addEventListener("click", format);
      formatBtnBottom.addEventListener("click", format);

      sampleBtn.addEventListener("click", loadSample);

      copyBtn.addEventListener("click", copyOutput);
      copyBtnBottom.addEventListener("click", copyOutput);

      clearBtn.addEventListener("click", clearAll);
      clearBtnBottom.addEventListener("click", clearAll);

      input.addEventListener("input", updateStats);

      input.addEventListener("keydown", function(event) {
        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();
          format();
        }
      });

      updateStats();
      updateOutputStats();

      function syncTheme() {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      }

      syncTheme();

      window.addEventListener("themeChange", syncTheme);

      const themeButton = document.getElementById("theme-btn");

      if (themeButton) {
        themeButton.addEventListener("click", function() {
          setTimeout(syncTheme, 0);
        });
      }
    })();
  </script>
</body>
</html>
