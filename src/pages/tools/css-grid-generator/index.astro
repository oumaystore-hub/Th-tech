---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CSS Grid Generator - مولد CSS Grid أونلاين | Th.Tech";
const description =
  "مولد CSS Grid مجاني لإنشاء تخطيطات Grid بسهولة مع معاينة مباشرة ونسخ كود CSS جاهز.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>CSS Grid Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-table-cells-large"></i>
          </div>

          <div>
            <span class="kicker">
              <i class="fas fa-code"></i>
              CSS Tools
            </span>

            <h1>
              CSS Grid <span>Generator</span>
            </h1>

            <p>
              أنشئ تخطيطات CSS Grid بسهولة مع معاينة مباشرة
              واحصل على كود CSS جاهز للنسخ والاستخدام.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- TOOLBAR -->
          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-table-cells-large"></i>
              <span>CSS Grid Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="resetBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-rotate-left"></i>
                إعادة ضبط
              </button>

              <button
                id="copyBtn"
                class="tool-btn primary-small"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ CSS
              </button>

            </div>

          </div>


          <!-- CONTROLS -->
          <div class="generator">

            <aside class="controls">

              <div class="control-title">
                <i class="fas fa-sliders"></i>
                إعدادات Grid
              </div>


              <!-- COLUMNS -->
              <div class="control-group">

                <div class="control-label">
                  <span>الأعمدة</span>
                  <strong id="columnsValue">3</strong>
                </div>

                <input
                  id="columns"
                  type="range"
                  min="1"
                  max="8"
                  value="3"
                />

              </div>


              <!-- ROWS -->
              <div class="control-group">

                <div class="control-label">
                  <span>الصفوف</span>
                  <strong id="rowsValue">3</strong>
                </div>

                <input
                  id="rows"
                  type="range"
                  min="1"
                  max="8"
                  value="3"
                />

              </div>


              <!-- COLUMN GAP -->
              <div class="control-group">

                <div class="control-label">
                  <span>Column Gap</span>
                  <strong id="columnGapValue">12px</strong>
                </div>

                <input
                  id="columnGap"
                  type="range"
                  min="0"
                  max="50"
                  value="12"
                />

              </div>


              <!-- ROW GAP -->
              <div class="control-group">

                <div class="control-label">
                  <span>Row Gap</span>
                  <strong id="rowGapValue">12px</strong>
                </div>

                <input
                  id="rowGap"
                  type="range"
                  min="0"
                  max="50"
                  value="12"
                />

              </div>


              <!-- JUSTIFY -->
              <div class="control-group">

                <label for="justify">
                  محاذاة العناصر أفقياً
                </label>

                <select id="justify">

                  <option value="stretch">Stretch</option>
                  <option value="start">Start</option>
                  <option value="center">Center</option>
                  <option value="end">End</option>
                  <option value="space-between">Space Between</option>
                  <option value="space-around">Space Around</option>
                  <option value="space-evenly">Space Evenly</option>

                </select>

              </div>


              <!-- ALIGN -->
              <div class="control-group">

                <label for="align">
                  محاذاة العناصر عمودياً
                </label>

                <select id="align">

                  <option value="stretch">Stretch</option>
                  <option value="start">Start</option>
                  <option value="center">Center</option>
                  <option value="end">End</option>

                </select>

              </div>


              <!-- JUSTIFY CONTENT -->
              <div class="control-group">

                <label for="justifyContent">
                  توزيع الشبكة أفقياً
                </label>

                <select id="justifyContent">

                  <option value="stretch">Stretch</option>
                  <option value="start">Start</option>
                  <option value="center">Center</option>
                  <option value="end">End</option>
                  <option value="space-between">Space Between</option>
                  <option value="space-around">Space Around</option>
                  <option value="space-evenly">Space Evenly</option>

                </select>

              </div>


              <!-- ALIGN CONTENT -->
              <div class="control-group">

                <label for="alignContent">
                  توزيع الشبكة عمودياً
                </label>

                <select id="alignContent">

                  <option value="stretch">Stretch</option>
                  <option value="start">Start</option>
                  <option value="center">Center</option>
                  <option value="end">End</option>
                  <option value="space-between">Space Between</option>
                  <option value="space-around">Space Around</option>
                  <option value="space-evenly">Space Evenly</option>

                </select>

              </div>

            </aside>


            <!-- PREVIEW -->
            <div class="preview-area">

              <div class="preview-header">

                <div>
                  <i class="fas fa-eye"></i>
                  المعاينة المباشرة
                </div>

                <span id="gridInfo">
                  3 × 3
                </span>

              </div>

              <div class="preview-wrapper">

                <div id="gridPreview" class="grid-preview">

                  <div>1</div>
                  <div>2</div>
                  <div>3</div>
                  <div>4</div>
                  <div>5</div>
                  <div>6</div>
                  <div>7</div>
                  <div>8</div>
                  <div>9</div>

                </div>

              </div>

            </div>

          </div>


          <!-- CSS OUTPUT -->
          <div class="code-section">

            <div class="code-header">

              <div>
                <i class="fas fa-code"></i>
                CSS الناتج
              </div>

              <button
                id="copyCodeBtn"
                class="copy-code"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

            </div>

            <pre id="cssOutput"></pre>

          </div>


          <!-- STATUS -->
          <div id="status" class="status hidden">

            <i id="statusIcon" class="fas fa-check-circle"></i>

            <span id="statusText"></span>

          </div>

        </div>


        <!-- INFO -->
        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>معاينة مباشرة</h3>

              <p>
                شاهد تغييرات CSS Grid مباشرة أثناء تعديل الإعدادات.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>CSS جاهز</h3>

              <p>
                احصل على كود CSS مرتب وجاهز للنسخ والاستخدام.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>يعمل في المتصفح</h3>

              <p>
                لا يتم إرسال بياناتك إلى أي خادم خارجي.
              </p>
            </div>

          </div>

        </div>


        <!-- HOW TO -->
        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>CSS Grid Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-sliders"></i>
              </div>

              <h3>حدد الإعدادات</h3>

              <p>
                اختر عدد الأعمدة والصفوف والمسافات المناسبة.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-eye"></i>
              </div>

              <h3>عاين Grid</h3>

              <p>
                شاهد شكل الشبكة مباشرة أثناء تغيير الإعدادات.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>انسخ CSS</h3>

              <p>
                انسخ الكود الناتج وأضفه مباشرة إلى مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- FAQ -->
        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>CSS Grid</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو CSS Grid؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                CSS Grid هو نظام تخطيط في CSS يسمح بإنشاء
                شبكات مرنة تتكون من صفوف وأعمدة.
              </p>

            </details>


            <details>

              <summary>
                هل أحتاج إلى كتابة CSS يدوياً؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. يمكنك ضبط الإعدادات من خلال الأداة
                وسيتم إنشاء CSS تلقائياً.
              </p>

            </details>


            <details>

              <summary>
                هل يمكنني استخدام الكود في أي مشروع؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. الكود الناتج هو CSS قياسي ويمكن استخدامه
                في مواقع HTML وCSS ومشاريع JavaScript وأطر العمل المختلفة.
              </p>

            </details>


            <details>

              <summary>
                هل المعاينة تتحدث مباشرة؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يتم تحديث الشبكة والكود مباشرة عند تغيير أي إعداد.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- CSS -->
  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;

      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    select,
    input {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* HERO */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;

      margin-bottom: 28px;

      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;

      display: flex;
      align-items: center;

      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);

      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;

      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);

      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;

      margin: 0;

      color: var(--muted);

      font-size: .92rem;
    }


    /* TOOL */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);

      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;

      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      transform: translateY(-2px);
    }


    .tool-btn.primary-small {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }


    .tool-btn.secondary:hover {
      color: var(--primary);
      border-color: rgba(37, 99, 235, .35);
    }


    /* GENERATOR */

    .generator {
      display: grid;

      grid-template-columns: 290px 1fr;

      gap: 20px;

      padding: 20px;
    }


    .controls {
      padding: 20px;

      border-radius: 16px;

      background: var(--card2);

      border: 1px solid var(--border);
    }


    .control-title {
      display: flex;
      align-items: center;

      gap: 8px;

      margin-bottom: 24px;

      font-size: .9rem;
      font-weight: 800;
    }


    .control-title i {
      color: var(--primary);
    }


    .control-group {
      margin-bottom: 22px;
    }


    .control-group:last-child {
      margin-bottom: 0;
    }


    .control-label {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 9px;

      color: var(--muted);

      font-size: .73rem;
      font-weight: 700;
    }


    .control-label strong {
      color: var(--primary);
      direction: ltr;
    }


    .control-group > label {
      display: block;

      margin-bottom: 9px;

      color: var(--muted);

      font-size: .73rem;
      font-weight: 700;
    }


    input[type="range"] {
      width: 100%;

      height: 5px;

      appearance: none;

      border-radius: 10px;

      background: rgba(100, 116, 139, .18);

      outline: none;
    }


    input[type="range"]::-webkit-slider-thumb {
      appearance: none;

      width: 17px;
      height: 17px;

      border-radius: 50%;

      background: var(--primary);

      cursor: pointer;

      box-shadow:
        0 3px 10px rgba(37, 99, 235, .3);
    }


    input[type="range"]::-moz-range-thumb {
      width: 17px;
      height: 17px;

      border: 0;

      border-radius: 50%;

      background: var(--primary);

      cursor: pointer;
    }


    select {
      width: 100%;

      height: 40px;

      padding: 0 10px;

      border-radius: 9px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      outline: none;

      font-size: .73rem;

      cursor: pointer;
    }


    select:focus {
      border-color: var(--primary);
    }


    /* PREVIEW */

    .preview-area {
      min-width: 0;

      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 13px 16px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;
      font-weight: 700;
    }


    .preview-header > div {
      display: flex;
      align-items: center;

      gap: 7px;
    }


    .preview-header i {
      color: var(--primary);
    }


    #gridInfo {
      color: var(--primary);

      direction: ltr;
    }


    .preview-wrapper {
      min-height: 450px;

      display: flex;

      align-items: stretch;

      justify-content: stretch;

      padding: 25px;

      background:
        linear-gradient(
          45deg,
          rgba(100,116,139,.035) 25%,
          transparent 25%,
          transparent 75%,
          rgba(100,116,139,.035) 75%
        ),
        linear-gradient(
          45deg,
          rgba(100,116,139,.035) 25%,
          transparent 25%,
          transparent 75%,
          rgba(100,116,139,.035) 75%
        );

      background-size: 20px 20px;

      background-position:
        0 0,
        10px 10px;
    }


    .grid-preview {
      width: 100%;

      min-height: 400px;

      display: grid;

      padding: 12px;

      border-radius: 12px;

      background: rgba(37, 99, 235, .06);

      border: 1px dashed rgba(37, 99, 235, .35);
    }


    .grid-preview > div {
      display: flex;

      align-items: center;
      justify-content: center;

      min-height: 45px;

      border-radius: 8px;

      background: rgba(37, 99, 235, .16);

      border: 1px solid rgba(37, 99, 235, .25);

      color: var(--primary);

      font-size: .8rem;

      font-weight: 800;

      direction: ltr;
    }


    /* CODE */

    .code-section {
      margin: 0 20px 20px;

      overflow: hidden;

      border-radius: 15px;

      border: 1px solid var(--border);

      background: #0b1220;
    }


    .code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px 15px;

      border-bottom: 1px solid rgba(255,255,255,.08);

      color: #cbd5e1;

      font-size: .75rem;
      font-weight: 700;
    }


    .code-header > div {
      display: flex;
      align-items: center;

      gap: 7px;
    }


    .code-header i {
      color: #60a5fa;
    }


    .copy-code {
      border: 0;

      border-radius: 8px;

      padding: 6px 10px;

      background: rgba(255,255,255,.07);

      color: #cbd5e1;

      cursor: pointer;

      font-size: .7rem;
    }


    .copy-code:hover {
      background: rgba(255,255,255,.12);
    }


    #cssOutput {
      margin: 0;

      min-height: 180px;

      padding: 18px;

      overflow-x: auto;

      direction: ltr;

      text-align: left;

      color: #e2e8f0;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .78rem;

      line-height: 1.8;

      white-space: pre-wrap;
    }


    /* STATUS */

    .status {
      display: flex;

      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);

      border-color: rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* INFO */

    .info-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color: rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background: rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;
    }


    /* SECTIONS */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size: clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* STEPS */

    .steps {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;

      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background: rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* FAQ */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    summary {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;

      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* MOBILE */

    @media (max-width: 900px) {

      .generator {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;

        align-items: flex-start;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .generator {
        padding: 12px;
        gap: 12px;
      }


      .controls {
        padding: 16px;
      }


      .preview-wrapper {
        min-height: 320px;

        padding: 12px;
      }


      .grid-preview {
        min-height: 295px;

        padding: 8px;
      }


      .grid-preview > div {
        min-height: 35px;

        font-size: .7rem;
      }


      .code-section {
        margin: 0 12px 12px;
      }


      #cssOutput {
        min-height: 160px;

        padding: 14px;

        font-size: .7rem;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      /* THEME */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme = event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      /* ELEMENTS */

      const columns =
        document.getElementById('columns');

      const rows =
        document.getElementById('rows');

      const columnGap =
        document.getElementById('columnGap');

      const rowGap =
        document.getElementById('rowGap');

      const justify =
        document.getElementById('justify');

      const align =
        document.getElementById('align');

      const justifyContent =
        document.getElementById('justifyContent');

      const alignContent =
        document.getElementById('alignContent');

      const gridPreview =
        document.getElementById('gridPreview');

      const cssOutput =
        document.getElementById('cssOutput');

      const columnsValue =
        document.getElementById('columnsValue');

      const rowsValue =
        document.getElementById('rowsValue');

      const columnGapValue =
        document.getElementById('columnGapValue');

      const rowGapValue =
        document.getElementById('rowGapValue');

      const gridInfo =
        document.getElementById('gridInfo');

      const copyBtn =
        document.getElementById('copyBtn');

      const copyCodeBtn =
        document.getElementById('copyCodeBtn');

      const resetBtn =
        document.getElementById('resetBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');


      /* STATUS */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {
        status.classList.add('hidden');
      };


      /* ITEMS */

      const createItems = () => {

        const total =
          Number(columns.value) *
          Number(rows.value);

        gridPreview.innerHTML = '';

        for (
          let i = 1;
          i <= total;
          i++
        ) {

          const item =
            document.createElement('div');

          item.textContent = i;

          gridPreview.appendChild(item);

        }

      };


      /* CSS */

      const generateCSS = () => {

        const cols =
          Number(columns.value);

        const rowCount =
          Number(rows.value);

        const colGap =
          Number(columnGap.value);

        const rGap =
          Number(rowGap.value);

        const justifyValue =
          justify.value;

        const alignValue =
          align.value;

        const justifyContentValue =
          justifyContent.value;

        const alignContentValue =
          alignContent.value;


        gridPreview.style.gridTemplateColumns =
          `repeat(${cols}, 1fr)`;

        gridPreview.style.gridTemplateRows =
          `repeat(${rowCount}, 1fr)`;

        gridPreview.style.columnGap =
          `${colGap}px`;

        gridPreview.style.rowGap =
          `${rGap}px`;

        gridPreview.style.justifyItems =
          justifyValue;

        gridPreview.style.alignItems =
          alignValue;

        gridPreview.style.justifyContent =
          justifyContentValue;

        gridPreview.style.alignContent =
          alignContentValue;


        columnsValue.textContent =
          cols;

        rowsValue.textContent =
          rowCount;

        columnGapValue.textContent =
          `${colGap}px`;

        rowGapValue.textContent =
          `${rGap}px`;

        gridInfo.textContent =
          `${cols} × ${rowCount}`;


        cssOutput.textContent =
`.grid-container {
  display: grid;
  grid-template-columns: repeat(${cols}, 1fr);
  grid-template-rows: repeat(${rowCount}, 1fr);
  column-gap: ${colGap}px;
  row-gap: ${rGap}px;
  justify-items: ${justifyValue};
  align-items: ${alignValue};
  justify-content: ${justifyContentValue};
  align-content: ${alignContentValue};
}`;


        createItems();

      };


      /* COPY */

      const copyCSS = async () => {

        const value =
          cssOutput.textContent;

        if (!value) {
          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );

          showStatus(
            'تم نسخ كود CSS بنجاح.'
          );

          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          copyCodeBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ CSS';

            copyCodeBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          showStatus(
            'تعذر نسخ الكود. حاول مرة أخرى.',
            true
          );

        }

      };


      /* RESET */

      const reset = () => {

        columns.value = '3';

        rows.value = '3';

        columnGap.value = '12';

        rowGap.value = '12';

        justify.value = 'stretch';

        align.value = 'stretch';

        justifyContent.value = 'stretch';

        alignContent.value = 'stretch';

        hideStatus();

        generateCSS();

      };


      /* EVENTS */

      [
        columns,
        rows,
        columnGap,
        rowGap,
        justify,
        align,
        justifyContent,
        alignContent
      ].forEach((element) => {

        element.addEventListener(
          'input',
          generateCSS
        );

        element.addEventListener(
          'change',
          generateCSS
        );

      });


      copyBtn.addEventListener(
        'click',
        copyCSS
      );


      copyCodeBtn.addEventListener(
        'click',
        copyCSS
      );


      resetBtn.addEventListener(
        'click',
        reset
      );


      /* INITIAL */

      generateCSS();

    })();
  </script>

</body>
</html>
