---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JSON Minifier - تصغير JSON أونلاين مجاناً | Th.Tech";
const description =
  "أداة JSON Minifier مجانية لتصغير وضغط كود JSON وإزالة المسافات والأسطر الزائدة وتقليل حجم البيانات مباشرة من المتصفح.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- تطبيق الثيم قبل ظهور الصفحة -->
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <!-- ================= HERO ================= -->
    <section class="tool-hero">
      <div class="container">
        <div class="breadcrumb">
          <a href={`${base}/`}>
            <i class="fas fa-house"></i>
            الرئيسية
          </a>

          <i class="fas fa-chevron-left separator"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fas fa-chevron-left separator"></i>

          <span>JSON Minifier</span>
        </div>

        <div class="tool-heading">
          <div class="tool-icon">
            <i class="fas fa-compress-alt"></i>
          </div>

          <div>
            <h1>JSON Minifier</h1>

            <p>
              تصغير وضغط JSON وإزالة المسافات والأسطر الزائدة لتقليل حجم البيانات.
            </p>
          </div>
        </div>

        <div class="tool-tags">
          <span>
            <i class="fas fa-bolt"></i>
            سريع
          </span>

          <span>
            <i class="fas fa-shield-halved"></i>
            يعمل محلياً
          </span>

          <span>
            <i class="fas fa-gift"></i>
            مجاني
          </span>
        </div>
      </div>
    </section>

    <!-- ================= TOOL ================= -->
    <section class="tool-section">
      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->
          <div class="toolbar">

            <div class="toolbar-title">
              <div class="toolbar-icon">
                <i class="fas fa-code"></i>
              </div>

              <div>
                <strong>JSON Minifier</strong>
                <small>تصغير كود JSON</small>
              </div>
            </div>

            <div class="toolbar-actions">
              <button
                id="sampleBtn"
                class="tool-btn secondary"
                type="button"
                title="إدخال مثال"
              >
                <i class="fas fa-flask"></i>
                <span>مثال</span>
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
                title="مسح"
              >
                <i class="fas fa-trash"></i>
                <span>مسح</span>
              </button>
            </div>

          </div>

          <!-- Editor Grid -->
          <div class="editor-grid">

            <!-- Input -->
            <div class="editor-panel">

              <div class="panel-header">
                <div class="panel-title">
                  <span class="status-dot input-dot"></span>
                  JSON الأصلي
                </div>

                <span id="inputSize" class="size-label">
                  0 B
                </span>
              </div>

              <div class="editor-wrapper">
                <textarea
                  id="input"
                  dir="ltr"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  placeholder={`{
  "name": "Th.Tech",
  "version": "1.0",
  "tools": [
    "JSON Formatter",
    "JSON Validator"
  ]
}`}
                ></textarea>
              </div>

              <div class="panel-footer">
                <span id="inputChars">
                  0 حرف
                </span>

                <span id="inputLines">
                  0 سطر
                </span>
              </div>

            </div>

            <!-- Arrow -->
            <div class="process-arrow">
              <div>
                <i class="fas fa-arrow-left"></i>
              </div>
            </div>

            <!-- Output -->
            <div class="editor-panel output-panel">

              <div class="panel-header">
                <div class="panel-title">
                  <span class="status-dot output-dot"></span>
                  JSON المصغّر
                </div>

                <span id="outputSize" class="size-label">
                  0 B
                </span>
              </div>

              <div class="editor-wrapper">
                <textarea
                  id="output"
                  dir="ltr"
                  spellcheck="false"
                  readonly
                  placeholder="ستظهر النتيجة هنا..."
                ></textarea>
              </div>

              <div class="panel-footer">
                <span id="outputChars">
                  0 حرف
                </span>

                <button
                  id="copyBtn"
                  class="copy-btn"
                  type="button"
                  disabled
                >
                  <i class="far fa-copy"></i>
                  نسخ
                </button>
              </div>

            </div>

          </div>

          <!-- Main Action -->
          <div class="action-area">

            <button id="minifyBtn" class="minify-btn" type="button">
              <i class="fas fa-compress"></i>
              <span>تصغير JSON</span>
              <i class="fas fa-arrow-left arrow"></i>
            </button>

          </div>

          <!-- Result -->
          <div id="resultBox" class="result-box hidden">

            <div class="result-icon success">
              <i class="fas fa-check"></i>
            </div>

            <div class="result-content">
              <strong>تم تصغير JSON بنجاح</strong>
              <span id="resultMessage">
                تم تقليل حجم البيانات.
              </span>
            </div>

          </div>

          <!-- Statistics -->
          <div class="stats-grid">

            <div class="stat-card">
              <div class="stat-card-icon blue">
                <i class="fas fa-file-code"></i>
              </div>

              <div>
                <span class="stat-label">الحجم الأصلي</span>
                <strong id="originalSize">0 B</strong>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-card-icon cyan">
                <i class="fas fa-compress"></i>
              </div>

              <div>
                <span class="stat-label">الحجم الجديد</span>
                <strong id="minifiedSize">0 B</strong>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-card-icon green">
                <i class="fas fa-chart-line"></i>
              </div>

              <div>
                <span class="stat-label">نسبة التوفير</span>
                <strong id="savedPercent">0%</strong>
              </div>
            </div>

          </div>

        </div>

        <!-- Privacy -->
        <div class="privacy-note">
          <div class="privacy-icon">
            <i class="fas fa-shield-halved"></i>
          </div>

          <div>
            <strong>خصوصيتك محفوظة</strong>
            <p>
              تتم معالجة JSON بالكامل داخل متصفحك.
              لا يتم إرسال بياناتك إلى أي خادم.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= INFO ================= -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">
          <span class="section-kicker">
            <i class="fas fa-circle-info"></i>
            حول الأداة
          </span>

          <h2>
            ما هو
            <span>JSON Minifier؟</span>
          </h2>

          <p>
            أداة تساعدك على تقليل حجم ملفات JSON من خلال إزالة المسافات
            والأسطر والتنسيقات غير الضرورية.
          </p>
        </div>

        <div class="info-grid">

          <div class="info-card">
            <div class="info-icon">
              <i class="fas fa-gauge-high"></i>
            </div>

            <h3>أداء أفضل</h3>

            <p>
              JSON أصغر يعني بيانات أقل عند إرسالها عبر الشبكة،
              مما يساعد على تحسين سرعة نقل البيانات.
            </p>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <i class="fas fa-hard-drive"></i>
            </div>

            <h3>حجم أقل</h3>

            <p>
              إزالة المسافات والأسطر غير الضرورية تقلل الحجم
              دون تغيير محتوى البيانات.
            </p>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <i class="fas fa-lock"></i>
            </div>

            <h3>معالجة محلية</h3>

            <p>
              تتم عملية التصغير داخل المتصفح مباشرة دون الحاجة
              إلى رفع JSON إلى خادم خارجي.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- ================= HOW TO ================= -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">
          <span class="section-kicker">
            <i class="fas fa-list-ol"></i>
            طريقة الاستخدام
          </span>

          <h2>
            كيف تستخدم
            <span>الأداة؟</span>
          </h2>
        </div>

        <div class="steps">

          <div class="step">
            <div class="step-number">01</div>

            <div class="step-icon">
              <i class="fas fa-paste"></i>
            </div>

            <h3>أدخل JSON</h3>

            <p>
              الصق كود JSON الذي تريد تصغيره في المحرر.
            </p>
          </div>

          <div class="step">
            <div class="step-number">02</div>

            <div class="step-icon">
              <i class="fas fa-compress"></i>
            </div>

            <h3>اضغط تصغير</h3>

            <p>
              اضغط على زر "تصغير JSON" لمعالجة البيانات.
            </p>
          </div>

          <div class="step">
            <div class="step-number">03</div>

            <div class="step-icon">
              <i class="fas fa-copy"></i>
            </div>

            <h3>انسخ النتيجة</h3>

            <p>
              انسخ JSON المصغّر واستخدمه مباشرة في مشروعك.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />

  <!-- Scroll Top -->
  <button
    id="scrollTop"
    class="scroll-top"
    aria-label="العودة إلى الأعلى"
    type="button"
  >
    <i class="fas fa-arrow-up"></i>
  </button>

  <style>
    /* =========================================================
       THEME
    ========================================================= */

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --bg3: #eaf0f7;

      --text: #0f172a;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;

      --border: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(37, 99, 235, 0.25);

      --card: #ffffff;
      --card-solid: #ffffff;

      --shadow:
        0 20px 60px rgba(15, 23, 42, 0.08);

      --radius: 20px;
    }

    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --bg3: #111d32;

      --text: #f8fafc;
      --text-muted: #94a3b8;

      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;

      --border: rgba(148, 163, 184, 0.12);
      --border-strong: rgba(59, 130, 246, 0.28);

      --card: rgba(17, 29, 50, 0.82);
      --card-solid: #111d32;

      --shadow:
        0 20px 60px rgba(0, 0, 0, 0.28);
    }

    /* =========================================================
       RESET
    ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color 0.25s ease,
        color 0.25s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    textarea {
      font-family: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: 100%;
      max-width: 1240px;
      margin: auto;
      padding: 0 24px;
    }

    /* =========================================================
       HERO
    ========================================================= */

    .tool-hero {
      position: relative;
      padding: 45px 0 55px;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 85% 30%,
          rgba(37, 99, 235, 0.12),
          transparent 35%
        ),
        var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .tool-hero::before {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      left: -250px;
      top: -300px;
      border-radius: 50%;
      background: rgba(6, 182, 212, 0.08);
      filter: blur(80px);
      pointer-events: none;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-muted);
      font-size: 0.78rem;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .breadcrumb a {
      transition: color 0.2s ease;
    }

    .breadcrumb a:hover {
      color: var(--primary);
    }

    .breadcrumb .separator {
      font-size: 0.55rem;
      opacity: 0.55;
    }

    .tool-heading {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .tool-icon {
      width: 76px;
      height: 76px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 21px;
      color: #fff;
      font-size: 1.75rem;
      background:
        linear-gradient(135deg, #3b82f6, #2563eb);
      box-shadow:
        0 15px 35px rgba(37, 99, 235, 0.25);
    }

    .tool-heading h1 {
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      line-height: 1.25;
      margin-bottom: 6px;
    }

    .tool-heading p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .tool-tags {
      display: flex;
      gap: 9px;
      margin-top: 22px;
      flex-wrap: wrap;
    }

    .tool-tags span {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      border-radius: 30px;
      background: rgba(37, 99, 235, 0.07);
      border: 1px solid rgba(37, 99, 235, 0.12);
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .tool-tags i {
      color: var(--primary);
    }

    /* =========================================================
       TOOL SECTION
    ========================================================= */

    .tool-section {
      padding: 55px 0 80px;
      background: var(--bg);
    }

    .tool-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 25px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    /* =========================================================
       TOOLBAR
    ========================================================= */

    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--border);
      background: var(--bg2);
    }

    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .toolbar-icon {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
    }

    .toolbar-title strong {
      display: block;
      font-size: 0.9rem;
    }

    .toolbar-title small {
      display: block;
      color: var(--text-muted);
      font-size: 0.7rem;
      margin-top: 2px;
    }

    .toolbar-actions {
      display: flex;
      gap: 8px;
    }

    .tool-btn {
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 8px 13px;
      border-radius: 10px;
      border: 1px solid var(--border);
      cursor: pointer;
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text);
      background: var(--card);
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .tool-btn:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
      color: var(--primary);
    }

    .tool-btn.danger:hover {
      color: #ef4444;
      border-color: rgba(239, 68, 68, 0.25);
    }

    /* =========================================================
       EDITORS
    ========================================================= */

    .editor-grid {
      display: grid;
      grid-template-columns: 1fr 45px 1fr;
      gap: 18px;
      padding: 24px;
      align-items: stretch;
    }

    .editor-panel {
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 17px;
      overflow: hidden;
      background: var(--bg2);
    }

    .panel-header {
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 15px;
      border-bottom: 1px solid var(--border);
    }

    .panel-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.78rem;
      font-weight: 800;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .input-dot {
      background: #f59e0b;
      box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }

    .output-dot {
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
    }

    .size-label {
      color: var(--text-muted);
      font-size: 0.7rem;
      direction: ltr;
    }

    .editor-wrapper {
      position: relative;
      height: 350px;
    }

    textarea {
      width: 100%;
      height: 100%;
      resize: none;
      display: block;
      padding: 18px;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-family:
        "Fira Code",
        "Cascadia Code",
        Consolas,
        monospace;
      font-size: 0.82rem;
      line-height: 1.8;
      tab-size: 2;
    }

    textarea::placeholder {
      color: var(--text-muted);
      opacity: 0.65;
    }

    #output {
      color: #22c55e;
    }

    html.dark-mode #output {
      color: #4ade80;
    }

    .panel-footer {
      min-height: 45px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 14px;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.68rem;
    }

    .panel-footer > span {
      direction: rtl;
    }

    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border: 0;
      border-radius: 8px;
      background: rgba(37, 99, 235, 0.09);
      color: var(--primary);
      cursor: pointer;
      font-size: 0.7rem;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .copy-btn:hover:not(:disabled) {
      background: rgba(37, 99, 235, 0.16);
    }

    .copy-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* =========================================================
       PROCESS ARROW
    ========================================================= */

    .process-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .process-arrow > div {
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(37, 99, 235, 0.1);
      color: var(--primary);
      font-size: 0.75rem;
    }

    /* =========================================================
       ACTION
    ========================================================= */

    .action-area {
      display: flex;
      justify-content: center;
      padding: 0 24px 25px;
    }

    .minify-btn {
      min-height: 54px;
      min-width: 220px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      padding: 13px 24px;
      border: 0;
      border-radius: 14px;
      color: #fff;
      background:
        linear-gradient(135deg, #3b82f6, #2563eb);
      box-shadow:
        0 12px 30px rgba(37, 99, 235, 0.25);
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 800;
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .minify-btn:hover {
      transform: translateY(-3px);
      box-shadow:
        0 16px 38px rgba(37, 99, 235, 0.35);
    }

    .minify-btn .arrow {
      transition: transform 0.2s ease;
    }

    .minify-btn:hover .arrow {
      transform: translateX(-4px);
    }

    /* =========================================================
       RESULT
    ========================================================= */

    .result-box {
      display: flex;
      align-items: center;
      gap: 13px;
      margin: 0 24px 24px;
      padding: 15px 17px;
      border-radius: 14px;
      background: rgba(34, 197, 94, 0.07);
      border: 1px solid rgba(34, 197, 94, 0.16);
    }

    .result-box.hidden {
      display: none;
    }

    .result-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      color: #22c55e;
      background: rgba(34, 197, 94, 0.12);
    }

    .result-content strong {
      display: block;
      font-size: 0.8rem;
    }

    .result-content span {
      display: block;
      color: var(--text-muted);
      font-size: 0.7rem;
    }

    /* =========================================================
       STATS
    ========================================================= */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      padding: 0 24px 24px;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px;
      border-radius: 15px;
      background: var(--bg2);
      border: 1px solid var(--border);
    }

    .stat-card-icon {
      width: 43px;
      height: 43px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }

    .stat-card-icon.blue {
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
    }

    .stat-card-icon.cyan {
      color: var(--cyan);
      background: rgba(6, 182, 212, 0.1);
    }

    .stat-card-icon.green {
      color: #22c55e;
      background: rgba(34, 197, 94, 0.1);
    }

    .stat-label {
      display: block;
      color: var(--text-muted);
      font-size: 0.66rem;
    }

    .stat-card strong {
      display: block;
      color: var(--text);
      font-size: 0.92rem;
      direction: ltr;
      text-align: right;
    }

    /* =========================================================
       PRIVACY
    ========================================================= */

    .privacy-note {
      display: flex;
      align-items: center;
      gap: 14px;
      max-width: 900px;
      margin: 22px auto 0;
      padding: 16px 20px;
      border-radius: 15px;
      background: var(--bg2);
      border: 1px solid var(--border);
    }

    .privacy-icon {
      width: 43px;
      height: 43px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      color: #22c55e;
      background: rgba(34, 197, 94, 0.1);
    }

    .privacy-note strong {
      display: block;
      font-size: 0.78rem;
    }

    .privacy-note p {
      color: var(--text-muted);
      font-size: 0.7rem;
      margin-top: 2px;
    }

    /* =========================================================
       SECTIONS
    ========================================================= */

    .info-section,
    .how-section {
      position: relative;
      padding: 90px 0;
    }

    .info-section {
      background: var(--bg2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .how-section {
      background: var(--bg);
    }

    .section-heading {
      max-width: 700px;
      text-align: center;
      margin: 0 auto 48px;
    }

    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 10px;
      color: var(--primary);
      font-size: 0.75rem;
      font-weight: 800;
    }

    .section-heading h2 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      line-height: 1.3;
      margin-bottom: 10px;
    }

    .section-heading h2 span {
      color: var(--primary);
    }

    .section-heading > p {
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    /* =========================================================
       INFO CARDS
    ========================================================= */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .info-card {
      padding: 30px 25px;
      text-align: center;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
    }

    .info-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-strong);
    }

    .info-icon {
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 17px;
      border-radius: 16px;
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
      font-size: 1.25rem;
    }

    .info-card h3 {
      font-size: 1rem;
      margin-bottom: 8px;
    }

    .info-card p {
      color: var(--text-muted);
      font-size: 0.76rem;
      line-height: 1.9;
    }

    /* =========================================================
       STEPS
    ========================================================= */

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      max-width: 950px;
      margin: auto;
    }

    .step {
      position: relative;
      padding: 30px 25px;
      text-align: center;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    .step-number {
      position: absolute;
      top: 8px;
      left: 15px;
      color: var(--primary);
      font-size: 2.6rem;
      font-weight: 800;
      opacity: 0.05;
    }

    .step-icon {
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 17px;
      border-radius: 16px;
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
    }

    .step h3 {
      font-size: 0.98rem;
      margin-bottom: 7px;
    }

    .step p {
      color: var(--text-muted);
      font-size: 0.75rem;
      line-height: 1.8;
    }

    /* =========================================================
       SCROLL TOP
    ========================================================= */

    .scroll-top {
      position: fixed;
      left: 24px;
      bottom: 24px;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 14px;
      background: var(--primary);
      color: #fff;
      cursor: pointer;
      z-index: 999;
      opacity: 0;
      visibility: hidden;
      transform: translateY(15px);
      box-shadow:
        0 10px 30px rgba(37, 99, 235, 0.3);
      transition:
        opacity 0.25s ease,
        visibility 0.25s ease,
        transform 0.25s ease;
    }

    .scroll-top.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .scroll-top:hover {
      transform: translateY(-4px);
      background: var(--primary-hover);
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 900px) {

      .editor-grid {
        grid-template-columns: 1fr;
      }

      .process-arrow {
        height: 35px;
      }

      .process-arrow > div {
        transform: rotate(-90deg);
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .editor-wrapper {
        height: 320px;
      }
    }

    @media (max-width: 640px) {

      .container {
        padding-left: 15px;
        padding-right: 15px;
      }

      .tool-hero {
        padding: 30px 0 40px;
      }

      .breadcrumb {
        font-size: 0.68rem;
        margin-bottom: 22px;
      }

      .tool-heading {
        align-items: flex-start;
        gap: 13px;
      }

      .tool-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        font-size: 1.3rem;
      }

      .tool-heading h1 {
        font-size: 1.65rem;
      }

      .tool-heading p {
        font-size: 0.76rem;
        line-height: 1.8;
      }

      .tool-tags {
        margin-top: 18px;
      }

      .tool-tags span {
        font-size: 0.65rem;
      }

      .tool-section {
        padding: 35px 0 55px;
      }

      .toolbar {
        align-items: flex-start;
        padding: 15px;
      }

      .toolbar-actions {
        gap: 5px;
      }

      .tool-btn {
        padding: 8px 10px;
      }

      .tool-btn span {
        display: none;
      }

      .editor-grid {
        padding: 15px;
        gap: 10px;
      }

      .editor-wrapper {
        height: 270px;
      }

      textarea {
        padding: 14px;
        font-size: 0.72rem;
      }

      .panel-header {
        padding: 0 12px;
      }

      .panel-footer {
        padding: 7px 11px;
      }

      .process-arrow {
        height: 32px;
      }

      .action-area {
        padding: 0 15px 18px;
      }

      .minify-btn {
        width: 100%;
        min-width: 0;
      }

      .result-box {
        margin: 0 15px 18px;
      }

      .stats-grid {
        grid-template-columns: 1fr;
        padding: 0 15px 15px;
      }

      .privacy-note {
        align-items: flex-start;
        margin-top: 18px;
        padding: 14px;
      }

      .privacy-note p {
        line-height: 1.8;
      }

      .info-section,
      .how-section {
        padding: 65px 0;
      }

      .section-heading {
        margin-bottom: 32px;
      }

      .section-heading h2 {
        font-size: 1.75rem;
      }

      .section-heading > p {
        font-size: 0.76rem;
      }

      .info-card,
      .step {
        padding: 25px 20px;
      }

      .scroll-top {
        width: 44px;
        height: 44px;
        left: 17px;
        bottom: 17px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }

      html {
        scroll-behavior: auto;
      }
    }
  </style>

  <!-- =========================================================
       JAVASCRIPT
  ========================================================= -->

  <script>
    /* =========================================================
       THEME SYNC
    ========================================================= */

    (() => {
      const applyTheme = (isDark) => {
        if (isDark) {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }

        try {
          localStorage.setItem(
            "theme",
            isDark ? "dark" : "light"
          );
        } catch {}
      };

      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}

      window.addEventListener("themeChange", (event) => {
        const theme = event?.detail;

        if (theme === "light" || theme === "dark") {
          applyTheme(theme === "dark");
        }
      });

      const themeObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (
            mutation.type === "attributes" &&
            mutation.attributeName === "class"
          ) {
            const isDark =
              document.documentElement.classList.contains(
                "dark-mode"
              );

            try {
              localStorage.setItem(
                "theme",
                isDark ? "dark" : "light"
              );
            } catch {}
          }
        }
      });

      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["class"]
        }
      );

      window.addEventListener("storage", (event) => {
        if (event.key === "theme") {
          applyTheme(event.newValue === "dark");
        }
      });
    })();


    /* =========================================================
       JSON MINIFIER
    ========================================================= */

    (() => {
      const input = document.getElementById("input");
      const output = document.getElementById("output");

      const minifyBtn =
        document.getElementById("minifyBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const sampleBtn =
        document.getElementById("sampleBtn");

      const inputSize =
        document.getElementById("inputSize");

      const outputSize =
        document.getElementById("outputSize");

      const inputChars =
        document.getElementById("inputChars");

      const outputChars =
        document.getElementById("outputChars");

      const inputLines =
        document.getElementById("inputLines");

      const resultBox =
        document.getElementById("resultBox");

      const resultMessage =
        document.getElementById("resultMessage");

      const originalSize =
        document.getElementById("originalSize");

      const minifiedSize =
        document.getElementById("minifiedSize");

      const savedPercent =
        document.getElementById("savedPercent");


      /* ---------------------------------------------------------
         Helpers
      --------------------------------------------------------- */

      const formatBytes = (bytes) => {
        if (!bytes || bytes <= 0) {
          return "0 B";
        }

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {
          return `${(bytes / 1024).toFixed(2)} KB`;
        }

        return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
      };


      const getBytes = (text) => {
        return new Blob([text]).size;
      };


      const updateInputStats = () => {
        const value = input.value;

        const size = getBytes(value);

        inputSize.textContent =
          formatBytes(size);

        inputChars.textContent =
          `${value.length.toLocaleString("ar")} حرف`;

        const lines = value
          ? value.split(/\r\n|\r|\n/).length
          : 0;

        inputLines.textContent =
          `${lines.toLocaleString("ar")} سطر`;

        originalSize.textContent =
          formatBytes(size);
      };


      const updateOutputStats = () => {
        const value = output.value;

        const size = getBytes(value);

        outputSize.textContent =
          formatBytes(size);

        outputChars.textContent =
          `${value.length.toLocaleString("ar")} حرف`;

        minifiedSize.textContent =
          formatBytes(size);
      };


      const showError = (message) => {
        resultBox.classList.remove("hidden");

        resultBox.style.background =
          "rgba(239, 68, 68, 0.07)";

        resultBox.style.borderColor =
          "rgba(239, 68, 68, 0.18)";

        const icon =
          resultBox.querySelector(".result-icon");

        icon.style.background =
          "rgba(239, 68, 68, 0.12)";

        icon.style.color = "#ef4444";

        icon.innerHTML =
          '<i class="fas fa-xmark"></i>';

        resultBox.querySelector("strong").textContent =
          "JSON غير صالح";

        resultMessage.textContent = message;
      };


      const showSuccess = (original, minified) => {
        resultBox.classList.remove("hidden");

        resultBox.style.background =
          "rgba(34, 197, 94, 0.07)";

        resultBox.style.borderColor =
          "rgba(34, 197, 94, 0.16)";

        const icon =
          resultBox.querySelector(".result-icon");

        icon.style.background =
          "rgba(34, 197, 94, 0.12)";

        icon.style.color =
          "#22c55e";

        icon.innerHTML =
          '<i class="fas fa-check"></i>';

        resultBox.querySelector("strong").textContent =
          "تم تصغير JSON بنجاح";

        const originalBytes =
          getBytes(original);

        const minifiedBytes =
          getBytes(minified);

        let saved = 0;

        if (originalBytes > 0) {
          saved =
            ((originalBytes - minifiedBytes) /
              originalBytes) *
            100;
        }

        if (saved < 0) {
          saved = 0;
        }

        savedPercent.textContent =
          `${saved.toFixed(1)}%`;

        const savedText =
          saved > 0
            ? `تم تقليل الحجم بنسبة ${saved.toFixed(1)}%.`
            : "JSON لا يحتوي على مسافات إضافية كبيرة.";

        resultMessage.textContent =
          savedText;
      };


      /* ---------------------------------------------------------
         Minify
      --------------------------------------------------------- */

      const minify = () => {
        const value = input.value.trim();

        if (!value) {
          showError(
            "أدخل كود JSON أولاً ثم حاول مرة أخرى."
          );

          output.value = "";
          copyBtn.disabled = true;

          updateOutputStats();

          return;
        }

        try {
          const parsed =
            JSON.parse(value);

          const minified =
            JSON.stringify(parsed);

          output.value = minified;

          copyBtn.disabled = !minified;

          updateInputStats();
          updateOutputStats();

          showSuccess(
            value,
            minified
          );

        } catch (error) {
          output.value = "";
          copyBtn.disabled = true;

          updateOutputStats();

          let message =
            "تحقق من الأقواس والفواصل وعلامات الاقتباس.";

          if (
            error &&
            typeof error.message === "string"
          ) {
            message = error.message;
          }

          showError(message);
        }
      };


      /* ---------------------------------------------------------
         Copy
      --------------------------------------------------------- */

      copyBtn.addEventListener("click", async () => {
        const value = output.value;

        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);

          const oldHTML =
            copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = oldHTML;
          }, 1600);

        } catch {
          output.select();
          document.execCommand("copy");

          const oldHTML =
            copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = oldHTML;
          }, 1600);
        }
      });


      /* ---------------------------------------------------------
         Clear
      --------------------------------------------------------- */

      clearBtn.addEventListener("click", () => {
        input.value = "";
        output.value = "";

        copyBtn.disabled = true;

        resultBox.classList.add("hidden");

        savedPercent.textContent =
          "0%";

        updateInputStats();
        updateOutputStats();

        input.focus();
      });


      /* ---------------------------------------------------------
         Sample
      --------------------------------------------------------- */

      sampleBtn.addEventListener("click", () => {
        input.value = `{
  "name": "Th.Tech",
  "description": "منصة تقنية عربية",
  "version": "1.0.0",
  "active": true,
  "tools": [
    {
      "name": "JSON Formatter",
      "category": "JSON",
      "free": true
    },
    {
      "name": "JSON Validator",
      "category": "JSON",
      "free": true
    },
    {
      "name": "JSON Minifier",
      "category": "JSON",
      "free": true
    }
  ],
  "features": {
    "fast": true,
    "secure": true,
    "responsive": true
  }
}`;

        updateInputStats();

        resultBox.classList.add("hidden");

        input.focus();
      });


      /* ---------------------------------------------------------
         Input
      --------------------------------------------------------- */

      input.addEventListener(
        "input",
        () => {
          updateInputStats();

          if (!input.value.trim()) {
            output.value = "";
            copyBtn.disabled = true;

            updateOutputStats();

            resultBox.classList.add("hidden");
          }
        }
      );


      /* ---------------------------------------------------------
         Keyboard shortcut
      --------------------------------------------------------- */

      input.addEventListener("keydown", (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key === "Enter"
        ) {
          event.preventDefault();
          minify();
        }

        if (event.key === "Tab") {
          event.preventDefault();

          const start = input.selectionStart;
          const end = input.selectionEnd;

          input.value =
            input.value.substring(0, start) +
            "  " +
            input.value.substring(end);

          input.selectionStart =
            input.selectionEnd =
              start + 2;

          updateInputStats();
        }
      });


      minifyBtn.addEventListener(
        "click",
        minify
      );


      /* Initial */
      updateInputStats();
      updateOutputStats();
    })();


    /* =========================================================
       SCROLL TOP
    ========================================================= */

    (() => {
      const button =
        document.getElementById("scrollTop");

      if (!button) return;

      const update = () => {
        if (window.scrollY > 400) {
          button.classList.add("show");
        } else {
          button.classList.remove("show");
        }
      };

      window.addEventListener(
        "scroll",
        update,
        { passive: true }
      );

      button.addEventListener(
        "click",
        () => {
          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });
        }
      );

      update();
    })();
  </script>
</body>
