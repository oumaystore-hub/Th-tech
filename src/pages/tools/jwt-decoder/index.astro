  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const input =
        document.getElementById("jwtInput");

      const decodeBtn =
        document.getElementById("decodeBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");


      const inputCount =
        document.getElementById("inputCount");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");


      const headerOutput =
        document.getElementById("headerOutput");

      const payloadOutput =
        document.getElementById("payloadOutput");

      const signatureOutput =
        document.getElementById("signatureOutput");


      const claimsPanel =
        document.getElementById("claimsPanel");

      const claimsList =
        document.getElementById("claimsList");


      const statLength =
        document.getElementById("statLength");

      const statParts =
        document.getElementById("statParts");

      const statAlgorithm =
        document.getElementById("statAlgorithm");

      const statStatus =
        document.getElementById("statStatus");


      let decodedHeader = "";
      let decodedPayload = "";
      let decodedSignature = "";


      function updateCount() {

        const length =
          input.value.length;

        inputCount.textContent =
          `${length.toLocaleString()} حرف`;

        statLength.textContent =
          length.toLocaleString();
      }


      function showReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز للتحليل";

        resultMessage.textContent =
          "أدخل JWT ثم اضغط على تحليل JWT.";

        statStatus.textContent =
          "جاهز";
      }


      function showSuccess(message) {

        resultBox.classList.remove(
          "error"
        );

        resultBox.classList.add(
          "success"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم تحليل JWT بنجاح";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "تم التحليل";
      }


      function showError(message) {

        resultBox.classList.remove(
          "success"
        );

        resultBox.classList.add(
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر تحليل JWT";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";
      }


      function resetOutput() {

        headerOutput.textContent =
          "—";

        payloadOutput.textContent =
          "—";

        signatureOutput.textContent =
          "—";

        decodedHeader = "";
        decodedPayload = "";
        decodedSignature = "";

        statParts.textContent =
          "0 / 3";

        statAlgorithm.textContent =
          "—";

        claimsList.innerHTML =
          '<div class="empty-claims">لا توجد Claims لعرضها.</div>';

        claimsPanel.classList.remove(
          "visible"
        );
      }


      function base64UrlDecode(value) {

        let str =
          value
            .replace(/-/g, "+")
            .replace(/_/g, "/");


        while (
          str.length % 4 !== 0
        ) {

          str += "=";
        }


        const binary =
          atob(str);


        const bytes =
          new Uint8Array(
            binary.length
          );


        for (
          let i = 0;
          i < binary.length;
          i++
        ) {

          bytes[i] =
            binary.charCodeAt(i);

        }


        try {

          return new TextDecoder(
            "utf-8",
            { fatal: true }
          ).decode(bytes);

        } catch {

          return new TextDecoder(
            "utf-8"
          ).decode(bytes);

        }
      }


      function prettyJSON(text) {

        try {

          const parsed =
            JSON.parse(text);

          return JSON.stringify(
            parsed,
            null,
            2
          );

        } catch {

          return text;
        }
      }


      function createClaims(payload) {

        claimsList.innerHTML = "";

        const keys =
          Object.keys(payload);


        if (!keys.length) {

          claimsList.innerHTML =
            '<div class="empty-claims">لا توجد Claims داخل Payload.</div>';

          claimsPanel.classList.add(
            "visible"
          );

          return;
        }


        keys.forEach(
          (key) => {

            const row =
              document.createElement("div");

            row.className =
              "claim-row";


            const name =
              document.createElement("div");

            name.className =
              "claim-name";

            name.textContent =
              key;


            const value =
              document.createElement("div");

            value.className =
              "claim-value";


            const raw =
              payload[key];


            if (
              raw !== null &&
              typeof raw === "object"
            ) {

              value.textContent =
                JSON.stringify(raw);

            } else {

              value.textContent =
                String(raw);

            }


            row.appendChild(
              name
            );

            row.appendChild(
              value
            );


            claimsList.appendChild(
              row
            );

          }
        );


        claimsPanel.classList.add(
          "visible"
        );
      }


      function decodeJWT() {

        const token =
          input.value
            .trim();


        updateCount();


        if (!token) {

          showError(
            "أدخل JWT أولاً."
          );

          return;
        }


        resetOutput();


        const parts =
          token.split(".");


        if (parts.length !== 3) {

          statParts.textContent =
            `${parts.length} / 3`;

          showError(
            "JWT يجب أن يتكون عادةً من ثلاثة أجزاء مفصولة بنقاط."
          );

          return;
        }


        try {

          const headerText =
            base64UrlDecode(
              parts[0]
            );


          const payloadText =
            base64UrlDecode(
              parts[1]
            );


          const header =
            JSON.parse(
              headerText
            );


          const payload =
            JSON.parse(
              payloadText
            );


          decodedHeader =
            JSON.stringify(
              header,
              null,
              2
            );


          decodedPayload =
            JSON.stringify(
              payload,
              null,
              2
            );


          decodedSignature =
            parts[2];


          headerOutput.textContent =
            decodedHeader;


          payloadOutput.textContent =
            decodedPayload;


          signatureOutput.textContent =
            decodedSignature;


          statParts.textContent =
            "3 / 3";


          statAlgorithm.textContent =
            header.alg ||
            "—";


          createClaims(
            payload
          );


          const type =
            header.typ
              ? ` — ${header.typ}`
              : "";


          showSuccess(
            `تم فك Header وPayload بنجاح${type}. ملاحظة: لم يتم التحقق من التوقيع.`
          );

        } catch (error) {

          resetOutput();

          statParts.textContent =
            "3 / 3";

          showError(
            "JWT غير صالح أو أن Header / Payload لا يحتويان على JSON صحيح."
          );
        }
      }


      function loadExample() {

        input.value =
          "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0aHRlY2giLCJuYW1lIjoiVGguVGVjaCIsInJvbGUiOiJkZXZlbG9wZXIiLCJpYXQiOjE3MjAwMDAwMDB9.dGVjaC1zaWduYXR1cmU";

        updateCount();

        decodeJWT();
      }


      function clearAll() {

        input.value = "";

        updateCount();

        resetOutput();

        showReady();

        input.focus();
      }


      async function copyAll() {

        const value =
          input.value.trim();


        if (!value) {

          showError(
            "لا يوجد JWT لنسخه."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);

        } catch {

          input.select();

          document.execCommand(
            "copy"
          );

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ';

          }, 1500);
        }
      }


      async function copyPart(type) {

        let value = "";


        if (type === "header") {
          value = decodedHeader;
        }


        if (type === "payload") {
          value = decodedPayload;
        }


        if (!value) {

          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );

        } catch {

          const temp =
            document.createElement(
              "textarea"
            );

          temp.value =
            value;

          document.body.appendChild(
            temp
          );

          temp.select();

          document.execCommand(
            "copy"
          );

          temp.remove();
        }

      }


      input.addEventListener(
        "input",
        updateCount
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            decodeJWT();
          }


          if (
            event.key === "Tab"
          ) {

            event.preventDefault();

            const start =
              input.selectionStart;

            const end =
              input.selectionEnd;


            input.value =
              input.value.substring(
                0,
                start
              ) +
              "  " +
              input.value.substring(
                end
              );


            input.selectionStart =
              input.selectionEnd =
                start + 2;

            updateCount();
          }

        }
      );


      document
        .querySelectorAll(".copy-part")
        .forEach(
          (button) => {

            button.addEventListener(
              "click",
              () => {

                copyPart(
                  button.dataset.copy
                );

              }
            );

          }
        );


      decodeBtn.addEventListener(
        "click",
        decodeJWT
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyAll
      );


      updateCount();

      resetOutput();

    })();
  </script>


