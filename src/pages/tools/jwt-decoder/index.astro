---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JWT Decoder - قراءة وتحليل JWT أونلاين مجاناً | Th.Tech";

const description =
  "أداة JWT Decoder مجانية لقراءة وتحليل Header وPayload الخاصة بـ JSON Web Token مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JWT؟",
    a: "JWT أو JSON Web Token هو تنسيق شائع لنقل المعلومات بين الأطراف، ويتكون عادةً من ثلاثة أجزاء: Header وPayload وSignature."
  },
  {
    q: "هل تقوم الأداة بالتحقق من توقيع JWT؟",
    a: "لا. هذه الأداة تقوم بقراءة وفك ترميز Header وPayload فقط، ولا تعتبر التوكن صالحاً أو موثوقاً لمجرد إمكانية فك ترميزه."
  },
  {
    q: "هل يتم إرسال JWT إلى الخادم؟",
    a: "لا. تتم عملية فك الترميز داخل المتصفح باستخدام JavaScript، ولا يتم إرسال التوكن إلى خادم خارجي."
  },
  {
    q: "هل يمكن قراءة Payload بدون معرفة Secret Key؟",
    a: "نعم. Header وPayload في JWT عادةً Base64URL encoded وليسا مشفرين. يمكن قراءتهما دون Secret Key، بينما التحقق من Signature يحتاج إلى المفتاح والخوارزمية المناسبة."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>JWT Decoder</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-cube"></i>
            <span>JWT</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>JWT Decoder</h1>

            <p>
              اقرأ وحلّل JSON Web Token واستخراج
              Header وPayload وSignature بسهولة.
            </p>

            <div class="tags">
              <span>JWT</span>
              <span>Base64URL</span>
              <span>JSON</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="decoder-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-cube"></i>
              JWT Decoder
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button id="decodeBtn" class="btn btn-primary">
              <i class="fa-solid fa-unlock-keyhole"></i>
              تحليل JWT
            </button>

          </div>


          <!-- INPUT -->
          <div class="input-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-key"></i>
                JWT Token
              </div>

              <span id="inputCount">0 حرف</span>

            </div>

            <textarea
              id="jwtInput"
              spellcheck="false"
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0aHRlY2giLCJuYW1lIjoiVGguVGVjaCJ9.signature"
            ></textarea>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للتحليل
              </strong>

              <p id="resultMessage">
                أدخل JWT ثم اضغط على تحليل JWT.
              </p>

            </div>

          </div>


          <!-- PARTS -->
          <div class="parts-grid">

            <!-- HEADER -->
            <div class="jwt-panel">

              <div class="panel-header">
                <div class="panel-title">
                  <div class="panel-icon">
                    <i class="fa-solid fa-code"></i>
                  </div>

                  <div>
                    <strong>Header</strong>
                    <span>بيانات الرأس</span>
                  </div>
                </div>

                <span class="part-badge">PART 1</span>
              </div>

              <pre id="headerOutput" class="code-output">—</pre>

              <button class="copy-part" data-copy="header">
                <i class="fa-regular fa-copy"></i>
                نسخ Header
              </button>

            </div>


            <!-- PAYLOAD -->
            <div class="jwt-panel">

              <div class="panel-header">
                <div class="panel-title">
                  <div class="panel-icon payload-icon">
                    <i class="fa-solid fa-database"></i>
                  </div>

                  <div>
                    <strong>Payload</strong>
                    <span>بيانات التوكن</span>
                  </div>
                </div>

                <span class="part-badge">PART 2</span>
              </div>

              <pre id="payloadOutput" class="code-output">—</pre>

              <button class="copy-part" data-copy="payload">
                <i class="fa-regular fa-copy"></i>
                نسخ Payload
              </button>

            </div>


            <!-- SIGNATURE -->
            <div class="jwt-panel signature-panel">

              <div class="panel-header">
                <div class="panel-title">
                  <div class="panel-icon signature-icon">
                    <i class="fa-solid fa-fingerprint"></i>
                  </div>

                  <div>
                    <strong>Signature</strong>
                    <span>التوقيع</span>
                  </div>
                </div>

                <span class="part-badge">PART 3</span>
              </div>

              <pre id="signatureOutput" class="code-output signature-output">—</pre>

              <div class="signature-note">
                <i class="fa-solid fa-circle-info"></i>
                التوقيع معروض فقط ولا يتم التحقق منه.
              </div>

            </div>

          </div>


          <!-- CLAIMS -->
          <div class="claims-panel" id="claimsPanel">

            <div class="panel-title">
              <i class="fa-solid fa-list-check"></i>
              JWT Claims
            </div>

            <div id="claimsList" class="claims-list">

              <div class="empty-claims">
                لا توجد Claims لعرضها.
              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>طول JWT</span>
                <strong id="statLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <div>
                <span>الأجزاء</span>
                <strong id="statParts">0 / 3</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <span>Algorithm</span>
                <strong id="statAlgorithm">—</strong>
