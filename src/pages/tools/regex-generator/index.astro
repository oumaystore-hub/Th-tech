  <Footer />

  <script is:inline>
    (() => {
      const type = document.getElementById("type");
      const length = document.getElementById("length");
      const customField = document.getElementById("customField");
      const customPattern = document.getElementById("customPattern");

      const lengthField = document.getElementById("lengthField");

      const globalFlag = document.getElementById("globalFlag");
      const ignoreCase = document.getElementById("ignoreCase");
      const anchors = document.getElementById("anchors");
      const unicode = document.getElementById("unicode");

      const output = document.getElementById("output");
      const patternType = document.getElementById("patternType");
      const flagPreview = document.getElementById("flagPreview");
      const patternLength = document.getElementById("patternLength");

      const generateBtn = document.getElementById("generateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const copyBtn = document.getElementById("copyBtn");
      const resetBtn = document.getElementById("resetBtn");

      const status = document.getElementById("status");

      const statLength = document.getElementById("statLength");
      const statFlags = document.getElementById("statFlags");
      const statType = document.getElementById("statType");
      const statStatus = document.getElementById("statStatus");

      const patterns = {
        email:
          "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",

        url:
          "https?:\\/\\/(?:www\\.)?[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?:\\/[^\\s]*)?",

        phone:
          "\\+?[0-9]{7,15}",

        ipv4:
          "(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}",

        date:
          "\\d{4}[-\\/]\\d{2}[-\\/]\\d{2}",

        number:
          "-?\\d+(?:\\.\\d+)?",

        integer:
          "-?\\d+",

        decimal:
          "-?\\d+\\.\\d+",

        username:
          "[A-Za-z][A-Za-z0-9_]{2,15}",

        hex:
          "#?[A-Fa-f0-9]{6}",

        binary:
          "[01]+",

        letters:
          "[A-Za-z]+",

        alphanumeric:
          "[A-Za-z0-9]+",

        whitespace:
          "\\s+"
      };

      const typeLabels = {
        email: "EMAIL",
        url: "URL",
        phone: "PHONE",
        ipv4: "IPV4",
        date: "DATE",
        number: "NUMBER",
        integer: "INTEGER",
        decimal: "DECIMAL",
        username: "USERNAME",
        password: "PASSWORD",
        hex: "HEX",
        binary: "BINARY",
        letters: "LETTERS",
        alphanumeric: "ALPHANUMERIC",
        whitespace: "WHITESPACE",
        custom: "CUSTOM"
      };

      function setStatus(message, success = true) {
        status.className = "status";

        if (success) {
          status.classList.add("success");
        }

        const icon = status.querySelector("i");
        const text = status.querySelector("span");

        icon.className = success
          ? "fa-solid fa-circle-check"
          : "fa-solid fa-circle-info";

        text.textContent = message;
      }

      function getFlags() {
        let flags = "";

        if (globalFlag.checked) {
          flags += "g";
        }

        if (ignoreCase.checked) {
          flags += "i";
        }

        if (unicode.checked) {
          flags += "u";
        }

        return flags;
      }

      function getPasswordPattern() {
        const min = Math.max(
          4,
          Math.min(99, Number(length.value) || 8)
        );

        return `(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{${min},}`;
      }

      function applyAnchors(pattern) {
        if (!anchors.checked) {
          return pattern;
        }

        return `^${pattern}$`;
      }

      function generate() {
        const selected = type.value;

        customField.hidden = selected !== "custom";

        if (selected === "custom") {
          lengthField.hidden = true;
        } else if (selected === "password") {
          lengthField.hidden = false;
        } else {
          lengthField.hidden = true;
        }

        let generated = "";

        if (selected === "custom") {
          generated = customPattern.value.trim();
        } else if (selected === "password") {
          generated = getPasswordPattern();
        } else {
          generated = patterns[selected] || "";
        }

        if (selected !== "whitespace" && generated) {
          generated = applyAnchors(generated);
        }

        output.value = generated;

        patternType.textContent =
          typeLabels[selected] || "REGEX";

        const flags = getFlags();

        flagPreview.textContent =
          `Flags: ${flags || "none"}`;

        patternLength.textContent =
          `${generated.length.toLocaleString("ar")} رمز`;

        statLength.textContent =
          generated.length.toLocaleString("ar");

        statFlags.textContent =
          flags.length.toLocaleString("ar");

        statType.textContent =
          typeLabels[selected] || "REGEX";

        if (!generated) {
          statStatus.textContent = "—";

          setStatus(
            "اختر نوع Regex أو أدخل نمطًا مخصصًا.",
            false
          );

          return;
        }

        try {
          new RegExp(generated, flags);

          statStatus.textContent = "✓";

          setStatus(
            "تم إنشاء Regex صالح وتحديثه تلقائيًا.",
            true
          );
        } catch {
          statStatus.textContent = "✕";

          setStatus(
            "النمط الناتج غير صالح. تحقق من الخيارات.",
            false
          );
        }
      }

      async function copyRegex() {
        if (!output.value) {
          setStatus(
            "لا يوجد Regex لنسخه.",
            false
          );
          return;
        }

        const regex = `/${output.value}/${getFlags()}`;

        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(regex);
          } else {
            const temp = document.createElement("textarea");
            temp.value = regex;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            temp.remove();
          }

          setStatus(
            "تم نسخ Regex إلى الحافظة.",
            true
          );
        } catch {
          setStatus(
            "تعذر نسخ Regex تلقائيًا.",
            false
          );
        }
      }

      function loadExample() {
        type.value = "password";
        length.value = "8";

        globalFlag.checked = true;
        ignoreCase.checked = false;
        anchors.checked = true;
        unicode.checked = true;

        generate();
      }

      function reset() {
        type.value = "email";
        length.value = "8";
        customPattern.value = "";

        globalFlag.checked = true;
        ignoreCase.checked = false;
        anchors.checked = true;
        unicode.checked = true;

        customField.hidden = true;
        lengthField.hidden = true;

        generate();

        setStatus(
          "تمت إعادة ضبط الإعدادات.",
          true
        );
      }

      type.addEventListener("change", generate);
      length.addEventListener("input", generate);
      customPattern.addEventListener("input", generate);

      globalFlag.addEventListener("change", generate);
      ignoreCase.addEventListener("change", generate);
      anchors.addEventListener("change", generate);
      unicode.addEventListener("change", generate);

      generateBtn.addEventListener("click", generate);
      exampleBtn.addEventListener("click", loadExample);
      copyBtn.addEventListener("click", copyRegex);
      resetBtn.addEventListener("click", reset);

      customPattern.addEventListener("keydown", (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key === "Enter"
        ) {
          event.preventDefault();
          generate();
        }
      });

      generate();
    })();
  </script>
