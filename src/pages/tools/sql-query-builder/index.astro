---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SQL Query Builder - إنشاء استعلامات SQL أونلاين | Th.Tech";
const description =
  "أداة SQL Query Builder مجانية لإنشاء استعلامات SQL بسهولة من خلال اختيار الجداول والأعمدة والشروط والترتيب والحدود.";

const faqs = [
  {
    q: "ما هي أداة SQL Query Builder؟",
    a: "SQL Query Builder هي أداة تساعدك على إنشاء استعلامات SQL بطريقة مرئية دون الحاجة إلى كتابة الاستعلام بالكامل يدوياً."
  },
  {
    q: "هل يمكنني إضافة شروط WHERE؟",
    a: "نعم، يمكنك إضافة عدة شروط WHERE واختيار الحقل والمقارنة والقيمة، ثم توليد استعلام SQL مباشرة."
  },
  {
    q: "هل يمكن استخدام JOIN؟",
    a: "نعم، يمكنك إضافة JOIN وتحديد الجدول المرتبط والحقل المستخدم في عملية الربط."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. الأداة تعمل بالكامل داخل المتصفح ولا ترسل الاستعلامات أو البيانات إلى خادم خارجي."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7c3aed" />

    <link rel="icon" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <!-- نفس نظام Theme المستخدم في SQL Formatter -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=programming">
    البرمجة
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">SQL Query Builder - إنشاء استعلامات SQL أونلاين</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->


      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>SQL Query Builder</span>
          </div>

          <div class="hero-content">

            <div class="hero-icon">
              <div class="icon-glow"></div>

              <i class="fa-solid fa-diagram-project"></i>

              <span class="mini-icon">
                <i class="fa-solid fa-database"></i>
              </span>
            </div>

            <div class="hero-text">

              <div class="badge">
                <i class="fa-solid fa-code"></i>
                Developer Tools
              </div>

              <h1>
                SQL Query Builder
                <span>منشئ استعلامات SQL</span>
              </h1>

              <p>
                أنشئ استعلامات SQL بطريقة مرئية وسهلة من خلال اختيار الجداول
                والأعمدة والشروط والترتيب والـ JOIN بدون كتابة كل شيء يدوياً.
              </p>

              <div class="hero-features">

                <span>
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  سهل
                </span>

                <span>
                  <i class="fa-solid fa-bolt"></i>
                  فوري
                </span>

                <span>
                  <i class="fa-solid fa-lock"></i>
                  خاص
                </span>

              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">

          <div class="builder-card">

            <!-- TOPBAR -->
            <div class="card-topbar">

              <div class="topbar-title">

                <div class="database-icon">
                  <i class="fa-solid fa-diagram-project"></i>
                </div>

                <div>
                  <strong>SQL Query Builder</strong>
                  <small>إنشاء استعلام SQL بصرياً</small>
                </div>

              </div>

              <div class="status">
                <span class="status-dot"></span>
                <span id="statusText">جاهز</span>
              </div>

            </div>

            <!-- TOOLBAR -->
            <div class="actionbar">

              <div class="action-group">

                <button class="btn btn-example" id="exampleBtn">
                  <i class="fa-solid fa-flask"></i>
                  مثال
                </button>

                <button class="btn btn-clear" id="clearBtn">
                  <i class="fa-solid fa-eraser"></i>
                  مسح
                </button>

              </div>

              <div class="action-group">

                <button class="btn btn-copy" id="copyBtn">
                  <i class="fa-regular fa-copy"></i>
                  نسخ SQL
                </button>

                <button class="btn btn-generate" id="generateBtn">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  توليد SQL
                </button>

              </div>

            </div>

            <!-- BUILDER -->
            <div class="builder-body">

              <!-- TABLE -->
              <div class="builder-section">

                <div class="section-title">
                  <div class="section-icon purple">
                    <i class="fa-solid fa-table"></i>
                  </div>

                  <div>
                    <strong>Table</strong>
                    <small>الجدول الرئيسي</small>
                  </div>
                </div>

                <div class="field-control">

                  <label for="tableName">
                    اسم الجدول
                  </label>

                  <div class="input-icon">
                    <i class="fa-solid fa-database"></i>

                    <input
                      id="tableName"
                      type="text"
                      value="users"
                      placeholder="users"
                    />
                  </div>

                </div>

              </div>

              <!-- COLUMNS -->
              <div class="builder-section">

                <div class="section-title">
                  <div class="section-icon blue">
                    <i class="fa-solid fa-table-columns"></i>
                  </div>

                  <div>
                    <strong>Columns</strong>
                    <small>الأعمدة المطلوبة</small>
                  </div>
                </div>

                <div class="columns-area">

                  <label class="check-card active">
                    <input
                      type="checkbox"
                      value="*"
                      checked
                      class="column-check"
                    />
                    <span>
                      <i class="fa-solid fa-asterisk"></i>
                      جميع الأعمدة
                    </span>
                  </label>

                  <label class="check-card">
                    <input
                      type="checkbox"
                      value="id"
                      class="column-check"
                    />
                    <span>
                      <i class="fa-solid fa-hashtag"></i>
                      id
                    </span>
                  </label>

                  <label class="check-card">
                    <input
                      type="checkbox"
                      value="name"
                      class="column-check"
                    />
                    <span>
                      <i class="fa-solid fa-user"></i>
                      name
                    </span>
                  </label>

                  <label class="check-card">
                    <input
                      type="checkbox"
                      value="email"
                      class="column-check"
                    />
                    <span>
                      <i class="fa-solid fa-envelope"></i>
                      email
                    </span>
                  </label>

                  <label class="check-card">
                    <input
                      type="checkbox"
                      value="status"
                      class="column-check"
                    />
                    <span>
                      <i class="fa-solid fa-toggle-on"></i>
                      status
                    </span>
                  </label>

                  <label class="check-card">
                    <input
                      type="checkbox"
                      value="created_at"
                      class="column-check"
                    />
                    <span>
                      <i class="fa-regular fa-calendar"></i>
                      created_at
                    </span>
                  </label>

                </div>

                <div class="custom-column">
                  <label for="customColumn">إضافة عمود مخصص</label>

                  <div class="custom-row">
                    <input
                      id="customColumn"
                      type="text"
                      placeholder="مثال: phone"
                    />

                    <button id="addColumnBtn" class="small-add">
                      <i class="fa-solid fa-plus"></i>
                    </button>
                  </div>
                </div>

              </div>

              <!-- WHERE -->
              <div class="builder-section">

                <div class="section-title">

                  <div class="section-icon orange">
                    <i class="fa-solid fa-filter"></i>
                  </div>

                  <div>
                    <strong>WHERE</strong>
                    <small>شروط الاستعلام</small>
                  </div>

                </div>

                <div id="conditionsContainer" class="conditions">

                  <div class="condition-row">

                    <select class="condition-column">
                      <option value="status">status</option>
                      <option value="id">id</option>
                      <option value="name">name</option>
                      <option value="email">email</option>
                      <option value="created_at">created_at</option>
                    </select>

                    <select class="condition-operator">
                      <option value="=">=</option>
                      <option value="!=">!=</option>
                      <option value=">">&gt;</option>
                      <option value="<">&lt;</option>
                      <option value=">=">&gt;=</option>
                      <option value="<=">&lt;=</option>
                      <option value="LIKE">LIKE</option>
                      <option value="NOT LIKE">NOT LIKE</option>
                    </select>

                    <input
                      class="condition-value"
                      type="text"
                      value="active"
                      placeholder="القيمة"
                    />

                    <button class="remove-condition" title="حذف">
                      <i class="fa-solid fa-xmark"></i>
                    </button>

                  </div>

                </div>

                <button id="addConditionBtn" class="add-row">
                  <i class="fa-solid fa-plus"></i>
                  إضافة شرط
                </button>

              </div>

              <!-- JOIN -->
              <div class="builder-section">

                <div class="section-title">

                  <div class="section-icon cyan">
                    <i class="fa-solid fa-link"></i>
                  </div>

                  <div>
                    <strong>JOIN</strong>
                    <small>ربط الجداول</small>
                  </div>

                </div>

                <div id="joinsContainer" class="joins">

                  <div class="join-row">

                    <select class="join-type">
                      <option value="INNER JOIN">INNER JOIN</option>
                      <option value="LEFT JOIN">LEFT JOIN</option>
                      <option value="RIGHT JOIN">RIGHT JOIN</option>
                      <option value="FULL JOIN">FULL JOIN</option>
                    </select>

                    <input
                      class="join-table"
                      value=""
                      placeholder="اسم الجدول"
                    />

                    <span class="join-equals">ON</span>

                    <input
                      class="join-left"
                      value=""
                      placeholder="users.id"
                    />

                    <span class="join-equals">=</span>

                    <input
                      class="join-right"
                      value=""
                      placeholder="orders.user_id"
                    />

                    <button class="remove-join">
                      <i class="fa-solid fa-xmark"></i>
                    </button>

                  </div>

                </div>

                <button id="addJoinBtn" class="add-row">
                  <i class="fa-solid fa-plus"></i>
                  إضافة JOIN
                </button>

              </div>

              <!-- ORDER -->
              <div class="advanced-grid">

                <div class="builder-section compact">

                  <div class="section-title">

                    <div class="section-icon green">
                      <i class="fa-solid fa-arrow-down-a-z"></i>
                    </div>

                    <div>
                      <strong>ORDER BY</strong>
                      <small>ترتيب النتائج</small>
                    </div>

                  </div>

                  <div class="order-controls">

                    <select id="orderColumn">
                      <option value="">بدون ترتيب</option>
                      <option value="id">id</option>
                      <option value="name">name</option>
                      <option value="email">email</option>
                      <option value="created_at">created_at</option>
                    </select>

                    <select id="orderDirection">
                      <option value="ASC">ASC</option>
                      <option value="DESC">DESC</option>
                    </select>

                  </div>

                </div>

                <div class="builder-section compact">

                  <div class="section-title">

                    <div class="section-icon red">
                      <i class="fa-solid fa-list-ol"></i>
                    </div>

                    <div>
                      <strong>LIMIT</strong>
                      <small>عدد النتائج</small>
                    </div>

                  </div>

                  <input
                    id="limitValue"
                    class="limit-input"
                    type="number"
                    min="1"
                    placeholder="مثال: 50"
                  />

                </div>

              </div>

              <!-- SQL OUTPUT -->
              <div class="query-output">

                <div class="output-header">

                  <div>
                    <div class="output-title">
                      <span class="output-dot"></span>

                      <div>
                        <strong>Generated SQL</strong>
                        <small>الاستعلام الناتج</small>
                      </div>
                    </div>
                  </div>

                  <span class="sql-badge">
                    SQL
                  </span>

                </div>

                <div class="sql-editor">

                  <textarea
                    id="sqlOutput"
                    readonly
                    spellcheck="false"
                    placeholder="سيظهر استعلام SQL هنا..."
                  ></textarea>

                </div>

              </div>

            </div>

            <!-- FOOTER STATS -->
            <div class="builder-stats">

              <div class="stat">
                <div class="stat-icon purple-stat">
                  <i class="fa-solid fa-database"></i>
                </div>

                <div>
                  <strong id="tableStat">users</strong>
                  <span>الجدول</span>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon blue-stat">
                  <i class="fa-solid fa-table-columns"></i>
                </div>

                <div>
                  <strong id="columnStat">1</strong>
                  <span>الأعمدة</span>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon orange-stat">
                  <i class="fa-solid fa-filter"></i>
                </div>

                <div>
                  <strong id="conditionStat">1</strong>
                  <span>الشروط</span>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon green-stat">
                  <i class="fa-solid fa-code"></i>
                </div>

                <div>
                  <strong id="queryLength">0</strong>
                  <span>حرف SQL</span>
                </div>
              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">

          <div class="section-heading">
            <span>SQL QUERY BUILDER</span>

            <h2>
              أنشئ استعلامات SQL بسهولة
            </h2>

            <p>
              طريقة مرئية ومنظمة لبناء الاستعلامات بدون كتابة كل التفاصيل
              يدوياً.
            </p>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-icon purple-icon">
                <i class="fa-solid fa-diagram-project"></i>
              </div>

              <h3>بناء بصري</h3>

              <p>
                اختر الجدول والأعمدة والشروط من واجهة سهلة الاستخدام.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon blue-icon">
                <i class="fa-solid fa-filter"></i>
              </div>

              <h3>شروط متعددة</h3>

              <p>
                أضف شروط WHERE متعددة لإنشاء استعلامات أكثر دقة.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon green-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3>خصوصية كاملة</h3>

              <p>
                جميع العمليات تتم داخل المتصفح ولا يتم إرسال بياناتك إلى
                الخادم.
              </p>
            </article>

          </div>

        </div>
      </section>

      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-heading">
            <span>طريقة الاستخدام</span>

            <h2>
              كيف تستخدم SQL Query Builder؟
            </h2>

            <p>
              أنشئ استعلامك في ثلاث خطوات بسيطة.
            </p>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>

              <div class="step-icon">
                <i class="fa-solid fa-table"></i>
              </div>

              <h3>اختر الجدول</h3>

              <p>
                أدخل اسم الجدول واختر الأعمدة التي تريد استخدامها.
              </p>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div class="step-icon">
                <i class="fa-solid fa-filter"></i>
              </div>

              <h3>أضف الشروط</h3>

              <p>
                أضف WHERE وJOIN وORDER BY وLIMIT حسب حاجتك.
              </p>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div class="step-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>ولّد SQL</h3>

              <p>
                اضغط توليد SQL ثم انسخ الاستعلام الناتج.
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-heading">
            <span>FAQ</span>

            <h2>
              الأسئلة الشائعة
            </h2>

            <p>
              كل ما تحتاج معرفته عن SQL Query Builder.
            </p>
          </div>

          <div class="faq-list">

            {faqs.map((faq) => (
              <details class="faq-item">
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}

          </div>

        </div>
      </section>

    









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/sql-formatter/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="7" ry="3"/>
        <path d="M5 5v7c0 2 3 3 7 3s7-1 7-3V5"/>
        <path d="M5 12v7c0 2 3 3 7 3s7-1 7-3v-7"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Sql Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/sql-minifier/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="7" ry="3"/>
        <path d="M5 5v7c0 2 3 3 7 3s7-1 7-3V5"/>
        <path d="M5 12v7c0 2 3 3 7 3s7-1 7-3v-7"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Sql Minifier</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/sql-validator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="7" ry="3"/>
        <path d="M5 5v7c0 2 3 3 7 3s7-1 7-3V5"/>
        <path d="M5 12v7c0 2 3 3 7 3s7-1 7-3v-7"/>
      </svg>
          </span>

          <span class="related-tool-content">
