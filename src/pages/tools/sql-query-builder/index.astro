<script is:inline>
  (() => {
    const tableName = document.getElementById("tableName");
    const sqlOutput = document.getElementById("sqlOutput");

    const generateBtn = document.getElementById("generateBtn");
    const clearBtn = document.getElementById("clearBtn");
    const copyBtn = document.getElementById("copyBtn");
    const exampleBtn = document.getElementById("exampleBtn");

    const addConditionBtn =
      document.getElementById("addConditionBtn");

    const addJoinBtn =
      document.getElementById("addJoinBtn");

    const addColumnBtn =
      document.getElementById("addColumnBtn");

    const customColumn =
      document.getElementById("customColumn");

    const conditionsContainer =
      document.getElementById("conditionsContainer");

    const joinsContainer =
      document.getElementById("joinsContainer");

    const orderColumn =
      document.getElementById("orderColumn");

    const orderDirection =
      document.getElementById("orderDirection");

    const limitValue =
      document.getElementById("limitValue");

    const statusText =
      document.getElementById("statusText");

    const tableStat =
      document.getElementById("tableStat");

    const columnStat =
      document.getElementById("columnStat");

    const conditionStat =
      document.getElementById("conditionStat");

    const queryLength =
      document.getElementById("queryLength");

    const example = {
      table: "users",
      conditions: [
        {
          column: "status",
          operator: "=",
          value: "active"
        }
      ],
      order: "created_at",
      direction: "DESC",
      limit: "50"
    };

    function setStatus(text, type = "ready") {
      statusText.textContent = text;

      const dot =
        document.querySelector(".status-dot");

      if (!dot) return;

      dot.classList.remove(
        "success",
        "error",
        "processing"
      );

      if (type === "success") {
        dot.classList.add("success");
      }

      if (type === "error") {
        dot.classList.add("error");
      }

      if (type === "processing") {
        dot.classList.add("processing");
      }
    }

    function escapeIdentifier(value) {
      return value
        .trim()
        .replace(/[^a-zA-Z0-9_$.-]/g, "");
    }

    function escapeSQLValue(value) {
      const trimmed = value.trim();

      if (
        /^null$/i.test(trimmed) ||
        /^true$/i.test(trimmed) ||
        /^false$/i.test(trimmed) ||
        /^-?\d+(\.\d+)?$/.test(trimmed)
      ) {
        return trimmed;
      }

      return `'${trimmed.replace(/'/g, "''")}'`;
    }

    function getColumns() {
      return Array.from(
        document.querySelectorAll(".column-check:checked")
      ).map((checkbox) => checkbox.value);
    }

    function updateActiveColumnCards() {
      document
        .querySelectorAll(".check-card")
        .forEach((card) => {
          const checkbox =
            card.querySelector("input");

          if (checkbox.checked) {
            card.classList.add("active");
          } else {
            card.classList.remove("active");
          }
        });
    }

    function getConditions() {
      return Array.from(
        document.querySelectorAll(".condition-row")
      )
        .map((row) => ({
          column:
            row.querySelector(".condition-column")?.value || "",
          operator:
            row.querySelector(".condition-operator")?.value || "=",
          value:
            row.querySelector(".condition-value")?.value || ""
        }))
        .filter(
          (item) =>
            item.column &&
            item.value.trim()
        );
    }

    function getJoins() {
      return Array.from(
        document.querySelectorAll(".join-row")
      )
        .map((row) => ({
          type:
            row.querySelector(".join-type")?.value || "INNER JOIN",

          table:
            row.querySelector(".join-table")?.value.trim() || "",

          left:
            row.querySelector(".join-left")?.value.trim() || "",

          right:
            row.querySelector(".join-right")?.value.trim() || ""
        }))
        .filter(
          (join) =>
            join.table &&
            join.left &&
            join.right
        );
    }

    function buildQuery() {
      const table =
        escapeIdentifier(tableName.value) || "users";

      const columns = getColumns();

      let selectedColumns;

      if (
        columns.length === 0 ||
        columns.includes("*")
      ) {
        selectedColumns = "*";
      } else {
        selectedColumns = columns
          .map(escapeIdentifier)
          .filter(Boolean)
          .join(", ");
      }

      let query =
        `SELECT ${selectedColumns} FROM ${table}`;

      const joins = getJoins();

      joins.forEach((join) => {
        const joinTable =
          escapeIdentifier(join.table);

        const left =
          escapeIdentifier(join.left);

        const right =
          escapeIdentifier(join.right);

        if (
          joinTable &&
          left &&
          right
        ) {
          query +=
            ` ${join.type} ${joinTable} ON ${left} = ${right}`;
        }
      });

      const conditions = getConditions();

      if (conditions.length) {
        const where = conditions
          .map((condition) => {
            const column =
              escapeIdentifier(condition.column);

            const operator =
              condition.operator;

            let value;

            if (
              operator === "LIKE" ||
              operator === "NOT LIKE"
            ) {
              value = escapeSQLValue(
                condition.value
              );
            } else {
              value = escapeSQLValue(
                condition.value
              );
            }

            return `${column} ${operator} ${value}`;
          })
          .filter(Boolean);

        if (where.length) {
          query +=
            ` WHERE ${where.join(" AND ")}`;
        }
      }

      const selectedOrder =
        escapeIdentifier(orderColumn.value);

      if (selectedOrder) {
        const direction =
          orderDirection.value === "DESC"
            ? "DESC"
            : "ASC";

        query +=
          ` ORDER BY ${selectedOrder} ${direction}`;
      }

      const limit =
        parseInt(limitValue.value, 10);

      if (
        Number.isFinite(limit) &&
        limit > 0
      ) {
        query += ` LIMIT ${limit}`;
      }

      query += ";";

      return query;
    }

    function updateStats() {
      const columns = getColumns();

      const effectiveColumns =
        columns.length === 0 ||
        columns.includes("*")
          ? 1
          : columns.length;

      const conditions =
        document.querySelectorAll(
          ".condition-row"
        ).length;

      tableStat.textContent =
        escapeIdentifier(tableName.value) ||
        "users";

      columnStat.textContent =
        effectiveColumns;

      conditionStat.textContent =
        conditions;

      queryLength.textContent =
        sqlOutput.value.length;

      updateActiveColumnCards();
    }

    function generate() {
      const table =
        escapeIdentifier(tableName.value);

      if (!table) {
        setStatus("أدخل اسم الجدول", "error");
        return;
      }

      setStatus("جارٍ التوليد...", "processing");

      setTimeout(() => {
        const query = buildQuery();

        sqlOutput.value = query;

        updateStats();

        setStatus("تم التوليد", "success");
      }, 80);
    }

    function createConditionRow(
      column = "status",
      operator = "=",
      value = ""
    ) {
      const row =
        document.createElement("div");

      row.className = "condition-row";

      row.innerHTML = `
        <select class="condition-column">
          <option value="status">status</option>
          <option value="id">id</option>
          <option value="name">name</option>
          <option value="email">email</option>
          <option value="created_at">created_at</option>
        </select>

        <select class="condition-operator">
          <option value="=">=</option>
          <option value="!=">!=</option>
          <option value=">">&gt;</option>
          <option value="<">&lt;</option>
          <option value=">=">&gt;=</option>
          <option value="<=">&lt;=</option>
          <option value="LIKE">LIKE</option>
          <option value="NOT LIKE">NOT LIKE</option>
        </select>

        <input
          class="condition-value"
          type="text"
          placeholder="القيمة"
        />

        <button class="remove-condition" title="حذف">
          <i class="fa-solid fa-xmark"></i>
        </button>
      `;

      row.querySelector(".condition-column").value =
        column;

      row.querySelector(".condition-operator").value =
        operator;

      row.querySelector(".condition-value").value =
        value;

      conditionsContainer.appendChild(row);

      attachConditionEvents(row);

      updateStats();
    }

    function attachConditionEvents(row) {
      const remove =
        row.querySelector(".remove-condition");

      remove.addEventListener("click", () => {
        const rows =
          conditionsContainer.querySelectorAll(
            ".condition-row"
          );

        if (rows.length === 1) {
          row.querySelector(".condition-value").value = "";
        } else {
          row.remove();
        }

        updateStats();
      });

      row
        .querySelectorAll("input, select")
        .forEach((element) => {
          element.addEventListener(
            "input",
            updateStats
          );

          element.addEventListener(
            "change",
            updateStats
          );
        });
    }

    function createJoinRow() {
      const row =
        document.createElement("div");

      row.className = "join-row";

      row.innerHTML = `
        <select class="join-type">
          <option value="INNER JOIN">INNER JOIN</option>
          <option value="LEFT JOIN">LEFT JOIN</option>
          <option value="RIGHT JOIN">RIGHT JOIN</option>
          <option value="FULL JOIN">FULL JOIN</option>
        </select>

        <input
          class="join-table"
          placeholder="اسم الجدول"
        />

        <span class="join-equals">ON</span>

        <input
          class="join-left"
          placeholder="users.id"
        />

        <span class="join-equals">=</span>

        <input
          class="join-right"
          placeholder="orders.user_id"
        />

        <button class="remove-join">
          <i class="fa-solid fa-xmark"></i>
        </button>
      `;

      joinsContainer.appendChild(row);

      row
        .querySelector(".remove-join")
        .addEventListener("click", () => {
          row.remove();
        });
    }

    function addCustomColumn() {
      const value =
        customColumn.value.trim();

      if (!value) return;

      const clean =
        escapeIdentifier(value);

      if (!clean) return;

      const exists =
        Array.from(
          document.querySelectorAll(
            ".column-check"
          )
        ).some(
          (checkbox) =>
            checkbox.value === clean
        );

      if (exists) {
        customColumn.value = "";
        return;
      }

      const card =
        document.createElement("label");

      card.className =
        "check-card active custom-added";

      card.innerHTML = `
        <input
          type="checkbox"
          value="${clean}"
          class="column-check"
          checked
        />

        <span>
          <i class="fa-solid fa-code"></i>
          ${clean}
        </span>
      `;

      document
        .querySelector(".columns-area")
        .appendChild(card);

      const checkbox =
        card.querySelector("input");

      checkbox.addEventListener(
        "change",
        updateStats
      );

      customColumn.value = "";

      updateStats();
    }

    function clearAll() {
      tableName.value = "users";

      document
        .querySelectorAll(".column-check")
        .forEach((checkbox) => {
          checkbox.checked =
            checkbox.value === "*";
        });

      conditionsContainer.innerHTML = "";

      createConditionRow(
        "status",
        "=",
        "active"
      );

      joinsContainer.innerHTML = "";

      orderColumn.value = "";
      orderDirection.value = "ASC";
      limitValue.value = "";

      sqlOutput.value = "";

      updateStats();

      setStatus("تم المسح", "ready");
    }

    function loadExample() {
      tableName.value =
        example.table;

      document
        .querySelectorAll(".column-check")
        .forEach((checkbox) => {
          checkbox.checked =
            checkbox.value === "*";
        });

      conditionsContainer.innerHTML = "";

      createConditionRow(
        example.conditions[0].column,
        example.conditions[0].operator,
        example.conditions[0].value
      );

      joinsContainer.innerHTML = "";

      orderColumn.value =
        example.order;

      orderDirection.value =
        example.direction;

      limitValue.value =
        example.limit;

      generate();
    }

    async function copySQL() {
      if (!sqlOutput.value) {
        generate();
      }

      if (!sqlOutput.value) {
        setStatus("لا يوجد SQL", "error");
        return;
      }

      try {
        await navigator.clipboard.writeText(
          sqlOutput.value
        );

        const oldHTML =
          copyBtn.innerHTML;

        copyBtn.innerHTML =
          `<i class="fa-solid fa-check"></i> تم النسخ`;

        setStatus("تم النسخ", "success");

        setTimeout(() => {
          copyBtn.innerHTML =
            oldHTML;

          setStatus(
            "جاهز",
            "ready"
          );
        }, 1500);

      } catch {
        sqlOutput.select();

        document.execCommand("copy");

        setStatus(
          "تم النسخ",
          "success"
        );
      }
    }

    document
      .querySelectorAll(".column-check")
      .forEach((checkbox) => {
        checkbox.addEventListener(
          "change",
          () => {
            const all =
              document.querySelector(
                '.column-check[value="*"]'
              );

            if (
              checkbox.value === "*" &&
              checkbox.checked
            ) {
              document
                .querySelectorAll(
                  ".column-check"
                )
                .forEach((item) => {
                  if (item !== all) {
                    item.checked = false;
                  }
                });
            }

            if (
              checkbox.value !== "*" &&
              checkbox.checked &&
              all
            ) {
              all.checked = false;
            }

            if (
              !document.querySelector(
                ".column-check:checked"
              )
            ) {
              if (all) {
                all.checked = true;
              }
            }

            updateStats();
          }
        );
      });

    tableName.addEventListener(
      "input",
      updateStats
    );

    orderColumn.addEventListener(
      "change",
      updateStats
    );

    limitValue.addEventListener(
      "input",
      updateStats
    );

    generateBtn.addEventListener(
      "click",
      generate
    );

    clearBtn.addEventListener(
      "click",
      clearAll
    );

    exampleBtn.addEventListener(
      "click",
      loadExample
    );

    copyBtn.addEventListener(
      "click",
      copySQL
    );

    addConditionBtn.addEventListener(
      "click",
      () => {
        createConditionRow();
      }
    );

    addJoinBtn.addEventListener(
      "click",
      createJoinRow
    );

    addColumnBtn.addEventListener(
      "click",
      addCustomColumn
    );

    customColumn.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          addCustomColumn();
        }
      }
    );

    document
      .querySelectorAll(".condition-row")
      .forEach(attachConditionEvents);

    document
      .querySelectorAll(".remove-join")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            button
              .closest(".join-row")
              ?.remove();
          }
        );
      });

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {
          event.preventDefault();
          generate();
        }
      }
    );

    updateStats();
    generate();
  })();
</script>

