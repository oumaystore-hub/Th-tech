---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Remove Duplicate - إزالة التكرارات أونلاين مجاناً | Th.Tech";

const description =
  "أداة Remove Duplicate مجانية لإزالة الأسطر والعناصر المكررة بسرعة مع الحفاظ على الترتيب. تعمل محلياً داخل المتصفح.";

const canonical = "https://oumaystore-hub.github.io" + base + "/tools/remove-duplicate/";
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="tool-page">

      <!-- Breadcrumb -->
      <div class="container">
        <nav class="breadcrumb" aria-label="مسار الصفحة">
          <a href={base + "/"}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={base + "/tools/"}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>Remove Duplicate</span>
        </nav>
      </div>

      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-card">

            <div class="hero-icon">
              <i class="fa-solid fa-clone"></i>
            </div>

            <div class="hero-content">
              <div class="eyebrow">
                <span class="dot"></span>
                Text Tools
              </div>

              <h1>Remove Duplicate</h1>

              <p>
                إزالة الأسطر والعناصر المكررة بسرعة مع الحفاظ على ترتيب البيانات.
              </p>

              <div class="tags">
                <span>Duplicate</span>
                <span>Text</span>
                <span>Clean</span>
                <span>Local</span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Tool -->
      <section class="tool-section">
        <div class="container">

          <div class="tool-card">

            <!-- Toolbar -->
            <div class="toolbar">

              <div class="toolbar-group">
                <label for="mode">
                  <i class="fa-solid fa-list"></i>
                  نوع البيانات
                </label>

                <select id="mode">
                  <option value="lines">أسطر</option>
                  <option value="commas">عناصر مفصولة بفواصل</option>
                  <option value="tabs">عناصر مفصولة بعلامة Tab</option>
                </select>
              </div>

              <div class="toolbar-group options-group">

                <label class="check-option">
                  <input type="checkbox" id="ignoreCase" />
                  <span class="custom-check"></span>
                  تجاهل حالة الأحرف
                </label>

                <label class="check-option">
                  <input type="checkbox" id="trimSpaces" checked />
                  <span class="custom-check"></span>
                  تجاهل المسافات الزائدة
                </label>

                <label class="check-option">
                  <input type="checkbox" id="removeEmpty" checked />
                  <span class="custom-check"></span>
                  إزالة العناصر الفارغة
                </label>

              </div>

            </div>

            <!-- Editors -->
            <div class="editors">

              <!-- Input -->
              <div class="editor-box">

                <div class="editor-header">
                  <div class="editor-title">
                    <span class="editor-icon input-icon">
                      <i class="fa-solid fa-file-lines"></i>
                    </span>

                    <div>
                      <strong>النص الأصلي</strong>
                      <small id="inputLabel">أدخل البيانات هنا</small>
                    </div>
                  </div>

                  <span class="counter" id="inputCount">0 عنصر</span>
                </div>

                <textarea
                  id="inputText"
                  dir="auto"
                  spellcheck="false"
                  placeholder="الصق النص أو قائمة العناصر هنا...

مثال:
Apple
Banana
Apple
Orange
Banana
Apple"
                ></textarea>

              </div>

              <!-- Arrow -->
              <div class="process-arrow">
                <div>
                  <i class="fa-solid fa-arrow-left"></i>
                </div>
              </div>

              <!-- Output -->
              <div class="editor-box output-box">

                <div class="editor-header">
                  <div class="editor-title">
                    <span class="editor-icon output-icon">
                      <i class="fa-solid fa-filter-circle-dollar"></i>
                    </span>

                    <div>
                      <strong>النتيجة</strong>
                      <small>بدون تكرارات</small>
                    </div>
                  </div>

                  <button class="mini-btn" id="copyOutput" type="button">
                    <i class="fa-regular fa-copy"></i>
                    نسخ
                  </button>
                </div>

                <textarea
                  id="outputText"
                  dir="auto"
                  spellcheck="false"
                  readonly
                  placeholder="ستظهر النتيجة هنا..."
                ></textarea>

              </div>

            </div>

            <!-- Actions -->
            <div class="actions">

              <div class="main-actions">

                <button class="btn primary" id="removeBtn" type="button">
                  <i class="fa-solid fa-filter-circle-dollar"></i>
                  إزالة التكرارات
                </button>

                <button class="btn secondary" id="sampleBtn" type="button">
                  <i class="fa-solid fa-flask"></i>
                  تجربة مثال
                </button>

              </div>

              <div class="utility-actions">

                <button class="btn utility" id="copyBtn" type="button">
                  <i class="fa-regular fa-copy"></i>
                  نسخ النتيجة
                </button>

                <button class="btn utility danger" id="clearBtn" type="button">
                  <i class="fa-solid fa-trash-can"></i>
                  مسح الكل
                </button>

              </div>

            </div>

            <!-- Status -->
            <div class="status" id="status">
              <i class="fa-solid fa-circle-info"></i>
              أدخل النص ثم اضغط على «إزالة التكرارات».
            </div>

            <!-- Stats -->
            <div class="stats">

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-list-ol"></i>
                </div>

                <div>
                  <span>العناصر الأصلية</span>
                  <strong id="originalStat">0</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-list-check"></i>
                </div>

                <div>
                  <span>العناصر الفريدة</span>
                  <strong id="uniqueStat">0</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-clone"></i>
                </div>

                <div>
                  <span>المكررات المحذوفة</span>
                  <strong id="duplicateStat">0</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-chart-line"></i>
                </div>

                <div>
                  <span>نسبة التخفيض</span>
                  <strong id="reductionStat">0%</strong>
                </div>
              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- Privacy -->
      <section class="container info-section">
        <div class="privacy-card">

          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>خصوصيتك أولاً</h3>
            <p>
              تتم معالجة النص بالكامل داخل متصفحك. لا يتم إرسال البيانات إلى أي
              خادم أو تخزينها على الموقع.
            </p>
          </div>

          <span class="local-badge">
            <i class="fa-solid fa-bolt"></i>
            معالجة محلية
          </span>

        </div>
      </section>

      <!-- Information -->
      <section class="container info-section">

        <div class="section-heading">
          <span>دليل الأداة</span>
          <h2>ما الذي يمكنك فعله باستخدام Remove Duplicate؟</h2>
          <p>
            نظّف القوائم والنصوص الكبيرة من التكرارات خلال ثوانٍ.
          </p>
        </div>

        <div class="info-grid">

          <article class="info-card">
            <div class="info-number">01</div>
            <div class="info-card-icon">
              <i class="fa-solid fa-broom"></i>
            </div>
            <h3>تنظيف القوائم</h3>
            <p>
              احذف العناصر المتكررة من القوائم مع الاحتفاظ بأول ظهور لكل عنصر.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">02</div>
            <div class="info-card-icon">
              <i class="fa-solid fa-arrow-down-a-z"></i>
            </div>
            <h3>الحفاظ على الترتيب</h3>
            <p>
              لا يتم إعادة ترتيب بياناتك؛ تبقى العناصر الفريدة بنفس ترتيب ظهورها.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">03</div>
            <div class="info-card-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>
            <h3>خيارات متقدمة</h3>
            <p>
              يمكنك تجاهل حالة الأحرف والمسافات الزائدة والعناصر الفارغة.
            </p>
          </article>

        </div>

      </section>

      <!-- How it works -->
      <section class="container steps-section">

        <div class="section-heading">
          <span>طريقة الاستخدام</span>
          <h2>إزالة التكرارات في 3 خطوات</h2>
        </div>

        <div class="steps">

          <div class="step">
            <div class="step-number">1</div>
            <div>
              <h3>أدخل البيانات</h3>
              <p>الصق النص أو القائمة التي تريد تنظيفها.</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <div>
              <h3>حدد الخيارات</h3>
              <p>اختر طريقة الفصل وخيارات مقارنة العناصر.</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <div>
              <h3>احذف التكرارات</h3>
              <p>اضغط على الزر لتحصل على قائمة نظيفة وفريدة.</p>
            </div>
          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="container faq-section">

        <div class="section-heading">
          <span>الأسئلة الشائعة</span>
          <h2>أسئلة حول إزالة التكرارات</h2>
        </div>

        <div class="faq-grid">

          <details>
            <summary>
              <span>هل تحافظ الأداة على ترتيب العناصر؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              نعم. تحتفظ الأداة بأول ظهور لكل عنصر وتحافظ على ترتيب العناصر
              الفريدة كما كانت في النص الأصلي.
            </p>
          </details>

          <details>
            <summary>
              <span>هل يمكن تجاهل اختلاف الأحرف؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              نعم. عند تفعيل خيار «تجاهل حالة الأحرف» سيتم اعتبار Apple و apple
              و APPLE عناصر متطابقة.
            </p>
          </details>

          <details>
            <summary>
              <span>هل يتم إرسال البيانات إلى الخادم؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              لا. تتم جميع عمليات المعالجة داخل المتصفح باستخدام JavaScript،
              لذلك لا تحتاج الأداة إلى رفع النص إلى خادم خارجي.
            </p>
          </details>

          <details>
            <summary>
              <span>ما الفرق بين العناصر الفريدة والمكررات؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              العناصر الفريدة هي العناصر التي تظهر مرة واحدة في النتيجة، بينما
              المكررات هي الظهورات الإضافية التي تم حذفها.
            </p>
          </details>

        </div>

      </section>

    </main>

    <Footer />

    <style>
      :root {
        --bg: #f5f8fc;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --text: #102033;
        --muted: #6b7b8f;
        --border: #e2eaf3;
        --primary: #2563eb;
        --primary-2: #06b6d4;
        --success: #10b981;
        --danger: #ef4444;
        --shadow: 0 18px 55px rgba(15, 35, 65, 0.08);
        --shadow-sm: 0 8px 25px rgba(15, 35, 65, 0.06);
      }

      html.dark-mode {
        --bg: #07111f;
        --surface: #0d1a2b;
        --surface-2: #101f32;
        --text: #e8f0fa;
        --muted: #91a3b8;
        --border: #1d3148;
        --primary: #4f8cff;
        --primary-2: #22d3ee;
        --success: #34d399;
        --danger: #fb7185;
        --shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
        --shadow-sm: 0 8px 25px rgba(0, 0, 0, 0.2);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at 10% 5%, rgba(37, 99, 235, 0.07), transparent 28%),
          radial-gradient(circle at 90% 15%, rgba(6, 182, 212, 0.06), transparent 25%),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        transition: background 0.25s ease, color 0.25s ease;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .tool-page {
        min-height: 100vh;
        padding-bottom: 70px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 24px 0 10px;
        color: var(--muted);
        font-size: 13px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: 0.65;
      }

      .hero {
        padding: 18px 0 30px;
      }

      .hero-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 34px;
        border: 1px solid var(--border);
        border-radius: 28px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .hero-card::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        left: -100px;
        top: -150px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.08);
        pointer-events: none;
      }

      .hero-icon {
        position: relative;
        flex: 0 0 88px;
        width: 88px;
        height: 88px;
        display: grid;
        place-items: center;
        border-radius: 24px;
        color: #fff;
        font-size: 34px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        box-shadow: 0 15px 35px rgba(37, 99, 235, 0.25);
      }

      .hero-content {
        position: relative;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
      }

      .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--primary);
      }

      h1 {
        margin: 0;
        font-size: clamp(27px, 4vw, 40px);
        line-height: 1.25;
        font-weight: 800;
      }

      .hero p {
        margin: 8px 0 14px;
        color: var(--muted);
        font-size: 15px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .tags span {
        padding: 5px 11px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        background: var(--surface-2);
        font-size: 11px;
        font-weight: 700;
      }

      .tool-section {
        padding: 8px 0 20px;
      }

      .tool-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 26px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .toolbar-group {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .toolbar-group > label:first-child {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      select {
        min-width: 190px;
        padding: 10px 13px;
        outline: none;
        border: 1px solid var(--border);
        border-radius: 11px;
        color: var(--text);
        background: var(--surface);
      }

      select:focus {
        border-color: var(--primary);
      }

      .options-group {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 14px;
      }

      .check-option {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
        user-select: none;
      }

      .check-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .custom-check {
        width: 17px;
        height: 17px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: var(--surface);
        transition: 0.2s ease;
      }

      .check-option input:checked + .custom-check {
        border-color: var(--primary);
        background: var(--primary);
      }

      .check-option input:checked + .custom-check::after {
        content: "✓";
        color: white;
        font-size: 11px;
        font-weight: 800;
      }

      .editors {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr);
        align-items: stretch;
        gap: 0;
        padding: 20px;
      }

      .editor-box {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface-2);
      }

      .editor-header {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 14px;
        border-bottom: 1px solid var(--border);
      }

      .editor-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
      }

      .editor-title > div {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .editor-title strong {
        font-size: 13px;
      }

      .editor-title small {
        color: var(--muted);
        font-size: 10px;
      }

      .editor-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
      }

      .input-icon {
        color: #2563eb;
        background: rgba(37, 99, 235, 0.1);
      }

      .output-icon {
        color: #10b981;
        background: rgba(16, 185, 129, 0.1);
      }

      .counter {
        flex-shrink: 0;
        padding: 5px 9px;
        border-radius: 8px;
        color: var(--muted);
        background: var(--surface);
        font-size: 10px;
        font-weight: 700;
      }

      textarea {
        display: block;
        width: 100%;
        min-height: 340px;
        padding: 18px;
        resize: vertical;
        outline: none;
        border: 0;
        color: var(--text);
        background: transparent;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.8;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: 0.7;
      }

      textarea:focus {
        background: rgba(37, 99, 235, 0.018);
      }

      .output-box textarea {
        background: rgba(16, 185, 129, 0.015);
      }

      .process-arrow {
        display: grid;
        place-items: center;
      }

      .process-arrow > div {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 50%;
        color: var(--primary);
        background: var(--surface);
        box-shadow: var(--shadow-sm);
      }

      .mini-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--muted);
        background: var(--surface);
        font-size: 11px;
        font-weight: 700;
      }

      .mini-btn:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 0 20px 20px;
      }

      .main-actions,
      .utility-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 16px;
        border-radius: 12px;
        border: 1px solid transparent;
        font-size: 12px;
        font-weight: 800;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn.primary {
        color: white;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
      }

      .btn.secondary {
        color: var(--primary);
        border-color: var(--border);
        background: var(--surface);
      }

      .btn.utility {
        color: var(--muted);
        border-color: var(--border);
        background: var(--surface);
      }

      .btn.utility:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .btn.danger:hover {
        color: var(--danger);
        border-color: rgba(239, 68, 68, 0.4);
      }

      .status {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 20px 20px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        color: var(--muted);
        background: var(--surface-2);
        font-size: 12px;
      }

      .status.success {
        color: var(--success);
        border-color: rgba(16, 185, 129, 0.22);
        background: rgba(16, 185, 129, 0.06);
      }

      .status.error {
        color: var(--danger);
        border-color: rgba(239, 68, 68, 0.22);
        background: rgba(239, 68, 68, 0.06);
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        border-top: 1px solid var(--border);
        background: var(--border);
      }

      .stat {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px;
        background: var(--surface);
      }

      .stat-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .stat:nth-child(2) .stat-icon {
        color: var(--success);
        background: rgba(16, 185, 129, 0.09);
      }

      .stat:nth-child(3) .stat-icon {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.1);
      }

      .stat:nth-child(4) .stat-icon {
        color: #8b5cf6;
        background: rgba(139, 92, 246, 0.1);
      }

      .stat div:last-child {
        display: flex;
        flex-direction: column;
      }

      .stat span {
        color: var(--muted);
        font-size: 10px;
      }

      .stat strong {
        margin-top: 1px;
        font-family: "JetBrains Mono", monospace;
        font-size: 19px;
      }

      .info-section,
      .steps-section,
      .faq-section {
        padding-top: 55px;
      }

      .privacy-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 1px solid rgba(37, 99, 235, 0.18);
        border-radius: 18px;
        background: rgba(37, 99, 235, 0.05);
      }

      .privacy-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.1);
        font-size: 19px;
      }

      .privacy-card h3 {
        margin: 0 0 2px;
        font-size: 14px;
      }

      .privacy-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .local-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-right: auto;
        padding: 7px 10px;
        border-radius: 9px;
        color: var(--success);
        background: rgba(16, 185, 129, 0.08);
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
      }

      .section-heading {
        margin-bottom: 22px;
      }

      .section-heading > span {
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
      }

      .section-heading h2 {
        margin: 4px 0 5px;
        font-size: clamp(20px, 3vw, 27px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .info-card {
        position: relative;
        overflow: hidden;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
      }

      .info-number {
        position: absolute;
        top: 17px;
        left: 20px;
        color: var(--border);
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
        font-weight: 700;
      }

      .info-card-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        margin-bottom: 15px;
        border-radius: 13px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-size: 14px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 21px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
      }

      .step-number {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        color: white;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        font-weight: 700;
      }

      .step h3 {
        margin: 0 0 4px;
        font-size: 13px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .faq-grid {
        display: grid;
        gap: 10px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
      }

      summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 18px;
        cursor: pointer;
        list-style: none;
        font-size: 12px;
        font-weight: 700;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: transform 0.2s ease;
      }

      details[open] summary i {
        transform: rotate(45deg);
      }

      details p {
        margin: 0;
        padding: 0 18px 18px;
        color: var(--muted);
        font-size: 11px;
        line-height: 2;
      }

      @media (max-width: 900px) {
        .toolbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .options-group {
          justify-content: flex-start;
        }

        .editors {
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .process-arrow {
          transform: rotate(-90deg);
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero-card {
          flex-direction: column;
          align-items: flex-start;
          padding: 24px;
          border-radius: 22px;
        }

        .hero-icon {
          width: 68px;
          height: 68px;
          flex-basis: 68px;
          border-radius: 19px;
          font-size: 27px;
        }

        .breadcrumb {
          padding-top: 17px;
          font-size: 11px;
        }

        .tool-card {
          border-radius: 20px;
        }

        .toolbar {
          padding: 14px;
        }

        .toolbar-group {
          width: 100%;
          align-items: flex-start;
          flex-direction: column;
        }

        select {
          width: 100%;
        }

        .options-group {
          flex-direction: row;
          align-items: center;
        }

        .editors {
          padding: 12px;
        }

        textarea {
          min-height: 260px;
          padding: 14px;
          font-size: 12px;
        }

        .actions {
          align-items: stretch;
          flex-direction: column;
          padding: 0 12px 14px;
        }

        .main-actions,
        .utility-actions {
          width: 100%;
        }

        .btn {
          flex: 1;
          padding: 10px 11px;
          font-size: 11px;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .stat {
          padding: 14px 11px;
          gap: 8px;
        }

        .stat-icon {
          width: 34px;
          height: 34px;
          flex-basis: 34px;
          font-size: 12px;
        }

        .stat strong {
          font-size: 16px;
        }

        .privacy-card {
          align-items: flex-start;
          flex-wrap: wrap;
        }

        .local-badge {
          margin-right: 0;
          width: 100%;
          justify-content: center;
        }

        .info-section,
        .steps-section,
        .faq-section {
          padding-top: 42px;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const input = document.getElementById("inputText");
        const output = document.getElementById("outputText");

        const mode = document.getElementById("mode");
        const ignoreCase = document.getElementById("ignoreCase");
        const trimSpaces = document.getElementById("trimSpaces");
        const removeEmpty = document.getElementById("removeEmpty");

        const removeBtn = document.getElementById("removeBtn");
        const sampleBtn = document.getElementById("sampleBtn");
        const copyBtn = document.getElementById("copyBtn");
        const copyOutput = document.getElementById("copyOutput");
        const clearBtn = document.getElementById("clearBtn");

        const status = document.getElementById("status");

        const inputCount = document.getElementById("inputCount");
        const originalStat = document.getElementById("originalStat");
        const uniqueStat = document.getElementById("uniqueStat");
        const duplicateStat = document.getElementById("duplicateStat");
        const reductionStat = document.getElementById("reductionStat");

        function syncTheme() {
          try {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function (event) {
          const target = event.target;

          if (
            target &&
            (
              target.id === "theme-btn" ||
              (target.closest && target.closest("#theme-btn"))
            )
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        function setStatus(message, type) {
          status.className = "status";

          if (type) {
            status.classList.add(type);
          }

          status.innerHTML =
            '<i class="fa-solid ' +
            (type === "success"
              ? "fa-circle-check"
              : type === "error"
                ? "fa-circle-exclamation"
                : "fa-circle-info") +
            '"></i>' +
            message;
        }

        function normalizeItem(value) {
          let result = value;

          if (trimSpaces.checked) {
            result = result.trim().replace(/\s+/g, " ");
          }

          if (ignoreCase.checked) {
            result = result.toLocaleLowerCase();
          }

          return result;
        }

        function parseInput(value) {
          const selectedMode = mode.value;

          if (selectedMode === "commas") {
            return value.split(",");
          }

          if (selectedMode === "tabs") {
            return value.split("\t");
          }

          return value.split(/\r?\n/);
        }

        function buildOutput(items) {
          const selectedMode = mode.value;

          if (selectedMode === "commas") {
            return items.join(", ");
          }

          if (selectedMode === "tabs") {
            return items.join("\t");
          }

          return items.join("\n");
        }

        function updateInputCount() {
          const value = input.value;

          if (!value.trim()) {
            inputCount.textContent = "0 عنصر";
            return;
          }

          const items = parseInput(value);

          let count = items.length;

          if (removeEmpty.checked) {
            count = items.filter(function (item) {
              return item.trim() !== "";
            }).length;
          }

          inputCount.textContent = count + " عنصر";
        }

        function removeDuplicates() {
          const raw = input.value;

          if (!raw.trim()) {
            output.value = "";
            originalStat.textContent = "0";
            uniqueStat.textContent = "0";
            duplicateStat.textContent = "0";
            reductionStat.textContent = "0%";

            setStatus("أدخل نصاً أو قائمة عناصر أولاً.", "error");
            updateInputCount();
            return;
          }

          let items = parseInput(raw);

          if (removeEmpty.checked) {
            items = items.filter(function (item) {
              return item.trim() !== "";
            });
          }

          const originalCount = items.length;
          const seen = new Set();
          const uniqueItems = [];

          items.forEach(function (item) {
            const comparison = normalizeItem(item);

            if (!comparison && removeEmpty.checked) {
              return;
            }

            if (!seen.has(comparison)) {
              seen.add(comparison);
              uniqueItems.push(
                trimSpaces.checked ? item.trim().replace(/\s+/g, " ") : item
              );
            }
          });

          const uniqueCount = uniqueItems.length;
          const duplicateCount = Math.max(0, originalCount - uniqueCount);

          const reduction =
            originalCount > 0
              ? Math.round((duplicateCount / originalCount) * 100)
              : 0;

          output.value = buildOutput(uniqueItems);

          originalStat.textContent = String(originalCount);
          uniqueStat.textContent = String(uniqueCount);
          duplicateStat.textContent = String(duplicateCount);
          reductionStat.textContent = String(reduction) + "%";

          if (duplicateCount === 0) {
            setStatus(
              "لم يتم العثور على عناصر مكررة. البيانات بالفعل فريدة.",
              "success"
            );
          } else {
            setStatus(
              "تم حذف " +
              duplicateCount +
              " عنصر مكرر بنجاح.",
              "success"
            );
          }

          updateInputCount();
        }

        async function copyResult() {
          const value = output.value;

          if (!value) {
            setStatus("لا توجد نتيجة لنسخها.", "error");
            return;
          }

          try {
            await navigator.clipboard.writeText(value);
            setStatus("تم نسخ النتيجة إلى الحافظة.", "success");
          } catch {
            output.select();
            document.execCommand("copy");
            setStatus("تم نسخ النتيجة.", "success");
          }
        }

        function loadSample() {
          if (mode.value === "commas") {
            input.value =
              "Apple, Banana, Apple, Orange, Banana, Mango, Apple, Orange";
          } else if (mode.value === "tabs") {
            input.value =
              "Apple\tBanana\tApple\tOrange\tBanana\tMango\tApple";
          } else {
            input.value =
              "Apple\nBanana\nApple\nOrange\nBanana\nMango\nApple\nOrange\nKiwi\nBanana";
          }

          removeDuplicates();
          setStatus("تم تحميل مثال وتجهيز النتيجة.", "success");
        }

        function clearAll() {
          input.value = "";
          output.value = "";

          originalStat.textContent = "0";
          uniqueStat.textContent = "0";
          duplicateStat.textContent = "0";
          reductionStat.textContent = "0%";

          updateInputCount();
          setStatus("تم مسح جميع البيانات.", "");
          input.focus();
        }

        input.addEventListener("input", updateInputCount);

        mode.addEventListener("change", updateInputCount);

        removeEmpty.addEventListener("change", updateInputCount);

        removeBtn.addEventListener("click", removeDuplicates);

        sampleBtn.addEventListener("click", loadSample);

        copyBtn.addEventListener("click", copyResult);

        copyOutput.addEventListener("click", copyResult);

        clearBtn.addEventListener("click", clearAll);

        input.addEventListener("keydown", function (event) {
          if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
            event.preventDefault();
            removeDuplicates();
          }
        });

        updateInputCount();
      })();
    </script>
  </body>
</html>
