  <script is:inline>
    (() => {
      const pattern = document.getElementById("pattern");
      const testString = document.getElementById("testString");

      const flagG = document.getElementById("flagG");
      const flagI = document.getElementById("flagI");
      const flagM = document.getElementById("flagM");
      const flagS = document.getElementById("flagS");

      const regexPreview = document.getElementById("regexPreview");
      const textLength = document.getElementById("textLength");
      const lineCount = document.getElementById("lineCount");

      const testBtn = document.getElementById("testBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const status = document.getElementById("status");

      const matches = document.getElementById("matches");
      const matchCount = document.getElementById("matchCount");

      const groupsBox = document.getElementById("groupsBox");
      const groups = document.getElementById("groups");

      const replaceFrom = document.getElementById("replaceFrom");
      const replaceWith = document.getElementById("replaceWith");
      const replaceOutput = document.getElementById("replaceOutput");

      const statMatches = document.getElementById("statMatches");
      const statGroups = document.getElementById("statGroups");
      const statChars = document.getElementById("statChars");
      const statLines = document.getElementById("statLines");

      function getFlags() {
        let flags = "";

        if (flagG.checked) flags += "g";
        if (flagI.checked) flags += "i";
        if (flagM.checked) flags += "m";
        if (flagS.checked) flags += "s";

        return flags;
      }

      function setStatus(type, message) {
        status.className = "status";

        if (type === "success") {
          status.classList.add("success");
        }

        if (type === "error") {
          status.classList.add("error");
        }

        if (type === "warning") {
          status.classList.add("warning");
        }

        const icon = status.querySelector("i");
        const text = status.querySelector("span");

        if (type === "success") {
          icon.className = "fa-solid fa-circle-check";
        } else if (type === "error") {
          icon.className = "fa-solid fa-circle-exclamation";
        } else if (type === "warning") {
          icon.className = "fa-solid fa-triangle-exclamation";
        } else {
          icon.className = "fa-solid fa-circle-info";
        }

        text.textContent = message;
      }

      function updateTextStats() {
        const text = testString.value;

        textLength.textContent =
          `${text.length.toLocaleString("ar")} حرف`;

        const lines = text ? text.split(/\r?\n/u).length : 0;

        lineCount.textContent =
          `${lines.toLocaleString("ar")} سطر`;

        statChars.textContent =
          text.length.toLocaleString("ar");

        statLines.textContent =
          lines.toLocaleString("ar");
      }

      function updatePreview() {
        const source = pattern.value;

        if (!source) {
          regexPreview.textContent = "/pattern/";
          return;
        }

        regexPreview.textContent =
          `/${source}/${getFlags()}`;
      }

      function clearResults() {
        matches.innerHTML =
          '<span class="empty-matches">لا توجد نتائج بعد.</span>';

        matchCount.textContent = "0";

        groups.innerHTML = "";
        groupsBox.hidden = true;

        replaceOutput.value = "";

        statMatches.textContent = "0";
        statGroups.textContent = "0";
      }

      function createRegex() {
        return new RegExp(pattern.value, getFlags());
      }

      function runTest() {
        updatePreview();
        updateTextStats();

        const source = pattern.value;

        if (!source) {
          clearResults();
          setStatus("info", "أدخل Regex Pattern لبدء الاختبار.");
          return;
        }

        try {
          const regex = createRegex();
          const text = testString.value;

          clearResults();

          if (!text) {
            setStatus(
              "warning",
              "تم إنشاء Regex بنجاح. أضف نصًا للاختبار."
            );
            return;
          }

          const found = [];

          if (regex.global) {
            let match;

            while ((match = regex.exec(text)) !== null) {
              found.push(match);

              if (match[0] === "") {
                regex.lastIndex++;
              }
            }
          } else {
            const single = regex.exec(text);

            if (single) {
              found.push(single);
            }
          }

          matchCount.textContent =
            found.length.toLocaleString("ar");

          statMatches.textContent =
            found.length.toLocaleString("ar");

          if (found.length === 0) {
            matches.innerHTML =
              '<span class="empty-matches">لم يتم العثور على أي تطابق.</span>';

            setStatus(
              "warning",
              "Regex صالح، لكن لم يتم العثور على تطابق في النص."
            );

            updateReplace(regex);
            return;
          }

          found.forEach((match) => {
            const item = document.createElement("span");

            item.className = "match";
            item.textContent =
              match[0] === "" ? "(empty)" : match[0];

            item.title =
              `Position: ${match.index}`;

            matches.appendChild(item);
          });

          const firstMatch = found[0];

          if (firstMatch && firstMatch.length > 1) {
            const groupCount = firstMatch.length - 1;

            statGroups.textContent =
              groupCount.toLocaleString("ar");

            groupsBox.hidden = false;

            for (let index = 1; index < firstMatch.length; index++) {
              const row = document.createElement("div");

              row.className = "group-item";

              const name = document.createElement("span");
              name.className = "group-name";
              name.textContent = `Group ${index}`;

              const value = document.createElement("span");
              value.className = "group-value";
              value.textContent =
                firstMatch[index] ?? "(undefined)";

              row.appendChild(name);
              row.appendChild(value);

              groups.appendChild(row);
            }
          }

          updateReplace(regex);

          setStatus(
            "success",
            `تم العثور على ${found.length.toLocaleString("ar")} تطابق.`
          );

        } catch (error) {
          clearResults();

          const message =
            error instanceof Error
              ? error.message
              : "Regex غير صالح.";

          setStatus(
            "error",
            `Regex غير صالح: ${message}`
          );
        }
      }

      function updateReplace(regex) {
        const replacement = replaceWith.value;

        if (!replaceFrom.value && !replacement) {
          replaceOutput.value = "";
          return;
        }

        try {
          const result = testString.value.replace(
            regex,
            replacement
          );

          replaceOutput.value = result;
        } catch {
          replaceOutput.value = "";
        }
      }

      function loadExample() {
        pattern.value = String.raw`\b[A-Za-z]+\b`;

        testString.value =
          "Hello world! This is a Regex Tester example. Regex makes text matching easier.";

        replaceFrom.value = "";
        replaceWith.value = "";

        flagG.checked = true;
        flagI.checked = false;
        flagM.checked = false;
        flagS.checked = false;

        runTest();
      }

      function clearAll() {
        pattern.value = "";
        testString.value = "";
        replaceFrom.value = "";
        replaceWith.value = "";

        clearResults();
        updatePreview();
        updateTextStats();

        setStatus(
          "info",
          "تم مسح الأداة. أدخل Regex ونصًا جديدًا."
        );

        pattern.focus();
      }

      async function copyRegex() {
        if (!pattern.value) {
          setStatus("info", "لا يوجد Regex لنسخه.");
          return;
        }

        const value =
          `/${pattern.value}/${getFlags()}`;

        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(value);
          } else {
            const temp = document.createElement("textarea");
            temp.value = value;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            temp.remove();
          }

          setStatus(
            "success",
            "تم نسخ Regex إلى الحافظة."
          );
        } catch {
          setStatus(
            "error",
            "تعذر النسخ تلقائيًا."
          );
        }
      }

      function updateReplaceLive() {
        if (!pattern.value) {
          replaceOutput.value = "";
          return;
        }

        try {
          const regex = createRegex();

          updateReplace(regex);
        } catch {
          replaceOutput.value = "";
        }
      }

      pattern.addEventListener("input", runTest);
      testString.addEventListener("input", runTest);

      replaceFrom.addEventListener(
        "input",
        updateReplaceLive
      );

      replaceWith.addEventListener(
        "input",
        updateReplaceLive
      );

      [
        flagG,
        flagI,
        flagM,
        flagS
      ].forEach((flag) => {
        flag.addEventListener("change", runTest);
      });

      testBtn.addEventListener("click", runTest);
      exampleBtn.addEventListener("click", loadExample);
      clearBtn.addEventListener("click", clearAll);
      copyBtn.addEventListener("click", copyRegex);

      pattern.addEventListener("keydown", (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key === "Enter"
        ) {
          event.preventDefault();
          runTest();
        }
      });

      testString.addEventListener("keydown", (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key === "Enter"
        ) {
          event.preventDefault();
          runTest();
        }
      });

      updatePreview();
      updateTextStats();
      clearResults();
    })();
  </script>
