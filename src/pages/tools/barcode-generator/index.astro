  <script is:inline define:vars={{ base }}>
    function startBarcodeTool() {

      const barcodeType = document.getElementById('barcodeType');
      const barcodeValue = document.getElementById('barcodeValue');

      const barWidth = document.getElementById('barWidth');
      const barHeight = document.getElementById('barHeight');

      const displayValue = document.getElementById('displayValue');
      const fontSize = document.getElementById('fontSize');

      const lineColor = document.getElementById('lineColor');
      const backgroundColor = document.getElementById('backgroundColor');

      const clearBtn = document.getElementById('clearBtn');
      const generateBtn = document.getElementById('generateBtn');

      const resetBtn = document.getElementById('resetBtn');
      const resetBtnMain = document.getElementById('resetBtnMain');

      const downloadPng = document.getElementById('downloadPng');
      const downloadSvg = document.getElementById('downloadSvg');

      const copyValue = document.getElementById('copyValue');

      const barcodeSvg = document.getElementById('barcodeSvg');
      const barcodeCanvas = document.getElementById('barcodeCanvas');

      const emptyPreview = document.getElementById('emptyPreview');

      const formatBadge = document.getElementById('formatBadge');
      const status = document.getElementById('status');


      function setStatus(message, error = false) {

        status.textContent = message;

        status.style.color = error
          ? '#ef4444'
          : '';

      }


      function normalizeValue(value) {

        return String(value || '').trim();

      }


      function validate(type, value) {

        if (!value) {
          return 'يرجى إدخال قيمة للباركود.';
        }


        if (type === 'EAN13') {

          if (!/^\d{12,13}$/.test(value)) {
            return 'EAN13 يجب أن يحتوي على 12 أو 13 رقمًا.';
          }

        }


        if (type === 'EAN8') {

          if (!/^\d{7,8}$/.test(value)) {
            return 'EAN8 يجب أن يحتوي على 7 أو 8 أرقام.';
          }

        }


        if (type === 'UPC') {

          if (!/^\d{11,12}$/.test(value)) {
            return 'UPC يجب أن يحتوي على 11 أو 12 رقمًا.';
          }

        }


        if (type === 'ITF14') {

          if (!/^\d{13,14}$/.test(value)) {
            return 'ITF14 يجب أن يحتوي على 13 أو 14 رقمًا.';
          }

        }


        if (type === 'CODE39') {

          if (!/^[0-9A-Z .\-$\/+%]+$/.test(value)) {
            return 'CODE39 يدعم الأحرف الكبيرة والأرقام وبعض الرموز فقط.';
          }

        }


        return null;
      }


      function clearPreview() {

        barcodeSvg.innerHTML = '';

        barcodeSvg.style.display = 'none';

        barcodeCanvas.style.display = 'none';

        emptyPreview.style.display = 'flex';

        setStatus('جاهز لإنشاء الباركود');

      }


      function generate() {

        if (
          typeof window.JsBarcode === 'undefined'
        ) {

          setStatus(
            'تعذر تحميل مكتبة إنشاء الباركود.',
            true
          );

          return;

        }


        const type = barcodeType.value;

        const value = normalizeValue(
          barcodeValue.value
        );


        const error = validate(
          type,
          value
        );


        if (error) {

          clearPreview();

          setStatus(error, true);

          return;

        }


        try {

          barcodeSvg.innerHTML = '';

          barcodeSvg.style.display = 'block';

          emptyPreview.style.display = 'none';


          window.JsBarcode(
            barcodeSvg,
            value,
            {
              format: type,

              width:
                Number(barWidth.value),

              height:
                Number(barHeight.value),

              displayValue:
                displayValue.value === 'true',

              fontSize:
                Number(fontSize.value),

              lineColor:
                lineColor.value,

              background:
                backgroundColor.value,

              margin: 12,

              textMargin: 6,

              font: 'Cairo',

              valid: function(valid) {

                if (!valid) {

                  clearPreview();

                  setStatus(
                    'القيمة غير صالحة لهذا النوع.',
                    true
                  );

                }

              }
            }
          );


          barcodeSvg.setAttribute(
            'xmlns',
            'http://www.w3.org/2000/svg'
          );


          barcodeSvg.setAttribute(
            'xmlns:xlink',
            'http://www.w3.org/1999/xlink'
          );


          formatBadge.textContent = type;

          setStatus(
            'تم إنشاء الباركود بنجاح'
          );

        } catch (error) {

          console.error(error);

          clearPreview();

          setStatus(
            'تعذر إنشاء الباركود. تحقق من القيمة.',
            true
          );

        }

      }


      function updateInterface() {

        formatBadge.textContent =
          barcodeType.value;

      }


      function prepareSVGForDownload() {

        if (
          !barcodeSvg ||
          !barcodeSvg.innerHTML.trim()
        ) {

          return null;

        }


        const clone =
          barcodeSvg.cloneNode(true);


        clone.setAttribute(
          'xmlns',
          'http://www.w3.org/2000/svg'
        );


        clone.setAttribute(
          'xmlns:xlink',
          'http://www.w3.org/1999/xlink'
        );


        const viewBox =
          clone.getAttribute('viewBox');


        if (viewBox) {

          const parts =
            viewBox
              .trim()
              .split(/\s+/)
              .map(Number);


          if (
            parts.length === 4 &&
            parts[2] > 0 &&
            parts[3] > 0
          ) {

            clone.setAttribute(
              'width',
              String(parts[2])
            );

            clone.setAttribute(
              'height',
              String(parts[3])
            );

          }

        }


        return new XMLSerializer()
          .serializeToString(clone);

      }


      function downloadFile(
        content,
        filename,
        type
      ) {

        const blob =
          new Blob(
            [content],
            { type }
          );


        const url =
          URL.createObjectURL(blob);


        const link =
          document.createElement('a');


        link.href = url;

        link.download = filename;

        link.style.display = 'none';


        document.body.appendChild(link);

        link.click();

        link.remove();


        setTimeout(
          () => URL.revokeObjectURL(url),
          1000
        );

      }


      function downloadSVG() {

        generate();


        setTimeout(() => {

          const svg =
            prepareSVGForDownload();


          if (!svg) {

            setStatus(
              'أنشئ الباركود أولًا.',
              true
            );

            return;

          }


          downloadFile(
            svg,
            'barcode.svg',
            'image/svg+xml;charset=utf-8'
          );


          setStatus(
            'تم تحميل ملف SVG'
          );

        }, 80);

      }


      function downloadPNG() {

        generate();


        setTimeout(() => {

          const svgContent =
            prepareSVGForDownload();


          if (!svgContent) {

            setStatus(
              'أنشئ الباركود أولًا.',
              true
            );

            return;

          }


          const svgBlob =
            new Blob(
              [svgContent],
              {
                type:
                  'image/svg+xml;charset=utf-8'
              }
            );


          const url =
            URL.createObjectURL(svgBlob);


          const image =
            new Image();


          image.onload = function() {

            try {

              const scale = 3;

              const width =
                image.naturalWidth ||
                image.width ||
                600;


              const height =
                image.naturalHeight ||
                image.height ||
                200;


              barcodeCanvas.width =
                width * scale;


              barcodeCanvas.height =
                height * scale;


              const ctx =
                barcodeCanvas.getContext('2d');


              ctx.setTransform(
                scale,
                0,
                0,
                scale,
                0,
                0
              );


              ctx.fillStyle =
                backgroundColor.value ||
                '#ffffff';


              ctx.fillRect(
                0,
                0,
                width,
                height
              );


              ctx.drawImage(
                image,
                0,
                0,
                width,
                height
              );


              barcodeCanvas.toBlob(
                function(blob) {

                  if (!blob) {

                    setStatus(
                      'تعذر إنشاء صورة PNG.',
                      true
                    );

                    URL.revokeObjectURL(url);

                    return;

                  }


                  const pngUrl =
                    URL.createObjectURL(blob);


                  const link =
                    document.createElement('a');


                  link.href = pngUrl;

                  link.download =
                    'barcode.png';

                  link.style.display = 'none';


                  document.body.appendChild(link);

                  link.click();

                  link.remove();


                  setTimeout(() => {

                    URL.revokeObjectURL(pngUrl);

                  }, 1000);


                  setStatus(
                    'تم تحميل ملف PNG'
                  );

                },
                'image/png'
              );


            } catch (error) {

              console.error(error);

              setStatus(
                'تعذر تصدير PNG.',
                true
              );

            }


            URL.revokeObjectURL(url);

          };


          image.onerror = function() {

            URL.revokeObjectURL(url);

            setStatus(
              'تعذر تحويل الباركود إلى PNG.',
              true
            );

          };


          image.src = url;

        }, 100);

      }


      function fallbackCopy(text) {

        const textarea =
          document.createElement('textarea');


        textarea.value = text;

        textarea.style.position =
          'fixed';

        textarea.style.opacity = '0';


        document.body.appendChild(
          textarea
        );


        textarea.focus();

        textarea.select();


        try {

          document.execCommand('copy');

          setStatus(
            'تم نسخ قيمة الباركود'
          );

        } catch {

          setStatus(
            'تعذر النسخ تلقائيًا.',
            true
          );

        }


        textarea.remove();

      }


      async function copyBarcodeValue() {

        const value =
          normalizeValue(
            barcodeValue.value
          );


        if (!value) {

          setStatus(
            'لا توجد قيمة لنسخها.',
            true
          );

          return;

        }


        try {

          if (
            navigator.clipboard &&
            window.isSecureContext
          ) {

            await navigator.clipboard.writeText(
              value
            );


            setStatus(
              'تم نسخ قيمة الباركود'
            );

          } else {

            fallbackCopy(value);

          }

        } catch {

          fallbackCopy(value);

        }

      }


      function reset() {

        barcodeType.value =
          'CODE128';


        barcodeValue.value =
          '123456789012';


        barWidth.value =
          '2';


        barHeight.value =
          '70';


        displayValue.value =
          'true';


        fontSize.value =
          '16';


        lineColor.value =
          '#111827';


        backgroundColor.value =
          '#ffffff';


        updateInterface();

        generate();

      }


      /* EVENTS */

      generateBtn.addEventListener(
        'click',
        generate
      );


      clearBtn.addEventListener(
        'click',
        () => {

          barcodeValue.value = '';

          clearPreview();

          barcodeValue.focus();

        }
      );


      resetBtn.addEventListener(
        'click',
        reset
      );


      resetBtnMain.addEventListener(
        'click',
        reset
      );


      downloadSVG.addEventListener(
        'click',
        downloadSVG
      );


      downloadPng.addEventListener(
        'click',
        downloadPNG
      );


      copyValue.addEventListener(
        'click',
        copyBarcodeValue
      );


      barcodeType.addEventListener(
        'change',
        () => {

          updateInterface();

          generate();

        }
      );


      [
        barWidth,
        barHeight,
        displayValue,
        fontSize,
        lineColor,
        backgroundColor
      ].forEach((element) => {

        element.addEventListener(
          'change',
          generate
        );

      });


      barcodeValue.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key === 'Enter'
          ) {

            generate();

          }

        }
      );


      /* START */

      updateInterface();

      generate();

    }


    if (
      document.readyState === 'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        startBarcodeTool
      );

    } else {

      startBarcodeTool();

    }

  </script>

</body>
</html>
