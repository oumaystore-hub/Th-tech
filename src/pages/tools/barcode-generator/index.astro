        13px;

    }


    .check {

      min-height:
        42px;

      padding:
        0 11px;

      box-sizing:
        border-box;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      background:
        var(--surface-2);

      border:
        1px solid var(--line);

      border-radius:
        10px;

      color:
        var(--text-soft);

      font-size:
        8px;

      cursor:
        pointer;

    }


    .check input {

      width:
        15px;

      height:
        15px;

      accent-color:
        var(--blue);

      flex-shrink:
        0;

    }


    /* =========================================================
       COLORS
       ========================================================= */

    .color-grid {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

      gap:
        10px;

    }


    .color-control {

      min-height:
        44px;

      padding:
        5px 8px;

      box-sizing:
        border-box;

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      background:
        var(--field);

      border:
        1px solid var(--line);

      border-radius:
        10px;

    }


    .color-control input {

      width:
        32px;

      height:
        32px;

      padding:
        0;

      border:
        0;

      background:
        transparent;

      cursor:
        pointer;

    }


    .color-control span {

      color:
        var(--text-soft);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        8px;

    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .actions {

      display:
        grid;

      grid-template-columns:
        1fr 1.6fr;

      gap:
        10px;

      margin-top:
        23px;

    }


    .actions button {

      min-height:
        48px;

      border-radius:
        11px;

      font-family:
        "Cairo",
        sans-serif;

      font-size:
        10px;

      font-weight:
        800;

      cursor:
        pointer;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      transition:
        .2s ease;

    }


    .reset-btn {

      color:
        var(--text);

      background:
        var(--surface-3);

      border:
        1px solid var(--line);

    }


    .generate-btn {

      color:
        #fff;

      background:
        linear-gradient(
          135deg,
          var(--blue),
          var(--blue-dark)
        );

      border:
        0;

      box-shadow:
        0 8px 22px rgba(8,151,215,.20);

    }


    .actions button:hover {

      transform:
        translateY(-1px);

    }


    .message {

      min-height:
        19px;

      margin-top:
        10px;

      text-align:
        center;

      font-size:
        9px;

    }


    .message.success {

      color:
        var(--success);

    }


    .message.error {

      color:
        var(--danger);

    }


    /* =========================================================
       BARCODE PREVIEW
       ========================================================= */

    .barcode-stage {

      min-height:
        330px;

      padding:
        22px;

      display:
        grid;

      place-items:
        center;

      box-sizing:
        border-box;

      background:
        var(--page-bg);

      border:
        1px dashed var(--line-strong);

      border-radius:
        18px;

      overflow:
        auto;

    }


    .empty {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      gap:
        8px;

      text-align:
        center;

    }


    .empty-icon {

      width:
        70px;

      height:
        70px;

      display:
        grid;

      place-items:
        center;

      margin-bottom:
        5px;

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      border-radius:
        18px;

      color:
        var(--blue);

      font-size:
        27px;

    }


    .empty strong {

      font-size:
        12px;

    }


    .empty span {

      color:
        var(--muted);

      font-size:
        9px;

    }


    .barcode-svg {

      display:
        none;

      max-width:
        100%;

      height:
        auto;

    }


    .preview-meta {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        12px;

      color:
        var(--muted);

      font-size:
        8px;

    }


    .preview-meta i {

      color:
        var(--success);

      margin-left:
        4px;

    }


    /* =========================================================
       EXPORT
       ========================================================= */

    .export-title {

      margin:
        21px 0 10px;

      color:
        var(--text-soft);

      font-size:
        10px;

      font-weight:
        800;

    }


    .export-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        9px;

    }


    .export {

      min-height:
        60px;

      padding:
        8px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        12px;

      color:
        var(--text);

      font-family:
        inherit;

      cursor:
        pointer;

      transition:
        .2s ease;

    }


    .export i {

      color:
        var(--blue);

      font-size:
        15px;

    }


    .export span {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-start;

    }


    .export strong {

      font-size:
        9px;

    }


    .export small {

      color:
        var(--muted);

      font-size:
        7px;

    }


    .export:hover:not(:disabled) {

      border-color:
        var(--line-strong);

      transform:
        translateY(-1px);

    }


    .export:disabled {

      opacity:
        .35;

      cursor:
        not-allowed;

    }


    .scan-note {

      margin-top:
        13px;

      padding:
        10px 12px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        8px;

      background:
        rgba(40,184,242,.06);

      border:
        1px solid var(--line);

      border-radius:
        10px;

      color:
        var(--muted);

      font-size:
        8px;

      line-height:
        1.8;

    }


    .scan-note i {

      color:
        var(--blue);

      margin-top:
        3px;

    }


    /* =========================================================
       FEATURES
       ========================================================= */

    .features {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        12px;

      margin-top:
        16px;

    }


    .feature {

      padding:
        17px;

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        15px;

      box-shadow:
        var(--shadow);

    }


    .feature-icon {

      width:
        42px;

      height:
        42px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      background:
        rgba(40,184,242,.08);

      border-radius:
        11px;

      color:
        var(--blue);

    }


    .feature strong,
    .feature span {

      display:
        block;

    }


    .feature strong {

      font-size:
        10px;

    }


    .feature span {

      margin-top:
        3px;

      color:
        var(--muted);

      font-size:
        8px;

    }


    /* =========================================================
       INFO
       ========================================================= */

    .info-card {

      margin-top:
        16px;

      padding:
        21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        14px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        17px;

      box-shadow:
        var(--shadow);

    }


    .info-icon,
    .tip-icon {

      width:
        44px;

      height:
        44px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      border-radius:
        12px;

      color:
        var(--blue);

    }


    .info-card h2 {

      margin:
        0 0 7px;

      font-size:
        14px;

    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        2;

    }


    .info-body {

      width:
        100%;

    }


    /* =========================================================
       STEPS
       ========================================================= */

    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        14px;

      margin-top:
        17px;

    }


    .step {

      display:
        flex;

      gap:
        10px;

    }


    .step > span {

      width:
        29px;

      height:
        29px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      border-radius:
        8px;

      color:
        var(--blue);

      font-size:
        10px;

      font-weight:
        800;

    }


    .step strong {

      font-size:
        10px;

    }


    .step p {

      margin-top:
        3px;

      font-size:
        8px;

    }


    /* =========================================================
       TIP
       ========================================================= */

    .tip {

      margin-top:
        16px;

      padding:
        18px 21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        13px;

      background:
        linear-gradient(
          135deg,
          rgba(40,184,242,.07),
          var(--surface)
        );

      border:
        1px solid var(--line);

      border-radius:
        17px;

    }


    .tip strong {

      display:
        block;

      margin:
        1px 0 4px;

      font-size:
        11px;

    }


    .tip p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        1.9;

    }


    /* =========================================================
       FAQ
       ========================================================= */

    .faq {

      margin-top:
        48px;

    }


    .faq-title {

      text-align:
        center;

      margin-bottom:
        18px;

    }


    .faq-title span {

      color:
        var(--blue);

      font-size:
        9px;

      font-weight:
        800;

    }


    .faq-title h2 {

      margin:
        5px 0 0;

      font-size:
        22px;

      font-weight:
        800;

    }


    details {

      margin-bottom:
        9px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        13px;

      overflow:
        hidden;

    }


    summary {

      min-height:
        54px;

      padding:
        12px 16px;

      box-sizing:
        border-box;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      list-style:
        none;

      cursor:
        pointer;

      color:
        var(--text);

      font-size:
        9px;

      font-weight:
        700;

    }


    summary::-webkit-details-marker {

      display:
        none;

    }


    summary i {

      color:
        var(--blue);

      transition:
        .2s ease;

    }


    details[open] summary i {

      transform:
        rotate(45deg);

    }


    details p {

      margin:
        0;

      padding:
        0 16px 16px;

      color:
        var(--muted);

      font-size:
        8px;

      line-height:
        2;

    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 850px) {

      .workspace {

        grid-template-columns:
          1fr;

      }


      .editor {

        border-left:
          0;

        border-bottom:
          1px solid var(--line);

      }


      .features {

        grid-template-columns:
          1fr;

      }

    }


    @media (max-width: 600px) {

      .barcode-page {

        width:
          calc(100% - 18px);

        padding:
          22px 0 55px;

      }


      .hero {

        padding:
          5px 5px 25px;

      }


      .hero h1 {

        font-size:
          28px;

      }


      .hero > p {

        font-size:
          10px;

      }


      .hero-points {

        gap:
          6px;

      }


      .hero-points span {

        padding:
          6px 8px;

        font-size:
          7px;

      }


      .tool {

        border-radius:
          18px;

      }


      .tool-top {

        padding:
          19px;

      }


      .tool-top h2 {

        font-size:
          17px;

      }


      .tool-top p {

        font-size:
          8px;

      }


      .status {

        padding:
          6px 9px;

        font-size:
          8px;

      }


      .editor,
      .preview {

        padding:
          18px;

      }


      .block-head {

        margin-bottom:
          18px;

      }


      .block-icon {

        width:
          39px;

        height:
          39px;

      }


      .block-head h3 {

        font-size:
          12px;

      }


      .block-head p {

        font-size:
          8px;

      }


      input[type="text"],
      select {

        height:
          45px;

        font-size:
          10px;

      }


      .settings-grid {

        grid-template-columns:
          1fr;

        gap:
          9px;

      }


      .check-row {

        grid-template-columns:
          1fr;

      }


      .color-grid {

        grid-template-columns:
          1fr;

      }


      .actions {

        grid-template-columns:
          1fr;

      }


      .actions button {

        min-height:
          46px;

      }


      .barcode-stage {

        min-height:
          270px;

        padding:
          14px;

      }


      .barcode-svg {

        max-width:
          100%;

      }


      .export-grid {

        gap:
          7px;

      }


      .export {

        min-height:
          56px;

      }


      .export span {

        display:
          none;

      }


      .export i {

        font-size:
          16px;

      }


      .info-card {

        padding:
          16px;

      }


      .steps {

        grid-template-columns:
          1fr;

      }


      .faq {

        margin-top:
          38px;

      }


      .faq-title h2 {

        font-size:
          19px;

      }

    }


    @media (max-width: 380px) {

      .tool-top {

        flex-direction:
          column;

      }


      .status {

        align-self:
          flex-start;

      }


      .hero h1 {

        font-size:
          25px;

      }


      .barcode-stage {

        min-height:
          235px;

      }

    }

  </style>

</body>
</html>
