---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;

const title = 'مولد الباركود أونلاين | Th.Tech';
const description =
  'أنشئ باركود احترافي مجانًا أونلاين مع دعم CODE128 وCODE39 وEAN13 وEAN8 وUPC وITF14، مع إمكانية تحميل PNG وSVG.';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta name="theme-color" content="#0b1220" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
</head>

<body>

  <Header />

  <main class="barcode-page">

    <!-- =========================
         HERO
    ========================== -->
    <section class="hero">
      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <span>/</span>
        <a href={`${base}/tools/`}>الأدوات</a>
        <span>/</span>
        <strong>مولد الباركود</strong>
      </div>

      <div class="hero-icon">
        <i class="fa-solid fa-barcode"></i>
      </div>

      <h1>مولد الباركود</h1>

      <p>
        أنشئ باركود احترافي بسرعة، خصص مظهره ثم حمّله بصيغة PNG أو SVG.
      </p>

      <div class="hero-tags">
        <span><i class="fa-solid fa-bolt"></i> سريع</span>
        <span><i class="fa-solid fa-mobile-screen"></i> يعمل على الهاتف</span>
        <span><i class="fa-solid fa-lock"></i> مجاني</span>
      </div>
    </section>


    <!-- =========================
         TOOL
    ========================== -->
    <section class="tool-card">

      <!-- FORMAT -->
      <div class="field">
        <label for="barcodeType">
          <span class="label-icon">
            <i class="fa-solid fa-barcode"></i>
          </span>
          نوع الباركود
        </label>

        <select id="barcodeType">
          <option value="CODE128">CODE128</option>
          <option value="CODE39">CODE39</option>
          <option value="EAN13">EAN13</option>
          <option value="EAN8">EAN8</option>
          <option value="UPC">UPC</option>
          <option value="ITF14">ITF14</option>
        </select>
      </div>


      <!-- VALUE -->
      <div class="field">
        <label for="barcodeValue">
          <span class="label-icon">
            <i class="fa-solid fa-hashtag"></i>
          </span>
          قيمة الباركود
        </label>

        <input
          id="barcodeValue"
          type="text"
          value="123456789012"
          autocomplete="off"
          spellcheck="false"
          placeholder="أدخل قيمة الباركود..."
        />

        <div class="field-hint">
          أدخل الرقم أو النص الذي تريد تحويله إلى باركود.
        </div>
      </div>


      <!-- ACTIONS -->
      <div class="main-actions">

        <button id="generateBtn" class="primary-btn" type="button">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <span>إنشاء الباركود</span>
        </button>

        <button id="clearBtn" class="secondary-btn" type="button">
          <i class="fa-solid fa-eraser"></i>
          <span>مسح</span>
        </button>

      </div>


      <!-- =====================================================
           MOBILE:
           SETTINGS ABOVE EXPORT
      ====================================================== -->

      <div class="options-grid">

        <!-- =========================
             SETTINGS
        ========================== -->
        <div class="options-card settings-card">

          <div class="section-heading">
            <div class="section-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>

            <div>
              <h3>إعدادات الباركود</h3>
              <span>خصص الشكل والحجم</span>
            </div>
          </div>


          <div class="settings-grid">

            <!-- WIDTH -->
            <div class="mini-field">
              <label for="barWidth">عرض الخط</label>

              <div class="mini-select">
                <select id="barWidth">
                  <option value="1">1</option>
                  <option value="2" selected>2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                </select>

                <i class="fa-solid fa-chevron-down"></i>
              </div>
            </div>


            <!-- HEIGHT -->
            <div class="mini-field">
              <label for="barHeight">الارتفاع</label>

              <div class="mini-select">
                <select id="barHeight">
                  <option value="40">40</option>
                  <option value="50">50</option>
                  <option value="60">60</option>
                  <option value="70" selected>70</option>
                  <option value="80">80</option>
                  <option value="100">100</option>
                  <option value="120">120</option>
                </select>

                <i class="fa-solid fa-chevron-down"></i>
              </div>
            </div>


            <!-- DISPLAY VALUE -->
            <div class="mini-field">
              <label for="displayValue">إظهار الرقم</label>

              <div class="mini-select">
                <select id="displayValue">
                  <option value="true" selected>نعم</option>
                  <option value="false">لا</option>
                </select>

                <i class="fa-solid fa-chevron-down"></i>
              </div>
            </div>


            <!-- FONT -->
            <div class="mini-field">
              <label for="fontSize">حجم الخط</label>

              <div class="mini-select">
                <select id="fontSize">
                  <option value="12">12</option>
                  <option value="14">14</option>
                  <option value="16" selected>16</option>
                  <option value="18">18</option>
                  <option value="20">20</option>
                  <option value="24">24</option>
                </select>

                <i class="fa-solid fa-chevron-down"></i>
              </div>
            </div>

          </div>


          <!-- COLORS -->
          <div class="colors-grid">

            <div class="color-box">
              <label for="lineColor">لون الباركود</label>

              <div class="color-control">
                <input id="lineColor" type="color" value="#111827" />
                <span>#111827</span>
              </div>
            </div>


            <div class="color-box">
              <label for="backgroundColor">لون الخلفية</label>

              <div class="color-control">
                <input id="backgroundColor" type="color" value="#ffffff" />
                <span>#ffffff</span>
              </div>
            </div>

          </div>

        </div>


        <!-- =========================
             EXPORT
        ========================== -->
        <div class="options-card export-card">

          <div class="section-heading">
            <div class="section-icon export-icon">
              <i class="fa-solid fa-download"></i>
            </div>

            <div>
              <h3>تصدير الباركود</h3>
              <span>احفظ النتيجة على جهازك</span>
            </div>
          </div>


          <div class="download-grid">

            <button id="downloadPng" class="export-btn" type="button">

              <span class="export-btn-icon">
                <i class="fa-solid fa-image"></i>
              </span>

              <span class="export-btn-content">
                <strong>تحميل PNG</strong>
                <small>صورة عالية الجودة</small>
              </span>

            </button>


            <button id="downloadSvg" class="export-btn" type="button">

              <span class="export-btn-icon">
                <i class="fa-solid fa-vector-square"></i>
              </span>

              <span class="export-btn-content">
                <strong>تحميل SVG</strong>
                <small>صيغة متجهة</small>
              </span>

            </button>


            <button id="copyValue" class="export-btn" type="button">

              <span class="export-btn-icon">
                <i class="fa-regular fa-copy"></i>
              </span>

              <span class="export-btn-content">
                <strong>نسخ القيمة</strong>
                <small>نسخ النص</small>
              </span>

            </button>


            <button id="resetBtnMain" class="export-btn" type="button">

              <span class="export-btn-icon">
                <i class="fa-solid fa-rotate-right"></i>
              </span>

              <span class="export-btn-content">
                <strong>إعادة الضبط</strong>
                <small>الإعدادات الافتراضية</small>
              </span>

            </button>

          </div>


          <div class="export-tip">
            <i class="fa-solid fa-circle-info"></i>
            يمكنك تحميل الباركود مباشرة من الهاتف أو الحاسوب.
          </div>

        </div>

      </div>


      <!-- =========================
           PREVIEW
      ========================== -->
      <div class="preview-section">

        <div class="preview-heading">

          <div>
            <h2>
              <i class="fa-solid fa-eye"></i>
              المعاينة
            </h2>

            <span id="status">جاهز لإنشاء الباركود</span>
          </div>

          <span id="formatBadge">CODE128</span>

        </div>


        <div id="previewBox" class="preview-box">

          <div id="emptyPreview" class="empty-preview">

            <div class="empty-icon">
              <i class="fa-solid fa-barcode"></i>
            </div>

            <strong>ستظهر المعاينة هنا</strong>

            <span>
              أدخل القيمة واضغط على إنشاء الباركود
            </span>

          </div>

          <svg
            id="barcodeSvg"
            role="img"
            aria-label="Barcode preview"
          ></svg>

          <canvas id="barcodeCanvas"></canvas>

        </div>

      </div>


      <!-- =========================
           RESET
      ========================== -->
      <button id="resetBtn" class="reset-btn" type="button">
        <i class="fa-solid fa-rotate-left"></i>
        إعادة جميع الإعدادات
      </button>

    </section>


    <!-- =========================
         INFO
    ========================== -->
    <section class="info-grid">

      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-circle-check"></i>
        </div>

        <h2>أنواع الباركود المدعومة</h2>

        <p>
          يدعم مولد الباركود أشهر الصيغ المستخدمة مثل CODE128
          وCODE39 وEAN13 وEAN8 وUPC وITF14.
        </p>

      </article>


      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-mobile-screen-button"></i>
        </div>

        <h2>مصمم للهاتف</h2>

        <p>
          الواجهة متجاوبة وتعمل بسهولة على الهواتف والأجهزة اللوحية
          وأجهزة الكمبيوتر.
        </p>

      </article>


      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <h2>خصوصية وأمان</h2>

        <p>
          تتم عملية إنشاء الباركود داخل المتصفح مباشرة، ولا تحتاج
          إلى إرسال البيانات إلى خادم خارجي.
        </p>

      </article>

    </section>


    <!-- =========================
         HOW TO
    ========================== -->
    <section class="content-section">

      <div class="content-title">
        <span>
          <i class="fa-solid fa-list-ol"></i>
        </span>

        <div>
          <h2>كيفية إنشاء باركود؟</h2>
          <p>أنشئ الباركود في ثلاث خطوات بسيطة.</p>
        </div>
      </div>


      <div class="steps">

        <div class="step">
          <b>1</b>

          <div>
            <h3>اختر النوع</h3>
            <p>حدد نوع الباركود المناسب من القائمة.</p>
          </div>
        </div>


        <div class="step">
          <b>2</b>

          <div>
            <h3>أدخل القيمة</h3>
            <p>اكتب الرقم أو النص الذي تريد تحويله إلى باركود.</p>
          </div>
        </div>


        <div class="step">
          <b>3</b>

          <div>
            <h3>حمّل النتيجة</h3>
            <p>خصص التصميم ثم حمّل PNG أو SVG.</p>
          </div>
        </div>

      </div>

    </section>


    <!-- =========================
         FAQ
    ========================== -->
    <section class="faq-section">

      <div class="content-title">
        <span>
          <i class="fa-solid fa-circle-question"></i>
        </span>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>أهم الأسئلة حول مولد الباركود.</p>
        </div>
      </div>


      <details>
        <summary>
          هل يمكن استخدام الأداة على الهاتف؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          نعم، تم تصميم الواجهة لتعمل على الهواتف والأجهزة اللوحية
          وأجهزة الكمبيوتر.
        </p>
      </details>


      <details>
        <summary>
          هل تحميل الباركود مجاني؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          نعم، يمكنك إنشاء الباركود وتحميله مجانًا بصيغة PNG أو SVG.
        </p>
      </details>


      <details>
        <summary>
          هل يتم حفظ البيانات؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          لا تحتاج الأداة إلى إرسال قيمة الباركود إلى خادم خارجي؛
          تتم المعالجة داخل المتصفح.
        </p>
      </details>

    </section>

  </main>

  <Footer />


  <style>

    /* =====================================================
       VARIABLES
    ====================================================== */

    :global(:root) {
      --primary: #2563eb;
      --primary-2: #38bdf8;

      --bg: #f5f9ff;
      --card: #ffffff;
      --input: #f8fafc;

      --text: #0f172a;
      --muted: #64748b;

      --border: #dbe5f0;

      --shadow:
        0 12px 35px rgba(15, 23, 42, 0.07);

      --radius: 20px;
    }


    :global(html[data-theme="dark"]),
    :global(body.dark) {
      --bg: #07101f;
      --card: #0d1728;
      --input: #111d30;

      --text: #f1f5f9;
      --muted: #94a3b8;

      --border: #23344d;

      --shadow:
        0 15px 40px rgba(0, 0, 0, 0.28);
    }


    :global(*) {
      box-sizing: border-box;
    }


    :global(body) {
      margin: 0;

      background:
        radial-gradient(
          circle at 50% -10%,
          rgba(37, 99, 235, 0.10),
          transparent 35%
        ),
        var(--bg);

      color: var(--text);

      font-family: "Cairo", sans-serif;

      transition:
        background 0.25s ease,
        color 0.25s ease;
    }


    /* =====================================================
       PAGE
    ====================================================== */

    .barcode-page {
      width: min(1180px, calc(100% - 32px));

      margin: 0 auto;

      padding:
        30px
        0
        70px;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .hero {
      text-align: center;

      margin-bottom: 25px;
    }


    .breadcrumb {
      display: flex;

      justify-content: center;
      align-items: center;

      flex-wrap: wrap;

      gap: 7px;

      color: var(--muted);

      font-size: 0.78rem;

      margin-bottom: 14px;
    }


    .breadcrumb a {
      color: var(--primary);

      text-decoration: none;
    }


    .hero-icon {
      width: 70px;
      height: 70px;

      margin: 0 auto 14px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 20px;

      color: white;

      font-size: 28px;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

      box-shadow:
        0 12px 28px rgba(37, 99, 235, 0.25);
    }


    .hero h1 {
      margin: 0;

      font-size: 2rem;

      font-weight: 800;
    }


    .hero > p {
      max-width: 650px;

      margin: 8px auto 15px;

      color: var(--muted);

      font-size: 0.9rem;

      line-height: 1.9;
    }


    .hero-tags {
      display: flex;

      justify-content: center;

      flex-wrap: wrap;

      gap: 7px;
    }


    .hero-tags span {
      padding: 6px 11px;

      border:
        1px solid
        var(--border);

      border-radius: 999px;

      background: var(--card);

      color: var(--muted);

      font-size: 0.7rem;
    }


    .hero-tags i {
      color: var(--primary);

      margin-left: 4px;
    }


    /* =====================================================
       MAIN CARD
    ====================================================== */

    .tool-card {
      background: var(--card);

      border:
        1px solid
        var(--border);

      border-radius: 24px;

      padding: 24px;

      box-shadow: var(--shadow);
    }


    /* =====================================================
       INPUTS
    ====================================================== */

    .field {
      margin-bottom: 18px;
    }


    .field label {
      display: flex;

      align-items: center;

      gap: 8px;

      margin-bottom: 8px;

      font-size: 0.86rem;

      font-weight: 700;
    }


    .label-icon {
      color: var(--primary);

      font-size: 0.8rem;
    }


    select,
    input[type="text"] {
      width: 100%;

      height: 50px;

      border:
        1px solid
        var(--border);

      border-radius: 13px;

      outline: none;

      background: var(--input);

      color: var(--text);

      font-family: inherit;

      font-size: 0.86rem;

      padding: 0 14px;

      transition:
        border 0.2s,
        box-shadow 0.2s;
    }


    select:focus,
    input[type="text"]:focus {
      border-color: var(--primary);

      box-shadow:
        0 0 0 3px
        rgba(37, 99, 235, 0.10);
    }


    .field-hint {
      margin-top: 6px;

      color: var(--muted);

      font-size: 0.68rem;
    }


    /* =====================================================
       ACTIONS
    ====================================================== */

    .main-actions {
      display: grid;

      grid-template-columns: 2fr 1fr;

      gap: 10px;

      margin: 20px 0;
    }


    button {
      font-family: inherit;

      cursor: pointer;
    }


    .primary-btn,
    .secondary-btn {
      height: 52px;

      border: 0;

      border-radius: 13px;

      font-size: 0.84rem;

      font-weight: 700;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      transition:
        transform 0.18s,
        opacity 0.18s;
    }


    .primary-btn {
      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

      color: white;

      box-shadow:
        0 9px 22px
        rgba(37, 99, 235, 0.22);
    }


    .secondary-btn {
      background: var(--input);

      border:
        1px solid
        var(--border);

      color: var(--text);
    }


    .primary-btn:hover,
    .secondary-btn:hover,
    .export-btn:hover {
      transform: translateY(-2px);
    }


    /* =====================================================
       OPTIONS
       DESKTOP = SIDE BY SIDE
    ====================================================== */

    .options-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 14px;

      width: 100%;

      margin: 16px 0;
    }


    .options-card {
      min-width: 0;

      padding: 18px;

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      background:
        linear-gradient(
          180deg,
          rgba(37, 99, 235, 0.035),
          transparent
        );

      transition: transform 0.2s;
    }


    .options-card:hover {
      transform: translateY(-2px);
    }


    .section-heading {
      display: flex;

      align-items: center;

      gap: 10px;

      margin-bottom: 15px;
    }


    .section-icon {
      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 11px;

      background:
        rgba(37, 99, 235, 0.10);

      color: var(--primary);

      font-size: 14px;
    }


    .export-icon {
      background:
        rgba(56, 189, 248, 0.12);

      color: #0284c7;
    }


    .section-heading h3 {
      margin: 0;

      font-size: 0.9rem;

      font-weight: 800;
    }


    .section-heading span {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 0.62rem;
    }


    /* =====================================================
       SETTINGS
    ====================================================== */

    .settings-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 10px;
    }


    .mini-field {
      min-width: 0;
    }


    .mini-field label {
      display: block;

      margin-bottom: 5px;

      font-size: 0.66rem;

      font-weight: 700;
    }


    .mini-select {
      position: relative;
    }


    .mini-select select {
      height: 42px;

      padding:
        0
        30px
        0
        10px;

      font-size: 0.7rem;

      appearance: none;
    }


    .mini-select i {
      position: absolute;

      right: 10px;

      top: 50%;

      transform: translateY(-50%);

      color: var(--muted);

      pointer-events: none;

      font-size: 0.55rem;
    }


    /* =====================================================
       COLORS
    ====================================================== */

    .colors-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 10px;

      margin-top: 12px;
    }


    .color-box {
      min-width: 0;

      padding: 10px;

      border:
        1px solid
        var(--border);

      border-radius: 11px;

      background: var(--input);
    }


    .color-box label {
      display: block;

      margin-bottom: 6px;

      font-size: 0.64rem;

      font-weight: 700;
    }


    .color-control {
      display: flex;

      align-items: center;

