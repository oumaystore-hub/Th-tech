---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>مولد الباركود | Th.Tech</title>

  <meta
    name="description"
    content="أنشئ باركود احترافي مجانًا مع إمكانية تخصيصه وتحميله بصيغة PNG أو SVG."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"
  ></script>
</head>

<body>

<Header />

<main class="barcode-page">

  <!-- HERO -->
  <section class="hero">

    <div class="breadcrumb">
      <a href={`${base}/`}>الرئيسية</a>
      <span>/</span>
      <a href={`${base}/tools/`}>الأدوات</a>
      <span>/</span>
      <strong>مولد الباركود</strong>
    </div>

    <div class="hero-icon">
      <i class="fa-solid fa-barcode"></i>
    </div>

    <h1>مولد الباركود</h1>

    <p>
      أنشئ باركود احترافي، خصص مظهره وحمّله مباشرة من هاتفك أو حاسوبك.
    </p>

    <div class="hero-tags">
      <span>
        <i class="fa-solid fa-bolt"></i>
        سريع
      </span>

      <span>
        <i class="fa-solid fa-mobile-screen"></i>
        متوافق مع الهاتف
      </span>

      <span>
        <i class="fa-solid fa-lock"></i>
        مجاني
      </span>
    </div>

  </section>


  <!-- TOOL -->
  <section class="tool-card">

    <div class="field">

      <label for="barcodeType">
        <i class="fa-solid fa-barcode"></i>
        نوع الباركود
      </label>

      <select id="barcodeType">
        <option value="CODE128">CODE128</option>
        <option value="CODE39">CODE39</option>
        <option value="EAN13">EAN13</option>
        <option value="EAN8">EAN8</option>
        <option value="UPC">UPC</option>
        <option value="ITF14">ITF14</option>
      </select>

    </div>


    <div class="field">

      <label for="barcodeValue">
        <i class="fa-solid fa-hashtag"></i>
        قيمة الباركود
      </label>

      <input
        id="barcodeValue"
        type="text"
        value="123456789012"
        autocomplete="off"
        spellcheck="false"
        placeholder="أدخل الرقم أو النص..."
      />

      <small>
        اكتب القيمة التي تريد تحويلها إلى باركود.
      </small>

    </div>


    <div class="main-actions">

      <button
        id="generateBtn"
        class="generate-btn"
        type="button"
      >
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        إنشاء الباركود
      </button>

      <button
        id="clearBtn"
        class="clear-btn"
        type="button"
      >
        <i class="fa-solid fa-eraser"></i>
        مسح
      </button>

    </div>


    <!-- OPTIONS -->
    <div class="options-grid">

      <!-- SETTINGS -->
      <div class="options-card">

        <div class="card-title">

          <div class="title-icon">
            <i class="fa-solid fa-sliders"></i>
          </div>

          <div>
            <h2>إعدادات الباركود</h2>
            <p>تخصيص الحجم والمظهر</p>
          </div>

        </div>


        <div class="settings-grid">

          <div class="setting">

            <label for="barWidth">
              عرض الخط
            </label>

            <select id="barWidth">
              <option value="1">1</option>
              <option value="2" selected>2</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>

          </div>


          <div class="setting">

            <label for="barHeight">
              الارتفاع
            </label>

            <select id="barHeight">
              <option value="40">40</option>
              <option value="50">50</option>
              <option value="60">60</option>
              <option value="70" selected>70</option>
              <option value="80">80</option>
              <option value="100">100</option>
              <option value="120">120</option>
            </select>

          </div>


          <div class="setting">

            <label for="displayValue">
              إظهار الرقم
            </label>

            <select id="displayValue">
              <option value="true" selected>نعم</option>
              <option value="false">لا</option>
            </select>

          </div>


          <div class="setting">

            <label for="fontSize">
              حجم الخط
            </label>

            <select id="fontSize">
              <option value="14">14</option>
              <option value="16" selected>16</option>
              <option value="18">18</option>
              <option value="20">20</option>
              <option value="22">22</option>
              <option value="24">24</option>
            </select>

          </div>

        </div>


        <div class="colors-grid">

          <div class="color-field">

            <label for="lineColor">
              لون الباركود
            </label>

            <div class="color-control">
              <input
                id="lineColor"
                type="color"
                value="#111827"
              />

              <span>#111827</span>
            </div>

          </div>


          <div class="color-field">

            <label for="backgroundColor">
              لون الخلفية
            </label>

            <div class="color-control">
              <input
                id="backgroundColor"
                type="color"
                value="#ffffff"
              />

              <span>#ffffff</span>
            </div>

          </div>

        </div>

      </div>


      <!-- EXPORT -->
      <div class="options-card">

        <div class="card-title">

          <div class="title-icon export-title">
            <i class="fa-solid fa-download"></i>
          </div>

          <div>
            <h2>تصدير الباركود</h2>
            <p>احفظ الباركود على جهازك</p>
          </div>

        </div>


        <div class="export-grid">

          <button
            id="downloadPng"
            class="export-button"
            type="button"
          >
            <i class="fa-solid fa-image"></i>

            <span>
              <strong>تحميل PNG</strong>
              <small>صورة</small>
            </span>
          </button>


          <button
            id="downloadSvg"
            class="export-button"
            type="button"
          >
            <i class="fa-solid fa-vector-square"></i>

            <span>
              <strong>تحميل SVG</strong>
              <small>متجه</small>
            </span>
          </button>


          <button
            id="copyValue"
            class="export-button"
            type="button"
          >
            <i class="fa-regular fa-copy"></i>

            <span>
              <strong>نسخ القيمة</strong>
              <small>نسخ النص</small>
            </span>
          </button>


          <button
            id="resetBtnMain"
            class="export-button"
            type="button"
          >
            <i class="fa-solid fa-rotate-right"></i>

            <span>
              <strong>إعادة الضبط</strong>
              <small>الإعدادات</small>
            </span>
          </button>

        </div>

      </div>

    </div>


    <!-- PREVIEW -->
    <div class="preview-section">

      <div class="preview-header">

        <div>
          <h2>
            <i class="fa-solid fa-eye"></i>
            المعاينة
          </h2>

          <p id="status">
            جاهز لإنشاء الباركود
          </p>
        </div>

        <span id="formatBadge">
          CODE128
        </span>

      </div>


      <div
        id="previewBox"
        class="preview-box"
      >

        <div
          id="emptyPreview"
          class="empty-preview"
        >

          <div class="empty-icon">
            <i class="fa-solid fa-barcode"></i>
          </div>

          <strong>
            ستظهر المعاينة هنا
          </strong>

          <span>
            اضغط على إنشاء الباركود
          </span>

        </div>


        <svg
          id="barcodeSvg"
          aria-label="Barcode"
        ></svg>


        <canvas
          id="barcodeCanvas"
        ></canvas>

      </div>

    </div>


    <button
      id="resetBtn"
      class="reset-button"
      type="button"
    >
      <i class="fa-solid fa-rotate-left"></i>
      إعادة جميع الإعدادات
    </button>

  </section>


  <!-- INFO -->
  <section class="info-grid">

    <article class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-barcode"></i>
      </div>

      <h2>أنواع متعددة</h2>

      <p>
        يدعم CODE128 وCODE39 وEAN13 وEAN8 وUPC وITF14.
      </p>

    </article>


    <article class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-mobile-screen"></i>
      </div>

      <h2>متوافق مع الهاتف</h2>

      <p>
        تصميم متجاوب وسهل الاستخدام على جميع الشاشات.
      </p>

    </article>


    <article class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <h2>خصوصية</h2>

      <p>
        يتم إنشاء الباركود داخل المتصفح مباشرة.
      </p>

    </article>

  </section>

</main>

<Footer />


<style>

/* =====================================================
   THEME VARIABLES
   لا يتم تغيير تصميم الأداة، فقط الألوان
===================================================== */

.barcode-page {
  --page-bg: #f5f9ff;
  --page-text: #0f172a;

  --card-bg: #ffffff;
  --card-bg-soft: #f8fafc;

  --input-bg: #f8fafc;

  --border: #dbe5f0;

  --text: #0f172a;
  --muted: #64748b;
  --muted-2: #94a3b8;

  --blue: #2563eb;
  --blue-light: #38bdf8;

  --icon-bg: rgba(37,99,235,.10);

  --shadow:
    0 15px 40px
    rgba(15,23,42,.07);
}


/* =====================================================
   DARK MODE
   متوافق مع data-theme="dark"
===================================================== */

html[data-theme="dark"] .barcode-page,
body.dark .barcode-page,
body.dark-theme .barcode-page {

  --page-bg: #0b1120;
  --page-text: #e5edf8;

  --card-bg: #111827;
  --card-bg-soft: #172033;

  --input-bg: #172033;

  --border: #263449;

  --text: #e5edf8;
  --muted: #9aa9bd;
  --muted-2: #7d8da3;

  --icon-bg: rgba(59,130,246,.16);

  --shadow:
    0 15px 40px
    rgba(0,0,0,.28);
}


/* =====================================================
   GLOBAL
===================================================== */

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  background: #f5f9ff;
}

:global(html[data-theme="dark"]) {
  background: #0b1120;
}

:global(body) {
  margin: 0;

  font-family: "Cairo", sans-serif;

  background: transparent;

  color: var(--page-text);
}


/* =====================================================
   PAGE BACKGROUND
===================================================== */

.barcode-page {
  width: min(1180px, calc(100% - 30px));

  margin: auto;

  padding:
    30px
    0
    70px;

  color: var(--text);
}


/* =====================================================
   HERO
===================================================== */

.hero {
  text-align: center;

  margin-bottom: 25px;
}

.breadcrumb {
  display: flex;

  justify-content: center;

  gap: 7px;

  color: var(--muted);

  font-size: 13px;

  margin-bottom: 15px;
}

.breadcrumb a {
  color: #2563eb;

  text-decoration: none;
}

.breadcrumb strong {
  color: var(--text);
}

.hero-icon {
  width: 68px;
  height: 68px;

  margin: auto;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 19px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #38bdf8
    );

  color: white;

  font-size: 28px;

  box-shadow:
    0 12px 30px
    rgba(37,99,235,.25);
}

.hero h1 {
  margin:
    13px
    0
    7px;

  color: var(--text);

  font-size: 32px;

  font-weight: 800;
}

.hero > p {
  margin: auto;

  max-width: 650px;

  color: var(--muted);

  font-size: 14px;

  line-height: 1.9;
}

.hero-tags {
  display: flex;

  justify-content: center;

  gap: 7px;

  margin-top: 13px;
}

.hero-tags span {
  padding: 6px 11px;

  border: 1px solid var(--border);

  border-radius: 999px;

  background: var(--card-bg);

  color: var(--muted);

  font-size: 11px;
}

.hero-tags i {
  color: #2563eb;
}


/* =====================================================
   TOOL CARD
===================================================== */

.tool-card {
  padding: 25px;

  border: 1px solid var(--border);

  border-radius: 24px;

  background: var(--card-bg);

  box-shadow: var(--shadow);
}


/* =====================================================
   FIELD
===================================================== */

.field {
  margin-bottom: 18px;
}

.field label {
  display: flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 8px;

  color: var(--text);

  font-size: 15px;

  font-weight: 700;
}

.field label i {
  color: #2563eb;
}

.field input,
.field select {
  width: 100%;

  height: 52px;

  padding: 0 15px;

  border: 1px solid var(--border);

  border-radius: 13px;

  background: var(--input-bg);

  color: var(--text);

  outline: none;

  font-family: inherit;

  font-size: 15px;
}

.field input::placeholder {
  color: var(--muted-2);
}

.field input:focus,
.field select:focus {
  border-color: #2563eb;

  box-shadow:
    0 0 0 3px
    rgba(37,99,235,.10);
}

.field small {
  display: block;

  margin-top: 6px;

  color: var(--muted);

  font-size: 11px;
}


/* =====================================================
   MAIN BUTTONS
===================================================== */

.main-actions {
  display: grid;

  grid-template-columns: 2fr 1fr;

  gap: 10px;

  margin: 20px 0;
}

.generate-btn,
.clear-btn {
  height: 53px;

  border-radius: 13px;

  font-family: inherit;

  font-size: 15px;

  font-weight: 700;

  cursor: pointer;
}

.generate-btn {
  border: 0;

  color: white;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #38bdf8
    );
}

.clear-btn {
  border: 1px solid var(--border);

  background: var(--card-bg-soft);

  color: var(--text);
}


/* =====================================================
   OPTIONS
===================================================== */

.options-grid {
  display: grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap: 15px;

  margin-top: 15px;
}

.options-card {
  padding: 20px;

  border: 1px solid var(--border);

  border-radius: 18px;

  background:
    linear-gradient(
      180deg,
      rgba(37,99,235,.035),
      transparent
    );
}

.card-title {
  display: flex;

  align-items: center;

  gap: 11px;

  margin-bottom: 17px;
}

.title-icon {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: var(--icon-bg);

  color: #2563eb;
}

.export-title {
  color: #0284c7;

  background:
    rgba(56,189,248,.12);
}

.card-title h2 {
  margin: 0;

  color: var(--text);

  font-size: 16px;
}

.card-title p {
  margin: 3px 0 0;

  color: var(--muted);

  font-size: 11px;
}


/* =====================================================
   SETTINGS
===================================================== */

.settings-grid {
  display: grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap: 10px;
}

.setting label,
.color-field label {
  display: block;

  margin-bottom: 6px;

  color: var(--text);

  font-size: 12px;

  font-weight: 700;
}

.setting select {
  width: 100%;

  height: 44px;

  padding: 0 10px;

  border: 1px solid var(--border);

  border-radius: 10px;

  background: var(--input-bg);

  color: var(--text);

  font-family: inherit;

  font-size: 13px;
}


/* =====================================================
   COLORS
===================================================== */

.colors-grid {
  display: grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap: 10px;

  margin-top: 12px;
}

.color-field {
  padding: 10px;

  border: 1px solid var(--border);

  border-radius: 11px;

  background: var(--input-bg);
}

.color-control {
  display: flex;

  align-items: center;

  gap: 8px;
}

.color-control input {
  width: 32px;
  height: 32px;

  padding: 2px;

  border: 0;

  cursor: pointer;
}

.color-control span {
  direction: ltr;

  color: var(--muted);

  font-size: 11px;
}


/* =====================================================
   EXPORT
===================================================== */

.export-grid {
  display: grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap: 10px;
}

.export-button {
  min-height: 68px;

  display: flex;

  align-items: center;

  gap: 10px;

  padding: 10px;

  border: 1px solid var(--border);

  border-radius: 12px;

  background: var(--input-bg);

  color: var(--text);

  font-family: inherit;

  text-align: right;

  cursor: pointer;
}

.export-button > i {
  width: 34px;
  height: 34px;

  flex: 0 0 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: var(--icon-bg);

  color: #2563eb;
}

.export-button span {
  min-width: 0;
}

.export-button strong {
  display: block;

  color: var(--text);

  font-size: 12px;
}

.export-button small {
  display: block;

  margin-top: 2px;

  color: var(--muted);

  font-size: 10px;
}


/* =====================================================
   PREVIEW
===================================================== */

.preview-section {
  margin-top: 22px;
}

.preview-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 10px;
}

.preview-header h2 {
  margin: 0;

  color: var(--text);

  font-size: 17px;
}

.preview-header h2 i {
  color: #2563eb;
}

.preview-header p {
  margin: 3px 0 0;

  color: var(--muted);

  font-size: 11px;
}

#formatBadge {
  padding: 6px 10px;

  border-radius: 999px;

  background: var(--icon-bg);

  color: #2563eb;

  font-size: 11px;

  font-weight: 800;

  direction: ltr;
}

.preview-box {
  min-height: 260px;

  padding: 25px 15px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;

  border: 1px solid var(--border);

  border-radius: 17px;

  /*
   * المعاينة نفسها تبقى بيضاء عمدًا
   * حتى يكون الباركود واضحًا وقابلًا للطباعة.
   */
  background: #ffffff;
}

#barcodeSvg {
  display: none;

  max-width: 100%;

  height: auto;
}

#barcodeCanvas {
  display: none;
}

.empty-preview {
  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 8px;

  color: var(--muted);
}

.empty-icon {
  width: 60px;
  height: 60px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background: var(--card-bg-soft);

  color: var(--muted-2);

  font-size: 24px;
}

.empty-preview strong {
  color: var(--text);

  font-size: 14px;
}

.empty-preview span {
  color: var(--muted);

  font-size: 11px;
}


/* =====================================================
   RESET
===================================================== */

.reset-button {
  width: 100%;

  height: 47px;

  margin-top: 13px;

  border: 1px solid var(--border);

  border-radius: 12px;

  background: transparent;

  color: var(--muted);

  font-family: inherit;

  font-size: 13px;

  font-weight: 700;

  cursor: pointer;
}


/* =====================================================
   INFO
===================================================== */

.info-grid {
  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 14px;

  margin-top: 22px;
}

.info-card {
  padding: 20px;

  border: 1px solid var(--border);

  border-radius: 18px;

  background: var(--card-bg);
}

.info-icon {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: var(--icon-bg);

  color: #2563eb;
}

.info-card h2 {
  margin: 10px 0 5px;

  color: var(--text);

  font-size: 15px;
}

.info-card p {
  margin: 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.8;
}


/* =====================================================
   MOBILE
   التصميم نفسه دون تغيير
===================================================== */

@media (max-width:700px) {

  .barcode-page {
    width: calc(100% - 12px);

    padding:
      15px
      0
      45px;
  }

  .hero {
    margin-bottom: 15px;
  }

  .breadcrumb {
    font-size: 11px;
  }

  .hero-icon {
