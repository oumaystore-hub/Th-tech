---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Barcode Generator | مولد الباركود | Th.Tech</title>
  <meta
    name="description"
    content="مولد باركود مجاني لإنشاء باركود احترافي بصيغ متعددة مع إمكانية التحميل بصيغة PNG أو SVG."
  />
  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <!-- مكتبة JsBarcode -->
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"
  ></script>
</head>

<body>
  <Header />

  <main class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-icon">
        <i class="fa-solid fa-barcode"></i>
      </div>

      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>Barcode Generator</span>
      </div>

      <h1>مولد <span>Barcode</span> احترافي</h1>

      <p>
        أنشئ باركود بسرعة وسهولة، واختر النوع والحجم واللون ثم حمّله بصيغة
        PNG أو SVG.
      </p>

      <div class="tags">
        <span><i class="fa-solid fa-bolt"></i> فوري</span>
        <span><i class="fa-solid fa-shield-halved"></i> آمن</span>
        <span><i class="fa-solid fa-cloud-arrow-down"></i> بدون رفع</span>
      </div>
    </section>

    <!-- Tool -->
    <section class="tool-card">

      <div class="tool-header">
        <div class="section-icon">
          <i class="fa-solid fa-barcode"></i>
        </div>

        <div>
          <h2>إنشاء الباركود</h2>
          <p>أدخل القيمة واختر نوع الباركود المناسب.</p>
        </div>
      </div>

      <!-- Type -->
      <div class="field">
        <label for="barcodeType">
          <i class="fa-solid fa-layer-group"></i>
          نوع الباركود
        </label>

        <select id="barcodeType">
          <option value="CODE128">CODE128 — عام</option>
          <option value="CODE39">CODE39</option>
          <option value="EAN13">EAN-13</option>
          <option value="EAN8">EAN-8</option>
          <option value="UPC">UPC-A</option>
          <option value="ITF14">ITF-14</option>
        </select>

        <small id="typeHint">
          مناسب للنصوص والأرقام ومعظم الاستخدامات.
        </small>
      </div>

      <!-- Value -->
      <div class="field">
        <label for="barcodeValue">
          <i class="fa-solid fa-pen"></i>
          القيمة
        </label>

        <div class="input-wrap">
          <input
            id="barcodeValue"
            type="text"
            value="123456789012"
            autocomplete="off"
            spellcheck="false"
            placeholder="أدخل الرقم أو النص..."
          />

          <button id="clearBtn" class="input-clear" type="button" aria-label="مسح">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="field-meta">
          <span id="charCount">12 حرف</span>
          <span id="validationText">جاهز</span>
        </div>
      </div>

      <!-- Settings -->
      <div class="settings-title">
        <i class="fa-solid fa-sliders"></i>
        إعدادات الباركود
      </div>

      <div class="settings-grid">

        <div class="field">
          <label for="barWidth">
            <i class="fa-solid fa-arrows-left-right"></i>
            عرض الخط
          </label>

          <select id="barWidth">
            <option value="1">صغير</option>
            <option value="2" selected>متوسط</option>
            <option value="3">كبير</option>
            <option value="4">كبير جدًا</option>
          </select>
        </div>

        <div class="field">
          <label for="barHeight">
            <i class="fa-solid fa-arrows-up-down"></i>
            الارتفاع
          </label>

          <select id="barHeight">
            <option value="50">50</option>
            <option value="70" selected>70</option>
            <option value="90">90</option>
            <option value="110">110</option>
            <option value="130">130</option>
          </select>
        </div>

        <div class="field">
          <label for="displayValue">
            <i class="fa-solid fa-hashtag"></i>
            إظهار الرقم
          </label>

          <select id="displayValue">
            <option value="true" selected>نعم</option>
            <option value="false">لا</option>
          </select>
        </div>

        <div class="field">
          <label for="fontSize">
            <i class="fa-solid fa-font"></i>
            حجم الرقم
          </label>

          <select id="fontSize">
            <option value="12">صغير</option>
            <option value="16" selected>متوسط</option>
            <option value="20">كبير</option>
            <option value="24">كبير جدًا</option>
          </select>
        </div>

      </div>

      <div class="colors-grid">

        <div class="color-field">
          <label for="lineColor">
            <i class="fa-solid fa-bars-staggered"></i>
            لون الباركود
          </label>

          <div class="color-control">
            <input id="lineColor" type="color" value="#111827" />
            <span id="lineColorText">#111827</span>
          </div>
        </div>

        <div class="color-field">
          <label for="backgroundColor">
            <i class="fa-solid fa-fill-drip"></i>
            لون الخلفية
          </label>

          <div class="color-control">
            <input id="backgroundColor" type="color" value="#ffffff" />
            <span id="backgroundColorText">#FFFFFF</span>
          </div>
        </div>

      </div>

      <!-- Actions -->
      <div class="actions">
        <button id="generateBtn" class="primary-btn" type="button">
          <i class="fa-solid fa-barcode"></i>
          إنشاء Barcode
        </button>

        <button id="resetBtn" class="secondary-btn" type="button">
          <i class="fa-solid fa-rotate-left"></i>
          إعادة ضبط
        </button>
      </div>

      <div id="status" class="status ready">
        <i class="fa-solid fa-circle-check"></i>
        <span>أدخل القيمة لإنشاء الباركود</span>
      </div>

      <!-- Preview -->
      <section class="preview-section">
        <div class="preview-header">
          <div>
            <h2>
              <i class="fa-solid fa-eye"></i>
              المعاينة
            </h2>

            <p>سيظهر الباركود هنا مباشرة.</p>
          </div>

          <span id="formatBadge" class="format-badge">
            CODE128
          </span>
        </div>

        <div id="previewBox" class="preview-box">
          <div id="emptyPreview" class="empty-preview">
            <div class="empty-icon">
              <i class="fa-solid fa-barcode"></i>
            </div>
            <strong>لا توجد معاينة بعد</strong>
            <span>أدخل قيمة صحيحة لإنشاء الباركود</span>
          </div>

          <svg id="barcodeSvg" aria-label="Barcode Preview"></svg>

          <canvas id="barcodeCanvas"></canvas>
        </div>

        <div class="preview-meta">
          <span id="previewInfo">
            CODE128
          </span>

          <span id="previewStatus">
            <i class="fa-solid fa-circle"></i>
            في انتظار الإدخال
          </span>
        </div>

        <!-- Download -->
        <div class="download-title">
          <i class="fa-solid fa-download"></i>
          تصدير الباركود
        </div>

        <div class="download-grid">

          <button id="downloadPng" class="download-btn" type="button">
            <span class="download-icon">
              <i class="fa-solid fa-image"></i>
            </span>
            <strong>PNG</strong>
            <small>صورة</small>
          </button>

          <button id="downloadSvg" class="download-btn" type="button">
            <span class="download-icon">
              <i class="fa-solid fa-vector-square"></i>
            </span>
            <strong>SVG</strong>
            <small>متجه</small>
          </button>

          <button id="copyValue" class="download-btn" type="button">
            <span class="download-icon">
              <i class="fa-solid fa-copy"></i>
            </span>
            <strong>نسخ</strong>
            <small>القيمة</small>
          </button>

        </div>

        <div class="tip">
          <i class="fa-solid fa-camera"></i>
          للحصول على أفضل نتيجة، استخدم خلفية بيضاء وتباينًا واضحًا بين
          الباركود والخلفية.
        </div>
      </section>
    </section>

    <!-- Privacy -->
    <section class="info-card">
      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div>
        <h3>خصوصيتك مهمة</h3>
        <p>
          يتم إنشاء الباركود بالكامل داخل متصفحك. لا يتم إرسال القيمة التي
          تدخلها إلى خوادمنا.
        </p>
      </div>
    </section>

    <!-- How to -->
    <section class="info-card">
      <div class="info-icon">
        <i class="fa-solid fa-list-ol"></i>
      </div>

      <div class="info-content">
        <h3>طريقة الاستخدام</h3>

        <ol>
          <li>اختر نوع الباركود.</li>
          <li>أدخل الرقم أو النص المطلوب.</li>
          <li>اضبط الحجم والمظهر إذا أردت.</li>
          <li>اضغط على إنشاء Barcode.</li>
          <li>حمّل النتيجة بصيغة PNG أو SVG.</li>
        </ol>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="feature">
        <i class="fa-solid fa-bolt"></i>
        <strong>سريع</strong>
        <span>إنشاء فوري</span>
      </div>

      <div class="feature">
        <i class="fa-solid fa-mobile-screen"></i>
        <strong>متجاوب</strong>
        <span>يعمل على الهاتف</span>
      </div>

      <div class="feature">
        <i class="fa-solid fa-lock"></i>
        <strong>خاص</strong>
        <span>بدون رفع البيانات</span>
      </div>

      <div class="feature">
        <i class="fa-solid fa-download"></i>
        <strong>تحميل</strong>
        <span>PNG و SVG</span>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="faq-heading">
        <span>الأسئلة الشائعة</span>
        <i class="fa-regular fa-circle-question"></i>
      </div>

      <details>
        <summary>
          ما هو أفضل نوع للاستخدام العام؟
          <i class="fa-solid fa-plus"></i>
        </summary>
        <p>
          CODE128 خيار ممتاز للاستخدام العام لأنه يدعم الأرقام والحروف
          ويستخدم على نطاق واسع.
        </p>
      </details>

      <details>
        <summary>
          هل يمكن تحميل الباركود كصورة؟
          <i class="fa-solid fa-plus"></i>
        </summary>
        <p>
          نعم، يمكنك تحميله بصيغة PNG أو SVG من قسم التصدير.
        </p>
      </details>

      <details>
        <summary>
          هل يتم حفظ البيانات؟
          <i class="fa-solid fa-plus"></i>
        </summary>
        <p>
          لا. يتم إنشاء الباركود داخل المتصفح ولا تحتاج القيمة إلى الرفع
          إلى خادم خارجي.
        </p>
      </details>

      <details>
        <summary>
          لماذا لا يظهر الباركود أحيانًا؟
          <i class="fa-solid fa-plus"></i>
        </summary>
        <p>
          بعض الأنواع لها شروط خاصة للقيمة، مثل EAN-13 وEAN-8 وUPC.
          استخدم القيمة المناسبة لكل نوع.
        </p>
      </details>
    </section>
  </main>

  <Footer />

  <!-- ========================================================= -->
  <!-- JavaScript - يتم تشغيله في المتصفح فقط -->
  <!-- ========================================================= -->
  <script is:inline>
    (function () {
      function startBarcodeTool() {
        var type = document.getElementById('barcodeType');
        var value = document.getElementById('barcodeValue');
        var width = document.getElementById('barWidth');
        var height = document.getElementById('barHeight');
        var displayValue = document.getElementById('displayValue');
        var fontSize = document.getElementById('fontSize');

        var lineColor = document.getElementById('lineColor');
        var backgroundColor = document.getElementById('backgroundColor');

        var lineColorText = document.getElementById('lineColorText');
        var backgroundColorText = document.getElementById('backgroundColorText');

        var svg = document.getElementById('barcodeSvg');
        var canvas = document.getElementById('barcodeCanvas');

        var emptyPreview = document.getElementById('emptyPreview');

        var generateBtn = document.getElementById('generateBtn');
        var resetBtn = document.getElementById('resetBtn');
        var clearBtn = document.getElementById('clearBtn');

        var downloadPng = document.getElementById('downloadPng');
        var downloadSvg = document.getElementById('downloadSvg');
        var copyValue = document.getElementById('copyValue');

        var status = document.getElementById('status');
        var statusText = status.querySelector('span');

        var charCount = document.getElementById('charCount');
        var validationText = document.getElementById('validationText');

        var formatBadge = document.getElementById('formatBadge');
        var previewInfo = document.getElementById('previewInfo');
        var previewStatus = document.getElementById('previewStatus');

        var typeHint = document.getElementById('typeHint');

        var currentSvg = '';
        var hasBarcode = false;

        var hints = {
          CODE128: 'مناسب للنصوص والأرقام ومعظم الاستخدامات.',
          CODE39: 'مناسب للأحرف الإنجليزية والأرقام وبعض الرموز.',
          EAN13: 'يحتاج إلى 12 أو 13 رقمًا.',
          EAN8: 'يحتاج إلى 7 أو 8 أرقام.',
          UPC: 'يحتاج إلى 11 أو 12 رقمًا.',
          ITF14: 'يحتاج إلى 13 أو 14 رقمًا.'
        };

        function setStatus(message, kind) {
          status.className = 'status ' + kind;

          if (kind === 'success') {
            status.querySelector('i').className =
              'fa-solid fa-circle-check';
          } else if (kind === 'error') {
            status.querySelector('i').className =
              'fa-solid fa-circle-exclamation';
          } else {
            status.querySelector('i').className =
              'fa-solid fa-circle-info';
          }

          statusText.textContent = message;
        }

        function normalizeValue() {
          var selected = type.value;
          var text = value.value.trim();

          if (
            selected === 'EAN13' ||
            selected === 'EAN8' ||
            selected === 'UPC' ||
            selected === 'ITF14'
          ) {
            text = text.replace(/[^0-9]/g, '');
          }

          return text;
        }

        function validate(text) {
          var selected = type.value;

          if (!text) {
            return {
              valid: false,
              message: 'أدخل قيمة أولاً.'
            };
          }

          if (selected === 'EAN13') {
            if (text.length !== 12 && text.length !== 13) {
              return {
                valid: false,
                message: 'EAN-13 يحتاج إلى 12 أو 13 رقمًا.'
              };
            }

            if (!/^[0-9]+$/.test(text)) {
              return {
                valid: false,
                message: 'EAN-13 يقبل الأرقام فقط.'
              };
            }
          }

          if (selected === 'EAN8') {
            if (text.length !== 7 && text.length !== 8) {
              return {
                valid: false,
                message: 'EAN-8 يحتاج إلى 7 أو 8 أرقام.'
              };
            }

            if (!/^[0-9]+$/.test(text)) {
              return {
                valid: false,
                message: 'EAN-8 يقبل الأرقام فقط.'
              };
            }
          }

          if (selected === 'UPC') {
            if (text.length !== 11 && text.length !== 12) {
              return {
                valid: false,
                message: 'UPC-A يحتاج إلى 11 أو 12 رقمًا.'
              };
            }

            if (!/^[0-9]+$/.test(text)) {
              return {
                valid: false,
                message: 'UPC-A يقبل الأرقام فقط.'
              };
            }
          }

          if (selected === 'ITF14') {
            if (text.length !== 13 && text.length !== 14) {
              return {
                valid: false,
                message: 'ITF-14 يحتاج إلى 13 أو 14 رقمًا.'
              };
            }

            if (!/^[0-9]+$/.test(text)) {
              return {
                valid: false,
                message: 'ITF-14 يقبل الأرقام فقط.'
              };
            }
          }

          return {
            valid: true,
            message: 'القيمة صحيحة.'
          };
        }

        function clearPreview() {
          svg.innerHTML = '';
          svg.style.display = 'none';

          canvas.style.display = 'none';

          emptyPreview.style.display = 'flex';

          currentSvg = '';
          hasBarcode = false;

          previewStatus.innerHTML =
            '<i class="fa-solid fa-circle"></i> في انتظار الإدخال';
        }

        function generate() {
          if (
            typeof window.JsBarcode !== 'function'
          ) {
            setStatus(
              'تعذر تحميل مكتبة الباركود. تحقق من اتصال الإنترنت.',
              'error'
            );
            return;
          }

          var selected = type.value;
          var text = normalizeValue();

          var result = validate(text);

          charCount.textContent = text.length + ' حرف';
          validationText.textContent = result.valid
            ? 'صحيح'
            : 'غير صحيح';

          if (!result.valid) {
            clearPreview();
            setStatus(result.message, 'error');
            return;
          }

          try {
            svg.innerHTML = '';

            var options = {
              format: selected,
              width: Number(width.value),
              height: Number(height.value),
              displayValue: displayValue.value === 'true',
              fontSize: Number(fontSize.value),
              lineColor: lineColor.value,
              background: backgroundColor.value,
              margin: 12,
              marginTop: 14,
              marginBottom: 14,
              marginLeft: 14,
              marginRight: 14,
              textMargin: 5
            };

            window.JsBarcode(svg, text, options);

            svg.style.display = 'block';
            canvas.style.display = 'none';
            emptyPreview.style.display = 'none';

            currentSvg = new XMLSerializer().serializeToString(svg);

            hasBarcode = true;

            formatBadge.textContent = selected;
            previewInfo.textContent =
              selected + ' • ' + text.length + ' حرف';

            previewStatus.innerHTML =
              '<i class="fa-solid fa-circle-check"></i> تم إنشاء الباركود بنجاح';

            setStatus(
              'تم إنشاء Barcode بنجاح.',
              'success'
            );
          } catch (error) {
            clearPreview();

            setStatus(
              'القيمة غير مناسبة لنوع الباركود المحدد.',
              'error'
            );
          }
        }

        function updateInterface() {
          typeHint.textContent = hints[type.value] || '';
          formatBadge.textContent = type.value;
          previewInfo.textContent = type.value;

          if (type.value === 'EAN13') {
            value.placeholder = 'مثال: 5901234123457';
          } else if (type.value === 'EAN8') {
            value.placeholder = 'مثال: 96385074';
          } else if (type.value === 'UPC') {
            value.placeholder = 'مثال: 036000291452';
          } else if (type.value === 'ITF14') {
            value.placeholder = 'مثال: 12345678901231';
          } else if (type.value === 'CODE39') {
            value.placeholder = 'مثال: ABC-123';
          } else {
            value.placeholder = 'أدخل الرقم أو النص...';
          }

          generate();
        }

        function downloadFile(blob, filename) {
          var url = URL.createObjectURL(blob);
          var link = document.createElement('a');

          link.href = url;
          link.download = filename;

          document.body.appendChild(link);
          link.click();
          link.remove();

          setTimeout(function () {
            URL.revokeObjectURL(url);
          }, 1000);
        }

        function downloadSVG() {
          if (!hasBarcode || !currentSvg) {
            setStatus(
              'أنشئ الباركود أولاً.',
              'error'
            );
            return;
          }

          var source =
            '<?xml version="1.0" encoding="UTF-8"?>\n' +
            currentSvg;

          var blob = new Blob(
            [source],
            {
              type: 'image/svg+xml;charset=utf-8'
            }
          );

          downloadFile(
            blob,
            'barcode-' + Date.now() + '.svg'
          );

          setStatus(
            'تم تحميل ملف SVG.',
            'success'
          );
        }

        function downloadPNG() {
          if (!hasBarcode) {
            setStatus(
              'أنشئ الباركود أولاً.',
              'error'
            );
            return;
          }

          try {
            var svgText =
              new XMLSerializer().serializeToString(svg);

            var svgBlob = new Blob(
              [svgText],
              {
                type: 'image/svg+xml;charset=utf-8'
              }
            );

            var url = URL.createObjectURL(svgBlob);
            var image = new Image();

            image.onload = function () {
              var scale = 2;

              canvas.width =
                image.width * scale;

              canvas.height =
                image.height * scale;

              var ctx =
                canvas.getContext('2d');

              ctx.fillStyle =
                backgroundColor.value;

              ctx.fillRect(
                0,
                0,
                canvas.width,
                canvas.height
              );

              ctx.drawImage(
                image,
                0,
                0,
                canvas.width,
                canvas.height
              );

              canvas.toBlob(
                function (blob) {
                  if (blob) {
                    downloadFile(
                      blob,
                      'barcode-' +
                        Date.now() +
                        '.png'
                    );

                    setStatus(
                      'تم تحميل ملف PNG.',
                      'success'
                    );
                  }

                  URL.revokeObjectURL(url);
                },
                'image/png'
              );
            };

            image.onerror = function () {
              URL.revokeObjectURL(url);

              setStatus(
                'تعذر تجهيز صورة PNG.',
                'error'
              );
            };

            image.src = url;
          } catch (error) {
            setStatus(
              'تعذر تحميل PNG.',
              'error'
            );
          }
        }

        function copyBarcodeValue() {
          var text = value.value.trim();

          if (!text) {
            setStatus(
              'لا توجد قيمة لنسخها.',
              'error'
            );
            return;
          }

          if (
            navigator.clipboard &&
            navigator.clipboard.writeText
          ) {
            navigator.clipboard.writeText(text)
              .then(function () {
                setStatus(
                  'تم نسخ القيمة بنجاح.',
                  'success'
                );
              })
              .catch(function () {
                fallbackCopy(text);
              });
          } else {
            fallbackCopy(text);
          }
        }

        function fallbackCopy(text) {
          var temp = document.createElement('textarea');

          temp.value = text;
          temp.style.position = 'fixed';
          temp.style.opacity = '0';

          document.body.appendChild(temp);
          temp.select();

          try {
            document.execCommand('copy');

            setStatus(
              'تم نسخ القيمة بنجاح.',
              'success'
            );
          } catch (error) {
            setStatus(
              'تعذر نسخ القيمة.',
              'error'
            );
          }

          temp.remove();
        }

        function reset() {
          type.value = 'CODE128';
          value.value = '123456789012';

          width.value = '2';
          height.value = '70';
          displayValue.value = 'true';
          fontSize.value = '16';

          lineColor.value = '#111827';
          backgroundColor.value = '#ffffff';

          lineColorText.textContent =
            '#111827';

          backgroundColorText.textContent =
            '#FFFFFF';

          updateInterface();
        }

        value.addEventListener(
          'input',
          function () {
            var text = normalizeValue();

            charCount.textContent =
              text.length + ' حرف';

            generate();
          }
        );

        type.addEventListener(
          'change',
          updateInterface
        );

        width.addEventListener(
          'change',
          generate
        );

        height.addEventListener(
          'change',
          generate
        );

        displayValue.addEventListener(
          'change',
          generate
        );

        fontSize.addEventListener(
          'change',
          generate
        );

        lineColor.addEventListener(
          'input',
          function () {
            lineColorText.textContent =
              lineColor.value.toUpperCase();

            generate();
          }
        );

        backgroundColor.addEventListener(
          'input',
          function () {
            backgroundColorText.textContent =
              backgroundColor.value.toUpperCase();

            generate();
          }
        );

        generateBtn.addEventListener(
          'click',
          generate
        );

        resetBtn.addEventListener(
          'click',
          reset
        );

        clearBtn.addEventListener(
          'click',
          function () {
            value.value = '';
            clearPreview();

            charCount.textContent = '0 حرف';
            validationText.textContent =
              'فارغ';

            setStatus(
              'تم مسح القيمة.',
              'info'
            );

            value.focus();
          }
        );

        downloadPng.addEventListener(
          'click',
          downloadPNG
        );

        downloadSvg.addEventListener(
          'click',
          downloadSVG
        );

        copyValue.addEventListener(
          'click',
          copyBarcodeValue
        );

        updateInterface();
      }

      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          startBarcodeTool
        );
      } else {
        startBarcodeTool();
      }
    })();
  </script>

  <style>
    :root {
      --bg: #f3f9fc;
      --surface: #ffffff;
      --surface-2: #f7fbfd;
      --surface-3: #edf7fb;
      --text: #102333;
      --muted: #647786;
      --border: #d8e8ef;
      --primary: #08a9df;
      --primary-dark: #078bc0;
      --success: #159d7c;
      --danger: #e05252;
      --shadow: 0 12px 35px rgba(13, 91, 120, 0.09);
    }

    html.dark-mode {
      --bg: #07111f;
      --surface: #0d1b2b;
      --surface-2: #101f31;
      --surface-3: #13263a;
      --text: #edf7fc;
      --muted: #91a6b7;
      --border: #203b50;
      --primary: #17b9ed;
      --primary-dark: #0b9dcc;
      --success: #25b993;
      --danger: #ff6b6b;
      --shadow: 0 18px 45px rgba(0, 0, 0, 0.24);
    }

    html[data-theme="light"] {
      --bg: #f3f9fc;
      --surface: #ffffff;
      --surface-2: #f7fbfd;
      --surface-3: #edf7fb;
      --text: #102333;
      --muted: #647786;
      --border: #d8e8ef;
      --primary: #08a9df;
      --primary-dark: #078bc0;
      --success: #159d7c;
      --danger: #e05252;
      --shadow: 0 12px 35px rgba(13, 91, 120, 0.09);
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      transition:
        background-color 0.25s ease,
        color 0.25s ease;
    }

    body {
      font-family: "Cairo", sans-serif;
      min-height: 100vh;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .page {
      width: min(1080px, calc(100% - 28px));
      margin: 0 auto;
      padding: 28px 0 70px;
    }

    /* Hero */

    .hero {
      text-align: center;
      padding: 20px 10px 32px;
    }

    .hero-icon {
      width: 76px;
      height: 76px;
      margin: 0 auto 18px;
      display: grid;
      place-items: center;
      border-radius: 24px;
      background: linear-gradient(
        135deg,
        rgba(8, 169, 223, 0.16),
        rgba(8, 169, 223, 0.05)
      );
      border: 1px solid rgba(8, 169, 223, 0.25);
      color: var(--primary);
      font-size: 32px;
      box-shadow: var(--shadow);
    }

    .breadcrumb {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 16px;
    }

    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
    }

    .breadcrumb i {
      font-size: 9px;
      opacity: 0.7;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(28px, 5vw, 44px);
      line-height: 1.4;
      font-weight: 800;
      color: var(--text);
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero p {
      max-width: 690px;
      margin: 12px auto 18px;
      color: var(--muted);
      font-size: 15px;
      line-height: 2;
    }

    .tags {
      display: flex;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tags span {
      padding: 7px 12px;
      border-radius: 30px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 12px;
    }

    .tags i {
      color: var(--primary);
      margin-left: 4px;
    }

    /* Tool card */

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 26px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .tool-header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 25px;
      background: linear-gradient(
        135deg,
        var(--surface-2),
        var(--surface)
      );
      border-bottom: 1px solid var(--border);
    }

    .section-icon {
      width: 58px;
      height: 58px;
      flex: 0 0 58px;
      display: grid;
      place-items: center;
      border-radius: 17px;
      background: rgba(8, 169, 223, 0.12);
      color: var(--primary);
      font-size: 23px;
    }

    .tool-header h2 {
      margin: 0 0 4px;
      font-size: 21px;
    }

    .tool-header p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .field {
      padding: 20px 25px 0;
    }

    .field label,
    .color-field label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 9px;
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
    }

    .field label i,
    .color-field label i {
      color: var(--primary);
    }

    select,
    input[type="text"] {
      width: 100%;
      height: 52px;
      border: 1px solid var(--border);
      border-radius: 14px;
      outline: none;
      background: var(--surface-2);
      color: var(--text);
      padding: 0 15px;
      transition: 0.2s ease;
    }

    select:focus,
    input[type="text"]:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(8, 169, 223, 0.1);
    }

    .field small {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-size: 11px;
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      padding-left: 50px;
      direction: ltr;
      text-align: left;
      font-family: "JetBrains Mono", monospace;
      font-size: 15px;
    }

    .input-clear {
      position: absolute;
      left: 8px;
      top: 8px;
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 10px;
      background: var(--surface-3);
      color: var(--muted);
      cursor: pointer;
    }

    .field-meta {
      display: flex;
      justify-content: space-between;
      margin-top: 8px;
      color: var(--muted);
      font-size: 11px;
    }

    .settings-title {
      margin: 28px 25px 0;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
      font-size: 16px;
      font-weight: 800;
    }

    .settings-title i {
      color: var(--primary);
      margin-left: 7px;
    }

    .settings-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }

    .colors-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      padding: 20px 25px 0;
    }

    .color-field {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 14px;
    }

    .color-control {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .color-control input {
      width: 50px;
      height: 40px;
      padding: 3px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface);
      cursor: pointer;
    }

    .color-control span {
      direction: ltr;
      font-family: "JetBrains Mono", monospace;
      color: var(--muted);
      font-size: 12px;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 25px;
    }

    .primary-btn,
    .secondary-btn {
      min-height: 56px;
      border-radius: 15px;
      border: 0;
      cursor: pointer;
      font-weight: 800;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .primary-btn {
      color: white;
      background: linear-gradient(
        135deg,
        var(--primary),
        var(--primary-dark)
      );
      box-shadow: 0 10px 25px rgba(8, 169, 223, 0.22);
    }

    .secondary-btn {
      color: var(--text);
      background: var(--surface-3);
      border: 1px solid var(--border);
    }

    .primary-btn:hover,
    .secondary-btn:hover,
    .download-btn:hover {
      transform: translateY(-2px);
    }

    .primary-btn i,
    .secondary-btn i {
      margin-left: 7px;
    }

    .status {
      margin: 0 25px 25px;
      padding: 13px 15px;
      border-radius: 13px;
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 13px;
    }

    .status.ready,
    .status.info {
      background: var(--surface-3);
      color: var(--muted);
    }

    .status.success {
      background: rgba(21, 157, 124, 0.1);
      color: var(--success);
    }

    .status.error {
      background: rgba(224, 82, 82, 0.1);
      color: var(--danger);
    }

    /* Preview */

    .preview-section {
      border-top: 1px solid var(--border);
      padding: 26px 25px 30px;
      background: var(--surface-2);
    }

    .preview-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 18px;
    }

    .preview-header h2 {
      margin: 0 0 3px;
      font-size: 20px;
    }

    .preview-header h2 i {
      color: var(--primary);
      margin-left: 6px;
    }

    .preview-header p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
    }

    .format-badge {
      padding: 7px 11px;
      border-radius: 9px;
      background: rgba(8, 169, 223, 0.11);
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
      font-weight: 700;
    }

    .preview-box {
      min-height: 285px;
      width: 100%;
      border: 2px dashed #bcd8e4;
      border-radius: 25px;
      background: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 25px;
      overflow: hidden;
    }

    html.dark-mode .preview-box {
      background: #ffffff;
      border-color: #527487;
    }

    #barcodeSvg {
      display: none;
      width: min(100%, 720px);
      height: auto;
      max-height: 230px;
    }

    #barcodeCanvas {
      display: none;
      max-width: 100%;
      height: auto;
    }

    .empty-preview {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 8px;
      color: #78909c;
    }

    .empty-icon {
      width: 65px;
      height: 65px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: #edf7fb;
      color: #08a9df;
      font-size: 27px;
      margin-bottom: 4px;
    }

    .empty-preview strong {
      color: #516b78;
      font-size: 14px;
    }

    .empty-preview span {
      font-size: 11px;
    }

    .preview-meta {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin: 13px 2px 25px;
      color: var(--muted);
      font-size: 11px;
    }

    .preview-meta #previewInfo {
      font-family: "JetBrains Mono", monospace;
    }

    .preview-status i {
      font-size: 7px;
      margin-left: 4px;
    }

    .download-title {
      margin-bottom: 13px;
      font-weight: 800;
      font-size: 16px;
    }

    .download-title i {
      color: var(--primary);
      margin-left: 6px;
    }

    .download-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .download-btn {
      min-height: 105px;
      border: 1px solid var(--border);
      border-radius: 17px;
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      transition: 0.2s ease;
    }

    .download-icon {
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(8, 169, 223, 0.1);
      color: var(--primary);
      font-size: 18px;
      margin-bottom: 2px;
    }

    .download-btn strong {
      font-size: 13px;
    }

    .download-btn small {
      color: var(--muted);
      font-size: 10px;
    }

    .tip {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-top: 18px;
      padding: 14px;
      border-radius: 14px;
      background: rgba(8, 169, 223, 0.08);
      border: 1px solid rgba(8, 169, 223, 0.17);
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }

    .tip i {
      color: var(--primary);
      margin-top: 4px;
    }

    /* Info */

    .info-card {
      display: flex;
      align-items: flex-start;
      gap: 15px;
      margin-top: 18px;
      padding: 22px;
      border-radius: 21px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .info-icon {
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(8, 169, 223, 0.1);
      color: var(--primary);
    }

    .info-card h3 {
      margin: 0 0 5px;
      font-size: 16px;
    }

    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    .info-content ol {
      margin: 10px 0 0;
      padding-right: 20px;
      color: var(--muted);
      font-size: 12px;
      line-height: 2.2;
    }

    /* Features */

    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 18px;
    }

    .feature {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 5px;
      padding: 19px 10px;
      border-radius: 18px;
      background: var(--surface);
      border: 1px solid var(--border);
    }

    .feature i {
      color: var(--primary);
      font-size: 19px;
      margin-bottom: 3px;
    }

    .feature strong {
      font-size: 12px;
    }

    .feature span {
      color: var(--muted);
      font-size: 10px;
    }

    /* FAQ */

    .faq-section {
      margin-top: 34px;
    }

    .faq-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-size: 21px;
      font-weight: 800;
    }

    .faq-heading i {
      color: var(--primary);
    }

    details {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      margin-bottom: 9px;
      overflow: hidden;
    }

    summary {
      min-height: 54px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      cursor: pointer;
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);
      transition: transform 0.2s ease;
    }

    details[open] summary i {
      transform: rotate(45deg);
    }

    details p {
      margin: 0;
      padding: 0 16px 17px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }

    /* Responsive */

    @media (max-width: 800px) {
      .settings-grid {
        grid-template-columns: 1fr 1fr;
      }

      .features {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 560px) {
      .page {
        width: min(100% - 18px, 1080px);
        padding-top: 15px;
      }

      .hero {
        padding: 14px 5px 24px;
      }

      .hero-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
      }

      .hero h1 {
        font-size: 27px;
      }

      .hero p {
        font-size: 12px;
        line-height: 1.9;
      }

      .tool-card {
        border-radius: 20px;
      }

      .tool-header {
        padding: 19px 16px;
        gap: 12px;
      }

      .section-icon {
        width: 48px;
        height: 48px;
        flex-basis: 48px;
        border-radius: 14px;
        font-size: 19px;
      }

      .tool-header h2 {
        font-size: 17px;
      }

      .tool-header p {
        font-size: 11px;
      }

      .field {
        padding: 17px 15px 0;
      }

      .field label,
      .color-field label {
        font-size: 13px;
      }

      .settings-title {
        margin-right: 15px;
        margin-left: 15px;
      }

      .settings-grid {
        grid-template-columns: 1fr 1fr;
      }

      .colors-grid {
        grid-template-columns: 1fr;
        padding: 17px 15px 0;
      }

      .actions {
        grid-template-columns: 1fr;
        padding: 20px 15px;
      }

      .status {
        margin: 0 15px 20px;
      }

      .preview-section {
        padding: 20px 15px 23px;
      }

      .preview-header h2 {
        font-size: 17px;
      }

      .preview-box {
        min-height: 240px;
        padding: 18px 10px;
        border-radius: 19px;
      }

      #barcodeSvg {
        max-height: 180px;
      }

      .download-grid {
        gap: 8px;
      }

      .download-btn {
        min-height: 92px;
      }

      .download-icon {
        width: 38px;
        height: 38px;
        font-size: 16px;
      }

      .info-card {
        padding: 17px;
        border-radius: 18px;
      }

      .features {
        gap: 8px;
      }

      .feature {
        padding: 16px 7px;
      }

      .feature strong {
        font-size: 11px;
      }

      .faq-heading {
        font-size: 19px;
      }
    }

    @media (max-width: 360px) {
      .settings-grid {
        grid-template-columns: 1fr;
      }

      .download-grid {
        grid-template-columns: 1fr;
      }

      .features {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</body>
</html>
