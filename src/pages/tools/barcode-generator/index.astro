        place-items: center;

        border-radius: 9px;

        color: #ffffff;

        background: var(--primary);

        font-size: 0.72rem;
        font-weight: 800;
      }


      .step h3 {
        margin: 0 0 3px;

        font-size: 0.82rem;
      }


      .step p {
        margin: 0;

        color: var(--muted);

        font-size: 0.67rem;
      }


      /* FEATURES */

      .features-grid {
        display: grid;

        grid-template-columns:
          repeat(4, minmax(0, 1fr));

        gap: 13px;
      }


      .feature {
        padding: 20px 16px;

        border-radius: 18px;

        background: var(--surface);

        border: 1px solid var(--border);

        text-align: center;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }


      .feature:hover {
        transform: translateY(-3px);

        box-shadow: var(--shadow);
      }


      .feature-icon {
        width: 44px;
        height: 44px;

        display: grid;
        place-items: center;

        margin: 0 auto 11px;

        border-radius: 13px;

        color: var(--primary);

        background: var(--primary-soft);
      }


      .feature h3 {
        margin: 0 0 4px;

        font-size: 0.82rem;
      }


      .feature p {
        margin: 0;

        color: var(--muted);

        font-size: 0.65rem;
      }


      /* FAQ */

      .faq-list {
        display: grid;

        gap: 10px;
      }


      .faq-list details {
        overflow: hidden;

        border: 1px solid var(--border);

        border-radius: 15px;

        background: var(--surface);

        transition:
          border-color 0.2s ease,
          background 0.2s ease;
      }


      .faq-list details[open] {
        border-color:
          rgba(37, 99, 235, 0.30);

        background: var(--surface-2);
      }


      .faq-list summary {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 15px 17px;

        cursor: pointer;

        list-style: none;

        font-size: 0.78rem;
        font-weight: 700;
      }


      .faq-list summary::-webkit-details-marker {
        display: none;
      }


      .faq-list summary i {
        color: var(--muted);

        font-size: 0.65rem;

        transition: transform 0.2s ease;
      }


      .faq-list details[open] summary i {
        transform: rotate(180deg);

        color: var(--primary);
      }


      .faq-list details p {
        margin: 0;

        padding:
          0
          17px
          17px;

        color: var(--muted);

        font-size: 0.72rem;
      }


      /* TABLET */

      @media (max-width: 850px) {

        .page {
          width: min(100% - 24px, 720px);

          padding-top: 28px;
        }


        .tool-card {
          padding: 20px;
        }


        .steps {
          grid-template-columns:
            1fr;
        }


        .features-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }

      }


      /* MOBILE */

      @media (max-width: 700px) {

        .page {
          width: calc(100% - 14px);

          padding:
            20px
            0
            45px;
        }


        .hero {
          margin-bottom: 20px;
        }


        .hero-icon {
          width: 57px;
          height: 57px;

          border-radius: 17px;

          font-size: 23px;
        }


        .breadcrumb {
          font-size: 0.68rem;

          gap: 6px;
        }


        .hero h1 {
          font-size: 1.65rem;
        }


        .hero > p {
          font-size: 0.76rem;

          line-height: 1.8;
        }


        .hero-tags {
          gap: 5px;
        }


        .hero-tags span {
          padding: 5px 8px;

          font-size: 0.62rem;
        }


        .tool-card {
          padding: 12px;

          border-radius: 21px;
        }


        .field {
          margin-bottom: 14px;
        }


        .field label {
          font-size: 0.75rem;

          margin-bottom: 6px;
        }


        select,
        input[type="text"] {
          height: 46px;

          border-radius: 12px;

          font-size: 0.78rem;
        }


        .options-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 8px;

          margin:
            16px 0
            12px;
        }


        .options-card {
          padding: 11px;

          border-radius: 16px;
        }


        .options-card:hover {
          transform: none;
        }


        .section-heading {
          gap: 7px;

          margin-bottom: 12px;
        }


        .section-icon {
          width: 31px;
          height: 31px;

          border-radius: 9px;

          font-size: 11px;
        }


        .section-heading h3 {
          font-size: 0.72rem;

          line-height: 1.25;
        }


        .section-heading span {
          margin-top: 1px;

          font-size: 0.52rem;
        }


        .settings-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 7px;
        }


        .mini-field label {
          margin-bottom: 4px;

          font-size: 0.54rem;
        }


        .mini-select select {
          height: 34px;

          padding:
            0
            22px
            0
            6px;

          border-radius: 8px;

          font-size: 0.61rem;
        }


        .mini-select i {
          right: 7px;

          font-size: 0.45rem;
        }


        .colors-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 7px;

          margin-top: 8px;
        }


        .color-box {
          padding: 6px;

          border-radius: 8px;
        }


        .color-box label {
          margin-bottom: 4px;

          font-size: 0.49rem;
        }


        .color-control {
          gap: 4px;
        }


        .color-control input[type="color"] {
          width: 22px;
          height: 22px;

          border-radius: 6px;
        }


        .color-control span {
          font-size: 0.46rem;
        }


        .download-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 7px;
        }


        .export-btn {
          min-height: 55px;

          gap: 5px;

          padding: 7px;

          border-radius: 10px;
        }


        .export-btn-icon {
          width: 27px;
          height: 27px;

          border-radius: 8px;

          font-size: 10px;
        }


        .export-btn-content strong {
          font-size: 0.59rem;
        }


        .export-btn-content small {
          font-size: 0.46rem;
        }


        .export-tip {
          align-items: flex-start;

          gap: 4px;

          margin-top: 7px;

          font-size: 0.48rem;

          line-height: 1.5;
        }


        .main-actions {
          grid-template-columns:
            minmax(0, 1.6fr)
            minmax(80px, 1fr);

          gap: 7px;

          margin:
            14px 0
            7px;
        }


        .generate-btn,
        .reset-btn {
          min-height: 45px;

          border-radius: 11px;

          font-size: 0.7rem;
        }


        .generate-btn i,
        .reset-btn i {
          margin-left: 3px;
        }


        .status {
          min-height: 30px;

          margin:
            3px 0
            12px;

          font-size: 0.62rem;
        }


        .preview-section {
          padding: 11px;

          border-radius: 15px;
        }


        .preview-heading {
          margin-bottom: 10px;
        }


        .preview-heading h2 {
          font-size: 0.76rem;
        }


        .preview-heading p {
          font-size: 0.54rem;
        }


        .format-badge {
          padding: 4px 7px;

          font-size: 0.5rem;
        }


        .preview-box {
          min-height: 190px;

          padding: 17px;

          border-radius: 13px;
        }


        .empty-icon {
          width: 46px;
          height: 46px;

          border-radius: 13px;

          font-size: 19px;
        }


        .empty-preview strong {
          font-size: 0.68rem;
        }


        .empty-preview span {
          font-size: 0.55rem;
        }


        .preview-meta {
          gap: 5px 9px;

          margin-top: 8px;

          font-size: 0.49rem;
        }


        .info-card {
          gap: 10px;

          margin-top: 13px;

          padding: 14px;

          border-radius: 15px;
        }


        .info-icon {
          width: 34px;
          height: 34px;

          border-radius: 9px;

          font-size: 12px;
        }


        .info-card h2 {
          font-size: 0.76rem;
        }


        .info-card p {
          font-size: 0.6rem;

          line-height: 1.7;
        }


        .content-section,
        .faq-section {
          margin-top: 33px;
        }


        .content-heading {
          gap: 9px;

          margin-bottom: 13px;
        }


        .content-number {
          width: 34px;
          height: 34px;

          border-radius: 9px;

          font-size: 0.59rem;
        }


        .content-heading h2 {
          font-size: 0.92rem;
        }


        .content-heading p {
          font-size: 0.57rem;
        }


        .step {
          padding: 12px;

          border-radius: 13px;
        }


        .step-number {
          width: 27px;
          height: 27px;

          border-radius: 8px;

          font-size: 0.61rem;
        }


        .step h3 {
          font-size: 0.7rem;
        }


        .step p {
          font-size: 0.57rem;

          line-height: 1.7;
        }


        .features-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 8px;
        }


        .feature {
          padding: 14px 9px;

          border-radius: 13px;
        }


        .feature-icon {
          width: 35px;
          height: 35px;

          margin-bottom: 7px;

          border-radius: 9px;

          font-size: 12px;
        }


        .feature h3 {
          font-size: 0.68rem;
        }


        .feature p {
          font-size: 0.52rem;

          line-height: 1.6;
        }


        .faq-list {
          gap: 7px;
        }


        .faq-list summary {
          padding: 12px;

          font-size: 0.65rem;
        }


        .faq-list details p {
          padding:
            0
            12px
            12px;

          font-size: 0.59rem;

          line-height: 1.8;
        }

      }


      /* VERY SMALL PHONES
         Keep both cards and all buttons 2×2,
         but reduce internal spacing only. */

      @media (max-width: 380px) {

        .page {
          width: calc(100% - 8px);
        }


        .tool-card {
          padding: 9px;
        }


        .options-grid {
          gap: 6px;
        }


        .options-card {
          padding: 8px;

          border-radius: 14px;
        }


        .section-heading {
          gap: 5px;
        }


        .section-icon {
          width: 27px;
          height: 27px;

          font-size: 9px;
        }


        .section-heading h3 {
          font-size: 0.63rem;
        }


        .section-heading span {
          display: none;
        }


        .settings-grid,
        .colors-grid,
        .download-grid {
          gap: 5px;
        }


        .mini-field label {
          font-size: 0.48rem;
        }


        .mini-select select {
          font-size: 0.55rem;
        }


        .export-btn {
          min-height: 50px;

          padding: 5px;

          gap: 4px;
        }


        .export-btn-icon {
          width: 23px;
          height: 23px;

          font-size: 8px;
        }


        .export-btn-content strong {
          font-size: 0.53rem;
        }


        .export-btn-content small {
          font-size: 0.42rem;
        }


        .color-box {
          padding: 5px;
        }


        .color-control input[type="color"] {
          width: 19px;
          height: 19px;
        }


        .color-control span {
          font-size: 0.4rem;
        }

      }
    </style>
  </body>
</html>
