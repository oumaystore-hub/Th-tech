</style>


<script is:inline>

function startBarcodeTool() {

  const type =
    document.getElementById('barcodeType');

  const value =
    document.getElementById('barcodeValue');

  const width =
    document.getElementById('barWidth');

  const height =
    document.getElementById('barHeight');

  const display =
    document.getElementById('displayValue');

  const fontSize =
    document.getElementById('fontSize');

  const lineColor =
    document.getElementById('lineColor');

  const background =
    document.getElementById('backgroundColor');

  const svg =
    document.getElementById('barcodeSvg');

  const canvas =
    document.getElementById('barcodeCanvas');

  const empty =
    document.getElementById('emptyPreview');

  const status =
    document.getElementById('status');

  const badge =
    document.getElementById('formatBadge');


  function setStatus(text, error = false) {

    status.textContent = text;

    status.style.color =
      error
        ? '#ef4444'
        : '';

  }


  function validate() {

    const v =
      value.value.trim();

    const t =
      type.value;


    if (!v) {
      return 'يرجى إدخال قيمة الباركود.';
    }


    if (
      t === 'EAN13' &&
      !/^\d{12,13}$/.test(v)
    ) {
      return 'EAN13 يحتاج إلى 12 أو 13 رقمًا.';
    }


    if (
      t === 'EAN8' &&
      !/^\d{7,8}$/.test(v)
    ) {
      return 'EAN8 يحتاج إلى 7 أو 8 أرقام.';
    }


    if (
      t === 'UPC' &&
      !/^\d{11,12}$/.test(v)
    ) {
      return 'UPC يحتاج إلى 11 أو 12 رقمًا.';
    }


    if (
      t === 'ITF14' &&
      !/^\d{13,14}$/.test(v)
    ) {
      return 'ITF14 يحتاج إلى 13 أو 14 رقمًا.';
    }


    if (
      t === 'CODE39' &&
      !/^[0-9A-Z .\-$\/+%]+$/.test(v)
    ) {
      return 'قيمة CODE39 غير صالحة.';
    }


    return null;

  }


  function clearPreview() {

    svg.innerHTML = '';

    svg.style.display = 'none';

    canvas.style.display = 'none';

    empty.style.display = 'flex';

  }


  function generate() {

    if (
      typeof window.JsBarcode !== 'function'
    ) {

      setStatus(
        'لم يتم تحميل مكتبة الباركود.',
        true
      );

      return false;

    }


    const error =
      validate();


    if (error) {

      clearPreview();

      setStatus(error, true);

      return false;

    }


    try {

      svg.innerHTML = '';


      window.JsBarcode(
        svg,
        value.value.trim(),
        {
          format: type.value,

          width:
            Number(width.value),

          height:
            Number(height.value),

          displayValue:
            display.value === 'true',

          fontSize:
            Number(fontSize.value),

          lineColor:
            lineColor.value,

          background:
            background.value,

          margin: 12,

          textMargin: 6,

          font: 'Cairo'
        }
      );


      svg.setAttribute(
        'xmlns',
        'http://www.w3.org/2000/svg'
      );


      svg.setAttribute(
        'xmlns:xlink',
        'http://www.w3.org/1999/xlink'
      );


      svg.style.display = 'block';

      empty.style.display = 'none';

      badge.textContent =
        type.value;

      setStatus(
        'تم إنشاء الباركود بنجاح'
      );

      return true;

    } catch (error) {

      console.error(error);

      clearPreview();

      setStatus(
        'القيمة غير صالحة لهذا النوع.',
        true
      );

      return false;

    }

  }


  function getSVGString() {

    if (
      !svg.innerHTML.trim()
    ) {
      return null;
    }


    const clone =
      svg.cloneNode(true);


    clone.setAttribute(
      'xmlns',
      'http://www.w3.org/2000/svg'
    );


    clone.setAttribute(
      'xmlns:xlink',
      'http://www.w3.org/1999/xlink'
    );


    let widthValue =
      parseFloat(
        clone.getAttribute('width')
      );


    let heightValue =
      parseFloat(
        clone.getAttribute('height')
      );


    const viewBox =
      clone.getAttribute('viewBox');


    if (
      viewBox &&
      (!widthValue || !heightValue)
    ) {

      const parts =
        viewBox
          .trim()
          .split(/\s+/)
          .map(Number);


      if (
        parts.length === 4
      ) {

        widthValue =
          parts[2];

        heightValue =
          parts[3];

      }

    }


    widthValue =
      widthValue ||
      600;


    heightValue =
      heightValue ||
      200;


    clone.setAttribute(
      'width',
      String(widthValue)
    );


    clone.setAttribute(
      'height',
      String(heightValue)
    );


    if (!clone.getAttribute('viewBox')) {

      clone.setAttribute(
        'viewBox',
        `0 0 ${widthValue} ${heightValue}`
      );

    }


    return new XMLSerializer()
      .serializeToString(clone);

  }


  function saveBlob(
    blob,
    filename
  ) {

    const url =
      URL.createObjectURL(blob);


    const link =
      document.createElement('a');


    link.href = url;

    link.download = filename;

    link.rel = 'noopener';

    link.style.display = 'none';


    document.body.appendChild(link);

    link.click();


    setTimeout(() => {

      link.remove();

      URL.revokeObjectURL(url);

    }, 1500);

  }


  function exportSVG() {

    if (!generate()) {
      return;
    }


    const svgString =
      getSVGString();


    if (!svgString) {

      setStatus(
        'لا توجد معاينة لتصديرها.',
        true
      );

      return;

    }


    const blob =
      new Blob(
        [svgString],
        {
          type:
            'image/svg+xml;charset=utf-8'
        }
      );


    saveBlob(
      blob,
      'barcode.svg'
    );


    setStatus(
      'تم تحميل SVG'
    );

  }


  function exportPNG() {

    if (!generate()) {
      return;
    }


    const svgString =
      getSVGString();


    if (!svgString) {

      setStatus(
        'لا توجد معاينة لتصديرها.',
        true
      );

      return;

    }


    const svgBlob =
      new Blob(
        [svgString],
        {
          type:
            'image/svg+xml;charset=utf-8'
        }
      );


    const url =
      URL.createObjectURL(svgBlob);


    const image =
      new Image();


    image.onload = function() {

      const originalWidth =
        image.naturalWidth ||
        600;


      const originalHeight =
        image.naturalHeight ||
        200;


      const scale = 3;


      canvas.width =
        originalWidth * scale;


      canvas.height =
        originalHeight * scale;


      const ctx =
        canvas.getContext('2d');


      ctx.setTransform(
        scale,
        0,
        0,
        scale,
        0,
        0
      );


      ctx.fillStyle =
        background.value ||
        '#ffffff';


      ctx.fillRect(
        0,
        0,
        originalWidth,
        originalHeight
      );


      ctx.drawImage(
        image,
        0,
        0,
        originalWidth,
        originalHeight
      );


      canvas.toBlob(
        function(blob) {

          URL.revokeObjectURL(url);


          if (!blob) {

            setStatus(
              'تعذر إنشاء ملف PNG.',
              true
            );

            return;

          }


          saveBlob(
            blob,
            'barcode.png'
          );


          setStatus(
            'تم تحميل PNG'
          );

        },
        'image/png',
        1
      );

    };


    image.onerror = function() {

      URL.revokeObjectURL(url);

      setStatus(
        'تعذر تجهيز صورة PNG.',
        true
      );

    };


    image.src = url;

  }


  async function copyValue() {

    const text =
      value.value.trim();


    if (!text) {

      setStatus(
        'لا توجد قيمة لنسخها.',
        true
      );

      return;

    }


    try {

      if (
        navigator.clipboard &&
        window.isSecureContext
      ) {

        await navigator.clipboard.writeText(
          text
        );

      } else {

        const textarea =
          document.createElement('textarea');

        textarea.value = text;

        textarea.style.position =
          'fixed';

        textarea.style.opacity =
          '0';

        document.body.appendChild(
          textarea
        );

        textarea.select();

        document.execCommand('copy');

        textarea.remove();

      }


      setStatus(
        'تم نسخ القيمة'
      );

    } catch {

      setStatus(
        'تعذر النسخ.',
        true
      );

    }

  }


  function reset() {

    type.value =
      'CODE128';

    value.value =
      '123456789012';

    width.value =
      '2';

    height.value =
      '70';

    display.value =
      'true';

    fontSize.value =
      '16';

    lineColor.value =
      '#111827';

    background.value =
      '#ffffff';


    generate();

  }


  document
    .getElementById('generateBtn')
    .addEventListener(
      'click',
      generate
    );


  document
    .getElementById('clearBtn')
    .addEventListener(
      'click',
      () => {

        value.value = '';

        clearPreview();

        setStatus(
          'تم مسح القيمة'
        );

      }
    );


  document
    .getElementById('downloadSvg')
    .addEventListener(
      'click',
      exportSVG
    );


  document
    .getElementById('downloadPng')
    .addEventListener(
      'click',
      exportPNG
    );


  document
    .getElementById('copyValue')
    .addEventListener(
      'click',
      copyValue
    );


  document
    .getElementById('resetBtn')
    .addEventListener(
      'click',
      reset
    );


  document
    .getElementById('resetBtnMain')
    .addEventListener(
      'click',
      reset
    );


  type.addEventListener(
    'change',
    generate
  );


  [
    width,
    height,
    display,
    fontSize,
    lineColor,
    background
  ].forEach(
    element => {

      element.addEventListener(
        'change',
        generate
      );

    }
  );


  value.addEventListener(
    'keydown',
    event => {

      if (
        event.key === 'Enter'
      ) {

        generate();

      }

    }
  );


  generate();

}


if (
  document.readyState === 'loading'
) {

  document.addEventListener(
    'DOMContentLoaded',
    startBarcodeTool
  );

} else {

  startBarcodeTool();

}

</script>

