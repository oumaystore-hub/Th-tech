---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Barcode Generator | مولد الباركود | Th.Tech</title>

  <meta
    name="description"
    content="مولد باركود مجاني لإنشاء باركود احترافي بصيغ CODE128 وEAN وUPC وCODE39 وغيرها."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <!-- Barcode library -->
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"
  ></script>
</head>

<body>

  <Header />

  <main class="barcode-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-barcode"></i>
        أداة Barcode Generator
      </div>

      <h1>
        مولد <span>Barcode</span> احترافي
      </h1>

      <p>
        أنشئ باركود جاهزًا للاستخدام والطباعة خلال ثوانٍ،
        مع دعم أشهر أنواع الباركود وتصديره كصورة.
      </p>

      <div class="hero-points">

        <span>
          <i class="fa-solid fa-bolt"></i>
          إنشاء فوري
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          خصوصية كاملة
        </span>

        <span>
          <i class="fa-solid fa-download"></i>
          PNG و SVG
        </span>

      </div>

    </section>


    <!-- MAIN TOOL -->
    <section class="tool">

      <div class="tool-top">

        <div>
          <div class="mini-label">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            مولد الباركود
          </div>

          <h2>أنشئ Barcode الخاص بك</h2>

          <p>
            أدخل القيمة واختر نوع الباركود ثم قم بتخصيص المظهر.
          </p>
        </div>

        <div class="status" id="status">
          <span></span>
          جاهز
        </div>

      </div>


      <!-- WORKSPACE -->
      <div class="workspace">


        <!-- INPUT -->
        <div class="editor">

          <div class="block-head">

            <div class="block-icon">
              <i class="fa-solid fa-pen-to-square"></i>
            </div>

            <div>
              <h3>بيانات الباركود</h3>
              <p>أدخل القيمة التي تريد تحويلها إلى Barcode</p>
            </div>

          </div>


          <!-- VALUE -->
          <div class="field">

            <label for="barcodeValue">
              القيمة
              <b>*</b>
            </label>

            <input
              id="barcodeValue"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="مثال: 123456789"
            />

            <div class="field-meta">
              <span id="valueCount">0 حرف</span>
              <span id="valueHint">أدخل قيمة للبدء</span>
            </div>

          </div>


          <!-- FORMAT -->
          <div class="field">

            <label for="formatSelect">
              نوع الباركود
            </label>

            <select id="formatSelect">

              <option value="CODE128" selected>
                CODE128 — عام
              </option>

              <option value="CODE128A">
                CODE128A
              </option>

              <option value="CODE128B">
                CODE128B
              </option>

              <option value="CODE128C">
                CODE128C — أرقام
              </option>

              <option value="EAN13">
                EAN-13
              </option>

              <option value="EAN8">
                EAN-8
              </option>

              <option value="EAN5">
                EAN-5
              </option>

              <option value="EAN2">
                EAN-2
              </option>

              <option value="UPC">
                UPC
              </option>

              <option value="CODE39">
                CODE39
              </option>

              <option value="ITF14">
                ITF-14
              </option>

              <option value="ITF">
                ITF
              </option>

              <option value="MSI">
                MSI
              </option>

              <option value="MSI10">
                MSI10
              </option>

              <option value="MSI11">
                MSI11
              </option>

              <option value="MSI1010">
                MSI1010
              </option>

              <option value="MSI1110">
                MSI1110
              </option>

              <option value="pharmacode">
                Pharmacode
              </option>

            </select>

            <div class="hint" id="formatHint">
              مناسب لمعظم النصوص والأرقام.
            </div>

          </div>


          <!-- SETTINGS -->
          <div class="settings">

            <div class="settings-head">

              <i class="fa-solid fa-sliders"></i>

              <span>إعدادات المظهر</span>

            </div>


            <div class="settings-grid">

              <div class="setting">

                <label for="lineWidth">
                  عرض الخط
                </label>

                <select id="lineWidth">

                  <option value="1">1</option>
                  <option value="2" selected>2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>

                </select>

              </div>


              <div class="setting">

                <label for="barHeight">
                  الارتفاع
                </label>

                <select id="barHeight">

                  <option value="50">صغير</option>
                  <option value="80" selected>متوسط</option>
                  <option value="110">كبير</option>
                  <option value="140">كبير جدًا</option>

                </select>

              </div>


              <div class="setting">

                <label for="fontSize">
                  حجم الرقم
                </label>

                <select id="fontSize">

                  <option value="10">صغير</option>
                  <option value="14" selected>متوسط</option>
                  <option value="18">كبير</option>
                  <option value="22">كبير جدًا</option>

                </select>

              </div>

            </div>


            <div class="check-row">

              <label class="check">

                <input
                  type="checkbox"
                  id="showText"
                  checked
                />

                <span>إظهار الرقم أسفل الباركود</span>

              </label>

              <label class="check">

                <input
                  type="checkbox"
                  id="flatMode"
                />

                <span>إلغاء الزوايا البيضاء الإضافية</span>

              </label>

            </div>

          </div>


          <!-- COLORS -->
          <div class="colors">

            <div class="settings-head">

              <i class="fa-solid fa-palette"></i>

              <span>الألوان</span>

            </div>


            <div class="color-grid">

              <div class="color-item">

                <label for="lineColor">
                  لون الباركود
                </label>

                <div class="color-control">

                  <input
                    id="lineColor"
                    type="color"
                    value="#07111f"
                  />

                  <span id="lineColorText">#07111F</span>

                </div>

              </div>


              <div class="color-item">

                <label for="backgroundColor">
                  لون الخلفية
                </label>

                <div class="color-control">

                  <input
                    id="backgroundColor"
                    type="color"
                    value="#ffffff"
                  />

                  <span id="backgroundColorText">#FFFFFF</span>

                </div>

              </div>

            </div>

          </div>


          <!-- ACTIONS -->
          <div class="actions">

            <button
              type="button"
              class="reset-btn"
              id="resetBtn"
            >
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

            <button
              type="button"
              class="generate-btn"
              id="generateBtn"
            >
              <i class="fa-solid fa-barcode"></i>
              إنشاء Barcode
            </button>

          </div>


          <div
            class="message"
            id="message"
            aria-live="polite"
          ></div>

        </div>


        <!-- PREVIEW -->
        <div class="preview">

          <div class="block-head">

            <div class="block-icon">
              <i class="fa-solid fa-eye"></i>
            </div>

            <div>
              <h3>المعاينة</h3>
              <p id="previewState">
                في انتظار البيانات
              </p>
            </div>

          </div>


          <div class="barcode-stage" id="barcodeStage">

            <div
              class="empty"
              id="barcodeEmpty"
            >

              <div class="empty-icon">
                <i class="fa-solid fa-barcode"></i>
              </div>

              <strong>
                سيظهر الباركود هنا
              </strong>

              <span>
                أدخل قيمة لإنشاء الباركود
              </span>

            </div>


            <svg
              id="barcodeSvg"
              class="barcode-svg"
              role="img"
              aria-label="Barcode preview"
            ></svg>

          </div>


          <div class="preview-meta">

            <span>
              <i class="fa-solid fa-circle-check"></i>
              <span id="previewFormat">CODE128</span>
            </span>

            <span id="previewLength">
              0 حرف
            </span>

          </div>


          <!-- EXPORT -->
          <div class="export-title">
            تصدير الباركود
          </div>


          <div class="export-grid">

            <button
              type="button"
              class="export"
              id="pngBtn"
              disabled
            >

              <i class="fa-solid fa-image"></i>

              <span>
                <strong>PNG</strong>
                <small>صورة</small>
              </span>

            </button>


            <button
              type="button"
              class="export"
              id="svgBtn"
              disabled
            >

              <i class="fa-solid fa-vector-square"></i>

              <span>
                <strong>SVG</strong>
                <small>متجه</small>
              </span>

            </button>


            <button
              type="button"
              class="export"
              id="copyBtn"
              disabled
            >

              <i class="fa-solid fa-copy"></i>

              <span>
                <strong>نسخ</strong>
                <small>القيمة</small>
              </span>

            </button>

          </div>


          <div class="scan-note">

            <i class="fa-solid fa-camera"></i>

            <span>
              للحصول على أفضل نتيجة، استخدم تباينًا واضحًا
              بين الباركود والخلفية.
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- FEATURES -->
    <section class="features">

      <div class="feature">

        <div class="feature-icon">
          <i class="fa-solid fa-bolt"></i>
        </div>

        <div>
          <strong>توليد سريع</strong>
          <span>إنشاء الباركود مباشرة أثناء الكتابة.</span>
        </div>

      </div>


      <div class="feature">

        <div class="feature-icon">
          <i class="fa-solid fa-layer-group"></i>
        </div>

        <div>
          <strong>أنواع متعددة</strong>
          <span>دعم CODE128 وEAN وUPC وغيرها.</span>
        </div>

      </div>


      <div class="feature">

        <div class="feature-icon">
          <i class="fa-solid fa-download"></i>
        </div>

        <div>
          <strong>تصدير سهل</strong>
          <span>تحميل PNG أو SVG في لحظة.</span>
        </div>

      </div>

    </section>


    <!-- PRIVACY -->
    <section class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div>

        <h2>خصوصيتك أولًا</h2>

        <p>
          تتم عملية إنشاء الباركود داخل متصفحك مباشرة.
          لا يتم إرسال القيمة التي تدخلها إلى خادم الأداة.
        </p>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-body">

        <h2>طريقة الاستخدام</h2>

        <div class="steps">

          <div class="step">

            <span>1</span>

            <div>
              <strong>أدخل القيمة</strong>
              <p>اكتب الرقم أو النص الذي تريد تحويله.</p>
            </div>

          </div>


          <div class="step">

            <span>2</span>

            <div>
              <strong>اختر النوع</strong>
              <p>حدد صيغة الباركود المناسبة لاحتياجك.</p>
            </div>

          </div>


          <div class="step">

            <span>3</span>

            <div>
              <strong>خصص المظهر</strong>
              <p>غيّر الحجم واللون والرقم الظاهر.</p>
            </div>

          </div>


          <div class="step">

            <span>4</span>

            <div>
              <strong>حمّل النتيجة</strong>
              <p>صدّر الباركود بصيغة PNG أو SVG.</p>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- TIP -->
    <section class="tip">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>

        <strong>نصيحة</strong>

        <p>
          استخدم لونًا داكنًا للباركود مع خلفية فاتحة
          للحصول على أفضل قابلية للقراءة بواسطة أجهزة المسح.
        </p>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq">

      <div class="faq-title">

        <span>دليل الأداة</span>

        <h2>الأسئلة الشائعة</h2>

      </div>


      <details>

        <summary>
          ما هو أفضل نوع Barcode للاستخدام العام؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          يعد CODE128 خيارًا مناسبًا لمعظم الاستخدامات
          لأنه يدعم مجموعة واسعة من الأحرف والأرقام.
        </p>

      </details>


      <details>

        <summary>
          هل يمكن استخدام الباركود على المنتجات؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، ولكن إذا كان الباركود مخصصًا للبيع بالتجزئة
          فمن المهم استخدام الصيغة التي تتطلبها الجهة أو النظام
          الذي سيقوم بقراءة المنتج.
        </p>

      </details>


      <details>

        <summary>
          هل يتم حفظ البيانات التي أدخلها؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          لا. يتم إنشاء الباركود محليًا داخل المتصفح.
        </p>

      </details>


      <details>

        <summary>
          هل يمكن تحميل الباركود؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم. يمكنك تحميله بصيغة PNG أو SVG.
        </p>

      </details>


      <details>

        <summary>
          لماذا يظهر خطأ عند استخدام بعض الصيغ؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          بعض أنواع الباركود لديها شروط محددة لطول القيمة
          أو الأحرف المسموح بها. اختر CODE128 إذا كنت تريد
          صيغة أكثر مرونة.
        </p>

      </details>

    </section>

  </main>

  <Footer />


  <!-- ======================================================
       JAVASCRIPT
       ====================================================== -->

  <script is:inline>
    (function () {

      function initBarcodeTool() {

        var valueInput =
          document.getElementById('barcodeValue');

        var formatSelect =
          document.getElementById('formatSelect');

        var lineWidth =
          document.getElementById('lineWidth');

        var barHeight =
          document.getElementById('barHeight');

        var fontSize =
          document.getElementById('fontSize');

        var showText =
          document.getElementById('showText');

        var flatMode =
          document.getElementById('flatMode');

        var lineColor =
          document.getElementById('lineColor');

        var backgroundColor =
          document.getElementById('backgroundColor');

        var lineColorText =
          document.getElementById('lineColorText');

        var backgroundColorText =
          document.getElementById('backgroundColorText');

        var barcodeSvg =
          document.getElementById('barcodeSvg');

        var barcodeEmpty =
          document.getElementById('barcodeEmpty');

        var barcodeStage =
          document.getElementById('barcodeStage');

        var generateBtn =
          document.getElementById('generateBtn');

        var resetBtn =
          document.getElementById('resetBtn');

        var pngBtn =
          document.getElementById('pngBtn');

        var svgBtn =
          document.getElementById('svgBtn');

        var copyBtn =
          document.getElementById('copyBtn');

        var message =
          document.getElementById('message');

        var status =
          document.getElementById('status');

        var valueCount =
          document.getElementById('valueCount');

        var valueHint =
          document.getElementById('valueHint');

        var previewState =
          document.getElementById('previewState');

        var previewFormat =
          document.getElementById('previewFormat');

        var previewLength =
          document.getElementById('previewLength');

        var formatHint =
          document.getElementById('formatHint');


        var timer = null;

        var generated = false;

        var currentValue = '';


        var formatDescriptions = {

          CODE128:
            'مناسب لمعظم النصوص والأرقام.',

          CODE128A:
            'يدعم مجموعة من الأحرف والأرقام والرموز.',

          CODE128B:
            'مناسب للنصوص والأرقام والرموز الشائعة.',

          CODE128C:
            'مخصص للأرقام في أزواج.',

          EAN13:
            'صيغة شائعة للمنتجات وتتطلب 12 أو 13 رقمًا.',

          EAN8:
            'صيغة مختصرة للمنتجات وتتطلب 7 أو 8 أرقام.',

          EAN5:
            'صيغة رقمية من 5 أرقام.',

          EAN2:
            'صيغة رقمية من رقمين.',

          UPC:
            'صيغة شائعة للمنتجات وتتطلب أرقامًا محددة.',

          CODE39:
            'مناسب للبيانات الأبجدية الرقمية.',

          ITF14:
            'صيغة رقمية مخصصة غالبًا للتغليف.',

          ITF:
            'صيغة رقمية تعتمد على أزواج من الأرقام.',

          MSI:
            'صيغة رقمية للمخازن والأنظمة الداخلية.',

          MSI10:
            'صيغة MSI رقمية.',

          MSI11:
            'صيغة MSI رقمية.',

          MSI1010:
            'صيغة MSI رقمية.',

          MSI1110:
            'صيغة MSI رقمية.',

          pharmacode:
            'صيغة رقمية تستخدم في بعض تطبيقات المنتجات الدوائية.'

        };


        function setStatus(text, working) {

          status.innerHTML =
            '<span></span>' + text;

          status.classList.toggle(
            'working',
            !!working
          );

        }


        function showMessage(text, type) {

          message.textContent =
            text || '';

          message.className =
            'message';

          if (type) {
            message.classList.add(type);
          }

        }


        function updateCounts() {

          var length =
            valueInput.value.length;

          valueCount.textContent =
            length + ' حرف';

          previewLength.textContent =
            length + ' حرف';

          if (length) {

            valueHint.textContent =
              'سيتم إنشاء الباركود تلقائيًا';

          } else {

            valueHint.textContent =
              'أدخل قيمة للبدء';

          }

        }


        function updateColorLabels() {

          lineColorText.textContent =
            lineColor.value.toUpperCase();

          backgroundColorText.textContent =
            backgroundColor.value.toUpperCase();

        }


        function validateValue(value, format) {

          if (!value) {

            return {
              valid: false,
              message: 'يرجى إدخال قيمة أولًا.'
            };

          }


          if (
            format === 'EAN13' ||
            format === 'EAN8' ||
            format === 'EAN5' ||
            format === 'EAN2' ||
            format === 'UPC' ||
            format === 'ITF14' ||
            format === 'ITF' ||
            format === 'MSI' ||
            format === 'MSI10' ||
            format === 'MSI11' ||
            format === 'MSI1010' ||
            format === 'MSI1110' ||
            format === 'pharmacode'
          ) {

            var digitsOnly =
              /^[0-9]+$/.test(value);

            if (!digitsOnly) {

              return {
                valid: false,
                message:
                  'هذا النوع يقبل الأرقام فقط.'
              };

            }

          }


          if (format === 'EAN13') {

            if (
              value.length !== 12 &&
              value.length !== 13
            ) {

              return {
                valid: false,
                message:
                  'EAN-13 يحتاج إلى 12 أو 13 رقمًا.'
              };

            }

          }


          if (format === 'EAN8') {

            if (
              value.length !== 7 &&
              value.length !== 8
            ) {

              return {
                valid: false,
                message:
                  'EAN-8 يحتاج إلى 7 أو 8 أرقام.'
              };

            }

          }


          if (format === 'EAN5') {

            if (value.length !== 5) {

              return {
                valid: false,
                message:
                  'EAN-5 يحتاج إلى 5 أرقام.'
              };

            }

          }


          if (format === 'EAN2') {

            if (value.length !== 2) {

              return {
                valid: false,
                message:
                  'EAN-2 يحتاج إلى رقمين.'
              };

            }

          }


          if (format === 'UPC') {

            if (
              value.length !== 11 &&
              value.length !== 12
            ) {

              return {
                valid: false,
                message:
                  'UPC يحتاج إلى 11 أو 12 رقمًا.'
              };

            }

          }


          if (format === 'ITF14') {

            if (
              value.length !== 13 &&
              value.length !== 14
            ) {

              return {
                valid: false,
                message:
                  'ITF-14 يحتاج إلى 13 أو 14 رقمًا.'
              };

            }

          }


          if (format === 'ITF') {

            if (value.length % 2 !== 0) {

              return {
                valid: false,
                message:
                  'ITF يحتاج إلى عدد زوجي من الأرقام.'
              };

            }

          }


          if (
            format === 'pharmacode'
          ) {

            var number =
              Number(value);

            if (
              !Number.isInteger(number) ||
              number < 3 ||
              number > 131070
            ) {

              return {
                valid: false,
                message:
                  'Pharmacode يقبل رقمًا بين 3 و131070.'
              };

            }

          }


          return {
            valid: true,
            message: ''
          };

        }


        function clearBarcode() {

          barcodeSvg.innerHTML =
            '';

          barcodeSvg.style.display =
            'none';

          barcodeEmpty.style.display =
            'flex';

          pngBtn.disabled =
            true;

          svgBtn.disabled =
            true;

          copyBtn.disabled =
            true;

          generated =
            false;

          currentValue =
            '';

          previewState.textContent =
            'في انتظار البيانات';

        }


        function generate() {

          if (
            typeof window.JsBarcode ===
            'undefined'
          ) {

            setStatus(
              'المكتبة غير متاحة',
              false
            );

            showMessage(
              'تعذر تحميل مكتبة Barcode. تحقق من اتصال الإنترنت ثم أعد تحميل الصفحة.',
              'error'
            );

            return;

          }


          var value =
            valueInput.value.trim();

          var format =
            formatSelect.value;


          var validation =
            validateValue(
              value,
              format
            );


          if (!validation.valid) {

            clearBarcode();

            setStatus(
              'جاهز',
              false
            );

            showMessage(
              validation.message,
              'error'
            );

            return;

          }


          setStatus(
            'جارٍ الإنشاء...',
            true
          );


          try {

            barcodeSvg.innerHTML =
              '';

            barcodeSvg.style.display =
              'block';

            barcodeEmpty.style.display =
              'none';


            var options = {

              format:
                format,

              lineColor:
                lineColor.value,

              background:
                backgroundColor.value,

              width:
                Number(lineWidth.value),

              height:
                Number(barHeight.value),

              displayValue:
                showText.checked,

              fontSize:
                Number(fontSize.value),

              font:
                'Cairo',

              textAlign:
                'center',

              textPosition:
                'bottom',

              textMargin:
                5,

              margin:
                flatMode.checked ? 0 : 12,

              marginTop:
                flatMode.checked ? 0 : 12,

              marginBottom:
                flatMode.checked ? 0 : 12,

              marginLeft:
                flatMode.checked ? 0 : 12,

              marginRight:
                flatMode.checked ? 0 : 12

            };


            window.JsBarcode(
              barcodeSvg,
              value,
              options
            );


            currentValue =
              value;

            generated =
              true;


            previewState.textContent =
              'تم إنشاء الباركود';

            previewFormat.textContent =
              format;

            previewLength.textContent =
              value.length + ' حرف';


            pngBtn.disabled =
              false;

            svgBtn.disabled =
              false;

            copyBtn.disabled =
              false;


            setStatus(
              'جاهز',
              false
            );


            showMessage(
              'تم إنشاء Barcode بنجاح.',
              'success'
            );


          } catch (error) {

            console.error(error);

            clearBarcode();

            setStatus(
              'خطأ',
              false
            );

            showMessage(
              'القيمة غير مناسبة لنوع الباركود المحدد.',
              'error'
            );

          }

        }


        function scheduleGenerate() {

          updateCounts();

          clearTimeout(timer);

          timer =
            setTimeout(
              function () {

                if (
                  valueInput.value.trim()
                ) {

                  generate();

                } else {

                  clearBarcode();

                  setStatus(
                    'جاهز',
                    false
                  );

                }

              },
              180
            );

        }


        function downloadSvg() {

          if (!generated) {
            return;
          }


          var svgData =
            barcodeSvg.outerHTML;


          var serializer =
            new XMLSerializer();


          try {

            svgData =
              serializer.serializeToString(
                barcodeSvg
              );

          } catch (error) {
            svgData =
              barcodeSvg.outerHTML;
          }


          if (
            svgData.indexOf(
              'xmlns='
            ) === -1
          ) {

            svgData =
              svgData.replace(
                '<svg',
                '<svg xmlns="http://www.w3.org/2000/svg"'
              );

          }


          var blob =
            new Blob(
              [svgData],
              {
                type:
                  'image/svg+xml;charset=utf-8'
              }
            );


          var url =
            URL.createObjectURL(
              blob
            );


          var link =
            document.createElement('a');

          link.href =
            url;

          link.download =
            'barcode.svg';

          document.body.appendChild(
            link
          );

          link.click();

          link.remove();


          setTimeout(
            function () {

              URL.revokeObjectURL(
                url
              );

            },
            1000
          );


          showMessage(
            'تم تحميل Barcode بصيغة SVG.',
            'success'
          );

        }


        function downloadPng() {

          if (!generated) {
            return;
          }


          var xml =
            new XMLSerializer()
              .serializeToString(
                barcodeSvg
              );


          if (
            xml.indexOf(
              'xmlns='
            ) === -1
          ) {

            xml =
              xml.replace(
                '<svg',
                '<svg xmlns="http://www.w3.org/2000/svg"'
              );

          }


          var svgBlob =
            new Blob(
              [xml],
              {
                type:
                  'image/svg+xml;charset=utf-8'
              }
            );


          var url =
            URL.createObjectURL(
              svgBlob
            );


          var image =
            new Image();


          image.onload =
            function () {

              var rect =
                barcodeSvg.getBoundingClientRect();


              var width =
                Math.max(
                  1,
                  Math.round(
                    barcodeSvg.viewBox.baseVal.width ||
                    rect.width
                  )
                );


              var height =
                Math.max(
                  1,
                  Math.round(
                    barcodeSvg.viewBox.baseVal.height ||
                    rect.height
                  )
                );


              var scale =
                2;


              var canvas =
                document.createElement(
                  'canvas'
                );


              canvas.width =
                width * scale;

              canvas.height =
                height * scale;


              var context =
                canvas.getContext(
                  '2d'
                );


              context.fillStyle =
                backgroundColor.value;

              context.fillRect(
                0,
                0,
                canvas.width,
                canvas.height
              );


              context.drawImage(
                image,
                0,
                0,
                canvas.width,
                canvas.height
              );


              URL.revokeObjectURL(
                url
              );


              var link =
                document.createElement('a');


              link.download =
                'barcode.png';

              link.href =
                canvas.toDataURL(
                  'image/png'
                );


              document.body.appendChild(
                link
              );

              link.click();

              link.remove();


              showMessage(
                'تم تحميل Barcode بصيغة PNG.',
                'success'
              );

            };


          image.onerror =
            function () {

              URL.revokeObjectURL(
                url
              );

              showMessage(
                'تعذر تصدير الباركود كصورة PNG.',
                'error'
              );

            };


          image.src =
            url;

        }


        function copyValue() {

          if (!currentValue) {
            return;
          }


          if (
            navigator.clipboard &&
            navigator.clipboard.writeText
          ) {

            navigator.clipboard
              .writeText(
                currentValue
              )
              .then(
                function () {

                  showMessage(
                    'تم نسخ القيمة بنجاح.',
                    'success'
                  );

                }
              )
              .catch(
                fallbackCopy
              );

          } else {

            fallbackCopy();

          }

        }


        function fallbackCopy() {

          var area =
            document.createElement(
              'textarea'
            );

          area.value =
            currentValue;

          area.style.position =
            'fixed';

          area.style.opacity =
            '0';

          document.body.appendChild(
            area
          );

          area.select();


          try {

            document.execCommand(
              'copy'
            );

            showMessage(
              'تم نسخ القيمة.',
              'success'
            );

          } catch (error) {

            showMessage(
              'تعذر نسخ القيمة.',
              'error'
            );

          }


          area.remove();

        }


        function reset() {

          valueInput.value =
            '';

          formatSelect.value =
            'CODE128';

          lineWidth.value =
            '2';

          barHeight.value =
            '80';

          fontSize.value =
            '14';

          showText.checked =
            true;

          flatMode.checked =
            false;

          lineColor.value =
            '#07111f';

          backgroundColor.value =
            '#ffffff';


          updateColorLabels();

          updateCounts();

          clearBarcode();


          formatHint.textContent =
            formatDescriptions.CODE128;


          showMessage(
            'تمت إعادة ضبط الأداة.',
            'success'
          );


          setStatus(
            'جاهز',
            false
          );

        }


        valueInput.addEventListener(
          'input',
          scheduleGenerate
        );


        formatSelect.addEventListener(
          'change',
          function () {

            formatHint.textContent =
              formatDescriptions[
                formatSelect.value
              ] || '';

            if (
              valueInput.value.trim()
            ) {

              generate();

            }

          }
        );


        [
          lineWidth,
          barHeight,
          fontSize,
          showText,
          flatMode
        ].forEach(
          function (element) {

            element.addEventListener(
              'change',
              function () {

                if (
                  valueInput.value.trim()
                ) {

                  generate();

                }

              }
            );

          }
        );


        lineColor.addEventListener(
          'input',
          function () {

            updateColorLabels();

            if (
              valueInput.value.trim()
            ) {

              generate();

            }

          }
        );


        backgroundColor.addEventListener(
          'input',
          function () {

            updateColorLabels();

            if (
              valueInput.value.trim()
            ) {

              generate();

            }

          }
        );


        generateBtn.addEventListener(
          'click',
          generate
        );


        resetBtn.addEventListener(
          'click',
          reset
        );


        pngBtn.addEventListener(
          'click',
          downloadPng
        );


        svgBtn.addEventListener(
          'click',
          downloadSvg
        );


        copyBtn.addEventListener(
          'click',
          copyValue
        );


        /*
         * Theme synchronization
         */

        function syncTheme() {

          var root =
            document.documentElement;

          var dark =
            root.classList.contains(
              'dark-mode'
            ) ||
            root.getAttribute(
              'data-theme'
            ) === 'dark';


          document.body.classList.toggle(
            'barcode-dark',
            dark
          );

          document.body.classList.toggle(
            'barcode-light',
            !dark
          );

        }


        syncTheme();


        if (
          typeof MutationObserver !==
          'undefined'
        ) {

          var observer =
            new MutationObserver(
              syncTheme
            );


          observer.observe(
            document.documentElement,
            {
              attributes: true,
              attributeFilter: [
                'class',
                'data-theme'
              ]
            }
          );

        }


        /*
         * Initial state
         */

        updateCounts();

        updateColorLabels();

        formatHint.textContent =
          formatDescriptions.CODE128;


        setStatus(
          'جارٍ التحقق...',
          true
        );


        if (
          typeof window.JsBarcode !==
          'undefined'
        ) {

          setStatus(
            'جاهز',
            false
          );

        } else {

          var attempts =
            0;


          var libraryTimer =
            setInterval(
              function () {

                attempts++;


                if (
                  typeof window.JsBarcode !==
                  'undefined'
                ) {

                  clearInterval(
                    libraryTimer
                  );

                  setStatus(
                    'جاهز',
                    false
                  );

                  return;

                }


                if (attempts >= 80) {

                  clearInterval(
                    libraryTimer
                  );

                  setStatus(
                    'تعذر التحميل',
                    false
                  );

                  showMessage(
                    'تعذر تحميل مكتبة Barcode. تحقق من اتصال الإنترنت.',
                    'error'
                  );

                }

              },
              100
            );

        }

      }


      if (
        document.readyState ===
        'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          initBarcodeTool
        );

      } else {

        initBarcodeTool();

      }

    })();
