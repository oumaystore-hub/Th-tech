---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>مولد الباركود | Th.Tech</title>
    <meta
      name="description"
      content="مولد باركود احترافي يدعم CODE128 وCODE39 وEAN13 وEAN8 وUPC وITF14 مع إمكانية التصدير PNG وSVG."
    />
    <link rel="canonical" href={canonical} />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"
    ></script>

    <style>
      /* =========================================================
         BASE
      ========================================================= */

      :global(html),
      :global(body) {
        margin: 0;
        padding: 0;
        min-height: 100%;
      }

      :global(body) {
        font-family: "Cairo", sans-serif;
        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      :global(body.barcode-dark-theme) {
        background: #0b1120 !important;
        color: #e5edf8 !important;
        color-scheme: dark;
      }

      :global(body.barcode-light-theme) {
        background: #f5f9ff !important;
        color: #172033 !important;
        color-scheme: light;
      }

      /* =========================================================
         PAGE THEME VARIABLES
      ========================================================= */

      .barcode-page {
        --page-bg: #0b1120;
        --page-text: #e5edf8;
        --muted: #9aa9bd;
        --muted-2: #7d8da3;

        --card: #111827;
        --card-2: #172033;
        --input: #172033;
        --input-text: #f3f7fc;

        --border: #263449;
        --border-strong: #34445b;

        --primary: #38bdf8;
        --primary-2: #0ea5e9;

        --success: #22c55e;
        --danger: #ef4444;

        --shadow: 0 16px 45px rgba(0, 0, 0, 0.25);

        min-height: calc(100vh - 80px);
        width: 100%;
        box-sizing: border-box;

        background: var(--page-bg);
        color: var(--page-text);

        padding: 28px 16px 50px;

        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      .barcode-page.force-light {
        --page-bg: #f5f9ff;
        --page-text: #172033;
        --muted: #667085;
        --muted-2: #7a8799;

        --card: #ffffff;
        --card-2: #f7faff;
        --input: #ffffff;
        --input-text: #172033;

        --border: #dbe5f0;
        --border-strong: #c6d4e4;

        --primary: #0284c7;
        --primary-2: #0369a1;

        --shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
      }

      .barcode-page.force-dark {
        --page-bg: #0b1120;
        --page-text: #e5edf8;
        --muted: #9aa9bd;
        --muted-2: #7d8da3;

        --card: #111827;
        --card-2: #172033;
        --input: #172033;
        --input-text: #f3f7fc;

        --border: #263449;
        --border-strong: #34445b;

        --primary: #38bdf8;
        --primary-2: #0ea5e9;

        --shadow: 0 16px 45px rgba(0, 0, 0, 0.25);
      }

      .barcode-container {
        width: min(1100px, 100%);
        margin: 0 auto;
      }

      /* =========================================================
         HEADER
      ========================================================= */

      .tool-heading {
        text-align: center;
        margin: 5px auto 28px;
      }

      .tool-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

        color: #fff;
        font-size: 27px;

        box-shadow:
          0 10px 25px rgba(14, 165, 233, 0.22);
      }

      .tool-heading h1 {
        margin: 0;
        font-size: clamp(25px, 5vw, 36px);
        font-weight: 800;
        color: var(--page-text);
      }

      .tool-heading p {
        margin: 8px auto 0;
        max-width: 680px;

        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
      }

      /* =========================================================
         MAIN GRID
      ========================================================= */

      .tool-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 20px;
        align-items: start;
      }

      .settings-card,
      .preview-card,
      .export-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;

        box-shadow: var(--shadow);

        transition:
          background-color 0.25s ease,
          border-color 0.25s ease,
          color 0.25s ease;
      }

      .settings-card {
        padding: 22px;
      }

      .preview-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .preview-card {
        padding: 22px;
      }

      .export-card {
        padding: 22px;
      }

      .card-title {
        display: flex;
        align-items: center;
        gap: 10px;

        margin-bottom: 20px;

        font-size: 18px;
        font-weight: 800;
        color: var(--page-text);
      }

      .card-title i {
        color: var(--primary);
      }

      /* =========================================================
         SETTINGS — 2 x 2
      ========================================================= */

      .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
      }

      .field {
        min-width: 0;
      }

      .field.full {
        grid-column: 1 / -1;
      }

      .field label {
        display: block;
        margin-bottom: 8px;

        color: var(--page-text);

        font-size: 14px;
        font-weight: 700;
      }

      .field label span {
        color: var(--muted);
        font-size: 12px;
        font-weight: 500;
      }

      .field input,
      .field select {
        width: 100%;
        height: 48px;

        box-sizing: border-box;

        padding: 0 13px;

        border: 1px solid var(--border);
        border-radius: 12px;

        background: var(--input);
        color: var(--input-text);

        font-family: "Cairo", sans-serif;
        font-size: 14px;

        outline: none;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background-color 0.2s ease;
      }

      .field input:focus,
      .field select:focus {
        border-color: var(--primary);

        box-shadow:
          0 0 0 3px rgba(14, 165, 233, 0.13);
      }

      .field input[type="color"] {
        padding: 5px;
        cursor: pointer;
      }

      .checkbox-field {
        display: flex;
        align-items: center;
        gap: 10px;

        min-height: 48px;

        padding: 0 13px;

        box-sizing: border-box;

        border: 1px solid var(--border);
        border-radius: 12px;

        background: var(--input);
      }

      .checkbox-field input {
        width: 18px;
        height: 18px;

        accent-color: var(--primary);

        cursor: pointer;
      }

      .checkbox-field label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      /* =========================================================
         ACTION BUTTONS
      ========================================================= */

      .actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;

        margin-top: 20px;
      }

      .btn {
        min-height: 48px;

        border: 0;
        border-radius: 12px;

        padding: 10px 13px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        font-family: "Cairo", sans-serif;
        font-size: 14px;
        font-weight: 800;

        cursor: pointer;

        transition:
          transform 0.18s ease,
          opacity 0.18s ease,
          background-color 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn:active {
        transform: translateY(0);
      }

      .btn-primary {
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

        color: #fff;
      }

      .btn-secondary {
        background: var(--card-2);
        color: var(--page-text);
        border: 1px solid var(--border);
      }

      .btn-danger {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
      }

      /* =========================================================
         PREVIEW
      ========================================================= */

      .preview-area {
        position: relative;

        min-height: 260px;

        border-radius: 16px;
        border: 1px dashed var(--border-strong);

        background: #ffffff;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 25px;

        overflow: hidden;
      }

      #barcodeSvg {
        display: none;

        max-width: 100%;
        height: auto;

        background: #fff;
      }

      #barcodeCanvas {
        display: none;
      }

      .empty-preview {
        text-align: center;
        color: #8a96a8;
      }

      .empty-preview i {
        font-size: 40px;
        margin-bottom: 10px;
        opacity: 0.6;
      }

      .empty-preview div {
        font-size: 14px;
        font-weight: 700;
      }

      .preview-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;

        margin-bottom: 14px;
      }

      .format-badge {
        display: none;

        padding: 5px 10px;

        border-radius: 999px;

        background: rgba(14, 165, 233, 0.12);
        color: var(--primary);

        font-size: 12px;
        font-weight: 800;
      }

      .status {
        min-height: 21px;

        color: var(--muted);

        font-size: 12px;
        font-weight: 600;
      }

      .status.success {
        color: var(--success);
      }

      .status.error {
        color: var(--danger);
      }

      /* =========================================================
         EXPORT — 2 x 2
      ========================================================= */

      .export-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .export-info {
        margin-top: 13px;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.8;

        text-align: center;
      }

      /* =========================================================
         RESPONSIVE
      ========================================================= */

      @media (max-width: 850px) {
        .barcode-page {
          padding: 24px 13px 45px;
        }

        .tool-grid {
          grid-template-columns: 1fr;
        }

        .settings-card {
          order: 1;
        }

        .preview-column {
          order: 2;
        }
      }

      @media (max-width: 560px) {
        .barcode-page {
          padding: 20px 10px 38px;
        }

        .tool-heading {
          margin-bottom: 22px;
        }

        .tool-icon {
          width: 58px;
          height: 58px;
          border-radius: 16px;
          font-size: 24px;
        }

        .tool-heading h1 {
          font-size: 25px;
        }

        .tool-heading p {
          font-size: 13px;
        }

        .settings-card,
        .preview-card,
        .export-card {
          padding: 16px;
          border-radius: 17px;
        }

        .card-title {
          font-size: 16px;
          margin-bottom: 16px;
        }

        .settings-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
        }

        .field.full {
          grid-column: 1 / -1;
        }

        .field label {
          font-size: 13px;
        }

        .field input,
        .field select {
          height: 46px;
          font-size: 13px;
          padding: 0 10px;
        }

        .checkbox-field {
          min-height: 46px;
          padding: 0 10px;
        }

        .checkbox-field label {
          font-size: 12px;
        }

        .actions {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }

        .btn {
          min-height: 46px;
          padding: 8px 8px;
          font-size: 12px;
        }

        .preview-area {
          min-height: 220px;
          padding: 15px;
        }

        .export-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }
      }

      @media (max-width: 380px) {
        .settings-grid,
        .export-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .btn {
          font-size: 11px;
          gap: 5px;
        }

        .btn i {
          font-size: 11px;
        }

        .field label {
          font-size: 12px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="barcode-page force-dark" id="barcodePage">
      <div class="barcode-container">

        <section class="tool-heading">
          <div class="tool-icon">
            <i class="fa-solid fa-barcode"></i>
          </div>

          <h1>مولد الباركود</h1>

          <p>
            أنشئ باركود احترافي بسرعة، مع التحكم في الحجم والألوان وإمكانية
            تحميله بصيغة PNG أو SVG.
          </p>
        </section>

        <section class="tool-grid">

          <!-- SETTINGS -->
          <div class="settings-card">

            <div class="card-title">
              <i class="fa-solid fa-sliders"></i>
              إعدادات الباركود
            </div>

            <div class="settings-grid">

              <div class="field full">
                <label for="barcodeValue">
                  القيمة
                  <span>النص أو الرقم</span>
                </label>

                <input
                  id="barcodeValue"
                  type="text"
                  value="123456789012"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>

              <div class="field">
                <label for="barcodeType">نوع الباركود</label>

                <select id="barcodeType">
                  <option value="CODE128">CODE128</option>
                  <option value="CODE39">CODE39</option>
                  <option value="EAN13">EAN13</option>
                  <option value="EAN8">EAN8</option>
                  <option value="UPC">UPC</option>
                  <option value="ITF14">ITF14</option>
                </select>
              </div>

              <div class="field">
                <label for="barWidth">عرض الخط</label>

                <input
                  id="barWidth"
                  type="number"
                  min="1"
                  max="5"
                  step="0.5"
                  value="2"
                />
              </div>

              <div class="field">
                <label for="barHeight">ارتفاع الباركود</label>

                <input
                  id="barHeight"
                  type="number"
                  min="30"
                  max="200"
                  value="70"
                />
              </div>

              <div class="field">
                <label for="fontSize">حجم النص</label>

                <input
                  id="fontSize"
                  type="number"
                  min="8"
                  max="40"
                  value="16"
                />
              </div>

              <div class="field">
                <label for="lineColor">لون الخط</label>

                <input
                  id="lineColor"
                  type="color"
                  value="#111827"
                />
              </div>

              <div class="field">
                <label for="backgroundColor">لون الخلفية</label>

                <input
                  id="backgroundColor"
                  type="color"
                  value="#ffffff"
                />
              </div>

              <div class="field full">
                <div class="checkbox-field">
                  <input
                    id="displayValue"
                    type="checkbox"
                    checked
                  />

                  <label for="displayValue">
                    إظهار القيمة أسفل الباركود
                  </label>
                </div>
              </div>

            </div>

            <div class="actions">

              <button
                type="button"
                class="btn btn-primary"
                id="generateBtn"
              >
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                إنشاء
              </button>

              <button
                type="button"
                class="btn btn-secondary"
                id="resetBtn"
              >
                <i class="fa-solid fa-rotate-right"></i>
                إعادة ضبط
              </button>

              <button
                type="button"
                class="btn btn-secondary"
                id="clearBtn"
              >
                <i class="fa-solid fa-eraser"></i>
                مسح
              </button>

              <button
                type="button"
                class="btn btn-secondary"
                id="copyValue"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ القيمة
              </button>

            </div>
          </div>

          <!-- PREVIEW + EXPORT -->
          <div class="preview-column">

            <div class="preview-card">

              <div class="preview-top">
                <div class="card-title" style="margin:0;">
                  <i class="fa-solid fa-eye"></i>
                  المعاينة
                </div>

                <span
                  class="format-badge"
                  id="formatBadge"
                ></span>
              </div>

              <div class="preview-area">

                <div
                  class="empty-preview"
                  id="emptyPreview"
                >
                  <i class="fa-solid fa-barcode"></i>

                  <div>
                    أدخل القيمة واضغط إنشاء
                  </div>
                </div>

                <svg
                  id="barcodeSvg"
                  aria-label="Barcode preview"
                ></svg>

                <canvas id="barcodeCanvas"></canvas>
              </div>

              <div
                class="status"
                id="status"
              ></div>

            </div>

            <div class="export-card">

              <div class="card-title">
                <i class="fa-solid fa-download"></i>
                تصدير الباركود
              </div>

              <div class="export-grid">

                <button
                  type="button"
                  class="btn btn-primary"
                  id="downloadPng"
                >
                  <i class="fa-solid fa-image"></i>
                  تحميل PNG
                </button>

                <button
                  type="button"
                  class="btn btn-secondary"
                  id="downloadSvg"
                >
                  <i class="fa-solid fa-file-code"></i>
                  تحميل SVG
                </button>

                <button
                  type="button"
                  class="btn btn-secondary"
                  id="resetBtnMain"
                >
                  <i class="fa-solid fa-arrows-rotate"></i>
                  إعادة ضبط
                </button>

                <button
                  type="button"
                  class="btn btn-danger"
                  id="clearBtn2"
                >
                  <i class="fa-solid fa-trash"></i>
                  مسح
                </button>

              </div>

              <div class="export-info">
                يمكنك تنزيل الباركود بصيغة PNG للاستخدام في الصور
                أو SVG للحفاظ على أعلى جودة ممكنة.
              </div>

            </div>

          </div>

        </section>
      </div>
    </main>

    <Footer />

    <script is:inline>
      (() => {
        /* =====================================================
           THEME SYNC
           لا نعتمد على data-theme="dark".
           نراقب localStorage + html + body + classes.
        ===================================================== */

        function getThemeState() {
          let stored = null;

          try {
            stored = localStorage.getItem("theme");
          } catch (e) {}

          const html = document.documentElement;
          const body = document.body;

          const htmlTheme = html.getAttribute("data-theme");
          const bodyTheme = body.getAttribute("data-theme");

          const htmlLight =
            htmlTheme === "light" ||
            html.classList.contains("light") ||
            html.classList.contains("light-theme");

          const bodyLight =
            bodyTheme === "light" ||
            body.classList.contains("light") ||
            body.classList.contains("light-theme");

          if (stored === "light") return "light";
          if (stored === "dark") return "dark";

          if (htmlLight || bodyLight) return "light";

          if (
            html.classList.contains("dark") ||
            html.classList.contains("dark-theme") ||
            body.classList.contains("dark") ||
            body.classList.contains("dark-theme")
          ) {
            return "dark";
          }

          /* الموقع يستخدم الوضع الداكن افتراضياً */
          return "dark";
        }

        function syncBarcodeTheme() {
          const page = document.getElementById("barcodePage");

          if (!page) return;

          const theme = getThemeState();
          const light = theme === "light";

          page.classList.toggle("force-light", light);
          page.classList.toggle("force-dark", !light);

          document.body.classList.toggle(
            "barcode-light-theme",
            light
          );

          document.body.classList.toggle(
            "barcode-dark-theme",
            !light
          );
        }

        function watchTheme() {
          syncBarcodeTheme();

          window.addEventListener(
            "storage",
            syncBarcodeTheme
          );

          const observer = new MutationObserver(() => {
            syncBarcodeTheme();
          });

          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class", "data-theme"]
          });

          observer.observe(document.body, {
            attributes: true,
            attributeFilter: ["class", "data-theme"]
          });
        }

        /* =====================================================
           BARCODE TOOL
        ===================================================== */

        function startBarcodeTool() {
          const valueInput =
            document.getElementById("barcodeValue");

          const typeInput =
            document.getElementById("barcodeType");

          const widthInput =
            document.getElementById("barWidth");

          const heightInput =
            document.getElementById("barHeight");

          const displayInput =
            document.getElementById("displayValue");

          const fontInput =
            document.getElementById("fontSize");

          const lineColorInput =
            document.getElementById("lineColor");

          const backgroundInput =
            document.getElementById("backgroundColor");

          const barcodeSvg =
            document.getElementById("barcodeSvg");

          const barcodeCanvas =
            document.getElementById("barcodeCanvas");

          const emptyPreview =
            document.getElementById("emptyPreview");

          const formatBadge =
            document.getElementById("formatBadge");

          const status =
            document.getElementById("status");

          const generateBtn =
            document.getElementById("generateBtn");

          const resetBtn =
            document.getElementById("resetBtn");

          const resetBtnMain =
            document.getElementById("resetBtnMain");

          const clearBtn =
            document.getElementById("clearBtn");

          const clearBtn2 =
            document.getElementById("clearBtn2");

          const downloadPng =
            document.getElementById("downloadPng");

          const downloadSvg =
            document.getElementById("downloadSvg");

          const copyBtn =
            document.getElementById("copyValue");

          function setStatus(message, type = "") {
            status.textContent = message;
            status.className = "status";

            if (type) {
              status.classList.add(type);
            }
          }

          function validate(value, type) {
            if (!value.trim()) {
              return "أدخل قيمة لإنشاء الباركود.";
            }

            if (type === "EAN13") {
              if (!/^\d{12,13}$/.test(value)) {
                return "EAN13 يحتاج إلى 12 أو 13 رقماً.";
              }
            }

            if (type === "EAN8") {
              if (!/^\d{7,8}$/.test(value)) {
                return "EAN8 يحتاج إلى 7 أو 8 أرقام.";
              }
            }

            if (type === "UPC") {
              if (!/^\d{11,12}$/.test(value)) {
                return "UPC يحتاج إلى 11 أو 12 رقماً.";
              }
            }

            if (type === "ITF14") {
              if (!/^\d{13,14}$/.test(value)) {
                return "ITF14 يحتاج إلى 13 أو 14 رقماً.";
              }
            }

            if (type === "CODE39") {
              if (!/^[0-9A-Z .\-$\/+%]+$/.test(value)) {
                return "CODE39 يدعم الأحرف الكبيرة والأرقام وبعض الرموز فقط.";
              }
            }

            return "";
          }

          function clearPreview() {
            barcodeSvg.style.display = "none";
            barcodeSvg.innerHTML = "";

            barcodeCanvas.style.display = "none";

            emptyPreview.style.display = "block";

            formatBadge.style.display = "none";
            formatBadge.textContent = "";

            setStatus("");
          }

          function generate() {
            if (
              typeof JsBarcode === "undefined"
            ) {
              setStatus(
                "تعذر تحميل مكتبة JsBarcode.",
                "error"
              );

              return;
            }

            const value =
              valueInput.value.trim();

            const type =
              typeInput.value;

            const error =
              validate(value, type);

            if (error) {
              clearPreview();

              setStatus(
                error,
                "error"
              );

              return;
            }

            try {
              barcodeSvg.innerHTML = "";

              JsBarcode(
                barcodeSvg,
                value,
                {
                  format: type,
                  width: Number(widthInput.value) || 2,
                  height: Number(heightInput.value) || 70,
                  displayValue: displayInput.checked,
                  fontSize: Number(fontInput.value) || 16,
                  lineColor:
                    lineColorInput.value,
                  background:
                    backgroundInput.value,
                  margin: 10,
                  textMargin: 5
                }
              );

              barcodeSvg.style.display = "block";
              emptyPreview.style.display = "none";

              formatBadge.textContent = type;
              formatBadge.style.display =
                "inline-flex";

              setStatus(
                "تم إنشاء الباركود بنجاح.",
                "success"
              );
            } catch (error) {
              clearPreview();

              setStatus(
                "تعذر إنشاء الباركود. تحقق من القيمة والنوع.",
                "error"
              );

              console.error(error);
            }
          }

          function getSVGString() {
            const svg =
              barcodeSvg.cloneNode(true);

            svg.setAttribute(
              "xmlns",
              "http://www.w3.org/2000/svg"
            );

            svg.setAttribute(
              "xmlns:xlink",
              "http://www.w3.org/1999/xlink"
            );

            return new XMLSerializer()
              .serializeToString(svg);
          }

          function saveBlob(
            blob,
            filename
          ) {
            const url =
              URL.createObjectURL(blob);

            const link =
              document.createElement("a");

            link.href = url;
            link.download = filename;

            document.body.appendChild(link);
            link.click();
            link.remove();

            setTimeout(() => {
              URL.revokeObjectURL(url);
            }, 1000);
          }

          function exportSVG() {
            if (
              barcodeSvg.style.display ===
              "none"
            ) {
              generate();
            }

            if (
              barcodeSvg.style.display ===
              "none"
            ) {
              return;
            }

            const svgString =
              getSVGString();

            const blob =
              new Blob(
                [svgString],
                {
                  type: "image/svg+xml;charset=utf-8"
                }
              );

            saveBlob(
              blob,
              `barcode-${Date.now()}.svg`
            );

            setStatus(
              "تم تحميل ملف SVG.",
              "success"
            );
          }

          function exportPNG() {
            if (
              barcodeSvg.style.display ===
              "none"
            ) {
              generate();
            }

            if (
              barcodeSvg.style.display ===
              "none"
            ) {
              return;
            }

            const svgString =
              getSVGString();

            const blob =
              new Blob(
                [svgString],
                {
                  type: "image/svg+xml;charset=utf-8"
                }
              );

            const url =
              URL.createObjectURL(blob);

            const image =
              new Image();

            image.onload = () => {
              const scale = 3;

              const svgWidth =
                barcodeSvg.getBoundingClientRect()
                  .width || 400;

              const svgHeight =
                barcodeSvg.getBoundingClientRect()
                  .height || 150;

              const canvasWidth =
                Math.ceil(svgWidth * scale);

              const canvasHeight =
                Math.ceil(svgHeight * scale);

              barcodeCanvas.width =
                canvasWidth;

              barcodeCanvas.height =
                canvasHeight;

              const ctx =
                barcodeCanvas.getContext(
                  "2d"
                );

              ctx.setTransform(
                scale,
                0,
                0,
                scale,
                0,
                0
              );

              ctx.fillStyle =
                backgroundInput.value ||
                "#ffffff";

              ctx.fillRect(
                0,
                0,
                svgWidth,
                svgHeight
              );

              ctx.drawImage(
                image,
                0,
                0,
                svgWidth,
                svgHeight
              );

              canvasToDownload(
                barcodeCanvas
              );

              URL.revokeObjectURL(url);
            };

            image.onerror = () => {
              URL.revokeObjectURL(url);

              setStatus(
                "تعذر تصدير PNG.",
                "error"
              );
            };

            image.src = url;
          }

          function canvasToDownload(
            canvas
          ) {
            canvas.toBlob(
              (blob) => {
                if (!blob) {
                  setStatus(
                    "تعذر إنشاء ملف PNG.",
                    "error"
                  );

                  return;
                }

                saveBlob(
                  blob,
                  `barcode-${Date.now()}.png`
                );

                setStatus(
                  "تم تحميل ملف PNG.",
                  "success"
                );
              },
              "image/png"
            );
          }

          async function copyValue() {
            const value =
              valueInput.value;

            if (!value) {
              setStatus(
                "لا توجد قيمة لنسخها.",
                "error"
              );

              return;
            }

            try {
              await navigator.clipboard.writeText(
                value
              );

              setStatus(
                "تم نسخ القيمة.",
                "success"
              );
            } catch {
              valueInput.select();

              document.execCommand(
                "copy"
              );

              setStatus(
                "تم نسخ القيمة.",
                "success"
              );
            }
          }

          function reset() {
            valueInput.value =
              "123456789012";

            typeInput.value =
              "CODE128";

            widthInput.value = "2";
            heightInput.value = "70";

            displayInput.checked = true;

            fontInput.value = "16";

            lineColorInput.value =
              "#111827";

            backgroundInput.value =
              "#ffffff";

            generate();
          }

          generateBtn.addEventListener(
            "click",
            generate
          );

          resetBtn.addEventListener(
            "click",
            reset
          );

          resetBtnMain.addEventListener(
            "click",
            reset
          );

          clearBtn.addEventListener(
            "click",
            clearPreview
          );

          clearBtn2.addEventListener(
            "click",
            clearPreview
          );

          downloadSvg.addEventListener(
            "click",
            exportSVG
          );

          downloadPng.addEventListener(
            "click",
            exportPNG
          );

          copyBtn.addEventListener(
            "click",
            copyValue
          );

          valueInput.addEventListener(
            "keydown",
            (event) => {
              if (
                event.key === "Enter"
              ) {
                generate();
              }
            }
          );

          [
            typeInput,
            widthInput,
            heightInput,
            displayInput,
            fontInput,
            lineColorInput,
            backgroundInput
          ].forEach((element) => {
            element.addEventListener(
              "change",
              () => {
                if (
                  barcodeSvg.style.display !==
                  "none"
                ) {
                  generate();
                }
              }
            );
          });

          generate();
        }

        function init() {
          watchTheme();

          if (
            document.readyState ===
            "loading"
          ) {
            document.addEventListener(
              "DOMContentLoaded",
              startBarcodeTool,
              { once: true }
            );
          } else {
            startBarcodeTool();
          }
        }

        init();
      })();
    </script>
  </body>
</html>
