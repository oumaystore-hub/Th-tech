---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/barcode-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Barcode Generator | مولد الباركود | Th.Tech</title>

    <meta
      name="description"
      content="مولد باركود مجاني لإنشاء باركود احترافي بصيغ متعددة مع إمكانية التحميل بصيغة PNG أو SVG."
    />

    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"
    ></script>
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-icon">
          <i class="fa-solid fa-barcode"></i>
        </div>

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>مولد الباركود</span>
        </div>

        <h1>
          مولد <span>Barcode</span> احترافي
        </h1>

        <p>
          أنشئ باركود احترافي بسرعة وسهولة، مع دعم عدة أنواع وإمكانية
          تخصيص الحجم والألوان وتحميل النتيجة بصيغة PNG أو SVG.
        </p>

        <div class="hero-tags">
          <span><i class="fa-solid fa-bolt"></i> سريع</span>
          <span><i class="fa-solid fa-shield-halved"></i> آمن</span>
          <span><i class="fa-solid fa-cloud"></i> بدون رفع</span>
          <span><i class="fa-solid fa-gift"></i> مجاني</span>
        </div>
      </section>


      <!-- TOOL -->
      <section class="tool-wrapper">

        <div class="tool-card">

          <!-- TYPE -->
          <div class="field">
            <label for="barcodeType">
              <span class="label-icon">
                <i class="fa-solid fa-layer-group"></i>
              </span>
              نوع الباركود
            </label>

            <div class="select-wrap">
              <select id="barcodeType">
                <option value="CODE128">CODE 128</option>
                <option value="CODE39">CODE 39</option>
                <option value="EAN13">EAN-13</option>
                <option value="EAN8">EAN-8</option>
                <option value="UPC">UPC</option>
                <option value="ITF14">ITF-14</option>
              </select>

              <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
          </div>


          <!-- VALUE -->
          <div class="field">
            <label for="barcodeValue">
              <span class="label-icon">
                <i class="fa-solid fa-hashtag"></i>
              </span>
              القيمة
            </label>

            <div class="input-wrap">
              <input
                id="barcodeValue"
                type="text"
                value="123456789012"
                autocomplete="off"
                spellcheck="false"
                placeholder="أدخل الرقم أو النص..."
              />

              <button
                id="clearBtn"
                class="clear-btn"
                type="button"
                aria-label="مسح القيمة"
                title="مسح"
              >
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>

            <div class="field-hint">
              <i class="fa-solid fa-circle-info"></i>
              أدخل القيمة التي تريد تحويلها إلى باركود
            </div>
          </div>


          <!-- OPTIONS GRID -->
          <div class="options-grid">

            <!-- SETTINGS -->
            <section class="options-card settings-card">

              <div class="section-heading">
                <div class="section-icon settings-icon">
                  <i class="fa-solid fa-sliders"></i>
                </div>

                <div>
                  <h3>إعدادات الباركود</h3>
                  <span>تخصيص الشكل والحجم</span>
                </div>
              </div>


              <div class="settings-grid">

                <div class="mini-field">
                  <label for="barWidth">
                    عرض الخط
                  </label>

                  <div class="mini-select">
                    <select id="barWidth">
                      <option value="1">1</option>
                      <option value="2" selected>2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>

                    <i class="fa-solid fa-chevron-down"></i>
                  </div>
                </div>


                <div class="mini-field">
                  <label for="barHeight">
                    الارتفاع
                  </label>

                  <div class="mini-select">
                    <select id="barHeight">
                      <option value="50">50</option>
                      <option value="70" selected>70</option>
                      <option value="90">90</option>
                      <option value="110">110</option>
                      <option value="130">130</option>
                    </select>

                    <i class="fa-solid fa-chevron-down"></i>
                  </div>
                </div>


                <div class="mini-field">
                  <label for="displayValue">
                    إظهار الرقم
                  </label>

                  <div class="mini-select">
                    <select id="displayValue">
                      <option value="true" selected>نعم</option>
                      <option value="false">لا</option>
                    </select>

                    <i class="fa-solid fa-chevron-down"></i>
                  </div>
                </div>


                <div class="mini-field">
                  <label for="fontSize">
                    حجم الخط
                  </label>

                  <div class="mini-select">
                    <select id="fontSize">
                      <option value="12">12</option>
                      <option value="16" selected>16</option>
                      <option value="20">20</option>
                      <option value="24">24</option>
                    </select>

                    <i class="fa-solid fa-chevron-down"></i>
                  </div>
                </div>

              </div>


              <!-- COLORS -->
              <div class="colors-grid">

                <div class="color-box">
                  <label for="lineColor">
                    <span>لون الباركود</span>
                  </label>

                  <div class="color-control">
                    <input
                      id="lineColor"
                      type="color"
                      value="#111827"
                    />

                    <span id="lineColorText">#111827</span>
                  </div>
                </div>


                <div class="color-box">
                  <label for="backgroundColor">
                    <span>لون الخلفية</span>
                  </label>

                  <div class="color-control">
                    <input
                      id="backgroundColor"
                      type="color"
                      value="#ffffff"
                    />

                    <span id="backgroundColorText">#FFFFFF</span>
                  </div>
                </div>

              </div>

            </section>


            <!-- EXPORT -->
            <section class="options-card export-card">

              <div class="section-heading">
                <div class="section-icon export-icon">
                  <i class="fa-solid fa-share-nodes"></i>
                </div>

                <div>
                  <h3>تصدير الباركود</h3>
                  <span>حفظ أو نسخ النتيجة</span>
                </div>
              </div>


              <div class="download-grid">

                <button
                  id="downloadPng"
                  type="button"
                  class="export-btn png-btn"
                >
                  <span class="export-btn-icon">
                    <i class="fa-solid fa-image"></i>
                  </span>

                  <span class="export-btn-content">
                    <strong>PNG</strong>
                    <small>صورة</small>
                  </span>
                </button>


                <button
                  id="downloadSvg"
                  type="button"
                  class="export-btn svg-btn"
                >
                  <span class="export-btn-icon">
                    <i class="fa-solid fa-code"></i>
                  </span>

                  <span class="export-btn-content">
                    <strong>SVG</strong>
                    <small>متجه</small>
                  </span>
                </button>


                <button
                  id="copyValue"
                  type="button"
                  class="export-btn copy-btn"
                >
                  <span class="export-btn-icon">
                    <i class="fa-regular fa-copy"></i>
                  </span>

                  <span class="export-btn-content">
                    <strong>نسخ</strong>
                    <small>القيمة</small>
                  </span>
                </button>


                <button
                  id="resetBtn"
                  type="button"
                  class="export-btn reset-export-btn"
                >
                  <span class="export-btn-icon">
                    <i class="fa-solid fa-rotate-left"></i>
                  </span>

                  <span class="export-btn-content">
                    <strong>إعادة</strong>
                    <small>الضبط</small>
                  </span>
                </button>

              </div>

              <div class="export-tip">
                <i class="fa-solid fa-lock"></i>
                <span>يتم إنشاء الملف داخل متصفحك دون رفع بياناتك.</span>
              </div>

            </section>

          </div>


          <!-- MAIN ACTION -->
          <div class="main-actions">

            <button id="generateBtn" type="button" class="generate-btn">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              إنشاء الباركود
            </button>

            <button id="resetBtnMain" type="button" class="reset-btn">
              <i class="fa-solid fa-arrow-rotate-left"></i>
              إعادة ضبط
            </button>

          </div>


          <!-- STATUS -->
          <div id="status" class="status" aria-live="polite">
            <i class="fa-solid fa-circle-check"></i>
            جاهز لإنشاء الباركود
          </div>


          <!-- PREVIEW -->
          <section class="preview-section">

            <div class="preview-heading">
              <div>
                <h2>
                  <i class="fa-solid fa-eye"></i>
                  المعاينة
                </h2>

                <p>ستظهر النتيجة هنا بشكل مباشر</p>
              </div>

              <span id="formatBadge" class="format-badge">
                CODE128
              </span>
            </div>


            <div class="preview-box">

              <div id="emptyPreview" class="empty-preview">
                <div class="empty-icon">
                  <i class="fa-solid fa-barcode"></i>
                </div>

                <strong>المعاينة جاهزة</strong>
                <span>أدخل قيمة لإنشاء الباركود</span>
              </div>

              <svg
                id="barcodeSvg"
                class="barcode-svg"
                aria-label="Barcode preview"
              ></svg>

              <canvas
                id="barcodeCanvas"
                class="barcode-canvas"
              ></canvas>

            </div>


            <div class="preview-meta">
              <span>
                <i class="fa-solid fa-ruler-horizontal"></i>
                معاينة مباشرة
              </span>

              <span>
                <i class="fa-solid fa-shield-halved"></i>
                معالجة محلية
              </span>

              <span>
                <i class="fa-solid fa-download"></i>
                PNG / SVG
              </span>
            </div>

          </section>

        </div>
      </section>


      <!-- PRIVACY -->
      <section class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>
          <h2>خصوصيتك أولاً</h2>

          <p>
            يتم إنشاء الباركود بالكامل داخل متصفحك. لا يتم إرسال القيمة التي
            تدخلها إلى خادم أو تخزينها في قاعدة بيانات.
          </p>
        </div>

      </section>


      <!-- HOW TO -->
      <section class="content-section">

        <div class="content-heading">
          <span class="content-number">01</span>

          <div>
            <h2>كيفية إنشاء باركود؟</h2>
            <p>أنشئ الباركود في ثلاث خطوات بسيطة.</p>
          </div>
        </div>


        <div class="steps">

          <div class="step">
            <div class="step-number">1</div>

            <div>
              <h3>اختر النوع</h3>
              <p>
                اختر نوع الباركود المناسب من القائمة مثل CODE128 أو EAN13.
              </p>
            </div>
          </div>


          <div class="step">
            <div class="step-number">2</div>

            <div>
              <h3>أدخل القيمة</h3>
              <p>
                أدخل الرقم أو النص الذي تريد تحويله إلى باركود.
              </p>
            </div>
          </div>


          <div class="step">
            <div class="step-number">3</div>

            <div>
              <h3>حمّل النتيجة</h3>
              <p>
                استخدم PNG للصور أو SVG للحصول على جودة متجهية عالية.
              </p>
            </div>
          </div>

        </div>

      </section>


      <!-- FEATURES -->
      <section class="content-section">

        <div class="content-heading">
          <span class="content-number">02</span>

          <div>
            <h2>مميزات مولد الباركود</h2>
            <p>أداة بسيطة وسريعة للاستخدام اليومي.</p>
          </div>
        </div>


        <div class="features-grid">

          <article class="feature">
            <div class="feature-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>إنشاء فوري</h3>
            <p>شاهد الباركود مباشرة أثناء العمل.</p>
          </article>


          <article class="feature">
            <div class="feature-icon">
              <i class="fa-solid fa-palette"></i>
            </div>

            <h3>ألوان مخصصة</h3>
            <p>اختر لون الباركود والخلفية حسب احتياجك.</p>
          </article>


          <article class="feature">
            <div class="feature-icon">
              <i class="fa-solid fa-expand"></i>
            </div>

            <h3>تحكم بالحجم</h3>
            <p>تحكم في العرض والارتفاع وحجم النص.</p>
          </article>


          <article class="feature">
            <div class="feature-icon">
              <i class="fa-solid fa-file-export"></i>
            </div>

            <h3>تصدير متعدد</h3>
            <p>احفظ النتيجة بصيغة PNG أو SVG.</p>
          </article>

        </div>

      </section>


      <!-- FAQ -->
      <section class="faq-section">

        <div class="content-heading">
          <span class="content-number">03</span>

          <div>
            <h2>الأسئلة الشائعة</h2>
            <p>إجابات عن الأسئلة الأكثر شيوعاً.</p>
          </div>
        </div>


        <div class="faq-list">

          <details>
            <summary>
              <span>هل مولد الباركود مجاني؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم، الأداة مجانية ويمكنك إنشاء وتحميل الباركود دون تسجيل.
            </p>
          </details>


          <details>
            <summary>
              <span>هل يتم حفظ البيانات التي أدخلها؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              لا. يتم إنشاء الباركود محلياً داخل المتصفح ولا يتم رفع القيمة
              إلى خادم.
            </p>
          </details>


          <details>
            <summary>
              <span>ما الفرق بين PNG و SVG؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              PNG مناسب للاستخدام كصورة، بينما SVG يحافظ على الجودة عند
              التكبير والطباعة.
            </p>
          </details>


          <details>
            <summary>
              <span>ما أنواع الباركود المدعومة؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              تدعم الأداة CODE128 وCODE39 وEAN13 وEAN8 وUPC وITF14.
            </p>
          </details>

        </div>

      </section>

    </main>

    <Footer />


    <script is:inline>
      function startBarcodeTool() {
        const barcodeType = document.getElementById('barcodeType');
        const barcodeValue = document.getElementById('barcodeValue');

        const barWidth = document.getElementById('barWidth');
        const barHeight = document.getElementById('barHeight');
        const displayValue = document.getElementById('displayValue');
        const fontSize = document.getElementById('fontSize');

        const lineColor = document.getElementById('lineColor');
        const backgroundColor = document.getElementById('backgroundColor');

        const lineColorText = document.getElementById('lineColorText');
        const backgroundColorText =
          document.getElementById('backgroundColorText');

        const barcodeSvg = document.getElementById('barcodeSvg');
        const barcodeCanvas = document.getElementById('barcodeCanvas');

        const emptyPreview = document.getElementById('emptyPreview');

        const generateBtn = document.getElementById('generateBtn');
        const resetBtn = document.getElementById('resetBtn');
        const resetBtnMain = document.getElementById('resetBtnMain');

        const clearBtn = document.getElementById('clearBtn');

        const downloadPng = document.getElementById('downloadPng');
        const downloadSvg = document.getElementById('downloadSvg');
        const copyValue = document.getElementById('copyValue');

        const status = document.getElementById('status');
        const formatBadge = document.getElementById('formatBadge');

        let currentSvg = '';

        function setStatus(message, type = 'success') {
          if (!status) return;

          const icons = {
            success: 'fa-circle-check',
            error: 'fa-circle-exclamation',
            info: 'fa-circle-info'
          };

          status.className = `status ${type}`;

          status.innerHTML = `
            <i class="fa-solid ${icons[type] || icons.info}"></i>
            <span>${message}</span>
          `;
        }


        function normalizeValue(value) {
          return value.trim();
        }


        function validate(value, type) {
          if (!value) {
            return 'الرجاء إدخال قيمة أولاً.';
          }

          if (type === 'EAN13') {
            if (!/^\d{12,13}$/.test(value)) {
              return 'EAN-13 يجب أن يحتوي على 12 أو 13 رقماً.';
            }
          }

          if (type === 'EAN8') {
            if (!/^\d{7,8}$/.test(value)) {
              return 'EAN-8 يجب أن يحتوي على 7 أو 8 أرقام.';
            }
          }

          if (type === 'UPC') {
            if (!/^\d{11,12}$/.test(value)) {
              return 'UPC يجب أن يحتوي على 11 أو 12 رقماً.';
            }
          }

          if (type === 'ITF14') {
            if (!/^\d{13,14}$/.test(value)) {
              return 'ITF-14 يجب أن يحتوي على 13 أو 14 رقماً.';
            }
          }

          if (type === 'CODE39') {
            if (!/^[0-9A-Z .\-$/+%]+$/i.test(value)) {
              return 'CODE39 يدعم الأرقام والحروف الإنجليزية وبعض الرموز فقط.';
            }
          }

          return null;
        }


        function clearPreview() {
          barcodeSvg.innerHTML = '';
          barcodeSvg.style.display = 'none';

          barcodeCanvas.style.display = 'none';
          emptyPreview.style.display = 'flex';

          currentSvg = '';
        }


        function generate() {
          if (
            typeof JsBarcode === 'undefined' ||
            !barcodeSvg
          ) {
            setStatus(
              'تعذر تحميل مكتبة الباركود. تحقق من اتصال الإنترنت.',
              'error'
            );

            return;
          }

          const value = normalizeValue(barcodeValue.value);
          const type = barcodeType.value;

          const error = validate(value, type);

          if (error) {
            clearPreview();
            setStatus(error, 'error');
            return;
          }

          try {
            barcodeSvg.innerHTML = '';

            JsBarcode(barcodeSvg, value, {
              format: type,
              width: Number(barWidth.value),
              height: Number(barHeight.value),
              displayValue: displayValue.value === 'true',
              fontSize: Number(fontSize.value),
              lineColor: lineColor.value,
              background: backgroundColor.value,
              margin: 12,
              textMargin: 5
            });

            currentSvg = new XMLSerializer().serializeToString(
              barcodeSvg
            );

            barcodeSvg.style.display = 'block';
            barcodeCanvas.style.display = 'none';
            emptyPreview.style.display = 'none';

            formatBadge.textContent = type;

            setStatus(
              'تم إنشاء الباركود بنجاح.',
              'success'
            );

          } catch (error) {
            clearPreview();

            setStatus(
              'تعذر إنشاء الباركود. تحقق من القيمة المدخلة.',
              'error'
            );
          }
        }


        function updateInterface() {
          lineColorText.textContent =
            lineColor.value.toUpperCase();

          backgroundColorText.textContent =
            backgroundColor.value.toUpperCase();

          formatBadge.textContent = barcodeType.value;
        }


        function downloadFile(blob, filename) {
          const url = URL.createObjectURL(blob);

          const link = document.createElement('a');

          link.href = url;
          link.download = filename;

          document.body.appendChild(link);
          link.click();
          link.remove();

          setTimeout(() => {
            URL.revokeObjectURL(url);
          }, 500);
        }


        function downloadSVG() {
          if (!currentSvg) {
            generate();

            if (!currentSvg) return;
          }

          const svgBlob = new Blob(
            [currentSvg],
            {
              type: 'image/svg+xml;charset=utf-8'
            }
          );

          downloadFile(
            svgBlob,
            `barcode-${Date.now()}.svg`
          );

          setStatus(
            'تم تحميل ملف SVG بنجاح.',
            'success'
          );
        }


        function downloadPNG() {
          if (!currentSvg) {
            generate();

            if (!currentSvg) return;
          }

          const svgBlob = new Blob(
            [currentSvg],
            {
              type: 'image/svg+xml;charset=utf-8'
            }
          );

          const url = URL.createObjectURL(svgBlob);

          const image = new Image();

          image.onload = () => {
            const scale = 2;

            const width = image.width || 500;
            const height = image.height || 150;

            barcodeCanvas.width = width * scale;
            barcodeCanvas.height = height * scale;

            const context = barcodeCanvas.getContext('2d');

            context.setTransform(
              scale,
              0,
              0,
              scale,
              0,
              0
            );

            context.fillStyle =
              backgroundColor.value || '#ffffff';

            context.fillRect(
              0,
              0,
              width,
              height
            );

            context.drawImage(
              image,
              0,
              0,
              width,
              height
            );

            barcodeCanvas.toBlob(
              (blob) => {
                if (blob) {
                  downloadFile(
                    blob,
                    `barcode-${Date.now()}.png`
                  );

                  setStatus(
                    'تم تحميل ملف PNG بنجاح.',
                    'success'
                  );
                }

                URL.revokeObjectURL(url);
              },
              'image/png'
            );
          };

          image.onerror = () => {
            URL.revokeObjectURL(url);

            setStatus(
              'تعذر إنشاء صورة PNG.',
              'error'
            );
          };

          image.src = url;
        }


        async function copyBarcodeValue() {
          const value = normalizeValue(
            barcodeValue.value
          );

          if (!value) {
            setStatus(
              'لا توجد قيمة لنسخها.',
              'error'
            );

            return;
          }

          try {
            await navigator.clipboard.writeText(value);

            setStatus(
              'تم نسخ قيمة الباركود.',
              'success'
            );

          } catch {
            fallbackCopy(value);
          }
        }


        function fallbackCopy(value) {
          const textarea =
            document.createElement('textarea');

          textarea.value = value;

          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(textarea);

          textarea.focus();
          textarea.select();

          try {
            document.execCommand('copy');

            setStatus(
              'تم نسخ قيمة الباركود.',
              'success'
            );

          } catch {
            setStatus(
              'تعذر نسخ القيمة.',
              'error'
            );
          }

          textarea.remove();
        }


        function reset() {
          barcodeType.value = 'CODE128';

          barcodeValue.value = '123456789012';

          barWidth.value = '2';
          barHeight.value = '70';

          displayValue.value = 'true';
          fontSize.value = '16';

          lineColor.value = '#111827';
          backgroundColor.value = '#ffffff';

          updateInterface();
          clearPreview();

          setStatus(
            'تمت إعادة الإعدادات إلى الوضع الافتراضي.',
            'success'
          );

          generate();
        }


        generateBtn.addEventListener(
          'click',
          generate
        );

        resetBtn.addEventListener(
          'click',
          reset
        );

        resetBtnMain.addEventListener(
          'click',
          reset
        );

        downloadPng.addEventListener(
          'click',
          downloadPNG
        );

        downloadSvg.addEventListener(
          'click',
          downloadSVG
        );

        copyValue.addEventListener(
          'click',
          copyBarcodeValue
        );


        clearBtn.addEventListener(
          'click',
          () => {
            barcodeValue.value = '';

            clearPreview();

            setStatus(
              'تم مسح القيمة.',
              'info'
            );

            barcodeValue.focus();
          }
        );


        barcodeValue.addEventListener(
          'input',
          () => {
            if (barcodeValue.value.trim()) {
              generate();
            } else {
              clearPreview();

              setStatus(
                'أدخل قيمة لإنشاء الباركود.',
                'info'
              );
            }
          }
        );


        barcodeType.addEventListener(
          'change',
          () => {
            updateInterface();

            if (barcodeValue.value.trim()) {
              generate();
            }
          }
        );


        [
          barWidth,
          barHeight,
          displayValue,
          fontSize
        ].forEach((element) => {
          element.addEventListener(
            'change',
            generate
          );
        });


        lineColor.addEventListener(
          'input',
          () => {
            updateInterface();

            if (barcodeValue.value.trim()) {
              generate();
            }
          }
        );


        backgroundColor.addEventListener(
          'input',
          () => {
            updateInterface();

            if (barcodeValue.value.trim()) {
              generate();
            }
          }
        );


        updateInterface();
        generate();
      }


      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          startBarcodeTool
        );
      } else {
        startBarcodeTool();
      }
    </script>


