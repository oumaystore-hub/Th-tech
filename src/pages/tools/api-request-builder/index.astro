    <script is:inline>
      (() => {
        const method = document.getElementById("method");
        const urlInput = document.getElementById("url");

        const sendBtn = document.getElementById("sendBtn");
        const sampleBtn = document.getElementById("sampleBtn");
        const clearBtn = document.getElementById("clearBtn");

        const addParam = document.getElementById("addParam");
        const addHeader = document.getElementById("addHeader");

        const paramsList = document.getElementById("paramsList");
        const headersList = document.getElementById("headersList");

        const paramsEmpty = document.getElementById("paramsEmpty");
        const headersEmpty = document.getElementById("headersEmpty");

        const bodyInput = document.getElementById("bodyInput");
        const formatBtn = document.getElementById("formatBtn");
        const clearBody = document.getElementById("clearBody");
        const jsonStatus = document.getElementById("jsonStatus");

        const curlOutput = document.getElementById("curlOutput");
        const copyCurl = document.getElementById("copyCurl");

        const status = document.getElementById("status");

        const responseOutput = document.getElementById("responseOutput");
        const responseHeadersOutput =
          document.getElementById("responseHeadersOutput");

        const statusBadge = document.getElementById("statusBadge");
        const responseTime = document.getElementById("responseTime");

        const copyResponseBtn =
          document.getElementById("copyResponseBtn");

        function syncTheme() {
          try {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function (event) {
          const target = event.target;

          if (
            target &&
            (
              target.id === "theme-btn" ||
              (target.closest && target.closest("#theme-btn"))
            )
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        function setStatus(message, type) {
          status.className = "status";

          if (type) {
            status.classList.add(type);
          }

          let icon = "fa-circle-info";

          if (type === "success") {
            icon = "fa-circle-check";
          }

          if (type === "error") {
            icon = "fa-circle-exclamation";
          }

          status.innerHTML =
            '<i class="fa-solid ' +
            icon +
            '"></i>' +
            message;
        }

        function updateEmptyState() {
          paramsEmpty.classList.toggle(
            "hidden",
            paramsList.children.length > 0
          );

          headersEmpty.classList.toggle(
            "hidden",
            headersList.children.length > 0
          );
        }

        function createRow(type, key = "", value = "") {
          const row = document.createElement("div");

          row.className = "request-row";

          const keyInput = document.createElement("input");
          keyInput.type = "text";
          keyInput.placeholder =
            type === "param" ? "parameter" : "Header";
          keyInput.value = key;
          keyInput.setAttribute(
            "aria-label",
            type === "param"
              ? "Parameter name"
              : "Header name"
          );

          const valueInput = document.createElement("input");
          valueInput.type = "text";
          valueInput.placeholder =
            type === "param" ? "value" : "Header value";
          valueInput.value = value;
          valueInput.setAttribute(
            "aria-label",
            type === "param"
              ? "Parameter value"
              : "Header value"
          );

          const remove = document.createElement("button");

          remove.type = "button";
          remove.className = "remove-row";
          remove.innerHTML =
            '<i class="fa-solid fa-xmark"></i>';
          remove.setAttribute("aria-label", "حذف");

          remove.addEventListener("click", function () {
            row.remove();

            updateEmptyState();
            updateCurl();
          });

          keyInput.addEventListener("input", updateCurl);
          valueInput.addEventListener("input", updateCurl);

          row.appendChild(keyInput);
          row.appendChild(valueInput);
          row.appendChild(remove);

          if (type === "param") {
            paramsList.appendChild(row);
          } else {
            headersList.appendChild(row);
          }

          updateEmptyState();
          updateCurl();
        }

        addParam.addEventListener("click", function () {
          createRow("param");
        });

        addHeader.addEventListener("click", function () {
          createRow("header");
        });

        function getRows(container) {
          return Array.from(
            container.querySelectorAll(".request-row")
          )
            .map(function (row) {
              const inputs = row.querySelectorAll("input");

              return {
                key: inputs[0].value.trim(),
                value: inputs[1].value
              };
            })
            .filter(function (item) {
              return item.key !== "";
            });
        }

        function buildUrl() {
          const rawUrl = urlInput.value.trim();

          if (!rawUrl) {
            return "";
          }

          try {
            const url = new URL(rawUrl);

            getRows(paramsList).forEach(function (item) {
              url.searchParams.set(
                item.key,
                item.value
              );
            });

            return url.toString();
          } catch {
            return rawUrl;
          }
        }

        function shellQuote(value) {
          return "'" +
            String(value).replace(/'/g, "'\\''") +
            "'";
        }

        function updateCurl() {
          const requestUrl = buildUrl();

          if (!requestUrl) {
            curlOutput.value = "";
            return;
          }

          const selectedMethod = method.value;

          let command =
            "curl -X " +
            selectedMethod +
            " " +
            shellQuote(requestUrl);

          getRows(headersList).forEach(function (item) {
            command +=
              " \\\n  -H " +
              shellQuote(
                item.key + ": " + item.value
              );
          });

          const body = bodyInput.value.trim();

          if (
            body &&
            selectedMethod !== "GET" &&
            selectedMethod !== "HEAD"
          ) {
            command +=
              " \\\n  --data-raw " +
              shellQuote(body);
          }

          curlOutput.value = command;
        }

        function validateJson() {
          const value = bodyInput.value.trim();

          jsonStatus.className = "json-status";

          if (!value) {
            jsonStatus.innerHTML =
              '<i class="fa-solid fa-circle-info"></i>' +
              "Body اختياري ويستخدم عادة مع POST وPUT وPATCH.";

            return true;
          }

          try {
            JSON.parse(value);

            jsonStatus.classList.add("valid");

            jsonStatus.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>' +
              "JSON صالح ويمكن استخدامه في الطلب.";

            return true;
          } catch (error) {
            jsonStatus.classList.add("invalid");

            jsonStatus.innerHTML =
              '<i class="fa-solid fa-circle-exclamation"></i>' +
              "JSON غير صالح. تحقق من الأقواس والفواصل وعلامات الاقتباس.";

            return false;
          }
        }

        formatBtn.addEventListener("click", function () {
          const value = bodyInput.value.trim();

          if (!value) {
            setStatus("لا يوجد JSON لتنسيقه.", "error");
            return;
          }

          try {
            const parsed = JSON.parse(value);

            bodyInput.value =
              JSON.stringify(parsed, null, 2);

            validateJson();
            updateCurl();

            setStatus(
              "تم تنسيق JSON بنجاح.",
              "success"
            );
          } catch {
            validateJson();

            setStatus(
              "تعذر تنسيق JSON لأنه غير صالح.",
              "error"
            );
          }
        });

        clearBody.addEventListener("click", function () {
          bodyInput.value = "";

          validateJson();
          updateCurl();

          setStatus("تم مسح Request Body.", "");
        });

        bodyInput.addEventListener("input", function () {
          validateJson();
          updateCurl();
        });

        method.addEventListener("change", updateCurl);
        urlInput.addEventListener("input", updateCurl);

        document.querySelectorAll(".tab").forEach(function (tab) {
          tab.addEventListener("click", function () {
            const target = tab.dataset.tab;

            document
              .querySelectorAll(".tab")
              .forEach(function (item) {
                item.classList.remove("active");
              });

            document
              .querySelectorAll(".tab-panel")
              .forEach(function (panel) {
                panel.classList.remove("active");
              });

            tab.classList.add("active");

            const panel = document.getElementById(
              target + "Panel"
            );

            if (panel) {
              panel.classList.add("active");
            }

            updateCurl();
          });
        });

        document
          .querySelectorAll(".response-tab")
          .forEach(function (tab) {
            tab.addEventListener("click", function () {
              const target = tab.dataset.responseTab;

              document
                .querySelectorAll(".response-tab")
                .forEach(function (item) {
                  item.classList.remove("active");
                });

              document
                .querySelectorAll(".response-panel")
                .forEach(function (panel) {
                  panel.classList.remove("active");
                });

              tab.classList.add("active");

              const panel =
                document.getElementById(
                  "response" +
                  target.charAt(0).toUpperCase() +
                  target.slice(1) +
                  "Panel"
                );

              if (panel) {
                panel.classList.add("active");
              }
            });
          });

        async function sendRequest() {
          const requestUrl = buildUrl();

          if (!requestUrl) {
            setStatus(
              "أدخل رابط API صالحاً أولاً.",
              "error"
            );
            return;
          }

          if (!/^https?:\/\//i.test(requestUrl)) {
            setStatus(
              "يجب أن يبدأ الرابط بـ http:// أو https://.",
              "error"
            );
            return;
          }

          const requestMethod = method.value;
          const headers = {};

          getRows(headersList).forEach(function (item) {
            headers[item.key] = item.value;
          });

          const body = bodyInput.value.trim();

          if (
            body &&
            requestMethod !== "GET" &&
            requestMethod !== "HEAD"
          ) {
            if (!validateJson()) {
              setStatus(
                "لا يمكن إرسال الطلب لأن JSON غير صالح.",
                "error"
              );
              return;
            }

            if (
              !Object.keys(headers).some(function (key) {
                return key.toLowerCase() === "content-type";
              })
            ) {
              headers["Content-Type"] =
                "application/json";
            }
          }

          sendBtn.classList.add("loading");

          sendBtn.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i>' +
            " جارٍ الإرسال";

          setStatus(
            "جارٍ إرسال طلب " +
            requestMethod +
            "...",
            ""
          );

          statusBadge.className =
            "status-badge neutral";

          statusBadge.textContent = "Loading";

          responseTime.textContent = "…";

          responseOutput.textContent =
            "جارٍ انتظار الاستجابة...";

          responseHeadersOutput.textContent =
            "جارٍ تحميل Headers...";

          const started = performance.now();

          try {
            const options = {
              method: requestMethod,
              headers: headers
            };

            if (
              body &&
              requestMethod !== "GET" &&
              requestMethod !== "HEAD"
            ) {
              options.body = body;
            }

            const response = await fetch(
              requestUrl,
              options
            );

            const elapsed =
              Math.round(
                performance.now() - started
              );

            responseTime.textContent =
              elapsed + " ms";

            statusBadge.textContent =
              response.status +
              " " +
              (response.statusText || "");

            if (response.ok) {
              statusBadge.className =
                "status-badge success";

              setStatus(
                "تم تنفيذ الطلب بنجاح.",
                "success"
              );
            } else {
              statusBadge.className =
                "status-badge error";

              setStatus(
                "استجاب الخادم بالحالة " +
                response.status +
                ".",
                "error"
              );
            }

            const contentType =
              response.headers.get("content-type") ||
              "";

            const responseText =
              await response.text();

            if (
              contentType.includes("application/json")
            ) {
              try {
                const parsed =
                  JSON.parse(responseText);

                responseOutput.textContent =
                  JSON.stringify(
                    parsed,
                    null,
                    2
                  );
              } catch {
                responseOutput.textContent =
                  responseText ||
                  "(استجابة فارغة)";
              }
            } else {
              responseOutput.textContent =
                responseText ||
                "(استجابة فارغة)";
            }

            const headerLines = [];

            response.headers.forEach(
              function (value, key) {
                headerLines.push(
                  key + ": " + value
                );
              }
            );

            responseHeadersOutput.textContent =
              headerLines.length
                ? headerLines.join("\n")
                : "لا توجد Headers ظاهرة في الاستجابة.";

          } catch (error) {
            const elapsed =
              Math.round(
                performance.now() - started
              );

            responseTime.textContent =
              elapsed + " ms";

            statusBadge.className =
              "status-badge error";

            statusBadge.textContent =
              "Request Error";

            responseOutput.textContent =
              "تعذر تنفيذ الطلب.\n\n" +
              "السبب المحتمل:\n" +
              "• مشكلة CORS\n" +
              "• الرابط غير صالح أو غير متاح\n" +
              "• مشكلة في الاتصال بالشبكة\n" +
              "• الخادم رفض الطلب\n\n" +
              "التفاصيل:\n" +
              String(error.message || error);

            responseHeadersOutput.textContent =
              "لا توجد Headers بسبب فشل الطلب.";

            setStatus(
              "تعذر تنفيذ الطلب. تحقق من الرابط وسياسة CORS.",
              "error"
            );

          } finally {
            sendBtn.classList.remove("loading");

            sendBtn.innerHTML =
              '<i class="fa-solid fa-paper-plane"></i>' +
              " إرسال";
          }
        }

        sendBtn.addEventListener(
          "click",
          sendRequest
        );

        sampleBtn.addEventListener(
          "click",
          function () {
            method.value = "POST";

            urlInput.value =
              "https://jsonplaceholder.typicode.com/posts";

            paramsList.innerHTML = "";
            headersList.innerHTML = "";

            createRow(
              "header",
              "Accept",
              "application/json"
            );

            createRow(
              "header",
              "Content-Type",
              "application/json"
            );

            bodyInput.value =
              '{\n' +
              '  "title": "Th.Tech",\n' +
              '  "body": "Hello from API Request Builder",\n' +
              '  "userId": 1\n' +
              '}';

            validateJson();
            updateEmptyState();
            updateCurl();

            setStatus(
              "تم تحميل مثال API جاهز للتجربة.",
              "success"
            );

            document
              .querySelectorAll(".tab")
              .forEach(function (tab) {
                tab.classList.remove("active");
              });

            document
              .querySelectorAll(".tab-panel")
              .forEach(function (panel) {
                panel.classList.remove("active");
              });

            const bodyTab =
              document.querySelector(
                '[data-tab="body"]'
              );

            bodyTab.classList.add("active");

            document
              .getElementById("bodyPanel")
              .classList.add("active");
          }
        );

        async function copyText(value, successMessage) {
          if (!value) {
            setStatus(
              "لا توجد بيانات لنسخها.",
              "error"
            );
            return;
          }

          try {
            await navigator.clipboard.writeText(value);

            setStatus(
              successMessage,
              "success"
            );
          } catch {
            setStatus(
              "تعذر النسخ تلقائياً. حدد النص وانسخه يدوياً.",
              "error"
            );
          }
        }

        copyCurl.addEventListener(
          "click",
          function () {
            copyText(
              curlOutput.value,
              "تم نسخ أمر cURL."
            );
          }
        );

        copyResponseBtn.addEventListener(
          "click",
          function () {
            copyText(
              responseOutput.textContent,
              "تم نسخ الاستجابة."
            );
          }
        );

        clearBtn.addEventListener(
          "click",
          function () {
            method.value = "GET";

            urlInput.value =
              "https://jsonplaceholder.typicode.com/posts/1";

            paramsList.innerHTML = "";
            headersList.innerHTML = "";

            bodyInput.value = "";

            responseOutput.textContent =
              "لم يتم إرسال أي طلب بعد.";

            responseHeadersOutput.textContent =
              "ستظهر Headers هنا بعد إرسال الطلب.";

            statusBadge.className =
              "status-badge neutral";

            statusBadge.textContent =
              "Waiting";

            responseTime.textContent =
              "0 ms";

            validateJson();
            updateEmptyState();
            updateCurl();

            setStatus(
              "تمت إعادة ضبط الأداة.",
              "success"
            );
          }
        );

        urlInput.addEventListener(
          "keydown",
          function (event) {
            if (event.key === "Enter") {
              sendRequest();
            }
          }
        );

        updateEmptyState();
        validateJson();
        updateCurl();
      })();
    </script>
  </body>
</html>
