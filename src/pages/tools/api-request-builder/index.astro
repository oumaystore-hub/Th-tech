---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/api-request-builder/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>API Request Builder | منشئ طلبات API - Th.Tech</title>

  <meta
    name="description"
    content="منشئ طلبات API احترافي لبناء وإرسال طلبات GET وPOST وPUT وPATCH وDELETE مع Headers وQuery Parameters وJSON Body وعرض الاستجابة."
  />

  <meta
    name="keywords"
    content="API Request Builder, API tester, REST API client, HTTP request builder, JSON API, API testing, منشئ طلبات API"
  />

  <link rel="canonical" href={canonical} />

  <meta name="theme-color" content="#07111f" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="api-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-icon">
        <i class="fa-solid fa-plug"></i>
      </div>

      <div class="hero-content">

        <span class="eyebrow">
          <i class="fa-solid fa-code"></i>
          DEVELOPER TOOL
        </span>

        <h1>
          منشئ طلبات
          <span>API</span>
        </h1>

        <p>
          أنشئ واختبر طلبات HTTP بسهولة مع دعم
          Headers وParameters وJSON Body والاستجابات.
        </p>

      </div>

    </section>


    <!-- REQUEST BUILDER -->
    <section class="builder-card">

      <div class="builder-header">

        <div class="builder-title">

          <div class="title-icon">
            <i class="fa-solid fa-terminal"></i>
          </div>

          <div>
            <h2>بناء الطلب</h2>
            <span>HTTP Request</span>
          </div>

        </div>

        <button
          id="clearBtn"
          class="clear-btn"
          type="button"
        >
          <i class="fa-solid fa-rotate-right"></i>
          مسح
        </button>

      </div>


      <!-- URL BAR -->
      <div class="url-row">

        <select
          id="methodSelect"
          class="method-select"
          aria-label="HTTP Method"
        >
          <option value="GET">GET</option>
          <option value="POST">POST</option>
          <option value="PUT">PUT</option>
          <option value="PATCH">PATCH</option>
          <option value="DELETE">DELETE</option>
          <option value="HEAD">HEAD</option>
          <option value="OPTIONS">OPTIONS</option>
        </select>


        <input
          id="urlInput"
          class="url-input"
          type="url"
          value="https://jsonplaceholder.typicode.com/posts/1"
          placeholder="https://api.example.com/users"
          autocomplete="off"
          spellcheck="false"
          dir="ltr"
        />


        <button
          id="sendBtn"
          class="send-btn"
          type="button"
        >
          <i class="fa-solid fa-paper-plane"></i>
          <span>إرسال</span>
        </button>

      </div>


      <!-- TABS -->
      <div class="request-tabs">

        <button
          class="request-tab active"
          data-tab="params"
          type="button"
        >
          <i class="fa-solid fa-sliders"></i>
          Parameters
          <span id="paramsCount">0</span>
        </button>

        <button
          class="request-tab"
          data-tab="headers"
          type="button"
        >
          <i class="fa-solid fa-heading"></i>
          Headers
          <span id="headersCount">0</span>
        </button>

        <button
          class="request-tab"
          data-tab="body"
          type="button"
        >
          <i class="fa-solid fa-file-code"></i>
          Body
        </button>

        <button
          class="request-tab"
          data-tab="curl"
          type="button"
        >
          <i class="fa-solid fa-code"></i>
          cURL
        </button>

      </div>


      <!-- PARAMETERS -->
      <div
        id="paramsPanel"
        class="tab-panel active"
      >

        <div class="panel-heading">

          <div>
            <h3>Query Parameters</h3>
            <p>أضف المعاملات التي سيتم إرسالها مع الرابط.</p>
          </div>

          <button
            id="addParamBtn"
            class="add-btn"
            type="button"
          >
            <i class="fa-solid fa-plus"></i>
            إضافة
          </button>

        </div>

        <div
          id="paramsContainer"
          class="rows-container"
        ></div>

        <div
          id="paramsEmpty"
          class="empty-row"
        >
          <i class="fa-solid fa-link"></i>
          <span>لم تتم إضافة أي Query Parameters</span>
        </div>

      </div>


      <!-- HEADERS -->
      <div
        id="headersPanel"
        class="tab-panel"
      >

        <div class="panel-heading">

          <div>
            <h3>Request Headers</h3>
            <p>أضف HTTP Headers إلى الطلب.</p>
          </div>

          <button
            id="addHeaderBtn"
            class="add-btn"
            type="button"
          >
            <i class="fa-solid fa-plus"></i>
            إضافة
          </button>

        </div>

        <div
          id="headersContainer"
          class="rows-container"
        ></div>

        <div
          id="headersEmpty"
          class="empty-row"
        >
          <i class="fa-solid fa-heading"></i>
          <span>لم تتم إضافة أي Headers</span>
        </div>

      </div>


      <!-- BODY -->
      <div
        id="bodyPanel"
        class="tab-panel"
      >

        <div class="panel-heading">

          <div>
            <h3>Request Body</h3>
            <p>أدخل البيانات التي سيتم إرسالها في جسم الطلب.</p>
          </div>

          <div class="body-tools">

            <button
              id="formatBodyBtn"
              class="small-btn"
              type="button"
            >
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              تنسيق JSON
            </button>

            <button
              id="clearBodyBtn"
              class="small-btn danger-btn"
              type="button"
            >
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

          </div>

        </div>


        <div class="editor-wrapper">

          <textarea
            id="bodyInput"
            class="body-editor"
            spellcheck="false"
            dir="ltr"
          >{
  "title": "Hello World",
  "body": "This is a test request",
  "userId": 1
}</textarea>

          <div
            id="jsonStatus"
            class="json-status"
          >
            <i class="fa-solid fa-circle-check"></i>
            JSON صالح
          </div>

        </div>

      </div>


      <!-- CURL -->
      <div
        id="curlPanel"
        class="tab-panel"
      >

        <div class="panel-heading">

          <div>
            <h3>cURL Command</h3>
            <p>الأمر المكافئ للطلب الحالي.</p>
          </div>

          <button
            id="copyCurlBtn"
            class="small-btn"
            type="button"
          >
            <i class="fa-regular fa-copy"></i>
            نسخ
          </button>

        </div>


        <div class="code-box">

          <code id="curlOutput"></code>

        </div>

      </div>

    </section>


    <!-- RESPONSE -->
    <section class="response-section">

      <div class="response-header">

        <div class="response-title">

          <div class="response-icon">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
          </div>

          <div>
            <h2>الاستجابة</h2>
            <span>API Response</span>
          </div>

        </div>


        <div class="response-meta">

          <span
            id="statusBadge"
            class="status-badge neutral"
          >
            لم يتم الإرسال
          </span>

          <span
            id="responseTime"
            class="response-time"
          >
            —
          </span>

        </div>

      </div>


      <!-- RESPONSE TABS -->
      <div class="response-tabs">

        <button
          class="response-tab active"
          data-response-tab="responseBody"
          type="button"
        >
          <i class="fa-solid fa-file-code"></i>
          Body
        </button>

        <button
          class="response-tab"
          data-response-tab="responseHeaders"
          type="button"
        >
          <i class="fa-solid fa-heading"></i>
          Headers
        </button>

      </div>


      <!-- RESPONSE BODY -->
      <div
        id="responseBodyPanel"
        class="response-panel active"
      >

        <div class="response-toolbar">

          <span id="responseType">
            لا توجد استجابة
          </span>

          <button
            id="copyResponseBtn"
            class="small-btn"
            type="button"
          >
            <i class="fa-regular fa-copy"></i>
            نسخ
          </button>

        </div>


        <pre
          id="responseOutput"
          class="response-output"
        >لم يتم إرسال أي طلب بعد.</pre>

      </div>


      <!-- RESPONSE HEADERS -->
      <div
        id="responseHeadersPanel"
        class="response-panel"
      >

        <div
          id="responseHeadersOutput"
          class="response-headers-output"
        >
          لم يتم استلام أي Headers بعد.
        </div>

      </div>

    </section>


    <!-- INFO -->
    <section class="info-grid">

      <div class="info-card">

        <div class="info-card-icon blue">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>
          <h3>تنفيذ مباشر</h3>
          <p>
            يتم إرسال الطلب مباشرة من متصفحك إلى عنوان API الذي تحدده.
          </p>
        </div>

      </div>


      <div class="info-card">

        <div class="info-card-icon green">
          <i class="fa-solid fa-bolt"></i>
        </div>

        <div>
          <h3>استجابة فورية</h3>
          <p>
            اعرض Status Code وHeaders وBody ووقت الاستجابة في مكان واحد.
          </p>
        </div>

      </div>


      <div class="info-card">

        <div class="info-card-icon orange">
          <i class="fa-solid fa-code"></i>
        </div>

        <div>
          <h3>JSON جاهز</h3>
          <p>
            نسّق JSON وتحقق من صحته قبل إرسال الطلب.
          </p>
        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-solid fa-circle-question"></i>
        </div>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>معلومات حول استخدام API Request Builder</p>
        </div>

      </div>


      <div class="faq-list">

        <details>

          <summary>
            <span>ما هو API Request Builder؟</span>
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            أداة تساعدك على إنشاء واختبار HTTP Requests من المتصفح
            مع إمكانية تحديد Method وURL وQuery Parameters وHeaders
            وRequest Body.
          </p>

        </details>


        <details>

          <summary>
            <span>ما هي HTTP Methods المدعومة؟</span>
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            الأداة تدعم GET وPOST وPUT وPATCH وDELETE وHEAD وOPTIONS.
          </p>

        </details>


        <details>

          <summary>
            <span>لماذا قد يفشل إرسال بعض الطلبات؟</span>
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            بعض APIs تمنع الطلبات القادمة من المتصفح باستخدام
            CORS، أو تتطلب Authentication، أو ترفض Origin معينًا.
            في هذه الحالة قد تحتاج إلى استخدام API Client أو Backend.
          </p>

        </details>


        <details>

          <summary>
            <span>هل يتم حفظ بيانات الطلب؟</span>
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            هذه الصفحة لا تحتوي على نظام خاص لحفظ طلباتك.
            البيانات المستخدمة في بناء الطلب تبقى في الصفحة ما لم
            يرسلها المتصفح إلى عنوان API الذي اخترته.
          </p>

        </details>

      </div>

    </section>

  </main>


  <Footer />


  <!-- TOAST -->
  <div
    id="toast"
    class="toast"
    role="status"
    aria-live="polite"
  >
    <i class="fa-solid fa-check"></i>
    <span id="toastMessage">تم</span>
  </div>


  <script>
    document.addEventListener('DOMContentLoaded', () => {

      /* ============================================
       * THEME SYNC
       * ============================================ */

      function syncTheme() {

        const theme =
          localStorage.getItem('theme');

        if (theme === 'light') {

          document.documentElement.setAttribute(
            'data-theme',
            'light'
          );

        } else {

          document.documentElement.removeAttribute(
            'data-theme'
          );

        }

      }

      syncTheme();


      const themeButton =
        document.getElementById('theme-btn');

      if (themeButton) {

        themeButton.addEventListener(
          'click',
          () => {

            setTimeout(() => {
              syncTheme();
            }, 0);

          }
        );

      }


      /* ============================================
       * ELEMENTS
       * ============================================ */

      const methodSelect =
        document.getElementById('methodSelect');

      const urlInput =
        document.getElementById('urlInput');

      const sendBtn =
        document.getElementById('sendBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const addParamBtn =
        document.getElementById('addParamBtn');

      const addHeaderBtn =
        document.getElementById('addHeaderBtn');

      const paramsContainer =
        document.getElementById('paramsContainer');

      const headersContainer =
        document.getElementById('headersContainer');

      const paramsEmpty =
        document.getElementById('paramsEmpty');

      const headersEmpty =
        document.getElementById('headersEmpty');

      const paramsCount =
        document.getElementById('paramsCount');

      const headersCount =
        document.getElementById('headersCount');

      const bodyInput =
        document.getElementById('bodyInput');

      const formatBodyBtn =
        document.getElementById('formatBodyBtn');

      const clearBodyBtn =
        document.getElementById('clearBodyBtn');

      const jsonStatus =
        document.getElementById('jsonStatus');

      const curlOutput =
        document.getElementById('curlOutput');

      const copyCurlBtn =
        document.getElementById('copyCurlBtn');

      const statusBadge =
        document.getElementById('statusBadge');

      const responseTime =
        document.getElementById('responseTime');

      const responseOutput =
        document.getElementById('responseOutput');

      const responseType =
        document.getElementById('responseType');

      const copyResponseBtn =
        document.getElementById('copyResponseBtn');

      const responseHeadersOutput =
        document.getElementById(
          'responseHeadersOutput'
        );

      const toast =
        document.getElementById('toast');

      const toastMessage =
        document.getElementById(
          'toastMessage'
        );


      /* ============================================
       * STATE
       * ============================================ */

      let requestId = 0;

      let lastResponseText = '';

      let lastResponseHeaders = '';


      /* ============================================
       * TOAST
       * ============================================ */

      let toastTimer = null;


      function showToast(message) {

        toastMessage.textContent =
          message;

        toast.classList.add('show');

        clearTimeout(toastTimer);

        toastTimer = setTimeout(() => {

          toast.classList.remove('show');

        }, 2200);

      }


      /* ============================================
       * COPY
       * ============================================ */

      async function copyText(text) {

        try {

          await navigator.clipboard.writeText(
            text
          );

          return true;

        } catch {

          const textarea =
            document.createElement('textarea');

          textarea.value = text;

          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(
            textarea
          );

          textarea.select();

          let success = false;

          try {

            success =
              document.execCommand('copy');

          } catch {

            success = false;

          }

          textarea.remove();

          return success;

        }

      }


      /* ============================================
       * TABS
       * ============================================ */

      document
        .querySelectorAll('.request-tab')
        .forEach(tab => {

          tab.addEventListener(
            'click',
            () => {

              const target =
                tab.dataset.tab;


              document
                .querySelectorAll(
                  '.request-tab'
                )
                .forEach(item => {
                  item.classList.remove(
                    'active'
                  );
                });


              document
                .querySelectorAll(
                  '.tab-panel'
                )
                .forEach(panel => {
                  panel.classList.remove(
                    'active'
                  );
                });


              tab.classList.add(
                'active'
              );


              const panel =
                document.getElementById(
                  `${target}Panel`
                );


              if (panel) {
                panel.classList.add(
                  'active'
                );
              }

            }
          );

        });


      document
        .querySelectorAll('.response-tab')
        .forEach(tab => {

          tab.addEventListener(
            'click',
            () => {

              const target =
                tab.dataset.responseTab;


              document
                .querySelectorAll(
                  '.response-tab'
                )
                .forEach(item => {
                  item.classList.remove(
                    'active'
                  );
                });


              document
                .querySelectorAll(
                  '.response-panel'
                )
                .forEach(panel => {
                  panel.classList.remove(
                    'active'
                  );
                });


              tab.classList.add(
                'active'
              );


              const panel =
                document.getElementById(
                  `${target}Panel`
                );


              if (panel) {
                panel.classList.add(
                  'active'
                );
              }

            }
          );

        });


      /* ============================================
       * CREATE REQUEST ROW
       * ============================================ */

      function createRow(type, key = '', value = '') {

        const row =
          document.createElement('div');

        row.className =
          'request-row';

        row.innerHTML = `
          <input
            class="row-key"
            type="text"
            placeholder="${type === 'param' ? 'Parameter' : 'Header'}"
            value="${escapeAttribute(key)}"
            dir="ltr"
            autocomplete="off"
          />

          <span class="equals-sign">=</span>

          <input
            class="row-value"
            type="text"
            placeholder="Value"
            value="${escapeAttribute(value)}"
            dir="ltr"
            autocomplete="off"
          />

          <button
            class="remove-row"
            type="button"
            title="حذف"
            aria-label="حذف"
          >
            <i class="fa-solid fa-xmark"></i>
          </button>
        `;


        const removeBtn =
          row.querySelector(
            '.remove-row'
          );


        removeBtn.addEventListener(
          'click',
          () => {

            row.remove();

            updateCounts();

            updateGeneratedRequest();

          }
        );


        row
          .querySelectorAll('input')
          .forEach(input => {

            input.addEventListener(
              'input',
              () => {

                updateCounts();

                updateGeneratedRequest();

              }
            );

          });


        return row;

      }


      function escapeAttribute(value) {

        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('"', '&quot;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;');

      }


      /* ============================================
       * ADD ROWS
       * ============================================ */

      addParamBtn.addEventListener(
        'click',
        () => {

          paramsContainer.appendChild(
            createRow('param')
          );

          updateCounts();

          updateGeneratedRequest();

        }
      );


      addHeaderBtn.addEventListener(
        'click',
        () => {

          headersContainer.appendChild(
            createRow('header')
          );

          updateCounts();

          updateGeneratedRequest();

        }
      );


      /* ============================================
       * READ ROWS
       * ============================================ */

      function readRows(container) {

        const result = [];

        container
          .querySelectorAll('.request-row')
          .forEach(row => {

            const key =
              row
                .querySelector('.row-key')
                .value
                .trim();

            const value =
              row
                .querySelector('.row-value')
                .value
                .trim();


            if (key) {

              result.push({
                key,
                value
              });

            }

          });


        return result;

      }


      /* ============================================
       * COUNTS
       * ============================================ */

      function updateCounts() {

        const params =
          readRows(paramsContainer);

        const headers =
          readRows(headersContainer);


        paramsCount.textContent =
          params.length;

        headersCount.textContent =
          headers.length;


        paramsEmpty.style.display =
          params.length
            ? 'none'
            : 'flex';


        headersEmpty.style.display =
          headers.length
            ? 'none'
            : 'flex';

      }


      /* ============================================
       * BUILD URL
       * ============================================ */

      function buildUrl() {

        const rawUrl =
          urlInput.value.trim();


        if (!rawUrl) {
          return '';
        }


        let url;


        try {

          url =
            new URL(rawUrl);

        } catch {

          return rawUrl;

        }


        const params =
          readRows(paramsContainer);


        params.forEach(item => {

          url.searchParams.set(
            item.key,
            item.value
          );

        });


        return url.toString();

      }


      /* ============================================
       * JSON VALIDATION
       * ============================================ */

      function validateJson() {

        const text =
          bodyInput.value.trim();


        if (!text) {

          jsonStatus.className =
            'json-status neutral';

          jsonStatus.innerHTML =
            `
              <i class="fa-solid fa-circle-info"></i>
              Body فارغ
            `;

          return true;

        }


        try {

          JSON.parse(text);


          jsonStatus.className =
            'json-status valid';

          jsonStatus.innerHTML =
            `
              <i class="fa-solid fa-circle-check"></i>
              JSON صالح
            `;

          return true;

        } catch {

          jsonStatus.className =
            'json-status invalid';

          jsonStatus.innerHTML =
            `
              <i class="fa-solid fa-circle-xmark"></i>
              JSON غير صالح
            `;

          return false;

        }

      }


      bodyInput.addEventListener(
        'input',
        () => {

          validateJson();

          updateGeneratedRequest();

        }
      );


      /* ============================================
       * FORMAT JSON
       * ============================================ */

      formatBodyBtn.addEventListener(
        'click',
        () => {

          const text =
            bodyInput.value.trim();


          if (!text) {

            showToast(
              'لا يوجد JSON لتنسيقه'
            );

            return;

          }


          try {

            const parsed =
              JSON.parse(text);


            bodyInput.value =
              JSON.stringify(
                parsed,
                null,
                2
              );


            validateJson();

            updateGeneratedRequest();

            showToast(
              'تم تنسيق JSON'
            );

          } catch {

            validateJson();

            showToast(
              'JSON غير صالح'
            );

          }

        }
      );


      clearBodyBtn.addEventListener(
        'click',
        () => {

          bodyInput.value = '';

          validateJson();

          updateGeneratedRequest();

        }
      );


      /* ============================================
       * CURL
       * ============================================ */

      function shellQuote(value) {

        return `'${String(value)
          .replaceAll("'", "'\\''")}'`;

      }


      function buildCurl() {

        const method =
          methodSelect.value;

        const url =
          buildUrl();


        if (!url) {
          return 'curl';
        }


        const headers =
          readRows(headersContainer);


        const lines = [
          `curl -X ${method} ${shellQuote(url)}`
        ];


        headers.forEach(header => {

          lines.push(
            `  -H ${shellQuote(
              `${header.key}: ${header.value}`
            )}`
          );

        });


        const body =
          bodyInput.value.trim();


        if (
          body &&
          !['GET', 'HEAD'].includes(method)
        ) {

          lines.push(
            `  -d ${shellQuote(body)}`
          );

        }


        return lines.join(' \\\n');

      }


      function updateCurl() {

        curlOutput.textContent =
          buildCurl();

      }


      /* ============================================
       * GENERATED REQUEST
       * ============================================ */

      function updateGeneratedRequest() {

        updateCurl();

      }


      /* ============================================
       * METHOD
       * ============================================ */

      methodSelect.addEventListener(
        'change',
        () => {

          updateGeneratedRequest();

        }
      );


      urlInput.addEventListener(
        'input',
        () => {

          updateGeneratedRequest();

        }
      );


      /* ============================================
       * SEND REQUEST
       * ============================================ */

      sendBtn.addEventListener(
        'click',
        sendRequest
      );


      async function sendRequest() {

        const currentId =
          ++requestId;


        const url =
          buildUrl();


        if (!url) {

          showToast(
            'أدخل عنوان API أولًا'
          );

          urlInput.focus();

          return;

        }


        const method =
          methodSelect.value;


        const headers =
          readRows(headersContainer);


        const body =
          bodyInput.value.trim();


        if (
          body &&
          !['GET', 'HEAD'].includes(method)
        ) {

          if (!validateJson()) {

            showToast(
              'صحح JSON قبل الإرسال'
            );

            return;

          }

        }


        sendBtn.disabled = true;

        sendBtn.classList.add(
          'loading'
        );

        sendBtn.innerHTML =
          `
            <i class="fa-solid fa-spinner fa-spin"></i>
            <span>جاري الإرسال...</span>
          `;


        statusBadge.className =
          'status-badge loading-status';

        statusBadge.textContent =
          'جاري الإرسال';


        responseTime.textContent =
          '…';


        responseOutput.textContent =
          'جاري انتظار الاستجابة...';


        responseType.textContent =
          'جاري التحميل';


        responseHeadersOutput.textContent =
          'جاري استلام Headers...';


        const options = {
          method,
          headers: {}
        };


        headers.forEach(header => {

          options.headers[
            header.key
          ] = header.value;

        });


        if (
          body &&
          !['GET', 'HEAD'].includes(method)
        ) {

          options.body = body;


          const hasContentType =
            headers.some(
              header =>
                header.key.toLowerCase() ===
                'content-type'
            );


          if (!hasContentType) {

            options.headers[
              'Content-Type'
            ] = 'application/json';

          }

        }


        const start =
          performance.now();


        try {

          const response =
            await fetch(
              url,
              options
            );


          if (currentId !== requestId) {
            return;
          }


          const elapsed =
            Math.round(
              performance.now() - start
            );


          responseTime.textContent =
            `${elapsed} ms`;


          updateStatus(
            response.status
          );


          const contentType =
            response.headers.get(
              'content-type'
            ) || '';


          const text =
            await response.text();


          lastResponseText =
            text;


          lastResponseHeaders =
            formatResponseHeaders(
              response.headers
            );


          responseHeadersOutput.textContent =
            lastResponseHeaders ||
            'لا توجد Headers.';


          if (
            contentType.includes(
              'application/json'
            )
          ) {

            try {

              const parsed =
                JSON.parse(text);


              responseOutput.textContent =
                JSON.stringify(
                  parsed,
                  null,
                  2
                );


              responseType.textContent =
                'JSON';

            } catch {

              responseOutput.textContent =
                text ||
                '(استجابة فارغة)';

              responseType.textContent =
                'Text';

            }

          } else {

            responseOutput.textContent =
              text ||
              '(استجابة فارغة)';

            responseType.textContent =
              getResponseType(
                contentType
              );

          }


        } catch (error) {

          if (currentId !== requestId) {
            return;
          }


          const elapsed =
            Math.round(
              performance.now() - start
            );


          responseTime.textContent =
            `${elapsed} ms`;


          statusBadge.className =
            'status-badge error';


          statusBadge.textContent =
            'Request Error';


          const message =
            error instanceof Error
              ? error.message
              : String(error);


          lastResponseText =
            `تعذر إرسال الطلب.\n\n${message}\n\nقد يكون السبب CORS أو مشكلة في الشبكة أو عنوان API غير صحيح.`;


          responseOutput.textContent =
            lastResponseText;


          responseType.textContent =
            'Error';


          responseHeadersOutput.textContent =
            'لم يتم استلام Headers.';


          showToast(
            'تعذر إرسال الطلب'
          );

        } finally {

          if (currentId === requestId) {

            sendBtn.disabled = false;

            sendBtn.classList.remove(
              'loading'
            );

            sendBtn.innerHTML =
              `
                <i class="fa-solid fa-paper-plane"></i>
                <span>إرسال</span>
              `;

          }

        }

      }


      /* ============================================
       * STATUS
       * ============================================ */

      function updateStatus(status) {

        let type =
          'success';


        if (
          status >= 400 &&
          status < 500
        ) {

          type = 'client';

        } else if (
          status >= 500
        ) {

          type = 'server';

        }


        statusBadge.className =
          `status-badge ${type}`;


        statusBadge.textContent =
          `${status} ${getStatusText(status)}`;

      }


      function getStatusText(status) {

        const map = {

          200: 'OK',
          201: 'Created',
          202: 'Accepted',
          204: 'No Content',

          301: 'Moved Permanently',
          302: 'Found',
          304: 'Not Modified',

          400: 'Bad Request',
          401: 'Unauthorized',
          403: 'Forbidden',
          404: 'Not Found',
          405: 'Method Not Allowed',
          409: 'Conflict',
          422: 'Unprocessable Entity',
          429: 'Too Many Requests',

          500: 'Internal Server Error',
          502: 'Bad Gateway',
          503: 'Service Unavailable',
          504: 'Gateway Timeout'

        };


        return map[status] || '';

      }


      function getResponseType(contentType) {

        if (
          contentType.includes('html')
        ) {
          return 'HTML';
        }


        if (
          contentType.includes('xml')
        ) {
          return 'XML';
        }


        if (
          contentType.includes('text')
        ) {
          return 'Text';
        }


        if (
          contentType
        ) {
          return contentType
            .split(';')[0];
        }


        return 'Unknown';

      }


      /* ============================================
       * RESPONSE HEADERS
       * ============================================ */

      function formatResponseHeaders(headers) {

        const entries = [];


        headers.forEach(
          (value, key) => {

            entries.push(
              `${key}: ${value}`
            );

          }
        );


        return entries.join('\n');

      }


      /* ============================================
       * COPY CURL
       * ============================================ */

      copyCurlBtn.addEventListener(
        'click',
        async () => {

          const success =
            await copyText(
              curlOutput.textContent
            );


          if (success) {

            showToast(
              'تم نسخ cURL'
            );

          }

        }
      );


      /* ============================================
       * COPY RESPONSE
       * ============================================ */

      copyResponseBtn.addEventListener(
        'click',
        async () => {

          if (!lastResponseText) {

            showToast(
              'لا توجد استجابة لنسخها'
            );

            return;

          }


          const success =
            await copyText(
              lastResponseText
            );


          if (success) {

            showToast(
              'تم نسخ الاستجابة'
            );

          }

        }
      );


      /* ============================================
       * CLEAR
       * ============================================ */

      clearBtn.addEventListener(
        'click',
        () => {

          requestId++;


          methodSelect.value =
            'GET';


          urlInput.value =
            'https://jsonplaceholder.typicode.com/posts/1';


          paramsContainer.innerHTML =
            '';

          headersContainer.innerHTML =
            '';


          bodyInput.value =
`{
  "title": "Hello World",
  "body": "This is a test request",
  "userId": 1
}`;


          validateJson();

          updateCounts();

          updateGeneratedRequest();


          statusBadge.className =
            'status-badge neutral';

          statusBadge.textContent =
            'لم يتم الإرسال';


          responseTime.textContent =
            '—';


          responseType.textContent =
            'لا توجد استجابة';


          responseOutput.textContent =
            'لم يتم إرسال أي طلب بعد.';


          responseHeadersOutput.textContent =
            'لم يتم استلام أي Headers بعد.';


          lastResponseText =
            '';

          lastResponseHeaders =
            '';


          showToast(
            'تم مسح الطلب'
          );

        }
      );


      /* ============================================
       * INITIAL DATA
       * ============================================ */

      headersContainer.appendChild(
        createRow(
          'header',
          'Accept',
          'application/json'
        )
      );


      updateCounts();

      validateJson();

      updateGeneratedRequest();

    });
  </script>


