      display: flex;

      align-items: center;
      justify-content: center;

      gap: 9px;

      border:
        1px dashed var(--api-border);

      border-radius: 12px;

      color:
        var(--api-muted);

      background:
        var(--api-bg);

      font-size: 11px;
    }


    .empty-row i {

      color:
        var(--api-primary);
    }


    /* ============================================
     * BODY
     * ============================================ */

    .body-tools {

      display: flex;

      gap: 7px;
    }


    .editor-wrapper {

      position: relative;
    }


    .body-editor {

      width: 100%;

      min-height: 270px;

      display: block;

      resize: vertical;

      padding: 17px;

      outline: none;

      border:
        1px solid var(--api-border);

      border-radius: 13px;

      background:
        #06101c;

      color:
        #dbeafe;

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 12px;

      line-height: 1.75;

      direction: ltr;

      text-align: left;

      tab-size: 2;
    }


    :global(html[data-theme='light'])
    .body-editor {

      background:
        #f5faff;

      color:
        #0f172a;
    }


    .json-status {

      position: absolute;

      left: 11px;

      bottom: 10px;

      display: inline-flex;

      align-items: center;

      gap: 6px;

      padding: 5px 8px;

      border-radius: 7px;

      color:
        var(--api-muted);

      background:
        var(--api-surface);

      font-size: 9px;
    }


    .json-status.valid {

      color:
        var(--api-green);
    }


    .json-status.invalid {

      color:
        var(--api-red);
    }


    /* ============================================
     * CURL
     * ============================================ */

    .code-box {

      min-height: 180px;

      padding: 18px;

      overflow-x: auto;

      border:
        1px solid var(--api-border);

      border-radius: 13px;

      background:
        #06101c;

      direction: ltr;

      text-align: left;
    }


    :global(html[data-theme='light'])
    .code-box {

      background:
        #f5faff;
    }


    .code-box code {

      color:
        var(--api-primary);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;

      line-height: 1.8;

      white-space: pre-wrap;

      overflow-wrap: anywhere;
    }


    /* ============================================
     * RESPONSE
     * ============================================ */

    .response-meta {

      display: flex;

      align-items: center;

      gap: 10px;
    }


    .status-badge {

      display: inline-flex;

      align-items: center;

      min-height: 28px;

      padding: 4px 9px;

      border-radius: 8px;

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 9px;

      font-weight: 700;
    }


    .status-badge.neutral {

      color:
        var(--api-muted);

      background:
        var(--api-bg);
    }


    .status-badge.loading-status {

      color:
        var(--api-primary);

      background:
        var(--api-primary-soft);
    }


    .status-badge.success {

      color:
        var(--api-green);

      background:
        var(--api-green-soft);
    }


    .status-badge.client,
    .status-badge.server,
    .status-badge.error {

      color:
        var(--api-red);

      background:
        var(--api-red-soft);
    }


    .response-time {

      color:
        var(--api-muted);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 9px;
    }


    .response-panel {

      display: none;

      padding: 20px;
    }


    .response-panel.active {
      display: block;
    }


    .response-toolbar {

      display: flex;

      align-items: center;

      justify-content: space-between;

      margin-bottom: 10px;

      color:
        var(--api-muted);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 9px;
    }


    .response-output {

      min-height: 270px;

      max-height: 600px;

      overflow: auto;

      margin: 0;

      padding: 17px;

      border:
        1px solid var(--api-border);

      border-radius: 13px;

      background:
        #06101c;

      color:
        #dbeafe;

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;

      line-height: 1.8;

      direction: ltr;

      text-align: left;

      white-space: pre-wrap;

      overflow-wrap: anywhere;
    }


    :global(html[data-theme='light'])
    .response-output {

      background:
        #f5faff;

      color:
        #0f172a;
    }


    .response-headers-output {

      min-height: 270px;

      max-height: 600px;

      overflow: auto;

      padding: 17px;

      border:
        1px solid var(--api-border);

      border-radius: 13px;

      background:
        #06101c;

      color:
        var(--api-soft);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;

      line-height: 1.9;

      direction: ltr;

      text-align: left;

      white-space: pre-wrap;

      overflow-wrap: anywhere;
    }


    :global(html[data-theme='light'])
    .response-headers-output {

      background:
        #f5faff;

      color:
        #334155;
    }


    /* ============================================
     * INFO CARDS
     * ============================================ */

    .info-grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 14px;

      margin-bottom: 42px;
    }


    .info-card {

      display: flex;

      align-items: flex-start;

      gap: 12px;

      padding: 19px;

      border:
        1px solid var(--api-border);

      border-radius: 16px;

      background:
        var(--api-surface);
    }


    .info-card-icon {

      width: 42px;
      height: 42px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 11px;

      font-size: 17px;
    }


    .info-card-icon.blue {

      color:
        var(--api-primary);

      background:
        var(--api-primary-soft);
    }


    .info-card-icon.green {

      color:
        var(--api-green);

      background:
        var(--api-green-soft);
    }


    .info-card-icon.orange {

      color:
        var(--api-orange);

      background:
        var(--api-orange-soft);
    }


    .info-card h3 {

      margin: 0 0 4px;

      font-size: 13px;
    }


    .info-card p {

      margin: 0;

      color:
        var(--api-muted);

      font-size: 10px;

      line-height: 1.8;
    }


    /* ============================================
     * FAQ
     * ============================================ */

    .faq-section {

      margin-bottom: 30px;
    }


    .section-heading {

      display: flex;

      align-items: center;

      gap: 12px;

      margin-bottom: 17px;
    }


    .heading-icon {

      width: 44px;
      height: 44px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color:
        var(--api-primary);

      background:
        var(--api-primary-soft);

      border:
        1px solid var(--api-border-strong);
    }


    .section-heading h2 {

      margin: 0;

      font-size: 18px;

      font-weight: 800;
    }


    .section-heading p {

      margin: 2px 0 0;

      color:
        var(--api-muted);

      font-size: 10px;
    }


    .faq-list {

      display: grid;

      gap: 9px;
    }


    .faq-list details {

      overflow: hidden;

      border:
        1px solid var(--api-border);

      border-radius: 13px;

      background:
        var(--api-surface);
    }


    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 16px;

      cursor: pointer;

      list-style: none;

      font-size: 12px;

      font-weight: 700;
    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color:
        var(--api-primary);

      transition:
        transform 0.2s ease;
    }


    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);
    }


    .faq-list details p {

      margin: 0;

      padding:
        0 16px 16px;

      color:
        var(--api-muted);

      font-size: 11px;

      line-height: 1.9;
    }


    /* ============================================
     * TOAST
     * ============================================ */

    .toast {

      position: fixed;

      z-index: 99999;

      left: 50%;

      bottom: 24px;

      display: flex;

      align-items: center;

      gap: 8px;

      padding: 11px 16px;

      border:
        1px solid var(--api-border-strong);

      border-radius: 11px;

      background:
        var(--api-surface);

      color:
        var(--api-text);

      box-shadow:
        var(--api-shadow);

      font-size: 11px;

      opacity: 0;

      pointer-events: none;

      transform:
        translate(-50%, 25px);

      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }


    .toast i {

      color:
        var(--api-green);
    }


    .toast.show {

      opacity: 1;

      transform:
        translate(-50%, 0);
    }


    /* ============================================
     * RESPONSIVE
     * ============================================ */

    @media (max-width: 900px) {

      .url-row {

        grid-template-columns:
          110px minmax(0, 1fr) 105px;
      }


      .info-grid {

        grid-template-columns:
          1fr;
      }

    }


    @media (max-width: 700px) {

      .api-page {

        width:
          min(
            calc(100% - 20px),
            620px
          );

        padding:
          30px 0 60px;
      }


      .hero {

        align-items: flex-start;

        padding: 21px;
      }


      .hero-icon {

        width: 54px;
        height: 54px;

        border-radius: 15px;

        font-size: 22px;
      }


      .hero h1 {

        font-size: 28px;
      }


      .hero p {

        font-size: 11px;
      }


      .url-row {

        grid-template-columns:
          1fr 1fr;

        padding: 14px;
      }


      .method-select {

        grid-column: span 1;
      }


      .url-input {

        grid-column: span 1;
      }


      .send-btn {

        grid-column: 1 / -1;
      }


      .request-tabs,
      .response-tabs {

        overflow-x: auto;

        scrollbar-width: none;
      }


      .request-tab,
      .response-tab {

        white-space: nowrap;

        padding:
          10px 11px;
      }


      .tab-panel,
      .response-panel {

        padding: 15px;
      }


      .request-row {

        grid-template-columns:
          minmax(0, 1fr) 25px minmax(0, 1fr) 38px;
      }


      .row-key,
      .row-value {

        font-size: 10px;
      }


      .response-header {

        align-items: flex-start;

        flex-direction: column;
      }


      .response-meta {

        width: 100%;

        justify-content: flex-start;
      }

    }


    @media (max-width: 480px) {

      .builder-header,
      .response-header {

        padding: 16px;
      }


      .title-icon,
      .response-icon {

        width: 38px;
        height: 38px;
      }


      .builder-title h2,
      .response-title h2 {

        font-size: 15px;
      }


      .url-row {

        grid-template-columns:
          100px minmax(0, 1fr);

        gap: 8px;
      }


      .method-select {

        grid-column: span 1;
      }


      .url-input {

        grid-column: span 1;
      }


      .send-btn {

        grid-column: 1 / -1;
      }


      .request-row {

        grid-template-columns:
          minmax(0, 1fr) 20px 38px;

        gap: 6px;
      }


      .request-row .row-key {

        grid-column: 1;
      }


      .request-row .equals-sign {

        display: none;
      }


      .request-row .row-value {

        grid-column: 2 / 4;
      }


      .request-row .remove-row {

        grid-column: 3;
        grid-row: 1;
      }


      .panel-heading {

        align-items: flex-start;

        flex-direction: column;
      }


      .body-tools {

        width: 100%;
      }


      .body-tools .small-btn {

        flex: 1;
      }


      .command-card {

        padding: 14px;
      }


      .response-meta {

        flex-wrap: wrap;
      }


      .info-card {

        padding: 15px;
      }

    }

  </style>

</body>
</html>
