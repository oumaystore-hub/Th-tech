---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "API Request Builder - منشئ طلبات API أونلاين | Th.Tech";

const description =
  "أداة API Request Builder مجانية لإنشاء واختبار طلبات API مباشرة من المتصفح مع دعم GET وPOST وPUT وPATCH وDELETE وHeaders وParameters وJSON.";

const canonical =
  "https://oumaystore-hub.github.io" +
  base +
  "/tools/api-request-builder/";
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="tool-page">

      <!-- Breadcrumb -->
      <div class="container">
        <nav class="breadcrumb" aria-label="مسار الصفحة">
          <a href={base + "/"}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={base + "/tools/"}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>API Request Builder</span>
        </nav>
      </div>

      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-card">

            <div class="hero-icon">
              <i class="fa-solid fa-plug"></i>
            </div>

            <div class="hero-content">

              <div class="eyebrow">
                <span class="dot"></span>
                Developer Tools
              </div>

              <h1>API Request Builder</h1>

              <p>
                أنشئ واختبر طلبات API مباشرة من المتصفح بسهولة وسرعة.
              </p>

              <div class="tags">
                <span>REST API</span>
                <span>HTTP</span>
                <span>JSON</span>
                <span>Local</span>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- Tool -->
      <section class="tool-section">
        <div class="container">

          <div class="tool-card">

            <!-- Header -->
            <div class="tool-header">

              <div class="header-title">

                <div class="header-icon">
                  <i class="fa-solid fa-code"></i>
                </div>

                <div>
                  <strong>منشئ طلب API</strong>
                  <span>أنشئ طلب HTTP واختبر الاستجابة</span>
                </div>

              </div>

              <div class="live-badge">
                <span></span>
                جاهز
              </div>

            </div>

            <!-- Request Builder -->
            <div class="request-area">

              <div class="url-row">

                <select id="method" aria-label="HTTP Method">
                  <option value="GET">GET</option>
                  <option value="POST">POST</option>
                  <option value="PUT">PUT</option>
                  <option value="PATCH">PATCH</option>
                  <option value="DELETE">DELETE</option>
                  <option value="HEAD">HEAD</option>
                  <option value="OPTIONS">OPTIONS</option>
                </select>

                <input
                  id="url"
                  type="url"
                  dir="ltr"
                  autocomplete="off"
                  spellcheck="false"
                  value="https://jsonplaceholder.typicode.com/posts/1"
                  placeholder="https://api.example.com/endpoint"
                />

                <button class="send-btn" id="sendBtn" type="button">
                  <i class="fa-solid fa-paper-plane"></i>
                  إرسال
                </button>

              </div>

              <!-- Tabs -->
              <div class="tabs">

                <button class="tab active" data-tab="params" type="button">
                  <i class="fa-solid fa-sliders"></i>
                  Parameters
                </button>

                <button class="tab" data-tab="headers" type="button">
                  <i class="fa-solid fa-heading"></i>
                  Headers
                </button>

                <button class="tab" data-tab="body" type="button">
                  <i class="fa-solid fa-file-code"></i>
                  Body
                </button>

                <button class="tab" data-tab="curl" type="button">
                  <i class="fa-solid fa-terminal"></i>
                  cURL
                </button>

              </div>

              <!-- Parameters -->
              <div class="tab-panel active" id="paramsPanel">

                <div class="panel-top">

                  <div>
                    <strong>Query Parameters</strong>
                    <span>إضافة معاملات إلى رابط الطلب</span>
                  </div>

                  <button class="small-btn" id="addParam" type="button">
                    <i class="fa-solid fa-plus"></i>
                    إضافة
                  </button>

                </div>

                <div id="paramsList" class="rows-list"></div>

                <div class="empty-message" id="paramsEmpty">
                  <i class="fa-solid fa-sliders"></i>
                  لا توجد Parameters. اضغط إضافة لإنشاء واحد.
                </div>

              </div>

              <!-- Headers -->
              <div class="tab-panel" id="headersPanel">

                <div class="panel-top">

                  <div>
                    <strong>HTTP Headers</strong>
                    <span>إضافة Headers مخصصة للطلب</span>
                  </div>

                  <button class="small-btn" id="addHeader" type="button">
                    <i class="fa-solid fa-plus"></i>
                    إضافة
                  </button>

                </div>

                <div id="headersList" class="rows-list"></div>

                <div class="empty-message" id="headersEmpty">
                  <i class="fa-solid fa-heading"></i>
                  لا توجد Headers مخصصة.
                </div>

              </div>

              <!-- Body -->
              <div class="tab-panel" id="bodyPanel">

                <div class="panel-top">

                  <div>
                    <strong>Request Body</strong>
                    <span>أدخل بيانات JSON للطلب</span>
                  </div>

                  <div class="body-actions">

                    <button class="small-btn" id="formatBtn" type="button">
                      <i class="fa-solid fa-wand-magic-sparkles"></i>
                      تنسيق
                    </button>

                    <button class="small-btn danger-small" id="clearBody" type="button">
                      <i class="fa-solid fa-trash"></i>
                      مسح
                    </button>

                  </div>

                </div>

                <textarea
                  id="bodyInput"
                  class="code-input"
                  dir="ltr"
                  spellcheck="false"
                  placeholder='{
  "title": "Th.Tech",
  "body": "Hello API",
  "userId": 1
}'
                ></textarea>

                <div id="jsonStatus" class="json-status">
                  <i class="fa-solid fa-circle-info"></i>
                  Body اختياري ويستخدم عادة مع POST وPUT وPATCH.
                </div>

              </div>

              <!-- cURL -->
              <div class="tab-panel" id="curlPanel">

                <div class="panel-top">

                  <div>
                    <strong>cURL Command</strong>
                    <span>الأمر المكافئ لطلب API</span>
                  </div>

                  <button class="small-btn" id="copyCurl" type="button">
                    <i class="fa-regular fa-copy"></i>
                    نسخ
                  </button>

                </div>

                <textarea
                  id="curlOutput"
                  class="code-input curl-output"
                  dir="ltr"
                  readonly
                  spellcheck="false"
                ></textarea>

              </div>

            </div>

            <!-- Actions -->
            <div class="actions">

              <div class="main-actions">

                <button class="btn primary" id="sampleBtn" type="button">
                  <i class="fa-solid fa-flask"></i>
                  تجربة مثال
                </button>

                <button class="btn secondary" id="copyResponseBtn" type="button">
                  <i class="fa-regular fa-copy"></i>
                  نسخ الاستجابة
                </button>

              </div>

              <button class="btn utility danger" id="clearBtn" type="button">
                <i class="fa-solid fa-rotate-left"></i>
                إعادة ضبط
              </button>

            </div>

            <!-- Status -->
            <div class="status" id="status">
              <i class="fa-solid fa-circle-info"></i>
              أدخل رابط API ثم اضغط إرسال لبدء الطلب.
            </div>

            <!-- Response -->
            <div class="response-wrapper">

              <div class="response-header">

                <div class="response-title">

                  <div class="response-icon">
                    <i class="fa-solid fa-server"></i>
                  </div>

                  <div>
                    <strong>Response</strong>
                    <span>نتيجة طلب API</span>
                  </div>

                </div>

                <div class="response-meta">

                  <span id="statusBadge" class="status-badge neutral">
                    Waiting
                  </span>

                  <span id="responseTime">
                    0 ms
                  </span>

                </div>

              </div>

              <div class="response-tabs">

                <button
                  class="response-tab active"
                  data-response-tab="body"
                  type="button"
                >
                  Response Body
                </button>

                <button
                  class="response-tab"
                  data-response-tab="headers"
                  type="button"
                >
                  Headers
                </button>

              </div>

              <div class="response-panel active" id="responseBodyPanel">

                <pre id="responseOutput">لم يتم إرسال أي طلب بعد.</pre>

              </div>

              <div class="response-panel" id="responseHeadersPanel">

                <pre id="responseHeadersOutput">ستظهر Headers هنا بعد إرسال الطلب.</pre>

              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- Privacy -->
      <section class="container info-section">

        <div class="privacy-card">

          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>معالجة مباشرة من المتصفح</h3>

            <p>
              الأداة لا تحتاج إلى خادم خاص بها. يتم إنشاء الطلب وإرساله مباشرة
              من متصفحك إلى عنوان API الذي تحدده.
            </p>
          </div>

          <span class="local-badge">
            <i class="fa-solid fa-bolt"></i>
            بدون Backend
          </span>

        </div>

      </section>

      <!-- Information -->
      <section class="container info-section">

        <div class="section-heading">

          <span>دليل الأداة</span>

          <h2>ماذا يمكنك فعلُه باستخدام API Request Builder؟</h2>

          <p>
            مجموعة من الأدوات تساعدك على إنشاء واختبار طلبات HTTP بسهولة.
          </p>

        </div>

        <div class="info-grid">

          <article class="info-card">

            <div class="info-number">01</div>

            <div class="info-card-icon">
              <i class="fa-solid fa-paper-plane"></i>
            </div>

            <h3>إرسال طلبات HTTP</h3>

            <p>
              اختر GET أو POST أو PUT أو PATCH أو DELETE واختبر الـ API
              مباشرة من المتصفح.
            </p>

          </article>

          <article class="info-card">

            <div class="info-number">02</div>

            <div class="info-card-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>JSON و Headers</h3>

            <p>
              أضف Headers وQuery Parameters وأدخل Request Body بصيغة JSON
              مع إمكانية تنسيقه والتحقق منه.
            </p>

          </article>

          <article class="info-card">

            <div class="info-number">03</div>

            <div class="info-card-icon">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <h3>cURL والاستجابة</h3>

            <p>
              احصل على أمر cURL المكافئ وشاهد Response Body وResponse Headers
              ووقت الاستجابة.
            </p>

          </article>

        </div>

      </section>

      <!-- Steps -->
      <section class="container steps-section">

        <div class="section-heading">

          <span>طريقة الاستخدام</span>

          <h2>اختبر API في خطوات بسيطة</h2>

        </div>

        <div class="steps">

          <div class="step">

            <div class="step-number">1</div>

            <div>
              <h3>أدخل الرابط</h3>

              <p>
                اكتب عنوان API وحدد HTTP Method المناسب.
              </p>
            </div>

          </div>

          <div class="step">

            <div class="step-number">2</div>

            <div>
              <h3>أضف البيانات</h3>

              <p>
                أضف Parameters أو Headers أو JSON Body عند الحاجة.
              </p>
            </div>

          </div>

          <div class="step">

            <div class="step-number">3</div>

            <div>
              <h3>أرسل الطلب</h3>

              <p>
                اضغط إرسال وشاهد النتيجة والـ Headers ووقت الاستجابة.
              </p>
            </div>

          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="container faq-section">

        <div class="section-heading">

          <span>الأسئلة الشائعة</span>

          <h2>أسئلة حول API Request Builder</h2>

        </div>

        <div class="faq-grid">

          <details>

            <summary>
              <span>هل يمكن اختبار أي API؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              يمكن اختبار APIs التي تسمح بطلبات المتصفح. بعض الخوادم تمنع
              الطلبات القادمة من مواقع مختلفة باستخدام سياسة CORS.
            </p>

          </details>

          <details>

            <summary>
              <span>ما الفرق بين GET وPOST؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              يستخدم GET عادةً لجلب البيانات، بينما يستخدم POST غالباً لإرسال
              بيانات جديدة إلى الخادم.
            </p>

          </details>

          <details>

            <summary>
              <span>هل تدعم الأداة JSON؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              نعم. يمكنك إدخال JSON داخل Body وتنسيقه والتحقق من صحة بنيته
              قبل إرسال الطلب.
            </p>

          </details>

          <details>

            <summary>
              <span>هل يتم إرسال بياناتي إلى Th.Tech؟</span>
              <i class="fa-solid fa-plus"></i>
            </summary>

            <p>
              لا تقوم الأداة بإرسال الطلبات إلى خادم Th.Tech. الطلب يتم
              مباشرة من متصفحك إلى عنوان API الذي أدخلته. تجنب إدخال أسرار
              حساسة في خدمات لا تثق بها.
            </p>

          </details>

        </div>

      </section>

    



<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/http-status-codes/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Http Status Codes</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/sql-query-builder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Sql Query Builder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />

    <style>
      :root {
        --bg: #f5f8fc;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --text: #102033;
        --muted: #6b7b8f;
        --border: #e2eaf3;
        --primary: #2563eb;
        --primary-2: #06b6d4;
        --success: #10b981;
        --danger: #ef4444;
        --orange: #f59e0b;
        --purple: #8b5cf6;
        --pink: #ec4899;
        --shadow: 0 18px 55px rgba(15, 35, 65, 0.08);
        --shadow-sm: 0 8px 25px rgba(15, 35, 65, 0.06);
      }

      html.dark-mode {
        --bg: #07111f;
        --surface: #0d1a2b;
        --surface-2: #101f32;
        --text: #e8f0fa;
        --muted: #91a3b8;
        --border: #1d3148;
        --primary: #4f8cff;
        --primary-2: #22d3ee;
        --success: #34d399;
        --danger: #fb7185;
        --orange: #fbbf24;
        --purple: #a78bfa;
        --pink: #f472b6;
        --shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
        --shadow-sm: 0 8px 25px rgba(0, 0, 0, 0.2);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 10% 5%,
            rgba(37, 99, 235, 0.07),
            transparent 28%
          ),
          radial-gradient(
            circle at 90% 15%,
            rgba(6, 182, 212, 0.06),
            transparent 25%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .tool-page {
        min-height: 100vh;
        padding-bottom: 70px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 24px 0 10px;
        color: var(--muted);
        font-size: 13px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: 0.65;
      }

      .hero {
        padding: 18px 0 30px;
      }

      .hero-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 34px;
        border: 1px solid var(--border);
        border-radius: 28px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .hero-card::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        left: -100px;
        top: -150px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.08);
        pointer-events: none;
      }

      .hero-icon {
        position: relative;
        flex: 0 0 88px;
        width: 88px;
        height: 88px;
        display: grid;
        place-items: center;
        border-radius: 24px;
        color: #fff;
        font-size: 34px;
