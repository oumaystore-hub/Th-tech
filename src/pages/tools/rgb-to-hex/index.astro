            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <span>RGB to HEX</span>
          </div>

          <div class="hero-content">

