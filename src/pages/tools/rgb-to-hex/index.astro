---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "RGB to HEX Converter - تحويل RGB إلى HEX أونلاين | Th.Tech";

const description =
  "أداة RGB to HEX مجانية لتحويل ألوان RGB إلى HEX مباشرة من المتصفح، مع معاينة اللون ونسخ قيمة HEX وCSS بسهولة.";

const faqs = [
  {
    q: "ما هو RGB؟",
    a: "RGB هو نظام ألوان يعتمد على ثلاث قنوات: الأحمر Red والأخضر Green والأزرق Blue، وتتراوح قيمة كل قناة عادةً من 0 إلى 255."
  },
  {
    q: "ما هو HEX؟",
    a: "HEX هو نظام لتمثيل الألوان باستخدام قيم hexadecimal، ويكتب عادةً بستة أحرف أو أرقام مثل #3B82F6."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. تتم عملية تحويل RGB إلى HEX بالكامل داخل المتصفح باستخدام JavaScript، ولا يتم إرسال القيم إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام HEX مباشرة في CSS؟",
    a: "نعم. قيمة HEX الناتجة مثل #3B82F6 يمكن استخدامها مباشرة كقيمة للخاصية color أو background-color وغيرها من خصائص CSS."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="RGB to HEX, RGB HEX, تحويل RGB إلى HEX, HEX Converter, Color Converter, أدوات الألوان"
    />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/rgb-to-hex/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>
