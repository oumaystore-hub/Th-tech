                </div>

              </div>

              <div class="stat">

                <div class="stat-icon red-stat">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Red</span>
                  <strong id="statRed">
                    59
                  </strong>
                </div>

              </div>

              <div class="stat">

                <div class="stat-icon green-stat">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Green</span>
                  <strong id="statGreen">
                    130
                  </strong>
                </div>

              </div>

              <div class="stat">

                <div class="stat-icon blue-stat">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Blue</span>
                  <strong id="statBlue">
                    246
                  </strong>
                </div>

              </div>

            </div>

            <!-- SECURITY NOTE -->
            <div class="security-note">

              <div class="security-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>

