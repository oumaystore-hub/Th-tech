                </p>

              </details>
            ))}

          </div>

        </div>

      </section>
    </main>

    <Footer />

    <!-- JAVASCRIPT -->
    <script is:inline>
      (() => {
        const redInput =
          document.getElementById("redInput");

        const greenInput =
          document.getElementById("greenInput");

        const blueInput =
          document.getElementById("blueInput");

        const colorPicker =
          document.getElementById("colorPicker");

        const exampleBtn =
          document.getElementById("exampleBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const convertBtn =
          document.getElementById("convertBtn");

        const copyHexBtn =
          document.getElementById("copyHexBtn");

        const outputCopyBtn =
          document.getElementById("outputCopyBtn");

        const copyCssBtn =
          document.getElementById("copyCssBtn");

        const copyRawBtn =
          document.getElementById("copyRawBtn");

        const heroColor =
          document.getElementById("heroColor");

        const largeColor =
          document.getElementById("largeColor");

        const previewHex =
          document.getElementById("previewHex");

        const previewRgb =
          document.getElementById("previewRgb");

        const hexOutput =
          document.getElementById("hexOutput");

        const cssOutput =
          document.getElementById("cssOutput");

        const rawOutput =
          document.getElementById("rawOutput");

        const statHex =
          document.getElementById("statHex");

        const statRed =
          document.getElementById("statRed");

        const statGreen =
          document.getElementById("statGreen");

        const statBlue =
          document.getElementById("statBlue");

        const resultBox =
          document.getElementById("resultBox");

        const resultIcon =
          document.getElementById("resultIcon");

        const resultTitle =
          document.getElementById("resultTitle");

        const resultMessage =
          document.getElementById("resultMessage");

        if (
          !redInput ||
          !greenInput ||
          !blueInput
        ) {
          return;
        }

        function clamp(value) {
          const number =
            Number(value);

          if (
            !Number.isFinite(number)
          ) {
            return 0;
          }

          return Math.min(
            255,
            Math.max(
              0,
              Math.round(number)
            )
          );
        }

        function componentToHex(value) {
          return value
            .toString(16)
            .padStart(2, "0")
            .toUpperCase();
        }

        function rgbToHex(r, g, b) {
          return (
            "#" +
            componentToHex(r) +
            componentToHex(g) +
            componentToHex(b)
          );
        }

        function hexToRgb(hex) {
          const clean =
            String(hex || "")
              .replace("#", "")
              .trim();

          if (
            !/^[0-9a-fA-F]{6}$/.test(clean)
          ) {
            return null;
          }

          return {
            r: parseInt(
              clean.slice(0, 2),
              16
            ),

            g: parseInt(
              clean.slice(2, 4),
              16
            ),

            b: parseInt(
              clean.slice(4, 6),
              16
            )
          };
        }

        function setStatus(
          type,
          title,
          message
        ) {
          resultBox.classList.remove(
            "success",
            "error",
            "warning"
          );

          if (type) {
            resultBox.classList.add(
              type
            );
          }

          if (type === "error") {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-circle-xmark"></i>';
          } else if (
            type === "warning"
          ) {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-triangle-exclamation"></i>';
          } else {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>';
          }

          resultTitle.textContent =
            title;

          resultMessage.textContent =
            message;
        }

        function getValues() {
          return {
            r: clamp(redInput.value),
            g: clamp(greenInput.value),
            b: clamp(blueInput.value)
          };
        }

        function updateInputs(
          r,
          g,
          b
        ) {
          redInput.value = r;
          greenInput.value = g;
          blueInput.value = b;
        }

        function updatePreview(
          hex,
          r,
          g,
          b
        ) {
          const rgbString =
            `rgb(${r}, ${g}, ${b})`;

          heroColor.style.backgroundColor =
            hex;

          largeColor.style.backgroundColor =
            hex;

          previewHex.textContent =
            hex;

          previewRgb.textContent =
            rgbString;

          colorPicker.value =
            hex;
        }

        function convert() {
          const r =
            Number(redInput.value);

          const g =
            Number(greenInput.value);

          const b =
            Number(blueInput.value);

          if (
            !Number.isInteger(r) ||
            !Number.isInteger(g) ||
            !Number.isInteger(b) ||
            r < 0 ||
            r > 255 ||
            g < 0 ||
            g > 255 ||
            b < 0 ||
            b > 255
          ) {
            setStatus(
              "error",
              "قيم RGB غير صحيحة",
              "يجب أن تكون كل قيمة RGB رقماً صحيحاً بين 0 و255."
            );

            return;
          }

          const hex =
            rgbToHex(
              r,
              g,
              b
            );

          const rgbString =
            `rgb(${r}, ${g}, ${b})`;

          const rawString =
            `${r}, ${g}, ${b}`;

          hexOutput.textContent =
            hex;

          cssOutput.textContent =
            hex;

          rawOutput.textContent =
            rawString;

          statHex.textContent =
            hex;

          statRed.textContent =
            r;

          statGreen.textContent =
            g;

          statBlue.textContent =
            b;

          updatePreview(
            hex,
            r,
            g,
            b
          );

          setStatus(
            "success",
            "تم التحويل بنجاح",
            `${rgbString} = ${hex}`
          );
        }

        function setExample() {
          updateInputs(
            59,
            130,
            246
          );

          convert();
        }

        function clearAll() {
          updateInputs(
            0,
            0,
            0
          );

          const hex = "#000000";

          hexOutput.textContent =
            "—";

          cssOutput.textContent =
            "—";

          rawOutput.textContent =
            "0, 0, 0";

          statHex.textContent =
            "—";

          statRed.textContent =
            "0";

          statGreen.textContent =
            "0";

          statBlue.textContent =
            "0";

          heroColor.style.backgroundColor =
            hex;

          largeColor.style.backgroundColor =
            hex;

          colorPicker.value =
            hex;

          previewHex.textContent =
            hex;

          previewRgb.textContent =
            "rgb(0, 0, 0)";

          setStatus(
            "",
            "تم المسح",
            "أدخل قيم RGB جديدة ثم اضغط على تحويل إلى HEX."
          );

          redInput.focus();
        }

        async function copyText(
          text,
          button
        ) {
          if (
            !text ||
            text === "—"
          ) {
            return;
          }

          const original =
            button.innerHTML;

          try {
            await navigator.clipboard.writeText(
              text
            );

            button.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(() => {
              button.innerHTML =
                original;
            }, 1500);

          } catch {
            const textarea =
              document.createElement(
                "textarea"
              );

            textarea.value =
              text;

            textarea.style.position =
              "fixed";

            textarea.style.opacity =
              "0";

            document.body.appendChild(
              textarea
            );

            textarea.select();

            try {
              document.execCommand(
                "copy"
              );

              button.innerHTML =
                '<i class="fa-solid fa-check"></i> تم النسخ';

              setTimeout(() => {
                button.innerHTML =
                  original;
              }, 1500);

            } catch {
              button.innerHTML =
                '<i class="fa-solid fa-xmark"></i> فشل النسخ';

              setTimeout(() => {
                button.innerHTML =
                  original;
              }, 1500);
            }

            textarea.remove();
          }
        }

        function pickerToRgb() {
          const rgb =
            hexToRgb(
              colorPicker.value
            );

          if (!rgb) {
            return;
          }

          updateInputs(
            rgb.r,
            rgb.g,
            rgb.b
          );

          convert();
        }

        [
          redInput,
          greenInput,
          blueInput
        ].forEach(input => {
          input.addEventListener(
            "input",
            () => {
              if (
                Number(input.value) > 255
              ) {
                input.value = "255";
              }

              if (
                Number(input.value) < 0
              ) {
                input.value = "0";
              }
            }
          );

          input.addEventListener(
            "keydown",
            event => {
              if (
                event.key === "Enter"
              ) {
                event.preventDefault();
                convert();
              }
            }
          );
        });

        colorPicker.addEventListener(
          "input",
          pickerToRgb
        );

        convertBtn.addEventListener(
          "click",
          convert
        );

        exampleBtn.addEventListener(
          "click",
          setExample
        );

        clearBtn.addEventListener(
          "click",
          clearAll
        );

        copyHexBtn.addEventListener(
          "click",
          () => {
            copyText(
              hexOutput.textContent,
              copyHexBtn
            );
          }
        );

        outputCopyBtn.addEventListener(
          "click",
          () => {
            copyText(
              hexOutput.textContent,
              outputCopyBtn
            );
          }
        );

        copyCssBtn.addEventListener(
          "click",
          () => {
            copyText(
              cssOutput.textContent,
              copyCssBtn
            );
          }
        );

        copyRawBtn.addEventListener(
          "click",
          () => {
            copyText(
              rawOutput.textContent,
              copyRawBtn
            );
          }
        );

        function syncTheme() {
          try {
            const saved =
              localStorage.getItem(
                "theme"
              );

            if (
              saved === "dark"
            ) {
              document.documentElement.classList.add(
                "dark-mode"
              );
            } else {
              document.documentElement.classList.remove(
                "dark-mode"
              );
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener(
          "themeChange",
          syncTheme
        );

        document.addEventListener(
          "click",
          event => {
            const button =
              event.target.closest(
                "#theme-btn"
              );

            if (button) {
              setTimeout(
                syncTheme,
                0
              );
            }
          }
        );

        convert();
      })();
    </script>

