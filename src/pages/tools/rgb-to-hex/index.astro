        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 18px;
      }

      .step {
        display: flex;

        gap: 16px;

        padding:
          22px;

        border:
          1px solid
          var(--border);

        border-radius: 17px;

        background:
          var(--surface);
      }

      .step-number {
        width: 42px;
        height: 42px;

        flex: 0 0 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background:
          linear-gradient(
            135deg,
            #2563eb,
            #06b6d4
          );

        color: white;

        font-family:
          "JetBrains Mono",
          monospace;

        font-weight: 700;
      }

      .step h3 {
        margin:
          0 0
          5px;

        font-size: 0.95rem;
      }

      .step p {
        margin: 0;

        color:
          var(--muted);

        font-size: 0.76rem;

        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;

        margin: 0 auto;
      }

      details {
        overflow: hidden;

        margin-bottom: 10px;

        border:
          1px solid
          var(--border);

        border-radius: 13px;

        background:
          var(--surface);
      }

      summary {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding:
          18px 20px;

        cursor: pointer;

        list-style: none;

        font-size: 0.86rem;
        font-weight: 700;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color:
          var(--primary);

        transition:
          transform 0.2s ease;
      }

      details[open] summary i {
        transform:
          rotate(180deg);
      }

      details p {
        margin: 0;

        padding:
          0 20px
          20px;

        color:
          var(--muted);

        font-size: 0.78rem;

        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 850px) {
        .info-grid,
        .steps {
          grid-template-columns:
            1fr;
        }

        .stats-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .rgb-input-grid {
          grid-template-columns:
            1fr;
        }
      }

      @media (max-width: 680px) {
        .container {
          width:
            min(
              calc(100% - 22px),
              1120px
            );
        }

        .hero {
          padding:
            30px 0
            38px;
        }

        .breadcrumb {
          margin-bottom:
            27px;
        }

        .hero-content {
          align-items:
            flex-start;

          gap: 18px;
        }

        .hero-icon {
          width: 76px;
          height: 76px;

          flex: 0 0 76px;

          border-radius: 20px;

          font-size: 1.8rem;
        }

        .color-preview {
          width: 14px;
          height: 14px;

          left: 10px;
          bottom: 10px;

          border-width: 2px;
        }

        h1 {
          font-size: 1.7rem;
        }

        .hero-text p {
          font-size: 0.85rem;
        }

        .tags span {
          font-size: 0.65rem;
        }

        .card-topbar {
          padding:
            0 13px;
        }

        .window-dots {
          width: 65px;
        }

        .secure {
          width: 65px;

          font-size: 0.68rem;
        }

        .actionbar {
          flex-direction: column;

          align-items: stretch;

          padding: 14px;
        }

        .action-group {
          width: 100%;
        }

        .action-group .btn {
          flex: 1;
        }

        .rgb-input-section,
        .picker-section,
        .output-section,
        .raw-section {
          padding:
            20px 15px 0;
        }

        .result-box {
          margin:
            20px 15px 0;
        }

        .stats-grid {
          padding:
            20px 15px;
        }

        .security-note {
          margin:
            0 15px
            20px;
        }

        .picker-preview {
          flex-direction: column;
        }

        .large-color {
          width: 100%;

          min-height: 105px;
        }

        .picker-info {
          min-height: 85px;
        }
      }

      @media (max-width: 430px) {
        .hero-content {
          flex-direction: column;
        }

        .hero-icon {
          width: 70px;
          height: 70px;
        }

        .stats-grid {
          grid-template-columns:
            1fr;
        }

        .btn {
          padding:
            0 10px;

          font-size: 0.76rem;
        }

        .number-input {
          height: 52px;
        }

        .number-input input {
          font-size: 0.95rem;
        }
      }
    </style>
  </body>
</html>
