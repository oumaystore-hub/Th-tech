    <script is:inline>
      (() => {
        function getThemeState() {
          const html = document.documentElement;
          const body = document.body;

          const stored = localStorage.getItem("theme");

          if (stored === "light") return "light";
          if (stored === "dark") return "dark";

          if (
            html.dataset.theme === "light" ||
            body.dataset.theme === "light" ||
            html.classList.contains("light") ||
            body.classList.contains("light")
          ) {
            return "light";
          }

          if (
            html.dataset.theme === "dark" ||
            body.dataset.theme === "dark" ||
            html.classList.contains("dark") ||
            body.classList.contains("dark")
          ) {
            return "dark";
          }

          return "dark";
        }

        function syncAsciiTheme() {
          const page = document.getElementById("asciiPage");

          if (!page) return;

          const theme = getThemeState();
          const light = theme === "light";

          /*
           * مهم:
           * نستخدم toggle مع القيمة الثانية حتى لا ندخل
           * في حلقة لا نهائية مع MutationObserver.
           */
          page.classList.toggle("force-light", light);
          page.classList.toggle("force-dark", !light);

          document.body.classList.toggle("ascii-light-theme", light);
          document.body.classList.toggle("ascii-dark-theme", !light);
        }

        function watchTheme() {
          syncAsciiTheme();

          window.addEventListener("storage", (event) => {
            if (event.key === "theme") {
              syncAsciiTheme();
            }
          });

          const observer = new MutationObserver(() => {
            syncAsciiTheme();
          });

          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class", "data-theme"]
          });

          observer.observe(document.body, {
            attributes: true,
            attributeFilter: ["class", "data-theme"]
          });
        }

        function startAsciiTool() {
          const input = document.getElementById("inputText");
          const output = document.getElementById("output");

          const textMode = document.getElementById("textMode");
          const asciiMode = document.getElementById("asciiMode");

          const convertBtn = document.getElementById("convertBtn");
          const pasteBtn = document.getElementById("pasteBtn");
          const swapBtn = document.getElementById("swapBtn");
          const clearBtn = document.getElementById("clearBtn");
          const copyBtn = document.getElementById("copyBtn");

          const inputLabel = document.getElementById("inputLabel");
          const counter = document.getElementById("counter");
          const status = document.getElementById("status");

          const decimalOutput = document.getElementById("decimalOutput");
          const hexOutput = document.getElementById("hexOutput");
          const binaryOutput = document.getElementById("binaryOutput");

          if (
            !input ||
            !output ||
            !textMode ||
            !asciiMode ||
            !convertBtn
          ) {
            return;
          }

          let mode = "text";

          function setStatus(message, type = "") {
            status.textContent = message;
            status.className = "status";

            if (type) {
              status.classList.add(type);
            }
          }

          function updateCounter() {
            const length = input.value.length;

            if (mode === "text") {
              counter.textContent = `${length} حرف`;
            } else {
              const count = input.value
                .trim()
                .replace(/[,;]+/g, " ")
                .split(/\s+/)
                .filter(Boolean).length;

              counter.textContent = `${count} قيمة`;
            }
          }

          function updateMode() {
            const isText = mode === "text";

            textMode.classList.toggle("active", isText);
            asciiMode.classList.toggle("active", !isText);

            if (isText) {
              inputLabel.textContent = "النص";
              input.placeholder = "اكتب النص هنا...";
              input.classList.remove("ltr");
            } else {
              inputLabel.textContent = "رموز ASCII";
              input.placeholder = "مثال: 72 101 108 108 111";
              input.classList.add("ltr");
            }

            updateCounter();
            setStatus("");
          }

          function showResult(text, codes) {
            output.textContent = text || "";

            if (!text) {
              output.innerHTML =
                '<div class="output-empty">ستظهر النتيجة هنا بعد التحويل</div>';
            }

            const decimal = codes.join(" ");

            const hex = codes
              .map((code) => code.toString(16).toUpperCase().padStart(2, "0"))
              .join(" ");

            const binary = codes
              .map((code) => code.toString(2).padStart(8, "0"))
              .join(" ");

            decimalOutput.textContent = decimal || "—";
            hexOutput.textContent = hex || "—";
            binaryOutput.textContent = binary || "—";
          }

          function convertTextToAscii() {
            const value = input.value;

            if (!value) {
              showResult("", []);
              setStatus("اكتب نصًا أولًا.", "error");
              return;
            }

            const codes = [];

            for (let i = 0; i < value.length; i++) {
              const code = value.charCodeAt(i);

              if (code > 127) {
                showResult("", []);
                setStatus(
                  "ASCII الأساسي يدعم الأحرف والقيم من 0 إلى 127 فقط.",
                  "error"
                );
                return;
              }

              codes.push(code);
            }

            const result = codes.join(" ");

            showResult(result, codes);
            setStatus("تم تحويل النص بنجاح.", "success");
          }

          function parseAscii(value) {
            const clean = value
              .replace(/[,;]+/g, " ")
              .replace(/\s+/g, " ")
              .trim();

            if (!clean) {
              return [];
            }

            const parts = clean.split(" ");
            const codes = [];

            for (let i = 0; i < parts.length; i++) {
              const part = parts[i];

              if (!/^\d+$/.test(part)) {
                throw new Error(
                  `القيمة "${part}" ليست رقم ASCII صالحًا.`
                );
              }

              const number = Number(part);

              if (!Number.isInteger(number) || number < 0 || number > 127) {
                throw new Error(
                  `القيمة "${part}" يجب أن تكون بين 0 و127.`
                );
              }

              codes.push(number);
            }

            return codes;
          }

          function convertAsciiToText() {
            const value = input.value.trim();

            if (!value) {
              showResult("", []);
              setStatus("أدخل رموز ASCII أولًا.", "error");
              return;
            }

            try {
              const codes = parseAscii(value);

              let result = "";

              for (let i = 0; i < codes.length; i++) {
                result += String.fromCharCode(codes[i]);
              }

              showResult(result, codes);
              setStatus("تم تحويل ASCII بنجاح.", "success");
            } catch (error) {
              showResult("", []);
              setStatus(error.message, "error");
            }
          }

          function convert() {
            if (mode === "text") {
              convertTextToAscii();
            } else {
              convertAsciiToText();
            }
          }

          textMode.addEventListener("click", () => {
            if (mode === "text") return;

            mode = "text";
            input.value = "";
            showResult("", []);
            updateMode();
            input.focus();
          });

          asciiMode.addEventListener("click", () => {
            if (mode === "ascii") return;

            mode = "ascii";
            input.value = "";
            showResult("", []);
            updateMode();
            input.focus();
          });

          convertBtn.addEventListener("click", convert);

          input.addEventListener("input", updateCounter);

          input.addEventListener("keydown", (event) => {
            if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
              event.preventDefault();
              convert();
            }
          });

          clearBtn.addEventListener("click", () => {
            input.value = "";

            showResult("", []);
            setStatus("");
            updateCounter();

            input.focus();
          });

          swapBtn.addEventListener("click", () => {
            mode = mode === "text" ? "ascii" : "text";

            input.value = "";

            showResult("", []);
            updateMode();

            input.focus();
          });

          pasteBtn.addEventListener("click", async () => {
            try {
              const text = await navigator.clipboard.readText();

              input.value = text;
              updateCounter();

              setStatus("تم لصق النص.", "success");
              input.focus();
            } catch (error) {
              setStatus(
                "تعذر الوصول إلى الحافظة. استخدم اللصق من لوحة المفاتيح.",
                "error"
              );
            }
          });

          copyBtn.addEventListener("click", async () => {
            const text = output.textContent.trim();

            if (
              !text ||
              text === "ستظهر النتيجة هنا بعد التحويل"
            ) {
              setStatus("لا توجد نتيجة لنسخها.", "error");
              return;
            }

            try {
              await navigator.clipboard.writeText(text);

              setStatus("تم نسخ النتيجة.", "success");
            } catch (error) {
              setStatus(
                "تعذر النسخ تلقائيًا. حدد النتيجة وانسخها يدويًا.",
                "error"
              );
            }
          });

          updateMode();
          showResult("", []);
        }

        function init() {
          watchTheme();
          startAsciiTool();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init, {
            once: true
          });
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
