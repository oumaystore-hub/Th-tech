---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/ascii-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ASCII Converter | محول ASCII | Th.Tech</title>

    <meta
      name="description"
      content="محول ASCII احترافي لتحويل النص إلى رموز ASCII والعكس مع دعم Decimal وHex وBinary."
    />

    <link rel="canonical" href={canonical} />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Cairo", sans-serif;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      .ascii-page {
        --bg: #07111f;
        --card: #0d1b2d;
        --card-2: #101f33;
        --border: rgba(96, 165, 250, 0.18);
        --text: #f1f5f9;
        --muted: #94a3b8;
        --primary: #38bdf8;
        --primary-2: #2563eb;
        --input: #081522;
        --output: #071522;
        --shadow: 0 20px 50px rgba(0, 0, 0, 0.25);

        min-height: calc(100vh - 100px);
        padding: 45px 18px 70px;
        background: var(--bg);
        color: var(--text);
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      .ascii-page.force-light {
        --bg: #f5f9ff;
        --card: #ffffff;
        --card-2: #f8fbff;
        --border: rgba(37, 99, 235, 0.15);
        --text: #0f172a;
        --muted: #64748b;
        --primary: #0284c7;
        --primary-2: #2563eb;
        --input: #f8fafc;
        --output: #f1f7ff;
        --shadow: 0 15px 40px rgba(15, 23, 42, 0.08);
      }

      .ascii-page.force-dark {
        --bg: #07111f;
        --card: #0d1b2d;
        --card-2: #101f33;
        --border: rgba(96, 165, 250, 0.18);
        --text: #f1f5f9;
        --muted: #94a3b8;
        --primary: #38bdf8;
        --primary-2: #2563eb;
        --input: #081522;
        --output: #071522;
        --shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
      }

      :global(body.ascii-dark-theme) {
        background: #07111f !important;
        color: #f1f5f9;
      }

      :global(body.ascii-light-theme) {
        background: #f5f9ff !important;
        color: #0f172a;
      }

      .tool-container {
        max-width: 1180px;
        margin: 0 auto;
      }

      .tool-heading {
        text-align: center;
        margin-bottom: 32px;
      }

      .tool-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: white;
        font-size: 30px;
        box-shadow: 0 15px 35px rgba(37, 99, 235, 0.3);
      }

      .tool-heading h1 {
        margin: 0 0 10px;
        font-size: clamp(28px, 5vw, 42px);
        font-weight: 800;
        background: linear-gradient(90deg, #38bdf8, #60a5fa);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .tool-heading p {
        max-width: 700px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
      }

      .tool-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        align-items: start;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px;
        box-shadow: var(--shadow);
        transition:
          background 0.25s ease,
          border-color 0.25s ease;
      }

      .card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 18px;
        font-weight: 800;
      }

      .card-title i {
        color: var(--primary);
      }

      .mode-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 18px;
      }

      .mode-btn {
        border: 1px solid var(--border);
        background: var(--card-2);
        color: var(--muted);
        border-radius: 12px;
        padding: 12px 10px;
        cursor: pointer;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        transition: 0.2s ease;
      }

      .mode-btn:hover {
        border-color: var(--primary);
        color: var(--text);
      }

      .mode-btn.active {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border-color: transparent;
        color: white;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
      }

      .field-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 9px;
        color: var(--text);
        font-size: 14px;
        font-weight: 700;
      }

      .counter {
        color: var(--muted);
        font-size: 12px;
        font-weight: 500;
      }

      textarea {
        width: 100%;
        min-height: 265px;
        resize: vertical;
        border: 1px solid var(--border);
        border-radius: 14px;
        outline: none;
        padding: 16px;
        background: var(--input);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        font-size: 15px;
        line-height: 1.8;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.25s ease;
      }

      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
      }

      textarea.ltr {
        direction: ltr;
        text-align: left;
        font-family: "Courier New", monospace;
      }

      .action-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 9px;
        margin-top: 14px;
      }

      .btn {
        min-height: 44px;
        border: 0;
        border-radius: 11px;
        padding: 10px 12px;
        cursor: pointer;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 0.15s ease,
          opacity 0.2s ease,
          background 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn:active {
        transform: translateY(0);
      }

      .btn-primary {
        color: white;
        background: linear-gradient(135deg, #0284c7, #2563eb);
      }

      .btn-secondary {
        background: var(--card-2);
        border: 1px solid var(--border);
        color: var(--text);
      }

      .btn-danger {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #f87171;
      }

      .status {
        min-height: 24px;
        margin-top: 13px;
        font-size: 13px;
        font-weight: 700;
      }

      .status.success {
        color: #22c55e;
      }

      .status.error {
        color: #ef4444;
      }

      .output-box {
        width: 100%;
        min-height: 145px;
        max-height: 280px;
        overflow: auto;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: var(--output);
        color: var(--text);
        direction: ltr;
        text-align: left;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: "Courier New", monospace;
        font-size: 14px;
        line-height: 1.7;
      }

      .output-empty {
        color: var(--muted);
        font-family: "Cairo", sans-serif;
        text-align: center;
        direction: rtl;
        padding-top: 25px;
      }

      .formats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 18px;
      }

      .format-box {
        min-width: 0;
        padding: 13px;
        border-radius: 13px;
        background: var(--card-2);
        border: 1px solid var(--border);
      }

      .format-name {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 7px;
      }

      .format-value {
        direction: ltr;
        text-align: left;
        overflow: auto;
        white-space: nowrap;
        font-family: "Courier New", monospace;
        font-size: 12px;
        color: var(--text);
      }

      .info-card {
        margin-top: 22px;
      }

      .info-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .info-list li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      .info-list i {
        color: var(--primary);
        margin-top: 5px;
      }

      .keyboard {
        display: inline-flex;
        align-items: center;
        padding: 2px 7px;
        border-radius: 6px;
        background: var(--card-2);
        border: 1px solid var(--border);
        color: var(--text);
        direction: ltr;
        font-family: monospace;
        font-size: 11px;
      }

      @media (max-width: 850px) {
        .ascii-page {
          padding: 32px 14px 55px;
        }

        .tool-grid {
          grid-template-columns: 1fr;
        }

        .action-row {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 560px) {
        .ascii-page {
          padding: 26px 10px 45px;
        }

        .card {
          padding: 16px;
          border-radius: 16px;
        }

        .tool-icon {
          width: 62px;
          height: 62px;
          font-size: 25px;
          border-radius: 17px;
        }

        .tool-heading {
          margin-bottom: 24px;
        }

        .tool-heading h1 {
          font-size: 29px;
        }

        textarea {
          min-height: 220px;
          font-size: 14px;
        }

        .formats {
          grid-template-columns: 1fr;
        }

        .action-row {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 380px) {
        .mode-buttons {
          grid-template-columns: 1fr;
        }

        .action-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="ascii-page force-dark" id="asciiPage">
      <div class="tool-container">

        <section class="tool-heading">
          <div class="tool-icon">
            <i class="fa-solid fa-code"></i>
          </div>

          <h1>محول ASCII</h1>

          <p>
            حوّل النص إلى رموز ASCII والعكس بسهولة، مع عرض القيم العشرية
            والسداسية عشرية والثنائية.
          </p>
        </section>

        <section class="tool-grid">

          <!-- Input -->
          <div class="card">
            <div class="card-title">
              <i class="fa-solid fa-arrow-right-arrow-left"></i>
              <span>المحول</span>
            </div>

            <div class="mode-buttons">
              <button
                type="button"
                class="mode-btn active"
                id="textMode"
              >
                <i class="fa-solid fa-font"></i>
                النص → ASCII
              </button>

              <button
                type="button"
                class="mode-btn"
                id="asciiMode"
              >
                <i class="fa-solid fa-hashtag"></i>
                ASCII → النص
              </button>
            </div>

            <label class="field-label" for="inputText">
              <span id="inputLabel">النص</span>
              <span class="counter" id="counter">0 حرف</span>
            </label>

            <textarea
              id="inputText"
              placeholder="اكتب النص هنا..."
              autocomplete="off"
              spellcheck="false"
            ></textarea>

            <div class="action-row">
              <button type="button" class="btn btn-primary" id="convertBtn">
                <i class="fa-solid fa-bolt"></i>
                تحويل
              </button>

              <button type="button" class="btn btn-secondary" id="pasteBtn">
                <i class="fa-solid fa-paste"></i>
                لصق
              </button>

              <button type="button" class="btn btn-secondary" id="swapBtn">
                <i class="fa-solid fa-right-left"></i>
                تبديل
              </button>

              <button type="button" class="btn btn-danger" id="clearBtn">
                <i class="fa-solid fa-trash"></i>
                مسح
              </button>
            </div>

            <div class="status" id="status"></div>
          </div>

          <!-- Output -->
          <div class="card">
            <div class="card-title">
              <i class="fa-solid fa-terminal"></i>
              <span>النتيجة</span>
            </div>

            <div class="output-box" id="output">
              <div class="output-empty">
                ستظهر النتيجة هنا بعد التحويل
              </div>
            </div>

            <div class="action-row" style="margin-top: 14px;">
              <button type="button" class="btn btn-primary" id="copyBtn">
                <i class="fa-solid fa-copy"></i>
                نسخ النتيجة
              </button>
            </div>

            <div class="formats">
              <div class="format-box">
                <div class="format-name">DECIMAL</div>
                <div class="format-value" id="decimalOutput">—</div>
              </div>

              <div class="format-box">
                <div class="format-name">HEX</div>
                <div class="format-value" id="hexOutput">—</div>
              </div>

              <div class="format-box">
                <div class="format-name">BINARY</div>
                <div class="format-value" id="binaryOutput">—</div>
              </div>
            </div>
          </div>

        </section>

        <section class="card info-card">
          <div class="card-title">
            <i class="fa-solid fa-circle-info"></i>
            <span>معلومات عن ASCII</span>
          </div>

          <ul class="info-list">
            <li>
              <i class="fa-solid fa-check"></i>
              <span>
                معيار ASCII الأساسي يستخدم القيم من 0 إلى 127.
              </span>
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              <span>
                مثال: الحرف <strong>A</strong> يساوي
                <strong>65</strong> بالعشري و
                <strong>41</strong> بالـ Hex.
              </span>
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              <span>
                يمكنك في وضع ASCII إدخال الأرقام مفصولة بمسافات أو فواصل.
              </span>
            </li>

            <li>
              <i class="fa-solid fa-keyboard"></i>
              <span>
                للتحويل بسرعة استخدم
                <span class="keyboard">Ctrl + Enter</span>
                أو
                <span class="keyboard">⌘ + Enter</span>.
              </span>
            </li>
          </ul>
        </section>

      </div>
    

