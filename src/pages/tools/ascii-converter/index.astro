---

import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(//$/, '');
const canonical = "https://oumaystore-hub.github.io${base}/tools/ascii-converter/";

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>ASCII Converter | محول ASCII | Th.Tech</title>

<meta
  name="description"
  content="محول ASCII احترافي لتحويل النص إلى أكواد ASCII والعكس."
/>

<link rel="canonical" href={canonical} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

  </head>  <body>
    <Header /><main class="ascii-tool">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-icon">
      <i class="fa-solid fa-code"></i>
    </div>

    <div>
      <span class="eyebrow">
        <i class="fa-solid fa-bolt"></i>
        أداة مجانية
      </span>

      <h1>ASCII Converter</h1>

      <p>
        تحويل النصوص إلى ASCII والعكس بسرعة وسهولة
      </p>
    </div>
  </section>


  <!-- TOOL -->
  <section class="tool-card">

    <!-- MODE -->
    <div class="mode-tabs">
      <button
        type="button"
        class="mode active"
        id="textMode"
      >
        <i class="fa-solid fa-font"></i>
        نص → ASCII
      </button>

      <button
        type="button"
        class="mode"
        id="asciiMode"
      >
        <i class="fa-solid fa-terminal"></i>
        ASCII → نص
      </button>
    </div>


    <!-- INPUT -->
    <div class="panel">

      <div class="panel-header">
        <div>
          <h2 id="inputTitle">النص</h2>
          <p id="inputHelp">
            اكتب النص الذي تريد تحويله
          </p>
        </div>

        <span class="counter" id="counter">
          0 حرف
        </span>
      </div>

      <textarea
        id="input"
        placeholder="اكتب النص هنا..."
        spellcheck="false"
      ></textarea>

      <div class="buttons">
        <button type="button" class="small-btn" id="paste">
          <i class="fa-solid fa-paste"></i>
          لصق
        </button>

        <button type="button" class="small-btn danger" id="clear">
          <i class="fa-solid fa-trash"></i>
          مسح
        </button>
      </div>

    </div>


    <!-- CONVERT -->
    <div class="convert-row">

      <button
        type="button"
        class="convert"
        id="convert"
      >
        <i class="fa-solid fa-arrow-down"></i>
        <span id="convertLabel">تحويل إلى ASCII</span>
      </button>

      <button
        type="button"
        class="swap"
        id="swap"
        title="تبديل الاتجاه"
      >
        <i class="fa-solid fa-right-left"></i>
      </button>

    </div>


    <!-- OUTPUT -->
    <div class="panel">

      <div class="panel-header">

        <div>
          <h2 id="outputTitle">ASCII</h2>
          <p id="outputHelp">
            النتيجة ستظهر هنا
          </p>
        </div>

        <button
          type="button"
          class="copy"
          id="copy"
        >
          <i class="fa-regular fa-copy"></i>
          نسخ
        </button>

      </div>

      <textarea
        id="output"
        readonly
        placeholder="النتيجة..."
        spellcheck="false"
      ></textarea>

    </div>


    <!-- REPRESENTATIONS -->
    <div class="representations">

      <div class="representation">
        <div class="representation-icon">
          <i class="fa-solid fa-hashtag"></i>
        </div>

        <div>
          <span>Decimal</span>
          <strong id="decimal">—</strong>
        </div>
      </div>


      <div class="representation">
        <div class="representation-icon">
          <i class="fa-solid fa-xmark"></i>
        </div>

        <div>
          <span>Hexadecimal</span>
          <strong id="hex">—</strong>
        </div>
      </div>


      <div class="representation">
        <div class="representation-icon">
          <i class="fa-solid fa-1"></i>
        </div>

        <div>
          <span>Binary</span>
          <strong id="binary">—</strong>
        </div>
      </div>

    </div>


    <div id="message" class="message"></div>

  </section>


  <!-- INFORMATION -->
  <section class="information">

    <article>
      <div class="info-icon">
        <i class="fa-solid fa-circle-info"></i>
      </div>

      <div>
        <h3>ما هو ASCII؟</h3>
        <p>
          معيار لترميز الأحرف باستخدام قيم رقمية من 0 إلى 127،
          ويشمل الأحرف الإنجليزية والأرقام والرموز الأساسية.
        </p>
      </div>
    </article>


    <article>
      <div class="info-icon">
        <i class="fa-solid fa-lock"></i>
      </div>

      <div>
        <h3>خصوصية كاملة</h3>
        <p>
          تتم عملية التحويل داخل متصفحك مباشرة ولا يتم إرسال
          البيانات إلى أي خادم.
        </p>
      </div>
    </article>


    <article>
      <div class="info-icon">
        <i class="fa-solid fa-repeat"></i>
      </div>

      <div>
        <h3>تحويل ثنائي الاتجاه</h3>
        <p>
          يمكنك التحويل من النص إلى ASCII أو من ASCII إلى نص
          بضغطة واحدة.
        </p>
      </div>
    </article>

  </section>

</main>

<Footer />


<script>
  const input = document.getElementById('input');
  const output = document.getElementById('output');

  const convertButton = document.getElementById('convert');
  const swapButton = document.getElementById('swap');

  const clearButton = document.getElementById('clear');
  const pasteButton = document.getElementById('paste');
  const copyButton = document.getElementById('copy');

  const textModeButton = document.getElementById('textMode');
  const asciiModeButton = document.getElementById('asciiMode');

  const inputTitle = document.getElementById('inputTitle');
  const inputHelp = document.getElementById('inputHelp');

  const outputTitle = document.getElementById('outputTitle');
  const outputHelp = document.getElementById('outputHelp');

  const convertLabel = document.getElementById('convertLabel');
  const counter = document.getElementById('counter');

  const decimal = document.getElementById('decimal');
  const hex = document.getElementById('hex');
  const binary = document.getElementById('binary');

  const message = document.getElementById('message');

  let mode = 'text';


  function setMessage(text, type = '') {
    message.textContent = text;
    message.className = 'message';

    if (text) {
      message.classList.add('visible');

      if (type) {
        message.classList.add(type);
      }
    }
  }


  function clearResults() {
    output.value = '';

    decimal.textContent = '—';
    hex.textContent = '—';
    binary.textContent = '—';

    setMessage('');
  }


  function updateCounter() {
    const length = input.value.length;

    counter.textContent =
      `${length} ${length === 1 ? 'حرف' : 'أحرف'}`;
  }


  function textToAscii() {
    const text = input.value;

    if (!text) {
      clearResults();
      setMessage('اكتب نصًا أولًا.', 'error');
      return;
    }

    const codes = [];

    for (const character of text) {
      const code = character.charCodeAt(0);

      if (code > 127) {
        clearResults();

        setMessage(
          `الحرف "${character}" غير مدعوم في ASCII القياسي.`,
          'error'
        );

        return;
      }

      codes.push(code);
    }

    output.value = codes.join(' ');

    decimal.textContent = codes.join(' ');

    hex.textContent = codes
      .map(code =>
        code
          .toString(16)
          .toUpperCase()
          .padStart(2, '0')
      )
      .join(' ');

    binary.textContent = codes
      .map(code =>
        code
          .toString(2)
          .padStart(8, '0')
      )
      .join(' ');

    setMessage('تم التحويل بنجاح.', 'success');
  }


  function asciiToText() {
    const value = input.value.trim();

    if (!value) {
      clearResults();
      setMessage('أدخل أكواد ASCII أولًا.', 'error');
      return;
    }

    const parts = value
      .replace(/[,;]+/g, ' ')
      .split(/\s+/)
      .filter(Boolean);

    const codes = [];

    for (const part of parts) {

      if (!/^\d+$/.test(part)) {
        clearResults();

        setMessage(
          `"${part}" ليست قيمة ASCII صحيحة.`,
          'error'
        );

        return;
      }

      const code = Number(part);

      if (code < 0 || code > 127) {
        clearResults();

        setMessage(
          `القيمة ${code} خارج نطاق ASCII (0–127).`,
          'error'
        );

        return;
      }

      codes.push(code);
    }

    output.value = String.fromCharCode(...codes);

    decimal.textContent = codes.join(' ');

    hex.textContent = codes
      .map(code =>
        code
          .toString(16)
          .toUpperCase()
          .padStart(2, '0')
      )
      .join(' ');

    binary.textContent = codes
      .map(code =>
        code
          .toString(2)
          .padStart(8, '0')
      )
      .join(' ');

    setMessage('تم التحويل بنجاح.', 'success');
  }


  function convert() {
    if (mode === 'text') {
      textToAscii();
    } else {
      asciiToText();
    }
  }


  function setMode(newMode) {

    mode = newMode;

    textModeButton.classList.toggle(
      'active',
      mode === 'text'
    );

    asciiModeButton.classList.toggle(
      'active',
      mode === 'ascii'
    );


    if (mode === 'text') {

      inputTitle.textContent = 'النص';

      inputHelp.textContent =
        'اكتب النص الذي تريد تحويله';

      outputTitle.textContent = 'ASCII';

      outputHelp.textContent =
        'الأكواد الرقمية الناتجة';

      input.placeholder =
        'اكتب النص هنا...';

      output.placeholder =
        'مثال: 72 101 108 108 111';

      convertLabel.textContent =
        'تحويل إلى ASCII';

      input.dir = 'auto';
      output.dir = 'ltr';

    } else {

      inputTitle.textContent = 'ASCII';

      inputHelp.textContent =
        'أدخل الأكواد مفصولة بمسافات';

      outputTitle.textContent = 'النص';

      outputHelp.textContent =
        'النص الناتج من الأكواد';

      input.placeholder =
        'مثال: 72 101 108 108 111';

      output.placeholder =
        'Hello';

      convertLabel.textContent =
        'تحويل إلى نص';

      input.dir = 'ltr';
      output.dir = 'auto';
    }

    input.value = '';
    output.value = '';

    updateCounter();
    clearResults();
  }


  textModeButton.addEventListener(
    'click',
    () => setMode('text')
  );


  asciiModeButton.addEventListener(
    'click',
    () => setMode('ascii')
  );


  swapButton.addEventListener(
    'click',
    () => {
      setMode(
        mode === 'text'
          ? 'ascii'
          : 'text'
      );
    }
  );


  convertButton.addEventListener(
    'click',
    convert
  );


  input.addEventListener(
    'input',
    updateCounter
  );


  clearButton.addEventListener(
    'click',
    () => {
      input.value = '';
      output.value = '';

      updateCounter();
      clearResults();

      input.focus();
    }
  );


  pasteButton.addEventListener(
    'click',
    async () => {

      try {

        const text =
          await navigator.clipboard.readText();

        if (!text) {
          setMessage(
            'الحافظة فارغة.',
            'error'
          );
          return;
        }

        input.value = text;

        updateCounter();

        input.focus();

        setMessage(
          'تم اللصق بنجاح.',
          'success'
        );

      } catch {

        setMessage(
          'تعذر الوصول إلى الحافظة.',
          'error'
        );
      }
    }
  );


  copyButton.addEventListener(
    'click',
    async () => {

      if (!output.value) {
        setMessage(
          'لا توجد نتيجة لنسخها.',
          'error'
        );
        return;
      }

      try {

        await navigator.clipboard.writeText(
          output.value
        );

        copyButton.innerHTML =
          '<i class="fa-solid fa-check"></i> تم النسخ';

        setTimeout(() => {
          copyButton.innerHTML =
            '<i class="fa-regular fa-copy"></i> نسخ';
        }, 1500);

        setMessage(
          'تم نسخ النتيجة.',
          'success'
        );

      } catch {

        output.select();

        document.execCommand('copy');

        setMessage(
          'تم نسخ النتيجة.',
          'success'
        );
      }
    }
  );


  input.addEventListener(
    'keydown',
    event => {

      if (
        (event.ctrlKey || event.metaKey) &&
        event.key === 'Enter'
      ) {
        convert();
      }
    }
  );


  /* Theme */

  function syncTheme() {

    const html = document.documentElement;
    const body = document.body;

    const saved =
      localStorage.getItem('theme');

    const light =
      saved === 'light' ||
      html.dataset.theme === 'light' ||
      body.dataset.theme === 'light' ||
      html.classList.contains('light') ||
      body.classList.contains('light') ||
      html.classList.contains('light-theme') ||
      body.classList.contains('light-theme');

    body.classList.toggle(
      'ascii-light',
      light
    );

    body.classList.toggle(
      'ascii-dark',
      !light
    );
  }


  syncTheme();


  const observer =
    new MutationObserver(syncTheme);

  observer.observe(
    document.documentElement,
    {
      attributes: true,
      attributeFilter: [
        'class',
        'data-theme'
      ]
    }
  );

  observer.observe(
    document.body,
    {
      attributes: true,
      attributeFilter: [
        'class',
        'data-theme'
      ]
    }
  );

  window.addEventListener(
    'storage',
    syncTheme
  );
</script>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: 'Cairo', sans-serif;
    transition:
      background .3s ease,
      color .3s ease;
  }


  /* =========================
     DARK THEME
  ========================= */

  :global(body.ascii-dark) {
    background: #07111f;
    color: #e8f1fb;
  }


  /* =========================
     LIGHT THEME
  ========================= */

  :global(body.ascii-light) {
    background: #f4f8fc;
    color: #172033;
  }


  .ascii-tool {
    width: min(1080px, calc(100% - 28px));
    margin: auto;
    padding: 42px 0 70px;
  }


  /* HERO */

  .hero {
    display: flex;
    align-items: center;
    gap: 20px;

    padding: 30px;

    margin-bottom: 22px;

    border-radius: 22px;

    border: 1px solid rgba(56,189,248,.18);

    background:
      radial-gradient(
        circle at 90% 20%,
        rgba(14,165,233,.14),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        rgba(37,99,235,.16),
        rgba(8,145,178,.06)
      );
  }


  .hero-icon {
    width: 72px;
    height: 72px;

    flex: 0 0 72px;

    display: grid;
    place-items: center;

    border-radius: 19px;

    color: white;

    font-size: 28px;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #0891b2
      );

    box-shadow:
      0 12px 30px rgba(37,99,235,.25);
  }


  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    color: #38bdf8;

    font-size: 12px;
    font-weight: 700;
  }


  .hero h1 {
    margin: 5px 0 5px;

    font-size: clamp(26px,5vw,40px);

    line-height: 1.2;

    font-weight: 800;
  }


  .hero p {
    margin: 0;

    color: #91a4b9;

    font-size: 14px;
  }


  body.ascii-light .hero p {
    color: #64748b;
  }


  /* TOOL CARD */

  .tool-card {
    padding: 24px;

    border-radius: 22px;

    border: 1px solid rgba(148,163,184,.15);

    background: #0b1b2d;

    box-shadow:
      0 20px 50px rgba(0,0,0,.16);
  }


  body.ascii-light .tool-card {
    background: white;

    border-color: #dce6ef;

    box-shadow:
      0 18px 45px rgba(31,55,82,.08);
  }


  /* MODE */

  .mode-tabs {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 8px;

    padding: 5px;

    margin-bottom: 25px;

    border-radius: 13px;

    background: #071524;
  }


  body.ascii-light .mode-tabs {
    background: #edf4f9;
  }


  .mode {
    min-height: 46px;

    border: 0;

    border-radius: 9px;

    color: #8195aa;

    background: transparent;

    font-family: inherit;

    font-size: 13px;

    font-weight: 700;

    cursor: pointer;

    transition: .2s;
  }


  .mode.active {
    color: white;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #0891b2
      );

    box-shadow:
      0 7px 18px rgba(37,99,235,.22);
  }


  body.ascii-light .mode {
    color: #64748b;
  }


  body.ascii-light .mode.active {
    color: white;
  }


  /* PANELS */

  .panel-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    margin-bottom: 9px;
  }


  .panel-header h2 {
    margin: 0;

    font-size: 17px;

    font-weight: 800;
  }


  .panel-header p {
    margin: 2px 0 0;

    color: #8195aa;

    font-size: 11px;
  }


  body.ascii-light .panel-header p {
    color: #718096;
  }


  .counter {
    padding: 4px 9px;

    border-radius: 7px;

    color: #5cc7f4;

    background: rgba(56,189,248,.09);

    font-size: 10px;
  }


  textarea {
    width: 100%;

    min-height: 165px;

    display: block;

    padding: 16px;

    resize: vertical;

    border: 1px solid #29415b;

    border-radius: 14px;

    outline: none;

    background: #071524;

    color: #e9f3ff;

    font-family:
      'Cairo',
      sans-serif;

    font-size: 14px;

    line-height: 1.8;

    transition: .2s;
  }


  body.ascii-light textarea {
    border-color: #d5e0ea;

    background: #f8fbfd;

    color: #172033;
  }


  textarea:focus {
    border-color: #2196e0;

    box-shadow:
      0 0 0 3px rgba(33,150,224,.1);
  }


  #output {
    direction: ltr;

    text-align: left;

    font-family:
      Consolas,
      'Courier New',
      monospace;
  }


  /* BUTTONS */

  .buttons {
    display: flex;

    gap: 8px;

    margin-top: 9px;
  }


  .small-btn,
  .copy {
    min-height: 38px;

    padding: 0 14px;

    border: 0;

    border-radius: 9px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    color: #a7c8e3;

    background: #10273f;

    font-family: inherit;

    font-size: 11px;

    font-weight: 700;

    cursor: pointer;

    transition: .2s;
  }


  body.ascii-light .small-btn {
    color: #315a7e;

    background: #eaf2f8;
  }


  .small-btn.danger {
    color: #fb8d9b;

    background: rgba(239,68,68,.08);
  }


  .copy {
    color: #57c4f2;

    background: rgba(56,189,248,.1);
  }


  .small-btn:hover,
  .copy:hover {
    transform: translateY(-1px);
  }


  /* CONVERT */

  .convert-row {
    display: flex;

    justify-content: center;

    align-items: center;

    gap: 9px;

    margin: 23px 0;
  }


  .convert {
    min-height: 48px;

    padding: 0 25px;

    border: 0;

    border-radius: 12px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    color: white;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #0891b2
      );

    font-family: inherit;

    font-size: 13px;

    font-weight: 800;

    cursor: pointer;

    box-shadow:
      0 9px 22px rgba(37,99,235,.2);

    transition: .2s;
  }


  .convert:hover {
    transform: translateY(-2px);
  }


  .swap {
    width: 48px;
    height: 48px;

    border: 1px solid #2a435d;

    border-radius: 12px;

    color: #62bce9;

    background: #0d2136;

    cursor: pointer;

    transition: .25s;
  }


  .swap:hover {
    transform: rotate(180deg);

    border-color: #2196e0;
  }


  body.ascii-light .swap {
    border-color: #d2dfe9;

    background: #f0f6fa;

    color: #2571a4;
  }


  /* REPRESENTATIONS */

  .representations {
    display: grid;

    grid-template-columns:
      repeat(3,1fr);

    gap: 10px;

    margin-top: 17px;
  }


  .representation {
    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 0;

    padding: 13px;

    border-radius: 13px;

    border: 1px solid rgba(148,163,184,.12);

    background: rgba(16,39,63,.5);
  }


  body.ascii-light .representation {
    border-color: #e1e9f0;

    background: #f8fafc;
  }


  .representation-icon {
    width: 37px;
    height: 37px;

    flex: 0 0 37px;

    display: grid;

    place-items: center;

    border-radius: 9px;

    color: white;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #0891b2
      );
  }


  .representation span {
    display: block;

    color: #8094aa;

    font-size: 9px;
  }


  .representation strong {
    display: block;

    margin-top: 2px;

    max-width: 100%;

    overflow: hidden;

    direction: ltr;

    text-align: left;

    color: #dcecff;

    font-family:
      Consolas,
      monospace;

    font-size: 11px;

