    .copy-section {

      display: flex;

      justify-content: flex-start;

      margin-top: 17px;
    }

    .secondary-btn {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      padding:
        10px 15px;

      border:
        1px solid
        var(--border);

      border-radius: 10px;

      background:
        var(--surface-2);

      color:
        var(--muted);

      font-family: inherit;

      font-size: 12px;

      cursor: pointer;

      transition: .2s ease;
    }

    .secondary-btn:hover,
    .secondary-btn.copied {

      color:
        var(--blue);

      border-color:
        rgba(40,184,242,.3);

      background:
        var(--blue-soft);
    }

    .examples-section {

      margin-top: 25px;

      padding-top: 20px;

      border-top:
        1px solid
        var(--border);
    }

    .examples-list {

      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 9px;

      margin-top: 10px;
    }

    .examples-list button {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 10px;

      padding:
        12px;

      border:
        1px solid
        var(--border);

      border-radius: 11px;

      background:
        var(--surface-2);

      color:
        var(--muted);

      font-family: inherit;

      cursor: pointer;

      text-align: right;

      transition: .2s ease;
    }

    .examples-list button:hover {

      border-color:
        rgba(40,184,242,.3);

      background:
        var(--blue-soft);
    }

    .examples-list code {

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;

      direction: ltr;
    }

    .examples-list span {

      font-size: 10px;
    }

    .parser-empty {

      grid-column:
        1 / -1;

      padding:
        35px 20px;

      text-align: center;

      border:
        1px dashed
        var(--border);

      border-radius: 15px;

      background:
        var(--surface-2);
    }

    .parser-empty > i {

      color:
        var(--danger);

      font-size: 25px;
    }

    .parser-empty h3 {

      margin:
        10px 0 5px;

      font-size: 15px;
    }

    .parser-empty p {

      margin: 0;

      color:
        var(--muted);

      font-size: 11px;
    }

    .info-grid {

      max-width: 1050px;

      margin:
        22px auto 0;

      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 15px;
    }

    .info-card {

      padding: 21px;

      border-radius: 18px;
    }

    .info-icon {

      width: 42px;
      height: 42px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .info-card h3 {

      margin:
        14px 0 7px;

      font-size: 15px;
    }

    .info-card p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    .content-card,
    .faq-card {

      max-width: 1050px;

      margin:
        22px auto 0;

      padding: 24px;

      border-radius: 20px;
    }

    .content-heading {

      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 22px;
    }

    .heading-icon {

      width: 44px;
      height: 44px;

      flex:
        0 0 44px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .content-heading h2 {

      margin:
        0 0 3px;

      font-size: 18px;
    }

    .content-heading p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;
    }

    .cron-table {

      display: grid;

      gap: 8px;
    }

    .table-row {

      display: grid;

      grid-template-columns:
        .5fr 1.2fr .8fr 2fr;

      align-items: center;

      gap: 10px;

      padding:
        12px 14px;

      border-radius: 11px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);

      color:
        var(--muted);

      font-size: 11px;
    }

    .table-row strong {

      color:
        var(--blue);
    }

    .table-row code {

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;
    }

    .table-head {

      background:
        var(--surface-3);

      color:
        var(--text);

      font-weight: 700;

      font-size: 10px;
    }

    .steps {

      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 14px;
    }

    .step {

      display: flex;

      gap: 12px;

      padding: 15px;

      border-radius: 14px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);
    }

    .step > span {

      color:
        var(--blue);

      font:
        600 12px
        'JetBrains Mono',
        monospace;
    }

    .step h3 {

      margin:
        0 0 4px;

      font-size: 13px;
    }

    .step p {

      margin: 0;

      color:
        var(--muted);

      font-size: 11px;

      line-height: 1.8;
    }

    .step code,
    .tip-card code {

      padding:
        2px 6px;

      border-radius: 5px;

      background:
        var(--blue-soft);

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 10px;
    }

    .tip-card {

      max-width: 1050px;

      margin:
        22px auto 0;

      padding:
        18px 20px;

      border-radius: 18px;

      display: flex;

      align-items: flex-start;

      gap: 14px;
    }

    .tip-icon {

      width: 43px;
      height: 43px;

      flex:
        0 0 43px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .tip-card strong {

      display: block;

      margin-bottom: 4px;

      font-size: 14px;
    }

    .tip-card p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    .faq-list {

      display: grid;

      gap: 9px;
    }

    .faq-list details {

      border:
        1px solid
        var(--border);

      background:
        var(--surface-2);

      border-radius: 13px;

      overflow: hidden;
    }

    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 15px;

      cursor: pointer;

      list-style: none;

      font-size: 13px;

      font-weight: 700;
    }

    .faq-list summary::-webkit-details-marker {
      display: none;
    }

    .faq-list summary i {

      color:
        var(--blue);

      transition:
        transform .2s ease;
    }

    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);
    }

    .faq-list details p {

      margin: 0;

      padding:
        0 15px 16px;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    @media (max-width: 900px) {

      .fields-grid {

        grid-template-columns:
          repeat(3,1fr);
      }

      .symbols-list {

        grid-template-columns:
          repeat(2,1fr);
      }

      .examples-list {

        grid-template-columns:
          repeat(2,1fr);
      }

    }

    @media (max-width: 700px) {

      .fields-grid {

        grid-template-columns:
          repeat(2,1fr);
      }

      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }

      .cron-table .table-row {

        grid-template-columns:
          .5fr 1fr 1fr 2fr;
      }

    }

    @media (max-width: 600px) {

      .cron-page {

        padding:
          25px 12px 50px;
      }

      .tool-card,
      .content-card,
      .faq-card {

        padding: 17px;

        border-radius: 18px;
      }

      .tool-top {

        align-items:
          flex-start;
      }

      .tool-title p {

        display: none;
      }

      .status {

        font-size: 10px;

        padding:
          7px 9px;
      }

      .input-row {

        flex-direction:
          column;
      }

      .primary-btn {

        height: 48px;
      }

      .fields-grid {

        grid-template-columns:
          1fr;
      }

      .symbols-list,
      .examples-list {

        grid-template-columns:
          1fr;
      }

      .description-card {

        align-items:
          flex-start;
      }

      .cron-table {

        gap: 6px;
      }

      .cron-table .table-row {

        grid-template-columns:
          .4fr 1fr 1fr 1.5fr;

        padding:
          10px;

        font-size: 9px;
      }

      .table-head {

        font-size: 8px !important;
      }

      .hero h1 {

        font-size: 34px;
      }

      .hero > p {

        font-size: 14px;
      }

      .tip-card {

        align-items:
          flex-start;
      }

    }

  </style>
</body>
</html>
