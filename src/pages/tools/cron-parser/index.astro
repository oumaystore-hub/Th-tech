---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/cron-expression-parser/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Cron Expression Parser | محلل Cron Expression</title>

  <meta
    name="description"
    content="أداة مجانية لتحليل Cron Expression وفهم كل حقل من حقول التعبير مع وصف بشري وأمثلة جاهزة."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>
  <Header />

  <main class="cron-page">

    <!-- Hero -->
    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-code-branch"></i>
        أداة المطورين
      </div>

      <h1>
        Cron Expression
        <span>Parser</span>
      </h1>

      <p>
        أدخل Cron Expression لفهم معناه وتحليل كل حقل من حقوله
        ومعرفة الجدول الزمني الذي يمثله التعبير.
      </p>

      <div class="hero-points">

        <span>
          <i class="fa-solid fa-check-circle"></i>
          فحص الصيغة
        </span>

        <span>
          <i class="fa-solid fa-magnifying-glass"></i>
          تحليل الحقول
        </span>

        <span>
          <i class="fa-solid fa-language"></i>
          وصف بشري
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          يعمل محليًا
        </span>

      </div>

    </section>

    <!-- Tool -->
    <section class="tool-card">

      <div class="tool-top">

        <div class="tool-title">

          <div class="tool-icon">
            <i class="fa-solid fa-code"></i>
          </div>

          <div>
            <h2>تحليل Cron Expression</h2>

            <p>
              أدخل تعبير Cron لمعرفة معنى كل جزء منه.
            </p>
          </div>

        </div>

        <div class="status">
          <span class="status-dot"></span>
          يعمل محليًا
        </div>

      </div>

      <!-- Input -->
      <div class="parser-input">

        <label for="cronInput">
          <i class="fa-solid fa-terminal"></i>
          Cron Expression
        </label>

        <div class="input-row">

          <div class="input-wrap">

            <i class="fa-solid fa-code"></i>

            <input
              id="cronInput"
              type="text"
              dir="ltr"
              spellcheck="false"
              autocomplete="off"
              value="*/5 * * * *"
              placeholder="مثال: 0 9 * * 1-5"
            />

            <button
              id="clearBtn"
              class="clear-btn"
              type="button"
              title="مسح"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>

          </div>

          <button
            id="parseBtn"
            class="primary-btn"
            type="button"
          >
            <i class="fa-solid fa-magnifying-glass"></i>
            تحليل
          </button>

        </div>

        <div class="input-hint">

          <i class="fa-solid fa-circle-info"></i>

          الصيغة التقليدية تتكون من خمسة حقول:
          الدقيقة، الساعة، اليوم، الشهر، ويوم الأسبوع.

        </div>

      </div>

      <!-- Status -->
      <div id="parseStatus" class="parse-status">

        <div class="status-icon">
          <i class="fa-solid fa-check"></i>
        </div>

        <div>
          <strong>تعبير صالح</strong>
          <span id="statusText">
            تم التعرف على التعبير بنجاح.
          </span>
        </div>

      </div>

      <!-- Human description -->
