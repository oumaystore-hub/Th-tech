  <script>
    function init() {

      const cronInput =
        document.getElementById('cronInput');

      const parseBtn =
        document.getElementById('parseBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const fieldsGrid =
        document.getElementById('fieldsGrid');

      const symbolsList =
        document.getElementById('symbolsList');

      const humanDescription =
        document.getElementById('humanDescription');

      const parseStatus =
        document.getElementById('parseStatus');

      const statusText =
        document.getElementById('statusText');

      const copyCron =
        document.getElementById('copyCron');

      if (
        !cronInput ||
        !parseBtn ||
        !fieldsGrid
      ) {
        return;
      }

      const fieldDefinitions = [

        {
          name: 'الدقيقة',
          english: 'Minute',
          icon: 'fa-stopwatch',
          range: '0–59',
          description: 'تحدد الدقيقة التي يتم فيها تنفيذ المهمة.'
        },

        {
          name: 'الساعة',
          english: 'Hour',
          icon: 'fa-clock',
          range: '0–23',
          description: 'تحدد الساعة التي يتم فيها تنفيذ المهمة.'
        },

        {
          name: 'اليوم',
          english: 'Day of Month',
          icon: 'fa-calendar-day',
          range: '1–31',
          description: 'تحدد يوم الشهر الذي يتم فيه التنفيذ.'
        },

        {
          name: 'الشهر',
          english: 'Month',
          icon: 'fa-calendar',
          range: '1–12',
          description: 'تحدد الشهر الذي يتم فيه التنفيذ.'
        },

        {
          name: 'يوم الأسبوع',
          english: 'Day of Week',
          icon: 'fa-calendar-week',
          range: '0–6',
          description: 'تحدد يوم الأسبوع الذي يتم فيه التنفيذ.'
        }

      ];

      function escapeHtml(value) {

        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      }

      function parseExpression(expression) {

        const clean =
          expression.trim();

        const parts =
          clean.split(/\s+/);

        if (parts.length !== 5) {

          return {
            valid: false,
            message:
              'يجب أن يحتوي التعبير على خمسة حقول بالضبط.'
          };

        }

        const validPattern =
          /^[0-9*?,\/\-A-Za-z]+$/;

        if (
          !parts.every(
            part => validPattern.test(part)
          )
        ) {

          return {
            valid: false,
            message:
              'التعبير يحتوي على رموز غير صالحة.'
          };

        }

        return {
          valid: true,
          parts
        };

      }

      function describeField(
        value,
        index
      ) {

        const names = [
          'الدقيقة',
          'الساعة',
          'اليوم',
          'الشهر',
          'يوم الأسبوع'
        ];

        if (value === '*') {
          return `جميع قيم ${names[index]}.`;
        }

        if (value.startsWith('*/')) {
          return `كل ${value.substring(2)} وحدات من ${names[index]}.`;
        }

        if (value.includes('-')) {
          return `نطاق من ${value} في ${names[index]}.`;
        }

        if (value.includes(',')) {
          return `القيم المحددة ${value} في ${names[index]}.`;
        }

        return `القيمة المحددة هي ${value}.`;

      }

      function humanize(parts) {

        const [
          minute,
          hour,
          day,
          month,
          weekday
        ] = parts;

        if (
          minute === '*' &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم تنفيذ المهمة كل دقيقة.';
        }

        if (
          minute === '0' &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم تنفيذ المهمة في بداية كل ساعة.';
        }

        if (
          minute.startsWith('*/') &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {

          const value =
            minute.substring(2);

          return `يتم تنفيذ المهمة كل ${value} دقائق.`;
        }

        if (
          minute === '0' &&
          hour === '0' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم تنفيذ المهمة يوميًا عند منتصف الليل.';
        }

        if (
          minute === '0' &&
          hour === '9' &&
          day === '*' &&
          month === '*' &&
          weekday === '1-5'
        ) {
          return 'يتم تنفيذ المهمة الساعة 09:00 من الاثنين إلى الجمعة.';
        }

        if (
          minute === '0' &&
          hour === '0' &&
          day === '1' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم تنفيذ المهمة في منتصف الليل في اليوم الأول من كل شهر.';
        }

        if (
          minute === '0' &&
          hour === '0' &&
          day === '*' &&
          month === '*' &&
          weekday === '0'
        ) {
          return 'يتم تنفيذ المهمة كل يوم أحد عند منتصف الليل.';
        }

        let text =
          'يتم التنفيذ وفق القيم التالية: ';

        text +=
          `الدقيقة ${minute}، `;

        text +=
          `الساعة ${hour}، `;

        text +=
          `اليوم ${day}، `;

        text +=
          `الشهر ${month}، `;

        text +=
          `ويوم الأسبوع ${weekday}.`;

        return text;

      }

      function getSymbols(parts) {

        const symbols = [];

        const full =
          parts.join(' ');

        if (full.includes('*')) {

          symbols.push({
            symbol: '*',
            title: 'Wildcard',
            description:
              'تمثل جميع القيم الممكنة.'
          });

        }

        if (full.includes('/')) {

          symbols.push({
            symbol: '/',
            title: 'Step',
            description:
              'تحدد الفاصل الزمني للتكرار.'
          });

        }

        if (full.includes('-')) {

          symbols.push({
            symbol: '-',
            title: 'Range',
            description:
              'تحدد نطاقًا من القيم.'
          });

        }

        if (full.includes(',')) {

          symbols.push({
            symbol: ',',
            title: 'List',
            description:
              'تفصل بين عدة قيم.'
          });

        }

        if (!symbols.length) {

          symbols.push({
            symbol: '—',
            title: 'قيم مباشرة',
            description:
              'التعبير يستخدم قيمًا محددة.'
          });

        }

        return symbols;

      }

      function renderFields(parts) {

        fieldsGrid.innerHTML =
          parts.map(
            (value, index) => {

              const field =
                fieldDefinitions[index];

              return `
                <article class="field-result">

                  <div class="field-result-top">

                    <div class="field-result-icon">
                      <i class="fa-solid ${field.icon}"></i>
                    </div>

                    <div>

                      <h3>
                        ${escapeHtml(field.name)}
                      </h3>

                      <span>
                        ${escapeHtml(field.english)}
                      </span>

                    </div>

                  </div>

                  <div class="field-value" dir="ltr">
                    ${escapeHtml(value)}
                  </div>

                  <div class="field-meta">

                    <span>
                      ${escapeHtml(field.range)}
                    </span>

                    <span>
                      ${escapeHtml(
                        describeField(value, index)
                      )}
                    </span>

                  </div>

                </article>
              `;

            }
          ).join('');

      }

      function renderSymbols(parts) {

        const symbols =
          getSymbols(parts);

        symbolsList.innerHTML =
          symbols.map(
            item => `
              <div class="symbol-card">

                <strong dir="ltr">
                  ${escapeHtml(item.symbol)}
                </strong>

                <div>
                  <b>
                    ${escapeHtml(item.title)}
                  </b>

                  <span>
                    ${escapeHtml(item.description)}
                  </span>
                </div>

              </div>
            `
          ).join('');

      }

      function setStatus(valid, message) {

        if (valid) {

          parseStatus.classList.remove('invalid');

          parseStatus.classList.add('valid');

          parseStatus.querySelector('.status-icon')
            .innerHTML =
              '<i class="fa-solid fa-check"></i>';

        } else {

          parseStatus.classList.remove('valid');

          parseStatus.classList.add('invalid');

          parseStatus.querySelector('.status-icon')
            .innerHTML =
              '<i class="fa-solid fa-xmark"></i>';

        }

        parseStatus.querySelector('strong')
          .textContent =
          valid
            ? 'تعبير صالح'
            : 'تعبير غير صالح';

        statusText.textContent =
          message;

      }

      function parse() {

        const expression =
          cronInput.value.trim();

        const result =
          parseExpression(expression);

        if (!result.valid) {

          setStatus(
            false,
            result.message
          );

          fieldsGrid.innerHTML = `
            <div class="parser-empty">
              <i class="fa-solid fa-triangle-exclamation"></i>

              <h3>تعذر تحليل التعبير</h3>

              <p>
                ${escapeHtml(result.message)}
              </p>
            </div>
          `;

          symbolsList.innerHTML = '';

          humanDescription.textContent =
            'أدخل تعبير Cron صالحًا للبدء بالتحليل.';

          return;

        }

        setStatus(
          true,
          'تم التعرف على التعبير وتحليل الحقول بنجاح.'
        );

        renderFields(result.parts);

        renderSymbols(result.parts);

        humanDescription.textContent =
          humanize(result.parts);

      }

      function copyText(text, button) {

        const original =
          button.innerHTML;

        const done = () => {

          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          button.classList.add('copied');

          setTimeout(() => {

            button.innerHTML =
              original;

            button.classList.remove('copied');

          }, 1300);

        };

        if (
          navigator.clipboard &&
          navigator.clipboard.writeText
        ) {

          navigator.clipboard
            .writeText(text)
            .then(done)
            .catch(() => {

              fallbackCopy(text);
              done();

            });

        } else {

          fallbackCopy(text);
          done();

        }

      }

      function fallbackCopy(text) {

        const textarea =
          document.createElement('textarea');

        textarea.value =
          text;

        textarea.style.position =
          'fixed';

        textarea.style.opacity =
          '0';

        document.body.appendChild(
          textarea
        );

        textarea.select();

        try {
          document.execCommand('copy');
        } catch {}

        textarea.remove();

      }

      parseBtn.addEventListener(
        'click',
        parse
      );

      cronInput.addEventListener(
        'input',
        parse
      );

      cronInput.addEventListener(
        'keydown',
        event => {

          if (event.key === 'Enter') {
            parse();
          }

        }
      );

      clearBtn.addEventListener(
        'click',
        () => {

          cronInput.value = '';

          setStatus(
            false,
            'أدخل تعبير Cron للبدء.'
          );

          fieldsGrid.innerHTML = '';

          symbolsList.innerHTML = '';

          humanDescription.textContent =
            'أدخل تعبير Cron صالحًا للبدء بالتحليل.';

          cronInput.focus();

        }
      );

      copyCron.addEventListener(
        'click',
        () => {

          const expression =
            cronInput.value.trim();

          if (!expression) return;

          copyText(
            expression,
            copyCron
          );

        }
      );

      document
        .querySelectorAll('[data-expression]')
        .forEach(button => {

          button.addEventListener(
            'click',
            () => {

              cronInput.value =
                button.dataset.expression || '';

              parse();

            }
          );

        });

      // Theme
      function getThemeState() {

        const html =
          document.documentElement;

        const stored =
          localStorage.getItem('theme');

        if (stored === 'light') return 'light';

        if (stored === 'dark') return 'dark';

        if (
          html.dataset.theme === 'light'
        ) {
          return 'light';
        }

        if (
          html.dataset.theme === 'dark'
        ) {
          return 'dark';
        }

        if (
          html.classList.contains('light')
        ) {
          return 'light';
        }

        if (
          html.classList.contains('dark')
        ) {
          return 'dark';
        }

        return 'dark';

      }

      function syncTheme() {

        const light =
          getThemeState() === 'light';

        document.body.classList.toggle(
          'cron-light',
          light
        );

        document.body.classList.toggle(
          'cron-dark',
          !light
        );

      }

      syncTheme();

      window.addEventListener(
        'storage',
        event => {

          if (
            event.key === 'theme'
          ) {
            syncTheme();
          }

        }
      );

      const themeObserver =
        new MutationObserver(
          syncTheme
        );

      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: [
            'class',
            'data-theme'
          ]
        }
      );

      parse();

    }

    if (
      document.readyState === 'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        init
      );

    } else {

      init();

    }
  </script>

