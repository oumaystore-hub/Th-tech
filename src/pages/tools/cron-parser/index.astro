          <i class="fa-solid fa-copy"></i>
          نسخ Cron Expression
        </button>

      </div>

      <!-- Examples -->
      <div class="examples-section">

        <div class="section-label">
          <i class="fa-solid fa-bolt"></i>
          أمثلة سريعة
        </div>

        <div class="examples-list">

          <button data-expression="* * * * *">
            <code>* * * * *</code>
            <span>كل دقيقة</span>
          </button>

          <button data-expression="0 * * * *">
