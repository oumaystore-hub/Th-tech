---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Open Graph Generator - إنشاء Open Graph أونلاين | Th.Tech";
const description =
  "أداة مجانية لإنشاء وسوم Open Graph لصفحات الويب وتحسين ظهور الروابط عند مشاركتها على Facebook وLinkedIn ووسائل التواصل الاجتماعي.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>
          <span>Open Graph Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-share-nodes"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-globe"></i>
              SEO Tools
            </span>

            <h1>
              Open Graph <span>Generator</span>
            </h1>

            <p>
              أنشئ وسوم Open Graph جاهزة لصفحتك لتحسين شكل الروابط
              عند مشاركتها على شبكات التواصل الاجتماعي.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-share-nodes"></i>
              <span>Open Graph Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ الكود
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Content -->

          <div class="generator-layout">

            <!-- INPUT -->

            <div class="form-panel">

              <div class="panel-title">
                <i class="fas fa-sliders"></i>
                معلومات الصفحة
              </div>


              <div class="form-group">

                <label for="pageTitle">
                  عنوان الصفحة
                </label>

                <input
                  id="pageTitle"
                  type="text"
                  placeholder="مثال: Th.Tech - أدوات تقنية مجانية"
                  value=""
                />

              </div>


              <div class="form-group">

                <label for="pageDescription">
                  وصف الصفحة
                </label>

                <textarea
                  id="pageDescription"
                  rows="4"
                  placeholder="اكتب وصفاً مختصراً للصفحة..."
                ></textarea>

              </div>


              <div class="form-group">

                <label for="pageUrl">
                  رابط الصفحة
                </label>

                <input
                  id="pageUrl"
                  type="url"
                  placeholder="https://example.com/page"
                />

              </div>


              <div class="form-group">

                <label for="imageUrl">
                  رابط الصورة
                </label>

                <input
                  id="imageUrl"
                  type="url"
                  placeholder="https://example.com/image.jpg"
                />

              </div>


              <div class="form-row">

                <div class="form-group">

                  <label for="siteName">
                    اسم الموقع
                  </label>

                  <input
                    id="siteName"
                    type="text"
                    placeholder="Th.Tech"
                  />

                </div>


                <div class="form-group">

                  <label for="locale">
                    اللغة
                  </label>

                  <select id="locale">

                    <option value="ar_AR">
                      العربية
                    </option>

                    <option value="en_US">
                      English
                    </option>

                    <option value="fr_FR">
                      Français
                    </option>

                  </select>

                </div>

              </div>


              <div class="form-group">

                <label for="type">
                  نوع المحتوى
                </label>

                <select id="type">

                  <option value="website">
                    Website
                  </option>

                  <option value="article">
                    Article
                  </option>

                  <option value="product">
                    Product
                  </option>

                  <option value="profile">
                    Profile
                  </option>

                </select>

              </div>


              <button
                id="generateBtn"
                class="generate-btn"
                type="button"
              >
                <i class="fas fa-wand-magic-sparkles"></i>
                إنشاء Open Graph
                <i class="fas fa-arrow-left"></i>
              </button>

            </div>


            <!-- OUTPUT -->

            <div class="output-panel">

              <div class="panel-title output-title">

                <div>
                  <i class="fas fa-code"></i>
                  كود Open Graph
                </div>

                <span id="codeStatus">
                  جاهز
                </span>

              </div>


              <div class="code-wrapper">

                <textarea
                  id="output"
                  readonly
                  spellcheck="false"
                  placeholder="سيظهر كود Open Graph هنا..."
                ></textarea>

              </div>


              <!-- Preview -->

              <div class="preview-section">

                <div class="preview-title">
                  <i class="fas fa-eye"></i>
                  معاينة المشاركة
                </div>


                <div class="social-preview">

                  <div
                    id="previewImage"
                    class="preview-image"
                  >
                    <i class="fas fa-image"></i>
                  </div>


                  <div class="preview-content">

                    <span
                      id="previewSite"
                      class="preview-site"
                    >
                      example.com
                    </span>

                    <h3 id="previewTitle">
                      عنوان الصفحة
                    </h3>

                    <p id="previewDescription">
                      وصف الصفحة سيظهر هنا...
                    </p>

                  </div>

                </div>

              </div>

            </div>

          </div>


          <!-- Status -->

          <div
            id="status"
            class="status hidden"
          >

            <i
              id="statusIcon"
              class="fas fa-check-circle"
            ></i>

            <span id="statusText"></span>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-share-nodes"></i>
            </div>

            <div>

              <h3>
                مشاركة أفضل
              </h3>

              <p>
                حسّن شكل روابط موقعك عند مشاركتها على شبكات التواصل الاجتماعي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>
                إنشاء فوري
              </h3>

              <p>
                أنشئ وسوم Open Graph مباشرة من المتصفح بدون رفع بياناتك إلى خادم.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>

              <h3>
                كود جاهز
              </h3>

              <p>
                انسخ الكود الناتج وضعه داخل وسم head في صفحة HTML الخاصة بك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>Open Graph Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-pen"></i>
              </div>

              <h3>
                أدخل معلومات الصفحة
              </h3>

              <p>
                أدخل العنوان والوصف والرابط والصورة واسم الموقع.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-wand-magic-sparkles"></i>
              </div>

              <h3>
                أنشئ الوسوم
              </h3>

              <p>
                اضغط على زر إنشاء Open Graph لتوليد الكود تلقائياً.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>
                انسخ الكود
              </h3>

              <p>
                انسخ الكود وضعه داخل قسم head في صفحة موقعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>Open Graph</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو Open Graph؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                Open Graph هو مجموعة من وسوم HTML تساعد شبكات التواصل
                الاجتماعي على معرفة عنوان الصفحة ووصفها والصورة التي يجب
                عرضها عند مشاركة الرابط.
              </p>

            </details>


            <details>

              <summary>
                أين أضع كود Open Graph؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                يوضع الكود الناتج داخل قسم head في صفحة HTML الخاصة بك.
              </p>

            </details>


            <details>

              <summary>
                هل الأداة ترسل بياناتي إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. يتم إنشاء الكود مباشرة داخل المتصفح.
              </p>

            </details>


            <details>

              <summary>
                هل Open Graph مهم لتحسين المشاركة؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. تساعد وسوم Open Graph المنصات الاجتماعية على عرض
                معاينة أكثر دقة وجاذبية عند مشاركة صفحات موقعك.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #7c3aed;
      --primary-hover: #6d28d9;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #8b5cf6;
      --primary-hover: #7c3aed;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* HERO */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(124, 58, 237, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 22px;
      color: var(--primary);
      background: rgba(124, 58, 237, .10);
      border: 1px solid rgba(124, 58, 237, .15);
      font-size: 2rem;
      box-shadow: 0 15px 35px rgba(124, 58, 237, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--primary);
      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;
      margin: 0;
      color: var(--muted);
      font-size: .92rem;
    }


    /* TOOL */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 38px;
      padding: 7px 13px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      font-size: .76rem;
      font-weight: 700;
      cursor: pointer;
      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(124, 58, 237, .35);
      color: var(--primary);
      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* GENERATOR */

    .generator-layout {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 20px;
      padding: 20px;
    }


    .form-panel,
    .output-panel {
      padding: 20px;
      border-radius: 18px;
      background: var(--card2);
      border: 1px solid var(--border);
    }


    .panel-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 15px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--border);
      font-size: .85rem;
      font-weight: 800;
    }


    .panel-title > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }


    .panel-title i {
      color: var(--primary);
    }


    .output-title span {
      padding: 4px 9px;
      border-radius: 7px;
      background: rgba(22, 163, 74, .09);
      color: var(--green);
      font-size: .65rem;
    }


    .form-group {
      margin-bottom: 15px;
    }


    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 700;
    }


    input,
    select,
    .form-group textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 11px;
      outline: none;
      padding: 11px 13px;
      background: var(--card);
      color: var(--text);
      font-size: .78rem;
      transition: .2s ease;
    }


    input:focus,
    select:focus,
    .form-group textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, .08);
    }


    .form-group textarea {
      min-height: 100px;
      resize: vertical;
      line-height: 1.8;
    }


    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }


    .generate-btn {
      width: 100%;
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      margin-top: 5px;
      border: 0;
      border-radius: 12px;
      background: linear-gradient(
        135deg,
        #8b5cf6,
        #7c3aed
      );
      color: white;
      font-size: .85rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 12px 30px rgba(124, 58, 237, .22);
      transition: .25s ease;
    }


    .generate-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 17px 35px rgba(124, 58, 237, .30);
    }


    /* CODE */

    .code-wrapper {
      height: 315px;
      overflow: hidden;
      border-radius: 13px;
      background: #08111f;
      border: 1px solid var(--border);
    }


    #output {
      width: 100%;
      height: 100%;
      display: block;
      resize: none;
      outline: none;
      border: 0;
      padding: 17px;
      background: transparent;
      color: #c4b5fd;
      direction: ltr;
      text-align: left;
      font-family: Consolas, "Courier New", monospace;
      font-size: .77rem;
      line-height: 1.8;
    }


    #output::placeholder {
      color: #64748b;
    }


    /* PREVIEW */

    .preview-section {
      margin-top: 18px;
    }


    .preview-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 700;
    }


    .preview-title i {
      color: var(--primary);
    }


    .social-preview {
      overflow: hidden;
      border-radius: 13px;
      background: var(--card);
      border: 1px solid var(--border);
    }


    .preview-image {
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(
          135deg,
          rgba(124, 58, 237, .13),
          rgba(6, 182, 212, .08)
        );
      color: var(--primary);
      font-size: 2rem;
      overflow: hidden;
    }


    .preview-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }


    .preview-content {
      padding: 14px 15px;
      direction: ltr;
      text-align: left;
    }


    .preview-site {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-size: .65rem;
      text-transform: uppercase;
    }


    .preview-content h3 {
      margin: 0 0 4px;
      color: var(--text);
      font-family: "Cairo", sans-serif;
      font-size: .88rem;
    }


    .preview-content p {
      margin: 0;
      color: var(--muted);
      font-size: .7rem;
      line-height: 1.6;
    }


    /* STATUS */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 0 20px 20px;
      padding: 11px 15px;
      border-radius: 11px;
      background: rgba(34, 197, 94, .08);
      border: 1px solid rgba(34, 197, 94, .15);
      color: var(--green);
      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);
      border-color: rgba(220, 38, 38, .15);
      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* INFO */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 17px;
      margin-top: 25px;
    }


    .info-card {
      display: flex;
      gap: 14px;
      padding: 22px;
      border-radius: 17px;
      background: var(--card);
      border: 1px solid var(--border);
      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);
      border-color: rgba(124, 58, 237, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      color: var(--primary);
      background: rgba(124, 58, 237, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;
      font-size: .9rem;
    }


    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: .74rem;
      line-height: 1.8;
    }


    /* SECTIONS */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;
      font-size: clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* STEPS */

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }


    .step {
      position: relative;
      overflow: hidden;
      padding: 30px 25px;
      text-align: center;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;
      top: 10px;
      left: 15px;
      color: var(--primary);
      opacity: .08;
      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 17px;
      border-radius: 16px;
      color: var(--primary);
      background: rgba(124, 58, 237, .09);
      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;
      font-size: 1rem;
    }


    .step p {
      margin: 0;
      color: var(--muted);
      font-size: .76rem;
      line-height: 1.8;
    }


    /* FAQ */

    .faq-list {
      max-width: 900px;
      margin: auto;
      display: grid;
      gap: 12px;
    }


    details {
      padding: 0 20px;
      border-radius: 15px;
      background: var(--card);
      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 19px 0;
      cursor: pointer;
      list-style: none;
      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);
      font-size: .7rem;
      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;
      padding: 0 0 19px;
      color: var(--muted);
      font-size: .76rem;
      line-height: 1.9;
    }


    /* MOBILE */

    @media (max-width: 900px) {

      .generator-layout {
        grid-template-columns: 1fr;
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
        align-items: flex-start;
      }


      .tool-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;
        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;
        flex-direction: column;
        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .generator-layout {
        padding: 12px;
        gap: 12px;
      }


      .form-panel,
      .output-panel {
        padding: 15px;
      }


      .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }


      .code-wrapper {
        height: 300px;
      }


      .preview-image {
        height: 130px;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }

      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* THEME */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {
            applyTheme(
              theme === 'dark'
            );
          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      /* ELEMENTS */

      const pageTitle =
        document.getElementById('pageTitle');

      const pageDescription =
        document.getElementById('pageDescription');

      const pageUrl =
        document.getElementById('pageUrl');

      const imageUrl =
        document.getElementById('imageUrl');

      const siteName =
        document.getElementById('siteName');

      const locale =
        document.getElementById('locale');

      const type =
        document.getElementById('type');

      const output =
        document.getElementById('output');

      const generateBtn =
        document.getElementById('generateBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const codeStatus =
        document.getElementById('codeStatus');

      const previewImage =
        document.getElementById('previewImage');

      const previewTitle =
        document.getElementById('previewTitle');

      const previewDescription =
        document.getElementById('previewDescription');

      const previewSite =
        document.getElementById('previewSite');


      /* STATUS */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add('hidden');

      };


      /* ESCAPE HTML */

      const escapeHTML = (value) => {

        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      };


      /* GET HOST */

      const getHost = (url) => {

        try {

          return new URL(url).hostname;

        } catch {

          return 'example.com';

        }

      };


      /* PREVIEW */

      const updatePreview = () => {

        const title =
          pageTitle.value.trim();

        const description =
          pageDescription.value.trim();

        const url =
          pageUrl.value.trim();

        const image =
          imageUrl.value.trim();

        const site =
          siteName.value.trim();


        previewTitle.textContent =
          title || 'عنوان الصفحة';

        previewDescription.textContent =
          description ||
          'وصف الصفحة سيظهر هنا...';

        previewSite.textContent =
          site ||
          getHost(url);


        if (image) {

          previewImage.innerHTML =
            `<img src="${escapeHTML(image)}" alt="Open Graph preview">`;

        } else {

          previewImage.innerHTML =
            '<i class="fas fa-image"></i>';

        }

      };


      /* GENERATE */

      const generateOpenGraph = () => {

        hideStatus();

        const title =
          pageTitle.value.trim();

        const description =
          pageDescription.value.trim();

        const url =
          pageUrl.value.trim();

        const image =
          imageUrl.value.trim();

        const site =
          siteName.value.trim();

        const selectedLocale =
          locale.value;

        const selectedType =
          type.value;


        if (!title) {

          showStatus(
            'أدخل عنوان الصفحة أولاً.',
            true
          );

          pageTitle.focus();

          return;

        }


        if (!url) {

          showStatus(
            'أدخل رابط الصفحة أولاً.',
            true
          );

          pageUrl.focus();

          return;

        }


        try {

          new URL(url);

        } catch {

          showStatus(
            'رابط الصفحة غير صالح.',
            true
          );

          pageUrl.focus();

          return;

        }


        let code = '';

        code +=
          '<meta property="og:title" content="' +
          escapeHTML(title) +
          '">\\n';

        if (description) {

          code +=
            '<meta property="og:description" content="' +
            escapeHTML(description) +
            '">\\n';

        }

        code +=
          '<meta property="og:url" content="' +
          escapeHTML(url) +
          '">\\n';

        code +=
          '<meta property="og:type" content="' +
          escapeHTML(selectedType) +
          '">\\n';

        code +=
          '<meta property="og:locale" content="' +
          escapeHTML(selectedLocale) +
          '">\\n';

        if (site) {

          code +=
            '<meta property="og:site_name" content="' +
            escapeHTML(site) +
            '">\\n';

        }

        if (image) {

          code +=
            '<meta property="og:image" content="' +
            escapeHTML(image) +
            '">\\n';

        }


        output.value =
          code.replace(/\\n/g, '\n');


        codeStatus.textContent =
          'تم الإنشاء';

        updatePreview();


        showStatus(
          'تم إنشاء وسوم Open Graph بنجاح.'
        );

      };


      /* COPY */

      const copyOutput = async () => {

        const value =
          output.value;

        if (!value) {

          showStatus(
            'أنشئ كود Open Graph أولاً.',
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );

        } catch {

          output.select();

          document.execCommand('copy');

        }


        showStatus(
          'تم نسخ كود Open Graph بنجاح.'
        );


        const original =
          copyBtn.innerHTML;

        copyBtn.innerHTML =
          '<i class="fas fa-check"></i> تم النسخ';


        setTimeout(() => {

          copyBtn.innerHTML =
            original;

        }, 1800);

      };


      /* CLEAR */

      const clearAll = () => {

        pageTitle.value = '';
        pageDescription.value = '';
        pageUrl.value = '';
        imageUrl.value = '';
        siteName.value = '';

        locale.value = 'ar_AR';
        type.value = 'website';

        output.value = '';

        codeStatus.textContent =
          'جاهز';

        previewImage.innerHTML =
          '<i class="fas fa-image"></i>';

        previewTitle.textContent =
          'عنوان الصفحة';

        previewDescription.textContent =
          'وصف الصفحة سيظهر هنا...';

        previewSite.textContent =
          'example.com';

        hideStatus();

        pageTitle.focus();

      };


      /* EVENTS */

      generateBtn.addEventListener(
        'click',
        generateOpenGraph
      );


      copyBtn.addEventListener(
        'click',
        copyOutput
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      pageTitle.addEventListener(
        'input',
        updatePreview
      );


      pageDescription.addEventListener(
        'input',
        updatePreview
      );


      pageUrl.addEventListener(
        'input',
        updatePreview
      );


      imageUrl.addEventListener(
        'input',
        updatePreview
      );


      siteName.addEventListener(
        'input',
        updatePreview
      );


      /* INITIAL */

      updatePreview();

    })();
  </script>

</body>
</html>
