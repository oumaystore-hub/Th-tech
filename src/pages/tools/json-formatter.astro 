---
import ToolLayout from '../../layouts/ToolLayout.astro';

// SEO Data
const toolData = {
  title: "JSON Formatter Online | Format & Minify JSON - Th.Tech",
  description: "أداة تنسيق JSON مجانية عبر الإنترنت. قم بتنسيق (Beautify)، تصغير (Minify)، والتحقق من صحة بيانات JSON بسهولة وسرعة.",
  toolName: "JSON Formatter",
  canonical: "/tools/json-formatter/"
};
---

<ToolLayout 
  title={toolData.title} 
  description={toolData.description}
  toolName={toolData.toolName}
>

  <div class="tool-container">
    <!-- Tool Header -->
    <header class="tool-header">
      <div class="icon-wrapper">
        <i class="fas fa-code"></i>
      </div>
      <div class="titles">
        <h1>أداة تنسيق JSON</h1>
        <p>قم بتنسيق، تصغير، والتحقق من كود JSON الخاص بك.</p>
      </div>
    </header>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="actions">
        <button onclick="formatJSON()" class="btn btn-primary" title="تنسيق الكود">
          <i class="fas fa-magic"></i> تنسيق
        </button>
        <button onclick="minifyJSON()" class="btn btn-secondary" title="تصغير الكود">
          <i class="fas fa-compress-arrows-alt"></i> Minify
        </button>
        <button onclick="validateJSON()" class="btn btn-outline" title="التحقق من الصحة">
          <i class="fas fa-check-circle"></i> تحقق
        </button>
      </div>
      <div class="utilities">
        <button onclick="copyToClipboard()" class="btn-icon" title="نسخ">
          <i class="far fa-copy"></i>
        </button>
        <button onclick="downloadJSON()" class="btn-icon" title="تحميل">
          <i class="fas fa-download"></i>
        </button>
        <button onclick="clearEditor()" class="btn-icon btn-danger" title="مسح">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </div>

    <!-- Editor Area -->
    <div class="editor-wrapper">
      <div class="editor-stats" id="editorStats">
        <span id="charCount">0 Char</span> | <span id="lineCount">0 Line</span>
      </div>
      <textarea 
        id="jsonInput" 
        placeholder='{"key": "value"}' 
        dir="ltr"
        spellcheck="false"
      ></textarea>
    </div>

    <!-- Error Message Area -->
    <div id="errorBox" class="error-box hidden">
      <i class="fas fa-exclamation-circle"></i>
      <div>
        <strong>خطأ في الصيغة:</strong>
        <span id="errorMessage">JSON غير صحيح</span>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast">تم النسخ بنجاح!</div>

</ToolLayout>

<style>
  /* Tool Specific Styles */
  .tool-container {
    max-width: 1000px;
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  /* Header */
  .tool-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .icon-wrapper {
    width: 60px;
    height: 60px;
    background: var(--primary-light, rgba(37, 99, 235, 0.1));
    color: var(--primary);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .titles h1 {
    font-size: 1.8rem;
    margin-bottom: 0.3rem;
    line-height: 1.2;
  }

  .titles p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--card-bg);
    padding: 1rem;
    border-radius: 12px 12px 0 0;
    border: 1px solid var(--border);
    border-bottom: none;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .utilities {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  /* Buttons */
  .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-family: 'Cairo', sans-serif;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    transition: all 0.2s;
    border: none;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }
  .btn-primary:hover { filter: brightness(1.1); }

  .btn-secondary {
    background: var(--bg-secondary, #f1f5f9);
    color: var(--text);
  }
  .btn-secondary:hover { background: #e2e8f0; }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .btn-outline:hover { border-color: var(--primary); color: var(--primary); }

  .btn-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .btn-icon:hover { color: var(--primary); border-color: var(--primary); }
  .btn-danger:hover { color: var(--danger, #ef4444); border-color: var(--danger); }

  /* Editor */
  .editor-wrapper {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    background: var(--editor-bg, #f8fafc);
    min-height: 400px;
  }
  
  html.dark-mode .editor-wrapper {
    background: #0f172a;
    border-color: #334155;
  }

  .editor-stats {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: rgba(0,0,0,0.02);
    font-family: 'Fira Code', monospace;
  }

  #jsonInput {
    width: 100%;
    height: 100%;
    min-height: 350px;
    padding: 1rem;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    color: var(--text);
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.6;
    direction: ltr; /* Code is always LTR */
    box-sizing: border-box;
  }

  /* Error Box */
  .error-box {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--danger, #ef4444);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    animation: fadeIn 0.3s ease;
  }
  .error-box.hidden { display: none; }
  
  .error-box strong { display: block; margin-bottom: 0.2rem; }

  /* Toast */
  .toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--primary);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    z-index: 100;
  }
  .toast.show {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .tool-header { flex-direction: column; text-align: center; }
    .toolbar { flex-direction: column; align-items: stretch; }
    .actions { justify-content: center; }
    .utilities { justify-content: center; }
    .btn { flex: 1; justify-content: center; }
  }
</style>

<script is:inline>
  // Logic
  const textarea = document.getElementById('jsonInput');
  const errorBox = document.getElementById('errorBox');
  const errorMessage = document.getElementById('errorMessage');
  const charCount = document.getElementById('charCount');
  const lineCount = document.getElementById('lineCount');
  const toast = document.getElementById('toast');

  // Live Stats Update
  textarea.addEventListener('input', updateStats);

  function updateStats() {
    const text = textarea.value;
    charCount.innerText = `${text.length} Char`;
    lineCount.innerText = `${text.split('\n').length} Line`;
    hideError();
  }

  function formatJSON() {
    try {
      const text = textarea.value;
      if (!text.trim()) return;
      const parsed = JSON.parse(text);
      textarea.value = JSON.stringify(parsed, null, 2);
      updateStats();
    } catch (e) {
      showError(e.message);
    }
  }

  function minifyJSON() {
    try {
      const text = textarea.value;
      if (!text.trim()) return;
      const parsed = JSON.parse(text);
      textarea.value = JSON.stringify(parsed);
      updateStats();
    } catch (e) {
      showError(e.message);
    }
  }

  function validateJSON() {
    const text = textarea.value;
    if (!text.trim()) return;
    try {
      JSON.parse(text);
      // If no error, show a temporary success state or just hide error
      hideError();
      showToast('✅ JSON صحيح وصالح!');
    } catch (e) {
      showError(e.message);
    }
  }

  function showError(msg) {
    errorMessage.innerText = msg;
    errorBox.classList.remove('hidden');
  }

  function hideError() {
    errorBox.classList.add('hidden');
  }

  function copyToClipboard() {
    navigator.clipboard.writeText(textarea.value).then(() => {
      showToast('تم نسخ الكود إلى الحافظة');
    });
  }

  function clearEditor() {
    textarea.value = '';
    updateStats();
  }

  function downloadJSON() {
    if (!textarea.value.trim()) return;
    const blob = new Blob([textarea.value], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'data.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('تم تحميل الملف');
  }

  function showToast(msg) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2000);
  }

  // Initial stats
  updateStats();
</script>
