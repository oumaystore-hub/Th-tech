---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "URL Decoder - فك ترميز URL أونلاين مجاناً | Th.Tech";

const description =
  "أداة URL Decoder مجانية لفك ترميز الروابط والنصوص المشفرة باستخدام URL Encoding مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو URL Decoder؟",
    a: "URL Decoder هو أداة لفك ترميز النصوص والروابط التي تم تحويلها باستخدام URL Encoding وإعادتها إلى شكلها الأصلي."
  },
  {
    q: "هل يمكن فك ترميز الروابط العربية؟",
    a: "نعم، تدعم الأداة النصوص العربية وأحرف Unicode باستخدام UTF-8."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا، تتم عملية فك الترميز بالكامل داخل المتصفح ولا يتم إرسال النص إلى أي خادم."
  },
  {
    q: "هل يمكن استخدام الأداة لفك ترميز Query Parameters؟",
    a: "نعم، يمكنك إدخال قيمة مشفرة من URL Query Parameters وستقوم الأداة بإعادتها إلى النص المقروء."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>URL Decoder</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-link-slash"></i>
            <span>URL</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>URL Decoder</h1>

            <p>
              فك ترميز الروابط والنصوص المشفرة وإعادتها إلى
              شكلها الأصلي بسهولة وسرعة.
            </p>

            <div class="tags">
              <span>URL Decode</span>
              <span>UTF-8</span>
              <span>Web</span>
              <span>Local</span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="decoder-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-link-slash"></i>
              URL Decoder
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button id="decodeBtn" class="btn btn-primary">
              <i class="fa-solid fa-link-slash"></i>
              فك ترميز URL
            </button>

          </div>


          <!-- WORKSPACE -->
          <div class="workspace">

            <!-- INPUT -->
            <div class="editor-panel">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-link"></i>
                  النص المرمّز
                </div>

                <span id="inputCount">0 حرف</span>

              </div>

              <div class="editor">

                <div
                  class="line-numbers"
                  id="inputLines"
                >1</div>

                <textarea
                  id="inputText"
                  spellcheck="false"
                  placeholder="أدخل الرابط أو النص المرمّز..."
                ></textarea>

              </div>

            </div>


            <!-- ARROW -->
            <div class="convert-arrow">
              <i class="fa-solid fa-arrow-down"></i>
            </div>


            <!-- OUTPUT -->
            <div class="editor-panel output-panel">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-file-lines"></i>
                  النص الأصلي
                </div>

                <span id="outputCount">0 حرف</span>

              </div>

              <div class="editor">

                <div
                  class="line-numbers"
                  id="outputLines"
                >1</div>

                <textarea
                  id="outputText"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر النتيجة هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- RESULT -->
          <div
            class="result-box"
            id="resultBox"
          >

            <div
              class="result-icon"
              id="resultIcon"
            >
              <i class="fa-solid fa-link-slash"></i>
            </div>

            <div>

              <strong id="resultTitle">
                جاهز لفك الترميز
              </strong>

              <p id="resultMessage">
                أدخل نصاً مشفراً ثم اضغط على زر فك ترميز URL.
              </p>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-link"></i>
              </div>

              <div>
                <span>النص المرمّز</span>
                <strong id="statInput">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <span>النص الأصلي</span>
                <strong id="statOutput">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-percent"></i>
              </div>

              <div>
                <span>نسبة الانخفاض</span>
                <strong id="statDecrease">0%</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>URL DECODING</span>

          <h2>
            ما هو URL Decoder؟
          </h2>

          <p>
            أداة تساعدك على تحويل النصوص المشفرة باستخدام
            URL Encoding إلى نصوص مقروءة يمكن استخدامها مرة أخرى.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-link-slash"></i>
            </div>

            <h3>
              فك ترميز الروابط
            </h3>

            <p>
              حوّل الرموز مثل %20 و%2F و%3F إلى الأحرف
              الأصلية التي تمثلها.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-language"></i>
            </div>

            <h3>
              دعم UTF-8
            </h3>

            <p>
              يدعم النصوص العربية واللغات المختلفة وأحرف Unicode.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>
              معالجة محلية
            </h3>

            <p>
              تتم عملية فك الترميز داخل المتصفح دون إرسال
              بياناتك إلى خادم خارجي.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام URL Decoder
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل النص المشفر
              </h3>

              <p>
                الصق الرابط أو النص الذي يحتوي على URL Encoding.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                اضغط فك الترميز
              </h3>

              <p>
                ستقوم الأداة بتحويل الرموز المشفرة إلى أحرفها الأصلية.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                انسخ النتيجة
              </h3>

              <p>
                اضغط على نسخ لاستخدام النص الناتج في مشروعك.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  



<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/url-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Base64 Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-entity-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Html Entity Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/jwt-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Jwt Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Base64 Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-entity-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Html Entity Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const input =
        document.getElementById("inputText");

      const output =
        document.getElementById("outputText");

      const decodeBtn =
        document.getElementById("decodeBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");


      const inputCount =
        document.getElementById("inputCount");

      const outputCount =
        document.getElementById("outputCount");


      const inputLines =
        document.getElementById("inputLines");

      const outputLines =
        document.getElementById("outputLines");


      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");


      const statInput =
        document.getElementById("statInput");

      const statOutput =
        document.getElementById("statOutput");

      const statDecrease =
        document.getElementById("statDecrease");

      const statStatus =
        document.getElementById("statStatus");


      function updateEditor(
        textarea,
        counter,
        lines
      ) {

        const value = textarea.value;

        const count = value.length;

        counter.textContent =
          `${count.toLocaleString()} حرف`;


        const lineCount =
          Math.max(
            1,
            value.split("\n").length
          );


        lines.textContent =
          Array.from(
            {
              length: lineCount
            },
            (_, index) => index + 1
          ).join("\n");
      }


      function updateStats(decoded = "") {

        const encodedLength =
          input.value.length;

        const decodedLength =
          decoded.length;


        statInput.textContent =
          encodedLength.toLocaleString();

        statOutput.textContent =
          decodedLength.toLocaleString();


        if (encodedLength > 0) {

          const decrease =
            ((encodedLength - decodedLength) /
              encodedLength) *
            100;


          statDecrease.textContent =
            `${decrease >= 0 ? "" : "+"}${decrease.toFixed(1)}%`;

        } else {

          statDecrease.textContent =
            "0%";

        }
      }


      function setSuccess(message) {

        resultBox.classList.remove("error");

        resultBox.classList.add("success");


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';


        resultTitle.textContent =
          "تم فك الترميز بنجاح";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "تم";
      }


      function setError(message) {

        resultBox.classList.remove("success");

        resultBox.classList.add("error");


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-exclamation"></i>';


        resultTitle.textContent =
          "تعذر فك الترميز";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "خطأ";
      }


      function decodeURL() {

        const value =
          input.value;


        if (!value.trim()) {

          output.value = "";

          updateEditor(
            output,
            outputCount,
            outputLines
          );

          updateStats("");

          setError(
            "أدخل نصاً أو رابطاً مشفراً أولاً."
          );

          return;
        }


        try {

          const start =
            performance.now();


          const decoded =
            decodeURIComponent(value);


          const end =
            performance.now();


          output.value =
            decoded;


          updateEditor(
            output,
            outputCount,
            outputLines
          );


          updateStats(decoded);


          setSuccess(
            `تم فك ترميز ${value.length.toLocaleString()} حرف بنجاح خلال ${(end - start).toFixed(2)} ms.`
          );

        } catch (error) {

          output.value = "";

          updateEditor(
            output,
            outputCount,
            outputLines
          );

          updateStats("");

          setError(
            "النص يحتوي على ترميز URL غير صالح أو رمز % غير مكتمل."
          );
        }
      }


      function clearAll() {

        input.value = "";

        output.value = "";


        updateEditor(
          input,
          inputCount,
          inputLines
        );


        updateEditor(
          output,
          outputCount,
          outputLines
        );


        updateStats("");


        resultBox.classList.remove(
          "success",
          "error"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-link-slash"></i>';


        resultTitle.textContent =
          "جاهز لفك الترميز";


        resultMessage.textContent =
          "أدخل نصاً مشفراً ثم اضغط على زر فك ترميز URL.";


        statStatus.textContent =
          "جاهز";


        input.focus();
      }


      function loadExample() {

        input.value =
          "https%3A%2F%2Fth.tech%2Fsearch%3Fq%3D%D8%A3%D8%AF%D9%88%D8%A7%D8%AA%20%D8%AA%D9%82%D9%86%D9%8A%D8%A9%26lang%3Dar";


        updateEditor(
          input,
          inputCount,
          inputLines
        );


        decodeURL();
      }


      async function copyResult() {

        if (!output.value) {

          setError(
            "لا توجد نتيجة لنسخها."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            output.value
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);

        } catch {

          output.select();

          document.execCommand("copy");

          setSuccess(
            "تم نسخ النتيجة إلى الحافظة."
          );
        }
      }


      input.addEventListener(
        "input",
        () => {

          updateEditor(
            input,
            inputCount,
            inputLines
          );


          if (!input.value) {

            output.value = "";


            updateEditor(
              output,
              outputCount,
              outputLines
            );


            updateStats("");
          }

        }
      );


      input.addEventListener(
        "scroll",
        () => {

          inputLines.scrollTop =
            input.scrollTop;

        }
      );


      output.addEventListener(
        "scroll",
        () => {

          outputLines.scrollTop =
            output.scrollTop;

        }
      );


      decodeBtn.addEventListener(
        "click",
        decodeURL
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyResult
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Tab") {

            event.preventDefault();


            const start =
              input.selectionStart;

            const end =
              input.selectionEnd;


            input.value =
              input.value.substring(
                0,
                start
              ) +
              "  " +
              input.value.substring(
                end
              );


            input.selectionStart =
              input.selectionEnd =
                start + 2;


            updateEditor(
              input,
              inputCount,
              inputLines
            );
          }


          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            decodeURL();
          }

        }
      );


      updateEditor(
        input,
        inputCount,
        inputLines
      );


      updateEditor(
        output,
        outputCount,
        outputLines
      );

    })();
  </script>


