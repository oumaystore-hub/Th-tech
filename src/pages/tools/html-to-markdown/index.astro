---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "HTML to Markdown - تحويل HTML إلى Markdown أونلاين | Th.Tech";
const description =
  "أداة مجانية لتحويل كود HTML إلى Markdown بسرعة، مع معاينة النتيجة ونسخها مباشرة من المتصفح.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>HTML to Markdown</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-right-left"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              HTML Tools
            </span>

            <h1>
              HTML <span>to Markdown</span>
            </h1>

            <p>
              حوّل كود HTML إلى Markdown بسهولة وسرعة،
              مع إمكانية تعديل النتيجة ونسخها مباشرة.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-code"></i>
              <span>HTML to Markdown</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Editors -->

          <div class="editors">

            <!-- HTML Input -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  HTML الإدخال
                </div>

                <span id="inputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="input"
                  spellcheck="false"
                  placeholder='<h1>Th.Tech</h1>

<p>منصة تقنية للمطورين.</p>

<a href="https://example.com">
  زيارة الموقع
</a>

<ul>
  <li>برمجة</li>
  <li>أدوات</li>
</ul>'
                ></textarea>

              </div>

            </div>


            <!-- Markdown Output -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fab fa-markdown"></i>
                  Markdown الناتج
                </div>

                <span id="outputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="output"
                  spellcheck="false"
                  placeholder="ستظهر Markdown هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- Main Action -->

          <div class="main-actions">

            <button
              id="convertBtn"
              class="convert-btn"
              type="button"
            >
              <i class="fas fa-arrow-right-arrow-left"></i>
              تحويل إلى Markdown
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- Status -->

          <div id="status" class="status hidden">

            <i id="statusIcon" class="fas fa-check-circle"></i>

            <span id="statusText"></span>

          </div>


          <!-- Statistics -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-file-code"></i>
              </div>

              <div>
                <span class="stat-value" id="originalSize">
                  0 B
                </span>

                <span class="stat-label">
                  حجم HTML
                </span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fab fa-markdown"></i>
              </div>

              <div>
                <span class="stat-value" id="markdownSize">
                  0 B
                </span>

                <span class="stat-label">
                  حجم Markdown
                </span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">
                <i class="fas fa-check"></i>
              </div>

              <div>
                <span class="stat-value" id="elementsCount">
                  0
                </span>

                <span class="stat-label">
                  العناصر المحوّلة
                </span>
              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>
                تحويل سريع
              </h3>

              <p>
                يتم تحويل HTML إلى Markdown مباشرة داخل المتصفح
                بدون الحاجة إلى رفع ملفاتك إلى خادم خارجي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>
                خصوصية أفضل
              </h3>

              <p>
                الكود تتم معالجته محلياً داخل متصفحك
                ولا يحتاج إلى إرساله إلى خدمة خارجية.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-file-lines"></i>
            </div>

            <div>

              <h3>
                Markdown نظيف
              </h3>

              <p>
                يتم تحويل العناوين والروابط والقوائم والصور
                والنصوص والعناصر الأساسية إلى Markdown.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>HTML to Markdown؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-paste"></i>
              </div>

              <h3>
                ألصق HTML
              </h3>

              <p>
                ضع كود HTML الذي تريد تحويله في مربع الإدخال.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-arrows-rotate"></i>
              </div>

              <h3>
                حوّل الكود
              </h3>

              <p>
                اضغط على زر تحويل إلى Markdown لمعالجة الكود.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>
                انسخ النتيجة
              </h3>

              <p>
                انسخ Markdown الناتج واستخدمه في مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>HTML to Markdown</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هي أداة HTML to Markdown؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                أداة تقوم بتحويل كود HTML إلى صيغة Markdown
                سهلة القراءة والاستخدام في ملفات Markdown.
              </p>

            </details>


            <details>

              <summary>
                هل يتم إرسال HTML إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم عملية التحويل داخل المتصفح باستخدام JavaScript.
              </p>

            </details>


            <details>

              <summary>
                ما العناصر التي يمكن تحويلها؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                تدعم الأداة العناوين والفقرات والروابط والصور
                والقوائم والنص العريض والمائل والكود
                وبعض العناصر الشائعة الأخرى.
              </p>

            </details>


            <details>

              <summary>
                هل يمكن تعديل Markdown بعد التحويل؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يمكنك تعديل النص الناتج مباشرة داخل مربع
                Markdown قبل نسخه.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #0891b2;
      --primary-hover: #0e7490;
      --cyan: #06b6d4;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #06b6d4;
      --primary-hover: #0891b2;
      --cyan: #22d3ee;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    textarea {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(8, 145, 178, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);

      background: rgba(8, 145, 178, .10);
      border: 1px solid rgba(8, 145, 178, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(8, 145, 178, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--primary);
      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;
      margin: 0;
      color: var(--muted);
      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 17px 20px;

      border-bottom: 1px solid var(--border);
      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;

      min-height: 38px;
      padding: 7px 13px;

      border-radius: 10px;
      border: 1px solid var(--border);

      background: var(--card);
      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(8, 145, 178, .35);
      color: var(--primary);
      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* ================= EDITORS ================= */

    .editors {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      padding: 20px;
    }


    .editor-panel {
      overflow: hidden;

      border-radius: 16px;
      border: 1px solid var(--border);

      background: var(--card2);
    }


    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px 15px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;
      font-weight: 700;
    }


    .panel-header > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .panel-header i {
      color: var(--primary);
    }


    .editor-wrapper {
      height: 350px;
    }


    textarea {
      width: 100%;
      height: 100%;
      display: block;

      resize: none;
      outline: none;
      border: 0;

      padding: 18px;

      background: transparent;
      color: var(--text);

      direction: ltr;
      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .84rem;
      line-height: 1.8;
    }


    textarea::placeholder {
      color: var(--muted);
      opacity: .65;
    }


    #output {
      color: var(--primary);
    }


    /* ================= ACTION ================= */

    .main-actions {
      display: flex;
      justify-content: center;
      padding: 0 20px 20px;
    }


    .convert-btn {
      min-width: 250px;
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;

      border: 0;
      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #06b6d4,
          #0891b2
        );

      color: white;

      font-family: inherit;
      font-size: .9rem;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(8, 145, 178, .22);

      transition: .25s ease;
    }


    .convert-btn:hover {
      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(8, 145, 178, .30);
    }


    /* ================= STATUS ================= */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;

      margin: 0 20px 20px;
      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);
      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);
      border-color: rgba(220, 38, 38, .15);
      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* ================= STATISTICS ================= */

    .statistics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      background: var(--border);

      border-top: 1px solid var(--border);
    }


    .stat {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;

      padding: 22px 15px;

      background: var(--card);
    }


    .stat-icon {
      width: 43px;
      height: 43px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background: rgba(8, 145, 178, .09);
      color: var(--primary);
    }


    .stat-icon.success {
      color: var(--green);
      background: rgba(34, 197, 94, .09);
    }


    .stat-value {
      display: block;

      color: var(--text);

      font-size: 1rem;
      font-weight: 800;

      direction: ltr;
      text-align: right;
    }


    .stat-label {
      display: block;

      color: var(--muted);

      font-size: .68rem;
    }


    /* ================= INFO ================= */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;
      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);
      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(8, 145, 178, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);
      background: rgba(8, 145, 178, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;
      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;
      line-height: 1.8;
    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* ================= STEPS ================= */

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }


    .step {
      position: relative;
      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);
      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);
      opacity: .08;

      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);
      background: rgba(8, 145, 178, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;
      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;
      line-height: 1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;
      margin: auto;

      display: grid;
      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);
      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;

      padding: 19px 0;

      cursor: pointer;
      list-style: none;

      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;
      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;
      line-height: 1.9;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .editors {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }


      .statistics {
        grid-template-columns: 1fr;
      }


      .stat {
        justify-content: flex-start;
        padding-right: 25px;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;
        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;
        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .editors {
        padding: 12px;
        gap: 12px;
      }


      .editor-wrapper {
        height: 280px;
      }


      textarea {
        padding: 14px;
        font-size: .76rem;
      }


      .convert-btn {
        width: 100%;
        min-width: 0;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }

      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {
            applyTheme(
              theme === 'dark'
            );
          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      window.addEventListener(
        'storage',
        (event) => {

          if (event.key === 'theme') {

            applyTheme(
              event.newValue === 'dark'
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const input =
        document.getElementById('input');

      const output =
        document.getElementById('output');

      const convertBtn =
        document.getElementById('convertBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const inputSize =
        document.getElementById('inputSize');

      const outputSize =
        document.getElementById('outputSize');

      const originalSize =
        document.getElementById('originalSize');

      const markdownSize =
        document.getElementById('markdownSize');

      const elementsCount =
        document.getElementById('elementsCount');


      /* ================= SIZE ================= */

      const getBytes = (text) => {
        return new Blob([text]).size;
      };


      const formatBytes = (bytes) => {

        if (!bytes) {
          return '0 B';
        }

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {

          return `${(
            bytes / 1024
          ).toFixed(2)} KB`;

        }

        return `${(
          bytes / (1024 * 1024)
        ).toFixed(2)} MB`;

      };


      const updateSizes = () => {

        const inputBytes =
          getBytes(input.value);

        const outputBytes =
          getBytes(output.value);

        inputSize.textContent =
          formatBytes(inputBytes);

        outputSize.textContent =
          formatBytes(outputBytes);

        originalSize.textContent =
          formatBytes(inputBytes);

        markdownSize.textContent =
          formatBytes(outputBytes);

      };


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove(
          'hidden'
        );

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {
        status.classList.add('hidden');
      };


      /* ================= HELPERS ================= */

      const escapeMarkdown = (text) => {

        return text
          .replace(/\r?\n/g, ' ')
          .replace(/[ \t]+/g, ' ')
          .trim();

      };


      const getText = (element) => {

        return escapeMarkdown(
          element.textContent || ''
        );

      };


      const convertInline = (node) => {

        if (node.nodeType === Node.TEXT_NODE) {
          return node.textContent
            .replace(/\s+/g, ' ');
        }


        if (
          node.nodeType !== Node.ELEMENT_NODE
        ) {
          return '';
        }


        const tag =
          node.tagName.toLowerCase();


        const content =
          Array.from(node.childNodes)
            .map(convertInline)
            .join('')
            .replace(/\s+/g, ' ');


        switch (tag) {

          case 'strong':
          case 'b':
            return `**${content.trim()}**`;

          case 'em':
          case 'i':
            return `*${content.trim()}*`;

          case 'del':
          case 's':
          case 'strike':
            return `~~${content.trim()}~~`;

          case 'code':
            return `\`${content.trim()}\``;

          case 'br':
            return '  \n';

          case 'a': {

            const href =
              node.getAttribute('href') || '';

            const title =
              node.getAttribute('title');

            const text =
              content.trim() || href;

            if (!href) {
              return text;
            }

            return title
              ? `[${text}](${href} "${title}")`
              : `[${text}](${href})`;

          }

          case 'img': {

            const src =
              node.getAttribute('src') || '';

            const alt =
              node.getAttribute('alt') || '';

            const title =
              node.getAttribute('title');

            if (!src) {
              return '';
            }

            return title
              ? `![${alt}](${src} "${title}")`
              : `![${alt}](${src})`;

          }

          default:
            return content;

        }

      };


      /* ================= CONVERTER ================= */

      const nodeToMarkdown = (
        node,
        depth = 0
      ) => {

        if (node.nodeType === Node.TEXT_NODE) {
          return node.textContent
            .replace(/\s+/g, ' ');
        }


        if (
          node.nodeType !== Node.ELEMENT_NODE
        ) {
          return '';
        }


        const tag =
          node.tagName.toLowerCase();


        const children =
          Array.from(node.childNodes);


        const inlineContent = () =>
          children
            .map(convertInline)
            .join('')
            .replace(/[ \t]+/g, ' ')
            .trim();


        switch (tag) {

          case 'h1':
            return `# ${inlineContent()}\n\n`;

          case 'h2':
            return `## ${inlineContent()}\n\n`;

          case 'h3':
            return `### ${inlineContent()}\n\n`;

          case 'h4':
            return `#### ${inlineContent()}\n\n`;

          case 'h5':
            return `##### ${inlineContent()}\n\n`;

          case 'h6':
            return `###### ${inlineContent()}\n\n`;


          case 'p': {

            const text =
              inlineContent();

            return text
              ? `${text}\n\n`
              : '';

          }


          case 'blockquote': {

            const text =
              Array.from(node.childNodes)
                .map(child =>
                  child.nodeType === Node.ELEMENT_NODE
                    ? nodeToMarkdown(child, depth)
                    : child.textContent
                )
                .join('')
                .trim();

            if (!text) {
              return '';
            }

            return text
              .split(/\n+/)
              .map(line => `> ${line.trim()}`)
              .join('\n') +
              '\n\n';

          }


          case 'pre': {

            const code =
              node.textContent || '';

            const className =
              node.querySelector('code')
                ?.getAttribute('class') || '';

            let language = '';

            const match =
              className.match(
                /language-([a-zA-Z0-9_-]+)/
              );

            if (match) {
              language = match[1];
            }

            return (
              '```' +
              language +
              '\n' +
              code.trim() +
              '\n```\n\n'
            );

          }


          case 'ul': {

            const items =
              Array.from(
                node.children
              ).filter(
                child =>
                  child.tagName.toLowerCase() === 'li'
              );

            return items
              .map(
                item =>
                  `- ${inlineContentFromElement(item)}`
              )
              .join('\n') +
              '\n\n';

          }


          case 'ol': {

            const items =
              Array.from(
                node.children
              ).filter(
                child =>
                  child.tagName.toLowerCase() === 'li'
              );

            return items
              .map(
                (item, index) =>
                  `${index + 1}. ${inlineContentFromElement(item)}`
              )
              .join('\n') +
              '\n\n';

          }


          case 'li':
            return inlineContent() + '\n';


          case 'hr':
            return '---\n\n';


          case 'table':
            return convertTable(node);


          case 'div':
          case 'section':
          case 'article':
          case 'main':
          case 'header':
          case 'footer':
          case 'aside':
          case 'nav': {

            return children
              .map(
                child =>
                  child.nodeType === Node.ELEMENT_NODE
                    ? nodeToMarkdown(child, depth)
                    : child.textContent
              )
              .join('');

          }


          case 'a':
          case 'strong':
          case 'b':
          case 'em':
          case 'i':
          case 'code':
          case 'del':
          case 's':
          case 'strike':
          case 'span':
          case 'small':
          case 'mark':
          case 'label':
            return convertInline(node);


          case 'img':
            return convertInline(node) + '\n\n';


          case 'br':
            return '  \n';


          default:

            return children
              .map(
                child =>
                  child.nodeType === Node.ELEMENT_NODE
                    ? nodeToMarkdown(child, depth)
                    : child.textContent
              )
              .join('');

        }

      };


      const inlineContentFromElement =
        (element) => {

          return Array.from(
            element.childNodes
          )
            .map(convertInline)
            .join('')
            .replace(/\s+/g, ' ')
            .trim();

        };


      const convertTable = (table) => {

        const rows =
          Array.from(
            table.querySelectorAll('tr')
          );

        if (!rows.length) {
          return '';
        }


        const matrix =
          rows.map(row =>
            Array.from(
              row.querySelectorAll('th, td')
            ).map(cell =>
              inlineContentFromElement(cell)
                .replace(/\|/g, '\\|')
            )
          );


        const columnCount =
          Math.max(
            ...matrix.map(row => row.length),
            0
          );


        if (!columnCount) {
          return '';
        }


        const header =
          matrix[0] || [];


        while (
          header.length < columnCount
        ) {
          header.push('');
        }


        const separator =
          Array(columnCount)
            .fill('---');


        const body =
          matrix
            .slice(1)
            .map(row => {

              while (
                row.length < columnCount
              ) {
                row.push('');
              }

              return row;

            });


        const lines = [];


        lines.push(
          `| ${header.join(' | ')} |`
        );

        lines.push(
          `| ${separator.join(' | ')} |`
        );


        body.forEach(row => {

          lines.push(
            `| ${row.join(' | ')} |`
          );

        });


        return (
          lines.join('\n') +
          '\n\n'
        );

      };


      /* ================= CONVERT ================= */

      const convertHTML = () => {

        hideStatus();

        const value =
          input.value.trim();


        if (!value) {

          output.value = '';

          elementsCount.textContent = '0';

          updateSizes();

          showStatus(
            'أدخل كود HTML أولاً.',
            true
          );

          return;

        }


        try {

          const parser =
            new DOMParser();

          const document =
            parser.parseFromString(
              value,
              'text/html'
            );


          const root =
            document.body;


          const result =
            Array.from(
              root.childNodes
            )
              .map(node => {

                if (
                  node.nodeType ===
                  Node.ELEMENT_NODE
                ) {
                  return nodeToMarkdown(node);
                }

                return node.textContent || '';

              })
              .join('');


          const markdown =
            result
              .replace(/\n{3,}/g, '\n\n')
              .replace(/[ \t]+\n/g, '\n')
              .trim();


          output.value =
            markdown;


          const count =
            root.querySelectorAll('*').length;


          elementsCount.textContent =
            String(count);


          updateSizes();


          showStatus(
            'تم تحويل HTML إلى Markdown بنجاح.'
          );

        } catch (error) {

          output.value = '';

          elementsCount.textContent = '0';

          updateSizes();

          showStatus(
            'حدث خطأ أثناء تحويل HTML.',
            true
          );

        }

      };


      /* ================= COPY ================= */

      const copyOutput = async () => {

        const value =
          output.value;


        if (!value) {

          showStatus(
            'لا توجد نتيجة لنسخها.',
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          showStatus(
            'تم نسخ Markdown بنجاح.'
          );


          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          output.select();

          document.execCommand('copy');

          showStatus(
            'تم نسخ النتيجة.'
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        input.value = '';
        output.value = '';

        elementsCount.textContent = '0';

        hideStatus();

        updateSizes();

        input.focus();

      };


      /* ================= EVENTS ================= */

      convertBtn.addEventListener(
        'click',
        convertHTML
      );


      copyBtn.addEventListener(
        'click',
        copyOutput
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      input.addEventListener(
        'input',
        () => {

          updateSizes();

          if (!input.value.trim()) {

            output.value = '';

            elementsCount.textContent =
              '0';

            updateSizes();

          }

        }
      );


      /* ================= KEYBOARD ================= */

      input.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            convertHTML();

          }

        }
      );


      /* ================= INITIAL ================= */

      updateSizes();

    })();
  </script>

