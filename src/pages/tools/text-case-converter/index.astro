---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Text Case Converter - تحويل حالة النص أونلاين مجاناً | Th.Tech';

const description =
  'أداة Text Case Converter مجانية لتحويل النص إلى UPPERCASE و lowercase و Title Case و Sentence Case وعكس حالة الأحرف بسرعة من المتصفح.';

const canonical =
  'https://oumaystore-hub.github.io' + base + '/tools/text-case-converter/';

const faqs = [
  [
    'ما هو Text Case Converter؟',
    'هي أداة لتحويل حالة الأحرف في النص بسرعة إلى أحرف كبيرة أو صغيرة أو Title Case أو Sentence Case وغيرها.'
  ],
  [
    'هل يتم إرسال النص إلى الخادم؟',
    'لا. تتم جميع عمليات تحويل النص داخل المتصفح مباشرة، ولا تحتاج إلى رفع النص إلى أي خادم.'
  ],
  [
    'ما الفرق بين UPPERCASE و lowercase؟',
    'UPPERCASE يحول جميع الأحرف الإنجليزية إلى أحرف كبيرة، بينما lowercase يحولها إلى أحرف صغيرة.'
  ],
  [
    'ما هو Title Case؟',
    'يقوم Title Case بجعل الحرف الأول من الكلمات الإنجليزية كبيراً، وهو مناسب للعناوين.'
  ],
  [
    'هل الأداة مجانية؟',
    'نعم، الأداة مجانية بالكامل ويمكن استخدامها مباشرة من المتصفح دون تسجيل.'
  ]
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07111f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');

          if (saved === 'dark') {
            document.documentElement.classList.add('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="tool-page">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container hero-content">
          <div class="breadcrumb">
            <a href={base + '/'}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={base + '/tools/'}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Text Case</span>
          </div>

          <div class="tool-icon">
            <i class="fa-solid fa-font"></i>
          </div>

          <div class="hero-badge">
            <span class="badge-dot"></span>
            أداة مجانية
          </div>

          <h1>Text Case Converter</h1>

          <p>
            حوّل حالة النص بسرعة إلى أحرف كبيرة أو صغيرة أو عناوين
            والمزيد، مباشرة من متصفحك.
          </p>

          <div class="hero-tags">
            <span><i class="fa-solid fa-arrow-up"></i> UPPERCASE</span>
            <span><i class="fa-solid fa-arrow-down"></i> lowercase</span>
            <span><i class="fa-solid fa-heading"></i> Title Case</span>
            <span><i class="fa-solid fa-lock"></i> محلي 100%</span>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="converter-card">

            <div class="card-top">
              <div>
                <span class="eyebrow">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  محرر النص
                </span>

                <h2>تحويل حالة النص</h2>

                <p>
                  أدخل النص ثم اختر العملية المناسبة لتحويله فوراً.
                </p>
              </div>

              <div class="local-status">
                <span class="status-dot"></span>
                يعمل محلياً
              </div>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
              <div class="main-actions">
                <button class="case-btn primary" id="upperBtn" type="button">
                  <i class="fa-solid fa-arrow-up"></i>
                  <span>UPPERCASE</span>
                </button>

                <button class="case-btn" id="lowerBtn" type="button">
                  <i class="fa-solid fa-arrow-down"></i>
                  <span>lowercase</span>
                </button>

                <button class="case-btn" id="titleBtn" type="button">
                  <i class="fa-solid fa-heading"></i>
                  <span>Title Case</span>
                </button>

                <button class="case-btn" id="sentenceBtn" type="button">
                  <i class="fa-solid fa-align-left"></i>
                  <span>Sentence case</span>
                </button>

                <button class="case-btn" id="invertBtn" type="button">
                  <i class="fa-solid fa-repeat"></i>
                  <span>Invert Case</span>
                </button>
              </div>

              <div class="utility-actions">
                <button class="utility-btn" id="copyBtn" type="button">
                  <i class="fa-regular fa-copy"></i>
                  <span>نسخ النتيجة</span>
                </button>

                <button class="utility-btn danger" id="clearBtn" type="button">
                  <i class="fa-solid fa-trash-can"></i>
                  <span>مسح</span>
                </button>
              </div>
            </div>

            <!-- EDITORS -->
            <div class="editors">

              <div class="editor-box">
                <div class="editor-head">
                  <div class="editor-title">
                    <span class="editor-number">01</span>
                    <div>
                      <strong>النص الأصلي</strong>
                      <small>Input</small>
                    </div>
                  </div>

                  <button class="small-btn" id="sampleBtn" type="button">
                    <i class="fa-solid fa-flask"></i>
                    مثال
                  </button>
                </div>

                <textarea
                  id="inputText"
                  dir="auto"
                  spellcheck="false"
                  placeholder="اكتب أو الصق النص هنا..."
                ></textarea>

                <div class="editor-footer">
                  <span id="inputStatus">
                    <i class="fa-solid fa-circle-info"></i>
                    ابدأ بكتابة النص
                  </span>

                  <span>
                    <b id="inputChars">0</b> حرف
                  </span>
                </div>
              </div>

              <div class="direction-arrow">
                <i class="fa-solid fa-arrow-left"></i>
              </div>

              <div class="editor-box output-box">
                <div class="editor-head">
                  <div class="editor-title">
                    <span class="editor-number output-number">02</span>
                    <div>
                      <strong>النتيجة</strong>
                      <small>Output</small>
                    </div>
                  </div>

                  <button class="small-btn" id="copySmallBtn" type="button">
                    <i class="fa-regular fa-copy"></i>
                    نسخ
                  </button>
                </div>

                <textarea
                  id="outputText"
                  dir="auto"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر النتيجة هنا..."
                ></textarea>

                <div class="editor-footer">
                  <span id="resultStatus">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    جاهز للتحويل
                  </span>

                  <span>
                    <b id="outputChars">0</b> حرف
                  </span>
                </div>
              </div>

            </div>

            <!-- SAMPLES -->
            <div class="samples">
              <span class="samples-title">
                <i class="fa-solid fa-lightbulb"></i>
                نص تجريبي
              </span>

              <button
                class="sample-chip"
                type="button"
                data-sample="welcome to th.tech — discover, learn and create."
              >
                Welcome to Th.Tech
              </button>

              <button
                class="sample-chip"
                type="button"
                data-sample="THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG."
              >
                Quick Brown Fox
              </button>

              <button
                class="sample-chip"
                type="button"
                data-sample="this is a simple example for text case conversion."
              >
                Example Text
              </button>
            </div>

            <!-- STATUS -->
            <div class="live-status" id="liveStatus">
              <div class="status-icon">
                <i class="fa-solid fa-check"></i>
              </div>

              <div>
                <strong>جاهز</strong>
                <span>أدخل النص واختر نوع التحويل.</span>
              </div>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-font"></i>
                </div>

                <div>
                  <span>الأحرف</span>
                  <strong id="statChars">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-align-left"></i>
                </div>

                <div>
                  <span>الكلمات</span>
                  <strong id="statWords">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-list-ol"></i>
                </div>

                <div>
                  <span>الأسطر</span>
                  <strong id="statLines">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-text-width"></i>
                </div>

                <div>
                  <span>بدون مسافات</span>
                  <strong id="statNoSpaces">0</strong>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- PRIVACY -->
      <section class="privacy-section">
        <div class="container">
          <div class="privacy-card">
            <div class="privacy-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
              <h3>خصوصيتك أولاً</h3>
              <p>
                جميع عمليات تحويل النص تتم داخل متصفحك. لا يتم رفع النص
                أو إرساله إلى خادم خارجي.
              </p>
            </div>

            <div class="privacy-checks">
              <span>
                <i class="fa-solid fa-check"></i>
                معالجة محلية
              </span>

              <span>
                <i class="fa-solid fa-check"></i>
                بدون تسجيل
              </span>

              <span>
                <i class="fa-solid fa-check"></i>
                مجانية
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">TEXT CASE</span>
            <h2>أدوات تحويل النص</h2>
            <p>
              مجموعة من الخيارات لتحويل النص بالشكل الذي تحتاجه.
            </p>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-arrow-up"></i>
              </div>

              <h3>UPPERCASE</h3>

              <p>
                يحول جميع الأحرف الإنجليزية إلى أحرف كبيرة.
              </p>

              <code>hello world → HELLO WORLD</code>
            </article>

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-arrow-down"></i>
              </div>

              <h3>lowercase</h3>

              <p>
                يحول جميع الأحرف الإنجليزية إلى أحرف صغيرة.
              </p>

              <code>HELLO WORLD → hello world</code>
            </article>

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-heading"></i>
              </div>

              <h3>Title Case</h3>

              <p>
                يجعل بداية الكلمات الإنجليزية بحروف كبيرة.
              </p>

              <code>hello world → Hello World</code>
            </article>

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-align-left"></i>
              </div>

              <h3>Sentence Case</h3>

              <p>
                يجعل بداية الجملة بحرف كبير مع تحويل باقي الأحرف إلى صغيرة.
              </p>

              <code>HELLO WORLD → Hello world.</code>
            </article>

          </div>
        </div>
      </section>

      <!-- HOW TO -->
      <section class="steps-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">HOW IT WORKS</span>
            <h2>كيفية استخدام الأداة؟</h2>
            <p>تحويل النص يحتاج إلى ثلاث خطوات بسيطة.</p>
          </div>

          <div class="steps-grid">

            <div class="step-card">
              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fa-solid fa-keyboard"></i>
              </div>

              <h3>أدخل النص</h3>

              <p>
                اكتب النص أو الصقه في مربع الإدخال.
              </p>
            </div>

            <div class="step-card">
              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </div>

              <h3>اختر التحويل</h3>

              <p>
                اختر UPPERCASE أو lowercase أو أي صيغة أخرى.
              </p>
            </div>

            <div class="step-card">
              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fa-regular fa-copy"></i>
              </div>

              <h3>انسخ النتيجة</h3>

              <p>
                اضغط على نسخ النتيجة لاستخدام النص مباشرة.
              </p>
            </div>

          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">FAQ</span>
            <h2>الأسئلة الشائعة</h2>
            <p>إجابات سريعة حول Text Case Converter.</p>
          </div>

          <div class="faq-list">
            {
              faqs.map((faq, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary>
                    <span>{faq[0]}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <div class="faq-answer">
                    <p>{faq[1]}</p>
                  </div>
                </details>
              ))
            }
          </div>

        </div>
      </section>

    </main>

    <Footer />

    <script is:inline>
      (() => {
        const input = document.getElementById('inputText');
        const output = document.getElementById('outputText');

        const upperBtn = document.getElementById('upperBtn');
        const lowerBtn = document.getElementById('lowerBtn');
        const titleBtn = document.getElementById('titleBtn');
        const sentenceBtn = document.getElementById('sentenceBtn');
        const invertBtn = document.getElementById('invertBtn');

        const copyBtn = document.getElementById('copyBtn');
        const copySmallBtn = document.getElementById('copySmallBtn');
        const clearBtn = document.getElementById('clearBtn');
        const sampleBtn = document.getElementById('sampleBtn');

        const inputChars = document.getElementById('inputChars');
        const outputChars = document.getElementById('outputChars');

        const statChars = document.getElementById('statChars');
        const statWords = document.getElementById('statWords');
        const statLines = document.getElementById('statLines');
        const statNoSpaces = document.getElementById('statNoSpaces');

        const inputStatus = document.getElementById('inputStatus');
        const resultStatus = document.getElementById('resultStatus');
        const liveStatus = document.getElementById('liveStatus');

        const sampleChips = document.querySelectorAll('.sample-chip');

        let currentOperation = '';

        function getText() {
          return input.value || '';
        }

        function updateStats() {
          const value = getText();

          const trimmed = value.trim();

          const words = trimmed
            ? trimmed.split(/\s+/).filter(Boolean).length
            : 0;

          const lines = value
            ? value.split(/\r?\n/).length
            : 0;

          inputChars.textContent = String(value.length);
          outputChars.textContent = String((output.value || '').length);

          statChars.textContent = String(value.length);
          statWords.textContent = String(words);
          statLines.textContent = String(lines);
          statNoSpaces.textContent = String(
            value.replace(/\s/g, '').length
          );
        }

        function setStatus(titleText, messageText, type) {
          const strong = liveStatus.querySelector('strong');
          const span = liveStatus.querySelector('span');
          const icon = liveStatus.querySelector('.status-icon i');

          strong.textContent = titleText;
          span.textContent = messageText;

          liveStatus.classList.remove(
            'success-status',
            'warning-status',
            'error-status'
          );

          if (type === 'success') {
            liveStatus.classList.add('success-status');
            icon.className = 'fa-solid fa-check';
          } else if (type === 'warning') {
            liveStatus.classList.add('warning-status');
            icon.className = 'fa-solid fa-circle-exclamation';
          } else if (type === 'error') {
            liveStatus.classList.add('error-status');
            icon.className = 'fa-solid fa-xmark';
          } else {
            icon.className = 'fa-solid fa-wand-magic-sparkles';
          }
        }

        function setActive(button) {
          const buttons = [
            upperBtn,
            lowerBtn,
            titleBtn,
            sentenceBtn,
            invertBtn
          ];

          buttons.forEach(function(item) {
            item.classList.remove('active');
          });

          if (button) {
            button.classList.add('active');
          }
        }

        function titleCase(text) {
          return text
            .toLowerCase()
            .replace(/\b\w/g, function(char) {
              return char.toUpperCase();
            });
        }

        function sentenceCase(text) {
          let result = text.toLowerCase();

          result = result.replace(
            /(^\s*[a-z])|([.!?]\s+[a-z])/g,
            function(match) {
              return match.toUpperCase();
            }
          );

          return result;
        }

        function invertCase(text) {
          let result = '';

          for (let i = 0; i < text.length; i++) {
            const char = text[i];

            if (char === char.toUpperCase() && char !== char.toLowerCase()) {
              result += char.toLowerCase();
            } else if (
              char === char.toLowerCase() &&
              char !== char.toUpperCase()
            ) {
              result += char.toUpperCase();
            } else {
              result += char;
            }
          }

          return result;
        }

        function convert(operation, button) {
          const text = getText();

          if (!text.trim()) {
            output.value = '';

            setStatus(
              'لا يوجد نص',
              'أدخل نصاً أولاً ثم اختر نوع التحويل.',
              'warning'
            );

            resultStatus.innerHTML =
              '<i class="fa-solid fa-circle-exclamation"></i> أدخل نصاً أولاً';

            updateStats();
            return;
          }

          currentOperation = operation;
          setActive(button);

          let result = '';

          if (operation === 'upper') {
            result = text.toUpperCase();
          } else if (operation === 'lower') {
            result = text.toLowerCase();
          } else if (operation === 'title') {
            result = titleCase(text);
          } else if (operation === 'sentence') {
            result = sentenceCase(text);
          } else if (operation === 'invert') {
            result = invertCase(text);
          }

          output.value = result;

          updateStats();

          setStatus(
            'تم التحويل بنجاح',
            'تم تطبيق صيغة ' + operation + ' على النص.',
            'success'
          );

          inputStatus.innerHTML =
            '<i class="fa-solid fa-check"></i> تمت المعالجة';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-circle-check"></i> النتيجة جاهزة';
        }

        async function copyResult() {
          const text = output.value;

          if (!text) {
            setStatus(
              'لا توجد نتيجة',
              'قم بتحويل النص أولاً ثم حاول النسخ.',
              'warning'
            );
            return;
          }

          try {
            await navigator.clipboard.writeText(text);

            setStatus(
              'تم النسخ',
              'تم نسخ النتيجة إلى الحافظة بنجاح.',
              'success'
            );

            copyBtn.innerHTML =
              '<i class="fa-solid fa-check"></i><span>تم النسخ</span>';

            copySmallBtn.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(function() {
              copyBtn.innerHTML =
                '<i class="fa-regular fa-copy"></i><span>نسخ النتيجة</span>';

              copySmallBtn.innerHTML =
                '<i class="fa-regular fa-copy"></i> نسخ';
            }, 1500);
          } catch (error) {
            output.focus();
            output.select();

            try {
              document.execCommand('copy');

              setStatus(
                'تم النسخ',
                'تم نسخ النص إلى الحافظة.',
                'success'
              );
            } catch (copyError) {
              setStatus(
                'تعذر النسخ',
                'حدد النص يدوياً وانسخه.',
                'warning'
              );
            }
          }
        }

        function clearAll() {
          input.value = '';
          output.value = '';

          currentOperation = '';

          setActive(null);

          inputStatus.innerHTML =
            '<i class="fa-solid fa-circle-info"></i> ابدأ بكتابة النص';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-wand-magic-sparkles"></i> جاهز للتحويل';

          setStatus(
            'تم المسح',
            'تم مسح النص والنتيجة.',
            'success'
          );

          updateStats();
          input.focus();
        }

        function loadSample(text) {
          input.value = text;
          output.value = '';

          setActive(null);

          inputStatus.innerHTML =
            '<i class="fa-solid fa-flask"></i> تم تحميل مثال';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-wand-magic-sparkles"></i> اختر نوع التحويل';

          setStatus(
            'مثال جاهز',
            'اختر إحدى صيغ التحويل لرؤية النتيجة.',
            'success'
          );

          updateStats();
          input.focus();
        }

        input.addEventListener('input', function() {
          updateStats();

          if (!input.value.trim()) {
            output.value = '';

            setStatus(
              'جاهز',
              'أدخل النص واختر نوع التحويل.',
              ''
            );

            inputStatus.innerHTML =
              '<i class="fa-solid fa-circle-info"></i> ابدأ بكتابة النص';

            resultStatus.innerHTML =
              '<i class="fa-solid fa-wand-magic-sparkles"></i> جاهز للتحويل';
          } else {
            inputStatus.innerHTML =
              '<i class="fa-solid fa-pen"></i> نص جاهز';

            setStatus(
              'جاهز للتحويل',
              'اختر نوع حالة النص الذي تريده.',
              ''
            );
          }
        });

        upperBtn.addEventListener('click', function() {
          convert('UPPERCASE', upperBtn);
        });

        lowerBtn.addEventListener('click', function() {
          convert('lowercase', lowerBtn);
        });

        titleBtn.addEventListener('click', function() {
          convert('Title Case', titleBtn);
        });

        sentenceBtn.addEventListener('click', function() {
          convert('Sentence Case', sentenceBtn);
        });

        invertBtn.addEventListener('click', function() {
          convert('Invert Case', invertBtn);
        });

        copyBtn.addEventListener('click', copyResult);
        copySmallBtn.addEventListener('click', copyResult);

        clearBtn.addEventListener('click', clearAll);

        sampleBtn.addEventListener('click', function() {
          loadSample(
            'welcome to th.tech — discover, learn and create.'
          );
        });

        sampleChips.forEach(function(chip) {
          chip.addEventListener('click', function() {
            loadSample(chip.getAttribute('data-sample') || '');
          });
        });

        input.addEventListener('keydown', function(event) {
          if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
            convert('UPPERCASE', upperBtn);
          }
        });

        function syncTheme() {
          try {
            const saved = localStorage.getItem('theme');

            if (saved === 'dark') {
              document.documentElement.classList.add('dark-mode');
            } else {
              document.documentElement.classList.remove('dark-mode');
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener('themeChange', syncTheme);

        document.addEventListener('click', function(event) {
          const target = event.target;

          if (
            target &&
            target.closest &&
            target.closest('#theme-btn')
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        updateStats();
      })();
    </script>

    <style>
      :root {
        --bg: #f4f8fc;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --border: #dce7f2;
        --text: #0b1728;
        --muted: #64748b;
        --primary: #1688e8;
        --primary-dark: #0867b7;
        --cyan: #06b6d4;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --shadow: 0 18px 50px rgba(15, 52, 87, 0.1);
        --radius: 22px;
      }

      html.dark-mode {
        --bg: #050b14;
        --surface: #0b1524;
        --surface-2: #0f1c2e;
        --border: #1c3047;
        --text: #edf6ff;
        --muted: #91a4ba;
        --primary: #39a8ff;
        --primary-dark: #1583d2;
        --cyan: #22d3ee;
        --success: #4ade80;
        --warning: #fbbf24;
        --danger: #fb7185;
        --shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Cairo', sans-serif;
      }

      button,
      textarea {
        font-family: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 70px 0 100px;
        background:
          radial-gradient(circle at 15% 30%, rgba(22, 136, 232, 0.2), transparent 32%),
          radial-gradient(circle at 85% 10%, rgba(6, 182, 212, 0.14), transparent 28%),
          linear-gradient(135deg, #07111f, #0b1b2d 55%, #07111f);
        color: #fff;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
      }

      .glow-one {
        width: 250px;
        height: 250px;
        background: rgba(22, 136, 232, 0.2);
        top: 40px;
        right: -100px;
      }

      .glow-two {
        width: 220px;
        height: 220px;
        background: rgba(6, 182, 212, 0.15);
        bottom: -80px;
        left: -80px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
        color: #8ea4bc;
        font-size: 13px;
      }

      .breadcrumb a {
        color: #b9cbe0;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: #55b9ff;
      }

      .tool-icon {
        width: 82px;
        height: 82px;
        display: grid;
        place-items: center;
        margin: 0 auto 18px;
        border: 1px solid rgba(96, 190, 255, 0.3);
        border-radius: 24px;
        background: linear-gradient(
          135deg,
          rgba(22, 136, 232, 0.28),
          rgba(6, 182, 212, 0.2)
        );
        box-shadow:
          0 20px 50px rgba(0, 0, 0, 0.22),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
        color: #66c7ff;
        font-size: 32px;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        border: 1px solid rgba(100, 190, 255, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.05);
        color: #b7dfff;
        font-size: 12px;
        font-weight: 700;
      }

      .badge-dot,
      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #35e27d;
        box-shadow: 0 0 12px rgba(53, 226, 125, 0.8);
      }

      .hero h1 {
        margin: 18px 0 12px;
        font-size: clamp(34px, 6vw, 58px);
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -1.5px;
      }

      .hero p {
        max-width: 680px;
        margin: 0 auto;
        color: #a8bad0;
        font-size: 16px;
        line-height: 1.9;
      }

      .hero-tags {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .hero-tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border: 1px solid rgba(126, 190, 230, 0.18);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.045);
        color: #bcd0e5;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
      }

      /* TOOL */

      .tool-section {
        position: relative;
        margin-top: -50px;
        padding-bottom: 70px;
      }

      .converter-card {
        position: relative;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .card-top h2 {
        margin: 0;
        font-size: 25px;
      }

      .card-top p {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .local-status {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
      }

      .actions {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
      }

      .main-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .case-btn,
      .utility-btn,
      .small-btn {
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--text);
        transition: 0.2s ease;
      }

      .case-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 15px;
        border-radius: 11px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 600;
      }

      .case-btn:hover,
      .utility-btn:hover,
      .small-btn:hover {
        border-color: rgba(22, 136, 232, 0.5);
        transform: translateY(-2px);
        color: var(--primary);
      }

      .case-btn.primary,
      .case-btn.active {
        border-color: transparent;
        background: linear-gradient(135deg, var(--primary), var(--cyan));
        color: #fff;
        box-shadow: 0 8px 22px rgba(22, 136, 232, 0.22);
      }

      .utility-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
      }

      .utility-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 14px;
        border-radius: 11px;
        font-size: 12px;
        font-weight: 700;
      }

      .utility-btn.danger:hover {
        border-color: rgba(220, 38, 38, 0.35);
        color: var(--danger);
      }

      /* EDITORS */

      .editors {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1fr);
        align-items: stretch;
        gap: 14px;
      }

      .editor-box {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface-2);
      }

      .editor-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 13px 15px;
        border-bottom: 1px solid var(--border);
      }

      .editor-title {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .editor-title > div {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .editor-title strong {
        font-size: 13px;
      }

      .editor-title small {
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
      }

      .editor-number {
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: rgba(22, 136, 232, 0.12);
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
      }

      .output-number {
        background: rgba(6, 182, 212, 0.12);
        color: var(--cyan);
      }

      .small-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 700;
      }

      textarea {
        display: block;
        width: 100%;
        min-height: 230px;
        resize: vertical;
        padding: 17px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.8;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: 0.75;
      }

      .output-box textarea {
        background: rgba(22, 136, 232, 0.025);
      }

      .editor-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 10px;
      }

      .editor-footer span:first-child {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .editor-footer b {
        color: var(--text);
        font-family: 'JetBrains Mono', monospace;
      }

      .direction-arrow {
        display: grid;
        place-items: center;
        color: var(--primary);
        font-size: 20px;
      }

      /* SAMPLES */

      .samples {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 15px;
      }

      .samples-title {
