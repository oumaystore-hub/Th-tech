        align-items: center;
        gap: 6px;
        margin-left: 4px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
      }

      .sample-chip {
        padding: 7px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        transition: 0.2s;
      }

      .sample-chip:hover {
        border-color: rgba(22, 136, 232, 0.4);
        color: var(--primary);
      }

      /* STATUS */

      .live-status {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding: 13px 15px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
      }

      .status-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .live-status > div:last-child {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .live-status strong {
        font-size: 12px;
      }

      .live-status span {
        color: var(--muted);
        font-size: 10px;
      }

      .success-status .status-icon {
        background: rgba(22, 163, 74, 0.11);
        color: var(--success);
      }

      .warning-status .status-icon {
        background: rgba(217, 119, 6, 0.11);
        color: var(--warning);
      }

      .error-status .status-icon {
        background: rgba(220, 38, 38, 0.11);
        color: var(--danger);
      }

      /* STATS */

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 14px;
      }

      .stat-card {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
      }

      .stat-icon {
        width: 35px;
        height: 35px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 9px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
        font-size: 13px;
      }

      .stat-card div:last-child {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .stat-card span {
        color: var(--muted);
        font-size: 9px;
      }

      .stat-card strong {
        font-family: 'JetBrains Mono', monospace;
        font-size: 17px;
      }

      /* PRIVACY */

      .privacy-section {
