      .privacy-checks span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 9px;
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 9px;
      }

      .privacy-checks i {
        color: var(--success);
      }

      /* SECTIONS */

      .info-section,
      .steps-section,
      .faq-section {
        padding: 80px 0;
      }

      .info-section {
        background: var(--surface);
      }

      .section-heading {
        max-width: 650px;
        margin: 0 auto 35px;
        text-align: center;
      }

      .section-kicker {
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 8px 0 7px;
        font-size: 28px;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }

      .info-card {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--surface-2);
        transition: 0.25s ease;
      }

      .info-card:hover {
        transform: translateY(-4px);
        border-color: rgba(22, 136, 232, 0.35);
        box-shadow: var(--shadow);
      }

      .info-card-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        margin-bottom: 15px;
        border-radius: 11px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
      }

      .info-card p {
        min-height: 54px;
        margin: 0 0 15px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .info-card code {
        display: block;
        padding: 9px;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
      }

      /* STEPS */

      .steps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .step-card {
        position: relative;
        padding: 27px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
      }

      .step-number {
        position: absolute;
        top: 18px;
        left: 20px;
        color: var(--border);
        font-family: 'JetBrains Mono', monospace;
        font-size: 32px;
        font-weight: 700;
      }

      .step-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        margin-bottom: 17px;
        border-radius: 13px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .step-card h3 {
        margin: 0 0 7px;
        font-size: 15px;
      }

      .step-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        max-width: 820px;
        margin: 0 auto;
      }

      .faq-item {
        margin-bottom: 9px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
      }

      .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 19px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--muted);
        transition: 0.2s;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
        color: var(--primary);
      }

      .faq-answer {
        padding: 0 19px 17px;
      }

      .faq-answer p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 980px) {
        .info-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .actions {
          flex-direction: column;
        }

        .utility-actions {
          width: 100%;
        }

        .utility-btn {
          min-height: 42px;
        }
      }

      @media (max-width: 760px) {
        .hero {
          padding: 48px 0 85px;
        }

        .converter-card {
          padding: 17px;
          border-radius: 17px;
        }

        .card-top {
          flex-direction: column;
        }

        .local-status {
          align-self: flex-start;
        }

        .main-actions {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          width: 100%;
        }

        .case-btn {
          width: 100%;
          padding: 0 8px;
        }

        .case-btn:last-child {
          grid-column: 1 / -1;
        }

        .utility-actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .utility-btn {
          justify-content: center;
        }

        .editors {
          grid-template-columns: 1fr;
        }

        .direction-arrow {
          transform: rotate(-90deg);
          height: 20px;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .privacy-card {
          align-items: flex-start;
          flex-wrap: wrap;
        }

        .privacy-checks {
          width: 100%;
          margin-right: 0;
        }

        .steps-grid {
          grid-template-columns: 1fr;
        }

        .info-grid {
