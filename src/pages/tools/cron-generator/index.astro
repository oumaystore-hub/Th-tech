        rgba(40, 184, 242, 0.18);

      font-size: 13px;

      font-weight: 700;
    }

    .hero h1 {

      margin:
        18px 0 10px;

      font-size:
        clamp(34px, 6vw, 58px);

      line-height: 1.15;

      font-weight: 800;

      letter-spacing: -1px;
    }

    .hero h1 span {
      color: var(--blue);
    }

    .hero > p {

      max-width: 720px;

      margin:
        0 auto;

      color:
        var(--muted);

      font-size: 16px;

      line-height: 1.9;
    }

    .hero-points {

      display: flex;

      flex-wrap: wrap;

      justify-content: center;

      gap: 10px;

      margin-top: 18px;
    }

    .hero-points span {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      color:
        var(--muted);

      font-size: 13px;
    }

    .hero-points i {
      color: var(--blue);
    }

    .tool-card,
    .content-card,
    .faq-card,
    .tip-card,
    .info-card {

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      box-shadow:
        var(--shadow);

      transition:
        background 0.25s ease,
        border-color 0.25s ease;
    }

    .tool-card {

      max-width: 1050px;

      margin:
        0 auto;

      padding: 24px;

      border-radius: 24px;
    }

    .tool-top {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding-bottom: 22px;

      border-bottom:
        1px solid
        var(--border);
    }

    .tool-title {

      display: flex;

      align-items: center;

      gap: 14px;
    }

    .tool-icon {

      width: 48px;
      height: 48px;

      flex:
        0 0 48px;

      display: grid;

      place-items: center;

      border-radius: 14px;

      background:
        var(--blue-soft);

      color:
        var(--blue);

      font-size: 20px;
    }

    .tool-title h2 {

      margin:
        0 0 3px;

      font-size: 19px;
    }

    .tool-title p {

      margin: 0;

      color:
        var(--muted);

      font-size: 13px;
    }

    .status {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding:
        8px 12px;

      border-radius: 10px;

      background:
        var(--surface-2);

      color:
        var(--muted);

      font-size: 12px;

      white-space: nowrap;
    }

    .status-dot {

      width: 8px;
      height: 8px;

      border-radius: 50%;

      background:
        var(--success);

      box-shadow:
        0 0 10px
        rgba(49, 214, 154, 0.45);
    }

    .section-label {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      color:
        var(--text);

      font-size: 13px;

      font-weight: 700;
    }

    .section-label i {
      color: var(--blue);
    }

    .expression-card {

      margin-top: 24px;

      padding: 20px;

      border-radius: 18px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);
    }

    .expression-header {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;
    }

    .expression-header p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size: 11px;
    }

    .copy-expression {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      border: 0;

      border-radius: 10px;

      padding:
        9px 14px;

      background:
        var(--blue-soft);

      color:
        var(--blue);

      font-family: inherit;

      font-size: 12px;

      font-weight: 700;

      cursor: pointer;

      transition: 0.2s ease;
    }

    .copy-expression:hover,
    .copy-expression.copied {

      background:
        var(--blue);

      color:
        #fff;
    }

    .expression-display {

      margin-top: 14px;

      padding:
        20px;

      border-radius: 14px;

      background:
        var(--field);

      border:
        1px solid
        var(--border);

      text-align: center;

      font-family:
        'JetBrains Mono',
        monospace;

      font-size:
        clamp(22px, 5vw, 34px);

      font-weight: 700;

      color:
        var(--blue);

      letter-spacing: 2px;

      overflow-x: auto;
    }

    .expression-description {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 7px;

      margin-top: 11px;

      color:
        var(--muted);

      font-size: 12px;
    }

    .expression-description i {
      color: var(--blue);
    }

    .presets-section {
      margin-top: 24px;
    }

    .preset-list {

      display: flex;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 10px;
    }

    .preset-list button {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      border:
        1px solid
        var(--border);

      background:
        var(--surface-2);

      color:
        var(--muted);

      border-radius: 10px;

      padding:
        9px 13px;

      font-family: inherit;

      font-size: 12px;

      cursor: pointer;

      transition: 0.2s ease;
    }

    .preset-list button:hover {

      color:
        var(--blue);

      border-color:
        rgba(40, 184, 242, 0.35);

      background:
        var(--blue-soft);

      transform:
        translateY(-1px);
    }

    .preset-list button i {
      color: var(--blue);
    }

    .fields-grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 14px;

      margin-top: 25px;
    }

    .cron-field {

      padding: 16px;

      border-radius: 16px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);

      transition:
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .cron-field:hover {

      border-color:
        rgba(40, 184, 242, 0.25);

      transform:
        translateY(-1px);
    }

    .field-heading {

      display: flex;

      align-items: center;

      gap: 10px;

      margin-bottom: 13px;
    }

    .field-icon {

      width: 38px;
      height: 38px;

      display: grid;

      place-items: center;

      border-radius: 11px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .field-heading h3 {

      margin: 0;

      font-size: 13px;
    }

    .field-heading span {

      display: block;

      margin-top: 2px;

      color:
        var(--muted);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 9px;

      direction: ltr;
      text-align: right;
    }

    .cron-field select,
    .cron-field input {

      width: 100%;

      box-sizing: border-box;

      height: 43px;

      border-radius: 10px;

      border:
        1px solid
        var(--border);

      background:
        var(--field);

      color:
        var(--text);

      outline: none;

      font-family:
        inherit;

      font-size: 12px;

      transition: 0.2s ease;
    }

    .cron-field select {

      padding:
        0 11px;

      cursor: pointer;
    }

    .cron-field input {

      margin-top: 8px;

      padding:
        0 11px;

      font-family:
        'JetBrains Mono',
        monospace;
    }

    .cron-field select:focus,
    .cron-field input:focus {

      border-color:
        var(--blue);

      box-shadow:
        0 0 0 3px
        var(--blue-soft);
    }

    .cron-field small {

      display: block;

      margin-top: 7px;

      color:
        var(--muted);

      font-size: 10px;
    }

    .cron-legend {

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 8px;

      margin-top: 15px;
    }

    .legend-item {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      padding:
        9px;

      border-radius: 10px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);
    }

    .legend-item strong {

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 16px;
    }

    .legend-item span {

      color:
        var(--muted);

      font-size: 10px;
    }

    .manual-section {

      margin-top: 24px;

      padding-top: 20px;

      border-top:
        1px solid
        var(--border);
    }

    .manual-row {

      display: flex;

      gap: 10px;

      margin-top: 10px;
    }

    #manualExpression {

      flex: 1;

      min-width: 0;

      height: 48px;

      box-sizing: border-box;

      padding:
        0 15px;

      border-radius: 12px;

      border:
        1px solid
        var(--border);

      background:
        var(--field);

      color:
        var(--text);

      outline: none;

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 14px;
    }

    #manualExpression:focus {

      border-color:
        var(--blue);

      box-shadow:
        0 0 0 3px
        var(--blue-soft);
    }

    .primary-btn {

      min-width: 105px;

      border: 0;

      border-radius: 12px;

      background:
        var(--blue);

      color:
        #fff;

      font-family: inherit;

      font-weight: 800;

      cursor: pointer;

      transition: 0.2s ease;
    }

    .primary-btn:hover {

      background:
        var(--blue-2);

      transform:
        translateY(-1px);
    }

    .manual-message {

      min-height: 18px;

      margin-top: 7px;

      font-size: 11px;
    }

    .manual-message.success {
      color: var(--success);
    }

    .manual-message.error {
      color: var(--danger);
    }

    .info-grid {

      max-width: 1050px;

      margin:
        22px auto 0;

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 15px;
    }

    .info-card {

      padding: 21px;

      border-radius: 18px;
    }

    .info-icon {

      width: 42px;
      height: 42px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .info-card h3 {

      margin:
        14px 0 7px;

      font-size: 15px;
    }

    .info-card p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    .content-card,
    .faq-card {

      max-width: 1050px;

      margin:
        22px auto 0;

      padding: 24px;

      border-radius: 20px;
    }

    .content-heading {

      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 22px;
    }

    .heading-icon {

      width: 44px;
      height: 44px;

      flex:
        0 0 44px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .content-heading h2 {

      margin:
        0 0 3px;

      font-size: 18px;
    }

    .content-heading p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;
    }

    .examples-table {

      display: grid;

      gap: 8px;
    }

    .example-row {

      display: grid;

      grid-template-columns:
        1.2fr 2fr 55px;

      align-items: center;

      gap: 12px;

      padding:
        12px 14px;

      border-radius: 12px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);
    }

    .example-row code {

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 12px;

      direction: ltr;

      text-align: left;
    }

    .example-row span {

      color:
        var(--muted);

      font-size: 12px;
    }

    .example-row button {

      width: 35px;
      height: 35px;

      display: grid;

      place-items: center;

      border: 0;

      border-radius: 9px;

      background:
        var(--blue-soft);

      color:
        var(--blue);

      cursor: pointer;

      transition: 0.2s ease;
    }

    .example-row button:hover {

      background:
        var(--blue);

      color:
        #fff;
    }

    .example-head {

      background:
        var(--surface-3);
    }

    .example-head span {

      color:
        var(--text);

      font-size: 11px;

      font-weight: 700;
    }

    .steps {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 14px;
    }

    .step {

      display: flex;

      gap: 12px;

      padding: 15px;

      border-radius: 14px;

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);
    }

    .step > span {

      font:
        600 12px
        'JetBrains Mono',
        monospace;

      color:
        var(--blue);
    }

    .step h3 {

      margin:
        0 0 4px;

      font-size: 13px;
    }

    .step p {

      margin: 0;

      color:
        var(--muted);

      font-size: 11px;

      line-height: 1.8;
    }

    .tip-card {

      max-width: 1050px;

      margin:
        22px auto 0;

      padding:
        18px 20px;

      border-radius: 18px;

      display: flex;

      align-items: flex-start;

      gap: 14px;
    }

    .tip-icon {

      width: 43px;
      height: 43px;

      flex:
        0 0 43px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        var(--blue-soft);

      color:
        var(--blue);
    }

    .tip-card strong {

      display: block;

      margin-bottom: 4px;

      font-size: 14px;
    }

    .tip-card p {

      margin: 0;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    .tip-card code,
    .faq-card code {

      padding:
        2px 6px;

      border-radius: 5px;

      background:
        var(--blue-soft);

      color:
        var(--blue);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;
    }

    .faq-list {

      display: grid;

      gap: 9px;
    }

    .faq-list details {

      border:
        1px solid
        var(--border);

      background:
        var(--surface-2);

      border-radius: 13px;

      overflow: hidden;
    }

    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 15px;

      cursor: pointer;

      list-style: none;

      font-size: 13px;

      font-weight: 700;
    }

    .faq-list summary::-webkit-details-marker {
      display: none;
    }

    .faq-list summary i {

      color:
        var(--blue);

      transition:
        transform 0.2s ease;
    }

    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);
    }

    .faq-list details p {

      margin: 0;

      padding:
        0 15px 16px;

      color:
        var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    @media (max-width: 850px) {

      .fields-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }

      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }

      .cron-legend {

        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (max-width: 600px) {

      .cron-page {

        padding:
          25px 12px 50px;
      }

      .tool-card,
      .content-card,
      .faq-card {

        padding: 17px;

        border-radius: 18px;
      }

      .tool-top {

        align-items:
          flex-start;
      }

      .tool-title p {
        display: none;
      }

      .status {

        font-size: 10px;

        padding:
          7px 9px;
      }

      .fields-grid {

        grid-template-columns:
          1fr;
      }

      .cron-legend {

        grid-template-columns:
          1fr 1fr;
      }

      .manual-row {

        flex-direction:
          column;
      }

      .primary-btn {

        height: 48px;
      }

      .example-row {

        grid-template-columns:
          1fr 42px;
      }

      .example-row span {

        grid-column:
          1 / -1;

        grid-row: 2;
      }

      .example-row button {

        grid-column: 2;
        grid-row: 1;
      }

      .example-head {

        display: none;
      }

      .hero h1 {

        font-size: 34px;
      }

      .hero > p {

        font-size: 14px;
      }

      .tip-card {

        align-items:
          flex-start;
      }

    }

    @media (max-width: 380px) {

      .hero-points {

        flex-direction:
          column;

        align-items:
          center;
      }

      .preset-list button {

        flex:
          1 1 calc(50% - 8px);
      }

    }

  </style>
</body>
</html>
