  <script>
    function init() {

      const expressionValue =
        document.getElementById('expressionValue');

      const expressionHuman =
        document.getElementById('expressionHuman');

      const copyExpression =
        document.getElementById('copyExpression');

      const manualExpression =
        document.getElementById('manualExpression');

      const applyManual =
        document.getElementById('applyManual');

      const manualMessage =
        document.getElementById('manualMessage');

      const fields = {
        minute: {
          select: document.getElementById('minute'),
          custom: document.getElementById('minuteCustom')
        },

        hour: {
          select: document.getElementById('hour'),
          custom: document.getElementById('hourCustom')
        },

        day: {
          select: document.getElementById('day'),
          custom: document.getElementById('dayCustom')
        },

        month: {
          select: document.getElementById('month'),
          custom: document.getElementById('monthCustom')
        },

        weekday: {
          select: document.getElementById('weekday'),
          custom: document.getElementById('weekdayCustom')
        }
      };

      if (!expressionValue || !manualExpression) return;

      function getFieldValue(field) {

        const custom = field.custom.value.trim();

        if (custom) {
          return custom;
        }

        return field.select.value;
      }

      function generateExpression() {

        const expression = [
          getFieldValue(fields.minute),
          getFieldValue(fields.hour),
          getFieldValue(fields.day),
          getFieldValue(fields.month),
          getFieldValue(fields.weekday)
        ].join(' ');

        setExpression(expression);

        return expression;
      }

      function setExpression(expression) {

        expressionValue.textContent = expression;
        manualExpression.value = expression;

        expressionHuman.textContent =
          describeExpression(expression);
      }

      function describeExpression(expression) {

        const parts = expression.trim().split(/\s+/);

        if (parts.length !== 5) {
          return 'Cron Expression غير مكتمل';
        }

        const [minute, hour, day, month, weekday] = parts;

        if (
          minute === '*' &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم التنفيذ كل دقيقة';
        }

        if (
          minute === '0' &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم التنفيذ في بداية كل ساعة';
        }

        if (
          minute === '0' &&
          hour === '0' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم التنفيذ يوميًا عند منتصف الليل';
        }

        if (
          minute === '0' &&
          hour === '9' &&
          day === '*' &&
          month === '*' &&
          weekday === '1-5'
        ) {
          return 'يتم التنفيذ الساعة 09:00 من الاثنين إلى الجمعة';
        }

        if (
          minute === '0' &&
          hour === '0' &&
          day === '1' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم التنفيذ في أول يوم من كل شهر';
        }

        if (
          minute === '*/5' &&
          hour === '*' &&
          day === '*' &&
          month === '*' &&
          weekday === '*'
        ) {
          return 'يتم التنفيذ كل 5 دقائق';
        }

        if (
          minute.startsWith('*/')
        ) {
          return `يتم التنفيذ كل ${minute.substring(2)} دقائق`;
        }

        if (
          hour.startsWith('*/') &&
          minute === '0'
        ) {
          return `يتم التنفيذ كل ${hour.substring(2)} ساعات`;
        }

        return 'Cron Expression مخصص';
      }

      function clearCustomWhenSelectChanges() {

        Object.values(fields).forEach(field => {

          field.select.addEventListener('change', () => {

            field.custom.value = '';

            generateExpression();

          });

          field.custom.addEventListener('input', () => {

            if (field.custom.value.trim()) {
              field.select.value = '*';
            }

            generateExpression();

          });

        });
      }

      function copyText(text, button) {

        const original = button.innerHTML;

        const finish = () => {

          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          button.classList.add('copied');

          setTimeout(() => {

            button.innerHTML = original;
            button.classList.remove('copied');

          }, 1300);

        };

        if (
          navigator.clipboard &&
          navigator.clipboard.writeText
        ) {

          navigator.clipboard
            .writeText(text)
            .then(finish)
            .catch(() => {
              fallbackCopy(text);
              finish();
            });

        } else {

          fallbackCopy(text);
          finish();

        }
      }

      function fallbackCopy(text) {

        const textarea =
          document.createElement('textarea');

        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';

        document.body.appendChild(textarea);

        textarea.select();

        try {
          document.execCommand('copy');
        } catch {}

        textarea.remove();
      }

      copyExpression.addEventListener('click', () => {

        copyText(
          expressionValue.textContent,
          copyExpression
        );

      });

      applyManual.addEventListener('click', () => {

        const expression =
          manualExpression.value.trim();

        const parts =
          expression.split(/\s+/);

        if (parts.length !== 5) {

          manualMessage.textContent =
            'يجب أن يحتوي Cron Expression على 5 حقول.';

          manualMessage.className =
            'manual-message error';

          return;
        }

        const valid =
          parts.every(part =>
            /^[0-9*?,\/\-A-Za-z]+$/.test(part)
          );

        if (!valid) {

          manualMessage.textContent =
            'التعبير يحتوي على رموز غير صالحة.';

          manualMessage.className =
            'manual-message error';

          return;
        }

        setExpression(expression);

        Object.values(fields).forEach(field => {

          field.select.value = '*';
          field.custom.value = '';

        });

        manualMessage.textContent =
          'تم تطبيق التعبير بنجاح.';

        manualMessage.className =
          'manual-message success';

        setTimeout(() => {
          manualMessage.textContent = '';
        }, 1800);

      });

      document
        .querySelectorAll('[data-preset]')
        .forEach(button => {

          button.addEventListener('click', () => {

            const preset =
              button.dataset.preset;

            const presets = {

              everyMinute:
                ['*', '*', '*', '*', '*'],

              everyHour:
                ['0', '*', '*', '*', '*'],

              daily:
                ['0', '0', '*', '*', '*'],

              weekly:
                ['0', '0', '*', '*', '0'],

              monthly:
                ['0', '0', '1', '*', '*'],

              weekday:
                ['0', '9', '*', '*', '1-5']

            };

            const values =
              presets[preset];

            if (!values) return;

            const keys =
              ['minute', 'hour', 'day', 'month', 'weekday'];

            keys.forEach((key, index) => {

              fields[key].select.value =
                values[index];

              fields[key].custom.value = '';

            });

            const expression =
              values.join(' ');

            setExpression(expression);

          });

        });

      document
        .querySelectorAll('[data-copy-example]')
        .forEach(button => {

          button.addEventListener('click', () => {

            const value =
              button.dataset.copyExample || '';

            copyText(value, button);

          });

        });

      clearCustomWhenSelectChanges();

      // Theme — نفس بنية الأدوات السابقة
      function getThemeState() {

        const html =
          document.documentElement;

        const stored =
          localStorage.getItem('theme');

        if (stored === 'light') return 'light';
        if (stored === 'dark') return 'dark';

        if (html.dataset.theme === 'light') {
          return 'light';
        }

        if (html.dataset.theme === 'dark') {
          return 'dark';
        }

        if (html.classList.contains('light')) {
          return 'light';
        }

        if (html.classList.contains('dark')) {
          return 'dark';
        }

        return 'dark';
      }

      function syncTheme() {

        const theme =
          getThemeState();

        const light =
          theme === 'light';

        document.body.classList.toggle(
          'cron-light',
          light
        );

        document.body.classList.toggle(
          'cron-dark',
          !light
        );

      }

      syncTheme();

      window.addEventListener(
        'storage',
        event => {

          if (event.key === 'theme') {
            syncTheme();
          }

        }
      );

      const themeObserver =
        new MutationObserver(() => {
          syncTheme();
        });

      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: [
            'class',
            'data-theme'
          ]
        }
      );

      setExpression('* * * * *');
    }

    if (
      document.readyState === 'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        init
      );

    } else {

      init();

    }
  </script>

