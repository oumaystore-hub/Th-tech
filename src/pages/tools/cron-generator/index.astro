---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/cron-expression-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Cron Expression Generator | مولد Cron Expression</title>

  <meta
    name="description"
    content="مولد Cron Expression مجاني لإنشاء تعبيرات Cron بسهولة من خلال اختيار الدقائق والساعات والأيام والشهور وأيام الأسبوع."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>
  <Header />

  <main class="cron-page">
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=tools">
    أدوات تقنية
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">Cron Generator</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->


    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">
        <i class="fa-solid fa-clock"></i>
        أداة المطورين
      </div>

      <h1>
        Cron Expression
        <span>Generator</span>
      </h1>

      <p>
        أنشئ Cron Expression بسهولة من خلال اختيار الدقيقة والساعة
        واليوم والشهر وأيام الأسبوع، ثم انسخ التعبير الجاهز للاستخدام.
      </p>

      <div class="hero-points">
        <span>
          <i class="fa-solid fa-bolt"></i>
          إنشاء سريع
        </span>

        <span>
          <i class="fa-solid fa-sliders"></i>
          إعدادات مرنة
        </span>

        <span>
          <i class="fa-solid fa-copy"></i>
          نسخ بنقرة
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          يعمل محليًا
        </span>
      </div>
    </section>

    <!-- Generator -->
    <section class="tool-card">

      <div class="tool-top">
        <div class="tool-title">
          <div class="tool-icon">
            <i class="fa-solid fa-clock-rotate-left"></i>
          </div>

          <div>
            <h2>مولد Cron Expression</h2>
            <p>
              اختر القيم المناسبة لإنشاء Cron Expression تلقائيًا.
            </p>
          </div>
        </div>

        <div class="status">
          <span class="status-dot"></span>
          يعمل محليًا
        </div>
      </div>

      <!-- Expression -->
      <div class="expression-card">

        <div class="expression-header">
          <div>
            <span class="section-label">
              <i class="fa-solid fa-code"></i>
              Cron Expression
            </span>

            <p>
              التعبير الناتج
            </p>
          </div>

          <button id="copyExpression" class="copy-expression" type="button">
            <i class="fa-solid fa-copy"></i>
            نسخ
          </button>
        </div>

        <div class="expression-display" dir="ltr">
          <span id="expressionValue">* * * * *</span>
        </div>

        <div class="expression-description">
          <i class="fa-solid fa-circle-info"></i>
          <span id="expressionHuman">
            كل دقيقة
          </span>
        </div>

      </div>

      <!-- Presets -->
      <div class="presets-section">

        <div class="section-label">
          <i class="fa-solid fa-bolt"></i>
          أمثلة سريعة
        </div>

        <div class="preset-list">

          <button data-preset="everyMinute">
            <i class="fa-solid fa-rotate"></i>
            كل دقيقة
          </button>

          <button data-preset="everyHour">
            <i class="fa-solid fa-clock"></i>
            كل ساعة
          </button>

          <button data-preset="daily">
            <i class="fa-solid fa-sun"></i>
            كل يوم
          </button>

          <button data-preset="weekly">
            <i class="fa-solid fa-calendar-week"></i>
            كل أسبوع
          </button>

          <button data-preset="monthly">
            <i class="fa-solid fa-calendar-days"></i>
            كل شهر
          </button>

          <button data-preset="weekday">
            <i class="fa-solid fa-briefcase"></i>
            أيام العمل
          </button>

        </div>

      </div>

      <!-- Fields -->
      <div class="fields-grid">

        <!-- Minute -->
        <div class="cron-field">

          <div class="field-heading">
            <div class="field-icon">
              <i class="fa-solid fa-stopwatch"></i>
            </div>

            <div>
              <h3>الدقيقة</h3>
              <span>Minute</span>
            </div>
          </div>

          <select id="minute">
            <option value="*" selected>كل دقيقة (*)</option>
            <option value="0">00</option>
            <option value="1">01</option>
            <option value="5">05</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
            <option value="30">30</option>
            <option value="45">45</option>
          </select>

          <input
            id="minuteCustom"
            type="text"
            dir="ltr"
            placeholder="مثال: */5 أو 0,15,30,45"
          />

          <small>
            0–59
          </small>

        </div>

        <!-- Hour -->
        <div class="cron-field">

          <div class="field-heading">
            <div class="field-icon">
              <i class="fa-solid fa-clock"></i>
            </div>

            <div>
              <h3>الساعة</h3>
              <span>Hour</span>
            </div>
          </div>

          <select id="hour">
            <option value="*" selected>كل ساعة (*)</option>
            <option value="0">00</option>
            <option value="1">01</option>
            <option value="2">02</option>
            <option value="3">03</option>
            <option value="4">04</option>
            <option value="5">05</option>
            <option value="6">06</option>
            <option value="7">07</option>
            <option value="8">08</option>
            <option value="9">09</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
            <option value="13">13</option>
            <option value="14">14</option>
            <option value="15">15</option>
            <option value="16">16</option>
            <option value="17">17</option>
            <option value="18">18</option>
            <option value="19">19</option>
            <option value="20">20</option>
            <option value="21">21</option>
            <option value="22">22</option>
            <option value="23">23</option>
          </select>

          <input
            id="hourCustom"
            type="text"
            dir="ltr"
            placeholder="مثال: */2 أو 9-17"
          />

          <small>
            0–23
          </small>

        </div>

        <!-- Day -->
        <div class="cron-field">

          <div class="field-heading">
            <div class="field-icon">
              <i class="fa-solid fa-calendar-day"></i>
            </div>

            <div>
              <h3>اليوم</h3>
              <span>Day of Month</span>
            </div>
          </div>

          <select id="day">
            <option value="*" selected>كل الأيام (*)</option>
            <option value="1">01</option>
            <option value="2">02</option>
            <option value="5">05</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
            <option value="25">25</option>
            <option value="28">28</option>
          </select>

          <input
            id="dayCustom"
            type="text"
            dir="ltr"
            placeholder="مثال: 1-5 أو 1,15"
          />

          <small>
            1–31
          </small>

        </div>

        <!-- Month -->
        <div class="cron-field">

          <div class="field-heading">
            <div class="field-icon">
              <i class="fa-solid fa-calendar"></i>
            </div>

            <div>
              <h3>الشهر</h3>
              <span>Month</span>
            </div>
          </div>

          <select id="month">
            <option value="*" selected>كل الشهور (*)</option>
            <option value="1">يناير</option>
            <option value="2">فبراير</option>
            <option value="3">مارس</option>
            <option value="4">أبريل</option>
            <option value="5">مايو</option>
            <option value="6">يونيو</option>
            <option value="7">يوليو</option>
            <option value="8">أغسطس</option>
            <option value="9">سبتمبر</option>
            <option value="10">أكتوبر</option>
            <option value="11">نوفمبر</option>
            <option value="12">ديسمبر</option>
          </select>

          <input
            id="monthCustom"
            type="text"
            dir="ltr"
            placeholder="مثال: 1-6 أو 1,7,12"
          />

          <small>
            1–12
          </small>

        </div>

        <!-- Weekday -->
        <div class="cron-field">

          <div class="field-heading">
            <div class="field-icon">
              <i class="fa-solid fa-calendar-week"></i>
            </div>

            <div>
              <h3>يوم الأسبوع</h3>
              <span>Day of Week</span>
            </div>
          </div>

          <select id="weekday">
            <option value="*" selected>كل الأيام (*)</option>
            <option value="0">الأحد</option>
            <option value="1">الاثنين</option>
            <option value="2">الثلاثاء</option>
            <option value="3">الأربعاء</option>
            <option value="4">الخميس</option>
            <option value="5">الجمعة</option>
            <option value="6">السبت</option>
          </select>

          <input
            id="weekdayCustom"
            type="text"
            dir="ltr"
            placeholder="مثال: 1-5 أو 1,3,5"
          />

          <small>
            0–6
          </small>

        </div>

      </div>

      <!-- Field explanation -->
      <div class="cron-legend">

        <div class="legend-item">
          <strong>*</strong>
          <span>كل القيم</span>
        </div>

        <div class="legend-item">
          <strong>,</strong>
          <span>قيم متعددة</span>
        </div>

        <div class="legend-item">
          <strong>-</strong>
          <span>نطاق</span>
        </div>

        <div class="legend-item">
          <strong>/</strong>
          <span>تكرار</span>
        </div>

      </div>

      <!-- Manual expression -->
      <div class="manual-section">

        <div class="section-label">
          <i class="fa-solid fa-terminal"></i>
          تعديل التعبير يدويًا
        </div>

        <div class="manual-row">

          <input
            id="manualExpression"
            type="text"
            dir="ltr"
            spellcheck="false"
            value="* * * * *"
            placeholder="* * * * *"
          />

          <button id="applyManual" class="primary-btn" type="button">
            <i class="fa-solid fa-check"></i>
            تطبيق
          </button>

        </div>

        <div id="manualMessage" class="manual-message"></div>

      </div>

    </section>

    <!-- Info -->
    <section class="info-grid">

      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-clock"></i>
        </div>

        <h3>ما هو Cron؟</h3>

        <p>
          Cron هو نظام جدولة يستخدم لتشغيل المهام والأوامر تلقائيًا
          في أوقات محددة على أنظمة Unix وLinux وغيرها.
        </p>

      </article>

      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-code"></i>
        </div>

        <h3>صيغة Cron</h3>

        <p>
          يتكون Cron التقليدي من خمسة حقول:
          الدقيقة، الساعة، اليوم، الشهر، ويوم الأسبوع.
        </p>

      </article>

      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-server"></i>
        </div>

        <h3>استخدامات متعددة</h3>

        <p>
          يمكن استخدام Cron للنسخ الاحتياطي، تشغيل السكربتات،
          إرسال التقارير، تنظيف الملفات والمهام المجدولة.
        </p>

      </article>

    </section>

    <!-- Common examples -->
    <section class="content-card">

      <div class="content-heading">

        <span class="heading-icon">
          <i class="fa-solid fa-list-check"></i>
        </span>

        <div>
          <h2>أمثلة Cron شائعة</h2>
          <p>
            بعض التعبيرات الجاهزة التي يمكنك استخدامها مباشرة.
          </p>
        </div>

      </div>

      <div class="examples-table">

        <div class="example-row example-head">
          <span>التعبير</span>
          <span>الوصف</span>
          <span>النسخ</span>
        </div>

        <div class="example-row">
          <code>* * * * *</code>
          <span>كل دقيقة</span>
          <button data-copy-example="* * * * *">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

        <div class="example-row">
          <code>0 * * * *</code>
          <span>كل ساعة</span>
          <button data-copy-example="0 * * * *">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

        <div class="example-row">
          <code>0 0 * * *</code>
          <span>كل يوم عند منتصف الليل</span>
          <button data-copy-example="0 0 * * *">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

        <div class="example-row">
          <code>0 9 * * 1-5</code>
          <span>الساعة 09:00 من الاثنين إلى الجمعة</span>
          <button data-copy-example="0 9 * * 1-5">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

        <div class="example-row">
          <code>0 0 1 * *</code>
          <span>أول يوم من كل شهر</span>
          <button data-copy-example="0 0 1 * *">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

        <div class="example-row">
          <code>*/5 * * * *</code>
          <span>كل 5 دقائق</span>
          <button data-copy-example="*/5 * * * *">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>

      </div>

    </section>

    <!-- How to use -->
    <section class="content-card">

      <div class="content-heading">

        <span class="heading-icon">
          <i class="fa-solid fa-list-ol"></i>
        </span>

        <div>
          <h2>طريقة الاستخدام</h2>
          <p>
            أنشئ Cron Expression في ثلاث خطوات.
          </p>
        </div>

      </div>

      <div class="steps">

        <div class="step">
          <span>01</span>

          <div>
            <h3>اختر الوقت</h3>

            <p>
              حدد الدقيقة والساعة واليوم والشهر ويوم الأسبوع.
            </p>
          </div>
        </div>

        <div class="step">
          <span>02</span>

          <div>
            <h3>راجع التعبير</h3>

            <p>
              سيقوم المولد بإنشاء Cron Expression تلقائيًا.
            </p>
          </div>
        </div>

        <div class="step">
          <span>03</span>

          <div>
            <h3>انسخ التعبير</h3>

            <p>
              اضغط على زر النسخ لاستخدام التعبير في مشروعك.
            </p>
          </div>
        </div>

      </div>

    </section>

    <!-- Tip -->
    <section class="tip-card">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>
        <strong>نصيحة للمطورين</strong>

        <p>
          استخدم <code>*</code> لتمثيل جميع القيم، واستخدم
          <code>/</code> لتحديد الفاصل الزمني، مثل
          <code>*/5</code> لتشغيل المهمة كل خمس دقائق.
        </p>
      </div>

    </section>

    <!-- FAQ -->
    <section class="faq-card">

      <div class="content-heading">

        <span class="heading-icon">
          <i class="fa-solid fa-circle-question"></i>
        </span>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>
            معلومات سريعة حول Cron Expressions.
          </p>
        </div>

      </div>

      <div class="faq-list">

        <details>
          <summary>
            ما هو Cron Expression؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            Cron Expression هو تعبير نصي يحدد متى يجب تنفيذ مهمة
            مجدولة. في صيغة Cron التقليدية يتكون التعبير من خمسة
            حقول تمثل الدقيقة والساعة واليوم والشهر ويوم الأسبوع.
          </p>
        </details>

        <details>
          <summary>
            ماذا يعني * في Cron؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            النجمة <code>*</code> تعني جميع القيم الممكنة للحقل.
            مثلًا <code>* * * * *</code> تعني تشغيل المهمة كل دقيقة.
          </p>
        </details>

        <details>
          <summary>
            ماذا يعني */5؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            الشرطة المائلة تستخدم للتكرار. التعبير
            <code>*/5</code> يعني كل خمس وحدات من الحقل المستخدم.
            لذلك <code>*/5 * * * *</code> يعني كل خمس دقائق.
          </p>
        </details>

        <details>
          <summary>
            هل تعمل الأداة بدون خادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. يتم إنشاء Cron Expression داخل المتصفح مباشرة،
            ولا يتم إرسال البيانات إلى خادم خارجي.
          </p>
        </details>

      </div>

    </section>

  









