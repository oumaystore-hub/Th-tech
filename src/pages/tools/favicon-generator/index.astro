---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Favicon Generator - إنشاء Favicon أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لإنشاء Favicon لموقعك بأحجام متعددة ومعاينة الأيقونة وإنشاء كود HTML جاهز للاستخدام.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- تطبيق الوضع قبل ظهور الصفحة -->
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">

      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>Favicon Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-star"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-globe"></i>
              Web Tools
            </span>

            <h1>
              Favicon <span>Generator</span>
            </h1>

            <p>
              أنشئ أيقونة Favicon لموقعك بأحجام متعددة
              واحصل على معاينة وكود HTML جاهز للاستخدام.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-star"></i>
              <span>Favicon Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ الكود
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Generator -->

          <div class="generator">

            <!-- Upload -->

            <div class="upload-section">

              <input
                id="fileInput"
                type="file"
                accept="image/png,image/jpeg,image/webp,image/svg+xml"
                hidden
              />

              <label
                for="fileInput"
                class="upload-box"
                id="uploadBox"
              >

                <div class="upload-icon">
                  <i class="fas fa-cloud-arrow-up"></i>
                </div>

                <h3>ارفع صورة الأيقونة</h3>

                <p>
                  PNG أو JPG أو WEBP أو SVG
                </p>

                <span class="upload-button">
                  <i class="fas fa-folder-open"></i>
                  اختيار صورة
                </span>

              </label>

              <div
                id="fileInfo"
                class="file-info hidden"
              >
                <i class="fas fa-file-image"></i>
                <span id="fileName"></span>
              </div>

            </div>


            <!-- Preview -->

            <div class="preview-section">

              <div class="panel-title">
                <i class="fas fa-eye"></i>
                معاينة Favicon
              </div>

              <div class="preview-area">

                <div class="preview-main">

                  <div
                    class="favicon-preview large"
                    id="previewLarge"
                  >
                    <span>
                      <i class="fas fa-star"></i>
                    </span>
                  </div>

                  <strong>Preview</strong>

                </div>


                <div class="preview-sizes">

                  <div class="size-preview">

                    <div
                      class="favicon-preview medium"
                      id="previewMedium"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>32 × 32</span>

                  </div>


                  <div class="size-preview">

                    <div
                      class="favicon-preview small"
                      id="previewSmall"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>16 × 16</span>

                  </div>


                  <div class="size-preview">

                    <div
                      class="favicon-preview tiny"
                      id="previewTiny"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>48 × 48</span>

                  </div>

                </div>

              </div>

            </div>


            <!-- Sizes -->

            <div class="sizes-section">

              <div class="panel-title">
                <i class="fas fa-layer-group"></i>
                أحجام الأيقونة
              </div>

              <div class="sizes-grid">

                <label class="size-option">
                  <input
                    type="checkbox"
                    value="16"
                    checked
                  />
                  <span class="check"></span>
                  <strong>16 × 16</strong>
                  <small>Favicon</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="32"
                    checked
                  />
                  <span class="check"></span>
                  <strong>32 × 32</strong>
                  <small>Browser</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="48"
                    checked
                  />
                  <span class="check"></span>
                  <strong>48 × 48</strong>
                  <small>Windows</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="180"
                    checked
                  />
                  <span class="check"></span>
                  <strong>180 × 180</strong>
                  <small>Apple Touch</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="192"
                    checked
                  />
                  <span class="check"></span>
                  <strong>192 × 192</strong>
                  <small>Android</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="512"
                    checked
                  />
                  <span class="check"></span>
                  <strong>512 × 512</strong>
                  <small>PWA</small>
                </label>

              </div>

            </div>


            <!-- Main action -->

            <div class="main-actions">

              <button
                id="generateBtn"
                class="generate-btn"
                type="button"
              >
                <i class="fas fa-wand-magic-sparkles"></i>
                إنشاء Favicon
                <i class="fas fa-arrow-left"></i>
              </button>

            </div>


            <!-- Downloads -->

            <div
              id="results"
              class="results hidden"
            >

              <div class="results-heading">

                <div>
                  <span class="kicker">
                    <i class="fas fa-check-circle"></i>
                    تم الإنشاء
                  </span>

                  <h3>
                    ملفات Favicon جاهزة
                  </h3>
                </div>

                <span id="resultCount">
                  0 ملفات
                </span>

              </div>

              <div
                id="downloadGrid"
                class="download-grid"
              ></div>

            </div>


            <!-- HTML Code -->

            <div
              id="codeSection"
              class="code-section hidden"
            >

              <div class="code-header">

                <div class="panel-title">
                  <i class="fas fa-code"></i>
                  كود HTML
                </div>

                <button
                  id="copyCodeBtn"
                  class="copy-code-btn"
                  type="button"
                >
                  <i class="fas fa-copy"></i>
                  نسخ
                </button>

              </div>

              <pre><code id="htmlCode"></code></pre>

            </div>


            <!-- Status -->

            <div
              id="status"
              class="status hidden"
            >

              <i
                id="statusIcon"
                class="fas fa-check-circle"
              ></i>

              <span id="statusText"></span>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>إنشاء سريع</h3>

              <p>
                أنشئ أحجام Favicon المختلفة مباشرة داخل المتصفح
                بدون الحاجة إلى برنامج خارجي.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>خصوصيتك محفوظة</h3>

              <p>
                تتم معالجة الصورة محلياً داخل متصفحك
                ولا يتم رفعها إلى خادم خارجي.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-mobile-screen-button"></i>
            </div>

            <div>
              <h3>متوافق مع الأجهزة</h3>

              <p>
                يدعم أحجاماً مناسبة للمتصفحات والهواتف
                وApple وAndroid وPWA.
              </p>
            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>Favicon Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-upload"></i>
              </div>

              <h3>ارفع الصورة</h3>

              <p>
                اختر صورة الشعار أو الأيقونة التي تريد استخدامها
                كـ Favicon.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-layer-group"></i>
              </div>

              <h3>اختر الأحجام</h3>

              <p>
                حدد الأحجام التي يحتاجها موقعك
                ثم اضغط على إنشاء Favicon.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-download"></i>
              </div>

              <h3>حمّل الملفات</h3>

              <p>
                حمّل الملفات وأضف كود HTML الناتج
                إلى قسم head في موقعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>Favicon Generator</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو Favicon؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                Favicon هي الأيقونة الصغيرة التي تظهر بجانب عنوان
                الموقع في تبويب المتصفح، وتساعد على تمييز الموقع.
              </p>

            </details>


            <details>

              <summary>
                ما أفضل حجم لـ Favicon؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                حجم 32×32 مناسب للاستخدام الشائع في المتصفحات،
                بينما يمكن استخدام 16×16 و48×48 لتغطية حالات أخرى.
              </p>

            </details>


            <details>

              <summary>
                هل يتم رفع الصورة إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم معالجة الصورة باستخدام JavaScript وCanvas
                داخل المتصفح، ولا تحتاج إلى رفعها إلى خدمة خارجية.
              </p>

            </details>


            <details>

              <summary>
                هل يمكن استخدام Favicon مع الهاتف؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. الأداة توفر أحجاماً مثل 180×180 لأجهزة Apple
                و192×192 و512×512 لتطبيقات الويب وAndroid.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #ea580c;
      --primary-hover: #c2410c;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #fb923c;
      --primary-hover: #f97316;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(234, 88, 12, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(234, 88, 12, .10);
      border: 1px solid rgba(234, 88, 12, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(234, 88, 12, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--primary);
      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;
      margin: 0;
      color: var(--muted);
      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);
      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;

      min-height: 38px;
      padding: 7px 13px;

      border-radius: 10px;
      border: 1px solid var(--border);

      background: var(--card);
      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;
      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(234, 88, 12, .35);
      color: var(--primary);
      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* ================= GENERATOR ================= */

    .generator {
      padding: 25px;
    }


    .upload-section {
      margin-bottom: 25px;
    }


    .upload-box {
      position: relative;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      min-height: 260px;
      padding: 30px;

      border: 2px dashed rgba(234, 88, 12, .25);
      border-radius: 20px;

      background:
        linear-gradient(
          135deg,
          rgba(234, 88, 12, .035),
          rgba(6, 182, 212, .025)
        );

      cursor: pointer;
      text-align: center;

      transition: .25s ease;
    }


    .upload-box:hover {
      border-color: var(--primary);
      background: rgba(234, 88, 12, .055);
      transform: translateY(-2px);
    }


    .upload-icon {
      width: 68px;
      height: 68px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 15px;

      border-radius: 19px;

      background: rgba(234, 88, 12, .10);
      color: var(--primary);

      font-size: 1.7rem;
    }


    .upload-box h3 {
      margin: 0 0 5px;
      font-size: 1rem;
    }


    .upload-box p {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: .75rem;
    }


    .upload-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 9px 17px;

      border-radius: 10px;

      background: var(--primary);
      color: white;

      font-size: .75rem;
      font-weight: 800;

      box-shadow:
        0 8px 20px rgba(234, 88, 12, .20);
    }


    .file-info {
      display: flex;
      align-items: center;
      gap: 9px;

      margin-top: 10px;
      padding: 10px 14px;

      border-radius: 10px;

      background: rgba(22, 163, 74, .07);
      border: 1px solid rgba(22, 163, 74, .15);

      color: var(--green);

      font-size: .75rem;
      font-weight: 700;
    }


    .hidden {
      display: none !important;
    }


    /* ================= PREVIEW ================= */

    .preview-section,
    .sizes-section {
      padding: 22px;
      margin-bottom: 18px;

      border-radius: 18px;
      border: 1px solid var(--border);

      background: var(--card2);
    }


    .panel-title {
      display: flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 20px;

      font-size: .82rem;
      font-weight: 800;
    }


    .panel-title i {
      color: var(--primary);
    }


    .preview-area {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 70px;

      min-height: 180px;
    }


    .preview-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;

      color: var(--muted);
      font-size: .72rem;
    }


    .favicon-preview {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;

      background:
        repeating-conic-gradient(
          #e5e7eb 0 25%,
          #ffffff 0 50%
        ) 50% / 18px 18px;

      border-radius: 12px;
      border: 1px solid var(--border);

      color: var(--primary);
    }


    .favicon-preview img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }


    .favicon-preview.large {
      width: 100px;
      height: 100px;
      border-radius: 18px;
      font-size: 2.5rem;
    }


    .favicon-preview.medium {
      width: 64px;
      height: 64px;
      border-radius: 12px;
      font-size: 1.6rem;
    }


    .favicon-preview.small {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      font-size: 1rem;
    }


    .favicon-preview.tiny {
      width: 50px;
