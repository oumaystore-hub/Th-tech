---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Favicon Generator - إنشاء Favicon أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لإنشاء Favicon لموقعك بأحجام متعددة ومعاينة الأيقونة وإنشاء كود HTML جاهز للاستخدام.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- تطبيق الوضع قبل ظهور الصفحة -->
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">

      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>Favicon Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-star"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-globe"></i>
              Web Tools
            </span>

            <h1>
              Favicon <span>Generator</span>
            </h1>

            <p>
              أنشئ أيقونة Favicon لموقعك بأحجام متعددة
              واحصل على معاينة وكود HTML جاهز للاستخدام.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-star"></i>
              <span>Favicon Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ الكود
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Generator -->

          <div class="generator">

            <!-- Upload -->

            <div class="upload-section">

              <input
                id="fileInput"
                type="file"
                accept="image/png,image/jpeg,image/webp,image/svg+xml"
                hidden
              />

              <label
                for="fileInput"
                class="upload-box"
                id="uploadBox"
              >

                <div class="upload-icon">
                  <i class="fas fa-cloud-arrow-up"></i>
                </div>

                <h3>ارفع صورة الأيقونة</h3>

                <p>
                  PNG أو JPG أو WEBP أو SVG
                </p>

                <span class="upload-button">
                  <i class="fas fa-folder-open"></i>
                  اختيار صورة
                </span>

              </label>

              <div
                id="fileInfo"
                class="file-info hidden"
              >
                <i class="fas fa-file-image"></i>
                <span id="fileName"></span>
              </div>

            </div>


            <!-- Preview -->

            <div class="preview-section">

              <div class="panel-title">
                <i class="fas fa-eye"></i>
                معاينة Favicon
              </div>

              <div class="preview-area">

                <div class="preview-main">

                  <div
                    class="favicon-preview large"
                    id="previewLarge"
                  >
                    <span>
                      <i class="fas fa-star"></i>
                    </span>
                  </div>

                  <strong>Preview</strong>

                </div>


                <div class="preview-sizes">

                  <div class="size-preview">

                    <div
                      class="favicon-preview medium"
                      id="previewMedium"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>32 × 32</span>

                  </div>


                  <div class="size-preview">

                    <div
                      class="favicon-preview small"
                      id="previewSmall"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>16 × 16</span>

                  </div>


                  <div class="size-preview">

                    <div
                      class="favicon-preview tiny"
                      id="previewTiny"
                    >
                      <i class="fas fa-star"></i>
                    </div>

                    <span>48 × 48</span>

                  </div>

                </div>

              </div>

            </div>


            <!-- Sizes -->

            <div class="sizes-section">

              <div class="panel-title">
                <i class="fas fa-layer-group"></i>
                أحجام الأيقونة
              </div>

              <div class="sizes-grid">

                <label class="size-option">
                  <input
                    type="checkbox"
                    value="16"
                    checked
                  />
                  <span class="check"></span>
                  <strong>16 × 16</strong>
                  <small>Favicon</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="32"
                    checked
                  />
                  <span class="check"></span>
                  <strong>32 × 32</strong>
                  <small>Browser</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="48"
                    checked
                  />
                  <span class="check"></span>
                  <strong>48 × 48</strong>
                  <small>Windows</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="180"
                    checked
                  />
                  <span class="check"></span>
                  <strong>180 × 180</strong>
                  <small>Apple Touch</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="192"
                    checked
                  />
                  <span class="check"></span>
                  <strong>192 × 192</strong>
                  <small>Android</small>
                </label>


                <label class="size-option">
                  <input
                    type="checkbox"
                    value="512"
                    checked
                  />
                  <span class="check"></span>
                  <strong>512 × 512</strong>
                  <small>PWA</small>
                </label>

              </div>

            </div>


            <!-- Main action -->

            <div class="main-actions">

              <button
                id="generateBtn"
                class="generate-btn"
                type="button"
              >
                <i class="fas fa-wand-magic-sparkles"></i>
                إنشاء Favicon
                <i class="fas fa-arrow-left"></i>
              </button>

            </div>


            <!-- Downloads -->

            <div
              id="results"
              class="results hidden"
            >

              <div class="results-heading">

                <div>
                  <span class="kicker">
                    <i class="fas fa-check-circle"></i>
                    تم الإنشاء
                  </span>

                  <h3>
                    ملفات Favicon جاهزة
                  </h3>
                </div>

                <span id="resultCount">
                  0 ملفات
                </span>

              </div>

              <div
                id="downloadGrid"
                class="download-grid"
              ></div>

            </div>


            <!-- HTML Code -->

            <div
              id="codeSection"
              class="code-section hidden"
            >

              <div class="code-header">

                <div class="panel-title">
                  <i class="fas fa-code"></i>
                  كود HTML
                </div>

                <button
                  id="copyCodeBtn"
                  class="copy-code-btn"
                  type="button"
                >
                  <i class="fas fa-copy"></i>
                  نسخ
                </button>

              </div>

              <pre><code id="htmlCode"></code></pre>

            </div>


            <!-- Status -->

            <div
              id="status"
              class="status hidden"
            >

              <i
                id="statusIcon"
                class="fas fa-check-circle"
              ></i>

              <span id="statusText"></span>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>إنشاء سريع</h3>

              <p>
                أنشئ أحجام Favicon المختلفة مباشرة داخل المتصفح
                بدون الحاجة إلى برنامج خارجي.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>خصوصيتك محفوظة</h3>

              <p>
                تتم معالجة الصورة محلياً داخل متصفحك
                ولا يتم رفعها إلى خادم خارجي.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-mobile-screen-button"></i>
            </div>

            <div>
              <h3>متوافق مع الأجهزة</h3>

              <p>
                يدعم أحجاماً مناسبة للمتصفحات والهواتف
                وApple وAndroid وPWA.
              </p>
            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>Favicon Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-upload"></i>
              </div>

              <h3>ارفع الصورة</h3>

              <p>
                اختر صورة الشعار أو الأيقونة التي تريد استخدامها
                كـ Favicon.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-layer-group"></i>
              </div>

              <h3>اختر الأحجام</h3>

              <p>
                حدد الأحجام التي يحتاجها موقعك
                ثم اضغط على إنشاء Favicon.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-download"></i>
              </div>

              <h3>حمّل الملفات</h3>

              <p>
                حمّل الملفات وأضف كود HTML الناتج
                إلى قسم head في موقعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>Favicon Generator</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو Favicon؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                Favicon هي الأيقونة الصغيرة التي تظهر بجانب عنوان
                الموقع في تبويب المتصفح، وتساعد على تمييز الموقع.
              </p>

            </details>


            <details>

              <summary>
                ما أفضل حجم لـ Favicon؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                حجم 32×32 مناسب للاستخدام الشائع في المتصفحات،
                بينما يمكن استخدام 16×16 و48×48 لتغطية حالات أخرى.
              </p>

            </details>


            <details>

              <summary>
                هل يتم رفع الصورة إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم معالجة الصورة باستخدام JavaScript وCanvas
                داخل المتصفح، ولا تحتاج إلى رفعها إلى خدمة خارجية.
              </p>

            </details>


            <details>

              <summary>
                هل يمكن استخدام Favicon مع الهاتف؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. الأداة توفر أحجاماً مثل 180×180 لأجهزة Apple
                و192×192 و512×512 لتطبيقات الويب وAndroid.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #ea580c;
      --primary-hover: #c2410c;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #fb923c;
      --primary-hover: #f97316;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 
