  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME SYNC ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme = event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {
            applyTheme(theme === 'dark');
          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      window.addEventListener(
        'storage',
        (event) => {

          if (event.key === 'theme') {

            applyTheme(
              event.newValue === 'dark'
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const fileInput =
        document.getElementById('fileInput');

      const uploadBox =
        document.getElementById('uploadBox');

      const fileInfo =
        document.getElementById('fileInfo');

      const fileName =
        document.getElementById('fileName');

      const generateBtn =
        document.getElementById('generateBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const copyCodeBtn =
        document.getElementById('copyCodeBtn');

      const results =
        document.getElementById('results');

      const downloadGrid =
        document.getElementById('downloadGrid');

      const resultCount =
        document.getElementById('resultCount');

      const codeSection =
        document.getElementById('codeSection');

      const htmlCode =
        document.getElementById('htmlCode');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const previewLarge =
        document.getElementById('previewLarge');

      const previewMedium =
        document.getElementById('previewMedium');

      const previewSmall =
        document.getElementById('previewSmall');

      const previewTiny =
        document.getElementById('previewTiny');


      let sourceImage = null;
      let sourceObjectUrl = null;


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add('hidden');

      };


      /* ================= PREVIEW ================= */

      const setPreviewImage = (element, src) => {

        element.innerHTML = '';

        const img =
          document.createElement('img');

        img.src = src;
        img.alt = 'Favicon Preview';

        element.appendChild(img);

      };


      /* ================= FILE ================= */

      fileInput.addEventListener(
        'change',
        () => {

          hideStatus();

          const file =
            fileInput.files?.[0];

          if (!file) {
            return;
          }


          if (file.size > 10 * 1024 * 1024) {

            showStatus(
              'حجم الصورة يجب ألا يتجاوز 10 MB.',
              true
            );

            fileInput.value = '';

            return;

          }


          const allowed =
            [
              'image/png',
              'image/jpeg',
              'image/webp',
              'image/svg+xml'
            ];


          if (!allowed.includes(file.type)) {

            showStatus(
              'نوع الصورة غير مدعوم.',
              true
            );

            fileInput.value = '';

            return;

          }


          if (sourceObjectUrl) {

            URL.revokeObjectURL(
              sourceObjectUrl
            );

          }


          sourceObjectUrl =
            URL.createObjectURL(file);


          const img =
            new Image();


          img.onload = () => {

            sourceImage = img;

            fileName.textContent =
              `${file.name} — ${(
                file.size / 1024
              ).toFixed(1)} KB`;

            fileInfo.classList.remove(
              'hidden'
            );


            setPreviewImage(
              previewLarge,
              sourceObjectUrl
            );

            setPreviewImage(
              previewMedium,
              sourceObjectUrl
            );

            setPreviewImage(
              previewSmall,
              sourceObjectUrl
            );

            setPreviewImage(
              previewTiny,
              sourceObjectUrl
            );


            showStatus(
              'تم تحميل الصورة بنجاح. يمكنك الآن إنشاء Favicon.'
            );

          };


          img.onerror = () => {

            sourceImage = null;

            showStatus(
              'تعذر قراءة الصورة.',
              true
            );

          };


          img.src =
            sourceObjectUrl;

        }
      );


      /* ================= CANVAS ================= */

      const createIcon = (size) => {

        return new Promise(
          (resolve, reject) => {

            if (!sourceImage) {

              reject(
                new Error(
                  'No image'
                )
              );

              return;

            }


            const canvas =
              document.createElement(
                'canvas'
              );


            canvas.width = size;
            canvas.height = size;


            const ctx =
              canvas.getContext(
                '2d'
              );


            if (!ctx) {

              reject(
                new Error(
                  'Canvas unavailable'
                )
              );

              return;

            }


            ctx.clearRect(
              0,
              0,
              size,
              size
            );


            /*
             * نحافظ على تناسب الصورة
             * بدون تشويه.
             */

            const ratio =
              Math.min(
                size / sourceImage.naturalWidth,
                size / sourceImage.naturalHeight
              );


            const width =
              sourceImage.naturalWidth *
              ratio;


            const height =
              sourceImage.naturalHeight *
              ratio;


            const x =
              (size - width) / 2;


            const y =
              (size - height) / 2;


            ctx.imageSmoothingEnabled =
              true;

            ctx.imageSmoothingQuality =
              'high';


            ctx.drawImage(
              sourceImage,
              x,
              y,
              width,
              height
            );


            canvas.toBlob(
              (blob) => {

                if (blob) {
                  resolve(blob);
                } else {
                  reject(
                    new Error(
                      'Failed to create image'
                    )
                  );
                }

              },
              'image/png'
            );

          }
        );

      };


      /* ================= DOWNLOAD ================= */

      const downloadBlob = (
        blob,
        filename
      ) => {

        const url =
          URL.createObjectURL(blob);

        const link =
          document.createElement('a');

        link.href = url;
        link.download = filename;

        document.body.appendChild(link);

        link.click();

        link.remove();

        setTimeout(
          () => URL.revokeObjectURL(url),
          1000
        );

      };


      /* ================= GENERATE ================= */

      const generateFavicon = async () => {

        hideStatus();


        if (!sourceImage) {

          showStatus(
            'اختر صورة أولاً لإنشاء Favicon.',
            true
          );

          return;

        }


        const selected =
          Array.from(
            document.querySelectorAll(
              '.size-option input:checked'
            )
          );


        if (!selected.length) {

          showStatus(
            'اختر حجماً واحداً على الأقل.',
            true
          );

          return;

        }


        generateBtn.disabled = true;

        generateBtn.innerHTML =
          '<i class="fas fa-spinner fa-spin"></i> جاري الإنشاء...';


        downloadGrid.innerHTML = '';

        results.classList.remove(
          'hidden'
        );

        codeSection.classList.add(
          'hidden'
        );


        const generated =
          [];


        try {

          for (const checkbox of selected) {

            const size =
              Number(
                checkbox.value
              );

            const blob =
              await createIcon(size);

            const filename =
              `favicon-${size}x${size}.png`;


            generated.push({
              size,
              blob,
              filename
            });

          }


          generated.forEach(
            (item) => {

              const url =
                URL.createObjectURL(
                  item.blob
                );


              const div =
                document.createElement(
                  'div'
                );

              div.className =
                'download-item';


              div.innerHTML = `
                <div class="download-icon">
                  <i class="fas fa-image"></i>
                </div>

                <div class="download-info">
                  <strong>${item.filename}</strong>
                  <span>${item.size} × ${item.size} PNG</span>
                </div>

                <a
                  class="download-link"
                  href="${url}"
                  download="${item.filename}"
                  title="تحميل"
                >
                  <i class="fas fa-download"></i>
                </a>
              `;


              downloadGrid.appendChild(
                div
              );

            }
          );


          resultCount.textContent =
            `${generated.length} ملفات`;


          /*
           * HTML جاهز.
           * نستخدم favicon-32x32 كأيقونة أساسية
           * إذا كانت متوفرة، وإلا أول حجم.
           */

          const has32 =
            generated.some(
              item => item.size === 32
            );


          const primary =
            has32
              ? 'favicon-32x32.png'
              : generated[0].filename;


          const apple =
            generated.some(
              item => item.size === 180
            )
              ? 'favicon-180x180.png'
              : primary;


          const android =
            generated.some(
              item => item.size === 192
            )
              ? 'favicon-192x192.png'
              : primary;


          const lines = [];


          lines.push(
            `<link rel="icon" type="image/png" sizes="32x32" href="/${primary}">`
          );


          if (
            generated.some(
              item => item.size === 16
            )
          ) {

            lines.push(
              `<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">`
            );

          }


          if (
            generated.some(
              item => item.size === 48
            )
          ) {

            lines.push(
              `<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">`
            );

          }


          if (
            generated.some(
              item => item.size === 180
            )
          ) {

            lines.push(
              `<link rel="apple-touch-icon" sizes="180x180" href="/${apple}">`
            );

          }


          if (
            generated.some(
              item => item.size === 192
            )
          ) {

            lines.push(
              `<link rel="icon" type="image/png" sizes="192x192" href="/${android}">`
            );

          }


          if (
            generated.some(
              item => item.size === 512
            )
          ) {

            lines.push(
              `<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">`
            );

          }


          htmlCode.textContent =
            lines.join('\n');


          codeSection.classList.remove(
            'hidden'
          );


          showStatus(
            'تم إنشاء ملفات Favicon بنجاح.'
          );


        } catch {

          showStatus(
            'حدث خطأ أثناء إنشاء ملفات Favicon.',
            true
          );

        } finally {

          generateBtn.disabled = false;

          generateBtn.innerHTML =
            '<i class="fas fa-wand-magic-sparkles"></i> إنشاء Favicon <i class="fas fa-arrow-left"></i>';

        }

      };


      /* ================= COPY CODE ================= */

      const copyText = async (
        text
      ) => {

        try {

          await navigator.clipboard.writeText(
            text
          );

          return true;

        } catch {

          const textarea =
            document.createElement(
              'textarea'
            );

          textarea.value = text;

          textarea.style.position =
            'fixed';

          textarea.style.opacity =
            '0';

          document.body.appendChild(
            textarea
          );

          textarea.select();

          const success =
            document.execCommand(
              'copy'
            );

          textarea.remove();

          return success;

        }

      };


      const copyHTML = async () => {

        const text =
          htmlCode.textContent || '';


        if (!text) {

          showStatus(
            'لا يوجد كود لنسخه.',
            true
          );

          return;

        }


        const success =
          await copyText(text);


        if (success) {

          copyCodeBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          showStatus(
            'تم نسخ كود HTML بنجاح.'
          );


          setTimeout(
            () => {

              copyCodeBtn.innerHTML =
                '<i class="fas fa-copy"></i> نسخ';

            },
            1800
          );

        } else {

          showStatus(
            'تعذر نسخ الكود.',
            true
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        fileInput.value = '';

        sourceImage = null;


        if (sourceObjectUrl) {

          URL.revokeObjectURL(
            sourceObjectUrl
          );

          sourceObjectUrl = null;

        }


        fileInfo.classList.add(
          'hidden'
        );


        results.classList.add(
          'hidden'
        );


        codeSection.classList.add(
          'hidden'
        );


        downloadGrid.innerHTML = '';

        htmlCode.textContent = '';

        hideStatus();


        previewLarge.innerHTML =
          '<span><i class="fas fa-star"></i></span>';

        previewMedium.innerHTML =
          '<i class="fas fa-star"></i>';

        previewSmall.innerHTML =
          '<i class="fas fa-star"></i>';

        previewTiny.innerHTML =
          '<i class="fas fa-star"></i>';

      };


      /* ================= EVENTS ================= */

      generateBtn.addEventListener(
        'click',
        generateFavicon
      );


      copyCodeBtn.addEventListener(
        'click',
        copyHTML
      );


      copyBtn.addEventListener(
        'click',
        copyHTML
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      /* ================= INITIAL ================= */

      hideStatus();

    })();
  </script>

</body>
</html>
