<script is:inline>
  (() => {

    const input =
      document.getElementById("sqlInput");

    const validateBtn =
      document.getElementById("validateBtn");

    const clearBtn =
      document.getElementById("clearBtn");

    const exampleBtn =
      document.getElementById("exampleBtn");

    const copyBtn =
      document.getElementById("copyBtn");

    const lineNumbers =
      document.getElementById("lineNumbers");

    const inputStats =
      document.getElementById("inputStats");

    const statusText =
      document.getElementById("statusText");

    const statusDot =
      document.getElementById("statusDot");

    const resultIcon =
      document.getElementById("resultIcon");

    const resultTitle =
      document.getElementById("resultTitle");

    const resultSubtitle =
      document.getElementById("resultSubtitle");

    const resultBadge =
      document.getElementById("resultBadge");

    const resultContent =
      document.getElementById("resultContent");

    const statementType =
      document.getElementById("statementType");

    const lineCount =
      document.getElementById("lineCount");

    const issueCount =
      document.getElementById("issueCount");

    const validState =
      document.getElementById("validState");


    function updateLines() {

      const value = input.value;

      const lines =
        Math.max(
          1,
          value.split("\n").length
        );

      lineNumbers.textContent =
        Array.from(
          { length: lines },
          (_, index) => index + 1
        ).join("\n");

      inputStats.textContent =
        `${lines} سطر · ${value.length} حرف`;

      lineCount.textContent =
        value.trim()
          ? lines
          : 0;
    }


    function setStatus(
      text,
      type = "neutral"
    ) {

      statusText.textContent = text;

      statusDot.className =
        "status-dot";

      if (type === "success") {
        statusDot.classList.add(
          "success"
        );
      }

      if (type === "error") {
        statusDot.classList.add(
          "error"
        );
      }

      if (type === "warning") {
        statusDot.classList.add(
          "warning"
        );
      }

      if (type === "processing") {
        statusDot.classList.add(
          "processing"
        );
      }
    }


    function detectType(sql) {

      const cleaned =
        sql
          .trim()
          .replace(/^--.*$/gm, "")
          .trim();

      const match =
        cleaned.match(
          /^(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|WITH|MERGE|REPLACE)\b/i
        );

      if (!match) {
        return "UNKNOWN";
      }

      return match[1].toUpperCase();
    }


    function checkBalanced(
      text,
      open,
      close
    ) {

      let count = 0;

      let quote = null;

      for (
        let i = 0;
        i < text.length;
        i++
      ) {

        const char = text[i];

        if (
          quote &&
          char === quote
        ) {

          if (
            text[i + 1] === quote
          ) {
            i++;
            continue;
          }

          quote = null;
          continue;
        }

        if (
          !quote &&
          (
            char === "'" ||
            char === '"' ||
            char === "`"
          )
        ) {
          quote = char;
          continue;
        }

        if (!quote) {

          if (char === open) {
            count++;
          }

          if (char === close) {
            count--;

            if (count < 0) {
              return false;
            }
          }
        }
      }

      return count === 0;
    }


    function checkQuotes(sql) {

      let quote = null;

      for (
        let i = 0;
        i < sql.length;
        i++
      ) {

        const char = sql[i];

        if (
          quote &&
          char === quote
        ) {

          if (
            sql[i + 1] === quote
          ) {
            i++;
            continue;
          }

          quote = null;
          continue;
        }

        if (
          !quote &&
          (
            char === "'" ||
            char === '"' ||
            char === "`"
          )
        ) {
          quote = char;
        }
      }

      return quote === null;
    }


    function analyzeSQL(sql) {

      const issues = [];
      const warnings = [];

      const trimmed =
        sql.trim();

      if (!trimmed) {

        issues.push({
          title: "الاستعلام فارغ",
          detail:
            "أدخل استعلام SQL حتى يمكن التحقق منه."
        });

        return {
          valid: false,
          issues,
          warnings,
          type: "—"
        };
      }


      const type =
        detectType(sql);


      if (type === "UNKNOWN") {

        issues.push({
          title: "نوع SQL غير معروف",
          detail:
            "يجب أن يبدأ الاستعلام بأمر SQL معروف مثل SELECT أو INSERT أو UPDATE أو DELETE."
        });

      }


      if (
        !checkBalanced(
          sql,
          "(",
          ")"
        )
      ) {

        issues.push({
          title: "أقواس غير متطابقة",
          detail:
            "تحقق من عدد الأقواس المفتوحة والمغلقة في الاستعلام."
        });

      }


      if (!checkQuotes(sql)) {

        issues.push({
          title: "علامة اقتباس غير مغلقة",
          detail:
            "يوجد نص يبدأ بعلامة اقتباس ولم يتم إغلاقه بشكل صحيح."
        });

      }


      const upper =
        sql
          .replace(
            /'(?:''|[^'])*'/g,
            "STRING"
          )
          .replace(
            /"(?:[""]|[^"])*"/g,
            "IDENTIFIER"
          )
          .toUpperCase();


      if (type === "SELECT") {

        if (!/\bFROM\b/.test(upper)) {

          issues.push({
            title: "SELECT بدون FROM",
            detail:
              "استعلام SELECT يحتاج عادةً إلى FROM عندما يتم جلب بيانات من جدول."
          });

        }


        if (
          /\bWHERE\b/.test(upper) &&
          !/\bFROM\b/.test(upper)
        ) {

          issues.push({
            title: "WHERE في موضع غير صحيح",
            detail:
              "يجب استخدام WHERE بعد مصدر البيانات."
          });

        }


        if (
          /\bORDER\s*$/.test(upper)
        ) {

          issues.push({
            title: "ORDER BY غير مكتمل",
            detail:
              "يجب تحديد العمود بعد ORDER BY."
          });

        }


        if (
          /\bGROUP\s*$/.test(upper)
        ) {

          issues.push({
            title: "GROUP BY غير مكتمل",
            detail:
              "يجب تحديد العمود بعد GROUP BY."
          });

        }


        if (
          /\bJOIN\b/.test(upper) &&
          !/\bON\b/.test(upper)
        ) {

          warnings.push({
            title: "JOIN بدون ON",
            detail:
              "تحقق من أن JOIN يحتوي على شرط ON مناسب."
          });

        }

      }


      if (type === "UPDATE") {

        if (!/\bSET\b/.test(upper)) {

          issues.push({
            title: "UPDATE بدون SET",
            detail:
              "يجب أن يحتوي UPDATE على عبارة SET."
          });

        }

      }


      if (type === "INSERT") {

        if (!/\bINTO\b/.test(upper)) {

          issues.push({
            title: "INSERT بدون INTO",
            detail:
              "يجب تحديد الجدول باستخدام INTO."
          });

        }

        if (
          !/\bVALUES\b/.test(upper) &&
          !/\bSELECT\b/.test(upper)
        ) {

          warnings.push({
            title: "INSERT بدون VALUES أو SELECT",
            detail:
              "تحقق من طريقة إدخال البيانات."
          });

        }

      }


      if (type === "DELETE") {

        if (!/\bFROM\b/.test(upper)) {

          issues.push({
            title: "DELETE بدون FROM",
            detail:
              "يجب تحديد الجدول باستخدام FROM."
          });

        }

        if (
          !/\bWHERE\b/.test(upper)
        ) {

          warnings.push({
            title: "DELETE بدون WHERE",
            detail:
              "قد يؤدي DELETE بدون WHERE إلى حذف جميع الصفوف."
          });

        }

      }


      if (type === "UPDATE") {

        if (
          !/\bWHERE\b/.test(upper)
        ) {

          warnings.push({
            title: "UPDATE بدون WHERE",
            detail:
              "قد يؤدي UPDATE بدون WHERE إلى تعديل جميع الصفوف."
          });

        }

      }


      if (
        /\bSELECT\s+FROM\b/i.test(sql)
      ) {

        issues.push({
          title: "SELECT بدون أعمدة",
          detail:
            "حدد الأعمدة المطلوبة أو استخدم SELECT *."
        });

      }


      if (
        /\bWHERE\s*(ORDER|GROUP|LIMIT|;|$)/i.test(sql)
      ) {

        issues.push({
          title: "WHERE بدون شرط",
          detail:
            "عبارة WHERE تحتاج إلى شرط صالح."
        });

      }


      if (
        /,\s*(FROM|WHERE|GROUP|ORDER|LIMIT)\b/i.test(sql)
      ) {

        issues.push({
          title: "فاصلة زائدة",
          detail:
            "قد توجد فاصلة زائدة قبل عبارة SQL التالية."
        });

      }


      if (
        /\bSELECT\s+\*/i.test(sql)
      ) {

        warnings.push({
          title: "استخدام SELECT *",
          detail:
            "يفضل تحديد الأعمدة المطلوبة في الاستعلامات الإنتاجية عند الإمكان."
        });

      }


      return {
        valid:
          issues.length === 0,

        issues,
        warnings,
        type
      };
    }


    function renderResult(
      analysis
    ) {

      const {
        valid,
        issues,
        warnings,
        type
      } = analysis;


      issueCount.textContent =
        issues.length + warnings.length;

      statementType.textContent =
        type;

      validState.textContent =
        valid
          ? "صالح"
          : "يحتاج إصلاح";


      if (valid) {

        setStatus(
          warnings.length
            ? "صالح مع تنبيهات"
            : "SQL صالح",
          warnings.length
            ? "warning"
            : "success"
        );

        resultIcon.className =
          "result-icon success";

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-check"></i>`;

        resultTitle.textContent =
          warnings.length
            ? "SQL صالح مع تنبيهات"
            : "SQL صالح";

        resultSubtitle.textContent =
          warnings.length
            ? "لم يتم العثور على أخطاء أساسية، ولكن توجد بعض التنبيهات."
            : "لم يتم العثور على أخطاء أساسية في الاستعلام.";

        resultBadge.className =
          warnings.length
            ? "result-badge warning"
            : "result-badge success";

        resultBadge.textContent =
          warnings.length
            ? `${warnings.length} تنبيه`
            : "Valid";

      } else {

        setStatus(
          `${issues.length} مشكلة`,
          "error"
        );

        resultIcon.className =
          "result-icon error";

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-xmark"></i>`;

        resultTitle.textContent =
          "SQL يحتاج إلى إصلاح";

        resultSubtitle.textContent =
          "تم العثور على مشكلات في الاستعلام.";

        resultBadge.className =
          "result-badge error";

        resultBadge.textContent =
          `${issues.length} خطأ`;
      }


      let html = "";


      if (issues.length) {

        html += `
          <div class="messages-section">
            <div class="messages-heading error-heading">
              <i class="fa-solid fa-circle-xmark"></i>
              الأخطاء
            </div>

            <div class="messages-list">
        `;

        issues.forEach((item) => {

          html += `
            <div class="message error-message">
              <div class="message-icon">
                <i class="fa-solid fa-xmark"></i>
              </div>

              <div>
                <strong>${item.title}</strong>
                <p>${item.detail}</p>
              </div>
            </div>
          `;

        });

        html += `
            </div>
          </div>
        `;

      }


      if (warnings.length) {

        html += `
          <div class="messages-section">
            <div class="messages-heading warning-heading">
              <i class="fa-solid fa-triangle-exclamation"></i>
              التنبيهات
            </div>

            <div class="messages-list">
        `;

        warnings.forEach((item) => {

          html += `
            <div class="message warning-message">
              <div class="message-icon">
                <i class="fa-solid fa-exclamation"></i>
              </div>

              <div>
                <strong>${item.title}</strong>
                <p>${item.detail}</p>
              </div>
            </div>
          `;

        });

        html += `
            </div>
          </div>
        `;

      }


      if (
        !issues.length &&
        !warnings.length
      ) {

        html = `
          <div class="success-result">

            <div class="success-large-icon">
              <i class="fa-solid fa-shield-check"></i>
            </div>

            <h3>
              الاستعلام يبدو صالحاً
            </h3>

            <p>
              لم يتم اكتشاف أخطاء أو تنبيهات في الفحص الأساسي.
            </p>

            <div class="success-note">
              <i class="fa-solid fa-circle-info"></i>
              التحقق يتم بناءً على تحليل نص SQL وليس تنفيذ الاستعلام.
            </div>

          </div>
        `;

      }


      resultContent.innerHTML =
        html;
    }


    function validate() {

      setStatus(
        "جارٍ التحقق...",
        "processing"
      );

      const sql =
        input.value;

      setTimeout(() => {

        const analysis =
          analyzeSQL(sql);

        renderResult(
          analysis
        );

        updateLines();

      }, 100);

    }


    function loadExample() {

      input.value =
`SELECT
    u.id,
    u.name,
    u.email,
    COUNT(o.id) AS orders_count
FROM users u
LEFT JOIN orders o
    ON o.user_id = u.id
WHERE u.status = 'active'
GROUP BY u.id, u.name, u.email
ORDER BY u.created_at DESC
LIMIT 50;`;

      updateLines();

      validate();

      input.focus();
    }


    function clearAll() {

      input.value = "";

      updateLines();

      resultIcon.className =
        "result-icon neutral";

      resultIcon.innerHTML =
        `<i class="fa-solid fa-circle-question"></i>`;

      resultTitle.textContent =
        "Validation Result";

      resultSubtitle.textContent =
        "نتيجة التحقق";

      resultBadge.className =
        "result-badge neutral";

      resultBadge.textContent =
        "غير مفحوص";

      resultContent.innerHTML = `
        <div class="empty-result">

          <div class="empty-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h3>
            جاهز لفحص SQL
          </h3>

          <p>
            أدخل استعلام SQL ثم اضغط
            «تحقق من SQL» لبدء التحليل.
          </p>

        </div>
      `;

      statementType.textContent =
        "—";

      lineCount.textContent =
        "0";

      issueCount.textContent =
        "0";

      validState.textContent =
        "—";

      setStatus(
        "جاهز للتحقق",
        "neutral"
      );

    }


    async function copySQL() {

      if (!input.value.trim()) {

        setStatus(
          "لا يوجد SQL للنسخ",
          "warning"
        );

        return;
      }

      try {

        await navigator.clipboard.writeText(
          input.value
        );

        const old =
          copyBtn.innerHTML;

        copyBtn.innerHTML =
          `<i class="fa-solid fa-check"></i> تم النسخ`;

        setStatus(
          "تم نسخ SQL",
          "success"
        );

        setTimeout(() => {

          copyBtn.innerHTML =
            old;

          setStatus(
            "جاهز للتحقق",
            "neutral"
          );

        }, 1500);

      } catch {

        input.select();

        document.execCommand(
          "copy"
        );

        setStatus(
          "تم النسخ",
          "success"
        );
      }

    }


    input.addEventListener(
      "input",
      updateLines
    );


    input.addEventListener(
      "scroll",
      () => {
        lineNumbers.scrollTop =
          input.scrollTop;
      }
    );


    input.addEventListener(
      "keydown",
      (event) => {

        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {

          event.preventDefault();

          validate();
        }


        if (event.key === "Tab") {

          event.preventDefault();

          const start =
            input.selectionStart;

          const end =
            input.selectionEnd;

          input.value =
            input.value.substring(
              0,
              start
            ) +
            "  " +
            input.value.substring(
              end
            );

          input.selectionStart =
            input.selectionEnd =
              start + 2;

          updateLines();
        }

      }
    );


    validateBtn.addEventListener(
      "click",
      validate
    );

    clearBtn.addEventListener(
      "click",
      clearAll
    );

    exampleBtn.addEventListener(
      "click",
      loadExample
    );

    copyBtn.addEventListener(
      "click",
      copySQL
    );


    updateLines();

  })();
</script>


