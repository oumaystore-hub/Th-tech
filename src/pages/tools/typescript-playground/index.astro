          45px;

        flex:
          0 0 45px;

        padding:
          15px 8px;

        background:
          rgba(0,0,0,.14);

        border-right:
          1px solid
          rgba(255,255,255,.05);

        color:
          #475569;

        text-align:
          right;

        white-space:
          pre;

        overflow:
          hidden;

        user-select:
          none;

        font:
          12px/1.8
          "JetBrains Mono",
          monospace;

      }


      textarea {

        width:
          100%;

        height:
          100%;

        resize:
          none;

        outline:
          none;

        border:
          0;

        padding:
          15px;

        background:
          var(--code-bg);

        color:
          var(--code-text);

        font:
          12px/1.8
          "JetBrains Mono",
          monospace;

        direction:
          ltr;

        text-align:
          left;

        tab-size:
          2;

      }


      textarea::placeholder {

        color:
          #475569;

      }


      .editor-foot {

        min-height:
          38px;

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          0 13px;

        border-top:
          1px solid
          rgba(255,255,255,.06);

        color:
          #64748b;

        font-size:
          9px;

      }


      .editor-foot span {

        display:
          flex;

        align-items:
          center;

        gap:
          5px;

      }


      /* CONSOLE */

      .console-card {

        margin:
          0 16px 16px;

        overflow:
          hidden;

        border:
          1px solid
          rgba(148,163,184,.12);

        border-radius:
          16px;

        background:
          #07141a;

        color:
          #e2f5f8;

      }


      .console-head {

        height:
          52px;

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          0 14px;

        background:
          #0a1d25;

        border-bottom:
          1px solid
          rgba(255,255,255,.06);

      }


      .console-title {

        display:
          flex;

        align-items:
          center;

        gap:
          9px;

      }


      .console-icon {

        width:
          31px;

        height:
          31px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          8px;

        background:
          rgba(34,211,238,.10);

        color:
          #67e8f9;

        font-size:
          11px;

      }


      .console-title strong {

        display:
          block;

        font-size:
          11px;

      }


      .console-title small {

        display:
          block;

        margin-top:
          1px;

        color:
          #64748b;

        font-size:
          9px;

      }


      .console-clear {

        display:
          inline-flex;

        align-items:
          center;

        gap:
          6px;

        padding:
          7px 10px;

        border:
          1px solid
          rgba(255,255,255,.08);

        border-radius:
          8px;

        background:
          transparent;

        color:
          #94a3b8;

        cursor:
          pointer;

        font-size:
          9px;

      }


      .console-clear:hover {

        color:
          #67e8f9;

        border-color:
          rgba(34,211,238,.25);

      }


      .console-output {

        min-height:
          150px;

        max-height:
          260px;

        overflow:
          auto;

        padding:
          15px;

        direction:
          ltr;

        text-align:
          left;

        font:
          12px/1.8
          "JetBrains Mono",
          monospace;

      }


      .console-placeholder {

        min-height:
          120px;

        display:
          flex;

        flex-direction:
          column;

        align-items:
          center;

        justify-content:
          center;

        gap:
          9px;

        color:
          #475569;

        font-size:
          10px;

      }


      .console-placeholder i {

        font-size:
          22px;

        opacity:
          .7;

      }


      .console-line {

        display:
          flex;

        align-items:
          flex-start;

        gap:
          8px;

        padding:
          5px 0;

        white-space:
          pre-wrap;

        word-break:
          break-word;

      }


      .console-line-icon {

        flex:
          0 0 auto;

        width:
          16px;

        padding-top:
          2px;

        color:
          #67e8f9;

      }


      .console-line.warn .console-line-icon {

        color:
          #fbbf24;

      }


      .console-line.error .console-line-icon {

        color:
          #f87171;

      }


      .console-line-text {

        color:
          #dbeafe;

      }


      .console-line.error .console-line-text {

        color:
          #fca5a5;

      }


      .console-line.warn .console-line-text {

        color:
          #fde68a;

      }


      .console-foot {

        min-height:
          38px;

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          0 13px;

        border-top:
          1px solid
          rgba(255,255,255,.06);

        color:
          #64748b;

        font:
          9px
          "JetBrains Mono",
          monospace;

      }


      /* STATUS */

      .status {

        display:
          flex;

        align-items:
          center;

        gap:
          6px;

      }


      .status-dot {

        width:
          6px;

        height:
          6px;

        border-radius:
          50%;

        background:
          #64748b;

      }


      .status.success {

        color:
          #4ade80;

      }


      .status.success .status-dot {

        background:
          #22c55e;

      }


      .status.warning {

        color:
          #fbbf24;

      }


      .status.warning .status-dot {

        background:
          #f59e0b;

      }


      .status.error {

        color:
          #f87171;

      }


      .status.error .status-dot {

        background:
          #ef4444;

      }


      /* STATS */

      .tool-stats {

        display:
          grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap:
          10px;

        padding:
          0 16px 16px;

      }


      .mini-stat {

        display:
          flex;

        align-items:
          center;

        gap:
          10px;

        padding:
          12px;

        border:
          1px solid
          var(--border);

        border-radius:
          13px;

        background:
          var(--surface-2);

      }


      .mini-icon {

        width:
          35px;

        height:
          35px;

        flex:
          0 0 35px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          9px;

      }


      .mini-icon.cyan {

        background:
          rgba(6,182,212,.11);

        color:
          var(--primary);

      }


      .mini-icon.blue {

        background:
          rgba(14,116,144,.11);

        color:
          #0e7490;

      }


      html.dark-mode
      .mini-icon.blue {

        color:
          #67e8f9;

      }


      .mini-icon.green {

        background:
          rgba(22,163,74,.10);

        color:
          var(--green);

      }


      .mini-icon.orange {

        background:
          rgba(234,88,12,.10);

        color:
          var(--orange);

      }


      .mini-ts-large {

        font:
          800 10px
          "JetBrains Mono",
          monospace;

      }


      .mini-stat strong {

        display:
          block;

        font-size:
          10px;

      }


      .mini-stat span {

        display:
          block;

        margin-top:
          2px;

        color:
          var(--muted);

        font-size:
          8px;

      }


      /* INFORMATION */

      .information {

        margin-top:
          55px;

      }


      .section-title {

        max-width:
          700px;

        margin:
          0 auto 25px;

        text-align:
          center;

      }


      .section-title > span {

        color:
          var(--primary);

        font-size:
          11px;

        font-weight:
          800;

      }


      .section-title h2 {

        margin:
          5px 0 7px;

        font-size:
          clamp(
            21px,
            4vw,
            28px
          );

      }


      .section-title p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          12px;

        line-height:
          1.9;

      }


      .info-grid {

        display:
          grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap:
          14px;

      }


      .info-card {

        position:
          relative;

        padding:
          24px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          18px;

        background:
          var(--surface);

      }


      .info-number {

        position:
          absolute;

        top:
          15px;

        left:
          18px;

        color:
          var(--muted);

        opacity:
          .25;

        font:
          700 28px
          "JetBrains Mono",
          monospace;

      }


      .info-card-icon {

        width:
          42px;

        height:
          42px;

        display:
          grid;

        place-items:
          center;

        margin-bottom:
          13px;

        border-radius:
          11px;

        background:
          rgba(6,182,212,.10);

        color:
          var(--primary);

      }


      .info-card h3 {

        margin:
          0 0 7px;

        font-size:
          14px;

      }


      .info-card p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* HOW */

      .how-section {

        margin-top:
          55px;

      }


      .steps {

        display:
          grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap:
          14px;

      }


      .step {

        display:
          flex;

        align-items:
          flex-start;

        gap:
          12px;

        padding:
          20px;

        background:
          var(--surface);

        border:
          1px solid
          var(--border);

        border-radius:
          17px;

      }


      .step-icon {

        width:
          43px;

        height:
          43px;

        flex:
          0 0 43px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          12px;

        background:
          linear-gradient(
            135deg,
            rgba(8,145,178,.12),
            rgba(6,182,212,.12)
          );

        color:
          var(--primary);

        font:
          700 10px
          "JetBrains Mono",
          monospace;

      }


      .step h3 {

        margin:
          0 0 5px;

        font-size:
          13px;

      }


      .step p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          10px;

        line-height:
          1.8;

      }


      /* FAQ */

      .faq-section {

        max-width:
          850px;

        margin:
          55px auto 70px;

      }


      .faq-list details {

        margin-bottom:
          9px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          14px;

        background:
          var(--surface);

      }


      .faq-list summary {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          15px;

        padding:
          16px 18px;

        cursor:
          pointer;

        list-style:
          none;

        font-size:
          12px;

        font-weight:
          700;

      }


      .faq-list summary::-webkit-details-marker {

        display:
          none;

      }


      .faq-list summary i {

        color:
          var(--muted);

        font-size:
          10px;

        transition:
          transform .2s ease;

      }


      .faq-list details[open]
      summary i {

        transform:
          rotate(180deg);

      }


      .faq-answer {

        padding:
          0 18px 17px;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* RESPONSIVE */

      @media (max-width: 900px) {

        .info-grid,
        .steps {

          grid-template-columns:
            repeat(2, 1fr);

        }

      }


      @media (max-width: 700px) {

        .tool-stats {

          grid-template-columns:
            repeat(2, 1fr);

        }


        .actionbar {

          flex-direction:
            column;

          align-items:
            stretch;

        }


        .action-group {

          width:
            100%;

        }


        .action {

          flex:
            1;

        }

      }


      @media (max-width: 600px) {

        .container {

          width:
            calc(100% - 20px);

        }


        .hero {

          padding:
            25px 0 32px;

        }


        .hero-icon {

          width:
            62px;

          height:
            62px;

        }


        .hero p {

          font-size:
            12px;

        }


        .topbar {

          padding:
            14px;

        }


        .topbar-status {

          display:
            none;

        }


        .actionbar {

          padding:
            10px;

        }


        .action {

          padding:
            9px 7px;

          font-size:
            10px;

        }


        .editor-card {

          margin:
            10px;

        }


        .console-card {

          margin:
            0 10px 10px;

        }


        .code-area {

          height:
            330px;

        }


        .console-output {

          min-height:
            130px;

        }

      }


      @media (max-width: 500px) {

        .info-grid,
        .steps {

          grid-template-columns:
            1fr;

        }


        .project-info span {

          display:
            none;

        }


        .project-logo {

          width:
            36px;

          height:
            36px;

        }

      }

    </style>

  </body>
</html>
