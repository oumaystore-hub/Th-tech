    <!-- JAVASCRIPT -->

    <script is:inline>
      (() => {

        const input =
          document.getElementById("inputCode");

        const inputLines =
          document.getElementById("inputLines");

        const inputStats =
          document.getElementById("inputStats");

        const consoleOutput =
          document.getElementById("consoleOutput");

        const executionTime =
          document.getElementById("executionTime");

        const status =
          document.getElementById("status");

        const runBtn =
          document.getElementById("runBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const clearConsoleBtn =
          document.getElementById("clearConsoleBtn");

        const exampleBtn =
          document.getElementById("exampleBtn");


        const exampleCode =
`interface User {
  id: number;
  name: string;
  age: number;
}

const user: User = {
  id: 1,
  name: "Ahmed",
  age: 25
};

console.log("Hello from TypeScript!");
console.log("User:", user);
console.log("Name:", user.name);
console.log("Age:", user.age);`;


        function updateStats() {

          const value =
            input.value;

          const count =
            value
              ? value.split("\n").length
              : 1;

          inputLines.textContent =
            Array.from(
              { length: count },
              (_, index) => index + 1
            ).join("\n");

          inputStats.textContent =
            value.length + " حرف";

        }


        function setStatus(
          type,
          text
        ) {

          status.className =
            "status " + type;

          status.innerHTML =
            '<span class="status-dot"></span>' +
            text;

        }


        function escapeHtml(value) {

          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

        }


        function addConsoleLine(
          type,
          values
        ) {

          const line =
            document.createElement("div");

          line.className =
            "console-line " + type;

          const icon =
            document.createElement("span");

          icon.className =
            "console-line-icon";

          if (type === "error") {

            icon.innerHTML =
              '<i class="fa-solid fa-circle-xmark"></i>';

          } else if (type === "warn") {

            icon.innerHTML =
              '<i class="fa-solid fa-triangle-exclamation"></i>';

          } else {

            icon.innerHTML =
              '<i class="fa-solid fa-angle-right"></i>';

          }


          const text =
            document.createElement("span");

          text.className =
            "console-line-text";

          text.textContent =
            values
              .map((value) => {

                if (
                  typeof value === "object" &&
                  value !== null
                ) {

                  try {

                    return JSON.stringify(
                      value,
                      null,
                      2
                    );

                  } catch {

                    return String(value);

                  }

                }

                return String(value);

              })
              .join(" ");


          line.appendChild(icon);

          line.appendChild(text);

          consoleOutput.appendChild(line);

          consoleOutput.scrollTop =
            consoleOutput.scrollHeight;

        }


        function showPlaceholder() {

          consoleOutput.innerHTML =
            '<div class="console-placeholder">' +
              '<i class="fa-solid fa-terminal"></i>' +
              '<span>ستظهر نتيجة تشغيل الكود هنا...</span>' +
            '</div>';

        }


        function stripTypeScript(code) {

          let result =
            code;

          /*
           * Remove interface declarations.
           */

          result =
            result.replace(
              /interface\s+[A-Za-z_$][\w$]*(?:\s+extends[^{]+)?\s*\{[\s\S]*?\}/g,
              ""
            );


          /*
           * Remove type aliases.
           */

          result =
            result.replace(
              /type\s+[A-Za-z_$][\w$]*(?:\s*<[^>]*>)?\s*=\s*[^;]+;/g,
              ""
            );


          /*
           * Remove access modifiers.
           */

          result =
            result.replace(
              /\b(public|private|protected|readonly|abstract|declare)\s+/g,
              ""
            );


          /*
           * Remove generic parameters from common functions.
           */

          result =
            result.replace(
              /\b(function\s+[A-Za-z_$][\w$]*)\s*<[^>{}]+>/g,
              "$1"
            );


          /*
           * Remove variable type annotations.
           */

          result =
            result.replace(
              /(\b(?:const|let|var)\s+[A-Za-z_$][\w$]*)\s*:\s*[A-Za-z_$][\w$]*(?:\s*<[^;=,\n]+>)?(?:\[\])?/g,
              "$1"
            );


          /*
           * Remove function parameter types.
           */

          result =
            result.replace(
              /([A-Za-z_$][\w$]*)\s*:\s*[A-Za-z_$][\w$]*(?:\s*<[^,\)]+>)?(?:\[\])?/g,
              "$1"
            );


          /*
           * Remove return types.
           */

          result =
            result.replace(
              /\)\s*:\s*[A-Za-z_$][\w$]*(?:\s*<[^>{}]+>)?(?:\[\])?\s*\{/g,
              ") {"
            );


          /*
           * Remove "as Type" assertions.
           */

          result =
            result.replace(
              /\s+as\s+[A-Za-z_$][\w$]*(?:\s*<[^>]+>)?(?:\[\])?/g,
              ""
            );


          return result;

        }


        function executeCode(code) {

          const cleaned =
            stripTypeScript(code);


          const logs = [];

          const fakeConsole = {

            log: function() {

              logs.push({
                type: "log",
                values: Array.from(arguments)
              });

            },

            warn: function() {

              logs.push({
                type: "warn",
                values: Array.from(arguments)
              });

            },

            error: function() {

              logs.push({
                type: "error",
                values: Array.from(arguments)
              });

            },

            info: function() {

              logs.push({
                type: "log",
                values: Array.from(arguments)
              });

            }

          };


          const runner =
            new Function(
              "console",
              '"use strict";\n' +
              cleaned
            );


          runner(fakeConsole);


          return logs;

        }


        function runCode() {

          const code =
            input.value.trim();


          if (!code) {

            showPlaceholder();

            setStatus(
              "warning",
              "أدخل كود TypeScript أولاً"
            );

            input.focus();

            return;

          }


          const started =
            performance.now();


          consoleOutput.innerHTML = "";


          try {

            const logs =
              executeCode(code);


            if (!logs.length) {

              addConsoleLine(
                "log",
                ["تم تشغيل الكود بنجاح."]
              );

            } else {

              logs.forEach(
                function(item) {

                  addConsoleLine(
                    item.type,
                    item.values
                  );

                }
              );

            }


            const elapsed =
              performance.now() - started;


            executionTime.textContent =
              elapsed.toFixed(1) + " ms";


            setStatus(
              "success",
              "تم تشغيل الكود بنجاح"
            );


          } catch (error) {

            const elapsed =
              performance.now() - started;


            executionTime.textContent =
              elapsed.toFixed(1) + " ms";


            addConsoleLine(
              "error",
              [
                error &&
                error.message
                  ? error.message
                  : String(error)
              ]
            );


            setStatus(
              "error",
              "حدث خطأ أثناء التشغيل"
            );

          }

        }


        async function copyCode() {

          const value =
            input.value;


          if (!value) {

            setStatus(
              "warning",
              "لا يوجد كود لنسخه"
            );

            return;

          }


          try {

            await navigator.clipboard.writeText(
              value
            );


            const old =
              copyBtn.innerHTML;


            copyBtn.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';


            setStatus(
              "success",
              "تم نسخ الكود"
            );


            setTimeout(
              function() {

                copyBtn.innerHTML =
                  old;

              },
              1500
            );


          } catch {

            input.select();

            document.execCommand(
              "copy"
            );


            setStatus(
              "success",
              "تم نسخ الكود"
            );

          }

        }


        function clearCode() {

          input.value =
            "";

          updateStats();

          showPlaceholder();

          executionTime.textContent =
            "0 ms";

          setStatus(
            "idle",
            "جاهز"
          );

          input.focus();

        }


        function clearConsole() {

          showPlaceholder();

          executionTime.textContent =
            "0 ms";

          setStatus(
            "idle",
            "جاهز"
          );

        }


        exampleBtn.addEventListener(
          "click",
          function() {

            input.value =
              exampleCode;

            updateStats();

            showPlaceholder();

            setStatus(
              "idle",
              "جاهز للتشغيل"
            );

            input.focus();

          }
        );


        runBtn.addEventListener(
          "click",
          runCode
        );


        copyBtn.addEventListener(
          "click",
          copyCode
        );


        clearBtn.addEventListener(
          "click",
          clearCode
        );


        clearConsoleBtn.addEventListener(
          "click",
          clearConsole
        );


        input.addEventListener(
          "input",
          updateStats
        );


        input.addEventListener(
          "scroll",
          function() {

            inputLines.scrollTop =
              input.scrollTop;

          }
        );


        input.addEventListener(
          "keydown",
          function(event) {

            if (event.key === "Tab") {

              event.preventDefault();


              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;


              input.value =
                input.value.substring(
                  0,
                  start
                ) +
                "  " +
                input.value.substring(
                  end
                );


              input.selectionStart =
                start + 2;

              input.selectionEnd =
                start + 2;


              updateStats();

            }


            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {

              event.preventDefault();

              runCode();

            }

          }
        );


        updateStats();

      })();
    </script>


