<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->


      <!-- HERO -->

      <section class="hero">

        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container">

          <div class="breadcrumb">

            <a href={`${base}/`}>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <span>
              TypeScript Playground
            </span>

          </div>


          <div class="hero-badge">

            <span class="badge-dot"></span>

            Developer Tools

            <i class="fa-solid fa-terminal"></i>

          </div>


          <div class="hero-icon">

            <span class="ts-mark">TS</span>

            <span class="terminal-mark">
              <i class="fa-solid fa-terminal"></i>
            </span>

          </div>


          <h1>

            TypeScript

            <span>Playground</span>

          </h1>


          <p>

            جرّب وشغّل أكواد TypeScript مباشرة من المتصفح
            مع Console لعرض النتائج والأخطاء بشكل واضح.

          </p>

        </div>

      </section>


      <!-- PLAYGROUND -->

      <section class="tool-section">

        <div class="container">

          <div class="playground-card">


            <!-- TOP BAR -->

            <div class="topbar">

              <div class="project-info">

                <div class="project-logo">

                  <span>TS</span>

                  <i class="fa-solid fa-terminal"></i>

                </div>

                <div>

                  <strong>
                    TypeScript Playground
                  </strong>

                  <span>
                    Online TypeScript Runtime
                  </span>

                </div>

              </div>


              <div class="topbar-status">

                <span class="online-dot"></span>

                Local Processing

              </div>

            </div>


            <!-- ACTION BAR -->

            <div class="actionbar">

              <div class="action-group">

                <button
                  id="exampleBtn"
                  class="action secondary"
                  type="button"
                >
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  مثال
                </button>


                <button
                  id="clearBtn"
                  class="action secondary"
                  type="button"
                >
                  <i class="fa-solid fa-trash-can"></i>
                  مسح
                </button>

              </div>


              <div class="action-group">

                <button
                  id="copyBtn"
                  class="action secondary"
                  type="button"
                >
                  <i class="fa-regular fa-copy"></i>
                  نسخ
                </button>


                <button
                  id="runBtn"
                  class="action primary"
                  type="button"
                >
                  <i class="fa-solid fa-play"></i>
                  تشغيل الكود
                </button>

              </div>

            </div>


            <!-- EDITOR -->

            <div class="editor-card">

              <div class="editor-head">

                <div class="editor-label">

                  <span class="file-icon">

                    <span class="mini-ts">
                      TS
                    </span>

                  </span>

                  <div>

                    <strong>
                      main.ts
                    </strong>

                    <small>
                      TypeScript
                    </small>

                  </div>

                </div>


                <div
                  id="inputStats"
                  class="editor-stats"
                >
                  0 حرف
                </div>

              </div>


              <div class="code-area">

                <div
                  id="inputLines"
                  class="line-numbers"
                >
                  1
                </div>


                <textarea
                  id="inputCode"
                  spellcheck="false"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="// اكتب كود TypeScript هنا..."
                ></textarea>

              </div>


              <div class="editor-foot">

                <span>

                  <i class="fa-solid fa-keyboard"></i>

                  Ctrl + Enter

                </span>


                <span>

                  TypeScript

                </span>

              </div>

            </div>


            <!-- CONSOLE -->

            <div class="console-card">

              <div class="console-head">

                <div class="console-title">

                  <span class="console-icon">

                    <i class="fa-solid fa-terminal"></i>

                  </span>

                  <div>

                    <strong>
                      Console
                    </strong>

                    <small>
                      Output
                    </small>

                  </div>

                </div>


                <button
                  id="clearConsoleBtn"
                  class="console-clear"
                  type="button"
                >

                  <i class="fa-solid fa-broom"></i>

                  مسح

                </button>

              </div>


              <div
                id="consoleOutput"
                class="console-output"
              >

                <div class="console-placeholder">

                  <i class="fa-solid fa-terminal"></i>

                  <span>
                    ستظهر نتيجة تشغيل الكود هنا...
                  </span>

                </div>

              </div>


              <div class="console-foot">

                <span
                  id="status"
                  class="status idle"
                >

                  <span class="status-dot"></span>

                  جاهز

                </span>


                <span id="executionTime">
                  0 ms
                </span>

              </div>

            </div>


            <!-- STATS -->

            <div class="tool-stats">


              <div class="mini-stat">

                <div class="mini-icon cyan">

                  <i class="fa-solid fa-play"></i>

                </div>

                <div>

                  <strong>
                    تشغيل فوري
                  </strong>

                  <span>
                    داخل المتصفح
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon blue">

                  <span class="mini-ts-large">
                    TS
                  </span>

                </div>

                <div>

                  <strong>
                    TypeScript
                  </strong>

                  <span>
                    دعم TypeScript
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon green">

                  <i class="fa-solid fa-lock"></i>

                </div>

                <div>

                  <strong>
                    Private
                  </strong>

                  <span>
                    لا رفع للكود
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon orange">

                  <i class="fa-solid fa-mobile-screen"></i>

                </div>

                <div>

                  <strong>
                    Responsive
                  </strong>

                  <span>
                    جميع الأجهزة
                  </span>

                </div>

              </div>


            </div>

          </div>


          <!-- INFORMATION -->

          <section class="information">

            <div class="section-title">

              <span>
                TypeScript Tools
              </span>

              <h2>
                TypeScript Playground احترافي
              </h2>

              <p>
                بيئة بسيطة وسريعة لتجربة أكواد TypeScript
                ومشاهدة النتائج مباشرة.
              </p>

            </div>


            <div class="info-grid">


              <article class="info-card">

                <div class="info-number">
                  01
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-play"></i>

                </div>

                <h3>
                  تشغيل مباشر
                </h3>

                <p>
                  شغّل الكود مباشرة من المتصفح
                  دون الحاجة إلى تثبيت بيئة تطوير.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  02
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-terminal"></i>

                </div>

                <h3>
                  Console مدمج
                </h3>

                <p>
                  شاهد نتائج console.log والأخطاء
                  داخل نافذة Console مخصصة.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  03
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-shield-halved"></i>

                </div>

                <h3>
                  معالجة محلية
                </h3>

                <p>
                  يتم تشغيل الكود محلياً داخل المتصفح
                  ولا يتم رفعه إلى خادم خارجي.
                </p>

              </article>

            </div>

          </section>


          <!-- HOW TO -->

          <section class="how-section">

            <div class="section-title">

              <span>
                How It Works
              </span>

              <h2>
                طريقة استخدام الأداة
              </h2>

            </div>


            <div class="steps">


              <div class="step">

                <div class="step-icon">

                  <span>
                    01
                  </span>

                </div>

                <div>

                  <h3>
                    اكتب الكود
                  </h3>

                  <p>
                    اكتب أو ألصق كود TypeScript
                    داخل المحرر.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    02
                  </span>

                </div>

                <div>

                  <h3>
                    اضغط تشغيل
                  </h3>

                  <p>
                    اضغط على تشغيل الكود أو
                    استخدم Ctrl + Enter.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    03
                  </span>

                </div>

                <div>

                  <h3>
                    شاهد النتيجة
                  </h3>

                  <p>
                    ستظهر النتائج والأخطاء
                    داخل Console.
                  </p>

                </div>

              </div>

            </div>

          </section>


          <!-- FAQ -->

          <section class="faq-section">

            <div class="section-title">

              <span>
                FAQ
              </span>

              <h2>
                الأسئلة الشائعة
              </h2>

            </div>


            <div class="faq-list">

              {
                faqs.map((faq) => (
                  <details>

                    <summary>

                      <span>
                        {faq.q}
                      </span>

                      <i class="fa-solid fa-chevron-down"></i>

                    </summary>

                    <div class="faq-answer">
                      {faq.a}
                    </div>

                  </details>
                ))
              }

            </div>

          </section>

        </div>

      </section>

    









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
