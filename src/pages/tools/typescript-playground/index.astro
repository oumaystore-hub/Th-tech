---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "TypeScript Playground - تشغيل TypeScript أونلاين مجاناً | Th.Tech";

const description =
  "TypeScript Playground مجاني لتجربة وتشغيل أكواد TypeScript مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو TypeScript Playground؟",
    a: "أداة تتيح لك تجربة أكواد TypeScript وتشغيلها مباشرة من المتصفح."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم معالجة وتشغيل الكود محلياً داخل المتصفح."
  },
  {
    q: "هل يمكن استخدام console.log؟",
    a: "نعم. ستظهر نتائج console.log داخل نافذة Console الموجودة أسفل المحرر."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم. الأداة مجانية ويمكن استخدامها مباشرة من المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      name="theme-color"
      content="#0891b2"
    />

    <link
      rel="icon"
      href={`${base}/logo1.png`}
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch (error) {
        }
      })();
    </script>

  </head>

  <body>

    <Header />

    <main>
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

