      function inlineMarkdown(text) {

        let value =
          escapeHtml(text);


        const codeTokens = [];

        value = value.replace(
          /`([^`]+)`/g,
          function(_, code) {

            const token =
              `@@CODE${codeTokens.length}@@`;

            codeTokens.push(
              `<code>${code}</code>`
            );

            return token;

          }
        );


        value = value.replace(
          /!\[([^\]]*)\]\((https?:\/\/[^\s)]+)(?:\s+"([^"]*)")?\)/g,
          function(_, alt, url, title) {

            const safeUrl =
              /^https?:\/\//i.test(url)
                ? url
                : "#";

            const titleAttr =
              title
                ? ` title="${escapeAttribute(title)}"`
                : "";

            return `<img src="${escapeAttribute(safeUrl)}" alt="${escapeAttribute(alt)}"${titleAttr}>`;

          }
        );


        value = value.replace(
          /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
          function(_, label, url) {

            const safeUrl =
              /^https?:\/\//i.test(url)
                ? url
                : "#";

            return `<a href="${escapeAttribute(safeUrl)}" target="_blank" rel="noopener noreferrer">${label}</a>`;

          }
