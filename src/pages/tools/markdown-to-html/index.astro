        );


        value = value.replace(
          /@@CODE(\d+)@@/g,
          function(_, index) {

            return codeTokens[
              Number(index)
            ];

          }
        );


        return value;

      }


      function markdownToHtml(markdown) {

        if (!markdown.trim()) {
          return "";
        }


        const lines =
          markdown.replace(/\r\n/g, "\n").split("\n");

        let html = "";

        let inCodeBlock = false;
        let codeLanguage = "";
        let codeLines = [];

        let inUl = false;
        let inOl = false;

        let inBlockquote = false;

        let tableLines = [];


        function closeLists() {

          if (inUl) {
            html += "</ul>\n";
            inUl = false;
          }

          if (inOl) {
            html += "</ol>\n";
            inOl = false;
          }

        }


        function closeBlockquote() {

          if (inBlockquote) {

            html += "</blockquote>\n";

            inBlockquote = false;

          }

        }


        function flushTable() {

          if (!tableLines.length) {
            return;
          }


          const rows =
            tableLines.slice();


          if (rows.length >= 2) {

            const headers =
              rows[0]
                .split("|")
                .map(item => item.trim())
                .filter(Boolean);


            const bodyRows =
              rows.slice(2);


            html += "<table>\n";

            html += "<thead><tr>";


            headers.forEach(header => {

              html +=
                `<th>${inlineMarkdown(header)}</th>`;

            });


            html += "</tr></thead>\n";


            if (bodyRows.length) {

              html += "<tbody>\n";


              bodyRows.forEach(row => {

                const cells =
                  row
                    .split("|")
                    .map(item => item.trim())
                    .filter(Boolean);


                html += "<tr>";


                cells.forEach(cell => {

                  html +=
                    `<td>${inlineMarkdown(cell)}</td>`;

                });


                html += "</tr>\n";

              });


              html += "</tbody>\n";

            }


            html += "</table>\n";

          }


          tableLines = [];

        }


        for (
          let i = 0;
          i < lines.length;
          i++
        ) {

          const line =
            lines[i];


          /* CODE BLOCK */

          if (
            line.trim().startsWith("```")
          ) {

            if (!inCodeBlock) {

              closeLists();

              closeBlockquote();

              flushTable();

              inCodeBlock = true;

              codeLanguage =
                line.trim()
                  .slice(3)
                  .trim();

              codeLines = [];

            } else {

              const languageClass =
                codeLanguage
                  ? ` class="language-${escapeAttribute(codeLanguage)}"`
                  : "";

              html +=
                `<pre><code${languageClass}>${escapeHtml(codeLines.join("\n"))}</code></pre>\n`;

              inCodeBlock = false;

              codeLanguage = "";

              codeLines = [];

            }

            continue;

          }


          if (inCodeBlock) {

            codeLines.push(line);

            continue;

          }


          /* TABLE */

          const nextLine =
            lines[i + 1] || "";

          if (
            line.includes("|") &&
            /^\s*\|?[\s:-]+(\|[\s:-]+)+\|?\s*$/.test(
              nextLine
            )
          ) {

            closeLists();

            closeBlockquote();

            flushTable();

            tableLines.push(line);

            tableLines.push(nextLine);

            i++;

            while (
              i + 1 < lines.length &&
              lines[i + 1].includes("|")
            ) {

              tableLines.push(
                lines[++i]
              );

            }

            flushTable();

            continue;

          }


          /* EMPTY */

          if (!line.trim()) {

            closeLists();

            closeBlockquote();

            flushTable();

            continue;

          }


          /* HEADINGS */

          const heading =
            line.match(/^(#{1,6})\s+(.+)$/);


          if (heading) {

            closeLists();

            closeBlockquote();

            flushTable();

            const level =
              heading[1].length;

            html +=
              `<h${level}>${inlineMarkdown(heading[2])}</h${level}>\n`;

            continue;

          }


          /* BLOCKQUOTE */

          if (
            /^\s*>\s?/.test(line)
          ) {

            closeLists();

            flushTable();

            if (!inBlockquote) {

              html += "<blockquote>\n";

              inBlockquote = true;

            }

            html +=
              `<p>${inlineMarkdown(line.replace(/^\s*>\s?/, ""))}</p>\n`;

            continue;

          } else {

            closeBlockquote();

          }


          /* UNORDERED LIST */

          const unordered =
            line.match(/^\s*[-*+]\s+(.+)$/);


          if (unordered) {

            if (inOl) {

              html += "</ol>\n";

              inOl = false;

            }

            flushTable();

            if (!inUl) {

              html += "<ul>\n";

              inUl = true;

            }

            html +=
              `<li>${inlineMarkdown(unordered[1])}</li>\n`;

            continue;

          }


          /* ORDERED LIST */

          const ordered =
            line.match(/^\s*\d+\.\s+(.+)$/);


          if (ordered) {

            if (inUl) {

              html += "</ul>\n";

              inUl = false;

            }

            flushTable();

            if (!inOl) {

              html += "<ol>\n";

              inOl = true;

            }

            html +=
              `<li>${inlineMarkdown(ordered[1])}</li>\n`;

            continue;

          }


          /* HORIZONTAL RULE */

          if (
            /^\s*(---|\*\*\*|___)\s*$/.test(line)
          ) {

            closeLists();

            closeBlockquote();

            flushTable();

            html += "<hr>\n";

            continue;

          }


          /* PARAGRAPH */

          closeLists();

          flushTable();

          html +=
            `<p>${inlineMarkdown(line)}</p>\n`;

        }


        if (inCodeBlock) {

          html +=
            `<pre><code>${escapeHtml(codeLines.join("\n"))}</code></pre>\n`;

        }


        closeLists();

        closeBlockquote();

        flushTable();


        return html.trim();

      }


      function updateStats() {

        const text =
          input.value || "";

        const html =
          output.value || "";

        const lines =
          text
            ? text.split(/\r?\n/).length
            : 0;

        const tags =
          (html.match(/<[^>]+>/g) || []).length;


        inputStats.textContent =
          `${text.length} حرف · ${lines} سطر`;

        outputStats.textContent =
          `${html.length} حرف`;


        statChars.textContent =
          text.length;

        statLines.textContent =
          lines;

        statHtml.textContent =
          html.length;

        statTags.textContent =
          tags;

      }


      function renderPreview(html) {

        if (!html) {

          preview.innerHTML = `
            <div class="empty-preview">
              <i class="fa-solid fa-file-code"></i>
              <p>ستظهر معاينة Markdown هنا</p>
            </div>
          `;

          return;

        }


        preview.innerHTML =
          html;

      }


      function showMessage(text, type) {

        message.innerHTML =
          `<i class="fa-solid fa-circle-info"></i>${text}`;


        if (type === "success") {

          message.style.background =
            "rgba(18,166,106,0.1)";

          message.style.color =
            "var(--success)";

        } else if (type === "error") {

          message.style.background =
            "rgba(224,82,82,0.1)";

          message.style.color =
            "var(--danger)";

        } else {

          message.style.background =
            "var(--primary-soft)";

          message.style.color =
            "var(--primary)";

        }

      }


      function convert() {

        const markdown =
          input.value;


        if (!markdown.trim()) {

          output.value = "";

          renderPreview("");

          updateStats();

          inputStatus.textContent =
            "فارغ";

          outputStatus.textContent =
            "لا توجد نتيجة";

          showMessage(
            "أدخل Markdown أولاً ثم اضغط على تحويل إلى HTML.",
            "error"
          );

          return;

        }


        try {

          const html =
            markdownToHtml(markdown);


          output.value =
            html;


          renderPreview(html);

          updateStats();


          inputStatus.textContent =
            "تم التحويل";

          outputStatus.textContent =
            "جاهز";


          showMessage(
            "تم تحويل Markdown إلى HTML بنجاح.",
            "success"
          );

        } catch {

          showMessage(
            "حدث خطأ أثناء تحويل Markdown.",
            "error"
          );

        }

      }


      async function copyOutput() {

        if (!output.value) {

          showMessage(
            "لا توجد نتيجة لنسخها.",
            "error"
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            output.value
          );


          showMessage(
            "تم نسخ HTML إلى الحافظة.",
            "success"
          );

        } catch {

          output.select();

          document.execCommand("copy");

          showMessage(
            "تم نسخ HTML.",
            "success"
          );

        }

      }


      function loadSample() {

        input.value = `# مرحباً بك

هذه أداة **Markdown to HTML** لتحويل Markdown إلى HTML.

## المميزات

- تحويل سريع
- معاينة مباشرة
- دعم العربية
- معالجة محلية

### مثال على الرابط

[Th.Tech](https://oumaystore-hub.github.io/Th-tech/)

> هذه ملاحظة مهمة.

\`console.log("Hello");\`

\`\`\`javascript
const message = "Hello World!";
console.log(message);
\`\`\`

| الاسم | القيمة |
| --- | --- |
| HTML | 100% |
| Markdown | سريع |`;


        output.value = "";

        renderPreview("");

        updateStats();


        inputStatus.textContent =
          "مثال محمل";

        outputStatus.textContent =
          "لا توجد نتيجة";


        showMessage(
          "تم تحميل مثال. اضغط على تحويل إلى HTML.",
          "info"
        );

      }


      function clearAll() {

        input.value = "";

        output.value = "";

        renderPreview("");

        updateStats();


        inputStatus.textContent =
          "جاهز";

        outputStatus.textContent =
          "لا توجد نتيجة";


        showMessage(
          "تم مسح المحتوى وإعادة ضبط الأداة.",
          "info"
        );

      }


      function downloadHtml() {

        if (!output.value) {

          showMessage(
            "لا توجد نتيجة لتحميلها.",
            "error"
          );

          return;

        }


        const fullHtml = `<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Markdown HTML Export</title>
</head>
<body>
${output.value}
</body>
</html>`;


        const blob =
          new Blob(
            [fullHtml],
            { type: "text/html;charset=utf-8" }
          );


        const url =
          URL.createObjectURL(blob);


        const link =
          document.createElement("a");


        link.href = url;

        link.download =
          "markdown-to-html.html";


        document.body.appendChild(link);

        link.click();

        link.remove();

        URL.revokeObjectURL(url);


        showMessage(
          "تم تحميل ملف HTML بنجاح.",
          "success"
        );

      }


      convertBtn.addEventListener(
        "click",
        convert
      );


      convertBtnBottom.addEventListener(
        "click",
        convert
      );


      sampleBtn.addEventListener(
        "click",
        loadSample
      );


      copyBtn.addEventListener(
        "click",
        copyOutput
      );


      copyBtnBottom.addEventListener(
        "click",
        copyOutput
      );


      downloadBtn.addEventListener(
        "click",
        downloadHtml
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      clearBtnBottom.addEventListener(
        "click",
        clearAll
      );


      input.addEventListener(
        "input",
        function() {

          updateStats();

          if (input.value.trim()) {

            const html =
              markdownToHtml(input.value);

            output.value =
              html;

            renderPreview(html);

            updateStats();

            inputStatus.textContent =
              "مباشر";

            outputStatus.textContent =
              "جاهز";

          } else {

            output.value = "";

            renderPreview("");

            updateStats();

            inputStatus.textContent =
              "جاهز";

            outputStatus.textContent =
              "لا توجد نتيجة";

          }

        }
      );


      input.addEventListener(
        "keydown",
        function(event) {

          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            convert();

          }

        }
      );


      updateStats();


      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");


          if (saved === "dark") {

            document.documentElement.classList.add(
              "dark-mode"
            );

          } else {

            document.documentElement.classList.remove(
              "dark-mode"
            );

          }

        } catch {}

      }


      syncTheme();


      window.addEventListener(
        "themeChange",
        syncTheme
      );


      const themeButton =
        document.getElementById("theme-btn");


      if (themeButton) {

        themeButton.addEventListener(
          "click",
          function() {

            setTimeout(
              syncTheme,
              0
            );

          }
        );

      }

    })();
  </script>

</body>
</html>
