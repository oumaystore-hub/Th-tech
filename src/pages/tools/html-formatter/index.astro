---

import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(//$/, '');

const title = "HTML Formatter - تنسيق وتجميل كود HTML أونلاين | Th.Tech";
