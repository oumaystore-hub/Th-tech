</section>


<!-- =====================================================
     WORKSPACE
====================================================== -->

<section class="workspace">

  <!-- TOOLBAR -->

  <div class="toolbar">

    <div class="toolbar-group">

      <button
        id="formatBtn"
        class="primary"
        type="button"
      >
        <i class="fas fa-wand-magic-sparkles"></i>
        تنسيق
      </button>

      <button
        id="minifyBtn"
        type="button"
      >
        <i class="fas fa-compress"></i>
        Minify
      </button>

    </div>


    <div class="toolbar-group">

      <button
        id="exampleBtn"
        type="button"
      >
        <i class="fas fa-flask"></i>
        مثال
      </button>

      <button
        id="copyBtn"
        type="button"
      >
        <i class="fas fa-copy"></i>
        نسخ
      </button>

      <button
        id="clearBtn"
        type="button"
      >
        <i class="fas fa-trash"></i>
        مسح
      </button>

    </div>

  </div>


  <!-- STATUS -->

  <div
    id="status"
    class="status"
    aria-live="polite"
  >
    <i class="fas fa-circle-info"></i>
    أدخل كود HTML ثم اضغط «تنسيق».
  </div>


  <!-- EDITORS -->

  <div class="editor-grid">

    <!-- INPUT -->

    <div class="editor-card">

      <div class="editor-header">

        <span>
          <i class="fas fa-pen"></i>
          HTML INPUT
        </span>

        <span id="inputStats">
          0 chars
        </span>

      </div>

      <textarea
        id="input"
        spellcheck="false"
        aria-label="HTML Input"
        placeholder={`<div class="container">

  <h1>Hello World</h1>
  <p>Welcome to Th.Tech</p>
</div>`}
          ></textarea>    </div>


    <!-- OUTPUT -->

    <div class="editor-card">

      <div class="editor-header">

        <span>
          <i class="fas fa-code"></i>
          FORMATTED HTML
        </span>

        <span id="outputStats">
          0 chars
        </span>

      </div>

      <textarea
        id="output"
        readonly
        spellcheck="false"
        aria-label="Formatted HTML Output"
        placeholder="ستظهر النتيجة هنا..."
      ></textarea>

    </div>

  </div>

</section>


<!-- =====================================================
     INFORMATION
====================================================== -->

<section class="info">

  <h2>
    HTML Formatter أونلاين
  </h2>

  <p>
    أداة تنسيق HTML تساعد المطورين على جعل الأكواد مقروءة ومنظمة
    أو تصغيرها لإنتاجية أفضل وسرعة تحميل أعلى للمواقع.
  </p>


  <div class="info-grid">

    <div>

      <i class="fas fa-indent"></i>

      <strong>
        تنسيق ذكي
      </strong>

      <span>
        ترتيب الوسوم والمسافات البادئة.
      </span>

    </div>


    <div>

      <i class="fas fa-file-zipper"></i>

      <strong>
        تصغير
      </strong>

      <span>
        إزالة المسافات غير الضرورية لتقليل حجم الملف.
      </span>

    </div>


    <div>

      <i class="fas fa-shield-halved"></i>

      <strong>
        آمن
      </strong>

      <span>
        تتم معالجة الكود داخل المتصفح ولا يتم إرساله إلى خادم.
      </span>

    </div>

  </div>

</section>

  </main>  <Footer />  <!-- =====================================================
       HTML FORMATTER JAVASCRIPT
  ====================================================== -->  <script>

    const input = document.getElementById("input");
    const output = document.getElementById("output");
    const status = document.getElementById("status");
    const inputStats = document.getElementById("inputStats");
    const outputStats = document.getElementById("outputStats");


    /* =====================================================
       EXAMPLE
    ====================================================== */

    const example = `<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>Th.Tech</title>
</head>
<body>
  <div class="container">
    <h1>مرحباً بك</h1>
    <p>هذه أداة تنسيق HTML.</p>
  </div>
</body>
</html>`;


    /* =====================================================
       VOID ELEMENTS
    ====================================================== */

    const voidElements =
      /^(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)$/i;


    /* =====================================================
       UPDATE STATS
    ====================================================== */

    function updateStats() {

      inputStats.textContent =
        `${input.value.length} chars`;

      outputStats.textContent =
        `${output.value.length} chars`;

    }


    /* =====================================================
       STATUS
    ====================================================== */

    function showStatus(
      message,
      type = "info"
    ) {

      const icons = {

        info: "fa-circle-info",

        success: "fa-circle-check",

        error: "fa-circle-xmark"

      };

      status.className =
        `status ${type}`;

      status.innerHTML =
        `<i class="fas ${icons[type]}"></i> ${message}`;

    }


    /* =====================================================
       FORMAT HTML
    ====================================================== */

    function formatHTML() {

      if (!input.value.trim()) {

        showStatus(
          "يرجى إدخال كود HTML أولاً.",
          "error"
        );

        return;

      }


      const html =
        input.value.trim();


      /*
       * تقسيم الكود إلى:
       * tags + text
       */

      const tokens =
        html.split(/(<[^>]+>)/g);


      let formatted = "";
      let indent = 0;


      tokens.forEach(token => {

        const value =
          token.trim();


        if (!value) return;


        /*
         * تعليق HTML
         */

        if (
          value.startsWith("<!--")
        ) {

          formatted +=
            `${"  ".repeat(indent)}${value}\n`;

          return;

        }


        /*
         * Closing tag
         */

        if (
          /^<\//.test(value)
        ) {

          indent =
            Math.max(0, indent - 1);

          formatted +=
            `${"  ".repeat(indent)}${value}\n`;

          return;

        }


        /*
         * Opening / self-closing tag
         */

        if (
          /^<[^/!]/.test(value)
        ) {

          formatted +=
            `${"  ".repeat(indent)}${value}\n`;


          /*
           * استخراج اسم الوسم
           */

          const match =
            value.match(
              /^<\s*([a-zA-Z0-9-]+)/
            );


          const tagName =
            match
              ? match[1]
              : "";


          /*
           * زيادة مستوى indentation
           * للوسوم التي تحتوي محتوى
           */

          if (
            tagName &&
            !voidElements.test(tagName) &&
            !/\/>$/.test(value)
          ) {

            indent++;

          }

          return;

        }


        /*
         * Text content
         */

        formatted +=
          `${"  ".repeat(indent)}${value}\n`;

      });


      output.value =
        formatted.trim();


      showStatus(
        "تم تنسيق HTML بنجاح.",
        "success"
      );


      updateStats();

    }


    /* =====================================================
       MINIFY HTML
    ====================================================== */

    function minifyHTML() {

      if (!input.value.trim()) {

        showStatus(
          "يرجى إدخال كود HTML أولاً.",
          "error"
        );

        return;

      }


      const minified =
        input.value

          /*
           * إزالة التعليقات
           */

          .replace(
            /<!--[\s\S]*?-->/g,
            ""
          )

          /*
           * إزالة الفراغات الزائدة
           */

          .replace(
            /\s+/g,
            " "
          )

          /*
           * إزالة الفراغات بين الوسوم
           */

          .replace(
            />\s+</g,
            "><"
          )

          .trim();


      output.value =
        minified;


      showStatus(
        "تم تصغير HTML بنجاح.",
        "success"
      );


      updateStats();

    }


    /* =====================================================
       COPY
    ====================================================== */

    async function copyOutput() {

      const text =
        output.value;


      if (!text) {

        showStatus(
          "لا توجد نتيجة لنسخها.",
          "error"
        );

        return;

      }


      try {

        await navigator.clipboard.writeText(
          text
        );

        showStatus(
          "تم نسخ الكود إلى الحافظة.",
          "success"
        );

      } catch {

        output.select();

        document.execCommand("copy");

        showStatus(
          "تم نسخ الكود.",
          "success"
        );

      }

    }


    /* =====================================================
       LOAD EXAMPLE
    ====================================================== */

    function loadExample() {

      input.value =
        example;

      output.value =
        "";

      updateStats();

      showStatus(
        "تم تحميل المثال.",
        "info"
      );

    }


    /* =====================================================
       CLEAR
    ====================================================== */

    function clearAll() {

      input.value =
        "";

      output.value =
        "";

      updateStats();

      showStatus(
        "تم مسح المحتوى.",
        "info"
      );

    }


    /* =====================================================
       EVENTS
    ====================================================== */

    document
      .getElementById("formatBtn")
      .addEventListener(
        "click",
        formatHTML
      );


    document
      .getElementById("minifyBtn")
      .addEventListener(
        "click",
        minifyHTML
      );


    document
      .getElementById("copyBtn")
      .addEventListener(
        "click",
        copyOutput
      );


    document
      .getElementById("exampleBtn")
      .addEventListener(
        "click",
        loadExample
      );


    document
      .getElementById("clearBtn")
      .addEventListener(
        "click",
        clearAll
      );


    input.addEventListener(
      "input",
      updateStats
    );


    /*
     * Ctrl + Enter
     */

    input.addEventListener(
      "keydown",
      event => {

        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {

          event.preventDefault();

          formatHTML();

        }

      }
    );


    updateStats();

  </script></body>
</html><style>

  /* =====================================================
     VARIABLES
  ====================================================== */

  :root {

    --bg: #f6f8fb;
    --card: #ffffff;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --soft: #f1f5f9;
    --primary: #2563eb;

  }


  /* =====================================================
     DARK MODE
  ====================================================== */

  html.dark-mode {

    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --border: rgba(148, 163, 184, .18);
    --soft: #172033;
    --primary: #38bdf8;

  }


  /* =====================================================
     RESET
  ====================================================== */

  * {

    box-sizing: border-box;
    margin: 0;
    padding: 0;

  }


  body {

    background: var(--bg);
    color: var(--text);
    font-family: "Cairo", sans-serif;
    line-height: 1.7;

    transition:
      background-color .25s ease,
      color .25s ease;

  }


  /* =====================================================
     PAGE
  ====================================================== */

  .page {

    width: min(
      1180px,
      calc(100% - 32px)
    );

    margin: auto;

    padding:
      35px 0 70px;

  }


  /* =====================================================
     BREADCRUMB
  ====================================================== */

  .breadcrumb {

    display: flex;
    align-items: center;
    gap: 9px;

    margin-bottom: 30px;

    color: var(--muted);

    font-size: 11px;

  }


  .breadcrumb a {

    color: var(--primary);
    text-decoration: none;

  }


  .breadcrumb i {

    font-size: 8px;

  }


  /* =====================================================
     TITLE
  ====================================================== */

  .tool-title {

    display: flex;
    align-items: center;

    gap: 17px;

    margin-bottom: 30px;

  }


  .tool-icon {

    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 17px;

    background:
      rgba(37, 99, 235, .10);

    color: var(--primary);

    font-size: 27px;

    flex: none;

  }


  .eyebrow {

    display: block;

    color: var(--primary);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.2px;

  }


  .tool-title h1 {

    font-size: 30px;

    font-weight: 800;

    line-height: 1.3;

  }


  .tool-title p {

    color: var(--muted);

    font-size: 13px;

    margin-top: 3px;

  }


  /* =====================================================
     WORKSPACE
  ====================================================== */

  .workspace {

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
      0 20px 60px
      rgba(15, 23, 42, .07);

    transition:
      background-color .25s ease,
      border-color .25s ease;

  }


  /* =====================================================
     TOOLBAR
  ====================================================== */

  .toolbar {

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 12px;

    border-bottom:
      1px solid var(--border);

    background: var(--soft);

  }


  .toolbar-group {

    display: flex;

    gap: 7px;

    flex-wrap: wrap;

  }


  .toolbar button {

    height: 37px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    padding: 0 13px;

    border:
      1px solid var(--border);

    border-radius: 8px;

    background: var(--card);

    color: var(--text);

    font-family: inherit;

    font-size: 11px;

    font-weight: 700;

    cursor: pointer;

    transition: .2s ease;

  }


  .toolbar button:hover {

    border-color:
      var(--primary);

    color:
      var(--primary);

  }


  .toolbar button.primary {

    background:
      var(--primary);

    border-color:
      var(--primary);

    color: white;

  }


  .toolbar button:active {

    transform:
      scale(.97);

  }


  /* =====================================================
     STATUS
  ====================================================== */

  .status {

    display: flex;

    align-items: center;

    gap: 8px;

    min-height: 43px;

    padding:
      8px 15px;

    border-bottom:
      1px solid var(--border);

    color:
      var(--muted);

    font-size: 11px;

  }


  .status.success {

    color:
      #15803d;

    background:
      rgba(34, 197, 94, .06);

  }


  .status.error {

    color:
      #dc2626;

    background:
      rgba(239, 68, 68, .06);

  }


  /* =====================================================
     EDITORS
  ====================================================== */

  .editor-grid {

    display: grid;

    grid-template-columns:
      1fr 1fr;

    min-height:
      480px;

  }


  .editor-card {

    display: flex;

    flex-direction: column;

    min-width: 0;

  }


  .editor-card + .editor-card {

    border-left:
      1px solid var(--border);

  }


  .editor-header {

    height: 43px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
      0 13px;

    background:
      var(--soft);

    border-bottom:
      1px solid var(--border);

    color:
      var(--muted);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .7px;

  }


  .editor-header span:first-child {

    display: flex;

    align-items: center;

    gap: 7px;

  }


  .editor-header i {

    color:
      var(--primary);

  }


  .editor-header span:last-child {

    font-family:
      "Fira Code",
      monospace;

    font-size: 9px;

  }


  textarea {

    flex: 1;

    width: 100%;

    min-height: 437px;

    resize: none;

    border: 0;

    outline: 0;

    padding: 18px;

    background:
      var(--card);

    color:
      var(--text);

    direction: ltr;

    text-align: left;

    font:
      13px / 1.8
      "Fira Code",
      monospace;

    tab-size: 2;

    transition:
      background-color .25s ease,
      color .25s ease;

  }


  textarea::placeholder {

    color:
      #94a3b8;

  }


  textarea:focus {

    background:
      var(--soft);

  }


  /* =====================================================
     INFO
  ====================================================== */

  .info {

    margin-top: 50px;

    text-align: center;

  }


  .info h2 {

    font-size: 25px;

    font-weight: 800;

  }


  .info > p {

    max-width: 750px;

    margin:
      10px auto;

    color:
      var(--muted);

    font-size: 13px;

  }


  .info-grid {

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 15px;

    margin-top: 25px;

  }


  .info-grid div {

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 3px;

    padding: 20px;

    border:
      1px solid var(--border);

    border-radius: 13px;

    background:
      var(--card);

    transition:
      transform .2s ease,
      border-color .2s ease;

  }


  .info-grid div:hover {

    transform:
      translateY(-3px);

    border-color:
      var(--primary);

  }


  .info-grid i {

    color:
      var(--primary);

    font-size: 20px;

    margin-bottom: 5px;

  }


  .info-grid strong {

    font-size: 13px;

  }


  .info-grid span {

    color:
      var(--muted);

    font-size: 10px;

  }


  /* =====================================================
     MOBILE
  ====================================================== */

  @media (max-width: 800px) {

    .editor-grid {

      grid-template-columns:
        1fr;

    }


    .editor-card + .editor-card {

      border-left: 0;

      border-top:
        1px solid var(--border);

    }


    .toolbar {

      flex-direction:
        column;

      align-items:
        stretch;

    }


    .toolbar-group {

      justify-content:
        center;

    }

  }


  @media (max-width: 600px) {

    .page {

      width:
        calc(100% - 16px);

      padding-top:
        22px;

    }


    .tool-title h1 {

      font-size:
        24px;

    }


    .tool-icon {

      width: 54px;
      height: 54px;

      font-size:
        22px;

    }


    .breadcrumb {

      overflow-x:
        auto;

      white-space:
        nowrap;

    }


    .toolbar button {

      flex: 1;

    }


    .info-grid {

      grid-template-columns:
        1fr;

    }

  }

</style>
