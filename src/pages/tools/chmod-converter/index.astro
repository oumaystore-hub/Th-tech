    <!-- FAQ -->
    <section class="faq-section">

      <div class="container">

        <div class="section-heading">

          <div class="heading-icon">
            <i class="fa-solid fa-circle-question"></i>
          </div>

          <div>
            <h2>الأسئلة الشائعة</h2>
            <p>
              معلومات سريعة حول CHMOD
            </p>
          </div>

        </div>


        <div class="faq">

          <details open>

            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ماذا يعني chmod 755؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              المالك لديه القراءة والكتابة والتنفيذ
              <code>rwx</code>،
              بينما المجموعة والآخرون لديهم القراءة والتنفيذ
              <code>r-x</code>.
            </p>

          </details>


          <details>

            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ماذا يعني chmod 644؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              المالك لديه القراءة والكتابة
              <code>rw-</code>،
              والمجموعة والآخرون لديهم القراءة فقط
              <code>r--</code>.
            </p>

          </details>


          <details>

            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                هل يتم إرسال البيانات إلى خادم؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              لا. جميع عمليات التحويل تتم داخل المتصفح ولا تحتاج إلى API.
            </p>

          </details>


          <details>

            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ما الفرق بين Numeric و Symbolic؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              Numeric تستخدم أرقامًا مثل
              <code>755</code>،
              بينما Symbolic تستخدم
              <code>r</code>
              و
              <code>w</code>
              و
              <code>x</code>
              والشرطة
              <code>-</code>.
            </p>

          </details>

        </div>

      </div>

    </section>

  </main>

  <Footer />


  <script>
    document.addEventListener('DOMContentLoaded', () => {

      const numericInput =
        document.getElementById('numericInput');

      const symbolicInput =
        document.getElementById('symbolicInput');

      const numericResult =
        document.getElementById('numericResult');

      const symbolicResult =
        document.getElementById('symbolicResult');

      const numericStatus =
        document.getElementById('numericStatus');

      const symbolicStatus =
        document.getElementById('symbolicStatus');

      const filenameInput =
        document.getElementById('filenameInput');

      const chmodCommand =
        document.getElementById('chmodCommand');


      function digitToSymbolic(value) {

        const number = Number(value);

        let result = '';

        result += number & 4 ? 'r' : '-';
        result += number & 2 ? 'w' : '-';
        result += number & 1 ? 'x' : '-';

        return result;
      }


      function numericToSymbolic(value) {

        if (!/^[0-7]{3}$/.test(value)) {
          return '';
        }

        return (
          digitToSymbolic(value[0]) +
          digitToSymbolic(value[1]) +
          digitToSymbolic(value[2])
        );
      }


      function symbolicToDigit(value) {

        if (!/^[rwx-]{3}$/.test(value)) {
          return null;
        }

        let number = 0;

        if (value[0] === 'r') {
          number += 4;
        }

        if (value[1] === 'w') {
          number += 2;
        }

        if (value[2] === 'x') {
          number += 1;
        }

        return number;
      }


      function symbolicToNumeric(value) {

        if (!/^[rwx-]{9}$/.test(value)) {
          return '';
        }

        const a =
          symbolicToDigit(value.substring(0, 3));

        const b =
          symbolicToDigit(value.substring(3, 6));

        const c =
          symbolicToDigit(value.substring(6, 9));

        if (
          a === null ||
          b === null ||
          c === null
        ) {
          return '';
        }

        return `${a}${b}${c}`;
      }


      function setStatus(element, valid, message) {

        if (!element) {
          return;
        }

        element.className =
          valid ? 'ok' : 'error';

        element.innerHTML = valid
          ? `<i class="fa-solid fa-circle-check"></i>${message}`
          : `<i class="fa-solid fa-circle-xmark"></i>${message}`;
      }


      function updateMatrix(value) {

        if (!/^[0-7]{3}$/.test(value)) {
          return;
        }

        const numbers = [
          Number(value[0]),
          Number(value[1]),
          Number(value[2])
        ];

        const groups = [
          ['uRead', 'uWrite', 'uExecute', 'uValue'],
          ['gRead', 'gWrite', 'gExecute', 'gValue'],
          ['oRead', 'oWrite', 'oExecute', 'oValue']
        ];


        groups.forEach((group, index) => {

          const number = numbers[index];

          const read =
            document.getElementById(group[0]);

          const write =
            document.getElementById(group[1]);

          const execute =
            document.getElementById(group[2]);

          const output =
            document.getElementById(group[3]);


          if (read) {
            read.checked = Boolean(number & 4);
          }

          if (write) {
            write.checked = Boolean(number & 2);
          }

          if (execute) {
            execute.checked = Boolean(number & 1);
          }

          if (output) {
            output.textContent = String(number);
          }

        });
      }


      function updateCommand() {

        let filename =
          filenameInput.value.trim();

        if (!filename) {
          filename = 'filename';
        }

        const value =
          numericInput.value || '000';

        chmodCommand.textContent =
          `chmod ${value} ${filename}`;
      }


      function updateFromNumeric(value) {

        if (!/^[0-7]{3}$/.test(value)) {

          setStatus(
            numericStatus,
            false,
            'أدخل 3 أرقام من 0 إلى 7'
          );

          return;
        }

        const symbolic =
          numericToSymbolic(value);

        symbolicInput.value = symbolic;

        numericResult.textContent = value;

        symbolicResult.textContent = symbolic;

        setStatus(
          numericStatus,
          true,
          'صحيح'
        );

        setStatus(
          symbolicStatus,
          true,
          'صحيح'
        );

        updateMatrix(value);
        updateCommand();
      }


      function updateFromSymbolic(value) {

        if (!/^[rwx-]{9}$/.test(value)) {

          setStatus(
            symbolicStatus,
            false,
            'الصيغة غير مكتملة'
          );

          return;
        }

        const numeric =
          symbolicToNumeric(value);

        if (!numeric) {

          setStatus(
            symbolicStatus,
            false,
            'صيغة غير صحيحة'
          );

          return;
        }

        numericInput.value = numeric;

        numericResult.textContent = numeric;

        symbolicResult.textContent = value;

        setStatus(
          numericStatus,
          true,
          'صحيح'
        );

        setStatus(
          symbolicStatus,
          true,
          'صحيح'
        );

        updateMatrix(numeric);
        updateCommand();
      }


      function getMatrixValue() {

        const groups = [
          ['uRead', 'uWrite', 'uExecute'],
          ['gRead', 'gWrite', 'gExecute'],
          ['oRead', 'oWrite', 'oExecute']
        ];


        return groups.map(group => {

          let number = 0;

          const read =
            document.getElementById(group[0]);

          const write =
            document.getElementById(group[1]);

          const execute =
            document.getElementById(group[2]);


          if (read && read.checked) {
            number += 4;
          }

          if (write && write.checked) {
            number += 2;
          }

          if (execute && execute.checked) {
            number += 1;
          }

          return number;

        }).join('');
      }


      function updateFromMatrix() {

        const numeric =
          getMatrixValue();

        const symbolic =
          numericToSymbolic(numeric);

        numericInput.value = numeric;

        symbolicInput.value = symbolic;

        numericResult.textContent = numeric;

        symbolicResult.textContent = symbolic;

        setStatus(
          numericStatus,
          true,
          'صحيح'
        );

        setStatus(
          symbolicStatus,
          true,
          'صحيح'
        );

        updateMatrix(numeric);
        updateCommand();
      }


      function copyText(text) {

        if (!text) {
          return;
        }

        if (
          navigator.clipboard &&
          window.isSecureContext
        ) {

          navigator.clipboard
            .writeText(text)
            .then(() => showToast('تم النسخ'));

          return;
        }


        const textarea =
          document.createElement('textarea');

        textarea.value = text;

        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';

        document.body.appendChild(textarea);

        textarea.focus();
        textarea.select();

        try {
          document.execCommand('copy');
          showToast('تم النسخ');
        } catch (error) {
          showToast('تعذر النسخ');
        }

        textarea.remove();
      }


      function showToast(message) {

        const old =
          document.querySelector('.chmod-toast');

        if (old) {
          old.remove();
        }

        const toast =
          document.createElement('div');

        toast.className = 'chmod-toast';

        toast.innerHTML =
          `<i class="fa-solid fa-check"></i>${message}`;

        document.body.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.add('show');
        });

        setTimeout(() => {

          toast.classList.remove('show');

          setTimeout(() => {
            toast.remove();
          }, 200);

        }, 1600);
      }


      /* Numeric input */

      numericInput.addEventListener(
        'input',
        () => {

          let value =
            numericInput.value
              .replace(/[^0-7]/g, '')
              .substring(0, 3);

          numericInput.value = value;

          if (value.length === 3) {
            updateFromNumeric(value);
          }

        }
      );


      /* Symbolic input */

      symbolicInput.addEventListener(
        'input',
        () => {

          let value =
            symbolicInput.value
              .toLowerCase()
              .replace(/[^rwx-]/g, '')
              .substring(0, 9);

          symbolicInput.value = value;

          if (value.length === 9) {
            updateFromSymbolic(value);
          }

        }
      );


      /* Filename */

      filenameInput.addEventListener(
        'input',
        updateCommand
      );


      /* Matrix */

      const matrixInputs = document.querySelectorAll(
        '.permission-check input'
      );


      matrixInputs.forEach(input => {

        input.addEventListener(
          'change',
          updateFromMatrix
        );

      });


      /* Presets */

      const presets =
        document.querySelectorAll('.preset');


      presets.forEach(button => {

        button.addEventListener(
          'click',
          () => {

            const value =
              button.getAttribute('data-value');

            if (!value) {
              return;
            }

            numericInput.value = value;

            updateFromNumeric(value);

          }
        );

      });


      /* Copy buttons */

      const copyButtons =
        document.querySelectorAll('[data-copy]');


      copyButtons.forEach(button => {

        button.addEventListener(
          'click',
          () => {

            const id =
              button.getAttribute('data-copy');

            const element =
              document.getElementById(id);

            if (!element) {
              return;
            }

            const value =
              'value' in element
                ? element.value
                : element.textContent;

            copyText(String(value).trim());

          }
        );

      });


      /* Copy command */

      document
        .getElementById('copyCommand')
        .addEventListener(
          'click',
          () => {

            copyText(
              chmodCommand.textContent.trim()
            );

          }
        );


      /* Copy all */

      document
        .getElementById('copyAllBtn')
        .addEventListener(
          'click',
          () => {

            const text =
              `Numeric: ${numericResult.textContent.trim()}\n` +
              `Symbolic: ${symbolicResult.textContent.trim()}\n` +
              `Command: ${chmodCommand.textContent.trim()}`;

            copyText(text);

          }
        );


      /* Clear */

      document
        .getElementById('clearBtn')
        .addEventListener(
          'click',
          () => {

            numericInput.value = '';
            symbolicInput.value = '';

            numericResult.textContent = '—';
            symbolicResult.textContent = '—';

            setStatus(
              numericStatus,
              false,
              'فارغ'
            );

            setStatus(
              symbolicStatus,
              false,
              'فارغ'
            );

            matrixInputs.forEach(input => {
              input.checked = false;
            });

            document.getElementById(
              'uValue'
            ).textContent = '0';

            document.getElementById(
              'gValue'
            ).textContent = '0';

            document.getElementById(
              'oValue'
            ).textContent = '0';

            updateCommand();

          }
        );


      /* Reset */

      document
        .getElementById('resetBtn')
        .addEventListener(
          'click',
          () => {

            numericInput.value = '755';

            updateFromNumeric('755');

          }
        );


      /* Initial state */

      updateFromNumeric('755');

    });
  </script>

</body>
</html>


