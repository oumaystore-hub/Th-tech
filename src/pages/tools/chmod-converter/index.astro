---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/chmod-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CHMOD Converter | محول صلاحيات Linux | Th.Tech</title>

  <meta
    name="description"
    content="محول CHMOD لتحويل صلاحيات Linux بين الصيغة الرقمية والرمزية وإنشاء أوامر chmod بسهولة."
  />

  <meta
    name="keywords"
    content="chmod converter, chmod calculator, linux permissions, chmod 755, chmod 644, محول chmod, صلاحيات لينكس"
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
