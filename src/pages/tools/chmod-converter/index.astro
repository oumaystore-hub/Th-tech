---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/chmod-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CHMOD Converter | محول صلاحيات Linux | Th.Tech</title>

  <meta
    name="description"
    content="محول CHMOD احترافي لتحويل صلاحيات Linux بين الصيغة الرقمية والصيغة الرمزية مع إنشاء أمر chmod تلقائياً."
  />

  <meta
    name="keywords"
    content="CHMOD Converter, chmod, Linux permissions, Linux permissions calculator, محول chmod, صلاحيات لينكس"
  />

  <link rel="canonical" href={canonical} />

  <meta property="og:title" content="CHMOD Converter | محول صلاحيات Linux" />
  <meta
    property="og:description"
    content="حوّل صلاحيات Linux بسهولة بين الصيغة الرقمية والرمزية وأنشئ أمر chmod جاهزاً."
  />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="chmod-page">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-glow glow-one"></div>
      <div class="hero-glow glow-two"></div>

      <div class="container hero-content">

        <div class="hero-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div class="badge">
          <i class="fa-solid fa-terminal"></i>
          Linux Permissions Tool
        </div>

        <h1>
          CHMOD
          <span>Converter</span>
        </h1>

        <p>
          محول احترافي لصلاحيات Linux
          <br />
          حوّل بين الصيغة الرقمية والرمزية وأنشئ أمر chmod جاهزاً للاستخدام.
        </p>

        <div class="hero-tags">
          <span>
            <i class="fa-solid fa-code"></i>
            Numeric
          </span>

          <span>
            <i class="fa-solid fa-list-check"></i>
            Symbolic
          </span>

          <span>
            <i class="fa-solid fa-terminal"></i>
            chmod Command
          </span>
        </div>

      </div>
    </section>


    <!-- Main Tool -->
    <section class="tool-section">
      <div class="container">

        <div class="tool-card">

          <!-- Tool Header -->
          <div class="tool-header">

            <div>
              <div class="tool-title">
                <i class="fa-solid fa-sliders"></i>
                محول الصلاحيات
              </div>

              <p>
                أدخل قيمة CHMOD الرقمية أو الرمزية وسيتم تحديث جميع النتائج تلقائياً.
              </p>
            </div>

            <button
              type="button"
              class="clear-btn"
              id="clearBtn"
              title="مسح"
            >
              <i class="fa-solid fa-rotate-left"></i>
              مسح
            </button>

          </div>


          <!-- Inputs -->
          <div class="input-grid">

            <!-- Numeric -->
            <div class="input-box">

              <label for="numericInput">
                <span>
                  <i class="fa-solid fa-hashtag"></i>
                  الصيغة الرقمية
                </span>

                <small>مثال: 755</small>
              </label>

              <div class="input-wrapper">

                <input
                  id="numericInput"
                  type="text"
                  inputmode="numeric"
                  maxlength="3"
                  value="755"
                  placeholder="755"
                  autocomplete="off"
                  spellcheck="false"
                />

                <button
                  type="button"
                  class="input-copy"
                  data-copy-target="numericInput"
                  title="نسخ"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>

              <div class="input-help">
                <span>كل رقم من 0 إلى 7</span>
                <span id="numericStatus" class="status valid">
                  <i class="fa-solid fa-circle-check"></i>
                  صحيح
                </span>
              </div>

            </div>


            <!-- Symbolic -->
            <div class="input-box">

              <label for="symbolicInput">
                <span>
                  <i class="fa-solid fa-code"></i>
                  الصيغة الرمزية
                </span>

                <small>مثال: rwxr-xr-x</small>
              </label>

              <div class="input-wrapper symbolic-wrapper">

                <input
                  id="symbolicInput"
                  type="text"
                  maxlength="9"
                  value="rwxr-xr-x"
                  placeholder="rwxr-xr-x"
                  autocomplete="off"
                  spellcheck="false"
                  dir="ltr"
                />

                <button
                  type="button"
                  class="input-copy"
                  data-copy-target="symbolicInput"
                  title="نسخ"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>

              <div class="input-help">
                <span>9 أحرف: r w x -</span>
                <span id="symbolicStatus" class="status valid">
                  <i class="fa-solid fa-circle-check"></i>
                  صحيح
                </span>
              </div>

            </div>

          </div>


          <!-- Results -->
          <div class="results-grid">

            <div class="result-card numeric-result">

              <div class="result-label">
                <i class="fa-solid fa-hashtag"></i>
                القيمة الرقمية
              </div>

              <div
                class="result-value"
                id="numericResult"
                dir="ltr"
              >
                755
              </div>

              <button
                type="button"
                class="result-copy"
                data-copy-target="numericResult"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

            </div>


            <div class="result-card symbolic-result">

              <div class="result-label">
                <i class="fa-solid fa-code"></i>
                القيمة الرمزية
              </div>

              <div
                class="result-value symbolic-value"
                id="symbolicResult"
                dir="ltr"
              >
                rwxr-xr-x
              </div>

              <button
                type="button"
                class="result-copy"
                data-copy-target="symbolicResult"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

            </div>

          </div>


          <!-- Command -->
          <div class="command-section">

            <div class="section-title">
              <div>
                <i class="fa-solid fa-terminal"></i>
                أمر chmod
              </div>

              <span>
                جاهز للاستخدام
              </span>
            </div>

            <div class="terminal">

              <div class="terminal-top">
                <div class="terminal-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <span>bash</span>
              </div>

              <div class="terminal-content" dir="ltr">

                <span class="terminal-prompt">$</span>

                <span id="chmodCommand">
                  chmod 755 filename
                </span>

                <button
                  type="button"
                  class="terminal-copy"
                  id="copyCommand"
                  title="نسخ الأمر"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>

            </div>

            <div class="filename-row">

              <label for="filenameInput">
                اسم الملف / المجلد
              </label>

              <input
                id="filenameInput"
                type="text"
                value="filename"
                placeholder="filename"
                dir="ltr"
                autocomplete="off"
              />

            </div>

          </div>


          <!-- Permission Matrix -->
          <div class="matrix-section">

            <div class="section-title">
              <div>
                <i class="fa-solid fa-table-list"></i>
                مصفوفة الصلاحيات
              </div>

              <span>
                انقر على الصلاحيات
              </span>
            </div>

            <div class="permission-table">

              <div class="permission-head">
                <div>المستخدم</div>
                <div>قراءة</div>
                <div>كتابة</div>
                <div>تنفيذ</div>
                <div>القيمة</div>
              </div>


              <!-- User -->
              <div class="permission-row">

                <div class="role">
                  <span class="role-icon user-icon">
                    <i class="fa-solid fa-user"></i>
                  </span>

                  <div>
                    <strong>User</strong>
                    <small>المالك</small>
                  </div>
                </div>

                <label class="check">
                  <input type="checkbox" id="uRead" checked />
                  <span>
                    <i class="fa-solid fa-eye"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="uWrite" checked />
                  <span>
                    <i class="fa-solid fa-pen"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="uExecute" checked />
                  <span>
                    <i class="fa-solid fa-play"></i>
                  </span>
                </label>

                <strong class="permission-number" id="uValue">7</strong>

              </div>


              <!-- Group -->
              <div class="permission-row">

                <div class="role">
                  <span class="role-icon group-icon">
                    <i class="fa-solid fa-users"></i>
                  </span>

                  <div>
                    <strong>Group</strong>
                    <small>المجموعة</small>
                  </div>
                </div>

                <label class="check">
                  <input type="checkbox" id="gRead" checked />
                  <span>
                    <i class="fa-solid fa-eye"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="gWrite" />
                  <span>
                    <i class="fa-solid fa-pen"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="gExecute" checked />
                  <span>
                    <i class="fa-solid fa-play"></i>
                  </span>
                </label>

                <strong class="permission-number" id="gValue">5</strong>

              </div>


              <!-- Others -->
              <div class="permission-row">

                <div class="role">
                  <span class="role-icon others-icon">
                    <i class="fa-solid fa-globe"></i>
                  </span>

                  <div>
                    <strong>Others</strong>
                    <small>الآخرون</small>
                  </div>
                </div>

                <label class="check">
                  <input type="checkbox" id="oRead" checked />
                  <span>
                    <i class="fa-solid fa-eye"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="oWrite" />
                  <span>
                    <i class="fa-solid fa-pen"></i>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" id="oExecute" checked />
                  <span>
                    <i class="fa-solid fa-play"></i>
                  </span>
                </label>

                <strong class="permission-number" id="oValue">5</strong>

              </div>

            </div>

          </div>


          <!-- Presets -->
          <div class="presets-section">

            <div class="section-title">
              <div>
                <i class="fa-solid fa-bolt"></i>
                صلاحيات شائعة
              </div>

              <span>
                اختيار سريع
              </span>
            </div>

            <div class="preset-grid">

              <button type="button" class="preset" data-mode="755">
                <strong>755</strong>
                <span>rwxr-xr-x</span>
                <small>تنفيذ شائع للملفات</small>
              </button>

              <button type="button" class="preset" data-mode="644">
                <strong>644</strong>
                <span>rw-r--r--</span>
                <small>ملفات عادية</small>
              </button>

              <button type="button" class="preset" data-mode="700">
                <strong>700</strong>
                <span>rwx------</span>
                <small>المالك فقط</small>
              </button>

              <button type="button" class="preset" data-mode="600">
                <strong>600</strong>
                <span>rw-------</span>
                <small>قراءة وكتابة للمالك</small>
              </button>

              <button type="button" class="preset" data-mode="775">
                <strong>775</strong>
                <span>rwxrwxr-x</span>
                <small>مالك ومجموعة</small>
              </button>

              <button type="button" class="preset warning-preset" data-mode="777">
                <strong>777</strong>
                <span>rwxrwxrwx</span>
                <small>صلاحيات كاملة للجميع</small>
              </button>

            </div>

          </div>


          <!-- Reset -->
          <div class="tool-actions">

            <button
              type="button"
              class="primary-action"
              id="resetBtn"
            >
              <i class="fa-solid fa-rotate"></i>
              إعادة 755
            </button>

            <button
              type="button"
              class="secondary-action"
              id="copyAllBtn"
            >
              <i class="fa-regular fa-copy"></i>
              نسخ النتائج
            </button>

          </div>

        </div>

      </div>
    </section>


    <!-- Explanation -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">
          <span class="heading-icon">
            <i class="fa-solid fa-circle-info"></i>
          </span>

          <div>
            <h2>ما هي صلاحيات CHMOD؟</h2>
            <p>
              فهم نظام الصلاحيات في Linux بطريقة بسيطة
            </p>
          </div>
        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-card-icon">
              <i class="fa-solid fa-eye"></i>
            </div>

            <h3>Read — القراءة</h3>

            <p>
              تسمح بقراءة محتوى الملف أو عرض محتويات المجلد.
            </p>

            <div class="permission-badge">
              <strong>4</strong>
              <span>r</span>
            </div>

          </article>


          <article class="info-card">

            <div class="info-card-icon">
              <i class="fa-solid fa-pen"></i>
            </div>

            <h3>Write — الكتابة</h3>

            <p>
              تسمح بتعديل محتوى الملف أو إنشاء وحذف العناصر في المجلد.
            </p>

            <div class="permission-badge">
              <strong>2</strong>
              <span>w</span>
            </div>

          </article>


          <article class="info-card">

            <div class="info-card-icon">
              <i class="fa-solid fa-play"></i>
            </div>

            <h3>Execute — التنفيذ</h3>

            <p>
              تسمح بتنفيذ الملف أو بالدخول إلى المجلد واستخدامه.
            </p>

            <div class="permission-badge">
              <strong>1</strong>
              <span>x</span>
            </div>

          </article>

        </div>


        <!-- Numeric explanation -->
        <div class="numeric-explanation">

          <div class="explanation-title">
            <i class="fa-solid fa-calculator"></i>
            كيف تُحسب القيمة الرقمية؟
          </div>

          <div class="calculation-grid">

            <div class="calculation-card">
              <strong>4</strong>
              <span>Read</span>
              <small>r--</small>
            </div>

            <div class="plus">+</div>

            <div class="calculation-card">
              <strong>2</strong>
              <span>Write</span>
              <small>-w-</small>
            </div>

            <div class="plus">+</div>

            <div class="calculation-card">
              <strong>1</strong>
              <span>Execute</span>
              <small>--x</small>
            </div>

            <div class="equals">=</div>

            <div class="calculation-card total">
              <strong>7</strong>
              <span>rwx</span>
              <small>4 + 2 + 1</small>
            </div>

          </div>

          <p class="explanation-note">
            مثال:
            <code dir="ltr">755</code>
            تعني أن المالك لديه
            <strong>7 = 4 + 2 + 1</strong>
            والمجموعة والآخرون لديهم
            <strong>5 = 4 + 1</strong>.
          </p>

        </div>

      </div>
    </section>


    <!-- How to use -->
    <section class="steps-section">
      <div class="container">

        <div class="section-heading">
          <span class="heading-icon">
            <i class="fa-solid fa-list-ol"></i>
          </span>

          <div>
            <h2>طريقة الاستخدام</h2>
            <p>تحويل الصلاحيات في خطوات بسيطة</p>
          </div>
        </div>


        <div class="steps-grid">

          <div class="step-card">
            <span class="step-number">01</span>

            <div class="step-icon">
              <i class="fa-solid fa-keyboard"></i>
            </div>

            <h3>أدخل الصلاحية</h3>

            <p>
              أدخل القيمة الرقمية مثل 755 أو القيمة الرمزية مثل rwxr-xr-x.
            </p>
          </div>


          <div class="step-card">
            <span class="step-number">02</span>

            <div class="step-icon">
              <i class="fa-solid fa-arrows-rotate"></i>
            </div>

            <h3>شاهد التحويل</h3>

            <p>
              يتم تحويل الصلاحية تلقائياً في الاتجاهين دون الحاجة إلى إرسال أي بيانات.
            </p>
          </div>


          <div class="step-card">
            <span class="step-number">03</span>

            <div class="step-icon">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <h3>انسخ الأمر</h3>

            <p>
              احصل على أمر chmod جاهز مع اسم الملف أو المجلد الذي تحدده.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- Security -->
    <section class="security-section">
      <div class="container">

        <div class="security-card">

          <div class="security-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div class="security-content">

            <h2>تنبيه أمني</h2>

            <p>
              تجنب استخدام
              <code dir="ltr">chmod 777</code>
              إلا عندما تكون هناك حاجة واضحة لذلك.
              هذه الصلاحيات تمنح القراءة والكتابة والتنفيذ لجميع المستخدمين،
              وقد تزيد من مخاطر الوصول غير المصرح به.
            </p>

          </div>

          <div class="security-value">
            777
          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">
          <span class="heading-icon">
            <i class="fa-solid fa-circle-question"></i>
          </span>

          <div>
            <h2>الأسئلة الشائعة</h2>
            <p>أهم الأسئلة حول CHMOD</p>
          </div>
        </div>


        <div class="faq-list">

          <details open>
            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ماذا يعني chmod 755؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <div class="faq-answer">
              <p>
                تعني أن المالك لديه صلاحيات القراءة والكتابة والتنفيذ
                <code dir="ltr">rwx</code>،
                بينما المجموعة والآخرون لديهم القراءة والتنفيذ
                <code dir="ltr">r-x</code>.
              </p>
            </div>
          </details>


          <details>
            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ماذا يعني chmod 644؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <div class="faq-answer">
              <p>
                المالك يستطيع القراءة والكتابة
                <code dir="ltr">rw-</code>،
                بينما المجموعة والآخرون يستطيعون القراءة فقط
                <code dir="ltr">r--</code>.
              </p>
            </div>
          </details>


          <details>
            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                هل يتم إرسال البيانات إلى خادم؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <div class="faq-answer">
              <p>
                لا. عملية التحويل تتم بالكامل داخل المتصفح باستخدام JavaScript،
                ولا تحتاج الأداة إلى API أو خادم لمعالجة الصلاحيات.
              </p>
            </div>
          </details>


          <details>
            <summary>
              <span>
                <i class="fa-solid fa-question"></i>
                ما الفرق بين الصيغة الرقمية والرمزية؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <div class="faq-answer">
              <p>
                الصيغة الرقمية تستخدم أرقاماً مثل
                <code dir="ltr">755</code>،
                بينما الصيغة الرمزية تستخدم الأحرف
                <code dir="ltr">r</code>
                و
                <code dir="ltr">w</code>
                و
                <code dir="ltr">x</code>
                لتمثيل الصلاحيات.
              </p>
            </div>
          </details>

        </div>

      </div>
    </section>

  </main>

  <Footer />


  <script>
    const numericInput = document.getElementById('numericInput');
    const symbolicInput = document.getElementById('symbolicInput');

    const numericResult = document.getElementById('numericResult');
    const symbolicResult = document.getElementById('symbolicResult');

    const numericStatus = document.getElementById('numericStatus');
    const symbolicStatus = document.getElementById('symbolicStatus');

    const chmodCommand = document.getElementById('chmodCommand');
    const filenameInput = document.getElementById('filenameInput');

    const clearBtn = document.getElementById('clearBtn');
    const resetBtn = document.getElementById('resetBtn');
    const copyCommand = document.getElementById('copyCommand');
    const copyAllBtn = document.getElementById('copyAllBtn');

    const permissionInputs = [
      'uRead',
      'uWrite',
      'uExecute',
      'gRead',
      'gWrite',
      'gExecute',
      'oRead',
      'oWrite',
      'oExecute'
    ];


    function digitToSymbolic(digit) {
      const n = Number(digit);

      let result = '';

      result += (n & 4) ? 'r' : '-';
      result += (n & 2) ? 'w' : '-';
      result += (n & 1) ? 'x' : '-';

      return result;
    }


    function numericToSymbolic(value) {
      if (!/^[0-7]{3}$/.test(value)) {
        return '';
      }

      return (
        digitToSymbolic(value[0]) +
        digitToSymbolic(value[1]) +
        digitToSymbolic(value[2])
      );
    }


    function symbolicTripleToDigit(triple) {
      if (!/^[r-][w-][x-]$/.test(triple)) {
        return null;
      }

      let value = 0;

      if (triple[0] === 'r') value += 4;
      if (triple[1] === 'w') value += 2;
      if (triple[2] === 'x') value += 1;

      return value;
    }


    function symbolicToNumeric(value) {
      if (!/^[rwx-]{9}$/.test(value)) {
        return '';
      }

      const first = symbolicTripleToDigit(value.slice(0, 3));
      const second = symbolicTripleToDigit(value.slice(3, 6));
      const third = symbolicTripleToDigit(value.slice(6, 9));

      if (
        first === null ||
        second === null ||
        third === null
      ) {
        return '';
      }

      return `${first}${second}${third}`;
    }


    function setStatus(element, valid, text) {
      if (!element) return;

      element.className = valid
        ? 'status valid'
        : 'status invalid';

      element.innerHTML = valid
        ? `<i class="fa-solid fa-circle-check"></i>${text}`
        : `<i class="fa-solid fa-circle-xmark"></i>${text}`;
    }


    function updateMatrix(numeric) {
      if (!/^[0-7]{3}$/.test(numeric)) {
        return;
      }

      const values = [
        Number(numeric[0]),
        Number(numeric[1]),
        Number(numeric[2])
      ];

      const ids = [
        ['uRead', 'uWrite', 'uExecute'],
        ['gRead', 'gWrite', 'gExecute'],
        ['oRead', 'oWrite', 'oExecute']
      ];

      const valueIds = [
        'uValue',
        'gValue',
        'oValue'
      ];

      values.forEach((value, index) => {

        const checks = [
          Boolean(value & 4),
          Boolean(value & 2),
          Boolean(value & 1)
        ];

        checks.forEach((checked, checkIndex) => {
          const input = document.getElementById(
            ids[index][checkIndex]
          );

          if (input) {
            input.checked = checked;
          }
        });

        const output = document.getElementById(
          valueIds[index]
        );

        if (output) {
          output.textContent = String(value);
        }

      });
    }


    function updateAll(numeric, symbolic) {

      numericResult.textContent = numeric || '—';
      symbolicResult.textContent = symbolic || '—';

      numericInput.value = numeric;
      symbolicInput.value = symbolic;

      if (numeric) {
        updateMatrix(numeric);
      }

      updateCommand();
    }


    function applyNumeric(rawValue) {

      const value = String(rawValue)
        .replace(/\D/g, '')
        .slice(0, 3);

      numericInput.value = value;

      if (!/^[0-7]{3}$/.test(value)) {

        setStatus(
          numericStatus,
          false,
          'أدخل 3 أرقام من 0 إلى 7'
        );

        return;
      }

      const symbolic = numericToSymbolic(value);

      setStatus(
        numericStatus,
        true,
        'صحيح'
      );

      setStatus(
        symbolicStatus,
        true,
        'صحيح'
      );

      updateAll(value, symbolic);
    }


    function applySymbolic(rawValue) {

      const value = String(rawValue)
        .toLowerCase()
        .replace(/[^rwx-]/g, '')
        .slice(0, 9);

      symbolicInput.value = value;

      if (!/^[rwx-]{9}$/.test(value)) {

        setStatus(
          symbolicStatus,
          false,
          'أدخل 9 أحرف'
        );

        return;
      }

      const numeric = symbolicToNumeric(value);

      if (!numeric) {

        setStatus(
          symbolicStatus,
          false,
          'صيغة غير صحيحة'
        );

        return;
      }

      setStatus(
        symbolicStatus,
        true,
        'صحيح'
      );

      setStatus(
        numericStatus,
        true,
        'صحيح'
      );

      updateAll(numeric, value);
    }


    function getNumericFromMatrix() {

      const groups = [
        ['uRead', 'uWrite', 'uExecute'],
        ['gRead', 'gWrite', 'gExecute'],
        ['oRead', 'oWrite', 'oExecute']
      ];

      return groups.map(group => {

        let value = 0;

        const read = document.getElementById(group[0]);
        const write = document.getElementById(group[1]);
        const execute = document.getElementById(group[2]);

        if (read?.checked) value += 4;
        if (write?.checked) value += 2;
        if (execute?.checked) value += 1;

        return value;

      }).join('');
    }


    function updateFromMatrix() {

      const numeric = getNumericFromMatrix();
      const symbolic = numericToSymbolic(numeric);

      updateAll(numeric, symbolic);

      setStatus(
        numericStatus,
        true,
        'صحيح'
      );

      setStatus(
        symbolicStatus,
        true,
        'صحيح'
      );
    }


    function updateCommand() {

      const numeric = numericInput.value || '000';

      let filename = filenameInput.value.trim();

      if (!filename) {
        filename = 'filename';
      }

      chmodCommand.textContent =
        `chmod ${numeric} ${filename}`;
    }


    function copyText(text) {

      if (!text) {
        return;
      }

      if (
        navigator.clipboard &&
        window.isSecureContext
      ) {

        navigator.clipboard.writeText(text)
          .then(() => showToast('تم النسخ بنجاح'));

        return;
      }

      const textarea =
        document.createElement('textarea');

      textarea.value = text;

      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';

      document.body.appendChild(textarea);

      textarea.select();

      try {
        document.execCommand('copy');
        showToast('تم النسخ بنجاح');
      } catch (error) {
        showToast('تعذر النسخ');
      }

      textarea.remove();
    }


    function showToast(message) {

      const oldToast =
        document.querySelector('.copy-toast');

      if (oldToast) {
        oldToast.remove();
      }

      const toast =
        document.createElement('div');

      toast.className = 'copy-toast';

      toast.innerHTML =
        `<i class="fa-solid fa-check"></i>${message}`;

      document.body.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.add('show');
      });

      setTimeout(() => {

        toast.classList.remove('show');

        setTimeout(() => {
          toast.remove();
        }, 250);

      }, 1800);
    }


    numericInput.addEventListener(
      'input',
      event => {
        applyNumeric(event.target.value);
      }
    );


    symbolicInput.addEventListener(
      'input',
      event => {
        applySymbolic(event.target.value);
      }
    );


    filenameInput.addEventListener(
      'input',
      updateCommand
    );


    permissionInputs.forEach(id => {

      const input =
        document.getElementById(id);

      if (input) {
        input.addEventListener(
          'change',
          updateFromMatrix
        );
      }

    });


    document.querySelectorAll(
      '.preset[data-mode]'
    ).forEach(button => {

      button.addEventListener(
        'click',
        () => {

          const value =
            button.dataset.mode;

          applyNumeric(value);

        }
      );

    });


    document.querySelectorAll(
      '[data-copy-target]'
    ).forEach(button => {

      button.addEventListener(
        'click',
        () => {

          const targetId =
            button.dataset.copyTarget;

          const target =
            document.getElementById(targetId);

          if (!target) return;

          const text =
            target.value !== undefined
              ? target.value
              : target.textContent;

          copyText(text.trim());

        }
      );

    });


    copyCommand.addEventListener(
      'click',
      () => {

        copyText(
          chmodCommand.textContent.trim()
        );

      }
    );


    copyAllBtn.addEventListener(
      'click',
      () => {

        const numeric =
          numericResult.textContent.trim();

        const symbolic =
          symbolicResult.textContent.trim();

        const command =
          chmodCommand.textContent.trim();

        const text =
          `Numeric: ${numeric}\n` +
          `Symbolic: ${symbolic}\n` +
          `Command: ${command}`;

        copyText(text);

      }
    );


    clearBtn.addEventListener(
      'click',
      () => {

        numericInput.value = '';
        symbolicInput.value = '';

        numericResult.textContent = '—';
        symbolicResult.textContent = '—';

        setStatus(
          numericStatus,
          false,
          'فارغ'
        );

        setStatus(
          symbolicStatus,
          false,
          'فارغ'
        );

        permissionInputs.forEach(id => {

          const input =
            document.getElementById(id);

          if (input) {
            input.checked = false;
          }

        });

        document.getElementById('uValue').textContent = '0';
        document.getElementById('gValue').textContent = '0';
        document.getElementById('oValue').textContent = '0';

        updateCommand();

      }
    );


    resetBtn.addEventListener(
      'click',
      () => {

        applyNumeric('755');

      }
    );


    function syncTheme() {

      const html =
        document.documentElement;

      const theme =
        localStorage.getItem('theme');

      if (theme === 'light') {
        html.setAttribute(
          'data-theme',
          'light'
        );
      }

    }


    try {
      syncTheme();
    } catch (error) {
      // Ignore localStorage restrictions.
    }


    const observer =
      new MutationObserver(() => {
        document.documentElement
          .classList.remove('theme-refresh');
      });


    observer.observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: [
          'class',
          'data-theme'
        ]
      }
    );


    applyNumeric('755');
  </script>

</body>
