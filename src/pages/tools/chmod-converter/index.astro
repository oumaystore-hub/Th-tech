---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/chmod-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CHMOD Converter | محول صلاحيات Linux - Th.Tech</title>

  <meta
    name="description"
    content="محول CHMOD احترافي لتحويل صلاحيات Linux بين الصيغة الرقمية والصيغة الرمزية بسهولة."
  />

  <meta
    name="keywords"
    content="CHMOD, Linux permissions, chmod converter, محول chmod, صلاحيات لينكس"
  />

  <link rel="canonical" href={canonical} />

  <meta name="theme-color" content="#07111f" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="chmod-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div class="hero-content">
        <span class="eyebrow">
          <i class="fa-brands fa-linux"></i>
          Linux Developer Tool
        </span>

        <h1>محول <span>CHMOD</span></h1>

        <p>
          حوّل صلاحيات ملفات Linux بين الصيغة الرقمية والرمزية
          بسهولة وسرعة.
        </p>
      </div>
    </section>


    <!-- MAIN CONVERTER -->
    <section class="converter-section">

      <!-- NUMERIC -->
      <div class="converter-card">

        <div class="card-header">
          <div class="header-icon numeric">
            <i class="fa-solid fa-hashtag"></i>
          </div>

          <div>
            <h2>الصيغة الرقمية</h2>
            <p>مثال: 755</p>
          </div>
        </div>

        <div class="input-wrapper">
          <input
            id="numericInput"
            type="text"
            inputmode="numeric"
            maxlength="3"
            value="755"
            placeholder="755"
            autocomplete="off"
          />

          <span class="input-label">CHMOD</span>
        </div>

        <button id="numericToSymbolicBtn" class="convert-btn primary">
          <i class="fa-solid fa-arrow-left-arrow-right"></i>
          تحويل إلى رمزية
        </button>

      </div>


      <!-- SYMBOLIC -->
      <div class="converter-card">

        <div class="card-header">
          <div class="header-icon symbolic">
            <i class="fa-solid fa-code"></i>
          </div>

          <div>
            <h2>الصيغة الرمزية</h2>
            <p>مثال: rwxr-xr-x</p>
          </div>
        </div>

        <div class="input-wrapper">
          <input
            id="symbolicInput"
            type="text"
            maxlength="9"
            value="rwxr-xr-x"
            placeholder="rwxr-xr-x"
            autocomplete="off"
          />

          <span class="input-label">SYMBOLIC</span>
        </div>

        <button id="symbolicToNumericBtn" class="convert-btn secondary">
          <i class="fa-solid fa-arrow-left-arrow-right"></i>
          تحويل إلى رقمي
        </button>

      </div>

    </section>


    <!-- RESULT -->
    <section class="result-section">

      <div class="result-card">

        <div class="result-top">

          <div>
            <span class="result-label">
              الصلاحية الرقمية
            </span>

            <div id="numericResult" class="big-value">
              755
            </div>
          </div>

          <div class="result-icon green">
            <i class="fa-solid fa-key"></i>
          </div>

        </div>

      </div>


      <div class="result-card">

        <div class="result-top">

          <div>
            <span class="result-label">
              الصلاحية الرمزية
            </span>

            <div id="symbolicResult" class="big-value symbolic-value">
              rwxr-xr-x
            </div>
          </div>

          <div class="result-icon blue">
            <i class="fa-solid fa-terminal"></i>
          </div>

        </div>

      </div>

    </section>


    <!-- COMMAND -->
