  <Footer />


  <!-- TOAST -->
  <div id="toast" class="toast">
    <i class="fa-solid fa-check"></i>
    <span id="toastMessage">تم النسخ بنجاح</span>
  </div>


  <script>
    document.addEventListener('DOMContentLoaded', () => {

      /* ============================================
       * TH-TECH THEME SYNC
       * ============================================ */

      function syncTheme() {
        const theme = localStorage.getItem('theme');

        if (theme === 'light') {
          document.documentElement.setAttribute(
            'data-theme',
            'light'
          );
        } else {
          document.documentElement.removeAttribute(
            'data-theme'
          );
        }
      }

      syncTheme();

      const themeButton =
        document.getElementById('theme-btn');

      if (themeButton) {
        themeButton.addEventListener('click', () => {
          setTimeout(() => {
            syncTheme();
          }, 0);
        });
      }


      /* ============================================
       * ELEMENTS
       * ============================================ */

      const numericInput =
        document.getElementById('numericInput');

      const symbolicInput =
        document.getElementById('symbolicInput');

      const numericResult =
        document.getElementById('numericResult');

      const symbolicResult =
        document.getElementById('symbolicResult');

      const commandOutput =
        document.getElementById('commandOutput');

      const fullCommandOutput =
        document.getElementById('fullCommandOutput');

      const filenameInput =
        document.getElementById('filenameInput');

      const numericToSymbolicBtn =
        document.getElementById('numericToSymbolicBtn');

      const symbolicToNumericBtn =
        document.getElementById('symbolicToNumericBtn');

      const copyCommandBtn =
        document.getElementById('copyCommandBtn');

      const copyAllBtn =
        document.getElementById('copyAllBtn');

      const resetBtn =
        document.getElementById('resetBtn');

      const toast =
        document.getElementById('toast');

      const toastMessage =
        document.getElementById('toastMessage');


      /* ============================================
       * CONVERSION FUNCTIONS
       * ============================================ */

      function digitToSymbolic(digit) {

        const permissions = [
          '---',
          '--x',
          '-w-',
          '-wx',
          'r--',
          'r-x',
          'rw-',
          'rwx'
        ];

        return permissions[Number(digit)] || '---';
      }


      function numericToSymbolic(number) {

        const value = String(number);

        if (!/^[0-7]{3}$/.test(value)) {
          return null;
        }

        return (
          digitToSymbolic(value[0]) +
          digitToSymbolic(value[1]) +
          digitToSymbolic(value[2])
        );
      }


      function symbolicToNumeric(symbolic) {

        if (!/^[rwx-]{9}$/.test(symbolic)) {
          return null;
        }

        const groups = [
          symbolic.slice(0, 3),
          symbolic.slice(3, 6),
          symbolic.slice(6, 9)
        ];

        return groups.map(group => {

          let value = 0;

          if (group[0] === 'r') value += 4;
          if (group[1] === 'w') value += 2;
          if (group[2] === 'x') value += 1;

          return value;

        }).join('');
      }


      /* ============================================
       * DESCRIPTION
       * ============================================ */

      function describePermission(group) {

        const parts = [];

        if (group.includes('r')) {
          parts.push('قراءة');
        }

        if (group.includes('w')) {
          parts.push('كتابة');
        }

        if (group.includes('x')) {
          parts.push('تنفيذ');
        }

        if (!parts.length) {
          return 'بدون صلاحيات';
        }

        return parts.join(' + ');
      }


      /* ============================================
       * MATRIX
       * ============================================ */

      function updateMatrixFromNumeric(number) {

        const value = String(number);

        if (!/^[0-7]{3}$/.test(value)) {
          return;
        }

        const groups = [
          {
            name: 'user',
            digit: value[0]
          },
          {
            name: 'group',
            digit: value[1]
          },
          {
            name: 'others',
            digit: value[2]
          }
        ];

        groups.forEach(group => {

          const digit = Number(group.digit);

          const read =
            document.querySelector(
              `input[data-permission="${group.name}"][data-value="r"]`
            );

          const write =
            document.querySelector(
              `input[data-permission="${group.name}"][data-value="w"]`
            );

          const execute =
            document.querySelector(
              `input[data-permission="${group.name}"][data-value="x"]`
            );

          if (read) {
            read.checked = Boolean(digit & 4);
          }

          if (write) {
            write.checked = Boolean(digit & 2);
          }

          if (execute) {
            execute.checked = Boolean(digit & 1);
          }

        });

      }


      function getMatrixDigit(groupName) {

        let value = 0;

        const read =
          document.querySelector(
            `input[data-permission="${groupName}"][data-value="r"]`
          );

        const write =
          document.querySelector(
            `input[data-permission="${groupName}"][data-value="w"]`
          );

        const execute =
          document.querySelector(
            `input[data-permission="${groupName}"][data-value="x"]`
          );

        if (read?.checked) {
          value += 4;
        }

        if (write?.checked) {
          value += 2;
        }

        if (execute?.checked) {
          value += 1;
        }

        return value;
      }


      function updateFromMatrix() {

        const number =
          String(getMatrixDigit('user')) +
          String(getMatrixDigit('group')) +
          String(getMatrixDigit('others'));

        updateFromNumeric(number);
      }


      /* ============================================
       * MAIN UPDATE
       * ============================================ */

      function updateCommand(number) {

        const filename =
          filenameInput.value.trim() || 'filename';

        const command =
          `chmod ${number} ${filename}`;

        commandOutput.textContent = command;
        fullCommandOutput.textContent = command;
      }


      function updateFromNumeric(number) {

        const symbolic =
          numericToSymbolic(number);

        if (!symbolic) {
          return;
        }

        numericInput.value = number;
        symbolicInput.value = symbolic;

        numericResult.textContent = number;
        symbolicResult.textContent = symbolic;

        updateCommand(number);
        updateMatrixFromNumeric(number);
      }


      function updateFromSymbolic(symbolic) {

        const number =
          symbolicToNumeric(symbolic);

        if (!number) {
          return;
        }

        symbolicInput.value = symbolic;
        numericInput.value = number;

        numericResult.textContent = number;
        symbolicResult.textContent = symbolic;

        updateCommand(number);
        updateMatrixFromNumeric(number);
      }


      /* ============================================
       * NUMERIC INPUT
       * ============================================ */

      numericInput.addEventListener('input', () => {

        let value =
          numericInput.value
            .replace(/[^0-7]/g, '')
            .slice(0, 3);

        numericInput.value = value;

        if (value.length === 3) {
          updateFromNumeric(value);
        }

      });


      numericInput.addEventListener('change', () => {

        if (/^[0-7]{3}$/.test(numericInput.value)) {
          updateFromNumeric(numericInput.value);
        }

      });


      /* ============================================
       * SYMBOLIC INPUT
       * ============================================ */

      symbolicInput.addEventListener('input', () => {

        let value =
          symbolicInput.value
            .toLowerCase()
            .replace(/[^rwx-]/g, '')
            .slice(0, 9);

        symbolicInput.value = value;

        if (value.length === 9) {
          updateFromSymbolic(value);
        }

      });


      symbolicInput.addEventListener('change', () => {

        if (/^[rwx-]{9}$/.test(symbolicInput.value)) {
          updateFromSymbolic(symbolicInput.value);
        }

      });


      /* ============================================
       * CONVERSION BUTTONS
       * ============================================ */

      numericToSymbolicBtn.addEventListener(
        'click',
        () => {

          const value =
            numericInput.value.trim();

          if (/^[0-7]{3}$/.test(value)) {

            updateFromNumeric(value);

            showToast(
              'تم تحويل الصلاحية بنجاح'
            );

          } else {

            showToast(
              'أدخل رقم CHMOD صحيحًا'
            );

          }

        }
      );


      symbolicToNumericBtn.addEventListener(
        'click',
        () => {

          const value =
            symbolicInput.value.trim();

          if (/^[rwx-]{9}$/.test(value)) {

            updateFromSymbolic(value);

            showToast(
              'تم تحويل الصلاحية بنجاح'
            );

          } else {

            showToast(
              'أدخل صيغة رمزية صحيحة'
            );

          }

        }
      );


      /* ============================================
       * FILENAME
       * ============================================ */

      filenameInput.addEventListener(
        'input',
        () => {

          const number =
            numericInput.value;

          if (/^[0-7]{3}$/.test(number)) {
            updateCommand(number);
          }

        }
      );


      /* ============================================
       * MATRIX EVENTS
       * ============================================ */

      document
        .querySelectorAll(
          '.permission-item input'
        )
        .forEach(input => {

          input.addEventListener(
            'change',
            updateFromMatrix
          );

        });


      /* ============================================
       * PRESETS
       * ============================================ */

      document
        .querySelectorAll('.preset-card')
        .forEach(button => {

          button.addEventListener(
            'click',
            () => {

              const value =
                button.dataset.chmod;

              if (value) {
                updateFromNumeric(value);

                showToast(
                  `تم اختيار CHMOD ${value}`
                );
              }

            }
          );

        });


      /* ============================================
       * COPY
       * ============================================ */

      async function copyText(text) {

        try {

          await navigator.clipboard.writeText(text);

          return true;

        } catch (error) {

          const textarea =
            document.createElement('textarea');

          textarea.value = text;

          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(textarea);

          textarea.select();

          let success = false;

          try {
            success =
              document.execCommand('copy');
          } catch {
            success = false;
          }

          textarea.remove();

          return success;

        }

      }


      copyCommandBtn.addEventListener(
        'click',
        async () => {

          const text =
            commandOutput.textContent.trim();

          const success =
            await copyText(text);

          if (success) {

            showToast(
              'تم نسخ أمر Linux'
            );

          }

        }
      );


      copyAllBtn.addEventListener(
        'click',
        async () => {

          const number =
            numericResult.textContent.trim();

          const symbolic =
            symbolicResult.textContent.trim();

          const command =
            commandOutput.textContent.trim();

          const text =
`CHMOD: ${number}
Symbolic: ${symbolic}
Command: ${command}`;

          const success =
            await copyText(text);

          if (success) {

            showToast(
              'تم نسخ جميع النتائج'
            );

          }

        }
      );


      /* ============================================
       * RESET
       * ============================================ */

      function resetTool() {

        numericInput.value = '755';
        symbolicInput.value = 'rwxr-xr-x';

        filenameInput.value = 'filename';

        updateFromNumeric('755');

        showToast(
          'تمت إعادة ضبط الأداة'
        );

      }


      resetBtn.addEventListener(
        'click',
        resetTool
      );


      /* ============================================
       * TOAST
       * ============================================ */

      let toastTimer;

      function showToast(message) {

        toastMessage.textContent =
          message;

        toast.classList.add('show');

        clearTimeout(toastTimer);

        toastTimer =
          setTimeout(() => {

            toast.classList.remove('show');

          }, 2200);

      }


      /* ============================================
       * INITIALIZE
       * ============================================ */

      updateFromNumeric('755');

    });
  </script>


