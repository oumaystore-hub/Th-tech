  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const numericInput = document.getElementById('numericInput');
      const symbolicInput = document.getElementById('symbolicInput');

      const numericError = document.getElementById('numericError');
      const symbolicError = document.getElementById('symbolicError');

      const numericResult = document.getElementById('numericResult');
      const symbolicResult = document.getElementById('symbolicResult');
      const permissionDescription =
        document.getElementById('permissionDescription');

      const chmodCommand = document.getElementById('chmodCommand');
      const filenameInput = document.getElementById('filenameInput');

      const numericToSymbolicBtn =
        document.getElementById('numericToSymbolicBtn');

      const symbolicToNumericBtn =
        document.getElementById('symbolicToNumericBtn');

      const copyAllBtn = document.getElementById('copyAllBtn');
      const resetBtn = document.getElementById('resetBtn');

      const copyCommandBtn =
        document.getElementById('copyCommandBtn');

      const updateFilenameBtn =
        document.getElementById('updateFilenameBtn');

      const clearMatrixBtn =
        document.getElementById('clearMatrixBtn');

      const bottomCopyBtn =
        document.getElementById('bottomCopyBtn');

      const bottomResetBtn =
        document.getElementById('bottomResetBtn');

      const toast = document.getElementById('toast');
      const toastText = document.getElementById('toastText');

      const matrixIds = [
        'uRead',
        'uWrite',
        'uExecute',
        'gRead',
        'gWrite',
        'gExecute',
        'oRead',
        'oWrite',
        'oExecute'
      ];

      function digitToSymbolic(digit) {
        const n = Number(digit);

        if (Number.isNaN(n) || n < 0 || n > 7) {
          return '---';
        }

        let result = '';

        result += (n & 4) ? 'r' : '-';
        result += (n & 2) ? 'w' : '-';
        result += (n & 1) ? 'x' : '-';

        return result;
      }

      function numericToSymbolic(value) {
        const clean = String(value).trim();

        if (!/^[0-7]{3,4}$/.test(clean)) {
          return null;
        }

        const digits = clean.length === 4
          ? clean.slice(1)
          : clean;

        return (
          digitToSymbolic(digits[0]) +
          digitToSymbolic(digits[1]) +
          digitToSymbolic(digits[2])
        );
      }

      function symbolicToDigit(group) {
        if (group.length !== 3) {
          return null;
        }

        let value = 0;

        if (group[0] === 'r') value += 4;
        if (group[1] === 'w') value += 2;
        if (group[2] === 'x') value += 1;

        const valid =
          (group[0] === 'r' || group[0] === '-') &&
          (group[1] === 'w' || group[1] === '-') &&
          (group[2] === 'x' || group[2] === '-');

        return valid ? String(value) : null;
      }

      function symbolicToNumeric(value) {
        let clean = String(value)
          .trim()
          .toLowerCase()
          .replace(/\s+/g, '');

        if (clean.length === 10 && /^[d-]/.test(clean)) {
          clean = clean.slice(1);
        }

        if (!/^[rwx-]{9}$/.test(clean)) {
          return null;
        }

        const user = symbolicToDigit(clean.slice(0, 3));
        const group = symbolicToDigit(clean.slice(3, 6));
        const others = symbolicToDigit(clean.slice(6, 9));

        if (
          user === null ||
          group === null ||
          others === null
        ) {
          return null;
        }

        return user + group + others;
      }

      function describePermission(value) {
        const clean = String(value);

        if (!/^[0-7]{3}$/.test(clean)) {
          return '';
        }

        const names = [];

        const roles = [
          ['المالك', clean[0]],
          ['المجموعة', clean[1]],
          ['الآخرون', clean[2]]
        ];

        roles.forEach(([name, digit]) => {
          const n = Number(digit);
          const parts = [];

          if (n & 4) parts.push('قراءة');
          if (n & 2) parts.push('كتابة');
          if (n & 1) parts.push('تنفيذ');

          names.push(
            `${name}: ${parts.length ? parts.join(' + ') : 'لا توجد صلاحيات'}`
          );
        });

        return names.join(' • ');
      }

      function setError(element, message) {
        if (element) {
          element.textContent = message || '';
        }
      }

      function setStatus(type) {
        if (type === 'success') {
          setError(numericError, '');
          setError(symbolicError, '');
        }
      }

      function updateCommand() {
        const numeric = numericResult.textContent.trim();

        let filename = filenameInput.value.trim();

        if (!filename) {
          filename = 'filename';
        }

        chmodCommand.textContent =
          `chmod ${numeric} ${filename}`;
      }

      function updateMatrixFromNumeric(numeric) {
        if (!/^[0-7]{3}$/.test(numeric)) {
          return;
        }

        const roles = [
          ['u', numeric[0]],
          ['g', numeric[1]],
          ['o', numeric[2]]
        ];

        roles.forEach(([role, digit]) => {
          const n = Number(digit);

          const read =
            document.getElementById(`${role}Read`);

          const write =
            document.getElementById(`${role}Write`);

          const execute =
            document.getElementById(`${role}Execute`);

          const number =
            document.getElementById(`${role}Number`);

          if (read) read.checked = Boolean(n & 4);
          if (write) write.checked = Boolean(n & 2);
          if (execute) execute.checked = Boolean(n & 1);
          if (number) number.textContent = String(n);
        });
      }

      function getMatrixDigit(role) {
        let value = 0;

        const read =
          document.getElementById(`${role}Read`);

        const write =
          document.getElementById(`${role}Write`);

        const execute =
          document.getElementById(`${role}Execute`);

        if (read && read.checked) {
          value += 4;
        }

        if (write && write.checked) {
          value += 2;
        }

        if (execute && execute.checked) {
          value += 1;
        }

        return value;
      }

      function updateFromNumeric(value, showErrors = true) {
        let clean = String(value)
          .replace(/\D/g, '')
          .slice(0, 4);

        numericInput.value = clean;

        if (!/^[0-7]{3,4}$/.test(clean)) {
          if (showErrors) {
            setError(
              numericError,
              'أدخل 3 أو 4 أرقام من 0 إلى 7.'
            );
          }
          return false;
        }

        const symbolic = numericToSymbolic(clean);

        if (!symbolic) {
          if (showErrors) {
            setError(
              numericError,
              'قيمة CHMOD غير صحيحة.'
            );
          }
          return false;
        }

        const normalized =
          clean.length === 4
            ? clean.slice(1)
            : clean;

        symbolicInput.value = symbolic;

        numericResult.textContent = normalized;
        symbolicResult.textContent = symbolic;

        permissionDescription.textContent =
          describePermission(normalized);

        updateMatrixFromNumeric(normalized);
        updateCommand();

        setStatus('success');

        return true;
      }

      function updateFromSymbolic(value, showErrors = true) {
        let clean = String(value)
          .trim()
          .toLowerCase()
          .replace(/\s+/g, '');

        if (clean.length === 10 && /^[d-]/.test(clean)) {
          clean = clean.slice(1);
        }

        symbolicInput.value = clean;

        const numeric = symbolicToNumeric(clean);

        if (!numeric) {
          if (showErrors) {
            setError(
              symbolicError,
              'أدخل صيغة مثل rwxr-xr-x.'
            );
          }
          return false;
        }

        numericInput.value = numeric;

        numericResult.textContent = numeric;
        symbolicResult.textContent = clean;

        permissionDescription.textContent =
          describePermission(numeric);

        updateMatrixFromNumeric(numeric);
        updateCommand();

        setStatus('success');

        return true;
      }

      function updateFromMatrix() {
        const numeric =
          String(getMatrixDigit('u')) +
          String(getMatrixDigit('g')) +
          String(getMatrixDigit('o'));

        numericInput.value = numeric;

        const symbolic = numericToSymbolic(numeric);

        if (!symbolic) {
          return;
        }

        symbolicInput.value = symbolic;

        numericResult.textContent = numeric;
        symbolicResult.textContent = symbolic;

        permissionDescription.textContent =
          describePermission(numeric);

        updateCommand();

        const roles = ['u', 'g', 'o'];

        roles.forEach((role) => {
          const number =
            document.getElementById(`${role}Number`);

          if (number) {
            number.textContent =
              String(getMatrixDigit(role));
          }
        });

        setError(numericError, '');
        setError(symbolicError, '');
      }

      async function copyText(text, successMessage = 'تم النسخ') {
        if (!text) {
          showToast('لا يوجد محتوى للنسخ', 'error');
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          showToast(successMessage, 'success');
        } catch (error) {
          const textarea =
            document.createElement('textarea');

          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();

          try {
            document.execCommand('copy');
            showToast(successMessage, 'success');
          } catch (copyError) {
            showToast('تعذر النسخ تلقائيًا', 'error');
          }

          textarea.remove();
        }
      }

      function showToast(message, type = 'success') {
        toastText.textContent = message;

        toast.classList.remove('success', 'error');
        toast.classList.add(type);
        toast.classList.add('show');

        window.clearTimeout(showToast.timer);

        showToast.timer = window.setTimeout(() => {
          toast.classList.remove('show');
        }, 2200);
      }

      function resetTool() {
        numericInput.value = '755';
        symbolicInput.value = 'rwxr-xr-x';
        filenameInput.value = 'filename';

        updateFromNumeric('755', false);

        showToast('تمت إعادة الضبط', 'success');
      }

      function copyAll() {
        const text =
`CHMOD: ${numericResult.textContent.trim()}
Symbolic: ${symbolicResult.textContent.trim()}
Command: ${chmodCommand.textContent.trim()}`;

        copyText(text, 'تم نسخ جميع النتائج');
      }

      numericToSymbolicBtn.addEventListener(
        'click',
        () => {
          updateFromNumeric(numericInput.value, true);
        }
      );

      symbolicToNumericBtn.addEventListener(
        'click',
        () => {
          updateFromSymbolic(symbolicInput.value, true);
        }
      );

      numericInput.addEventListener('input', () => {
        const value = numericInput.value;

        if (/^[0-7]{3,4}$/.test(value)) {
          updateFromNumeric(value, false);
        } else {
          setError(
            numericError,
            'أدخل 3 أو 4 أرقام من 0 إلى 7.'
          );
        }
      });

      numericInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          updateFromNumeric(numericInput.value, true);
        }
      });

      symbolicInput.addEventListener('input', () => {
        const value = symbolicInput.value;

        if (symbolicToNumeric(value)) {
          updateFromSymbolic(value, false);
        } else if (value.length >= 9) {
          setError(
            symbolicError,
            'الصيغة يجب أن تكون مثل rwxr-xr-x.'
          );
        }
      });

      symbolicInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          updateFromSymbolic(symbolicInput.value, true);
        }
      });

      filenameInput.addEventListener('input', () => {
        updateCommand();
      });

      filenameInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          updateCommand();
          showToast('تم تحديث الأمر', 'success');
        }
      });

      updateFilenameBtn.addEventListener(
        'click',
        () => {
          updateCommand();
          showToast('تم تحديث أمر chmod', 'success');
        }
      );

      copyCommandBtn.addEventListener(
        'click',
        () => {
          copyText(
            chmodCommand.textContent.trim(),
            'تم نسخ أمر chmod'
          );
        }
      );

      copyAllBtn.addEventListener(
        'click',
        copyAll
      );

      bottomCopyBtn.addEventListener(
        'click',
        copyAll
      );

      resetBtn.addEventListener(
        'click',
        resetTool
      );

      bottomResetBtn.addEventListener(
        'click',
        resetTool
      );

      clearMatrixBtn.addEventListener(
        'click',
        () => {
          matrixIds.forEach((id) => {
            const checkbox =
              document.getElementById(id);

            if (checkbox) {
              checkbox.checked = false;
            }
          });

          updateFromMatrix();

          showToast(
            'تم مسح جميع الصلاحيات',
            'success'
          );
        }
      );

      document
        .querySelectorAll('.permission-check')
        .forEach((checkbox) => {
          checkbox.addEventListener(
            'change',
            updateFromMatrix
          );
        });

      document
        .querySelectorAll('.preset')
        .forEach((preset) => {
          preset.addEventListener(
            'click',
            () => {
              const value =
                preset.dataset.permission || '755';

              updateFromNumeric(value, false);

              showToast(
                `تم اختيار CHMOD ${value}`,
                'success'
              );
            }
          );
        });

      document
        .querySelectorAll('.copy-btn')
        .forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              const targetId =
                button.dataset.copyTarget;

              const target =
                document.getElementById(targetId);

              if (!target) {
                return;
              }

              copyText(
                target.textContent.trim(),
                'تم النسخ بنجاح'
              );
            }
          );
        });

      document
        .querySelectorAll('.faq-question')
        .forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              const item =
                button.closest('.faq-item');

              if (!item) {
                return;
              }

              document
                .querySelectorAll('.faq-item.open')
                .forEach((openItem) => {
                  if (openItem !== item) {
                    openItem.classList.remove('open');
                  }
                });

              item.classList.toggle('open');
            }
          );
        });

      /* الحالة الابتدائية */
      updateFromNumeric('755', false);
    });
  </script>
</body>
</html>
