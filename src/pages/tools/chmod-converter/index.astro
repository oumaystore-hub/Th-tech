---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/chmod-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CHMOD Converter | محول صلاحيات Linux | Th.Tech</title>

  <meta
    name="description"
    content="محول CHMOD مجاني لتحويل صلاحيات Linux بين النظام الرقمي والرمزي، إنشاء أوامر chmod وفحص صلاحيات المستخدم والمجموعة والآخرين."
  />

  <meta
    name="keywords"
    content="CHMOD Converter, chmod, Linux permissions, صلاحيات لينكس, محول chmod, 755, 644, chmod calculator"
  />

  <link rel="canonical" href={canonical} />

  <meta property="og:title" content="CHMOD Converter | محول صلاحيات Linux" />
  <meta
    property="og:description"
    content="حوّل صلاحيات Linux بسهولة بين Numeric و Symbolic وأنشئ أمر chmod جاهز."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
  />

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      --chmod-bg: #07111f;
      --chmod-bg-2: #0a1628;
      --chmod-surface: #0d1b2d;
      --chmod-surface-2: #102238;
      --chmod-card: #112a43;
      --chmod-border: rgba(148, 163, 184, 0.15);
      --chmod-border-strong: rgba(56, 189, 248, 0.28);

      --chmod-text: #f1f5f9;
      --chmod-soft: #cbd5e1;
      --chmod-muted: #94a3b8;

      --chmod-primary: #38bdf8;
      --chmod-primary-2: #0ea5e9;
      --chmod-primary-soft: rgba(56, 189, 248, 0.12);

      --chmod-green: #22c55e;
      --chmod-green-soft: rgba(34, 197, 94, 0.12);

      --chmod-orange: #f59e0b;
      --chmod-orange-soft: rgba(245, 158, 11, 0.12);

      --chmod-red: #ef4444;
      --chmod-red-soft: rgba(239, 68, 68, 0.12);

      --chmod-purple: #a78bfa;
      --chmod-purple-soft: rgba(167, 139, 250, 0.12);

      --chmod-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      --chmod-radius: 18px;

      color-scheme: dark;
      scroll-behavior: smooth;
    }

    :global(html[data-theme='light']) {
      --chmod-bg: #f1f7fc;
      --chmod-bg-2: #eaf4fb;
      --chmod-surface: #ffffff;
      --chmod-surface-2: #f8fbfe;
      --chmod-card: #ffffff;

      --chmod-border: rgba(15, 23, 42, 0.10);
      --chmod-border-strong: rgba(14, 165, 233, 0.28);

      --chmod-text: #0f172a;
      --chmod-soft: #334155;
      --chmod-muted: #64748b;

      --chmod-primary: #0284c7;
      --chmod-primary-2: #0ea5e9;
      --chmod-primary-soft: rgba(14, 165, 233, 0.09);

      --chmod-green: #16a34a;
      --chmod-green-soft: rgba(22, 163, 74, 0.09);

      --chmod-orange: #d97706;
      --chmod-orange-soft: rgba(217, 119, 6, 0.09);

      --chmod-red: #dc2626;
      --chmod-red-soft: rgba(220, 38, 38, 0.08);

      --chmod-purple: #7c3aed;
      --chmod-purple-soft: rgba(124, 58, 237, 0.08);

      --chmod-shadow: 0 18px 50px rgba(15, 23, 42, 0.09);

      color-scheme: light;
    }

    :global(body) {
      margin: 0;
      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(14, 165, 233, 0.09),
          transparent 28%
        ),
        radial-gradient(
          circle at 90% 20%,
          rgba(56, 189, 248, 0.07),
          transparent 25%
        ),
        var(--chmod-bg);
      color: var(--chmod-text);
      font-family: 'Cairo', sans-serif;
      min-height: 100vh;
    }

    :global(button),
    :global(input) {
      font-family: inherit;
    }

    .chmod-page {
      width: 100%;
      min-height: 100vh;
      padding: 30px 16px 70px;
    }

    .chmod-container {
      width: min(1180px, 100%);
      margin: 0 auto;
    }

    /* HERO */

    .hero {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--chmod-border);
      border-radius: 28px;
      padding: 42px 28px;
      margin-bottom: 24px;
      background:
        linear-gradient(
          135deg,
          rgba(14, 165, 233, 0.15),
          rgba(56, 189, 248, 0.04)
        ),
        var(--chmod-surface);
      box-shadow: var(--chmod-shadow);
      text-align: center;
    }

    .hero::before {
      content: '';
      position: absolute;
      width: 240px;
      height: 240px;
      top: -130px;
      left: -80px;
      border-radius: 50%;
      background: rgba(56, 189, 248, 0.12);
      filter: blur(5px);
      pointer-events: none;
    }

    .hero::after {
      content: '';
      position: absolute;
      width: 210px;
      height: 210px;
      bottom: -120px;
      right: -70px;
      border-radius: 50%;
      background: rgba(14, 165, 233, 0.10);
      pointer-events: none;
    }

    .hero-icon {
      width: 74px;
      height: 74px;
      margin: 0 auto 18px;
      display: grid;
      place-items: center;
      border-radius: 22px;
      background: linear-gradient(
        135deg,
        var(--chmod-primary-2),
        var(--chmod-primary)
      );
      color: white;
      font-size: 30px;
      box-shadow: 0 15px 35px rgba(14, 165, 233, 0.25);
      position: relative;
      z-index: 1;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(28px, 5vw, 46px);
      line-height: 1.2;
      font-weight: 800;
      position: relative;
      z-index: 1;
    }

    .hero h1 span {
      display: block;
      margin-top: 8px;
      color: var(--chmod-primary);
      font-size: 0.56em;
      font-weight: 700;
    }

    .hero p {
      width: min(700px, 100%);
      margin: 18px auto 0;
      color: var(--chmod-muted);
      line-height: 1.9;
      font-size: 15px;
      position: relative;
      z-index: 1;
    }

    .hero-badges {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 22px;
      position: relative;
      z-index: 1;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      border: 1px solid var(--chmod-border);
      border-radius: 999px;
      background: var(--chmod-primary-soft);
      color: var(--chmod-soft);
      font-size: 12px;
      font-weight: 600;
    }

    .hero-badge i {
      color: var(--chmod-primary);
    }

    /* TOOL */

    .tool-card {
      border: 1px solid var(--chmod-border);
      border-radius: var(--chmod-radius);
      background: var(--chmod-surface);
      box-shadow: var(--chmod-shadow);
      overflow: hidden;
    }

    .tool-header {
      padding: 18px 20px;
      border-bottom: 1px solid var(--chmod-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    .tool-title {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      font-size: 17px;
    }

    .tool-title i {
      color: var(--chmod-primary);
    }

    .tool-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--chmod-green);
      font-size: 12px;
      font-weight: 700;
    }

    .tool-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--chmod-green);
      box-shadow: 0 0 0 5px var(--chmod-green-soft);
    }

    .tool-body {
      padding: 22px;
    }

    /* INPUTS */

    .input-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .field-card {
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--chmod-border);
      border-radius: 16px;
      background: var(--chmod-surface-2);
    }

    .field-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 11px;
    }

    .field-label-main {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 14px;
    }

    .field-label-main i {
      color: var(--chmod-primary);
    }

    .field-hint {
      color: var(--chmod-muted);
      font-size: 11px;
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      width: 100%;
      height: 54px;
      border: 1px solid var(--chmod-border);
      border-radius: 13px;
      background: var(--chmod-bg);
      color: var(--chmod-text);
      outline: none;
      padding: 0 15px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 21px;
      font-weight: 700;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
      direction: ltr;
      text-align: center;
    }

    .input-wrap input:focus {
      border-color: var(--chmod-primary);
      box-shadow: 0 0 0 4px var(--chmod-primary-soft);
    }

    .input-wrap.symbolic input {
      font-size: 17px;
      letter-spacing: 1px;
    }

    .field-error {
      min-height: 20px;
      margin-top: 7px;
      color: var(--chmod-red);
      font-size: 11px;
      text-align: right;
    }

    /* BUTTONS */

    .button-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .btn {
      min-height: 44px;
      border: 1px solid var(--chmod-border);
      border-radius: 12px;
      padding: 9px 15px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      color: var(--chmod-soft);
      background: var(--chmod-surface-2);
      font-size: 13px;
      font-weight: 700;
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
      border-color: var(--chmod-border-strong);
      background: var(--chmod-primary-soft);
    }

    .btn:active {
      transform: translateY(0);
    }

    .btn-primary {
      color: white;
      border-color: transparent;
      background: linear-gradient(
        135deg,
        var(--chmod-primary-2),
        var(--chmod-primary)
      );
    }

    .btn-primary:hover {
      background: linear-gradient(
        135deg,
        var(--chmod-primary),
        var(--chmod-primary-2)
      );
    }

    .btn-danger:hover {
      border-color: rgba(239, 68, 68, 0.35);
      background: var(--chmod-red-soft);
      color: var(--chmod-red);
    }

    .btn-success:hover {
      border-color: rgba(34, 197, 94, 0.35);
      background: var(--chmod-green-soft);
      color: var(--chmod-green);
    }

    .btn-small {
      min-height: 36px;
      padding: 7px 11px;
      font-size: 11px;
    }

    /* RESULT */

    .result-section {
      margin-top: 22px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 13px;
      flex-wrap: wrap;
    }

    .section-heading h2,
    .section-heading h3 {
      margin: 0;
      font-size: 17px;
      font-weight: 800;
    }

    .section-heading h2 i,
    .section-heading h3 i {
      color: var(--chmod-primary);
      margin-left: 7px;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .result-card {
      min-width: 0;
      padding: 17px;
      border: 1px solid var(--chmod-border);
      border-radius: 15px;
      background: var(--chmod-surface-2);
    }

    .result-card-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--chmod-muted);
      font-size: 11px;
      margin-bottom: 10px;
    }

    .result-value {
      min-height: 45px;
      display: flex;
      align-items: center;
      justify-content: center;
      direction: ltr;
      text-align: center;
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 25px;
      font-weight: 700;
      word-break: break-all;
    }

    .result-card.command-card {
      grid-column: 1 / -1;
    }

    .command-box {
      display: flex;
      align-items: center;
      gap: 9px;
      direction: ltr;
    }

    .command-box code {
      flex: 1;
      min-width: 0;
      overflow-x: auto;
      white-space: nowrap;
      padding: 13px;
      border-radius: 11px;
      background: var(--chmod-bg);
      border: 1px solid var(--chmod-border);
      color: var(--chmod-green);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
    }

    /* MATRIX */

    .matrix-section {
      margin-top: 25px;
    }

    .matrix-wrap {
      border: 1px solid var(--chmod-border);
      border-radius: 16px;
      overflow: hidden;
      background: var(--chmod-surface-2);
    }

    .permission-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .permission-table th,
    .permission-table td {
      padding: 13px 8px;
      border-bottom: 1px solid var(--chmod-border);
      text-align: center;
    }

    .permission-table tr:last-child td {
      border-bottom: 0;
    }

    .permission-table th {
      color: var(--chmod-muted);
      font-size: 11px;
      font-weight: 700;
      background: var(--chmod-bg);
    }

    .permission-table td {
      color: var(--chmod-soft);
      font-size: 12px;
    }

    .permission-table .role-cell {
      text-align: right;
      padding-right: 15px;
      font-weight: 800;
    }

    .role-name {
      display: block;
      color: var(--chmod-text);
    }

    .role-code {
      display: block;
      margin-top: 2px;
      color: var(--chmod-muted);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      direction: ltr;
    }

    .permission-check {
      width: 22px;
      height: 22px;
      accent-color: var(--chmod-primary-2);
      cursor: pointer;
    }

    .permission-number {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      color: var(--chmod-primary);
      direction: ltr;
    }

    /* FILE COMMAND */

    .filename-section {
      margin-top: 22px;
      padding: 18px;
      border: 1px solid var(--chmod-border);
      border-radius: 16px;
      background: var(--chmod-surface-2);
    }

    .filename-input {
      display: flex;
      align-items: center;
      gap: 10px;
      direction: ltr;
    }

    .filename-input input {
      flex: 1;
      min-width: 0;
      height: 46px;
      border: 1px solid var(--chmod-border);
      border-radius: 11px;
      background: var(--chmod-bg);
      color: var(--chmod-text);
      padding: 0 13px;
      outline: none;
      font-family: 'JetBrains Mono', monospace;
      direction: ltr;
      text-align: left;
    }

    .filename-input input:focus {
      border-color: var(--chmod-primary);
      box-shadow: 0 0 0 4px var(--chmod-primary-soft);
    }

    /* PRESETS */

    .presets-section {
      margin-top: 25px;
    }

    .presets-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
    }

    .preset {
      border: 1px solid var(--chmod-border);
      border-radius: 13px;
      background: var(--chmod-surface-2);
      padding: 13px 8px;
      cursor: pointer;
      text-align: center;
      color: var(--chmod-text);
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .preset:hover {
      transform: translateY(-2px);
      border-color: var(--chmod-border-strong);
      background: var(--chmod-primary-soft);
    }

    .preset-number {
      display: block;
      direction: ltr;
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 17px;
      font-weight: 800;
    }

    .preset-name {
      display: block;
      margin-top: 4px;
      color: var(--chmod-muted);
      font-size: 10px;
    }

    /* INFO */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 25px;
    }

    .info-card {
      padding: 21px;
      border: 1px solid var(--chmod-border);
      border-radius: 17px;
      background: var(--chmod-surface);
    }

    .info-card h2 {
      margin: 0 0 14px;
      font-size: 17px;
    }

    .info-card h2 i {
      color: var(--chmod-primary);
      margin-left: 7px;
    }

    .info-card p {
      margin: 0;
      color: var(--chmod-muted);
      font-size: 13px;
      line-height: 1.9;
    }

    .number-list {
      display: grid;
      gap: 8px;
      margin-top: 13px;
    }

    .number-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 9px 11px;
      border-radius: 10px;
      background: var(--chmod-surface-2);
      border: 1px solid var(--chmod-border);
      font-size: 12px;
    }

    .number-item strong {
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      direction: ltr;
    }

    .number-item span {
      color: var(--chmod-soft);
    }

    .steps {
      display: grid;
      gap: 10px;
      counter-reset: step;
    }

    .step {
      position: relative;
      padding: 11px 42px 11px 11px;
      border-radius: 11px;
      border: 1px solid var(--chmod-border);
      background: var(--chmod-surface-2);
      color: var(--chmod-soft);
      font-size: 12px;
      line-height: 1.7;
      counter-increment: step;
    }

    .step::before {
      content: counter(step);
      position: absolute;
      right: 11px;
      top: 50%;
      transform: translateY(-50%);
      width: 23px;
      height: 23px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--chmod-primary-soft);
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
    }

    .warning {
      margin-top: 25px;
      padding: 17px;
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 15px;
      background: var(--chmod-orange-soft);
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .warning i {
      color: var(--chmod-orange);
      margin-top: 3px;
    }

    .warning strong {
      display: block;
      margin-bottom: 4px;
      color: var(--chmod-orange);
      font-size: 13px;
    }

    .warning p {
      margin: 0;
      color: var(--chmod-soft);
      font-size: 12px;
      line-height: 1.8;
    }

    /* FAQ */

    .faq-section {
      margin-top: 25px;
      padding: 21px;
      border: 1px solid var(--chmod-border);
      border-radius: 17px;
      background: var(--chmod-surface);
    }

    .faq-section h2 {
      margin: 0 0 15px;
      font-size: 18px;
    }

    .faq-section h2 i {
      color: var(--chmod-primary);
      margin-left: 7px;
    }

    .faq-list {
      display: grid;
      gap: 9px;
    }

    .faq-item {
      border: 1px solid var(--chmod-border);
      border-radius: 12px;
      overflow: hidden;
      background: var(--chmod-surface-2);
    }

    .faq-question {
      width: 100%;
      border: 0;
      background: transparent;
      color: var(--chmod-text);
      padding: 14px;
      text-align: right;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .faq-question i {
      color: var(--chmod-primary);
      transition: transform 0.2s ease;
    }

    .faq-answer {
      display: none;
      padding: 0 14px 14px;
      color: var(--chmod-muted);
      font-size: 12px;
      line-height: 1.9;
    }

    .faq-item.open .faq-answer {
      display: block;
    }

    .faq-item.open .faq-question i {
      transform: rotate(180deg);
    }

    /* TOAST */

    .toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      z-index: 9999;
      transform: translate(-50%, 20px);
      opacity: 0;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px 16px;
      border: 1px solid var(--chmod-border);
      border-radius: 12px;
      background: var(--chmod-surface);
      color: var(--chmod-text);
      box-shadow: var(--chmod-shadow);
      font-size: 12px;
      font-weight: 700;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .toast.success i {
      color: var(--chmod-green);
    }

    .toast.error i {
      color: var(--chmod-red);
    }

    /* FOOTER ACTIONS */

    .bottom-actions {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 25px;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .result-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .presets-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
