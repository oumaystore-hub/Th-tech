      font-size: 13px;

      font-weight: 800;

      line-height: 18px;

      text-align: center;
    }


    .permission-item strong {

      margin-right: auto;

      color:
        var(--chmod-primary);

      font-family:
        'JetBrains Mono',
        monospace;
    }


    /* ============================================
     * FILENAME
     * ============================================ */

    .filename-box {

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      gap: 15px;
    }


    .filename-input-wrapper {

      display: flex;

      align-items: center;

      gap: 12px;

      height: 58px;

      padding: 0 16px;

      border:
        1px solid var(--chmod-border);

      border-radius: 14px;

      background:
        var(--chmod-surface);

      color:
        var(--chmod-muted);
    }


    .filename-input-wrapper input {

      width: 100%;

      border: none;

      outline: none;

      background: transparent;

      color:
        var(--chmod-text);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 14px;

      direction: ltr;

      text-align: left;
    }


    .filename-command {

      display: flex;

      align-items: center;

      min-height: 58px;

      padding: 0 16px;

      border:
        1px solid var(--chmod-border);

      border-radius: 14px;

      background:
        var(--chmod-surface);

      overflow: hidden;
    }


    .filename-command code {

      direction: ltr;

      color:
        var(--chmod-primary);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 13px;

      white-space: nowrap;

      overflow-x: auto;
    }


    /* ============================================
     * PRESETS
     * ============================================ */

    .preset-grid {

      display: grid;

      grid-template-columns:
        repeat(6, minmax(0, 1fr));

      gap: 12px;
    }


    .preset-card {

      min-height: 125px;

      display: flex;

      flex-direction: column;

      align-items: center;
      justify-content: center;

      gap: 5px;

      padding: 12px;

      border:
        1px solid var(--chmod-border);

      border-radius: 15px;

      background:
        var(--chmod-surface);

      color:
        var(--chmod-text);

      cursor: pointer;

      font-family:
        'Cairo',
        sans-serif;

      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        background 0.2s ease;
    }


    .preset-card:hover {

      transform:
        translateY(-3px);

      border-color:
        var(--chmod-border-strong);

      background:
        var(--chmod-primary-soft);
    }


    .preset-card strong {

      color:
        var(--chmod-primary);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 22px;
    }


    .preset-card span {

      direction: ltr;

      color:
        var(--chmod-soft);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 11px;
    }


    .preset-card small {

      color:
        var(--chmod-muted);

      font-size: 10px;
    }


    .preset-card.warning strong {

      color:
        var(--chmod-orange);
    }


    /* ============================================
     * ACTIONS
     * ============================================ */

    .actions-section {

      display: flex;

      justify-content: center;

      gap: 12px;

      margin-bottom: 45px;
    }


    .action-btn {

      min-width: 170px;

      border: none;

      border-radius: 12px;

      padding: 13px 20px;

      font-family:
        'Cairo',
        sans-serif;

      font-size: 14px;

      font-weight: 700;

      cursor: pointer;

      transition:
        transform 0.2s ease;
    }


    .action-btn:hover {

      transform:
        translateY(-2px);
    }


    .primary-action {

      color: #fff;

      background:
        linear-gradient(
          135deg,
          var(--chmod-primary),
          var(--chmod-primary-2)
        );
    }


    .reset-action {

      color:
        var(--chmod-text);

      background:
        var(--chmod-surface);

      border:
        1px solid var(--chmod-border);
    }


    /* ============================================
     * INFO
     * ============================================ */

    .info-section {

      display: grid;

      gap: 15px;

      margin-bottom: 40px;
    }


    .info-card,
    .warning-card {

      display: flex;

      gap: 15px;

      padding: 22px;

      border-radius:
        var(--chmod-radius);

      background:
        var(--chmod-surface);

      border:
        1px solid var(--chmod-border);
    }


    .info-icon,
    .warning-icon {

      width: 45px;
      height: 45px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 13px;

      font-size: 19px;
    }


    .info-icon {

      color:
        var(--chmod-primary);

      background:
        var(--chmod-primary-soft);
    }


    .warning-icon {

      color:
        var(--chmod-orange);

      background:
        var(--chmod-orange-soft);
    }


    .info-card h2,
    .warning-card h3 {

      margin:
        0 0 7px;

      font-size: 17px;
    }


    .info-card p,
    .warning-card p {

      margin: 5px 0;

      color:
        var(--chmod-muted);

      font-size: 13px;

      line-height: 1.9;
    }


    .warning-card {

      border-color:
        rgba(245, 158, 11, 0.25);
    }


    .warning-card strong {

      color:
        var(--chmod-orange);
    }


    /* ============================================
     * FAQ
     * ============================================ */

    .faq-list {

      display: grid;

      gap: 10px;
    }


    .faq-list details {

      border:
        1px solid var(--chmod-border);

      border-radius: 14px;

      background:
        var(--chmod-surface);

      overflow: hidden;

      transition:
        border-color 0.2s ease;
    }


    .faq-list details[open] {

      border-color:
        var(--chmod-border-strong);
    }


    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 17px 18px;

      cursor: pointer;

      list-style: none;

      color:
        var(--chmod-text);

      font-size: 14px;

      font-weight: 700;
    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color:
        var(--chmod-primary);

      transition:
        transform 0.2s ease;
    }


    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);
    }


    .faq-list details p {

      margin: 0;

      padding:
        0 18px 18px;

      color:
        var(--chmod-muted);

      font-size: 13px;

      line-height: 1.9;
    }


    /* ============================================
     * TOAST
     * ============================================ */

    .toast {

      position: fixed;

      bottom: 25px;

      left: 50%;

      transform:
        translate(-50%, 30px);

      display: flex;

      align-items: center;

      gap: 9px;

      padding: 12px 18px;

      border:
        1px solid var(--chmod-border-strong);

      border-radius: 12px;

      background:
        var(--chmod-surface);

      color:
        var(--chmod-text);

      box-shadow:
        var(--chmod-shadow);

      font-size: 13px;

      opacity: 0;

      pointer-events: none;

      z-index: 9999;

      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }


    .toast i {

      color:
        var(--chmod-green);
    }


    .toast.show {

      opacity: 1;

      transform:
        translate(-50%, 0);
    }


    /* ============================================
     * RESPONSIVE
     * ============================================ */

    @media (max-width: 900px) {

      .preset-grid {

        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

    }


    @media (max-width: 700px) {

      .chmod-page {

        width:
          min(
            100% - 20px,
            620px
          );

        padding-top: 30px;
      }


      .hero {

        padding: 21px;

        align-items: flex-start;
      }


      .hero-icon {

        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 23px;
      }


      .hero h1 {

        font-size: 29px;
      }


      .hero p {

        font-size: 13px;
      }


      .converter-section,
      .result-section {

        grid-template-columns: 1fr;
      }


      .filename-box {

        grid-template-columns: 1fr;
      }


      .permission-grid {

        grid-template-columns: 1fr;
      }


      .matrix-head {

        display: none;
      }


      .preset-grid {

        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }


      .actions-section {

        flex-direction: column;
      }


      .action-btn {

        width: 100%;
      }

    }


    @media (max-width: 430px) {

      .hero {

        gap: 13px;
      }


      .hero-icon {

        width: 48px;
        height: 48px;

        font-size: 20px;
      }


      .hero h1 {

        font-size: 25px;
      }


      .converter-card {

        padding: 18px;
      }


      .big-value {

        font-size: 25px;
      }


      .command-box code {

        font-size: 12px;
      }

    }

  </style>

</body>
</html>
