      }

      .permission-table {
        min-width: 560px;
      }

      .filename-input {
        flex-direction: column;
        align-items: stretch;
      }

      .filename-input .btn {
        width: 100%;
      }

      .command-box {
        flex-direction: column;
        align-items: stretch;
      }

      .command-box .btn {
        width: 100%;
      }
    }

    @media (max-width: 430px) {
      .hero h1 {
        font-size: 27px;
      }

      .hero p {
        font-size: 13px;
      }

      .field-card {
