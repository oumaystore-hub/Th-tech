---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CSS Clamp Generator - مولد CSS Clamp أونلاين | Th.Tech";
const description =
  "أداة مجانية لإنشاء CSS clamp() بشكل تفاعلي ومتجاوب للتحكم في أحجام الخطوط والمسافات والأبعاد.";

---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>
          <span>CSS Clamp Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-ruler-combined"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fab fa-css3-alt"></i>
              CSS Tools
            </span>

            <h1>
              CSS <span>Clamp Generator</span>
            </h1>

            <p>
              أنشئ دالة CSS clamp() متجاوبة للتحكم في الأحجام والمسافات
              والقيم بين حد أدنى وحد أقصى بطريقة سهلة وسريعة.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-sliders"></i>
              <span>CSS Clamp Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="resetBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-rotate-left"></i>
                إعادة ضبط
              </button>

            </div>

          </div>


          <!-- Controls -->

          <div class="controls">

            <div class="control-card">

              <div class="control-heading">
                <i class="fas fa-arrow-down"></i>
                <span>القيمة الدنيا</span>
              </div>

              <div class="input-row">

                <input
                  id="minValue"
                  type="number"
                  value="16"
                  min="0"
                  step="1"
                />

                <select id="minUnit">
                  <option value="px" selected>px</option>
                  <option value="rem">rem</option>
                  <option value="em">em</option>
                  <option value="vw">vw</option>
                  <option value="vh">vh</option>
                  <option value="%">%</option>
                </select>

              </div>

            </div>


            <div class="control-card">

              <div class="control-heading">
                <i class="fas fa-chart-line"></i>
                <span>القيمة المرنة</span>
              </div>

              <div class="input-row">

                <input
                  id="preferredValue"
                  type="number"
                  value="3"
                  min="-100"
                  step="0.1"
                />

                <select id="preferredUnit">
                  <option value="vw" selected>vw</option>
                  <option value="vh">vh</option>
                  <option value="rem">rem</option>
                  <option value="em">em</option>
                  <option value="px">px</option>
                  <option value="%">%</option>
                </select>

              </div>

            </div>


            <div class="control-card">

              <div class="control-heading">
                <i class="fas fa-arrow-up"></i>
                <span>القيمة القصوى</span>
              </div>

              <div class="input-row">

                <input
                  id="maxValue"
                  type="number"
                  value="32"
                  min="0"
                  step="1"
                />

                <select id="maxUnit">
                  <option value="px" selected>px</option>
                  <option value="rem">rem</option>
                  <option value="em">em</option>
                  <option value="vw">vw</option>
                  <option value="vh">vh</option>
                  <option value="%">%</option>
                </select>

              </div>

            </div>

          </div>


          <!-- Result -->

          <div class="result-section">

            <div class="result-header">

              <div>
                <i class="fas fa-code"></i>
                CSS الناتج
              </div>

              <span id="statusLabel">
                تلقائي
              </span>

            </div>

            <div class="code-box">

              <code id="result">
                clamp(16px, 3vw, 32px)
              </code>

            </div>

          </div>


          <!-- Preview -->

          <div class="preview-section">

            <div class="preview-header">

              <div>
                <i class="fas fa-eye"></i>
                المعاينة
              </div>

              <span>
                Responsive Preview
              </span>

            </div>

            <div class="preview-box">

              <div
                id="previewText"
                class="preview-text"
              >
                CSS Clamp
              </div>

              <p>
                غيّر القيم أعلاه لمشاهدة التأثير مباشرة
              </p>

            </div>

          </div>


          <!-- Status -->

          <div
            id="status"
            class="status hidden"
          >

            <i
              id="statusIcon"
              class="fas fa-check-circle"
            ></i>

            <span id="statusText"></span>

          </div>


          <!-- Statistics -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-arrow-down"></i>
              </div>

              <div>
                <span
                  class="stat-value"
                  id="minOutput"
                >
                  16px
                </span>

                <span class="stat-label">
                  الحد الأدنى
                </span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-chart-line"></i>
              </div>

              <div>
                <span
                  class="stat-value"
                  id="preferredOutput"
                >
                  3vw
                </span>

                <span class="stat-label">
                  القيمة المرنة
                </span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">
                <i class="fas fa-arrow-up"></i>
              </div>

              <div>
                <span
                  class="stat-value"
                  id="maxOutput"
                >
                  32px
                </span>

                <span class="stat-label">
                  الحد الأقصى
                </span>
              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-mobile-screen"></i>
            </div>

            <div>
              <h3>تصميم متجاوب</h3>

              <p>
                تساعد clamp() على إنشاء قيم تتكيف تلقائياً
                مع أحجام الشاشات المختلفة.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>CSS خالص</h3>

              <p>
                يتم إنشاء كود CSS جاهز للاستخدام مباشرة
                داخل ملفات مشروعك.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>نتيجة فورية</h3>

              <p>
                تتغير النتيجة والمعاينة مباشرة عند تعديل
                أي قيمة.
              </p>
            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>CSS Clamp Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-arrow-down"></i>
              </div>

              <h3>
                حدد الحد الأدنى
              </h3>

              <p>
                أدخل أصغر قيمة تريد السماح بها
                وحدد وحدة القياس المناسبة.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-sliders"></i>
              </div>

              <h3>
                حدد القيمة المرنة
              </h3>

              <p>
                اختر القيمة التي ستتغير بشكل مرن
                حسب حجم الشاشة.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>
                انسخ CSS
              </h3>

              <p>
                انسخ دالة clamp() الناتجة واستخدمها
                مباشرة في مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>CSS Clamp</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هي CSS clamp()؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                clamp() هي دالة في CSS تسمح بتحديد قيمة
                دنيا وقيمة مفضلة وقيمة قصوى، بحيث تتغير
                القيمة بشكل مرن ضمن هذا النطاق.
              </p>

            </details>


            <details>

              <summary>
                أين يمكن استخدام clamp()؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                يمكن استخدامها مع أحجام الخطوط والمسافات
                والعروض والارتفاعات والعديد من خصائص CSS
                التي تقبل قيماً رقمية.
              </p>

            </details>


            <details>

              <summary>
                ما معنى القيم الثلاث؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                القيمة الأولى هي الحد الأدنى، والثانية
                هي القيمة المرنة المفضلة، والثالثة هي
                الحد الأقصى.
              </p>

            </details>


            <details>

              <summary>
                هل تعمل clamp() على الهاتف؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. clamp() مصممة لإنشاء قيم CSS متجاوبة
                ويمكن استخدامها لبناء واجهات تتكيف مع
                أحجام الشاشات المختلفة.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input,
    select {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);
      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 720px;
      margin: 0;

      color: var(--muted);
      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);
      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;
      border: 1px solid var(--border);

      background: var(--card);
      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(37, 99, 235, .35);
      color: var(--primary);

      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* ================= CONTROLS ================= */

    .controls {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;

      padding: 22px;
    }


    .control-card {
      padding: 18px;

      border-radius: 16px;

      background: var(--card2);
      border: 1px solid var(--border);
    }


    .control-heading {
      display: flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 13px;

      color: var(--muted);

      font-size: .78rem;
      font-weight: 800;
    }


    .control-heading i {
      color: var(--primary);
    }


    .input-row {
      display: flex;
      gap: 8px;
    }


    .input-row input,
    .input-row select {
      height: 44px;

      border: 1px solid var(--border);
      border-radius: 10px;

      background: var(--card);
      color: var(--text);

      outline: none;

      transition: .2s ease;
    }


    .input-row input {
      width: 100%;
      min-width: 0;

      padding: 0 12px;

      direction: ltr;
      text-align: left;

      font-size: .85rem;
      font-weight: 700;
    }


    .input-row select {
      width: 90px;

      padding: 0 8px;

      direction: ltr;

      font-size: .75rem;
      font-weight: 700;
    }


    .input-row input:focus,
    .input-row select:focus {
      border-color: var(--primary);

      box-shadow:
        0 0 0 3px rgba(37, 99, 235, .10);
    }


    /* ================= RESULT ================= */

    .result-section,
    .preview-section {
      margin: 0 22px 20px;

      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);
      background: var(--card2);
    }


    .result-header,
    .preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 13px 16px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .76rem;
      font-weight: 800;
    }


    .result-header > div,
    .preview-header > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }


    .result-header i,
    .preview-header i {
      color: var(--primary);
    }


    .code-box {
      min-height: 100px;

      display: flex;
      align-items: center;

      padding: 20px;

      overflow-x: auto;
    }


    .code-box code {
      width: 100%;

      direction: ltr;
      text-align: left;

      color: var(--primary);

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: 1rem;
      font-weight: 700;

      white-space: nowrap;
    }


    /* ================= PREVIEW ================= */

    .preview-box {
      min-height: 260px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      padding: 30px;

      text-align: center;

      background:
        radial-gradient(
          circle at center,
          rgba(37, 99, 235, .08),
          transparent 55%
        );
    }


    .preview-text {
      font-size: clamp(16px, 3vw, 32px);
      font-weight: 800;

      line-height: 1.3;

      color: var(--text);

      transition: font-size .15s ease;
    }


    .preview-box p {
      margin: 12px 0 0;

      color: var(--muted);

      font-size: .72rem;
    }


    /* ================= STATUS ================= */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 22px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);
      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);
      border-color: rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* ================= STATISTICS ================= */

    .statistics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;

      background: var(--border);

      border-top: 1px solid var(--border);
    }


    .stat {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 12px;

      padding: 22px 15px;

      background: var(--card);
    }


    .stat-icon {
      width: 43px;
      height: 43px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background: rgba(37, 99, 235, .09);

      color: var(--primary);
    }


    .stat-icon.success {
      color: var(--green);
      background: rgba(34, 197, 94, .09);
    }


    .stat-value {
      display: block;

      color: var(--text);

      font-size: 1rem;
      font-weight: 800;

      direction: ltr;
      text-align: right;
    }


    .stat-label {
      display: block;

      color: var(--muted);

      font-size: .68rem;
    }


    /* ================= INFO ================= */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;
      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);
      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);
      background: rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;
      line-height: 1.8;
    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* ================= STEPS ================= */

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;
      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);
      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);
      background: rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;
      line-height: 1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);
      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .controls {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }


      .statistics {
        grid-template-columns: 1fr;
      }


      .stat {
        justify-content: flex-start;

        padding-right: 25px;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .controls {
        padding: 12px;

        gap: 12px;
      }


      .control-card {
        padding: 15px;
      }


      .result-section,
      .preview-section {
        margin-left: 12px;
        margin-right: 12px;
      }


      .code-box {
        min-height: 90px;

        padding: 16px;
      }


      .code-box code {
        font-size: .82rem;
      }


      .preview-box {
        min-height: 220px;

        padding: 20px;
      }


      .preview-text {
        font-size: clamp(16px, 8vw, 32px);
      }


      .status {
        margin-left: 12px;
        margin-right: 12px;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      window.addEventListener(
        'storage',
        (event) => {

          if (event.key === 'theme') {

            applyTheme(
              event.newValue === 'dark'
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const minValue =
        document.getElementById('minValue');

      const minUnit =
        document.getElementById('minUnit');

      const preferredValue =
        document.getElementById('preferredValue');

      const preferredUnit =
        document.getElementById('preferredUnit');

      const maxValue =
        document.getElementById('maxValue');

      const maxUnit =
        document.getElementById('maxUnit');

      const result =
        document.getElementById('result');

      const previewText =
        document.getElementById('previewText');

      const copyBtn =
        document.getElementById('copyBtn');

      const resetBtn =
        document.getElementById('resetBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const minOutput =
        document.getElementById('minOutput');

      const preferredOutput =
        document.getElementById('preferredOutput');

      const maxOutput =
        document.getElementById('maxOutput');


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      /* ================= GENERATE ================= */

      const generateClamp = () => {

        const min =
          minValue.value;

        const minU =
          minUnit.value;

        const preferred =
          preferredValue.value;

        const preferredU =
          preferredUnit.value;

        const max =
          maxValue.value;

        const maxU =
          maxUnit.value;


        if (
          min === '' ||
          preferred === '' ||
          max === ''
        ) {

          return;

        }


        const minNumber =
          Number(min);

        const maxNumber =
          Number(max);


        if (
          Number.isNaN(minNumber) ||
          Number.isNaN(maxNumber)
        ) {

          showStatus(
            'تحقق من القيم المدخلة.',
            true
          );

          return;

        }


        if (minNumber > maxNumber) {

          showStatus(
            'القيمة الدنيا يجب أن تكون أصغر من أو تساوي القيمة القصوى.',
            true
          );

          return;

        }


        const clampValue =
          `clamp(${min}${minU}, ${preferred}${preferredU}, ${max}${maxU})`;


        result.textContent =
          clampValue;


        previewText.style.fontSize =
          clampValue;


        minOutput.textContent =
          `${min}${minU}`;

        preferredOutput.textContent =
          `${preferred}${preferredU}`;

        maxOutput.textContent =
          `${max}${maxU}`;


        status.classList.add('hidden');

      };


      /* ================= COPY ================= */

      const copyResult = async () => {

        const value =
          result.textContent.trim();


        if (!value) {

          showStatus(
            'لا توجد نتيجة لنسخها.',
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );

          showStatus(
            'تم نسخ كود CSS بنجاح.'
          );


          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          showStatus(
            'تعذر نسخ الكود تلقائياً.',
            true
          );

        }

      };


      /* ================= RESET ================= */

      const resetTool = () => {

        minValue.value = '16';
        minUnit.value = 'px';

        preferredValue.value = '3';
        preferredUnit.value = 'vw';

        maxValue.value = '32';
        maxUnit.value = 'px';


        generateClamp();


        showStatus(
          'تمت إعادة ضبط الأداة.'
        );

      };


      /* ================= EVENTS ================= */

      [
        minValue,
        minUnit,
        preferredValue,
        preferredUnit,
        maxValue,
        maxUnit
      ].forEach((element) => {

        element.addEventListener(
          'input',
          generateClamp
        );

        element.addEventListener(
          'change',
          generateClamp
        );

      });


      copyBtn.addEventListener(
        'click',
        copyResult
      );


      resetBtn.addEventListener(
        'click',
        resetTool
      );


      /* ================= INITIAL ================= */

      generateClamp();

    })();
  </script>

</body>
</html>
