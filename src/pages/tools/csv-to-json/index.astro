---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CSV to JSON - تحويل CSV إلى JSON أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لتحويل ملفات CSV إلى JSON بسرعة مباشرة من المتصفح، مع دعم الفواصل والحقول النصية والبيانات الكبيرة.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">

      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>

          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>

          <i class="fas fa-chevron-left"></i>

          <span>CSV to JSON</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-table"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              JSON Tools
            </span>

            <h1>
              CSV <span>to JSON</span>
            </h1>

            <p>
              حوّل بيانات CSV إلى JSON بسرعة وسهولة
              مباشرة داخل المتصفح بدون رفع بياناتك إلى خادم خارجي.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">

              <i class="fas fa-table"></i>

              <span>CSV to JSON</span>

            </div>

            <div class="toolbar-actions">

              <button
                id="exampleBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-lightbulb"></i>
                مثال
              </button>

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Options -->

          <div class="options">

            <div class="option">

              <label for="delimiter">
                <i class="fas fa-grip-lines"></i>
                الفاصل
              </label>

              <select id="delimiter">

                <option value="auto">تلقائي</option>

                <option value=",">فاصلة ,</option>

                <option value=";">فاصلة منقوطة ;</option>

                <option value="	">Tab</option>

              </select>

            </div>


            <div class="option-check">

              <label>

                <input
                  id="trimValues"
                  type="checkbox"
                  checked
                />

                <span>إزالة المسافات الزائدة</span>

              </label>

            </div>

          </div>


          <!-- Editors -->

          <div class="editors">

            <!-- CSV -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>

                  <i class="fas fa-file-csv"></i>

                  CSV الإدخال

                </div>

                <span id="inputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="input"
                  spellcheck="false"
                  placeholder="ألصق بيانات CSV هنا...

مثال:

name,age,city
Ahmed,25,Rabat
Sara,30,Casablanca
Youssef,28,Témara"
                ></textarea>

              </div>

            </div>


            <!-- JSON -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>

                  <i class="fas fa-brackets-curly"></i>

                  JSON الناتج

                </div>

                <span id="outputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="output"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر نتيجة JSON هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- Main Action -->

          <div class="main-actions">

            <button
              id="convertBtn"
              class="convert-btn"
              type="button"
            >

              <i class="fas fa-arrow-right-arrow-left"></i>

              تحويل CSV إلى JSON

              <i class="fas fa-arrow-left"></i>

            </button>

          </div>


          <!-- Status -->

          <div id="status" class="status hidden">

            <i
              id="statusIcon"
              class="fas fa-check-circle"
            ></i>

            <span id="statusText"></span>

          </div>


          <!-- Statistics -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">

                <i class="fas fa-file-csv"></i>

              </div>

              <div>

                <span
                  class="stat-value"
                  id="rowsCount"
                >
                  0
                </span>

                <span class="stat-label">
                  عدد الصفوف
                </span>

              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">

                <i class="fas fa-table-columns"></i>

              </div>

              <div>

                <span
                  class="stat-value"
                  id="columnsCount"
                >
                  0
                </span>

                <span class="stat-label">
                  عدد الأعمدة
                </span>

              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">

                <i class="fas fa-code"></i>

              </div>

              <div>

                <span
                  class="stat-value"
                  id="jsonSize"
                >
                  0 B
                </span>

                <span class="stat-label">
                  حجم JSON
                </span>

              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">

              <i class="fas fa-bolt"></i>

            </div>

            <div>

              <h3>تحويل فوري</h3>

              <p>
                تتم عملية التحويل مباشرة داخل المتصفح
                بدون انتظار خادم خارجي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">

              <i class="fas fa-shield-halved"></i>

            </div>

            <div>

              <h3>خصوصية البيانات</h3>

              <p>
                بيانات CSV الخاصة بك لا تحتاج إلى إرسالها
                إلى أي خدمة خارجية.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">

              <i class="fas fa-code"></i>

            </div>

            <div>

              <h3>JSON جاهز</h3>

              <p>
                احصل على مصفوفة JSON منظمة يمكن استخدامها
                مباشرة في مشاريعك البرمجية.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-info"></i>

              طريقة الاستخدام

            </span>

            <h2>

              كيف تستخدم

              <span>CSV to JSON؟</span>

            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">

                <i class="fas fa-paste"></i>

              </div>

              <h3>
                ألصق CSV
              </h3>

              <p>
                ضع بيانات CSV في مربع الإدخال،
                بحيث يكون الصف الأول هو أسماء الأعمدة.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">

                <i class="fas fa-arrows-rotate"></i>

              </div>

              <h3>
                حوّل البيانات
              </h3>

              <p>
                اضغط على زر تحويل CSV إلى JSON
                لمعالجة البيانات فوراً.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">

                <i class="fas fa-copy"></i>

              </div>

              <h3>
                انسخ JSON
              </h3>

              <p>
                انسخ النتيجة واستخدمها مباشرة
                في مشروعك أو API.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-question"></i>

              الأسئلة الشائعة

            </span>

            <h2>

              أسئلة حول

              <span>CSV to JSON</span>

            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>

                ما هو CSV؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                CSV هو تنسيق لتخزين البيانات الجدولية،
                حيث يتم فصل الأعمدة باستخدام فاصلة أو فاصل آخر.
              </p>

            </details>


            <details>

              <summary>

                كيف يتم تحديد أسماء الحقول؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                يتم استخدام الصف الأول من بيانات CSV
                كأسماء للحقول في كائنات JSON.
              </p>

            </details>


            <details>

              <summary>

                هل تدعم الأداة الفاصلة المنقوطة؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                نعم. يمكنك اختيار الفاصلة أو الفاصلة المنقوطة
                أو Tab، كما يمكن للأداة محاولة اكتشاف الفاصل تلقائياً.
              </p>

            </details>


            <details>

              <summary>

                هل يتم إرسال البيانات إلى الخادم؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                لا. تتم عملية تحويل CSV إلى JSON
                بالكامل داخل المتصفح باستخدام JavaScript.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {

      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);

    }


    html.dark-mode {

      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);

    }


    *,
    *::before,
    *::after {

      box-sizing: border-box;

    }


    html {

      scroll-behavior: smooth;

    }


    body {

      margin: 0;

      background: var(--bg);

      color: var(--text);

      font-family: "Cairo", sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color .25s ease,
        color .25s ease;

    }


    a {

      color: inherit;

      text-decoration: none;

    }


    button,
    textarea,
    select {

      font-family: inherit;

    }


    button {

      -webkit-tap-highlight-color: transparent;

    }


    .container {

      width: 100%;

      max-width: 1200px;

      margin: auto;

      padding: 0 20px;

    }


    /* ================= HERO ================= */


    .tool-hero {

      position: relative;

      overflow: hidden;

      padding: 55px 0 65px;

      background: var(--bg2);

      border-bottom: 1px solid var(--border);

    }


    .hero-bg {

      position: absolute;

      inset: 0;

      pointer-events: none;

      background:

        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),

        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );

    }


    .breadcrumb {

      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 9px;

      margin-bottom: 28px;

      color: var(--muted);

      font-size: .78rem;

    }


    .breadcrumb a {

      transition: color .2s ease;

    }


    .breadcrumb a:hover {

      color: var(--primary);

    }


    .breadcrumb i {

      font-size: .55rem;

      opacity: .6;

    }


    .hero-content {

      position: relative;

      display: flex;

      align-items: center;

      gap: 22px;

    }


    .tool-icon {

      width: 78px;

      height: 78px;

      flex-shrink: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 22px;

      color: #9333ea;

      background: rgba(147, 51, 234, .10);

      border: 1px solid rgba(147, 51, 234, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(147, 51, 234, .10);

    }


    .kicker {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;

      font-weight: 800;

    }


    .hero-content h1 {

      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);

      line-height: 1.25;

    }


    .hero-content h1 span {

      color: var(--primary);

    }


    .hero-content p {

      max-width: 700px;

      margin: 0;

      color: var(--muted);

      font-size: .92rem;

    }


    /* ================= TOOL ================= */


    .tool-section {

      padding: 65px 0 90px;

    }


    .tool-card {

      overflow: hidden;

      border-radius: 24px;

      background: var(--card);

      border: 1px solid var(--border);

      box-shadow: var(--shadow);

    }


    .toolbar {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);

    }


    .toolbar-title {

      display: flex;

      align-items: center;

      gap: 9px;

      font-size: .9rem;

      font-weight: 800;

    }


    .toolbar-title i {

      color: #9333ea;

    }


    .toolbar-actions {

      display: flex;

      gap: 8px;

      flex-wrap: wrap;

    }


    .tool-btn {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;

      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;

    }


    .tool-btn:hover {

      border-color: rgba(37, 99, 235, .35);

      color: var(--primary);

      transform: translateY(-2px);

    }


    .tool-btn.danger:hover {

      color: var(--red);

      border-color: rgba(220, 38, 38, .25);

    }


    /* ================= OPTIONS ================= */


    .options {

      display: flex;

      align-items: center;

      gap: 20px;

      flex-wrap: wrap;

      padding: 15px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);

    }


    .option {

      display: flex;

      align-items: center;

      gap: 10px;

    }


    .option label {

      display: flex;

      align-items: center;

      gap: 7px;

      color: var(--muted);

      font-size: .74rem;

      font-weight: 700;

    }


    .option label i {

      color: var(--primary);

    }


    select {

      min-width: 130px;

      padding: 7px 10px;

      outline: none;

      border-radius: 9px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      cursor: pointer;

      font-size: .73rem;

    }


    .option-check label {

      display: flex;

      align-items: center;

      gap: 8px;

      color: var(--muted);

      font-size: .73rem;

      font-weight: 700;

      cursor: pointer;

    }


    .option-check input {

      width: 16px;

      height: 16px;

      accent-color: var(--primary);

      cursor: pointer;

    }


    /* ================= EDITORS ================= */


    .editors {

      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 18px;

      padding: 20px;

    }


    .editor-panel {

      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);

    }


    .panel-header {

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding: 12px 15px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;

      font-weight: 700;

    }


    .panel-header > div {

      display: flex;

      align-items: center;

      gap: 7px;

    }


    .panel-header i {

      color: var(--primary);

    }


    .editor-wrapper {

      height: 350px;

    }


    textarea {

      width: 100%;

      height: 100%;

      display: block;

      resize: none;

      outline: none;

      border: 0;

      padding: 18px;

      background: transparent;

      color: var(--text);

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .84rem;

      line-height: 1.8;

    }


    textarea::placeholder {

      color: var(--muted);

      opacity: .65;

    }


    #output {

      color: var(--primary);

    }


    /* ================= ACTION ================= */


    .main-actions {

      display: flex;

      justify-content: center;

      padding: 0 20px 20px;

    }


    .convert-btn {

      min-width: 250px;

      min-height: 52px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      border: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #9333ea,
          #7c3aed
        );

      color: white;

      font-family: inherit;

      font-size: .9rem;

      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(124, 58, 237, .22);

      transition: .25s ease;

    }


    .convert-btn:hover {

      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(124, 58, 237, .30);

    }


    /* ================= STATUS ================= */


    .status {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;

      font-weight: 700;

    }


    .status.error {

      background: rgba(220, 38, 38, .08);

      border-color: rgba(220, 38, 38, .15);

      color: var(--red);

    }


    .hidden {

      display: none;

    }


    /* ================= STATISTICS ================= */


    .statistics {

      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      background: var(--border);

      border-top: 1px solid var(--border);

    }


    .stat {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 12px;

      padding: 22px 15px;

      background: var(--card);

    }


    .stat-icon {

      width: 43px;

      height: 43px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 12px;

      background: rgba(37, 99, 235, .09);

      color: var(--primary);

    }


    .stat-icon.success {

      color: var(--green);

      background: rgba(34, 197, 94, .09);

    }


    .stat-value {

      display: block;

      color: var(--text);

      font-size: 1rem;

      font-weight: 800;

      direction: ltr;

      text-align: right;

    }


    .stat-label {

      display: block;

      color: var(--muted);

      font-size: .68rem;

    }


    /* ================= INFO ================= */


    .info-grid {

      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;

    }


    .info-card {

      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;

    }


    .info-card:hover {

      transform: translateY(-4px);

      border-color:
        rgba(37, 99, 235, .25);

    }


    .info-icon {

      width: 44px;

      height: 44px;

      flex-shrink: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);

    }


    .info-card h3 {

      margin: 0 0 5px;

      font-size: .9rem;

    }


    .info-card p {

      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;

    }


    /* ================= SECTIONS ================= */


    .how-section,
    .faq-section {

      margin-top: 100px;

    }


    .section-heading {

      text-align: center;

      margin-bottom: 40px;

    }


    .section-heading h2 {

      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);

    }


    .section-heading h2 span {

      color: var(--primary);

    }


    /* ================= STEPS ================= */


    .steps {

      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 18px;

    }


    .step {

      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);

    }


    .step-number {

      position: absolute;

      top: 10px;

      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;

      font-weight: 800;

    }


    .step-icon {

      width: 58px;

      height: 58px;

      display: flex;

      align-items: center;

      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);

      font-size: 1.2rem;

    }


    .step h3 {

      margin: 0 0 7px;

      font-size: 1rem;

    }


    .step p {

      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;

    }


    /* ================= FAQ ================= */


    .faq-list {

      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;

    }


    details {

      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);

    }


    summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;

      font-weight: 700;

    }


    summary::-webkit-details-marker {

      display: none;

    }


    summary i {

      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;

    }


    details[open] summary i {

      transform: rotate(180deg);

    }


    details p {

      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;

    }


    /* ================= MOBILE ================= */


    @media (max-width: 800px) {

      .tool-hero {

        padding: 40px 0 50px;

      }


      .hero-content {

        align-items: flex-start;

      }


      .tool-icon {

        width: 65px;

        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;

      }


      .editors {

        grid-template-columns: 1fr;

      }


      .info-grid,
      .steps {

        grid-template-columns: 1fr;

      }


      .statistics {

        grid-template-columns: 1fr;

      }


      .stat {

        justify-content: flex-start;

        padding-right: 25px;

      }

    }


    @media (max-width: 600px) {

      .container {

        padding-left: 14px;

        padding-right: 14px;

      }


      .tool-hero {

        padding: 30px 0 40px;

      }


      .breadcrumb {

        font-size: .68rem;

      }


      .hero-content {

        gap: 14px;

      }


      .tool-icon {

        width: 55px;

        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;

      }


      .hero-content h1 {

        font-size: 1.75rem;

      }


      .hero-content p {

        font-size: .75rem;

        line-height: 1.8;

      }


      .tool-section {

        padding: 45px 0 65px;

      }


      .tool-card {

        border-radius: 18px;

      }


      .toolbar {

        align-items: flex-start;

        flex-direction: column;

        padding: 14px;

      }


      .toolbar-actions {

        width: 100%;

      }


      .tool-btn {

        flex: 1;

      }


      .options {

        align-items: flex-start;

        flex-direction: column;

        padding: 13px;

      }


      .option {

        width: 100%;

        justify-content: space-between;

      }


      .option-check {

        width: 100%;

      }


      select {

        flex: 1;

      }


      .editors {

        padding: 12px;

        gap: 12px;

      }


      .editor-wrapper {

        height: 280px;

      }


      textarea {

        padding: 14px;

        font-size: .76rem;

      }


      .convert-btn {

        width: 100%;

        min-width: 0;

        font-size: .82rem;

      }


      .info-card {

        padding: 18px;

      }


      .how-section,
      .faq-section {

        margin-top: 70px;

      }


      .section-heading {

        margin-bottom: 30px;

      }


      .section-heading h2 {

        font-size: 1.7rem;

      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {

        animation-duration: .01ms !important;

        transition-duration: .01ms !important;

      }


      html {

        scroll-behavior: auto;

      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {

          document.documentElement.classList.add(
            'dark-mode'
          );

        } else {

          document.documentElement.classList.remove(
            'dark-mode'
          );

        }

        try {

          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );

        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {

          document.documentElement.classList.add(
            'dark-mode'
          );

        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      window.addEventListener(
        'storage',
        (event) => {

          if (event.key === 'theme') {

            applyTheme(
              event.newValue === 'dark'
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const input =
        document.getElementById('input');

      const output =
        document.getElementById('output');

      const convertBtn =
        document.getElementById('convertBtn');

      const exampleBtn =
        document.getElementById('exampleBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const delimiter =
        document.getElementById('delimiter');

      const trimValues =
        document.getElementById('trimValues');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const inputSize =
        document.getElementById('inputSize');

      const outputSize =
        document.getElementById('outputSize');

      const rowsCount =
        document.getElementById('rowsCount');

      const columnsCount =
        document.getElementById('columnsCount');

      const jsonSize =
        document.getElementById('jsonSize');


      /* ================= SIZE ================= */

      const getBytes = (text) => {

        return new Blob([text]).size;

      };


      const formatBytes = (bytes) => {

        if (!bytes) {

          return '0 B';

        }

        if (bytes < 1024) {

          return `${bytes} B`;

        }

        if (bytes < 1024 * 1024) {

          return `${(
            bytes / 1024
          ).toFixed(2)} KB`;

        }

        return `${(
          bytes / (1024 * 1024)
        ).toFixed(2)} MB`;

      };


      const updateSizes = () => {

        const inputBytes =
          getBytes(input.value);

        const outputBytes =
          getBytes(output.value);

        inputSize.textContent =
          formatBytes(inputBytes);

        outputSize.textContent =
          formatBytes(outputBytes);

        jsonSize.textContent =
          formatBytes(outputBytes);

      };


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove(
          'hidden'
        );

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add(
          'hidden'
        );

      };


      /* ================= CSV PARSER ================= */

      const detectDelimiter = (text) => {

        const firstLine =
          text.split(/\r?\n/)[0] || '';

        const candidates = [
          ',',
          ';',
          '\t'
        ];

        let best =
          candidates[0];

        let bestCount = -1;

        candidates.forEach((candidate) => {

          let count = 0;

          let insideQuotes = false;

          for (
            let i = 0;
            i < firstLine.length;
            i++
          ) {

            const char =
              firstLine[i];

            if (char === '"') {

              if (
                insideQuotes &&
                firstLine[i + 1] === '"'
              ) {

                i++;

              } else {

                insideQuotes =
                  !insideQuotes;

              }

            } else if (
              char === candidate &&
              !insideQuotes
            ) {

              count++;

            }

          }

          if (count > bestCount) {

            bestCount = count;

            best = candidate;

          }

        });

        return best;

      };


      const parseCSV = (
        text,
        separator,
        shouldTrim
      ) => {

        const rows = [];

        let row = [];

        let value = '';

        let insideQuotes = false;


        for (
          let i = 0;
          i < text.length;
          i++
        ) {

          const char =
            text[i];

          const next =
            text[i + 1];


          if (char === '"') {

            if (
              insideQuotes &&
              next === '"'
            ) {

              value += '"';

              i++;

            } else {

              insideQuotes =
                !insideQuotes;

            }

            continue;

          }


          if (
            char === separator &&
            !insideQuotes
          ) {

            row.push(
              shouldTrim
                ? value.trim()
                : value
            );

            value = '';

            continue;

          }


          if (
            (char === '\n' ||
              char === '\r') &&
            !insideQuotes
          ) {

            if (
              char === '\r' &&
              next === '\n'
            ) {

              i++;

            }

            row.push(
              shouldTrim
                ? value.trim()
                : value
            );

            value = '';

            if (
              row.some(
                (cell) =>
                  cell !== ''
              )
            ) {

              rows.push(row);

            }

            row = [];

            continue;

          }


          value += char;

        }


        if (
          value !== '' ||
          row.length > 0
        ) {

          row.push(
            shouldTrim
              ? value.trim()
              : value
          );

          if (
            row.some(
              (cell) =>
                cell !== ''
            )
          ) {

            rows.push(row);

          }

        }


        if (
          insideQuotes
        ) {

          throw new Error(
            'CSV يحتوي على علامة اقتباس غير مغلقة.'
          );

        }


        return rows;

      };


      /* ================= UNIQUE HEADERS ================= */

      const makeUniqueHeaders = (
        headers
      ) => {

        const used = {};

        return headers.map(
          (header, index) => {

            let name =
              header ||
              `column_${index + 1}`;

            if (
              used[name] === undefined
            ) {

              used[name] = 0;

              return name;

            }

            used[name]++;

            return `${name}_${used[name]}`;

          }
        );

      };


      /* ================= CONVERT ================= */

      const convertCSV = () => {

        hideStatus();

        const value =
          input.value.trim();

        if (!value) {

          output.value = '';

          rowsCount.textContent = '0';

          columnsCount.textContent = '0';

          updateSizes();

          showStatus(
            'أدخل بيانات CSV أولاً.',
            true
          );

          return;

        }


        try {

          const separator =
            delimiter.value === 'auto'
              ? detectDelimiter(value)
              : delimiter.value;


          const rows =
            parseCSV(
              value,
              separator,
              trimValues.checked
            );


          if (
            rows.length < 2
          ) {

            throw new Error(
              'يجب أن يحتوي CSV على صف للعناوين وصف واحد على الأقل للبيانات.'
            );

          }


          const headers =
            makeUniqueHeaders(
              rows[0]
            );


          const dataRows =
            rows.slice(1);


          const result =
            dataRows.map(
              (row) => {

                const object = {};

                headers.forEach(
                  (header, index) => {

                    object[header] =
                      row[index] !== undefined
                        ? row[index]
                        : '';

                  }
                );

                return object;

              }
            );


          output.value =
            JSON.stringify(
              result,
              null,
              2
            );


          rowsCount.textContent =
            String(
              result.length
            );

          columnsCount.textContent =
            String(
              headers.length
            );


          updateSizes();


          showStatus(
            `تم تحويل ${result.length} صف و${headers.length} عمود بنجاح.`
          );

        } catch (error) {

          output.value = '';

          rowsCount.textContent = '0';

          columnsCount.textContent = '0';

          updateSizes();

          showStatus(
            error?.message ||
              'تعذر تحويل بيانات CSV.',
            true
          );

        }

      };


      /* ================= EXAMPLE ================= */

      const loadExample = () => {

        input.value =
`name,age,city,active
Ahmed,25,Rabat,true
Sara,30,Casablanca,true
Youssef,28,Temara,false
Salma,24,Marrakech,true`;

        delimiter.value =
          'auto';

        trimValues.checked =
          true;

        output.value = '';

        hideStatus();

        updateSizes();

        rowsCount.textContent =
          '0';

        columnsCount.textContent =
          '0';

        input.focus();

      };


      /* ================= COPY ================= */

      const copyOutput = async () => {

        const value =
          output.value;

        if (!value) {

          showStatus(
            'لا توجد نتيجة لنسخها.',
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );

          showStatus(
            'تم نسخ JSON بنجاح.'
          );

          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          output.select();

          document.execCommand(
            'copy'
          );

          showStatus(
            'تم نسخ JSON.'
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        input.value = '';

        output.value = '';

        rowsCount.textContent =
          '0';

        columnsCount.textContent =
          '0';

        hideStatus();

        updateSizes();

        input.focus();

      };


      /* ================= EVENTS ================= */

      convertBtn.addEventListener(
        'click',
        convertCSV
      );


      exampleBtn.addEventListener(
        'click',
        loadExample
      );


      copyBtn.addEventListener(
        'click',
        copyOutput
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      input.addEventListener(
        'input',
        () => {

          updateSizes();

          if (
            !input.value.trim()
          ) {

            output.value = '';

            rowsCount.textContent =
              '0';

            columnsCount.textContent =
              '0';

            updateSizes();

          }

        }
      );


      delimiter.addEventListener(
        'change',
        () => {

          if (
            input.value.trim()
          ) {

            convertCSV();

          }

        }
      );


      trimValues.addEventListener(
        'change',
        () => {

          if (
            input.value.trim()
          ) {

            convertCSV();

          }

        }
      );


      /* ================= KEYBOARD ================= */

      input.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            convertCSV();

          }

        }
      );


      /* ================= INITIAL ================= */

      updateSizes();

    })();
  </script>

</body>
