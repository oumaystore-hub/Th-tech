        height: 82px;
        flex: 0 0 82px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 32px;
        background:
          linear-gradient(
            145deg,
            var(--primary),
            var(--primary-2)
