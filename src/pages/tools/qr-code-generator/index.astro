        1px solid var(--line-strong);

      border-radius:
        999px;

      font-size:
        12px;

      font-weight:
        700;

    }


    .hero h1 {

      margin:
        0;

      font-size:
        clamp(29px, 5vw, 46px);

      line-height:
        1.35;

      font-weight:
        800;

      letter-spacing:
        -.5px;

    }


    .hero h1 span {
      color: var(--blue);
    }


    .hero > p {

      max-width:
        680px;

      margin:
        13px auto 20px;

      color:
        var(--muted);

      font-size:
        14px;

      line-height:
        2;

    }


    .hero-points {

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      flex-wrap:
        wrap;

      gap:
        9px;

    }


    .hero-points span {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        7px 12px;

      color:
        var(--text-soft);

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        10px;

      font-size:
        10px;

    }


    .hero-points i {
      color: var(--blue);
    }


    /* =========================================================
       TOOL CARD
       ========================================================= */

    .tool {

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        24px;

      box-shadow:
        var(--shadow);

      overflow:
        hidden;

      transition:
        background .25s ease,
        border-color .25s ease;

    }


    .tool-top {

      padding:
        26px 28px;

      display:
        flex;

      justify-content:
        space-between;

      align-items:
        flex-start;

      gap:
        20px;

      border-bottom:
        1px solid var(--line);

    }


    .mini-label {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      color:
        var(--blue);

      font-size:
        11px;

      font-weight:
        800;

    }


    .tool-top h2 {

      margin:
        6px 0 3px;

      font-size:
        21px;

      font-weight:
        800;

    }


    .tool-top p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        11px;

    }


    .status {

      flex-shrink:
        0;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        8px 12px;

      border:
        1px solid rgba(42,213,161,.20);

      border-radius:
        999px;

      color:
        var(--success);

      background:
        rgba(42,213,161,.07);

      font-size:
        10px;

      font-weight:
        700;

    }


    .status span {

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        currentColor;

      box-shadow:
        0 0 10px currentColor;

    }


    .status.working {

      color:
        var(--blue);

      border-color:
        var(--line-strong);

      background:
        rgba(40,184,242,.07);

    }


    /* =========================================================
       TYPE SELECTOR
       ========================================================= */

    .type-area {

      padding:
        22px 28px;

      border-bottom:
        1px solid var(--line);

    }


    .type-title {

      margin-bottom:
        12px;

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        800;

    }


    .types {

      display:
        grid;

      grid-template-columns:
        repeat(5,1fr);

      gap:
        10px;

    }


    .type {

      min-height:
        64px;

      padding:
        8px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      border:
        1px solid var(--line);

      border-radius:
        13px;

      background:
        var(--surface-2);

      color:
        var(--muted);

      font-family:
        inherit;

      font-size:
        11px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        .2s ease;

    }


    .type i {

      color:
        var(--blue);

      font-size:
        15px;

    }


    .type:hover {

      border-color:
        var(--line-strong);

      transform:
        translateY(-1px);

    }


    .type.active {

      color:
        var(--text);

      background:
        linear-gradient(
          135deg,
          rgba(40,184,242,.15),
          rgba(40,184,242,.05)
        );

      border-color:
        rgba(40,184,242,.45);

      box-shadow:
        inset 0 0 0 1px rgba(40,184,242,.04);

    }


    /* =========================================================
       WORKSPACE
       ========================================================= */

    .work {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

    }


    .editor,
    .preview {

      padding:
        28px;

    }


    .editor {

      border-left:
        1px solid var(--line);

    }


    .preview {

      background:
        var(--surface-2);

    }


    .block-head {

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

      margin-bottom:
        24px;

    }


    .block-icon {

      width:
        43px;

      height:
        43px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid var(--line);

      border-radius:
        12px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

      font-size:
        15px;

    }


    .block-head h3 {

      margin:
        0 0 3px;

      font-size:
        15px;

      font-weight:
        800;

    }


    .block-head p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.8;

    }


    .fields {

      display:
        flex;

      flex-direction:
        column;

      gap:
        9px;

    }


    .fields label {

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        700;

      margin-top:
        3px;

    }


    .fields label b {

      color:
        var(--danger);

      font-weight:
        700;

    }


    input,
    textarea,
    select {

      width:
        100%;

      border:
        1px solid var(--line);

      border-radius:
        11px;

      background:
        var(--field);

      color:
        var(--text);

      font-family:
        "Cairo",
        sans-serif;

      outline:
        none;

      transition:
        .2s ease;

    }


    input,
    select {

      height:
        46px;

      padding:
        0 13px;

      font-size:
        11px;

    }


    textarea {

      min-height:
        150px;

      padding:
        12px 13px;

      resize:
        vertical;

      font-size:
        11px;

      line-height:
        2;

    }


    textarea.small-textarea {

      min-height:
        95px;

    }


    input:focus,
    textarea:focus,
    select:focus {

      border-color:
        var(--blue);

      box-shadow:
        0 0 0 3px rgba(40,184,242,.08);

    }


    input::placeholder,
    textarea::placeholder {

      color:
        var(--muted-2);

    }


    .field-meta {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      color:
        var(--muted-2);

      font-size:
        9px;

    }


    .hint {

      color:
        var(--muted-2);

      font-size:
        9px;

    }


    .checkbox {

      display:
        flex !important;

      align-items:
        center;

      gap:
        9px;

      cursor:
        pointer;

      margin-top:
        4px !important;

    }


    .checkbox input {

      width:
        16px;

      height:
        16px;

      accent-color:
        var(--blue);

    }


    /* =========================================================
       SETTINGS
       ========================================================= */

    .settings {

      margin-top:
        24px;

      padding-top:
        22px;

      border-top:
        1px solid var(--line);

    }


    .settings-head {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      margin-bottom:
        13px;

      color:
        var(--text);

      font-size:
        11px;

      font-weight:
        800;

    }


    .settings-head i {
      color: var(--blue);
    }


    .settings-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        9px;

    }


    .settings-grid label {

      display:
        block;

      margin-bottom:
        7px;

      color:
        var(--muted);

      font-size:
        9px;

    }


    .settings-grid select {

      height:
        43px;

    }


    /* =========================================================
       MAIN ACTIONS
       ========================================================= */

    .main-actions {

      display:
        grid;

      grid-template-columns:
        1fr 1.6fr;

      gap:
        10px;

      margin-top:
        24px;

    }


    .main-actions button {

      min-height:
        48px;

      border-radius:
        11px;

      font-family:
        inherit;

      font-size:
        11px;

      font-weight:
        800;

      cursor:
        pointer;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      transition:
        .2s ease;

    }


    .reset-btn {

      color:
        var(--text);

      background:
        var(--surface-3);

      border:
        1px solid var(--line);

    }


    .generate-btn {

      color:
        #fff;

      background:
        linear-gradient(
          135deg,
          var(--blue),
          var(--blue-dark)
        );

      border:
        0;

      box-shadow:
        0 8px 22px rgba(8,151,215,.20);

    }


    .main-actions button:hover {

      transform:
        translateY(-1px);

    }


    .message {

      min-height:
        19px;

      margin-top:
        10px;

      text-align:
        center;

      font-size:
        10px;

    }


    .message.success {
      color: var(--success);
    }


    .message.error {
      color: var(--danger);
    }


    /* =========================================================
       PREVIEW
       ========================================================= */

    .preview-head {
      margin-bottom: 22px;
    }


    .qr-container {

      min-height:
        350px;

      padding:
        20px;

      display:
        grid;

      place-items:
        center;

      border:
        1px dashed var(--line-strong);

      border-radius:
        18px;

      background:
        var(--page-bg);

      transition:
        background .25s ease;

    }


    .empty {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      gap:
        8px;

      text-align:
        center;

    }


    .empty-icon {

      width:
        70px;

      height:
        70px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid var(--line);

      border-radius:
        18px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

      font-size:
        27px;

      margin-bottom:
        5px;

    }


    .empty strong {

      color:
        var(--text);

      font-size:
        12px;

    }


    .empty span {

      color:
        var(--muted);

      font-size:
        9px;

    }


    .qr-box {

      padding:
        12px;

      background:
        #fff;

      border-radius:
        10px;

      box-shadow:
        0 14px 35px rgba(0,0,0,.18);

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      max-width:
        100%;

    }


    .qr-box img,
    .qr-box canvas {

      display:
        block;

      max-width:
        100%;

      height:
        auto;

    }


    .qr-meta {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        12px;

      color:
        var(--muted);

      font-size:
        9px;

    }


    .qr-meta i {
      color:
        var(--success);

      margin-left:
        4px;

    }


    .export-title {

      margin:
        22px 0 10px;

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        800;

    }


    .export-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        9px;

    }


    .export {

      min-height:
        60px;

      padding:
        8px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      border:
        1px solid var(--line);

      border-radius:
        12px;

      background:
        var(--surface);

      color:
        var(--text);

      font-family:
        inherit;

      cursor:
        pointer;

      transition:
        .2s ease;

    }


    .export i {

      color:
        var(--blue);

      font-size:
        15px;

    }


    .export span {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-start;

    }


    .export strong {

      font-size:
        10px;

    }


    .export small {

      color:
        var(--muted);

      font-size:
        8px;

    }


    .export:hover:not(:disabled) {

      border-color:
        var(--line-strong);

      transform:
        translateY(-1px);

    }


    .export:disabled {

      opacity:
        .35;

      cursor:
        not-allowed;

    }


    /* =========================================================
       FEATURES
       ========================================================= */

    .features {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        12px;

      margin-top:
        16px;

    }


    .feature {

      padding:
        17px;

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        15px;

      box-shadow:
        var(--shadow);

    }


    .feature > div {

      width:
        42px;

      height:
        42px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

    }


    .feature section strong,
    .feature section span {

      display:
        block;

    }


    .feature strong {

      font-size:
        11px;

    }


    .feature span {

      margin-top:
        3px;

      color:
        var(--muted);

      font-size:
        8px;

    }


    /* =========================================================
       INFO
       ========================================================= */

    .info {

      margin-top:
        16px;

      padding:
        21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        14px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        17px;

      box-shadow:
        var(--shadow);

    }


    .info-icon,
    .tip-icon {

      width:
        44px;

      height:
        44px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        12px;

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      color:
        var(--blue);

    }


    .info h2 {

      margin:
        0 0 7px;

      font-size:
        14px;

    }


    .info p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        2;

    }


    .info-body {
      width: 100%;
    }


    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        14px;

      margin-top:
        17px;

    }


    .step {

      display:
        flex;

      gap:
        10px;

    }


    .step > span {

      width:
        29px;

      height:
        29px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        8px;

      color:
        var(--blue);

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      font-size:
        10px;

      font-weight:
        800;

    }


    .step strong {

      font-size:
        10px;

    }


    .step p {

      margin-top:
        3px;

      font-size:
        8px;

    }


    /* =========================================================
       TIP
       ========================================================= */

    .tip {

      margin-top:
        16px;

      padding:
        18px 21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        13px;

      border:
        1px solid var(--line);

      border-radius:
        17px;

      background:
        linear-gradient(
          135deg,
          rgba(40,184,242,.07),
          var(--surface)
        );

    }


    .tip strong {

      display:
        block;

      margin:
        1px 0 4px;

      font-size:
        12px;

    }


    .tip p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        1.9;

    }


    /* =========================================================
       FAQ
       ========================================================= */

    .faq {

      margin-top:
        48px;

    }


    .faq-title {

      text-align:
        center;

      margin-bottom:
        18px;

    }


    .faq-title span {

      color:
        var(--blue);

      font-size:
        10px;

      font-weight:
        800;

    }


    .faq-title h2 {

      margin:
        5px 0 0;

      font-size:
        22px;

      font-weight:
        800;

    }


    details {

      margin-bottom:
        9px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        13px;

      overflow:
        hidden;

    }


    summary {

      min-height:
        54px;

      padding:
        12px 16px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      list-style:
        none;

      cursor:
        pointer;

      color:
        var(--text);

      font-size:
        10px;

      font-weight:
        700;

    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {

      color:
        var(--blue);

      transition:
        .2s ease;

    }


    details[open] summary i {

      transform:
        rotate(45deg);

    }


    details p {

      margin:
        0;

      padding:
        0 16px 16px;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        2;

    }


    .hidden {
      display: none !important;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @media (max-width: 850px) {

      .work {

        grid-template-columns:
          1fr;

      }


      .editor {

        border-left:
          0;

        border-bottom:
          1px solid var(--line);

      }


      .features {

        grid-template-columns:
          1fr;

      }

    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 600px) {

      .qr-page {

        width:
          calc(100% - 18px);

        padding:
          22px 0 55px;

      }


      .hero {

        padding:
          5px 5px 25px;

      }


      .hero h1 {

        font-size:
          28px;

      }


      .hero > p {

        font-size:
          11px;

        line-height:
          1.9;

      }


      .hero-points {

        gap:
          6px;

      }


      .hero-points span {

        padding:
          6px 8px;

        font-size:
          8px;

      }


      .tool {

        border-radius:
          18px;

      }


      .tool-top {

        padding:
          19px;

      }


      .tool-top h2 {

        font-size:
          17px;

      }


      .tool-top p {

        font-size:
          9px;

      }


      .status {

        padding:
          6px 9px;

        font-size:
          8px;

      }


      .type-area {

        padding:
          16px;

      }


      .types {

        grid-template-columns:
          repeat(3,1fr);

        gap:
          7px;

      }


      .type {

        min-height:
          53px;

        flex-direction:
          column;

        gap:
          4px;

        font-size:
          9px;

      }


      .type i {

        font-size:
          14px;

      }


      .editor,
      .preview {

        padding:
          18px;

      }


      .block-head {

        margin-bottom:
          18px;

      }


      .block-icon {

        width:
          39px;

        height:
          39px;

      }


      .block-head h3 {

        font-size:
          13px;

      }


      .block-head p {

        font-size:
          8px;

      }


      input,
      select {

        height:
          45px;

        font-size:
          10px;

      }


      textarea {

        min-height:
          135px;

      }


      .settings-grid {

        grid-template-columns:
          1fr;

        gap:
          10px;

      }


      .main-actions {

        grid-template-columns:
          1fr;

      }


      .main-actions button {

        min-height:
          46px;

      }


      .qr-container {

        min-height:
          280px;

        padding:
          14px;

      }


      .qr-box {

        max-width:
          100%;

        overflow:
          hidden;

      }


      .qr-meta {

        font-size:
          8px;

      }


      .export-grid {

        gap:
          7px;

      }


      .export {

        min-height:
          56px;

        padding:
          6px;

      }


      .export span {

        display:
          none;

      }


      .export i {

        font-size:
          16px;

      }


      .info {

        padding:
          16px;

      }


      .steps {

        grid-template-columns:
          1fr;

      }


