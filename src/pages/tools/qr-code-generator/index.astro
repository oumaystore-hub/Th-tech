      display: grid;
      place-items: center;
      border-radius: 11px;
      color: white;
      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-dark)
        );
      font-family: "JetBrains Mono", monospace;
      font-size: 9px;
      font-weight: 700;
    }


    .step h3 {
      margin: 0 0 6px;
      font-size: 13px;
    }


    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.9;
    }


    .faq {
      max-width: 850px;
      margin: auto;
      display: grid;
      gap: 9px;
    }


    details {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 16px 18px;
      cursor: pointer;
      list-style: none;
      font-size: 11px;
      font-weight: 800;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);
    }


    details p {
      margin: 0;
      padding: 0 18px 17px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.9;
    }


    @media (max-width:1000px) {

      .tool-grid {
        grid-template-columns: 1fr;
      }

      .input-panel {
        border-left: 0;
        border-bottom: 1px solid var(--border);
      }

      .features {
        grid-template-columns: repeat(2,1fr);
      }

    }


    @media (max-width:750px) {

      .hero {
        padding-top: 25px;
      }

      .hero-icon {
        width: 68px;
        height: 68px;
        flex-basis: 68px;
        font-size: 27px;
      }

      .input-panel,
      .preview-panel {
        padding: 18px 15px;
      }

      .settings-grid {
        grid-template-columns: 1fr;
      }

      .secure {
        display: none;
      }

      .wifi-box {
        grid-template-columns: 1fr;
      }

      .wifi-box .full {
        grid-column: auto;
      }

    }


    @media (max-width:600px) {

      .container {
        width: min(100% - 20px,1180px);
      }

      .hero-icon {
        display: none;
      }

      h1 {
        font-size: 30px;
      }

      .hero-content p {
        font-size: 12px;
      }

      .toolbar-space {
        display: none;
      }

      .action-button,
      .download-button {
        flex: 1;
        padding-inline: 8px;
        font-size: 9px;
      }

      .types {
        gap: 5px;
      }

      .type {
        min-height: 60px;
      }

      .type span {
        font-size: 8px;
      }

      .qr-area {
        min-height: 320px;
      }

      .qr-box {
        max-width: 285px;
      }

      .features,
      .steps {
        grid-template-columns: 1fr;
      }

      .preview-buttons {
        grid-template-columns: 1fr;
      }

      .section,
      .how {
        padding: 55px 0;
      }

    }


    @media (max-width:390px) {

      .type span {
        display: none;
      }

      .type {
        min-height: 48px;
      }

    }

  </style>

