    padding: 11px 12px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface);
  }

  .status-message-icon {
    width: 31px;
    height: 31px;
    flex: 0 0 31px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    color: var(--primary);
    background: var(--primary-soft);
    font-size: 12px;
  }

  .status-message strong {
    display: block;
    font-size: 10px;
  }

  .status-message span {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.5;
  }

  .status-message.success .status-message-icon {
    color: var(--success);
    background: rgba(9, 149, 110, 0.1);
  }

  .status-message.error .status-message-icon {
    color: var(--danger);
    background: rgba(220, 76, 85, 0.1);
  }

  .status-message.loading .status-message-icon {
    color: var(--primary);
  }

  /* SECTIONS */

  .features-section,
  .how-section,
  .faq-section {
    padding: 75px 0;
  }

  .how-section {
    border-block: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .section-heading {
    max-width: 720px;
    margin: 0 auto 35px;
    text-align: center;
  }

  .section-heading > span {
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .section-heading h2 {
    margin: 8px 0 9px;
    font-size: clamp(23px, 4vw, 31px);
  }

  .section-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.9;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
  }

  .feature-card {
    padding: 23px;
    border: 1px solid var(--border);
    border-radius: 17px;
    background: var(--surface);
    transition: 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(7, 159, 194, 0.35);
    box-shadow: 0 15px 35px rgba(7, 159, 194, 0.08);
  }

  .feature-icon {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    margin-bottom: 15px;
    border-radius: 12px;
    color: var(--primary);
    background: var(--primary-soft);
  }

  .feature-card h3 {
    margin: 0 0 7px;
    font-size: 14px;
  }

  .feature-card p {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .step {
    display: flex;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 17px;
    background: var(--surface);
  }

  .step-number {
    width: 39px;
    height: 39px;
    flex: 0 0 39px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    color: #fff;
    background:
      linear-gradient(
        135deg,
        var(--primary),
        var(--primary-dark)
      );
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 700;
  }

  .step h3 {
    margin: 0 0 6px;
    font-size: 13px;
  }

  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
  }

  .faq-list {
    max-width: 850px;
    margin: auto;
    display: grid;
    gap: 9px;
  }

  details {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
    font-size: 11px;
    font-weight: 800;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    color: var(--primary);
    transition: 0.2s ease;
  }

  details[open] summary i {
    transform: rotate(180deg);
  }

  details p {
    margin: 0;
    padding: 0 18px 17px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
  }

  /* RESPONSIVE */

  @media (max-width: 1000px) {
    .workspace-grid {
      grid-template-columns: 1fr;
    }

    .editor-panel {
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 750px) {
    .hero {
      padding-top: 25px;
    }

    .hero-layout {
      align-items: flex-start;
    }

    .hero-icon {
      width: 68px;
      height: 68px;
      flex-basis: 68px;
      border-radius: 19px;
      font-size: 27px;
    }

    .workspace-head {
      padding-inline: 15px;
    }

    .toolbar {
      padding-inline: 15px;
    }

    .editor-panel,
    .preview-panel {
      padding: 18px 15px;
    }

    .settings-grid {
      grid-template-columns: 1fr;
    }

    .type-grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .type-card {
      min-height: 64px;
    }

    .type-card span {
      font-size: 8px;
    }

    .privacy {
      display: none;
    }

    .wifi-fields {
      grid-template-columns: 1fr;
    }

    .wifi-fields .field:last-child {
      grid-column: auto;
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 20px, 1180px);
    }

    .hero-layout {
      gap: 0;
    }

    .hero-icon {
      display: none;
    }

    h1 {
      font-size: 30px;
    }

    .hero-content p {
      font-size: 12px;
    }

    .toolbar {
      gap: 6px;
    }

    .tool-button,
    .download-button {
      flex: 1;
      padding-inline: 8px;
      font-size: 9px;
    }

    .toolbar-spacer {
      display: none;
    }

    .type-grid {
      gap: 5px;
    }

    .type-card {
      min-height: 60px;
      border-radius: 9px;
    }

    .type-card i {
      font-size: 13px;
    }

    .type-card span {
      font-size: 7px;
    }

    .qr-stage {
      min-height: 320px;
      padding: 18px;
    }

    .qr-paper {
      max-width: 285px;
    }

    .empty-state {
      min-height: 240px;
    }

    .preview-meta {
      grid-template-columns: repeat(3, 1fr);
    }

    .features-grid,
    .steps {
      grid-template-columns: 1fr;
    }

    .features-section,
    .how-section,
    .faq-section {
      padding: 55px 0;
    }
  }

  @media (max-width: 390px) {
    .type-card span {
      display: none;
    }

    .type-card {
      min-height: 48px;
    }

    .type-card i {
      font-size: 15px;
    }

    .preview-actions {
      grid-template-columns: 1fr;
    }
  }
</style>

