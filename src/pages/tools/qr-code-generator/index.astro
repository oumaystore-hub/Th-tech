---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>مولد QR Code احترافي | Th.Tech</title>
  <meta
    name="description"
    content="مولد QR Code مجاني وسريع لإنشاء رموز QR للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi."
  />
  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <!-- QRCode.js -->
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"
  ></script>
</head>

<body>
  <Header />

  <main class="page">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-icon">
        <i class="fa-solid fa-qrcode"></i>
      </div>

      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>مولد QR Code</span>
      </div>

      <span class="eyebrow">أداة مجانية وسريعة</span>

      <h1>مولد <span>QR Code</span> احترافي</h1>

      <p class="hero-description">
        أنشئ رمز QR مخصصاً للنصوص والروابط وأرقام الهاتف والبريد الإلكتروني
        وشبكات Wi-Fi بسهولة وفورياً.
      </p>

      <div class="hero-tags">
        <span><i class="fa-solid fa-bolt"></i> فوري</span>
        <span><i class="fa-solid fa-shield-halved"></i> آمن</span>
        <span><i class="fa-solid fa-mobile-screen"></i> متجاوب</span>
      </div>
    </section>

    <!-- TOOL -->
    <section class="tool-card">

      <div class="tool-header">
        <div>
          <span class="section-label">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            مولد QR
          </span>

          <h2>أنشئ رمز QR الخاص بك</h2>

          <p>
            أدخل البيانات وسيتم إنشاء الرمز تلقائياً.
          </p>
        </div>

        <div class="live-status" id="status">
          <span class="status-dot"></span>
          جاهز
        </div>
      </div>

      <!-- TYPES -->
      <div class="types">
        <button class="type-btn active" type="button" data-type="text">
          <i class="fa-solid fa-font"></i>
          <span>نص</span>
        </button>

        <button class="type-btn" type="button" data-type="url">
          <i class="fa-solid fa-link"></i>
          <span>رابط</span>
        </button>

        <button class="type-btn" type="button" data-type="email">
          <i class="fa-solid fa-envelope"></i>
          <span>بريد</span>
        </button>

        <button class="type-btn" type="button" data-type="phone">
          <i class="fa-solid fa-phone"></i>
          <span>هاتف</span>
        </button>

        <button class="type-btn" type="button" data-type="wifi">
          <i class="fa-solid fa-wifi"></i>
          <span>Wi-Fi</span>
        </button>
      </div>

      <!-- INPUT AREA -->
      <div class="workspace">

        <div class="input-panel">

          <div class="panel-title">
            <div class="panel-title-icon">
              <i class="fa-solid fa-pen"></i>
            </div>

            <div>
              <h3 id="inputTitle">النص</h3>
              <p id="inputHint">اكتب النص الذي تريد تحويله إلى QR Code</p>
            </div>
          </div>

          <!-- TEXT -->
          <div class="field-group" id="textFields">
            <label for="mainInput">
              المحتوى
              <span>*</span>
            </label>

            <textarea
              id="mainInput"
              rows="7"
              placeholder="اكتب النص هنا..."
              autocomplete="off"
            ></textarea>

            <div class="field-footer">
              <span id="charCount">0 حرف</span>
              <span>يدعم العربية وجميع اللغات</span>
            </div>
          </div>

          <!-- URL -->
          <div class="field-group hidden" id="urlFields">
            <label for="urlInput">
              رابط الموقع
              <span>*</span>
            </label>

            <input
              id="urlInput"
              type="url"
              placeholder="https://example.com"
              autocomplete="off"
            />

            <small>
              مثال:
              https://oumaystore-hub.github.io/Th-tech/
            </small>
          </div>

          <!-- EMAIL -->
          <div class="field-group hidden" id="emailFields">
            <label for="emailInput">
              البريد الإلكتروني
              <span>*</span>
            </label>

            <input
              id="emailInput"
              type="email"
              placeholder="example@email.com"
              autocomplete="off"
            />

            <label for="emailSubject">
              موضوع الرسالة
            </label>

            <input
              id="emailSubject"
              type="text"
              placeholder="موضوع اختياري"
              autocomplete="off"
            />

            <label for="emailBody">
              نص الرسالة
            </label>

            <textarea
              id="emailBody"
              rows="4"
              placeholder="نص الرسالة الاختياري..."
            ></textarea>
          </div>

          <!-- PHONE -->
          <div class="field-group hidden" id="phoneFields">
            <label for="phoneInput">
              رقم الهاتف
              <span>*</span>
            </label>

            <input
              id="phoneInput"
              type="tel"
              placeholder="+212600000000"
              autocomplete="off"
            />

            <small>
              أدخل الرقم مع رمز الدولة للحصول على أفضل نتيجة.
            </small>
          </div>

          <!-- WIFI -->
          <div class="field-group hidden" id="wifiFields">
            <label for="wifiName">
              اسم الشبكة SSID
              <span>*</span>
            </label>

            <input
              id="wifiName"
              type="text"
              placeholder="اسم شبكة Wi-Fi"
              autocomplete="off"
            />

            <label for="wifiPassword">
              كلمة المرور
            </label>

            <input
              id="wifiPassword"
              type="text"
              placeholder="كلمة المرور"
              autocomplete="off"
            />

            <label for="wifiSecurity">
              نوع الحماية
            </label>

            <select id="wifiSecurity">
              <option value="WPA">WPA / WPA2 / WPA3</option>
              <option value="WEP">WEP</option>
              <option value="nopass">بدون كلمة مرور</option>
            </select>

            <label class="check-row">
              <input type="checkbox" id="wifiHidden" />
              <span>الشبكة مخفية</span>
            </label>
          </div>

          <!-- SETTINGS -->
          <div class="settings">

            <div class="settings-title">
              <i class="fa-solid fa-sliders"></i>
              الإعدادات
            </div>

            <div class="settings-grid">

              <div class="setting">
                <label for="sizeSelect">الحجم</label>

                <select id="sizeSelect">
                  <option value="180">صغير</option>
                  <option value="240" selected>متوسط</option>
                  <option value="320">كبير</option>
                  <option value="420">كبير جداً</option>
                </select>
              </div>

              <div class="setting">
                <label for="marginSelect">الهامش</label>

                <select id="marginSelect">
                  <option value="1">صغير</option>
                  <option value="2" selected>متوسط</option>
                  <option value="4">كبير</option>
                  <option value="6">كبير جداً</option>
                </select>
              </div>

              <div class="setting">
                <label for="errorSelect">تصحيح الخطأ</label>

                <select id="errorSelect">
                  <option value="L">منخفض</option>
                  <option value="M" selected>متوسط</option>
                  <option value="Q">مرتفع</option>
                  <option value="H">أقصى</option>
                </select>
              </div>

            </div>
          </div>

          <!-- ACTIONS -->
          <div class="actions">
            <button class="btn secondary" type="button" id="resetBtn">
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

            <button class="btn primary" type="button" id="generateBtn">
              <i class="fa-solid fa-qrcode"></i>
              إنشاء QR Code
            </button>
          </div>

          <div class="message" id="message"></div>
        </div>

        <!-- PREVIEW -->
        <div class="preview-panel">

          <div class="preview-head">
            <div>
              <span class="section-label small">
                <i class="fa-solid fa-eye"></i>
                المعاينة
              </span>

              <h3>رمز QR الخاص بك</h3>
            </div>

            <span class="preview-state" id="previewState">
              في انتظار البيانات
            </span>
          </div>

          <div class="qr-stage" id="qrStage">
            <div class="empty-preview" id="emptyPreview">
              <div class="empty-icon">
                <i class="fa-solid fa-qrcode"></i>
              </div>

              <strong>سيظهر QR Code هنا</strong>

              <span>
                أدخل المحتوى في الحقول لبدء التوليد
              </span>
            </div>

            <canvas id="qrCanvas" hidden></canvas>
          </div>

          <div class="preview-info">
            <span>
              <i class="fa-solid fa-circle-check"></i>
              يتم التوليد محلياً في المتصفح
            </span>

            <span id="dataTypeInfo">
              النوع: نص
            </span>
          </div>

          <!-- DOWNLOAD ACTIONS -->
          <div class="download-actions">

            <button
              class="download-btn"
              type="button"
              id="pngBtn"
              disabled
            >
              <i class="fa-solid fa-image"></i>
              <span>
                <strong>PNG</strong>
                <small>صورة</small>
              </span>
            </button>

            <button
              class="download-btn"
              type="button"
              id="svgBtn"
              disabled
            >
              <i class="fa-solid fa-vector-square"></i>
              <span>
                <strong>SVG</strong>
                <small>متجه</small>
              </span>
            </button>

            <button
              class="download-btn"
              type="button"
              id="copyBtn"
              disabled
            >
              <i class="fa-solid fa-copy"></i>
              <span>
                <strong>نسخ</strong>
                <small>المحتوى</small>
              </span>
            </button>

          </div>

        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div>
          <strong>فوري</strong>
          <span>توليد مباشر</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
          <strong>100%</strong>
          <span>محلي وآمن</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-download"></i>
        </div>
        <div>
          <strong>3</strong>
          <span>طرق للتصدير</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
          <strong>5</strong>
          <span>أنواع مختلفة</span>
        </div>
      </div>

    </section>

    <!-- PRIVACY -->
    <section class="info-card privacy-card">
      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div>
        <h2>خصوصيتك أولاً</h2>

        <p>
          يتم إنشاء رمز QR داخل متصفحك مباشرة. لا يتم إرسال النصوص أو
          الروابط أو البيانات التي تدخلها إلى خادم خارجي من طرف هذه الأداة.
        </p>
      </div>
    </section>

    <!-- HOW TO -->
    <section class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-content">
        <h2>طريقة الاستخدام</h2>

        <ol class="steps">
          <li>
            <span>1</span>
            <div>
              <strong>اختر نوع البيانات</strong>
              <p>نص، رابط، بريد إلكتروني، هاتف أو Wi-Fi.</p>
            </div>
          </li>

          <li>
            <span>2</span>
            <div>
              <strong>أدخل المحتوى</strong>
              <p>اكتب البيانات المطلوبة وسيتم إنشاء الرمز تلقائياً.</p>
            </div>
          </li>

          <li>
            <span>3</span>
            <div>
              <strong>خصص الرمز</strong>
              <p>اختر الحجم والهامش ومستوى تصحيح الخطأ.</p>
            </div>
          </li>

          <li>
            <span>4</span>
            <div>
              <strong>حمّل النتيجة</strong>
              <p>يمكنك حفظ QR بصيغة PNG أو SVG أو نسخ المحتوى.</p>
            </div>
          </li>
        </ol>
      </div>

    </section>

    <!-- NOTE -->
    <section class="info-card note-card">

      <div class="info-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>
        <h2>نصيحة</h2>

        <p>
          عند طباعة QR Code، يفضل استخدام حجم مناسب وترك هامش واضح حول
          الرمز لضمان سهولة قراءته بواسطة كاميرات الهواتف.
        </p>
      </div>

    </section>

    <!-- FAQ -->
    <section class="faq">

      <div class="faq-heading">
        <span>أسئلة شائعة</span>
        <h2>الأسئلة الشائعة</h2>
      </div>

      <details>
        <summary>
          هل مولد QR Code مجاني؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، الأداة مجانية ويمكن استخدامها لإنشاء رموز QR دون الحاجة إلى
          تسجيل حساب.
        </p>
      </details>

      <details>
        <summary>
          هل يتم حفظ البيانات التي أدخلها؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          لا. عملية إنشاء الرمز تتم داخل المتصفح مباشرة.
        </p>
      </details>

      <details>
        <summary>
          ما أنواع البيانات المدعومة؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          النصوص والروابط والبريد الإلكتروني وأرقام الهاتف وبيانات شبكات
          Wi-Fi.
        </p>
      </details>

      <details>
        <summary>
          هل يمكن تحميل QR Code كصورة؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، يمكنك تحميله بصيغة PNG أو SVG.
        </p>
      </details>

    </section>

  </main>

  <Footer />

  <!-- ========================================================= -->
  <!-- QR CODE LOGIC -->
  <!-- ========================================================= -->

  <script is:inline>
    (function () {
      function startQRTool() {
        var mainInput = document.getElementById('mainInput');
        var urlInput = document.getElementById('urlInput');
        var emailInput = document.getElementById('emailInput');
        var emailSubject = document.getElementById('emailSubject');
        var emailBody = document.getElementById('emailBody');
        var phoneInput = document.getElementById('phoneInput');
        var wifiName = document.getElementById('wifiName');
        var wifiPassword = document.getElementById('wifiPassword');
        var wifiSecurity = document.getElementById('wifiSecurity');
        var wifiHidden = document.getElementById('wifiHidden');

        var qrCanvas = document.getElementById('qrCanvas');
        var emptyPreview = document.getElementById('emptyPreview');

        var generateBtn = document.getElementById('generateBtn');
        var resetBtn = document.getElementById('resetBtn');
        var pngBtn = document.getElementById('pngBtn');
        var svgBtn = document.getElementById('svgBtn');
        var copyBtn = document.getElementById('copyBtn');

        var message = document.getElementById('message');
        var status = document.getElementById('status');
        var previewState = document.getElementById('previewState');
        var charCount = document.getElementById('charCount');
        var dataTypeInfo = document.getElementById('dataTypeInfo');

        var inputTitle = document.getElementById('inputTitle');
        var inputHint = document.getElementById('inputHint');

        var typeButtons = document.querySelectorAll('.type-btn');

        var textFields = document.getElementById('textFields');
        var urlFields = document.getElementById('urlFields');
        var emailFields = document.getElementById('emailFields');
        var phoneFields = document.getElementById('phoneFields');
        var wifiFields = document.getElementById('wifiFields');

        var sizeSelect = document.getElementById('sizeSelect');
        var marginSelect = document.getElementById('marginSelect');
        var errorSelect = document.getElementById('errorSelect');

        var currentType = 'text';
        var currentPayload = '';
        var hasQR = false;

        var titles = {
          text: 'النص',
          url: 'الرابط',
          email: 'البريد الإلكتروني',
          phone: 'رقم الهاتف',
          wifi: 'شبكة Wi-Fi'
        };

        var hints = {
          text: 'اكتب النص الذي تريد تحويله إلى QR Code',
          url: 'أدخل رابط الموقع أو الصفحة',
          email: 'أدخل بيانات البريد الإلكتروني',
          phone: 'أدخل رقم الهاتف',
          wifi: 'أدخل بيانات شبكة Wi-Fi'
        };

        var typeNames = {
          text: 'نص',
          url: 'رابط',
          email: 'بريد إلكتروني',
          phone: 'هاتف',
          wifi: 'Wi-Fi'
        };

        function showOnly(element) {
          textFields.classList.add('hidden');
          urlFields.classList.add('hidden');
          emailFields.classList.add('hidden');
          phoneFields.classList.add('hidden');
          wifiFields.classList.add('hidden');

          element.classList.remove('hidden');
        }

        function setMessage(text, kind) {
          message.textContent = text || '';
          message.className = 'message';

          if (kind) {
            message.classList.add(kind);
          }
        }

        function setStatus(text, active) {
          status.innerHTML =
            '<span class="status-dot"></span>' + text;

          if (active) {
            status.classList.add('working');
          } else {
            status.classList.remove('working');
          }
        }

        function setPreviewEmpty() {
          qrCanvas.hidden = true;
          emptyPreview.hidden = false;
          previewState.textContent = 'في انتظار البيانات';
          pngBtn.disabled = true;
          svgBtn.disabled = true;
          copyBtn.disabled = true;
          hasQR = false;
        }

        function buildPayload() {
          if (currentType === 'text') {
            return mainInput.value.trim();
          }

          if (currentType === 'url') {
            var url = urlInput.value.trim();

            if (!url) {
              return '';
            }

            try {
              var parsed = new URL(url);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {
                return '';
              }

              return url;
            } catch (error) {
              return '';
            }
          }

          if (currentType === 'email') {
            var email = emailInput.value.trim();

            if (!email) {
              return '';
            }

            var subject = emailSubject.value.trim();
            var body = emailBody.value.trim();

            var result = 'mailto:' + email;

            var query = [];

            if (subject) {
              query.push(
                'subject=' + encodeURIComponent(subject)
              );
            }

            if (body) {
              query.push(
                'body=' + encodeURIComponent(body)
              );
            }

            if (query.length > 0) {
              result += '?' + query.join('&');
            }

            return result;
          }

          if (currentType === 'phone') {
            var phone = phoneInput.value.trim();

            if (!phone) {
              return '';
            }

            return 'tel:' + phone;
          }

          if (currentType === 'wifi') {
            var name = wifiName.value.trim();

            if (!name) {
              return '';
            }

            var password = wifiPassword.value;

            var security = wifiSecurity.value;

            var hidden = wifiHidden.checked ? 'true' : 'false';

            var slash = String.fromCharCode(92);

            function escapeWifi(value) {
              return value
                .split(slash)
                .join(slash + slash)
                .split(';')
                .join(slash + ';')
                .split(',')
                .join(slash + ',')
                .split(':')
                .join(slash + ':');
            }

            return (
              'WIFI:T:' +
              security +
              ';S:' +
              escapeWifi(name) +
              ';P:' +
              escapeWifi(password) +
              ';H:' +
              hidden +
              ';;'
            );
          }

          return '';
        }

        function validatePayload(payload) {
          if (!payload) {
            setMessage('يرجى إدخال البيانات أولاً.', 'error');
            return false;
          }

          if (currentType === 'url') {
            try {
              var parsed = new URL(payload);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {
                setMessage(
                  'يرجى إدخال رابط يبدأ بـ http:// أو https://',
                  'error'
                );

                return false;
              }
            } catch (error) {
              setMessage(
                'الرابط غير صالح. مثال: https://example.com',
                'error'
              );

              return false;
            }
          }

          if (currentType === 'email') {
            var email = emailInput.value.trim();
            var atPosition = email.indexOf('@');
            var dotPosition = email.lastIndexOf('.');

            if (
              atPosition < 1 ||
              dotPosition < atPosition + 2 ||
              dotPosition >= email.length - 1
            ) {
              setMessage(
                'يرجى إدخال بريد إلكتروني صالح.',
                'error'
              );

              return false;
            }
          }

          return true;
        }

        function generateQR() {
          if (
            !window.QRCode ||
            typeof window.QRCode.toCanvas !== 'function'
          ) {
            setMessage(
              'تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت ثم أعد تحميل الصفحة.',
              'error'
            );

            setStatus('خطأ', false);
            return;
          }

          var payload = buildPayload();

          if (!validatePayload(payload)) {
            setPreviewEmpty();
            return;
          }

          currentPayload = payload;

          setMessage('', '');
          setStatus('جارٍ الإنشاء...', true);
          previewState.textContent = 'جارٍ إنشاء الرمز...';

          var size = Number(sizeSelect.value);
          var margin = Number(marginSelect.value);
          var errorLevel = errorSelect.value;

          window.QRCode.toCanvas(
            qrCanvas,
            payload,
            {
              width: size,
              margin: margin,
              errorCorrectionLevel: errorLevel,
              color: {
                dark: '#07111f',
                light: '#ffffff'
              }
            },
            function (error) {
              if (error) {
                console.error(error);

                setPreviewEmpty();

                setMessage(
                  'حدث خطأ أثناء إنشاء QR Code.',
                  'error'
                );

                setStatus('خطأ', false);
                return;
              }

              emptyPreview.hidden = true;
              qrCanvas.hidden = false;

              previewState.textContent = 'تم الإنشاء';
              dataTypeInfo.textContent =
                'النوع: ' + typeNames[currentType];

              pngBtn.disabled = false;
              svgBtn.disabled = false;
              copyBtn.disabled = false;

              hasQR = true;

              setStatus('جاهز', false);

              if (currentType === 'text') {
                setMessage('تم إنشاء QR Code بنجاح.', 'success');
              } else {
                setMessage(
                  'تم إنشاء رمز QR بنجاح.',
                  'success'
                );
              }
            }
          );
        }

        function updateCharacterCount() {
          var length = mainInput.value.length;
          charCount.textContent = length + ' حرف';
        }

        function updateInterface() {
          inputTitle.textContent = titles[currentType];
          inputHint.textContent = hints[currentType];

          dataTypeInfo.textContent =
            'النوع: ' + typeNames[currentType];

          if (currentType === 'text') {
            showOnly(textFields);
          }

          if (currentType === 'url') {
            showOnly(urlFields);
          }

          if (currentType === 'email') {
            showOnly(emailFields);
          }

          if (currentType === 'phone') {
            showOnly(phoneFields);
          }

          if (currentType === 'wifi') {
            showOnly(wifiFields);
          }

          typeButtons.forEach(function (button) {
            if (button.dataset.type === currentType) {
              button.classList.add('active');
            } else {
              button.classList.remove('active');
            }
          });

          setPreviewEmpty();
          setMessage('', '');
          setStatus('جاهز', false);
        }

        function selectType(type) {
          currentType = type;
          updateInterface();
        }

        typeButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            selectType(button.dataset.type);
          });
        });

        [
          mainInput,
          urlInput,
          emailInput,
          emailSubject,
          emailBody,
          phoneInput,
          wifiName,
          wifiPassword,
          wifiSecurity,
          wifiHidden,
          sizeSelect,
          marginSelect,
          errorSelect
        ].forEach(function (element) {
          if (!element) {
            return;
          }

          element.addEventListener('input', function () {
            if (element === mainInput) {
              updateCharacterCount();
            }

            if (hasQR) {
              generateQR();
            } else {
              var payload = buildPayload();

              if (payload) {
                generateQR();
              }
            }
          });

          element.addEventListener('change', function () {
            if (hasQR || buildPayload()) {
              generateQR();
            }
          });
        });

        generateBtn.addEventListener('click', function () {
          generateQR();
        });

        resetBtn.addEventListener('click', function () {
          mainInput.value = '';
          urlInput.value = '';
          emailInput.value = '';
          emailSubject.value = '';
          emailBody.value = '';
          phoneInput.value = '';
          wifiName.value = '';
          wifiPassword.value = '';
          wifiSecurity.value = 'WPA';
          wifiHidden.checked = false;

          sizeSelect.value = '240';
          marginSelect.value = '2';
          errorSelect.value = 'M';

          currentType = 'text';
          currentPayload = '';

          updateCharacterCount();
          updateInterface();

          setMessage('تمت إعادة ضبط الأداة.', 'success');
        });

        pngBtn.addEventListener('click', function () {
          if (!hasQR) {
            return;
          }

          var link = document.createElement('a');

          link.download = 'qr-code.png';

          link.href = qrCanvas.toDataURL('image/png');

          document.body.appendChild(link);
          link.click();
          link.remove();

          setMessage(
            'تم تجهيز ملف PNG.',
            'success'
          );
        });

        svgBtn.addEventListener('click', function () {
          if (!hasQR || !window.QRCode) {
            return;
          }

          var size = Number(sizeSelect.value);
          var margin = Number(marginSelect.value);
          var errorLevel = errorSelect.value;

          window.QRCode.toString(
            currentPayload,
            {
              type: 'svg',
              width: size,
              margin: margin,
              errorCorrectionLevel: errorLevel,
              color: {
                dark: '#07111f',
                light: '#ffffff'
              }
            },
            function (error, svg) {
              if (error) {
                setMessage(
                  'تعذر إنشاء ملف SVG.',
                  'error'
                );
                return;
              }

              var blob = new Blob(
                [svg],
                {
                  type: 'image/svg+xml;charset=utf-8'
                }
              );

              var url = URL.createObjectURL(blob);

              var link = document.createElement('a');

              link.href = url;
              link.download = 'qr-code.svg';

              document.body.appendChild(link);
              link.click();
              link.remove();

              setTimeout(function () {
                URL.revokeObjectURL(url);
              }, 1000);

              setMessage(
                'تم تجهيز ملف SVG.',
                'success'
              );
            }
          );
        });

        copyBtn.addEventListener('click', function () {
          if (!hasQR || !currentPayload) {
            return;
          }

          if (
            navigator.clipboard &&
            typeof navigator.clipboard.writeText === 'function'
          ) {
            navigator.clipboard
              .writeText(currentPayload)
              .then(function () {
                setMessage(
                  'تم نسخ محتوى QR إلى الحافظة.',
                  'success'
                );
              })
              .catch(function () {
                fallbackCopy();
              });
          } else {
            fallbackCopy();
          }
        });

        function fallbackCopy() {
          var temp = document.createElement('textarea');

          temp.value = currentPayload;
          temp.style.position = 'fixed';
          temp.style.opacity = '0';

          document.body.appendChild(temp);

          temp.focus();
          temp.select();

          try {
            document.execCommand('copy');

            setMessage(
              'تم نسخ المحتوى.',
              'success'
            );
          } catch (error) {
            setMessage(
              'تعذر النسخ تلقائياً.',
              'error'
            );
          }

          temp.remove();
        }

        updateCharacterCount();
        updateInterface();

        setStatus('جاهز', false);

        /*
         * فحص بسيط للتأكد من تحميل مكتبة QR.
         */
        if (
          window.QRCode &&
          typeof window.QRCode.toCanvas === 'function'
        ) {
          setStatus('جاهز', false);
        } else {
          setStatus('انتظار المكتبة...', true);

          var attempts = 0;

          var libraryTimer = setInterval(function () {
            attempts++;

            if (
              window.QRCode &&
              typeof window.QRCode.toCanvas === 'function'
            ) {
              clearInterval(libraryTimer);

              setStatus('جاهز', false);
            }

            if (attempts > 50) {
              clearInterval(libraryTimer);

              setStatus('خطأ', false);

              setMessage(
                'لم يتم تحميل مكتبة QR Code.',
                'error'
              );
            }
          }, 100);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          startQRTool
        );
      } else {
        startQRTool();
      }
    })();
  </script>

