        const CDN =
          "https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js";

        const loadLibrary = () =>
          new Promise((resolve, reject) => {
            if (window.QRCode) {
              resolve(window.QRCode);
              return;
            }

            const script = document.createElement("script");
            script.src = CDN;
            script.async = true;

            script.onload = () => {
              if (window.QRCode) {
                resolve(window.QRCode);
              } else {
                reject(new Error("QR library unavailable"));
              }
            };

            script.onerror = () => {
              reject(new Error("QR library failed"));
            };

            document.head.appendChild(script);
          });

        const start = async () => {
          const content = document.getElementById("qr-content");
          const normalInput = document.getElementById("normal-input");
          const wifiInput = document.getElementById("wifi-input");

          const ssid = document.getElementById("wifi-ssid");
          const password = document.getElementById("wifi-password");
          const security = document.getElementById("wifi-security");
          const hidden = document.getElementById("wifi-hidden");

          const size = document.getElementById("qr-size");
          const margin = document.getElementById("qr-margin");
          const errorLevel = document.getElementById("qr-error");

          const canvas = document.getElementById("qr-canvas");
          const empty = document.getElementById("qr-empty");
          const result = document.getElementById("qr-result");

          const generateButton = document.getElementById("generate-btn");
          const clearButton = document.getElementById("clear-btn");
          const downloadPng = document.getElementById("download-png");
          const downloadSvg = document.getElementById("download-svg");
          const copyContent = document.getElementById("copy-content");

          const count = document.getElementById("content-count");

          const metaType = document.getElementById("meta-type");
          const metaSize = document.getElementById("meta-size");
          const metaError = document.getElementById("meta-error");

          const statusBox = document.getElementById("status-box");
          const statusTitle = document.getElementById("status-title");
          const statusText = document.getElementById("status-text");
          const statusIcon = statusBox.querySelector(".status-icon i");

          const typeCards = Array.from(document.querySelectorAll(".type-card"));
          const exampleButtons = Array.from(
            document.querySelectorAll("[data-example]")
          );

          let currentType = "text";
          let currentPayload = "";
          let qrReady = false;

          const typeNames = {
            text: "نص",
            url: "رابط",
            email: "بريد",
            phone: "هاتف",
            wifi: "Wi-Fi"
          };

          const escapeWifi = (value) => {
            return String(value || "")
              .replace(/\\/g, "\\\\")
              .replace(/;/g, "\\;")
              .replace(/,/g, "\\,")
              .replace(/:/g, "\\:");
          };

          const setStatus = (type, title, text) => {
            statusBox.className = "status-box " + type;
            statusTitle.textContent = title;
            statusText.textContent = text;

            if (type === "success") {
              statusIcon.className = "fa-solid fa-circle-check";
            } else if (type === "error") {
              statusIcon.className = "fa-solid fa-circle-exclamation";
            } else {
              statusIcon.className = "fa-solid fa-circle-info";
            }
          };

          const getRawValue = () => {
            if (currentType === "wifi") {
              const networkName = ssid.value.trim();
              const networkPassword = password.value;

              if (!networkName) {
                return "";
              }

              const type = security.value;
              const pass =
                type === "nopass" ? "" : escapeWifi(networkPassword);

              const hiddenValue = hidden.checked ? "H" : "";

              return (
                "WIFI:T:" +
                type +
                ";S:" +
                escapeWifi(networkName) +
                ";P:" +
                pass +
                ";H:" +
                hiddenValue +
                ";;"
              );
            }

            return content.value.trim();
          };

          const getPayload = () => {
            const value = getRawValue();

            if (!value) {
              return "";
            }

            if (currentType === "email") {
              return "mailto:" + value;
            }

            if (currentType === "phone") {
              return "tel:" + value;
            }

            return value;
          };

          const validate = () => {
            if (currentType === "text") {
              if (!content.value.trim()) {
                return "اكتب نصًا أولًا.";
              }

              return "";
            }

            if (currentType === "url") {
              const value = content.value.trim();

              if (!value) {
                return "أدخل رابطًا أولًا.";
              }

              try {
                const url = new URL(value);

                if (url.protocol !== "http:" && url.protocol !== "https:") {
                  return "استخدم رابطًا يبدأ بـ http:// أو https://.";
                }
              } catch (error) {
                return "الرابط غير صالح. مثال: https://example.com";
              }

              return "";
            }

            if (currentType === "email") {
              const value = content.value.trim();

              if (!value) {
                return "أدخل عنوان البريد الإلكتروني.";
              }

              const emailPattern =
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

              if (!emailPattern.test(value)) {
                return "عنوان البريد الإلكتروني غير صالح.";
              }

              return "";
            }

            if (currentType === "phone") {
              const value = content.value.trim();

              if (!value) {
                return "أدخل رقم الهاتف.";
              }

              const phonePattern = /^\+?[0-9][0-9\s().-]{5,20}$/;

              if (!phonePattern.test(value)) {
                return "رقم الهاتف غير صالح.";
              }

              return "";
            }

            if (currentType === "wifi") {
              if (!ssid.value.trim()) {
                return "أدخل اسم شبكة Wi-Fi.";
              }

              if (
                security.value !== "nopass" &&
                !password.value
              ) {
                return "أدخل كلمة مرور الشبكة أو اختر شبكة بدون حماية.";
              }

              return "";
            }

            return "";
          };

          const resetPreview = () => {
            empty.classList.remove("hidden");
            result.classList.add("hidden");

            downloadPng.disabled = true;
            downloadSvg.disabled = true;

            qrReady = false;
            currentPayload = "";
          };

          const generate = async () => {
            const errorMessage = validate();

            if (errorMessage) {
              resetPreview();

              setStatus(
                "error",
                "تحقق من البيانات",
                errorMessage
              );

              return;
            }

            const payload = getPayload();

            if (!payload) {
              resetPreview();

              setStatus(
                "info",
                "جاهز",
                "أدخل محتوى لإنشاء QR Code."
              );

              return;
            }

            try {
              const QRCode = await loadLibrary();

              const selectedSize = Number(size.value);
              const selectedMargin = Number(margin.value);
              const selectedError = errorLevel.value;

              await new Promise((resolve, reject) => {
                QRCode.toCanvas(
                  canvas,
                  payload,
                  {
                    width: selectedSize,
                    margin: selectedMargin,
                    errorCorrectionLevel: selectedError,
                    color: {
                      dark: "#07111f",
                      light: "#ffffff"
                    }
                  },
                  (error) => {
                    if (error) {
                      reject(error);
                    } else {
                      resolve();
                    }
                  }
                );
              });

              currentPayload = payload;
              qrReady = true;

              empty.classList.add("hidden");
              result.classList.remove("hidden");

              downloadPng.disabled = false;
              downloadSvg.disabled = false;

              metaType.textContent = typeNames[currentType];
              metaSize.textContent = selectedSize + "px";
              metaError.textContent = selectedError;

              setStatus(
                "success",
                "تم إنشاء QR Code",
                "الرمز جاهز للنسخ أو التنزيل."
              );
            } catch (error) {
              resetPreview();

              setStatus(
                "error",
                "تعذر إنشاء الرمز",
                "تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت وحاول مرة أخرى."
              );
            }
          };

          const updateCount = () => {
            const value =
              currentType === "wifi"
                ? getRawValue()
                : content.value;

            count.textContent =
              String(value.length) + " حرف";
          };

          const switchType = (type) => {
            currentType = type;

            typeCards.forEach((card) => {
              card.classList.toggle(
                "active",
                card.dataset.type === type
              );
            });

            if (type === "wifi") {
              normalInput.classList.add("hidden");
              wifiInput.classList.remove("hidden");
            } else {
              normalInput.classList.remove("hidden");
              wifiInput.classList.add("hidden");

              const placeholders = {
                text: "اكتب النص أو المحتوى الذي تريد تحويله إلى QR Code...",
                url: "https://example.com",
                email: "hello@example.com",
                phone: "+212600000000"
              };

              content.placeholder =
                placeholders[type] || placeholders.text;
            }

            updateCount();
            generate();
          };

          typeCards.forEach((card) => {
            card.addEventListener("click", () => {
              switchType(card.dataset.type);
            });
          });

          content.addEventListener("input", () => {
            updateCount();
            generate();
          });

          [ssid, password].forEach((input) => {
            input.addEventListener("input", () => {
              updateCount();
              generate();
            });
          });

          [security, hidden, size, margin, errorLevel].forEach(
            (element) => {
              element.addEventListener("change", () => {
                updateCount();
                generate();
              });
            }
          );

          generateButton.addEventListener("click", generate);

          clearButton.addEventListener("click", () => {
            content.value = "";
            ssid.value = "";
            password.value = "";
            security.value = "WPA";
            hidden.checked = false;
            size.value = "280";
            margin.value = "2";
            errorLevel.value = "M";

            switchType("text");

            setStatus(
              "info",
              "تمت إعادة الضبط",
              "يمكنك الآن إدخال محتوى جديد."
            );
          });

          exampleButtons.forEach((button) => {
            button.addEventListener("click", () => {
              const value = button.dataset.example || "";

              const text = value.trim();

              if (
                text.startsWith("http://") ||
                text.startsWith("https://")
              ) {
                switchType("url");
              } else if (
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text)
              ) {
                switchType("email");
              } else {
                switchType("text");
              }

              content.value = text;
              updateCount();
              generate();
            });
          });

          downloadPng.addEventListener("click", () => {
            if (!qrReady) {
              return;
            }

            const link = document.createElement("a");
            link.download = "th-tech-qr-code.png";
            link.href = canvas.toDataURL("image/png");
            link.click();
          });

          downloadSvg.addEventListener("click", async () => {
            if (!qrReady || !currentPayload) {
              return;
            }

            try {
              const QRCode = await loadLibrary();

              QRCode.toString(
                currentPayload,
                {
                  type: "svg",
                  margin: Number(margin.value),
                  errorCorrectionLevel: errorLevel.value,
                  color: {
                    dark: "#07111f",
                    light: "#ffffff"
                  }
                },
                (error, svg) => {
                  if (error) {
                    setStatus(
                      "error",
                      "تعذر تنزيل SVG",
                      "حدث خطأ أثناء إنشاء ملف SVG."
                    );
                    return;
                  }

                  const blob = new Blob(
                    [svg],
                    { type: "image/svg+xml;charset=utf-8" }
                  );

                  const url = URL.createObjectURL(blob);
                  const link = document.createElement("a");

                  link.href = url;
                  link.download = "th-tech-qr-code.svg";

                  document.body.appendChild(link);
                  link.click();
                  link.remove();

                  URL.revokeObjectURL(url);
                }
              );
            } catch (error) {
              setStatus(
                "error",
                "تعذر تنزيل SVG",
                "تحقق من اتصال الإنترنت وحاول مرة أخرى."
              );
            }
          });

          copyContent.addEventListener("click", async () => {
            const rawValue = getRawValue();

            if (!rawValue) {
              setStatus(
                "error",
                "لا يوجد محتوى",
                "أدخل محتوى أولًا لنسخه."
              );
              return;
            }

            try {
              await navigator.clipboard.writeText(rawValue);

              copyContent.innerHTML =
                '<i class="fa-solid fa-check"></i> تم النسخ';

              setStatus(
                "success",
                "تم النسخ",
                "تم نسخ محتوى QR Code إلى الحافظة."
              );

              window.setTimeout(() => {
                copyContent.innerHTML =
                  '<i class="fa-regular fa-copy"></i> نسخ المحتوى';
              }, 1600);
            } catch (error) {
              setStatus(
                "error",
                "تعذر النسخ",
                "المتصفح لم يسمح بالوصول إلى الحافظة."
              );
            }
          });

          updateCount();

          setStatus(
            "info",
            "جاهز",
            "أدخل محتوى لإنشاء QR Code."
          );
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start);
        } else {
          start();
        }
      })();
    </script>
  </body>
</html>
