---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'QR Code Generator - مولد QR Code احترافي ومجاني | Th.Tech';
const description =
  'أنشئ QR Code احترافيًا للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi مع معاينة فورية وتنزيل PNG وSVG.';

const canonical = `https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`;

const faqs = [
  {
    q: 'ما هو QR Code Generator؟',
    a: 'أداة مجانية لإنشاء رموز QR من النصوص والروابط والبريد الإلكتروني وأرقام الهاتف وشبكات Wi-Fi مباشرة داخل المتصفح.'
  },
  {
    q: 'هل يتم إرسال البيانات إلى الخادم؟',
    a: 'لا. يتم إنشاء رمز QR داخل المتصفح، ولا تحتاج إلى رفع النص أو الرابط إلى خادم خارجي.'
  },
  {
    q: 'هل يمكن تنزيل QR Code كصورة؟',
    a: 'نعم. يمكنك تنزيل الرمز بصيغة PNG أو SVG بجودة مناسبة للاستخدام الرقمي والطباعة.'
  },
  {
    q: 'هل يمكن إنشاء QR Code لشبكة Wi-Fi؟',
    a: 'نعم. أدخل اسم الشبكة وكلمة المرور ونوع الحماية، وستنشئ الأداة رمز Wi-Fi جاهزًا للمسح.'
  },
  {
    q: 'ما مستوى تصحيح الأخطاء الأفضل؟',
    a: 'M مناسب للاستخدام العام، بينما Q وH يوفران قدرة أكبر على تحمل التلف أو التشويش عند الطباعة.'
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08111f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.classList.remove('dark-mode');
        } else {
          document.documentElement.classList.add('dark-mode');
        }
      } catch (error) {
        document.documentElement.classList.add('dark-mode');
      }
    </script>
  </head>

  <body>
    <Header />

    <main class="tool-page">

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>
              <i class="fa-solid fa-house"></i>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <span>QR Code Generator</span>
          </div>

          <div class="hero-content">

            <div class="hero-icon">
              <i class="fa-solid fa-qrcode"></i>
            </div>

            <div class="hero-text">
              <div class="eyebrow">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                GENERATOR TOOL
              </div>

              <h1>QR Code Generator</h1>

              <p>
                أنشئ رمز QR احترافيًا للنصوص والروابط والبريد الإلكتروني
                والهاتف وشبكات Wi-Fi مع معاينة فورية.
              </p>

              <div class="hero-tags">
                <span>
                  <i class="fa-solid fa-bolt"></i>
                  فوري
                </span>

                <span>
                  <i class="fa-solid fa-download"></i>
                  PNG
                </span>

                <span>
                  <i class="fa-solid fa-code"></i>
                  SVG
                </span>

                <span>
                  <i class="fa-solid fa-shield-halved"></i>
                  محلي
                </span>
              </div>
            </div>

          </div>
        </div>
      </section>


      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">

          <div class="tool-card">

            <!-- TOOL HEADER -->
            <div class="tool-header">

              <div class="tool-brand">
                <div class="brand-icon">
                  <i class="fa-solid fa-qrcode"></i>
                </div>

                <div>
                  <h2>مولد QR Code</h2>
                  <p>أنشئ رمزك خلال ثوانٍ</p>
                </div>
              </div>

              <div class="privacy-badge">
                <span class="online-dot"></span>
                يعمل داخل المتصفح
              </div>

            </div>


            <!-- CONTENT -->
            <div class="workspace">

              <!-- LEFT -->
              <div class="editor-panel">

                <div class="section-title">
                  <div class="section-number">01</div>

                  <div>
                    <h3>المحتوى</h3>
                    <p>اختر نوع البيانات وأدخل المحتوى</p>
                  </div>
                </div>


                <!-- TYPES -->
                <div class="type-grid">

                  <button class="type-card active" type="button" data-type="text">
                    <span class="type-icon">
                      <i class="fa-solid fa-align-left"></i>
                    </span>
                    <span class="type-info">
                      <strong>نص</strong>
                      <small>Text</small>
                    </span>
                  </button>

                  <button class="type-card" type="button" data-type="url">
                    <span class="type-icon">
                      <i class="fa-solid fa-link"></i>
                    </span>
                    <span class="type-info">
                      <strong>رابط</strong>
                      <small>URL</small>
                    </span>
                  </button>

                  <button class="type-card" type="button" data-type="email">
                    <span class="type-icon">
                      <i class="fa-solid fa-envelope"></i>
                    </span>
                    <span class="type-info">
                      <strong>بريد</strong>
                      <small>Email</small>
                    </span>
                  </button>

                  <button class="type-card" type="button" data-type="phone">
                    <span class="type-icon">
                      <i class="fa-solid fa-phone"></i>
                    </span>
                    <span class="type-info">
                      <strong>هاتف</strong>
                      <small>Phone</small>
                    </span>
                  </button>

                  <button class="type-card" type="button" data-type="wifi">
                    <span class="type-icon">
                      <i class="fa-solid fa-wifi"></i>
                    </span>
                    <span class="type-info">
                      <strong>Wi-Fi</strong>
                      <small>Network</small>
                    </span>
                  </button>

                </div>


                <!-- NORMAL INPUT -->
                <div id="normal-input" class="input-area">

                  <label for="qr-content">
                    <span>
                      <i class="fa-solid fa-pen"></i>
                      المحتوى
                    </span>

                    <span id="content-count">0 حرف</span>
                  </label>

                  <textarea
                    id="qr-content"
                    rows="6"
                    placeholder="اكتب النص أو المحتوى الذي تريد تحويله إلى QR Code..."
                    spellcheck="false"
                  ></textarea>

                  <div class="field-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    سيتم إنشاء الرمز تلقائيًا أثناء الكتابة.
                  </div>

                </div>


                <!-- WIFI -->
                <div id="wifi-input" class="wifi-area hidden">

                  <div class="field">

                    <label for="wifi-ssid">
                      <i class="fa-solid fa-wifi"></i>
                      اسم الشبكة
                    </label>

                    <input
                      id="wifi-ssid"
                      type="text"
                      placeholder="اسم شبكة Wi-Fi"
                      autocomplete="off"
                    />

                  </div>

                  <div class="field">

                    <label for="wifi-password">
                      <i class="fa-solid fa-key"></i>
                      كلمة المرور
                    </label>

                    <input
                      id="wifi-password"
                      type="text"
                      placeholder="كلمة مرور الشبكة"
                      autocomplete="off"
                    />

                  </div>

                  <div class="field">

                    <label for="wifi-security">
                      <i class="fa-solid fa-shield-halved"></i>
                      نوع الحماية
                    </label>

                    <select id="wifi-security">
                      <option value="WPA">WPA / WPA2 / WPA3</option>
                      <option value="WEP">WEP</option>
                      <option value="nopass">بدون كلمة مرور</option>
                    </select>

                  </div>

                  <label class="checkbox-row">
                    <input id="wifi-hidden" type="checkbox" />
                    <span class="checkmark"></span>
                    <span>الشبكة مخفية</span>
                  </label>

                </div>


                <!-- SETTINGS -->
                <div class="settings-box">

                  <div class="settings-title">
                    <i class="fa-solid fa-sliders"></i>
                    إعدادات QR Code
                  </div>

                  <div class="settings-grid">

                    <div class="field">
                      <label for="qr-size">
                        حجم الرمز
                      </label>

                      <select id="qr-size">
                        <option value="180">180 × 180</option>
                        <option value="220">220 × 220</option>
                        <option value="280" selected>280 × 280</option>
                        <option value="360">360 × 360</option>
                        <option value="500">500 × 500</option>
                      </select>
                    </div>

                    <div class="field">
                      <label for="qr-margin">
                        الهامش
                      </label>

                      <select id="qr-margin">
                        <option value="1">صغير</option>
                        <option value="2" selected>متوسط</option>
                        <option value="4">كبير</option>
                        <option value="6">كبير جدًا</option>
                      </select>
                    </div>

                    <div class="field">
                      <label for="qr-error">
                        تصحيح الأخطاء
                      </label>

                      <select id="qr-error">
                        <option value="L">L — منخفض</option>
                        <option value="M" selected>M — متوسط</option>
                        <option value="Q">Q — مرتفع</option>
                        <option value="H">H — أعلى</option>
                      </select>
                    </div>

                  </div>

                </div>


                <!-- EXAMPLES -->
                <div class="examples">

                  <div class="examples-head">
                    <span>
                      <i class="fa-solid fa-lightbulb"></i>
                      أمثلة سريعة
                    </span>
                  </div>

                  <div class="example-buttons">

                    <button type="button" data-example="Th.Tech — أدوات تقنية مجانية">
                      نص
                    </button>

                    <button
                      type="button"
                      data-example="https://oumaystore-hub.github.io/Th-tech/"
                    >
                      رابط
                    </button>

                    <button
                      type="button"
                      data-example="hello@example.com"
                    >
                      بريد
                    </button>

                  </div>

                </div>


                <!-- ACTIONS -->
                <div class="action-bar">

                  <button id="generate-btn" class="primary-btn" type="button">
                    <i class="fa-solid fa-qrcode"></i>
                    إنشاء QR Code
                  </button>

                  <button id="clear-btn" class="secondary-btn" type="button">
                    <i class="fa-solid fa-rotate-left"></i>
                    إعادة ضبط
                  </button>

                </div>

              </div>


              <!-- RIGHT -->
              <div class="preview-panel">

                <div class="section-title">
                  <div class="section-number">02</div>

                  <div>
                    <h3>المعاينة</h3>
                    <p>شاهد النتيجة وحمّل الرمز</p>
                  </div>
                </div>


                <!-- PREVIEW -->
                <div class="qr-stage">

                  <div id="qr-empty" class="qr-empty">

                    <div class="empty-icon">
                      <i class="fa-solid fa-qrcode"></i>
                    </div>

                    <h3>QR Code سيظهر هنا</h3>

                    <p>
                      أدخل المحتوى في الجهة المقابلة لبدء إنشاء الرمز.
                    </p>

                  </div>

                  <div id="qr-result" class="qr-result hidden">

                    <div class="qr-paper">
                      <canvas id="qr-canvas"></canvas>
                    </div>

                    <div class="qr-ready">
                      <i class="fa-solid fa-circle-check"></i>
                      QR Code جاهز
                    </div>

                  </div>

                </div>


                <!-- META -->
                <div class="qr-meta">

                  <div class="meta-item">
                    <span>النوع</span>
                    <strong id="meta-type">نص</strong>
                  </div>

                  <div class="meta-item">
                    <span>الحجم</span>
                    <strong id="meta-size">280px</strong>
                  </div>

                  <div class="meta-item">
                    <span>التصحيح</span>
                    <strong id="meta-error">M</strong>
                  </div>

                </div>


                <!-- DOWNLOAD -->
                <div class="download-actions">

                  <button id="download-png" class="download-btn primary-download" type="button" disabled>
                    <i class="fa-solid fa-image"></i>

                    <span>
                      <strong>تنزيل PNG</strong>
                      <small>صورة عالية الجودة</small>
                    </span>
                  </button>

                  <button id="download-svg" class="download-btn" type="button" disabled>
                    <i class="fa-solid fa-file-code"></i>

                    <span>
                      <strong>تنزيل SVG</strong>
                      <small>جودة قابلة للتكبير</small>
                    </span>
                  </button>

                </div>


                <button id="copy-content" class="copy-content" type="button">
                  <i class="fa-regular fa-copy"></i>
                  نسخ المحتوى
                </button>

              </div>

            </div>


            <!-- STATUS -->
            <div id="status-box" class="status-box info">

              <div class="status-icon">
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div>
                <strong id="status-title">جاهز</strong>
                <span id="status-text">
                  أدخل محتوى لإنشاء QR Code.
                </span>
              </div>

            </div>

          </div>


          <!-- FEATURES -->
          <div class="features-grid">

            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>توليد فوري</h3>

              <p>
                يتحدث QR Code مباشرة أثناء إدخال المحتوى دون الحاجة إلى إعادة تحميل الصفحة.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3>خصوصية أفضل</h3>

              <p>
                تتم معالجة المحتوى داخل المتصفح ولا تحتاج إلى إرسال بياناتك إلى خادم.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-download"></i>
              </div>

              <h3>PNG و SVG</h3>

              <p>
                نزّل الرمز كصورة PNG أو SVG حسب احتياجاتك الرقمية أو الطباعية.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-wifi"></i>
              </div>

              <h3>Wi-Fi جاهز</h3>

              <p>
                أنشئ QR Code لشبكة Wi-Fi ليتمكن الآخرون من الاتصال بسهولة.
              </p>
            </article>

          </div>


          <!-- HOW TO -->
          <section class="info-section">

            <div class="info-heading">
              <span class="info-number">01</span>

              <div>
                <span class="section-label">HOW IT WORKS</span>
                <h2>كيفية إنشاء QR Code؟</h2>
              </div>
            </div>

            <div class="steps-grid">

              <div class="step-card">
                <span class="step-number">1</span>

                <div>
                  <h3>اختر النوع</h3>
                  <p>
                    اختر نصًا أو رابطًا أو بريدًا إلكترونيًا أو هاتفًا أو Wi-Fi.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <span class="step-number">2</span>

                <div>
                  <h3>أدخل البيانات</h3>
                  <p>
                    اكتب المحتوى وسيتم إنشاء QR Code تلقائيًا.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <span class="step-number">3</span>

                <div>
                  <h3>نزّل الرمز</h3>
                  <p>
                    اختر PNG أو SVG واحفظ الرمز على جهازك.
                  </p>
                </div>
              </div>

            </div>

          </section>


          <!-- FAQ -->
          <section class="faq-section">

            <div class="faq-heading">
              <span class="section-label">FAQ</span>
              <h2>الأسئلة الشائعة</h2>
            </div>

            <div class="faq-list">

              {
                faqs.map((faq, index) => (
                  <details class="faq-item" open={index === 0}>
                    <summary>
                      <span>{faq.q}</span>

                      <i class="fa-solid fa-chevron-down"></i>
                    </summary>

                    <div class="faq-answer">
                      {faq.a}
                    </div>
                  </details>
                ))
              }

            </div>

          </section>

        </div>
      </section>

    </main>

    <Footer />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: #07111f;
        color: #e7f0fa;
        font-size: 15px;
      }

      :global(button),
      :global(input),
      :global(textarea),
      :global(select) {
        font-family: inherit;
      }

      :global(button) {
        cursor: pointer;
      }

      :global(a) {
        text-decoration: none;
      }

      .tool-page {
        min-height: 100vh;
        background:
          radial-gradient(circle at 10% 5%, rgba(14, 165, 233, 0.10), transparent 30%),
          radial-gradient(circle at 90% 15%, rgba(6, 182, 212, 0.08), transparent 28%),
          #07111f;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* HERO */

      .hero {
        padding: 42px 0 32px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 30px;
        color: #8ea5ba;
        font-size: 13px;
        flex-wrap: wrap;
      }

      .breadcrumb a {
        color: #9bb1c6;
        transition: 0.2s;
      }

      .breadcrumb a:hover {
        color: #38bdf8;
      }

      .separator {
        font-size: 10px;
        color: #52687b;
      }

      .hero-content {
        display: flex;
        align-items: center;
        gap: 26px;
      }

      .hero-icon {
        flex: 0 0 88px;
        width: 88px;
        height: 88px;
        display: grid;
        place-items: center;
        border-radius: 24px;
        color: #38bdf8;
        font-size: 40px;
        background:
          linear-gradient(145deg, rgba(14, 165, 233, 0.22), rgba(8, 47, 73, 0.72));
        border: 1px solid rgba(56, 189, 248, 0.28);
        box-shadow:
          0 18px 45px rgba(0, 0, 0, 0.22),
          inset 0 0 25px rgba(56, 189, 248, 0.05);
      }

      .hero-text {
        min-width: 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #38bdf8;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(34px, 5vw, 48px);
        line-height: 1.15;
        color: #f8fbff;
        font-weight: 800;
      }

      .hero p {
        max-width: 760px;
        margin: 12px 0 18px;
        color: #a8bbcd;
        line-height: 1.9;
        font-size: 16px;
      }

      .hero-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .hero-tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        color: #b8d7eb;
        background: rgba(14, 165, 233, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.14);
        font-size: 12px;
      }

      .hero-tags i {
        color: #38bdf8;
      }

      /* TOOL CARD */

      .tool-card {
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        background: rgba(11, 25, 42, 0.88);
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.22);
      }

      .tool-header {
        min-height: 82px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.12);
        background: rgba(255, 255, 255, 0.018);
      }

      .tool-brand {
        display: flex;
        align-items: center;
        gap: 13px;
      }

      .brand-icon {
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        color: #38bdf8;
        background: rgba(14, 165, 233, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.18);
        font-size: 20px;
      }

      .tool-brand h2 {
        margin: 0;
        color: #f1f7fc;
        font-size: 17px;
      }

      .tool-brand p {
        margin: 2px 0 0;
        color: #8197ab;
        font-size: 12px;
      }

      .privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        color: #8fe4b4;
        background: rgba(34, 197, 94, 0.07);
        border: 1px solid rgba(34, 197, 94, 0.14);
        font-size: 12px;
        white-space: nowrap;
      }

      .online-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
