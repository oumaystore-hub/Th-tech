---

import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(//$/, '');

const title = "QR Code Generator - مولد QR Code احترافي ومجاني | Th.Tech";
const description =
"أنشئ QR Code احترافيًا للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi مع معاينة فورية وتنزيل PNG وSVG.";

const faqs = [
{
q: "ما هو QR Code Generator؟",
a: "أداة مجانية لإنشاء رموز QR من النصوص والروابط والبريد الإلكتروني وأرقام الهاتف وبيانات شبكات Wi-Fi مباشرة من المتصفح."
},
{
q: "هل يمكن إنشاء QR Code لرابط موقع؟",
a: "نعم. اختر URL وأدخل الرابط الكامل، وسيتم إنشاء الرمز مباشرة مع التحقق من صحة الرابط."
},
{
q: "هل يتم إرسال البيانات إلى الخادم؟",
a: "لا تتم معالجة المحتوى على خادم Th.Tech. يتم إنشاء QR Code داخل المتصفح بعد تحميل مكتبة التوليد."
},
{
q: "ما الفرق بين مستويات تصحيح الأخطاء؟",
a: "كلما ارتفع المستوى زادت قدرة QR Code على الاستمرار في العمل عند تلف أو تغطية جزء منه، لكن ذلك قد يزيد حجم الرمز وتعقيده."
},
{
q: "ما الصيغ التي يمكن تنزيلها؟",
a: "يمكن تنزيل QR Code بصيغة PNG أو SVG، ويمكن استخدام SVG للطباعة والأحجام الكبيرة."
}
];

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>{title}</title>
<meta name="description" content={description} />

<link
  rel="canonical"
  href={`https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`}
/>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<script is:inline>
  (() => {
    try {
      const theme = localStorage.getItem("theme");

      if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
        document.documentElement.classList.remove("dark-mode");
      } else {
        document.documentElement.classList.add("dark-mode");
      }
    } catch {}
  })();
</script>

<!-- QR Code engine must load BEFORE the application script -->
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  </head>  <body>
    <Header /><main>
  <section class="hero">
    <div class="container">
      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>QR Code Generator</span>
      </div>

      <div class="hero-layout">
        <div class="hero-icon">
          <i class="fa-solid fa-qrcode"></i>
        </div>

        <div class="hero-content">
          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            GENERATOR TOOL
          </div>

          <h1>QR Code Generator</h1>

          <p>
            أنشئ رمز QR احترافيًا خلال ثوانٍ للنصوص والروابط والبريد
            الإلكتروني والهاتف وشبكات Wi-Fi مع معاينة مباشرة وتنزيل
            بجودة عالية.
          </p>

          <div class="hero-tags">
            <span>QR Code</span>
            <span>PNG</span>
            <span>SVG</span>
            <span>Wi-Fi</span>
            <span>Local Processing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="workspace-section">
    <div class="container">
      <div class="workspace">
        <div class="workspace-head">
          <div class="brand-tool">
            <div class="mini-icon">
              <i class="fa-solid fa-qrcode"></i>
            </div>

            <div>
              <strong>QR Code Generator</strong>
              <span>Professional QR Creator</span>
            </div>
          </div>

          <div class="privacy">
            <i class="fa-solid fa-shield-halved"></i>
            <span>يعمل داخل المتصفح</span>
          </div>
        </div>

        <div class="toolbar">
          <button class="tool-button" id="exampleBtn">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            مثال
          </button>

          <button class="tool-button" id="clearBtn">
            <i class="fa-solid fa-eraser"></i>
            مسح
          </button>

          <button class="tool-button" id="copyTextBtn">
            <i class="fa-regular fa-copy"></i>
            نسخ
          </button>

          <div class="toolbar-spacer"></div>

          <button class="download-button" id="downloadPngBtn">
            <i class="fa-solid fa-download"></i>
            PNG
          </button>

          <button class="download-button secondary" id="downloadSvgBtn">
            <i class="fa-solid fa-vector-square"></i>
            SVG
          </button>
        </div>

        <div class="workspace-grid">
          <!-- INPUT -->
          <section class="editor-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-number">01</span>

                <div>
                  <strong>المحتوى</strong>
                  <small>اختر نوع البيانات وأدخل المحتوى</small>
                </div>
              </div>

              <span class="live-badge">
                <span></span>
                LIVE
              </span>
            </div>

            <div class="type-grid">
              <button class="type-card active" data-type="text">
                <i class="fa-solid fa-align-left"></i>
                <span>نص</span>
              </button>

              <button class="type-card" data-type="url">
                <i class="fa-solid fa-link"></i>
                <span>رابط</span>
              </button>

              <button class="type-card" data-type="email">
                <i class="fa-solid fa-envelope"></i>
                <span>Email</span>
              </button>

              <button class="type-card" data-type="phone">
                <i class="fa-solid fa-phone"></i>
                <span>هاتف</span>
              </button>

              <button class="type-card" data-type="wifi">
                <i class="fa-solid fa-wifi"></i>
                <span>Wi-Fi</span>
              </button>
            </div>

            <div id="normalFields">
              <div class="field">
                <div class="field-label">
                  <label for="mainInput" id="mainLabel">
                    النص
                  </label>

                  <span id="charCounter">0 حرف</span>
                </div>

                <textarea
                  id="mainInput"
                  rows="8"
                  spellcheck="false"
                  placeholder="اكتب النص الذي تريد تحويله إلى QR Code..."
                ></textarea>

                <div class="field-help" id="fieldHelp">
                  يمكنك إدخال نص عادي أو أي معلومات تريد مشاركتها.
                </div>
              </div>
            </div>

            <div class="wifi-fields" id="wifiFields">
              <div class="field">
                <div class="field-label">
                  <label for="wifiName">اسم الشبكة</label>
                </div>

                <input
                  id="wifiName"
                  type="text"
                  placeholder="My WiFi"
                  autocomplete="off"
                />
              </div>

              <div class="field">
                <div class="field-label">
                  <label for="wifiPassword">كلمة المرور</label>
                </div>

                <input
                  id="wifiPassword"
                  type="text"
                  placeholder="Password"
                  autocomplete="off"
                />
              </div>

              <div class="field">
                <div class="field-label">
                  <label for="wifiSecurity">الحماية</label>
                </div>

                <select id="wifiSecurity">
                  <option value="WPA">WPA / WPA2 / WPA3</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">بدون كلمة مرور</option>
                </select>
              </div>
            </div>

            <div class="settings-box">
              <div class="settings-title">
                <i class="fa-solid fa-sliders"></i>
                إعدادات QR Code
              </div>

              <div class="settings-grid">
                <div class="field compact">
                  <label for="qrSize">الحجم</label>

                  <select id="qrSize">
                    <option value="200">200 × 200</option>
                    <option value="300" selected>300 × 300</option>
                    <option value="400">400 × 400</option>
                    <option value="500">500 × 500</option>
                    <option value="600">600 × 600</option>
                  </select>
                </div>

                <div class="field compact">
                  <label for="qrMargin">الهامش</label>

                  <select id="qrMargin">
                    <option value="1">صغير</option>
                    <option value="2" selected>متوسط</option>
                    <option value="4">كبير</option>
                    <option value="6">واسع</option>
                  </select>
                </div>

                <div class="field compact">
                  <label for="qrError">تصحيح الأخطاء</label>

                  <select id="qrError">
                    <option value="L">L — 7%</option>
                    <option value="M" selected>M — 15%</option>
                    <option value="Q">Q — 25%</option>
                    <option value="H">H — 30%</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="quick-section">
              <div class="quick-title">
                <i class="fa-solid fa-bolt"></i>
                أمثلة سريعة
              </div>

              <div class="quick-buttons">
                <button data-example="url">موقع</button>
                <button data-example="text">نص</button>
                <button data-example="email">Email</button>
                <button data-example="phone">هاتف</button>
                <button data-example="wifi">Wi-Fi</button>
              </div>
            </div>
          </section>

          <!-- PREVIEW -->
          <section class="preview-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-number">02</span>

                <div>
                  <strong>المعاينة</strong>
                  <small>QR Code الناتج</small>
                </div>
              </div>

              <div class="status-pill" id="statusPill">
                <span></span>
                جاهز
              </div>
            </div>

            <div class="qr-stage" id="qrStage">
              <div class="qr-paper">
                <canvas id="qrCanvas"></canvas>

                <div class="empty-state" id="emptyState">
                  <div class="empty-icon">
                    <i class="fa-solid fa-qrcode"></i>
                  </div>

                  <strong>ابدأ بكتابة المحتوى</strong>

                  <span>
                    سيظهر QR Code هنا تلقائيًا
                  </span>
                </div>
              </div>
            </div>

            <div class="preview-meta">
              <div>
                <span>النوع</span>
                <strong id="metaType">TEXT</strong>
              </div>

              <div>
                <span>الحجم</span>
                <strong id="metaSize">300px</strong>
              </div>

              <div>
                <span>التصحيح</span>
                <strong id="metaError">M</strong>
              </div>
            </div>

            <div class="preview-actions">
              <button class="main-download" id="mainPngBtn">
                <i class="fa-solid fa-download"></i>
                تنزيل PNG
              </button>

              <button class="outline-download" id="mainSvgBtn">
                <i class="fa-solid fa-vector-square"></i>
                تنزيل SVG
              </button>
            </div>

            <div class="status-message" id="statusMessage">
              <div class="status-message-icon">
                <i class="fa-solid fa-circle-check"></i>
              </div>

              <div>
                <strong id="statusTitle">جاهز</strong>
                <span id="statusText">
                  أدخل المحتوى لإنشاء QR Code.
                </span>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="features-section">
    <div class="container">
      <div class="section-heading">
        <span>FEATURES</span>
        <h2>كل ما تحتاجه لإنشاء QR Code</h2>
