                <button data-example="url">موقع</button>
                <button data-example="text">نص</button>
                <button data-example="email">بريد</button>
                <button data-example="phone">هاتف</button>
                <button data-example="wifi">Wi-Fi</button>

              </div>
            </div>

          </div>

          <!-- RIGHT -->
          <div class="preview-area">

            <div class="section-title">

              <div class="section-number">02</div>

              <div>
                <h3>المعاينة</h3>
                <p>QR Code الناتج</p>
              </div>

              <div class="ready" id="status">
                <span></span>
                جاهز
