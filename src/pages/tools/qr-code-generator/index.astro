              </button>

              <button class="secondary-download" id="mainSvg">
                <i class="fa-solid fa-vector-square"></i>
                تنزيل SVG
              </button>

            </div>

            <!-- MESSAGE -->
            <div class="message" id="message">

              <div class="message-icon">
                <i class="fa-solid fa-circle-check"></i>
              </div>

              <div>
                <strong id="messageTitle">جاهز</strong>

                <p id="messageText">
