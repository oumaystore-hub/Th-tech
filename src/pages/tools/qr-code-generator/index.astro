                    أدخل المحتوى ليظهر الرمز هنا
                  </span>

                </div>

              </div>

            </div>

            <!-- META -->
            <div class="meta">

              <div>
                <span>النوع</span>
                <strong id="metaType">TEXT</strong>
              </div>

              <div>
                <span>الحجم</span>
                <strong id="metaSize">300px</strong>
              </div>

              <div>
                <span>التصحيح</span>
                <strong id="metaError">M</strong>
              </div>

            </div>

            <!-- DOWNLOAD -->
            <div class="download-grid">

              <button class="primary-download" id="mainPng">
                <i class="fa-solid fa-download"></i>
