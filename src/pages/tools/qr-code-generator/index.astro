</main>

<Footer />

<script>
  const mainInput = document.getElementById('mainInput');
  const inputLabel = document.getElementById('inputLabel');
  const inputHint = document.getElementById('inputHint');
  const counter = document.getElementById('counter');

  const normalInput = document.getElementById('normalInput');
  const wifiBox = document.getElementById('wifiBox');

  const wifiName = document.getElementById('wifiName');
  const wifiPassword = document.getElementById('wifiPassword');
  const wifiSecurity = document.getElementById('wifiSecurity');

  const size = document.getElementById('size');
  const margin = document.getElementById('margin');
  const errorLevel = document.getElementById('errorLevel');

  const canvas = document.getElementById('qrCanvas');
  const empty = document.getElementById('empty');

  const status = document.getElementById('status');
  const message = document.getElementById('message');
  const messageTitle = document.getElementById('messageTitle');
  const messageText = document.getElementById('messageText');

  const metaType = document.getElementById('metaType');
  const metaSize = document.getElementById('metaSize');
  const metaError = document.getElementById('metaError');

  const typeButtons = document.querySelectorAll('.type-btn');
  const exampleButtons = document.querySelectorAll('[data-example]');

  let currentType = 'text';
  let currentPayload = '';

  const labels = {
    text: {
      label: 'النص',
      placeholder: 'اكتب النص الذي تريد تحويله إلى QR Code...',
      hint: 'يمكنك إدخال أي نص تريد مشاركته.'
    },
    url: {
      label: 'رابط URL',
      placeholder: 'https://example.com',
      hint: 'أدخل رابطًا يبدأ بـ http:// أو https://.'
    },
    email: {
      label: 'البريد الإلكتروني',
      placeholder: 'hello@example.com',
      hint: 'أدخل عنوان بريد إلكتروني صالحًا.'
    },
    phone: {
      label: 'رقم الهاتف',
      placeholder: '+212600000000',
      hint: 'يمكنك استخدام رقم دولي مثل +212600000000.'
    }
  };

  function setMessage(type, title, text) {
    message.className = 'message ' + type;
    status.className = 'ready ' + type;

    messageTitle.textContent = title;
    messageText.textContent = text;

    if (type === 'success') {
      status.innerHTML = '<span></span>جاهز';
    } else if (type === 'error') {
      status.innerHTML = '<span></span>خطأ';
    } else {
      status.innerHTML = '<span></span>جاهز';
    }
  }

  function getPayload() {
    if (currentType === 'wifi') {
      const ssid = wifiName.value.trim();
      const password = wifiPassword.value;

      if (!ssid) return '';

      const security = wifiSecurity.value;

      const safeSsid = ssid
        .replace(/\\/g, '\\\\')
        .replace(/;/g, '\\;')
        .replace(/,/g, '\\,')
        .replace(/:/g, '\\:');

      const safePassword = password
        .replace(/\\/g, '\\\\')
        .replace(/;/g, '\\;')
        .replace(/,/g, '\\,')
        .replace(/:/g, '\\:');

      return 'WIFI:T:' + security + ';S:' + safeSsid + ';P:' + safePassword + ';;';
    }

    return mainInput.value.trim();
  }

  function validate(payload) {
    if (!payload) {
      return {
        valid: false,
        message: 'أدخل المحتوى أولاً.'
      };
    }

    if (currentType === 'url') {
      try {
        const url = new URL(payload);

        if (
          url.protocol !== 'http:' &&
          url.protocol !== 'https:'
        ) {
          return {
            valid: false,
            message: 'الرابط يجب أن يبدأ بـ http:// أو https://.'
          };
        }
      } catch {
        return {
          valid: false,
          message: 'الرابط المدخل غير صالح.'
        };
      }
    }

    if (currentType === 'email') {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      if (!emailRegex.test(payload)) {
        return {
          valid: false,
          message: 'أدخل بريدًا إلكترونيًا صحيحًا.'
        };
      }
    }

    if (currentType === 'phone') {
      const phone = payload.replace(/[\s\-().]/g, '');

      if (!/^\+?[0-9]{6,18}$/.test(phone)) {
        return {
          valid: false,
          message: 'رقم الهاتف غير صالح.'
        };
      }
    }

    return {
      valid: true,
      message: ''
    };
  }

  function typeName() {
    const names = {
      text: 'TEXT',
      url: 'URL',
      email: 'EMAIL',
      phone: 'PHONE',
      wifi: 'WI-FI'
    };

    return names[currentType];
  }

  function updateType() {
    typeButtons.forEach((button) => {
      button.classList.toggle(
        'active',
        button.dataset.type === currentType
      );
    });

    if (currentType === 'wifi') {
      normalInput.style.display = 'none';
      wifiBox.style.display = 'grid';
    } else {
      normalInput.style.display = 'block';
      wifiBox.style.display = 'none';

      inputLabel.textContent = labels[currentType].label;
      mainInput.placeholder = labels[currentType].placeholder;
      inputHint.textContent = labels[currentType].hint;
    }

    generate();
  }

  function generate() {
    const payload = getPayload();

    currentPayload = payload;

    const outputSize = Number(size.value);
    const outputMargin = Number(margin.value);
    const outputError = errorLevel.value;

    metaType.textContent = typeName();
    metaSize.textContent = outputSize + 'px';
    metaError.textContent = outputError;

    counter.textContent =
      payload.length.toLocaleString('ar-MA') + ' حرف';

    if (!payload) {
      canvas.style.display = 'none';
      empty.style.display = 'flex';

      setMessage(
        'ready',
        'جاهز',
        'أدخل المحتوى لإنشاء QR Code.'
      );

      return;
    }

    const result = validate(payload);

    if (!result.valid) {
      canvas.style.display = 'none';
      empty.style.display = 'flex';

      setMessage(
        'error',
        'بيانات غير صالحة',
        result.message
      );

      return;
    }

    if (
      !window.QRCode ||
      typeof window.QRCode.toCanvas !== 'function'
    ) {
      setMessage(
        'error',
        'المكتبة غير متاحة',
        'تعذر تحميل محرك QR Code. أعد تحميل الصفحة.'
      );

      return;
    }

    window.QRCode.toCanvas(
      canvas,
      payload,
      {
        width: outputSize,
        margin: outputMargin,
        errorCorrectionLevel: outputError,
        color: {
          dark: '#071b24',
          light: '#ffffff'
        }
      },
      function (error) {
        if (error) {
          canvas.style.display = 'none';
          empty.style.display = 'flex';

          setMessage(
            'error',
            'تعذر إنشاء QR Code',
            'المحتوى كبير جدًا أو غير صالح.'
          );

          return;
        }

        empty.style.display = 'none';
        canvas.style.display = 'block';

        setMessage(
          'success',
          'تم الإنشاء',
          'QR Code جاهز للتنزيل.'
        );
      }
    );
  }

  function downloadPng() {
    if (!currentPayload) {
      generate();
      return;
    }

    if (canvas.style.display === 'none') {
      return;
    }

    const link = document.createElement('a');

    link.download = 'th-tech-qr-code.png';
    link.href = canvas.toDataURL('image/png');

    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  function downloadSvg() {
    if (!currentPayload) {
      setMessage(
        'error',
        'لا يوجد QR Code',
        'أدخل المحتوى أولاً.'
      );

      return;
    }

    if (
      !window.QRCode ||
      typeof window.QRCode.toString !== 'function'
    ) {
      return;
    }

    window.QRCode.toString(
      currentPayload,
      {
        type: 'svg',
        margin: Number(margin.value),
        errorCorrectionLevel: errorLevel.value,
        color: {
          dark: '#071b24',
          light: '#ffffff'
        }
      },
      function (error, svg) {
        if (error) {
          setMessage(
            'error',
            'تعذر إنشاء SVG',
            'حدث خطأ أثناء إنشاء ملف SVG.'
          );

          return;
        }

        const blob = new Blob(
          [svg],
          { type: 'image/svg+xml;charset=utf-8' }
        );

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = 'th-tech-qr-code.svg';

        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);
      }
    );
  }

  async function copyContent() {
    const payload = getPayload();

    if (!payload) {
      setMessage(
        'error',
        'لا يوجد محتوى',
        'أدخل المحتوى أولاً.'
      );

      return;
    }

    try {
      await navigator.clipboard.writeText(payload);

      setMessage(
        'success',
        'تم النسخ',
        'تم نسخ محتوى QR Code.'
      );
    } catch {
      setMessage(
        'error',
        'تعذر النسخ',
        'المتصفح لم يسمح بالوصول إلى الحافظة.'
      );
    }
  }

  function loadExample(type) {
    currentType = type;

    if (type === 'text') {
      mainInput.value =
        'مرحباً بك في Th.Tech - منصة تقنية مجانية.';
    }

    if (type === 'url') {
      mainInput.value =
        'https://oumaystore-hub.github.io/Th-tech/';
    }

    if (type === 'email') {
      mainInput.value = 'hello@example.com';
    }

    if (type === 'phone') {
      mainInput.value = '+212600000000';
    }

    if (type === 'wifi') {
      wifiName.value = 'Th-Tech WiFi';
      wifiPassword.value = 'ThTech2026';
      wifiSecurity.value = 'WPA';
    }

    updateType();
  }

  function clearAll() {
    currentType = 'text';

    mainInput.value = '';
    wifiName.value = '';
    wifiPassword.value = '';
    wifiSecurity.value = 'WPA';

    size.value = '300';
    margin.value = '2';
    errorLevel.value = 'M';

    currentPayload = '';

    updateType();

    setMessage(
      'ready',
      'جاهز',
      'أدخل المحتوى لإنشاء QR Code.'
    );
  }

  typeButtons.forEach((button) => {
    button.addEventListener('click', function () {
      currentType = button.dataset.type;
      updateType();
    });
  });

  exampleButtons.forEach((button) => {
    button.addEventListener('click', function () {
      loadExample(button.dataset.example);
    });
  });

  mainInput.addEventListener('input', generate);
  wifiName.addEventListener('input', generate);
  wifiPassword.addEventListener('input', generate);
  wifiSecurity.addEventListener('change', generate);

  size.addEventListener('change', generate);
  margin.addEventListener('change', generate);
  errorLevel.addEventListener('change', generate);

  document
    .getElementById('exampleBtn')
    .addEventListener('click', function () {
      loadExample('url');
    });

  document
    .getElementById('clearBtn')
    .addEventListener('click', clearAll);

  document
    .getElementById('copyBtn')
    .addEventListener('click', copyContent);

  document
    .getElementById('pngBtn')
    .addEventListener('click', downloadPng);

  document
    .getElementById('mainPng')
    .addEventListener('click', downloadPng);

  document
    .getElementById('svgBtn')
    .addEventListener('click', downloadSvg);

  document
    .getElementById('mainSvg')
    .addEventListener('click', downloadSvg);

  updateType();
</script>

