        color: var(--muted);
        line-height: 1.9;
        font-size: 11px;
      }

      @media (max-width: 1000px) {
        .generator-layout {
          grid-template-columns: 1fr;
        }

        .input-side {
          border-left: 0;
          border-bottom: 1px solid var(--border);
        }

        .preview-side {
          background: var(--surface-2);
        }
      }

      @media (max-width: 900px) {
        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }

        .options-grid {
          grid-template-columns: 1fr 1fr;
        }

        .options-grid .field:last-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 700px) {
        .hero-content {
          align-items: flex-start;
        }

        .hero-icon {
          width: 65px;
          height: 65px;
          flex-basis: 65px;
          border-radius: 18px;
          font-size: 25px;
        }

        .tool-topbar {
          padding: 0 14px;
        }

        .secure {
          display: none;
        }

        .input-side,
        .preview-side,
        .examples {
          padding-inline: 15px;
        }

        .status-box {
          margin-inline: 15px;
        }

        .stats-grid {
          padding-inline: 15px;
        }

        .action-btn.primary {
          margin-right: 0;
        }

        .wifi-fields {
          grid-template-columns: 1fr;
        }

        .wifi-fields .field:last-child {
          grid-column: auto;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero {
          padding-top: 25px;
        }

        .hero-content {
          gap: 14px;
        }

        .hero-icon {
          display: none;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text p {
          font-size: 13px;
        }

        .actionbar {
          padding: 12px 15px;
        }

        .action-btn {
          flex: 1;
          justify-content: center;
        }

        .action-btn.primary {
          flex-basis: 100%;
        }

        .options-grid {
          grid-template-columns: 1fr;
        }

        .options-grid .field:last-child {
          grid-column: auto;
        }

        .qr-preview {
          min-height: 300px;
        }

        .qr-frame {
          max-width: 285px;
        }

        .preview-info,
        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .preview-info > div:last-child {
          grid-column: 1 / -1;
        }

        .example-list {
          overflow-x: auto;
          flex-wrap: nowrap;
          padding-bottom: 4px;
        }

        .example-list button {
          white-space: nowrap;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 55px 0;
        }
      }
    </style>
  </body>
</html>
