  <!-- ====================================================== -->
  <!-- CLIENT LOGIC -->
  <!-- ====================================================== -->

  <script is:inline>
    (function () {

      function init() {

        var qrBox = document.getElementById('qrBox');
        var qrEmpty = document.getElementById('qrEmpty');

        var mainInput = document.getElementById('mainInput');
        var urlInput = document.getElementById('urlInput');

        var emailInput = document.getElementById('emailInput');
        var emailSubject = document.getElementById('emailSubject');
        var emailBody = document.getElementById('emailBody');

        var phoneInput = document.getElementById('phoneInput');

        var wifiName = document.getElementById('wifiName');
        var wifiPassword = document.getElementById('wifiPassword');
        var wifiSecurity = document.getElementById('wifiSecurity');
        var wifiHidden = document.getElementById('wifiHidden');

        var sizeSelect = document.getElementById('sizeSelect');
        var marginSelect = document.getElementById('marginSelect');
        var errorSelect = document.getElementById('errorSelect');

        var generateBtn = document.getElementById('generateBtn');
        var resetBtn = document.getElementById('resetBtn');

        var pngBtn = document.getElementById('pngBtn');
        var svgBtn = document.getElementById('svgBtn');
        var copyBtn = document.getElementById('copyBtn');

        var message = document.getElementById('message');
        var status = document.getElementById('status');

        var inputTitle = document.getElementById('inputTitle');
        var inputHint = document.getElementById('inputHint');

        var previewState = document.getElementById('previewState');
        var dataTypeInfo = document.getElementById('dataTypeInfo');
        var charCount = document.getElementById('charCount');

        var textFields = document.getElementById('textFields');
        var urlFields = document.getElementById('urlFields');
        var emailFields = document.getElementById('emailFields');
        var phoneFields = document.getElementById('phoneFields');
        var wifiFields = document.getElementById('wifiFields');

        var typeButtons =
          document.querySelectorAll('.type');

        var currentType = 'text';
        var currentPayload = '';
        var generated = false;
        var timer = null;


        var names = {
          text: 'نص',
          url: 'رابط',
          email: 'بريد إلكتروني',
          phone: 'هاتف',
          wifi: 'Wi-Fi'
        };


        var titles = {
          text: 'النص',
          url: 'الرابط',
          email: 'البريد الإلكتروني',
          phone: 'رقم الهاتف',
          wifi: 'شبكة Wi-Fi'
        };


        var hints = {
          text: 'اكتب النص الذي تريد تحويله إلى QR Code',
          url: 'أدخل رابط الموقع أو الصفحة',
          email: 'أدخل بيانات البريد الإلكتروني',
          phone: 'أدخل رقم الهاتف',
          wifi: 'أدخل بيانات شبكة Wi-Fi'
        };


        function setStatus(text, working) {

          status.innerHTML =
            '<span></span>' + text;

          status.classList.toggle(
            'working',
            !!working
          );

        }


        function showMessage(text, type) {

          message.textContent = text || '';
          message.className = 'message';

          if (type) {
            message.classList.add(type);
          }

        }


        function clearQR() {

          qrBox.innerHTML = '';

          qrEmpty.style.display = 'flex';

          previewState.textContent =
            'في انتظار البيانات';

          pngBtn.disabled = true;
          svgBtn.disabled = true;
          copyBtn.disabled = true;

          generated = false;

        }


        function showFields() {

          textFields.classList.add('hidden');
          urlFields.classList.add('hidden');
          emailFields.classList.add('hidden');
          phoneFields.classList.add('hidden');
          wifiFields.classList.add('hidden');

          if (currentType === 'text') {
            textFields.classList.remove('hidden');
          }

          if (currentType === 'url') {
            urlFields.classList.remove('hidden');
          }

          if (currentType === 'email') {
            emailFields.classList.remove('hidden');
          }

          if (currentType === 'phone') {
            phoneFields.classList.remove('hidden');
          }

          if (currentType === 'wifi') {
            wifiFields.classList.remove('hidden');
          }

        }


        function escapeWifi(value) {

          var slash =
            String.fromCharCode(92);

          return value
            .split(slash)
            .join(slash + slash)
            .split(';')
            .join(slash + ';')
            .split(',')
            .join(slash + ',')
            .split(':')
            .join(slash + ':');

        }


        function getPayload() {

          if (currentType === 'text') {
            return mainInput.value.trim();
          }


          if (currentType === 'url') {

            var url =
              urlInput.value.trim();

            if (!url) {
              return '';
            }

            try {

              var parsed =
                new URL(url);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {
                return '';
              }

              return url;

            } catch (error) {

              return '';

            }

          }


          if (currentType === 'email') {

            var email =
              emailInput.value.trim();

            if (!email) {
              return '';
            }

            var subject =
              emailSubject.value.trim();

            var body =
              emailBody.value.trim();

            var result =
              'mailto:' + email;

            var params = [];

            if (subject) {

              params.push(
                'subject=' +
                encodeURIComponent(subject)
              );

            }

            if (body) {

              params.push(
                'body=' +
                encodeURIComponent(body)
              );

            }

            if (params.length) {
              result += '?' + params.join('&');
            }

            return result;

          }


          if (currentType === 'phone') {

            var phone =
              phoneInput.value.trim();

            if (!phone) {
              return '';
            }

            return 'tel:' + phone;

          }


          if (currentType === 'wifi') {

            var name =
              wifiName.value.trim();

            if (!name) {
              return '';
            }

            var password =
              wifiPassword.value;

            var security =
              wifiSecurity.value;

            var hidden =
              wifiHidden.checked
                ? 'true'
                : 'false';

            return (
              'WIFI:T:' +
              security +
              ';S:' +
              escapeWifi(name) +
              ';P:' +
              escapeWifi(password) +
              ';H:' +
              hidden +
              ';;'
            );

          }

          return '';

        }


        function validEmail() {

          var email =
            emailInput.value.trim();

          var at =
            email.indexOf('@');

          var dot =
            email.lastIndexOf('.');

          return (
            at > 0 &&
            dot > at + 1 &&
            dot < email.length - 1
          );

        }


        function validate(payload) {

          if (!payload) {

            showMessage(
              'يرجى إدخال البيانات أولاً.',
              'error'
            );

            return false;

          }


          if (currentType === 'url') {

            try {

              var parsed =
                new URL(payload);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {

                showMessage(
                  'يرجى إدخال رابط صحيح.',
                  'error'
                );

                return false;

              }

            } catch (error) {

              showMessage(
                'يرجى إدخال رابط صحيح.',
                'error'
              );

              return false;

            }

          }


          if (
            currentType === 'email' &&
            !validEmail()
          ) {

            showMessage(
              'يرجى إدخال بريد إلكتروني صحيح.',
              'error'
            );

            return false;

          }

          return true;

        }


        function generate() {

          if (
            typeof window.QRCode === 'undefined'
          ) {

            setStatus(
              'المكتبة غير متاحة',
              false
            );

            showMessage(
              'تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت.',
              'error'
            );

            return;

          }


          var payload =
            getPayload();


          if (!validate(payload)) {

            clearQR();

            return;

          }


          currentPayload =
            payload;

          setStatus(
            'جارٍ الإنشاء...',
            true
          );

          previewState.textContent =
            'جارٍ إنشاء الرمز...';

          qrBox.innerHTML =
            '';


          var size =
            parseInt(
              sizeSelect.value,
              10
            );


          try {

            new window.QRCode(
              qrBox,
              {
                text: payload,

                width: size,

                height: size,

                colorDark: '#07111f',

                colorLight: '#ffffff',

                correctLevel:
                  window.QRCode.CorrectLevel[
                    errorSelect.value
                  ]
              }
            );


            setTimeout(
              function () {

                var canvas =
                  qrBox.querySelector(
                    'canvas'
                  );

                var image =
                  qrBox.querySelector(
                    'img'
                  );


                if (!canvas && !image) {

                  setStatus(
                    'خطأ',
                    false
                  );

                  showMessage(
                    'تعذر إنشاء QR Code.',
                    'error'
                  );

                  return;

                }


                qrEmpty.style.display =
                  'none';

                previewState.textContent =
                  'تم إنشاء الرمز';

                dataTypeInfo.textContent =
                  'النوع: ' +
                  names[currentType];

                pngBtn.disabled =
                  false;

                svgBtn.disabled =
                  false;

                copyBtn.disabled =
                  false;

                generated =
                  true;

                setStatus(
                  'جاهز',
                  false
                );

                showMessage(
                  'تم إنشاء QR Code بنجاح.',
                  'success'
                );

              },
              100
            );


          } catch (error) {

            console.error(error);

            clearQR();

            setStatus(
              'خطأ',
              false
            );

            showMessage(
              'حدث خطأ أثناء إنشاء الرمز.',
              'error'
            );

          }

        }


        function autoGenerate() {

          clearTimeout(timer);

          timer =
            setTimeout(
              function () {

                if (getPayload()) {
                  generate();
                }

              },
              220
            );

        }


        function changeType(type) {

          currentType =
            type;

          inputTitle.textContent =
            titles[type];

          inputHint.textContent =
            hints[type];

          dataTypeInfo.textContent =
            'النوع: ' + names[type];

          showFields();

          typeButtons.forEach(
            function (button) {

              button.classList.toggle(
                'active',
                button.dataset.type === type
              );

            }
          );

          clearQR();

          showMessage(
            '',
            ''
          );

          setStatus(
            'جاهز',
            false
          );

        }


        typeButtons.forEach(
          function (button) {

            button.addEventListener(
              'click',
              function () {

                changeType(
                  button.dataset.type
                );

              }
            );

          }
        );


        mainInput.addEventListener(
          'input',
          function () {

            charCount.textContent =
              mainInput.value.length +
              ' حرف';

            autoGenerate();

          }
        );


        [
          urlInput,
          emailInput,
          emailSubject,
          emailBody,
          phoneInput,
          wifiName,
          wifiPassword
        ].forEach(
          function (element) {

            element.addEventListener(
              'input',
              autoGenerate
            );

          }
        );


        [
          wifiSecurity,
          wifiHidden,
          sizeSelect,
          marginSelect,
          errorSelect
        ].forEach(
          function (element) {

            element.addEventListener(
              'change',
              function () {

                if (getPayload()) {
                  generate();
                }

              }
            );

          }
        );


        generateBtn.addEventListener(
          'click',
          generate
        );


        resetBtn.addEventListener(
          'click',
          function () {

            mainInput.value = '';
            urlInput.value = '';

            emailInput.value = '';
            emailSubject.value = '';
            emailBody.value = '';

            phoneInput.value = '';

            wifiName.value = '';
            wifiPassword.value = '';
            wifiSecurity.value = 'WPA';
            wifiHidden.checked = false;

            sizeSelect.value = '240';
            marginSelect.value = '2';
            errorSelect.value = 'M';

            currentPayload = '';

            changeType('text');

            charCount.textContent =
              '0 حرف';

            showMessage(
              'تمت إعادة ضبط الأداة.',
              'success'
            );

          }
        );


        function getCanvas() {

          var canvas =
            qrBox.querySelector(
              'canvas'
            );

          if (canvas) {
            return canvas;
          }


          var image =
            qrBox.querySelector(
              'img'
            );

          if (!image) {
            return null;
          }


          var temporary =
            document.createElement(
              'canvas'
            );

          var context =
            temporary.getContext(
              '2d'
            );


          temporary.width =
            image.naturalWidth ||
            image.width ||
            Number(sizeSelect.value);

          temporary.height =
            image.naturalHeight ||
            image.height ||
            Number(sizeSelect.value);


          context.fillStyle =
            '#ffffff';

          context.fillRect(
            0,
            0,
            temporary.width,
            temporary.height
          );


          context.drawImage(
            image,
            0,
            0,
            temporary.width,
            temporary.height
          );


          return temporary;

        }


        pngBtn.addEventListener(
          'click',
          function () {

            var canvas =
              getCanvas();

            if (!canvas) {
              return;
            }

            var link =
              document.createElement(
                'a'
              );

            link.download =
              'qr-code.png';

            link.href =
              canvas.toDataURL(
                'image/png'
              );

            document.body.appendChild(
              link
            );

            link.click();

            link.remove();

            showMessage(
              'تم تحميل QR Code بصيغة PNG.',
              'success'
            );

          }
        );


        svgBtn.addEventListener(
          'click',
          function () {

            var canvas =
              getCanvas();

            if (!canvas) {
              return;
            }


            var png =
              canvas.toDataURL(
                'image/png'
              );


            var width =
              canvas.width;

            var height =
              canvas.height;


            var svg =
              '<?xml version="1.0" encoding="UTF-8"?>' +
              '<svg xmlns="http://www.w3.org/2000/svg" ' +
              'width="' + width + '" ' +
              'height="' + height + '" ' +
              'viewBox="0 0 ' + width + ' ' + height + '">' +
              '<image href="' + png + '" ' +
              'width="' + width + '" ' +
              'height="' + height + '" />' +
              '</svg>';


            var blob =
              new Blob(
                [svg],
                {
                  type:
                    'image/svg+xml;charset=utf-8'
                }
              );


            var objectUrl =
              URL.createObjectURL(
                blob
              );


            var link =
              document.createElement(
                'a'
              );

            link.href =
              objectUrl;

            link.download =
              'qr-code.svg';

            document.body.appendChild(
              link
            );

            link.click();

            link.remove();


            setTimeout(
              function () {
                URL.revokeObjectURL(
                  objectUrl
                );
              },
              1000
            );


            showMessage(
              'تم تحميل QR Code بصيغة SVG.',
              'success'
            );

          }
        );


        copyBtn.addEventListener(
          'click',
          function () {

            if (!currentPayload) {
              return;
            }


            if (
              navigator.clipboard &&
              navigator.clipboard.writeText
            ) {

              navigator.clipboard
                .writeText(
                  currentPayload
                )
                .then(
                  function () {

                    showMessage(
                      'تم نسخ المحتوى بنجاح.',
                      'success'
                    );

                  }
                )
                .catch(
                  fallbackCopy
                );

            } else {

              fallbackCopy();

            }

          }
        );


        function fallbackCopy() {

          var area =
            document.createElement(
              'textarea'
            );

          area.value =
            currentPayload;

          area.style.position =
            'fixed';

          area.style.opacity =
            '0';

          document.body.appendChild(
            area
          );

          area.select();

          try {

            document.execCommand(
              'copy'
            );

            showMessage(
              'تم نسخ المحتوى.',
              'success'
            );

          } catch (error) {

            showMessage(
              'تعذر نسخ المحتوى.',
              'error'
            );

          }

          area.remove();

        }


        /*
         * Theme synchronization.
         * This keeps this page synchronized with
         * the Header theme button immediately.
         */

        function syncTheme() {

          var root =
            document.documentElement;

          var dark =
            root.classList.contains(
              'dark-mode'
            ) ||
            root.getAttribute(
              'data-theme'
            ) === 'dark';

          document.body.classList.toggle(
            'qr-dark',
            dark
          );

          document.body.classList.toggle(
            'qr-light',
            !dark
          );

        }


        syncTheme();


        var observer =
          new MutationObserver(
            syncTheme
          );


        observer.observe(
          document.documentElement,
          {
            attributes: true,
            attributeFilter: [
              'class',
              'data-theme'
            ]
          }
        );


        /*
         * Initial state
         */

        changeType('text');

        setStatus(
          'جارٍ التحقق...',
          true
        );


        if (
          typeof window.QRCode !== 'undefined'
        ) {

          setStatus(
            'جاهز',
            false
          );

        } else {

          var attempts = 0;

          var libraryTimer =
            setInterval(
              function () {

                attempts++;

                if (
                  typeof window.QRCode !==
                  'undefined'
                ) {

                  clearInterval(
                    libraryTimer
                  );

                  setStatus(
                    'جاهز',
                    false
                  );

                  return;

                }


                if (attempts >= 80) {

                  clearInterval(
                    libraryTimer
                  );

                  setStatus(
                    'تعذر التحميل',
                    false
                  );

                  showMessage(
                    'تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت.',
                    'error'
                  );

                }

              },
              100
            );

        }

      }


      if (
        document.readyState === 'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          init
        );

      } else {

        init();

      }

    })();
  </script>


