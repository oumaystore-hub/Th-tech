      </div>
    </div>
  </section>

  <section class="how-section">
    <div class="container">
      <div class="section-heading">
        <span>HOW IT WORKS</span>
        <h2>كيف تستخدم الأداة؟</h2>
      </div>

      <div class="steps">
        <div class="step">
          <div class="step-number">01</div>

          <div>
            <h3>اختر نوع المحتوى</h3>
            <p>
              حدد النص أو الرابط أو البريد أو الهاتف أو Wi-Fi.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">02</div>

          <div>
            <h3>أدخل البيانات</h3>
            <p>
              اكتب المحتوى وستظهر المعاينة مباشرة دون الحاجة إلى زر إنشاء.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">03</div>

          <div>
            <h3>نزّل الرمز</h3>
            <p>
              اختر PNG أو SVG واحفظ QR Code على جهازك.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="section-heading">
        <span>FAQ</span>
        <h2>الأسئلة الشائعة</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>
              <span>{faq.q}</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</main>

<Footer />

<script is:inline>
  (() => {
    "use strict";

    const $ = (selector) => document.querySelector(selector);
    const $$ = (selector) => [...document.querySelectorAll(selector)];

    const typeCards = $$(".type-card");

    const mainInput = $("#mainInput");
    const mainLabel = $("#mainLabel");
    const fieldHelp = $("#fieldHelp");
    const normalFields = $("#normalFields");
    const wifiFields = $("#wifiFields");

    const wifiName = $("#wifiName");
    const wifiPassword = $("#wifiPassword");
    const wifiSecurity = $("#wifiSecurity");

    const qrCanvas = $("#qrCanvas");
    const emptyState = $("#emptyState");

    const qrSize = $("#qrSize");
    const qrMargin = $("#qrMargin");
    const qrError = $("#qrError");

    const charCounter = $("#charCounter");

    const metaType = $("#metaType");
    const metaSize = $("#metaSize");
    const metaError = $("#metaError");

    const statusPill = $("#statusPill");
    const statusMessage = $("#statusMessage");
    const statusTitle = $("#statusTitle");
    const statusText = $("#statusText");

    let currentType = "text";
    let currentPayload = "";
    let timer = null;

    const labels = {
      text: {
        label: "النص",
        placeholder: "اكتب النص الذي تريد تحويله إلى QR Code...",
        help: "يمكنك إدخال نص عادي أو أي معلومات تريد مشاركتها."
      },
      url: {
        label: "رابط URL",
        placeholder: "https://example.com",
        help: "استخدم رابطًا يبدأ بـ https:// أو http://."
      },
      email: {
        label: "البريد الإلكتروني",
        placeholder: "hello@example.com",
        help: "أدخل عنوان بريد إلكتروني صالحًا."
      },
      phone: {
        label: "رقم الهاتف",
        placeholder: "+212600000000",
        help: "يمكنك استخدام رقم دولي مثل +212600000000."
      }
    };

    function setStatus(type, title, message) {
      statusPill.className = `status-pill ${type}`;

      const icon =
        type === "success"
          ? "fa-circle-check"
          : type === "error"
            ? "fa-circle-xmark"
            : type === "loading"
              ? "fa-spinner fa-spin"
              : "fa-circle";

      statusPill.innerHTML =
        `<span></span>${title}`;

      statusMessage.className =
        `status-message ${type}`;

      statusMessage.querySelector("i").className =
        `fa-solid ${icon}`;

      statusTitle.textContent = title;
      statusText.textContent = message;
    }

    function getPayload() {
      if (currentType === "wifi") {
        const ssid = wifiName.value.trim();
        const password = wifiPassword.value;

        if (!ssid) return "";

        const security = wifiSecurity.value;

        const safeSsid = ssid
          .replace(/\\/g, "\\\\")
          .replace(/;/g, "\\;")
          .replace(/,/g, "\\,")
          .replace(/:/g, "\\:");

        const safePassword = password
          .replace(/\\/g, "\\\\")
          .replace(/;/g, "\\;")
          .replace(/,/g, "\\,")
          .replace(/:/g, "\\:");

        return `WIFI:T:${security};S:${safeSsid};P:${safePassword};;`;
      }

      return mainInput.value.trim();
    }

    function getTypeName() {
      const names = {
        text: "TEXT",
        url: "URL",
        email: "EMAIL",
        phone: "PHONE",
        wifi: "WI-FI"
      };

      return names[currentType];
    }

    function updateTypeUI() {
      typeCards.forEach((card) => {
        card.classList.toggle(
          "active",
          card.dataset.type === currentType
        );
      });

      if (currentType === "wifi") {
        normalFields.style.display = "none";
        wifiFields.style.display = "grid";
      } else {
        normalFields.style.display = "block";
        wifiFields.style.display = "none";

        mainLabel.textContent =
          labels[currentType].label;

        mainInput.placeholder =
          labels[currentType].placeholder;

        fieldHelp.textContent =
          labels[currentType].help;
      }

      generate();
    }

    function validatePayload(payload) {
      if (!payload) {
        return {
          valid: false,
          message: "أدخل المحتوى أولاً."
        };
      }

      if (currentType === "url") {
        try {
          const url = new URL(payload);

          if (
            url.protocol !== "https:" &&
            url.protocol !== "http:"
          ) {
            return {
              valid: false,
              message:
                "يجب أن يبدأ الرابط بـ http:// أو https://."
            };
          }
        } catch {
          return {
            valid: false,
            message: "الرابط المدخل غير صالح."
          };
        }
      }

      if (currentType === "email") {
        const emailRegex =
          /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

        if (!emailRegex.test(payload)) {
          return {
            valid: false,
            message:
              "أدخل عنوان بريد إلكتروني صحيحًا."
          };
        }
      }

      if (currentType === "phone") {
        const phone =
          payload.replace(/[\s\-().]/g, "");

        if (!/^\+?[0-9]{6,18}$/.test(phone)) {
          return {
            valid: false,
            message: "رقم الهاتف غير صالح."
          };
        }
      }

      return {
        valid: true,
        message: ""
      };
    }

    function generate() {
      clearTimeout(timer);

      timer = setTimeout(() => {
        generateNow();
      }, 80);
    }

    function generateNow() {
      const payload = getPayload();

      currentPayload = payload;

      const size = Number(qrSize.value);
      const margin = Number(qrMargin.value);
      const error = qrError.value;

      metaType.textContent = getTypeName();
      metaSize.textContent = `${size}px`;
      metaError.textContent = error;

      charCounter.textContent =
        `${payload.length.toLocaleString("ar-MA")} حرف`;

      if (!payload) {
        qrCanvas.style.display = "none";
        emptyState.style.display = "flex";

        setStatus(
          "ready",
          "جاهز",
          "أدخل المحتوى لإنشاء QR Code."
        );

        return;
      }

      const validation =
        validatePayload(payload);

      if (!validation.valid) {
        qrCanvas.style.display = "none";
        emptyState.style.display = "flex";

        setStatus(
          "error",
          "بيانات غير صالحة",
          validation.message
        );

        return;
      }

      if (
        typeof window.QRCode === "undefined" ||
        typeof window.QRCode.toCanvas !== "function"
      ) {
        setStatus(
          "error",
          "المكتبة غير متاحة",
          "تعذر تحميل محرك QR Code. تحقق من اتصال الإنترنت ثم أعد تحميل الصفحة."
        );

        return;
      }

      setStatus(
        "loading",
        "يتم الإنشاء",
        "جارٍ إنشاء QR Code..."
      );

      QRCode.toCanvas(
        qrCanvas,
        payload,
        {
          width: size,
          margin,
          errorCorrectionLevel: error,
          color: {
            dark: "#081c25",
            light: "#ffffff"
          }
        },
        (errorObject) => {
          if (errorObject) {
            qrCanvas.style.display = "none";
            emptyState.style.display = "flex";

            setStatus(
              "error",
              "تعذر الإنشاء",
              "المحتوى كبير جدًا أو غير مناسب لهذا المستوى من تصحيح الأخطاء."
            );

            return;
          }

          emptyState.style.display = "none";
          qrCanvas.style.display = "block";

          setStatus(
            "success",
            "تم الإنشاء",
            "QR Code جاهز ويمكنك تنزيله بصيغة PNG أو SVG."
          );
        }
      );
    }

    function downloadPng() {
      if (
        !currentPayload ||
        qrCanvas.style.display === "none"
      ) {
        generateNow();
        return;
      }

      const link = document.createElement("a");

      link.download = "th-tech-qr-code.png";
      link.href =
        qrCanvas.toDataURL("image/png");

      document.body.appendChild(link);
      link.click();
      link.remove();

      setStatus(
        "success",
        "تم التنزيل",
        "تم حفظ QR Code بصيغة PNG."
      );
    }

    function downloadSvg() {
      if (!currentPayload) {
        setStatus(
          "error",
          "لا يوجد QR Code",
          "أدخل المحتوى أولاً."
        );
        return;
      }

      const validation =
        validatePayload(currentPayload);

      if (!validation.valid) {
        setStatus(
          "error",
          "بيانات غير صالحة",
          validation.message
        );
        return;
      }

      if (
        typeof window.QRCode === "undefined" ||
        typeof window.QRCode.toString !== "function"
      ) {
        setStatus(
          "error",
          "المكتبة غير متاحة",
          "تعذر تحميل محرك QR Code."
        );
        return;
      }

      QRCode.toString(
        currentPayload,
        {
          type: "svg",
          margin: Number(qrMargin.value),
          errorCorrectionLevel:
            qrError.value,
          color: {
            dark: "#081c25",
            light: "#ffffff"
          }
        },
        (errorObject, svg) => {
          if (errorObject) {
            setStatus(
              "error",
              "تعذر التنزيل",
              "حدث خطأ أثناء إنشاء ملف SVG."
            );
            return;
          }

          const blob = new Blob(
            [svg],
            {
              type: "image/svg+xml;charset=utf-8"
            }
          );

          const url =
            URL.createObjectURL(blob);

          const link =
            document.createElement("a");

          link.download =
            "th-tech-qr-code.svg";

          link.href = url;

          document.body.appendChild(link);
          link.click();
          link.remove();

          URL.revokeObjectURL(url);

          setStatus(
            "success",
            "تم التنزيل",
            "تم حفظ QR Code بصيغة SVG."
          );
        }
      );
    }

    async function copyText() {
      const payload = getPayload();

      if (!payload) {
        setStatus(
          "error",
          "لا يوجد محتوى",
          "أدخل المحتوى أولاً."
        );
        return;
      }

      try {
        await navigator.clipboard.writeText(
          payload
        );

        setStatus(
          "success",
          "تم النسخ",
          "تم نسخ محتوى QR Code إلى الحافظة."
        );
      } catch {
        setStatus(
          "error",
          "تعذر النسخ",
          "المتصفح لم يسمح بالوصول إلى الحافظة."
        );
      }
    }

    function loadExample(type) {
      currentType = type;

      if (type === "text") {
        mainInput.value =
          "مرحباً بك في Th.Tech - منصة تقنية مجانية.";
      }

      if (type === "url") {
        mainInput.value =
          "https://oumaystore-hub.github.io/Th-tech/";
      }

      if (type === "email") {
        mainInput.value =
          "hello@example.com";
      }

      if (type === "phone") {
        mainInput.value =
          "+212600000000";
      }

      if (type === "wifi") {
        wifiName.value = "Th-Tech WiFi";
        wifiPassword.value = "ThTech2026";
        wifiSecurity.value = "WPA";
      }

      updateTypeUI();
    }

    function clearAll() {
      currentType = "text";

      mainInput.value = "";

      wifiName.value = "";
      wifiPassword.value = "";
      wifiSecurity.value = "WPA";

      qrSize.value = "300";
      qrMargin.value = "2";
      qrError.value = "M";

      currentPayload = "";

      updateTypeUI();

      charCounter.textContent = "0 حرف";

      setStatus(
        "ready",
        "جاهز",
        "أدخل المحتوى لإنشاء QR Code."
      );
    }

    typeCards.forEach((card) => {
      card.addEventListener("click", () => {
        currentType = card.dataset.type;
        updateTypeUI();
      });
    });

    mainInput.addEventListener(
      "input",
      generate
    );

    wifiName.addEventListener(
      "input",
      generate
    );

    wifiPassword.addEventListener(
      "input",
      generate
    );

    wifiSecurity.addEventListener(
      "change",
      generate
    );

    qrSize.addEventListener(
      "change",
      generate
    );

    qrMargin.addEventListener(
      "change",
      generate
    );

    qrError.addEventListener(
      "change",
      generate
    );

    $("#downloadPngBtn").addEventListener(
      "click",
      downloadPng
    );

    $("#mainPngBtn").addEventListener(
      "click",
      downloadPng
    );

    $("#downloadSvgBtn").addEventListener(
      "click",
      downloadSvg
    );

    $("#mainSvgBtn").addEventListener(
      "click",
      downloadSvg
    );

    $("#copyTextBtn").addEventListener(
      "click",
      copyText
    );

    $("#exampleBtn").addEventListener(
      "click",
      () => loadExample("url")
    );

    $("#clearBtn").addEventListener(
      "click",
      clearAll
    );

    $$("[data-example]").forEach(
      (button) => {
        button.addEventListener(
          "click",
          () =>
            loadExample(
              button.dataset.example
            )
        );
      }
    );

    /*
     * Initial state
     * QRCode library is loaded synchronously
     * in <head> before this script executes.
     */
    updateTypeUI();
  })();
</script>

