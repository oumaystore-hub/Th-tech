---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "QR Code Generator - مولد QR Code أونلاين مجاناً | Th.Tech";

const description =
  "مولد QR Code مجاني لإنشاء رموز QR للنصوص والروابط والبريد الإلكتروني وأرقام الهاتف مع إمكانية تخصيص الحجم والتصحيح والمعاينة مباشرة داخل المتصفح.";

const faqs = [
  {
    q: "ما هي أداة QR Code Generator؟",
    a: "هي أداة مجانية لإنشاء QR Code من النصوص والروابط وبيانات الاتصال وغيرها، مع إمكانية تنزيل الرمز كصورة."
  },
  {
    q: "هل يمكن إنشاء QR Code لرابط؟",
    a: "نعم. أدخل الرابط مثل https://example.com وسيتم إنشاء QR Code يمكن مسحه مباشرة باستخدام كاميرا الهاتف."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. يتم إنشاء رمز QR داخل المتصفح، ولا يتم إرسال المحتوى الذي تدخله إلى خادم خارجي."
  },
  {
    q: "هل يمكن تنزيل QR Code؟",
    a: "نعم. يمكنك تنزيل الرمز الناتج كصورة PNG واستخدامه أو مشاركته."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");

          if (theme === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          } else {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>QR Code Generator</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-solid fa-qrcode"></i>
            </div>

            <div class="hero-text">
              <div class="tool-badge">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                Generator Tools
              </div>

              <h1>QR Code Generator</h1>

              <p>
                أنشئ QR Code احترافيًا للنصوص والروابط والبريد الإلكتروني
                وأرقام الهاتف مع معاينة فورية وتنزيل مباشر.
              </p>

              <div class="tags">
                <span>QR Code</span>
                <span>Generator</span>
                <span>URL</span>
                <span>PNG</span>
                <span>Local</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="tool-section">
        <div class="container">
          <div class="tool-card">
            <div class="tool-topbar">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="tool-name">
                <i class="fa-solid fa-qrcode"></i>
                QR Code Generator
              </div>

              <div class="secure">
                <i class="fa-solid fa-lock"></i>
                معالجة محلية
              </div>
            </div>

            <div class="actionbar">
              <button class="action-btn" id="exampleBtn">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                مثال
              </button>

              <button class="action-btn" id="clearBtn">
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

              <button class="action-btn" id="copyBtn">
                <i class="fa-regular fa-copy"></i>
                نسخ المحتوى
              </button>

              <button class="action-btn primary" id="downloadBtn">
                <i class="fa-solid fa-download"></i>
                تنزيل PNG
              </button>
            </div>

            <div class="generator-layout">
              <div class="input-side">
                <div class="editor-header">
                  <div>
                    <i class="fa-solid fa-pen-to-square"></i>
                    محتوى QR Code
                  </div>

                  <span id="charCount">0 حرف</span>
                </div>

                <div class="field">
                  <label for="qrType">
                    <i class="fa-solid fa-layer-group"></i>
                    نوع المحتوى
                  </label>

                  <select id="qrType">
                    <option value="text">نص</option>
                    <option value="url">رابط URL</option>
                    <option value="email">بريد إلكتروني</option>
                    <option value="phone">رقم هاتف</option>
                    <option value="wifi">Wi-Fi</option>
                  </select>
                </div>

                <div class="field" id="mainField">
                  <label for="qrInput" id="mainLabel">
                    <i class="fa-solid fa-align-left"></i>
                    النص
                  </label>

                  <textarea
                    id="qrInput"
                    rows="7"
                    placeholder="اكتب النص أو الرابط هنا..."
                    spellcheck="false"
                  ></textarea>

                  <small id="inputHint">
                    أدخل أي نص تريد تحويله إلى QR Code.
                  </small>
                </div>

                <div class="wifi-fields" id="wifiFields">
                  <div class="field">
                    <label for="wifiSsid">
                      <i class="fa-solid fa-wifi"></i>
                      اسم الشبكة
                    </label>

                    <input
                      id="wifiSsid"
                      type="text"
                      placeholder="My WiFi"
                      autocomplete="off"
                    />
                  </div>

                  <div class="field">
                    <label for="wifiPassword">
                      <i class="fa-solid fa-key"></i>
                      كلمة المرور
                    </label>

                    <input
                      id="wifiPassword"
                      type="text"
                      placeholder="Password"
                      autocomplete="off"
                    />
                  </div>

                  <div class="field">
                    <label for="wifiSecurity">
                      <i class="fa-solid fa-shield-halved"></i>
                      نوع الحماية
                    </label>

                    <select id="wifiSecurity">
                      <option value="WPA">WPA / WPA2</option>
                      <option value="WEP">WEP</option>
                      <option value="nopass">بدون كلمة مرور</option>
                    </select>
                  </div>
                </div>

                <div class="options-grid">
                  <div class="field">
                    <label for="qrSize">
                      <i class="fa-solid fa-expand"></i>
                      الحجم
                    </label>

                    <select id="qrSize">
                      <option value="200">200 × 200</option>
                      <option value="300" selected>300 × 300</option>
                      <option value="400">400 × 400</option>
                      <option value="500">500 × 500</option>
                    </select>
                  </div>

                  <div class="field">
                    <label for="qrMargin">
                      <i class="fa-solid fa-border-all"></i>
                      الهامش
                    </label>

                    <select id="qrMargin">
                      <option value="1">صغير</option>
                      <option value="2" selected>متوسط</option>
                      <option value="4">كبير</option>
                    </select>
                  </div>

                  <div class="field">
                    <label for="qrError">
                      <i class="fa-solid fa-shield-halved"></i>
                      تصحيح الأخطاء
                    </label>

                    <select id="qrError">
                      <option value="L">L — 7%</option>
                      <option value="M" selected>M — 15%</option>
                      <option value="Q">Q — 25%</option>
                      <option value="H">H — 30%</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="preview-side">
                <div class="preview-header">
                  <div>
                    <i class="fa-solid fa-eye"></i>
                    المعاينة
                  </div>

                  <span>Live Preview</span>
                </div>

                <div class="qr-preview">
                  <div class="qr-frame" id="qrFrame">
                    <canvas id="qrCanvas" width="300" height="300"></canvas>

                    <div class="empty-preview" id="emptyPreview">
                      <i class="fa-solid fa-qrcode"></i>
                      <span>أدخل المحتوى لعرض QR Code</span>
                    </div>
                  </div>
                </div>

                <div class="preview-actions">
                  <button class="preview-btn" id="regenerateBtn">
                    <i class="fa-solid fa-rotate"></i>
                    تحديث
                  </button>

                  <button class="preview-btn primary-preview" id="downloadPreviewBtn">
                    <i class="fa-solid fa-download"></i>
                    تنزيل
                  </button>
                </div>

                <div class="preview-info">
                  <div>
                    <span>الحجم</span>
                    <strong id="previewSize">300px</strong>
                  </div>

                  <div>
                    <span>تصحيح</span>
                    <strong id="previewError">M</strong>
                  </div>

                  <div>
                    <span>الحالة</span>
                    <strong id="previewStatus">جاهز</strong>
                  </div>
                </div>
              </div>
            </div>

            <div class="examples">
              <div class="examples-title">
                <i class="fa-solid fa-bolt"></i>
                أمثلة سريعة
              </div>

              <div class="example-list">
                <button data-example="url">
                  رابط Website
                </button>

                <button data-example="text">
                  نص عادي
                </button>

                <button data-example="email">
                  بريد إلكتروني
                </button>

                <button data-example="phone">
                  رقم هاتف
                </button>

                <button data-example="wifi">
                  شبكة Wi-Fi
                </button>
              </div>
            </div>

            <div class="status-box ready" id="statusBox">
              <div class="status-icon">
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div>
                <strong id="statusTitle">جاهز لإنشاء QR Code</strong>

                <p id="statusText">
                  أدخل المحتوى وستظهر المعاينة مباشرة.
                </p>
              </div>
            </div>

            <div class="stats-grid">
              <div class="stat">
                <span>Characters</span>
                <strong id="statCharacters">0</strong>
              </div>

              <div class="stat">
                <span>Type</span>
                <strong id="statType">Text</strong>
              </div>

              <div class="stat">
                <span>Size</span>
                <strong id="statSize">300px</strong>
              </div>

              <div class="stat">
                <span>Error Correction</span>
                <strong id="statError">M</strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>لماذا QR Code Generator؟</span>

            <h2>أنشئ QR Code بسهولة وسرعة</h2>

            <p>
              أداة بسيطة وسريعة لإنشاء رموز QR متعددة الاستخدامات مباشرة من
              المتصفح.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>معاينة فورية</h3>

              <p>
                شاهد QR Code يتغير مباشرة أثناء كتابة أو تعديل المحتوى.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-download"></i>
              </div>

              <h3>تنزيل PNG</h3>

              <p>
                احفظ الرمز الناتج كصورة PNG بجودة وحجم مناسبين للاستخدام.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <h3>خصوصية محلية</h3>

              <p>
                تتم معالجة المحتوى محليًا داخل المتصفح دون إرساله إلى خادم
                خارجي.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>طريقة الاستخدام</span>

            <h2>أنشئ QR Code في 3 خطوات</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>اختر نوع المحتوى</h3>

                <p>
                  اختر نصًا أو رابطًا أو بريدًا إلكترونيًا أو رقم هاتف أو
                  شبكة Wi-Fi.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>أدخل البيانات</h3>

                <p>
                  اكتب المحتوى الذي تريد تحويله إلى QR Code وستظهر المعاينة
                  تلقائيًا.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>نزّل الرمز</h3>

                <p>
                  اضغط على تنزيل PNG لحفظ QR Code على جهازك.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>الأسئلة الشائعة</span>

            <h2>QR Code Generator FAQ</h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const qrType = document.getElementById("qrType");
      const qrInput = document.getElementById("qrInput");
      const qrSize = document.getElementById("qrSize");
      const qrMargin = document.getElementById("qrMargin");
      const qrError = document.getElementById("qrError");

      const wifiFields = document.getElementById("wifiFields");
      const wifiSsid = document.getElementById("wifiSsid");
      const wifiPassword = document.getElementById("wifiPassword");
      const wifiSecurity = document.getElementById("wifiSecurity");

      const mainLabel = document.getElementById("mainLabel");
      const inputHint = document.getElementById("inputHint");

      const qrCanvas = document.getElementById("qrCanvas");
      const qrFrame = document.getElementById("qrFrame");
      const emptyPreview = document.getElementById("emptyPreview");

      const charCount = document.getElementById("charCount");

      const generateBtn = document.getElementById("downloadBtn");
      const downloadPreviewBtn = document.getElementById("downloadPreviewBtn");
      const regenerateBtn = document.getElementById("regenerateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const statusBox = document.getElementById("statusBox");
      const statusTitle = document.getElementById("statusTitle");
      const statusText = document.getElementById("statusText");

      const previewSize = document.getElementById("previewSize");
      const previewError = document.getElementById("previewError");
      const previewStatus = document.getElementById("previewStatus");

      const statCharacters = document.getElementById("statCharacters");
      const statType = document.getElementById("statType");
      const statSize = document.getElementById("statSize");
      const statError = document.getElementById("statError");

      let qrReady = false;
      let currentPayload = "";

      function showStatus(type, title, text) {
        statusBox.className = `status-box ${type}`;
        statusTitle.textContent = title;
        statusText.textContent = text;
      }

      function showReady() {
        showStatus(
          "ready",
          "جاهز لإنشاء QR Code",
          "أدخل المحتوى وستظهر المعاينة مباشرة."
        );
      }

      function showSuccess(text) {
        showStatus(
          "success",
          "تم إنشاء QR Code",
          text
        );
      }

      function showError(text) {
        showStatus(
          "error",
          "تعذر إنشاء QR Code",
          text
        );
      }

      function escapeWifiValue(value) {
        return String(value)
          .replace(/\\/g, "\\\\")
          .replace(/;/g, "\\;")
          .replace(/,/g, "\\,")
          .replace(/:/g, "\\:");
      }

      function getPayload() {
        const type = qrType.value;

        if (type === "wifi") {
          const ssid = wifiSsid.value.trim();
          const password = wifiPassword.value;
          const security = wifiSecurity.value;

          if (!ssid) return "";

          return `WIFI:T:${security};S:${escapeWifiValue(
            ssid
          )};P:${escapeWifiValue(password)};;`;
        }

        return qrInput.value.trim();
      }

      function getTypeName() {
        const names = {
          text: "Text",
          url: "URL",
          email: "Email",
          phone: "Phone",
          wifi: "Wi-Fi"
        };

        return names[qrType.value] || "Text";
      }

      function updateTypeUI() {
        const type = qrType.value;

        if (type === "wifi") {
          document.getElementById("mainField").style.display = "none";
          wifiFields.style.display = "grid";
          inputHint.textContent =
            "أدخل اسم الشبكة وكلمة المرور ونوع الحماية.";
        } else {
          document.getElementById("mainField").style.display = "block";
          wifiFields.style.display = "none";

          const labels = {
            text: "النص",
            url: "الرابط",
            email: "البريد الإلكتروني",
            phone: "رقم الهاتف"
          };

          const hints = {
            text: "أدخل أي نص تريد تحويله إلى QR Code.",
            url: "مثال: https://example.com",
            email: "مثال: hello@example.com",
            phone: "مثال: +212600000000"
          };

          mainLabel.innerHTML =
            `<i class="fa-solid ${
              type === "url"
                ? "fa-link"
                : type === "email"
                  ? "fa-envelope"
                  : type === "phone"
                    ? "fa-phone"
                    : "fa-align-left"
            }"></i> ${labels[type]}`;

          inputHint.textContent = hints[type];
        }

        generateQRCode();
      }

      function getQrLibrary() {
        return window.QRCode;
      }

      function generateQRCode() {
        const payload = getPayload();

        currentPayload = payload;

        charCount.textContent =
          `${payload.length} ${payload.length === 1 ? "حرف" : "حرف"}`;

        statCharacters.textContent = payload.length;
        statType.textContent = getTypeName();

        const size = Number(qrSize.value);
        const margin = Number(qrMargin.value);
        const error = qrError.value;

        previewSize.textContent = `${size}px`;
        previewError.textContent = error;
        statSize.textContent = `${size}px`;
        statError.textContent = error;

        qrCanvas.width = size;
        qrCanvas.height = size;

        if (!payload) {
          qrReady = false;
          emptyPreview.style.display = "flex";
          qrCanvas.style.display = "none";
          previewStatus.textContent = "جاهز";
          return;
        }

        if (!window.QRCode) {
          qrReady = false;
          emptyPreview.style.display = "flex";
          qrCanvas.style.display = "none";

          showError(
            "تعذر تحميل محرك QR Code. تحقق من اتصال الإنترنت ثم أعد المحاولة."
          );

          return;
        }

        emptyPreview.style.display = "none";
        qrCanvas.style.display = "block";

        try {
          QRCode.toCanvas(
            qrCanvas,
            payload,
            {
              width: size,
              margin: margin,
              errorCorrectionLevel: error,
              color: {
                dark: "#10212b",
                light: "#ffffff"
              }
            },
            (errorObject) => {
              if (errorObject) {
                qrReady = false;
                showError("تعذر إنشاء QR Code لهذا المحتوى.");
                previewStatus.textContent = "خطأ";
                return;
              }

              qrReady = true;
              previewStatus.textContent = "جاهز";
              showSuccess(
                "تم إنشاء QR Code ويمكنك تنزيله الآن."
              );
            }
          );
        } catch {
          qrReady = false;
          previewStatus.textContent = "خطأ";
          showError("حدث خطأ أثناء إنشاء QR Code.");
        }
      }

      function validateContent() {
        const type = qrType.value;
        const payload = getPayload();

        if (!payload) {
          showError("أدخل المحتوى أولاً لإنشاء QR Code.");
          return false;
        }

        if (type === "url") {
          try {
            const url = new URL(payload);

            if (!["http:", "https:"].includes(url.protocol)) {
              showError(
                "الرابط يجب أن يبدأ بـ http:// أو https://."
              );
              return false;
            }
          } catch {
            showError("أدخل رابط URL صحيحًا.");
            return false;
          }
        }

        if (type === "email") {
          const validEmail =
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload);

          if (!validEmail) {
            showError("أدخل عنوان بريد إلكتروني صحيحًا.");
            return false;
          }
        }

        if (type === "phone") {
          const phone = payload.replace(/[\s\-().]/g, "");

          if (!/^\+?[0-9]{6,18}$/.test(phone)) {
            showError("أدخل رقم هاتف صحيحًا.");
            return false;
          }
        }

        return true;
      }

      function downloadQRCode() {
        if (!validateContent()) return;

        if (!qrReady) {
          generateQRCode();

          setTimeout(() => {
            if (qrReady) downloadQRCodeFile();
          }, 150);

          return;
        }

        downloadQRCodeFile();
      }

      function downloadQRCodeFile() {
        try {
          const link = document.createElement("a");

          link.download = "th-tech-qr-code.png";
          link.href = qrCanvas.toDataURL("image/png");

          document.body.appendChild(link);
          link.click();
          link.remove();

          showSuccess("تم تنزيل QR Code بصيغة PNG.");
        } catch {
          showError("تعذر تنزيل QR Code.");
        }
      }

      async function copyContent() {
        const payload = getPayload();

        if (!payload) {
          showError("أدخل المحتوى أولاً.");
          return;
        }

        try {
          await navigator.clipboard.writeText(payload);

          const oldHTML = copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = oldHTML;
          }, 1300);
        } catch {
          showError("تعذر نسخ المحتوى.");
        }
      }

      function loadExample(type = "url") {
        qrType.value = type;

        if (type === "url") {
          qrInput.value = "https://oumaystore-hub.github.io/Th-tech/";
        }

        if (type === "text") {
          qrInput.value =
            "مرحباً بك في Th.Tech - منصة تقنية مجانية.";
        }

        if (type === "email") {
          qrInput.value = "hello@example.com";
        }

        if (type === "phone") {
          qrInput.value = "+212600000000";
        }

        if (type === "wifi") {
          wifiSsid.value = "Th-Tech-WiFi";
          wifiPassword.value = "ThTech2026";
          wifiSecurity.value = "WPA";
        }

        updateTypeUI();
      }

      function clearAll() {
        qrType.value = "text";
        qrInput.value = "";

        wifiSsid.value = "";
        wifiPassword.value = "";
        wifiSecurity.value = "WPA";

        qrSize.value = "300";
        qrMargin.value = "2";
        qrError.value = "M";

        currentPayload = "";
        qrReady = false;

        qrCanvas.style.display = "none";
        emptyPreview.style.display = "flex";

        updateTypeUI();

        charCount.textContent = "0 حرف";
        statCharacters.textContent = "0";
        statType.textContent = "Text";
        statSize.textContent = "300px";
        statError.textContent = "M";

        previewSize.textContent = "300px";
        previewError.textContent = "M";
        previewStatus.textContent = "جاهز";

        showReady();
      }

      qrType.addEventListener("change", updateTypeUI);

      [
        qrInput,
        wifiSsid,
        wifiPassword
      ].forEach((input) => {
        input.addEventListener("input", generateQRCode);
      });

      [
        wifiSecurity,
        qrSize,
        qrMargin,
        qrError
      ].forEach((input) => {
        input.addEventListener("change", generateQRCode);
      });

      generateBtn.addEventListener("click", downloadQRCode);
      downloadPreviewBtn.addEventListener("click", downloadQRCode);
      regenerateBtn.addEventListener("click", generateQRCode);
      copyBtn.addEventListener("click", copyContent);

      exampleBtn.addEventListener("click", () => {
        loadExample("url");
      });

      clearBtn.addEventListener("click", clearAll);

      document.querySelectorAll("[data-example]").forEach((button) => {
        button.addEventListener("click", () => {
          loadExample(button.dataset.example);
        });
      });

      updateTypeUI();
    </script>

    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.4/qrcode.min.js"
      defer
    ></script>

    <style>
      :root {
        --bg: #f4f9fc;
        --surface: #ffffff;
        --surface-2: #f7fbfd;
        --border: #dceaf1;
        --text: #10212b;
