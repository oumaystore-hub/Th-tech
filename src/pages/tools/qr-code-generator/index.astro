        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .window-dots {
        display: flex;
        gap: 7px;
      }

      .window-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
