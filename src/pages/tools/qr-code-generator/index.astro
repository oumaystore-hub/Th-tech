      font-size: 7px;
    }

    .download-btn:hover:not(:disabled) {
      border-color: var(--border-strong);
      transform: translateY(-1px);
    }

    .download-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 16px;
    }

    .stat-card {
      min-height: 80px;
      padding: 14px;
      border-radius: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stat-icon {
      width: 37px;
      height: 37px;
      border-radius: 10px;
    }

    .stat-card strong,
    .stat-card span {
      display: block;
    }

    .stat-card strong {
      font-size: 12px;
    }

    .stat-card span {
      color: var(--muted);
      font-size: 8px;
      margin-top: 2px;
    }

    .info-card {
      margin-top: 16px;
      padding: 20px;
      border-radius: 18px;
      display: flex;
      gap: 15px;
      align-items: flex-start;
    }

    .info-icon {
      width: 43px;
      height: 43px;
      border-radius: 12px;
    }

    .info-card h2 {
      margin: 1px 0 7px;
      font-size: 14px;
    }

    .info-card p {
      margin: 0;
      color: var(--muted);
      line-height: 2;
      font-size: 10px;
    }

    .steps {
      list-style: none;
      margin: 16px 0 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }

    .steps li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .steps li > span {
      width: 27px;
      height: 27px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 8px;
      color: var(--primary);
      background: rgba(40, 184, 242, 0.08);
      border: 1px solid var(--border);
      font-size: 9px;
      font-weight: 800;
    }

    .steps strong {
      font-size: 10px;
    }

    .steps p {
      margin-top: 2px;
      font-size: 8px;
    }

    .note-card {
      background:
        linear-gradient(
          145deg,
          rgba(40, 184, 242, 0.06),
          transparent
        ),
        var(--card);
    }

    .faq {
      margin-top: 45px;
    }

    .faq-heading {
      text-align: center;
      margin-bottom: 17px;
    }

    .faq-heading span {
      color: var(--primary);
      font-size: 9px;
      font-weight: 800;
    }

    .faq-heading h2 {
      margin: 5px 0 0;
      font-size: 20px;
    }

    details {
      margin-bottom: 8px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--card);
      overflow: hidden;
    }

    summary {
      min-height: 48px;
      padding: 12px 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      list-style: none;
      font-size: 10px;
      font-weight: 700;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);
      font-size: 9px;
      transition: transform 0.2s ease;
    }

    details[open] summary i {
      transform: rotate(45deg);
    }

    details p {
      margin: 0;
      padding: 0 15px 15px;
      color: var(--muted);
      font-size: 9px;
      line-height: 2;
    }

    @media (max-width: 850px) {
      .workspace {
        grid-template-columns: 1fr;
      }

      .input-panel {
        border-left: 0;
        border-bottom: 1px solid var(--border);
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 620px) {
      .page {
        width: min(100% - 18px, 540px);
        padding-top: 15px;
      }

      .hero {
        padding: 15px 5px 24px;
      }

      .hero-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        font-size: 23px;
      }

      .hero-description {
        font-size: 11px;
        line-height: 1.9;
      }

      .tool-card {
        border-radius: 18px;
      }

      .tool-header {
        padding: 17px;
      }

      .tool-header h2 {
        font-size: 16px;
      }

      .types {
        grid-template-columns: repeat(3, 1fr);
        padding: 13px;
      }

      .type-btn {
        min-height: 48px;
        flex-direction: column;
        gap: 3px;
        font-size: 8px;
      }

      .type-btn i {
        font-size: 12px;
      }

      .input-panel,
      .preview-panel {
        padding: 16px;
      }

      .settings-grid {
        grid-template-columns: 1fr;
      }

      .actions {
        grid-template-columns: 1fr 1fr;
      }

      .qr-stage {
        min-height: 270px;
      }

      .stats-grid {
        gap: 7px;
      }

      .stat-card {
        min-height: 70px;
        padding: 10px;
      }

      .stat-icon {
        width: 32px;
        height: 32px;
        font-size: 11px;
      }

      .stat-card strong {
        font-size: 10px;
      }

      .stat-card span {
        font-size: 7px;
      }

      .download-actions {
        gap: 6px;
      }

      .download-btn {
        min-height: 50px;
        gap: 5px;
      }

      .download-btn span {
        display: none;
      }

      .download-btn i {
        font-size: 14px;
      }

      .info-card {
        padding: 15px;
        gap: 10px;
      }

      .info-icon {
        width: 37px;
        height: 37px;
        font-size: 12px;
      }

      .info-card p {
        font-size: 9px;
      }
    }

    @media (max-width: 380px) {
      .types {
        grid-template-columns: repeat(3, 1fr);
      }

      .type-btn {
        min-height: 44px;
      }

      .tool-header {
        flex-direction: column;
      }

      .live-status {
        align-self: flex-start;
      }

      .actions {
        grid-template-columns: 1fr;
      }

      .qr-stage {
        min-height: 240px;
      }
    }
  </style>
</body>
</html>
