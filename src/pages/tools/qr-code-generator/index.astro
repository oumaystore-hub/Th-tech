---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>مولد QR Code احترافي | Th.Tech</title>

  <meta
    name="description"
    content="مولد QR Code مجاني لإنشاء رموز QR للنصوص والروابط والبريد والهاتف وشبكات Wi-Fi."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
  ></script>
</head>

<body>

  <Header />

  <main class="qr-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-qrcode"></i>
        أداة QR Code
      </div>

      <h1>
        مولد <span>QR Code</span> احترافي
      </h1>

      <p>
        أنشئ رمز QR بسهولة للنصوص والروابط والبريد الإلكتروني
        وأرقام الهاتف وشبكات Wi-Fi.
      </p>

      <div class="hero-points">
        <span>
          <i class="fa-solid fa-bolt"></i>
          إنشاء فوري
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          بدون حفظ البيانات
        </span>

        <span>
          <i class="fa-solid fa-mobile-screen"></i>
          يعمل على الهاتف
        </span>
      </div>

    </section>


    <!-- MAIN TOOL -->
    <section class="tool">

      <div class="tool-top">

        <div>
          <div class="mini-label">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            مولد QR
          </div>

          <h2>أنشئ رمز QR الخاص بك</h2>

          <p>
            اختر النوع وأدخل بياناتك وسيتم إنشاء الرمز مباشرة.
          </p>
        </div>

        <div class="status" id="status">
          <span></span>
          جاهز
        </div>

      </div>


      <!-- TYPE SELECTOR -->
      <div class="type-area">

        <div class="type-title">
          نوع البيانات
        </div>

        <div class="types">

          <button class="type active" type="button" data-type="text">
            <i class="fa-solid fa-font"></i>
            <span>نص</span>
          </button>

          <button class="type" type="button" data-type="url">
            <i class="fa-solid fa-link"></i>
            <span>رابط</span>
          </button>

          <button class="type" type="button" data-type="email">
            <i class="fa-solid fa-envelope"></i>
            <span>بريد</span>
          </button>

          <button class="type" type="button" data-type="phone">
            <i class="fa-solid fa-phone"></i>
            <span>هاتف</span>
          </button>

          <button class="type" type="button" data-type="wifi">
            <i class="fa-solid fa-wifi"></i>
            <span>Wi-Fi</span>
          </button>

        </div>

      </div>


      <!-- WORK AREA -->
      <div class="work">

        <!-- INPUT SIDE -->
        <div class="editor">

          <div class="block-head">

            <div class="block-icon">
              <i class="fa-solid fa-pen"></i>
            </div>

            <div>
              <h3 id="inputTitle">النص</h3>

              <p id="inputHint">
                اكتب النص الذي تريد تحويله إلى QR Code
              </p>
            </div>

          </div>


          <!-- TEXT -->
          <div class="fields" id="textFields">

            <label for="mainInput">
              المحتوى
              <b>*</b>
            </label>

            <textarea
              id="mainInput"
              placeholder="اكتب النص هنا..."
            ></textarea>

            <div class="field-meta">
              <span id="charCount">0 حرف</span>
              <span>يدعم العربية واللغات المختلفة</span>
            </div>

          </div>


          <!-- URL -->
          <div class="fields hidden" id="urlFields">

            <label for="urlInput">
              رابط الموقع
              <b>*</b>
            </label>

            <input
              id="urlInput"
              type="url"
              placeholder="https://example.com"
            />

            <div class="hint">
              مثال: https://example.com
            </div>

          </div>


          <!-- EMAIL -->
          <div class="fields hidden" id="emailFields">

            <label for="emailInput">
              البريد الإلكتروني
              <b>*</b>
            </label>

            <input
              id="emailInput"
              type="email"
              placeholder="example@email.com"
            />

            <label for="emailSubject">
              الموضوع
            </label>

            <input
              id="emailSubject"
              type="text"
              placeholder="موضوع اختياري"
            />

            <label for="emailBody">
              الرسالة
            </label>

            <textarea
              id="emailBody"
              class="small-textarea"
              placeholder="اكتب الرسالة..."
            ></textarea>

          </div>


          <!-- PHONE -->
          <div class="fields hidden" id="phoneFields">

            <label for="phoneInput">
              رقم الهاتف
              <b>*</b>
            </label>

            <input
              id="phoneInput"
              type="tel"
              placeholder="+212600000000"
            />

            <div class="hint">
              يفضل إدخال رمز الدولة.
            </div>

          </div>


          <!-- WIFI -->
          <div class="fields hidden" id="wifiFields">

            <label for="wifiName">
              اسم الشبكة SSID
              <b>*</b>
            </label>

            <input
              id="wifiName"
              type="text"
              placeholder="اسم شبكة Wi-Fi"
            />

            <label for="wifiPassword">
              كلمة المرور
            </label>

            <input
              id="wifiPassword"
              type="text"
              placeholder="كلمة المرور"
            />

            <label for="wifiSecurity">
              نوع الحماية
            </label>

            <select id="wifiSecurity">
              <option value="WPA">WPA / WPA2 / WPA3</option>
              <option value="WEP">WEP</option>
              <option value="nopass">بدون كلمة مرور</option>
            </select>

            <label class="checkbox">
              <input type="checkbox" id="wifiHidden" />
              <span>الشبكة مخفية</span>
            </label>

          </div>


          <!-- SETTINGS -->
          <div class="settings">

            <div class="settings-head">
              <i class="fa-solid fa-sliders"></i>
              <span>إعدادات الرمز</span>
            </div>

            <div class="settings-grid">

              <div>
                <label for="sizeSelect">الحجم</label>

                <select id="sizeSelect">
                  <option value="180">صغير</option>
                  <option value="240" selected>متوسط</option>
                  <option value="320">كبير</option>
                  <option value="420">كبير جدًا</option>
                </select>
              </div>

              <div>
                <label for="marginSelect">الهامش</label>

                <select id="marginSelect">
                  <option value="1">صغير</option>
                  <option value="2" selected>متوسط</option>
                  <option value="4">كبير</option>
                  <option value="6">كبير جدًا</option>
                </select>
              </div>

              <div>
                <label for="errorSelect">تصحيح الخطأ</label>

                <select id="errorSelect">
                  <option value="L">منخفض</option>
                  <option value="M" selected>متوسط</option>
                  <option value="Q">مرتفع</option>
                  <option value="H">أقصى</option>
                </select>
              </div>

            </div>

          </div>


          <!-- ACTIONS -->
          <div class="main-actions">

            <button class="reset-btn" type="button" id="resetBtn">
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

            <button class="generate-btn" type="button" id="generateBtn">
              <i class="fa-solid fa-qrcode"></i>
              إنشاء QR Code
            </button>

          </div>

          <div id="message" class="message"></div>

        </div>


        <!-- PREVIEW SIDE -->
        <div class="preview">

          <div class="block-head preview-head">

            <div class="block-icon">
              <i class="fa-solid fa-eye"></i>
            </div>

            <div>
              <h3>المعاينة</h3>

              <p id="previewState">
                في انتظار البيانات
              </p>
            </div>

          </div>


          <div class="qr-container">

            <div class="empty" id="qrEmpty">

              <div class="empty-icon">
                <i class="fa-solid fa-qrcode"></i>
              </div>

              <strong>سيظهر QR Code هنا</strong>

              <span>
                أدخل البيانات لإنشاء الرمز
              </span>

            </div>

            <div id="qrBox" class="qr-box"></div>

          </div>


          <div class="qr-meta">

            <span>
              <i class="fa-solid fa-circle-check"></i>
              جاهز للمسح
            </span>

            <span id="dataTypeInfo">
              النوع: نص
            </span>

          </div>


          <div class="export-title">
            تصدير الرمز
          </div>


          <div class="export-grid">

            <button class="export" id="pngBtn" type="button" disabled>
              <i class="fa-solid fa-image"></i>
              <span>
                <strong>PNG</strong>
                <small>صورة</small>
              </span>
            </button>

            <button class="export" id="svgBtn" type="button" disabled>
              <i class="fa-solid fa-vector-square"></i>
              <span>
                <strong>SVG</strong>
                <small>متجه</small>
              </span>
            </button>

            <button class="export" id="copyBtn" type="button" disabled>
              <i class="fa-solid fa-copy"></i>
              <span>
                <strong>نسخ</strong>
                <small>المحتوى</small>
              </span>
            </button>

          </div>

        </div>

      </div>

    </section>


    <!-- FEATURES -->
    <section class="features">

      <div class="feature">
        <div>
          <i class="fa-solid fa-bolt"></i>
        </div>

        <section>
          <strong>توليد فوري</strong>
          <span>النتيجة تظهر مباشرة أثناء الكتابة</span>
        </section>
      </div>


      <div class="feature">
        <div>
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <section>
          <strong>خصوصية كاملة</strong>
          <span>البيانات لا تغادر متصفحك</span>
        </section>
      </div>


      <div class="feature">
        <div>
          <i class="fa-solid fa-download"></i>
        </div>

        <section>
          <strong>تصدير سهل</strong>
          <span>PNG و SVG ونسخ المحتوى</span>
        </section>
      </div>

    </section>


    <!-- INFO -->
    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div>
        <h2>خصوصيتك أولًا</h2>

        <p>
          يتم إنشاء رمز QR داخل متصفحك مباشرة.
          لا يتم إرسال النص أو الروابط أو بيانات Wi-Fi إلى خادم الأداة.
        </p>
      </div>

    </section>


    <!-- HOW TO -->
    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-body">

        <h2>طريقة الاستخدام</h2>

        <div class="steps">

          <div class="step">
            <span>1</span>
            <div>
              <strong>اختر النوع</strong>
              <p>حدد نص أو رابط أو بريد أو هاتف أو Wi-Fi.</p>
            </div>
          </div>

          <div class="step">
            <span>2</span>
            <div>
              <strong>أدخل البيانات</strong>
              <p>اكتب البيانات المطلوبة في الحقول.</p>
            </div>
          </div>

          <div class="step">
            <span>3</span>
            <div>
              <strong>خصص الرمز</strong>
              <p>اختر الحجم والهامش ومستوى تصحيح الخطأ.</p>
            </div>
          </div>

          <div class="step">
            <span>4</span>
            <div>
              <strong>صدّر QR Code</strong>
              <p>حمّل الرمز أو انسخ محتواه.</p>
            </div>
          </div>

        </div>

      </div>

    </section>


    <!-- TIP -->
    <section class="tip">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>
        <strong>نصيحة</strong>

        <p>
          اترك مساحة بيضاء كافية حول الرمز عند طباعته
          للحصول على أفضل نتيجة عند المسح بالكاميرا.
        </p>
      </div>

    </section>


    <!-- FAQ -->
    <section class="faq">

      <div class="faq-title">
        <span>دليل الأداة</span>
        <h2>الأسئلة الشائعة</h2>
      </div>


      <details>
        <summary>
          هل مولد QR Code مجاني؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، الأداة مجانية ولا تحتاج إلى إنشاء حساب.
        </p>
      </details>


      <details>
        <summary>
          هل يتم حفظ البيانات؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          لا. تتم عملية إنشاء الرمز داخل المتصفح مباشرة.
        </p>
      </details>


      <details>
        <summary>
          ما أنواع البيانات المدعومة؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          النصوص والروابط والبريد الإلكتروني وأرقام الهاتف
          وشبكات Wi-Fi.
        </p>
      </details>


      <details>
        <summary>
          هل يمكن تحميل QR Code؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، يمكنك تحميله بصيغة PNG أو SVG أو نسخ المحتوى.
        </p>
      </details>

    </section>

  







<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/barcode-generator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Barcode Generator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-diff/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Diff</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-minifier/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Minifier</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/source-code-counter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Source Code Counter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Base64 Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  /* ================================
     Related Tools
     الوضع الافتراضي: فاتح
     ================================ */

  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;

    background: #ffffff;
    color: #0f172a;

    border: 1px solid rgba(15, 23, 42, 0.10);

    box-shadow:
      0 10px 30px rgba(15, 23, 42, 0.06);

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;

    color: #0284c7;

    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;

    color: #0f172a;

    font-size: 1.55rem;
    font-weight: 800;
  }

  .related-tools p {
    margin: 0;

    color: #64748b;

    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;

    gap: 12px;

    min-height: 72px;

    padding: 14px;

    border-radius: 15px;

    text-decoration: none;

    color: #0f172a;

    background: #f8fafc;

    border: 1px solid rgba(15, 23, 42, 0.08);

    box-shadow:
      0 4px 12px rgba(15, 23, 42, 0.04);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);

    color: #0f172a;

    border-color: #38bdf8;

    background: #f0f9ff;

    box-shadow:
      0 8px 20px rgba(14, 165, 233, 0.10);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    border-radius: 12px;

    color: #0284c7;

    background: rgba(14, 165, 233, 0.12);

    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;

    gap: 4px;

    min-width: 0;
  }

  .related-tool-content strong {
    color: #0f172a;

    font-size: 0.95rem;
    font-weight: 700;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    color: #64748b;

    font-size: 0.75rem;
  }


  /* ================================
     الوضع الداكن
     ================================ */

  [data-theme="dark"] .related-tools,
  html[data-theme="dark"] .related-tools,
  body[data-theme="dark"] .related-tools {
    background: #111827;
    color: #f8fafc;

    border-color: rgba(255, 255, 255, 0.08);

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.20);
  }

  [data-theme="dark"] .related-tools h2,
  html[data-theme="dark"] .related-tools h2,
  body[data-theme="dark"] .related-tools h2 {
    color: #f8fafc;
  }

  [data-theme="dark"] .related-tools p,
  html[data-theme="dark"] .related-tools p,
  body[data-theme="dark"] .related-tools p {
    color: #cbd5e1;
  }

  [data-theme="dark"] .related-tool-card,
  html[data-theme="dark"] .related-tool-card,
  body[data-theme="dark"] .related-tool-card {
    color: #f8fafc;

    background: rgba(255, 255, 255, 0.035);

    border-color: rgba(255, 255, 255, 0.08);

    box-shadow: none;
  }

  [data-theme="dark"] .related-tool-card:hover,
  html[data-theme="dark"] .related-tool-card:hover,
  body[data-theme="dark"] .related-tool-card:hover {
    color: #ffffff;

    border-color: #38bdf8;

    background: rgba(56, 189, 248, 0.08);
  }

  [data-theme="dark"] .related-tool-content strong,
  html[data-theme="dark"] .related-tool-content strong,
  body[data-theme="dark"] .related-tool-content strong {
    color: #f8fafc;
  }

  [data-theme="dark"] .related-tool-content small,
  html[data-theme="dark"] .related-tool-content small,
  body[data-theme="dark"] .related-tool-content small {
    color: #94a3b8;
  }

  [data-theme="dark"] .related-tool-icon,
  html[data-theme="dark"] .related-tool-icon,
  body[data-theme="dark"] .related-tool-icon {
    color: #38bdf8;

    background: rgba(56, 189, 248, 0.12);
  }


  /* ================================
     الوضع الفاتح — أولوية قصوى
     ================================ */

  [data-theme="light"] .related-tools,
  html[data-theme="light"] .related-tools,
  body[data-theme="light"] .related-tools {
    background: #ffffff !important;

    color: #0f172a !important;

    border-color: rgba(15, 23, 42, 0.10) !important;

    box-shadow:
      0 10px 30px rgba(15, 23, 42, 0.06) !important;
  }

