---

import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(//$/, '');

const title = 'QR Code Generator - مولد QR Code مجاني | Th.Tech';
const description =
'أنشئ QR Code للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi مع معاينة فورية وتنزيل PNG وSVG.';

const faqs = [
{
q: 'ما هو QR Code Generator؟',
a: 'أداة مجانية لإنشاء رموز QR للنصوص والروابط والبريد الإلكتروني وأرقام الهاتف وشبكات Wi-Fi مباشرة من المتصفح.'
},
{
q: 'هل يمكن إنشاء QR Code لرابط؟',
a: 'نعم، اختر رابط URL ثم أدخل الرابط، وسيتم إنشاء QR Code مباشرة.'
},
{
q: 'هل يتم إرسال البيانات إلى الخادم؟',
a: 'تتم معالجة المحتوى داخل المتصفح ولا يتم إرساله إلى خادم Th.Tech.'
},
{
q: 'هل يمكن تنزيل QR Code؟',
a: 'نعم، يمكنك تنزيله بصيغة PNG أو SVG.'
}
];

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>{title}</title>
<meta name="description" content={description} />

<link
  rel="canonical"
  href={`https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`}
/>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<script is:inline>
  try {
    const theme = localStorage.getItem('theme');

    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark-mode');
    } else {
      document.documentElement.classList.add('dark-mode');
    }
  } catch {}
</script>

<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  </head>  <body>
    <Header /><main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">

      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-angle-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-angle-left"></i>
        <span>QR Code Generator</span>
      </div>

      <div class="hero-card">

        <div class="hero-icon">
          <i class="fa-solid fa-qrcode"></i>
        </div>

        <div class="hero-content">
          <div class="hero-label">
            <span class="dot"></span>
            GENERATOR
          </div>

          <h1>QR Code Generator</h1>

          <p>
            أنشئ QR Code احترافيًا للنصوص والروابط والبريد الإلكتروني
            والهاتف وشبكات Wi-Fi بسهولة وسرعة.
          </p>

          <div class="tags">
            <span>QR Code</span>
            <span>PNG</span>
            <span>SVG</span>
            <span>Wi-Fi</span>
            <span>مجاني</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TOOL -->
  <section class="tool-section">
    <div class="container">

      <div class="tool-box">

        <!-- TOOL HEADER -->
        <div class="tool-header">

          <div class="tool-title">
            <div class="tool-title-icon">
              <i class="fa-solid fa-qrcode"></i>
            </div>

            <div>
              <h2>مولد QR Code</h2>
              <p>أنشئ رمز QR خلال ثوانٍ</p>
            </div>
          </div>

          <div class="secure-badge">
            <i class="fa-solid fa-shield-halved"></i>
            معالجة محلية
          </div>

        </div>

        <!-- ACTION BAR -->
        <div class="action-bar">

          <button class="action-btn" id="exampleBtn">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>مثال</span>
          </button>

          <button class="action-btn" id="clearBtn">
            <i class="fa-solid fa-trash-can"></i>
            <span>مسح</span>
          </button>

          <button class="action-btn" id="copyBtn">
            <i class="fa-regular fa-copy"></i>
            <span>نسخ</span>
          </button>

          <div class="action-space"></div>

          <button class="download-btn" id="pngBtn">
            <i class="fa-solid fa-download"></i>
            PNG
          </button>

          <button class="download-btn outline" id="svgBtn">
            <i class="fa-solid fa-vector-square"></i>
            SVG
          </button>

        </div>

        <!-- MAIN GRID -->
        <div class="main-grid">

          <!-- LEFT -->
          <div class="input-area">

            <div class="section-title">
              <div class="section-number">01</div>

              <div>
                <h3>المحتوى</h3>
                <p>اختر نوع البيانات وأدخل المحتوى</p>
              </div>
            </div>

            <!-- TYPES -->
            <div class="types">

              <button class="type-btn active" data-type="text">
                <i class="fa-solid fa-align-left"></i>
                <span>نص</span>
              </button>

              <button class="type-btn" data-type="url">
                <i class="fa-solid fa-link"></i>
                <span>رابط</span>
              </button>

              <button class="type-btn" data-type="email">
                <i class="fa-solid fa-envelope"></i>
                <span>بريد</span>
              </button>

              <button class="type-btn" data-type="phone">
                <i class="fa-solid fa-phone"></i>
                <span>هاتف</span>
              </button>

              <button class="type-btn" data-type="wifi">
                <i class="fa-solid fa-wifi"></i>
                <span>Wi-Fi</span>
              </button>

            </div>

            <!-- NORMAL INPUT -->
            <div id="normalInput">

              <div class="label-row">
                <label id="inputLabel" for="mainInput">
                  النص
