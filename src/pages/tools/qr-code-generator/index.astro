        var(--text);

      background:
        var(--card2);

    }


    .btn:hover {
      transform: translateY(-1px);
    }


    .message {

      min-height:
        18px;

      margin-top:
        10px;

      text-align:
        center;

      font-size:
        9px;

    }


    .message.success {
      color: var(--success);
    }


    .message.error {
      color: var(--danger);
    }


    .preview-panel {

      background:
        linear-gradient(
          145deg,
          rgba(40,184,242,.035),
          transparent 50%
        ),
        var(--card2);

    }


    .preview-head {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        12px;

    }


    .preview-head h3 {

      margin:
        7px 0 0;

      font-size:
        15px;

    }


    .preview-state {

      color:
        var(--muted2);

      font-size:
        8px;

    }


    .qr-stage {

      min-height:
        320px;

      margin-top:
        18px;

      padding:
        18px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        18px;

      border:
        1px dashed var(--border2);

      background:
        radial-gradient(
          circle,
          rgba(40,184,242,.06),
          transparent 65%
        ),
        var(--bg);

    }


    .qr-box {

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      padding:
        10px;

      background:
        #fff;

      border-radius:
        9px;

      box-shadow:
        0 12px 35px rgba(0,0,0,.2);

    }


    .qr-box img,
    .qr-box canvas {

      display:
        block;

      max-width:
        100%;

      height:
        auto;

    }


    .empty-preview {

      text-align:
        center;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--muted);

    }


    .empty-preview strong {

      color:
        var(--text);

      font-size:
        11px;

    }


    .empty-preview span {

      color:
        var(--muted2);

      font-size:
        8px;

    }


    .empty-icon {

      width:
        65px;

      height:
        65px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        17px;

      color:
        var(--primary);

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--border);

      font-size:
        25px;

    }


    .preview-info {

      display:
        flex;

      justify-content:
        space-between;

      flex-wrap:
        wrap;

      gap:
        8px;

      margin-top:
        12px;

      color:
        var(--muted2);

      font-size:
        8px;

    }


    .preview-info i {
      color: var(--success);
    }


    .download-actions {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        8px;

      margin-top:
        16px;

    }


    .download-btn {

      min-height:
        55px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      border:
        1px solid var(--border);

      border-radius:
        12px;

      background:
        var(--card);

      color:
        var(--text);

      cursor:
        pointer;

      font-family:
        inherit;

      transition:
        .2s ease;

    }


    .download-btn i {
      color: var(--primary);
    }


    .download-btn span {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-start;

    }


    .download-btn strong {
      font-size: 9px;
    }


    .download-btn small {

      color:
        var(--muted2);

      font-size:
        7px;

    }


    .download-btn:hover:not(:disabled) {

      border-color:
        var(--border2);

      transform:
        translateY(-1px);

    }


    .download-btn:disabled {

      opacity:
        .35;

      cursor:
        not-allowed;

    }


    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4,1fr);

      gap:
        10px;

      margin-top:
        16px;

    }


    .stat-card {

      min-height:
        80px;

      padding:
        14px;

      border-radius:
        15px;

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

    }


    .stat-icon {

      width:
        37px;

      height:
        37px;

      border-radius:
        10px;

    }


    .stat-card strong,
    .stat-card span {
      display: block;
    }


    .stat-card strong {
      font-size: 12px;
    }


    .stat-card span {

      color:
        var(--muted);

      font-size:
        8px;

    }


    .info-card {

      margin-top:
        16px;

      padding:
        20px;

      border-radius:
        18px;

      display:
        flex;

      gap:
        15px;

      align-items:
        flex-start;

    }


    .info-icon {

      width:
        43px;

      height:
        43px;

      border-radius:
        12px;

    }


    .info-card h2 {

      margin:
        1px 0 7px;

      font-size:
        14px;

    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      line-height:
        2;

      font-size:
        10px;

    }


    .steps {

      list-style:
        none;

      margin:
        16px 0 0;

      padding:
        0;

      display:
        grid;

      gap:
        12px;

    }


    .steps li {

      display:
        flex;

      gap:
        10px;

    }


    .steps li > span {

      width:
        27px;

      height:
        27px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        8px;

      color:
        var(--primary);

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--border);

      font-size:
        9px;

    }


    .steps strong {
      font-size: 10px;
    }


    .steps p {
      margin-top: 2px;
      font-size: 8px;
    }


    .note-card {

      background:
        linear-gradient(
          145deg,
          rgba(40,184,242,.06),
          transparent
        ),
        var(--card);

    }


    .faq {

      margin-top:
        45px;

    }


    .faq-heading {

      text-align:
        center;

      margin-bottom:
        17px;

    }


    .faq-heading span {

      color:
        var(--primary);

      font-size:
        9px;

      font-weight:
        800;

    }


    .faq-heading h2 {

      margin:
        5px 0 0;

      font-size:
        20px;

    }


    details {

      margin-bottom:
        8px;

      border:
        1px solid var(--border);

      border-radius:
        12px;

      background:
        var(--card);

      overflow:
        hidden;

    }


    summary {

      min-height:
        48px;

      padding:
        12px 15px;

      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      cursor:
        pointer;

      list-style:
        none;

      font-size:
        10px;

      font-weight:
        700;

    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {

      color:
        var(--primary);

      transition:
        .2s ease;

    }


    details[open] summary i {
      transform: rotate(45deg);
    }


    details p {

      margin:
        0;

      padding:
        0 15px 15px;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        2;

    }


    @media (max-width:850px) {

      .workspace {
        grid-template-columns: 1fr;
      }

      .input-panel {

        border-left:
          0;

        border-bottom:
          1px solid var(--border);

      }

      .stats-grid {
        grid-template-columns:
          repeat(2,1fr);
      }

    }


    @media (max-width:620px) {

      .page {

        width:
          calc(100% - 18px);

        padding:
          15px 0 50px;

      }


      .hero {
        padding: 15px 4px 24px;
      }


      .hero-icon {

        width:
          58px;

        height:
          58px;

        font-size:
          23px;

      }


      h1 {
        font-size: 26px;
      }


      .hero-description {

        font-size:
          10px;

        line-height:
          1.9;

      }


      .tool-card {
        border-radius: 18px;
      }


      .tool-header {
        padding: 17px;
      }


      .tool-header h2 {
        font-size: 16px;
      }


      .types {

        grid-template-columns:
          repeat(3,1fr);

        padding:
          12px;

      }


      .type-btn {

        min-height:
          48px;

        flex-direction:
          column;

        gap:
          3px;

        font-size:
          8px;

      }


      .input-panel,
      .preview-panel {
        padding: 16px;
      }


      .settings-grid {
        grid-template-columns: 1fr;
      }


      .actions {
        grid-template-columns: 1fr 1.5fr;
      }


      .qr-stage {

        min-height:
          270px;

        padding:
          12px;

      }


      .qr-box {

        max-width:
          100%;

        overflow:
          hidden;

      }


      .stats-grid {
        gap: 7px;
      }


      .stat-card {

        min-height:
          70px;

        padding:
          10px;

      }


      .download-btn {

        min-height:
          50px;

      }


      .download-btn span {
        display: none;
      }


      .info-card {

        padding:
          15px;

        gap:
          10px;

      }


      .info-icon {

        width:
          37px;

        height:
          37px;

      }


    }


    @media (max-width:380px) {

      .types {
        grid-template-columns:
          repeat(3,1fr);
      }


      .type-btn {
        min-height: 44px;
      }


      .tool-header {
        flex-direction: column;
      }


      .live-status {
        align-self: flex-start;
      }


      .actions {
        grid-template-columns: 1fr;
      }


      .qr-stage {
        min-height: 230px;
      }

    }

  </style>

</body>
</html>
