---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "QR Code Generator - مولد QR Code احترافي ومجاني | Th.Tech";
const description =
  "أنشئ QR Code احترافيًا للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi مع معاينة فورية وتنزيل PNG وSVG.";

const faqs = [
  {
    q: "ما هو QR Code Generator؟",
    a: "أداة مجانية لإنشاء رموز QR من النصوص والروابط والبريد الإلكتروني وأرقام الهاتف وبيانات شبكات Wi-Fi مباشرة من المتصفح."
  },
  {
    q: "هل يمكن إنشاء QR Code لرابط موقع؟",
    a: "نعم. اختر رابط وأدخل الرابط الكامل وسيتم إنشاء الرمز مباشرة."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "يتم إنشاء QR Code داخل المتصفح ولا تحتاج بيانات المحتوى إلى إرسالها إلى خادم Th.Tech."
  },
  {
    q: "ما مستويات تصحيح الأخطاء؟",
    a: "يمكنك اختيار L أو M أو Q أو H حسب مستوى تحمل QR Code للتلف أو التغطية."
  },
  {
    q: "ما الصيغ التي يمكن تنزيلها؟",
    a: "يمكن تنزيل QR Code بصيغة PNG أو SVG."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    try {
      const theme = localStorage.getItem("theme");

      if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
        document.documentElement.classList.remove("dark-mode");
      } else {
        document.documentElement.classList.add("dark-mode");
      }
    } catch (e) {}
  </script>

  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>QR Code Generator</span>
        </div>

        <div class="hero-layout">

          <div class="hero-icon">
            <i class="fa-solid fa-qrcode"></i>
          </div>

          <div class="hero-content">

            <div class="eyebrow">
              <span></span>
              GENERATOR TOOL
            </div>

            <h1>QR Code Generator</h1>

            <p>
              أنشئ رمز QR احترافيًا للنصوص والروابط والبريد الإلكتروني
              والهاتف وشبكات Wi-Fi مع معاينة مباشرة وتنزيل PNG وSVG.
            </p>

            <div class="hero-tags">
              <span>QR Code</span>
              <span>PNG</span>
              <span>SVG</span>
              <span>Wi-Fi</span>
              <span>Live Preview</span>
            </div>

          </div>
        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="tool-card">

          <div class="tool-header">

            <div class="tool-brand">

              <div class="tool-brand-icon">
                <i class="fa-solid fa-qrcode"></i>
              </div>

              <div>
                <strong>QR Code Generator</strong>
                <small>Professional QR Creator</small>
              </div>

            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              يعمل داخل المتصفح
            </div>

          </div>


          <div class="toolbar">

            <button id="exampleBtn" class="action-button">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              مثال
            </button>

            <button id="clearBtn" class="action-button">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="action-button">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <div class="toolbar-space"></div>

            <button id="pngBtn" class="download-button">
              <i class="fa-solid fa-download"></i>
              PNG
            </button>

            <button id="svgBtn" class="download-button secondary">
              <i class="fa-solid fa-vector-square"></i>
              SVG
            </button>

          </div>


          <div class="tool-grid">

            <!-- INPUT -->
            <div class="input-panel">

              <div class="panel-title">

                <div class="panel-title-left">
                  <span class="number">01</span>

                  <div>
                    <strong>المحتوى</strong>
                    <small>اختر نوع البيانات</small>
                  </div>
                </div>

                <span class="live">
                  <span></span>
                  LIVE
                </span>

              </div>


              <!-- TYPES -->
              <div class="types">

                <button class="type active" data-type="text">
                  <i class="fa-solid fa-align-left"></i>
                  <span>نص</span>
                </button>

                <button class="type" data-type="url">
                  <i class="fa-solid fa-link"></i>
                  <span>رابط</span>
                </button>

                <button class="type" data-type="email">
                  <i class="fa-solid fa-envelope"></i>
                  <span>Email</span>
                </button>

                <button class="type" data-type="phone">
                  <i class="fa-solid fa-phone"></i>
                  <span>هاتف</span>
                </button>

                <button class="type" data-type="wifi">
                  <i class="fa-solid fa-wifi"></i>
                  <span>Wi-Fi</span>
                </button>

              </div>


              <!-- NORMAL -->
              <div id="normalBox">

                <div class="field">

                  <div class="field-head">
                    <label id="mainLabel" for="mainInput">
                      النص
                    </label>

                    <span id="counter">0 حرف</span>
                  </div>

                  <textarea
                    id="mainInput"
                    rows="8"
                    spellcheck="false"
                    placeholder="اكتب النص الذي تريد تحويله إلى QR Code..."
                  ></textarea>

                  <small id="help">
                    أدخل أي نص تريد مشاركته.
                  </small>

                </div>

              </div>


              <!-- WIFI -->
              <div id="wifiBox" class="wifi-box">

                <div class="field">

                  <label for="wifiName">اسم الشبكة</label>

                  <input
                    id="wifiName"
                    type="text"
                    placeholder="My WiFi"
                    autocomplete="off"
                  />

                </div>

                <div class="field">

                  <label for="wifiPassword">كلمة المرور</label>

                  <input
                    id="wifiPassword"
                    type="text"
                    placeholder="Password"
                    autocomplete="off"
                  />

                </div>

                <div class="field full">

                  <label for="wifiSecurity">نوع الحماية</label>

                  <select id="wifiSecurity">
                    <option value="WPA">WPA / WPA2 / WPA3</option>
                    <option value="WEP">WEP</option>
                    <option value="nopass">بدون كلمة مرور</option>
                  </select>

                </div>

              </div>


              <!-- SETTINGS -->
              <div class="settings">

                <div class="settings-title">
                  <i class="fa-solid fa-sliders"></i>
                  إعدادات QR Code
                </div>

                <div class="settings-grid">

                  <div class="field">
                    <label for="size">الحجم</label>

                    <select id="size">
                      <option value="200">200 × 200</option>
                      <option value="300" selected>300 × 300</option>
                      <option value="400">400 × 400</option>
                      <option value="500">500 × 500</option>
                      <option value="600">600 × 600</option>
                    </select>
                  </div>

                  <div class="field">
                    <label for="margin">الهامش</label>

                    <select id="margin">
                      <option value="1">صغير</option>
                      <option value="2" selected>متوسط</option>
                      <option value="4">كبير</option>
                      <option value="6">واسع</option>
                    </select>
                  </div>

                  <div class="field">
                    <label for="errorLevel">التصحيح</label>

                    <select id="errorLevel">
                      <option value="L">L — 7%</option>
                      <option value="M" selected>M — 15%</option>
                      <option value="Q">Q — 25%</option>
                      <option value="H">H — 30%</option>
                    </select>
                  </div>

                </div>

              </div>


              <!-- EXAMPLES -->
              <div class="examples">

                <div class="examples-title">
                  <i class="fa-solid fa-bolt"></i>
                  أمثلة سريعة
                </div>

                <div class="example-list">

                  <button data-example="url">موقع</button>
                  <button data-example="text">نص</button>
                  <button data-example="email">Email</button>
                  <button data-example="phone">هاتف</button>
                  <button data-example="wifi">Wi-Fi</button>

                </div>

              </div>

            </div>


            <!-- PREVIEW -->
            <div class="preview-panel">

              <div class="panel-title">

                <div class="panel-title-left">
                  <span class="number">02</span>

                  <div>
                    <strong>المعاينة</strong>
                    <small>QR Code الناتج</small>
                  </div>
                </div>

                <span id="status" class="status ready">
                  <span></span>
                  جاهز
                </span>

              </div>


              <div class="qr-area">

                <div class="qr-box">

                  <canvas id="qrCanvas"></canvas>

                  <div id="empty" class="empty">

                    <div class="empty-icon">
                      <i class="fa-solid fa-qrcode"></i>
                    </div>

                    <strong>ابدأ بكتابة المحتوى</strong>

                    <span>
                      سيظهر QR Code هنا تلقائيًا
                    </span>

                  </div>

                </div>

              </div>


              <div class="meta">

                <div>
                  <span>النوع</span>
                  <strong id="metaType">TEXT</strong>
                </div>

                <div>
                  <span>الحجم</span>
                  <strong id="metaSize">300px</strong>
                </div>

                <div>
                  <span>التصحيح</span>
                  <strong id="metaError">M</strong>
                </div>

              </div>


              <div class="preview-buttons">

                <button id="mainPng" class="main-download">
                  <i class="fa-solid fa-download"></i>
                  تنزيل PNG
                </button>

                <button id="mainSvg" class="outline-download">
                  <i class="fa-solid fa-vector-square"></i>
                  تنزيل SVG
                </button>

              </div>


              <div id="message" class="message">

                <div class="message-icon">
                  <i class="fa-solid fa-circle-check"></i>
                </div>

                <div>
                  <strong id="messageTitle">جاهز</strong>
                  <span id="messageText">
                    أدخل المحتوى لإنشاء QR Code.
                  </span>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FEATURES -->
    <section class="section">
      <div class="container">

        <div class="section-heading">

          <span>FEATURES</span>

          <h2>مولد QR Code احترافي</h2>

          <p>
            أدوات بسيطة وسريعة لإنشاء رموز QR للاستخدام الشخصي والعملي.
          </p>

        </div>


        <div class="features">

          <article>
            <div class="feature-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>إنشاء فوري</h3>

            <p>
              يتم تحديث QR Code مباشرة عند تغيير المحتوى.
            </p>
          </article>


          <article>
            <div class="feature-icon">
              <i class="fa-solid fa-file-image"></i>
            </div>

            <h3>PNG و SVG</h3>

            <p>
              تنزيل مناسب للمشاركة الرقمية والطباعة.
            </p>
          </article>


          <article>
            <div class="feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>معالجة محلية</h3>

            <p>
              يتم إنشاء الرمز داخل المتصفح.
            </p>
          </article>


          <article>
            <div class="feature-icon">
              <i class="fa-solid fa-mobile-screen-button"></i>
            </div>

            <h3>متجاوب</h3>

            <p>
              يعمل على الهاتف والكمبيوتر واللوحي.
            </p>
          </article>

        </div>

      </div>
    </section>


    <!-- HOW -->
    <section class="how">

      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>كيف تستخدم الأداة؟</h2>

        </div>


        <div class="steps">

          <div class="step">

            <div>01</div>

            <section>
              <h3>اختر نوع المحتوى</h3>
              <p>
                اختر النص أو الرابط أو البريد أو الهاتف أو Wi-Fi.
              </p>
            </section>

          </div>


          <div class="step">

            <div>02</div>

            <section>
              <h3>أدخل البيانات</h3>
              <p>
                أدخل المحتوى وستظهر المعاينة مباشرة.
              </p>
            </section>

          </div>


          <div class="step">

            <div>03</div>

            <section>
              <h3>نزّل QR Code</h3>
              <p>
                اختر PNG أو SVG واحفظ الرمز على جهازك.
              </p>
            </section>

          </div>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="section faq-section">

      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>الأسئلة الشائعة</h2>

        </div>


        <div class="faq">

          {faqs.map((faq) => (
            <details>
              <summary>
                <span>{faq.q}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>{faq.a}</p>
            </details>
          ))}

        </div>

      </div>

    </section>

  </main>

  <Footer />


  <!-- APPLICATION SCRIPT -->
  <script>
    const mainInput = document.getElementById("mainInput");
    const mainLabel = document.getElementById("mainLabel");
    const help = document.getElementById("help");
    const counter = document.getElementById("counter");

    const normalBox = document.getElementById("normalBox");
    const wifiBox = document.getElementById("wifiBox");

    const wifiName = document.getElementById("wifiName");
    const wifiPassword = document.getElementById("wifiPassword");
    const wifiSecurity = document.getElementById("wifiSecurity");

    const qrCanvas = document.getElementById("qrCanvas");
    const empty = document.getElementById("empty");

    const size = document.getElementById("size");
    const margin = document.getElementById("margin");
    const errorLevel = document.getElementById("errorLevel");

    const status = document.getElementById("status");
    const message = document.getElementById("message");
    const messageIcon = message.querySelector("i");

    const messageTitle = document.getElementById("messageTitle");
    const messageText = document.getElementById("messageText");

    const metaType = document.getElementById("metaType");
    const metaSize = document.getElementById("metaSize");
    const metaError = document.getElementById("metaError");

    const types = document.querySelectorAll(".type");
    const examples = document.querySelectorAll("[data-example]");

    let currentType = "text";
    let currentPayload = "";
    let timer = null;


    const labels = {
      text: {
        label: "النص",
        placeholder: "اكتب النص الذي تريد تحويله إلى QR Code...",
        help: "أدخل أي نص تريد مشاركته."
      },

      url: {
        label: "رابط URL",
        placeholder: "https://example.com",
        help: "استخدم رابطًا يبدأ بـ http:// أو https://."
      },

      email: {
        label: "البريد الإلكتروني",
        placeholder: "hello@example.com",
        help: "أدخل عنوان بريد إلكتروني صالحًا."
      },

      phone: {
        label: "رقم الهاتف",
        placeholder: "+212600000000",
        help: "يمكنك استخدام رقم هاتف دولي."
      }
    };


    function setStatus(type, title, text) {

      status.className = "status " + type;

      status.innerHTML = "<span></span>" + title;

      message.className = "message " + type;

      if (type === "success") {
        messageIcon.className = "fa-solid fa-circle-check";
      } else if (type === "error") {
        messageIcon.className = "fa-solid fa-circle-xmark";
      } else if (type === "loading") {
        messageIcon.className = "fa-solid fa-spinner fa-spin";
      } else {
        messageIcon.className = "fa-solid fa-circle";
      }

      messageTitle.textContent = title;
      messageText.textContent = text;
    }


    function getPayload() {

      if (currentType !== "wifi") {
        return mainInput.value.trim();
      }

      const ssid = wifiName.value.trim();
      const password = wifiPassword.value;

      if (!ssid) {
        return "";
      }

      const security = wifiSecurity.value;

      const safeSsid = ssid
        .replace(/\\/g, "\\\\")
        .replace(/;/g, "\\;")
        .replace(/,/g, "\\,")
        .replace(/:/g, "\\:");

      const safePassword = password
        .replace(/\\/g, "\\\\")
        .replace(/;/g, "\\;")
        .replace(/,/g, "\\,")
        .replace(/:/g, "\\:");

      return "WIFI:T:" +
        security +
        ";S:" +
        safeSsid +
        ";P:" +
        safePassword +
        ";;";
    }


    function validate(value) {

      if (!value) {
        return {
          valid: false,
          text: "أدخل المحتوى أولاً."
        };
      }


      if (currentType === "url") {

        try {

          const url = new URL(value);

          if (
            url.protocol !== "http:" &&
            url.protocol !== "https:"
          ) {
            return {
              valid: false,
              text: "يجب أن يبدأ الرابط بـ http:// أو https://."
            };
          }

        } catch (e) {

          return {
            valid: false,
            text: "الرابط المدخل غير صالح."
          };

        }

      }


      if (currentType === "email") {

        const pattern =
          /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

        if (!pattern.test(value)) {
          return {
            valid: false,
            text: "أدخل بريدًا إلكترونيًا صحيحًا."
          };
        }

      }


      if (currentType === "phone") {

        const phone =
          value.replace(/[\s\-().]/g, "");

        if (!/^\+?[0-9]{6,18}$/.test(phone)) {
          return {
            valid: false,
            text: "رقم الهاتف غير صالح."
          };
        }

      }


      return {
        valid: true,
        text: ""
      };
    }


    function typeName() {

      const names = {
        text: "TEXT",
        url: "URL",
        email: "EMAIL",
        phone: "PHONE",
        wifi: "WI-FI"
      };

      return names[currentType];
    }


    function updateType() {

      types.forEach(function(button) {

        button.classList.toggle(
          "active",
          button.dataset.type === currentType
        );

      });


      if (currentType === "wifi") {

        normalBox.style.display = "none";
        wifiBox.style.display = "grid";

      } else {

        normalBox.style.display = "block";
        wifiBox.style.display = "none";

        mainLabel.textContent =
          labels[currentType].label;

        mainInput.placeholder =
          labels[currentType].placeholder;

        help.textContent =
          labels[currentType].help;

      }


      generate();
    }


    function generate() {

      clearTimeout(timer);

      timer = setTimeout(function() {
        generateNow();
      }, 80);

    }


    function generateNow() {

      const payload = getPayload();

      currentPayload = payload;

      const qrSize = Number(size.value);
      const qrMargin = Number(margin.value);
      const qrError = errorLevel.value;


      metaType.textContent = typeName();
      metaSize.textContent = qrSize + "px";
      metaError.textContent = qrError;

      counter.textContent =
        payload.length.toLocaleString("ar-MA") + " حرف";


      if (!payload) {

        qrCanvas.style.display = "none";
        empty.style.display = "flex";

        setStatus(
          "ready",
          "جاهز",
          "أدخل المحتوى لإنشاء QR Code."
        );

        return;
      }


      const result = validate(payload);


      if (!result.valid) {

        qrCanvas.style.display = "none";
        empty.style.display = "flex";

        setStatus(
          "error",
          "بيانات غير صالحة",
          result.text
        );

        return;
      }


      if (
        !window.QRCode ||
        typeof window.QRCode.toCanvas !== "function"
      ) {

        setStatus(
          "error",
          "المكتبة غير متاحة",
          "تعذر تحميل محرك QR Code. أعد تحميل الصفحة."
        );

        return;
      }


      setStatus(
        "loading",
        "يتم الإنشاء",
        "جارٍ إنشاء QR Code..."
      );


      window.QRCode.toCanvas(
        qrCanvas,
        payload,
        {
          width: qrSize,
          margin: qrMargin,
          errorCorrectionLevel: qrError,

          color: {
            dark: "#081c25",
            light: "#ffffff"
          }
        },

        function(error) {

          if (error) {

            qrCanvas.style.display = "none";
            empty.style.display = "flex";

            setStatus(
              "error",
              "تعذر الإنشاء",
              "تعذر إنشاء QR Code لهذا المحتوى."
            );

            return;
          }


          empty.style.display = "none";
          qrCanvas.style.display = "block";

          setStatus(
            "success",
            "تم الإنشاء",
            "QR Code جاهز للتنزيل."
          );

        }
      );

    }


    function downloadPNG() {

      if (!currentPayload) {

        setStatus(
          "error",
          "لا يوجد محتوى",
          "أدخل المحتوى أولاً."
        );

        return;
      }


      if (qrCanvas.style.display === "none") {
        generateNow();
        return;
      }


      const link =
        document.createElement("a");

      link.download =
        "th-tech-qr-code.png";

      link.href =
        qrCanvas.toDataURL("image/png");

      document.body.appendChild(link);

      link.click();

      link.remove();


      setStatus(
        "success",
        "تم التنزيل",
        "تم حفظ QR Code بصيغة PNG."
      );

    }


    function downloadSVG() {

      if (!currentPayload) {

        setStatus(
          "error",
          "لا يوجد محتوى",
          "أدخل المحتوى أولاً."
        );

        return;
      }


      if (
        !window.QRCode ||
        typeof window.QRCode.toString !== "function"
      ) {

        setStatus(
          "error",
          "المكتبة غير متاحة",
          "تعذر تحميل محرك QR Code."
        );

        return;
      }


      window.QRCode.toString(
        currentPayload,
        {
          type: "svg",
          margin: Number(margin.value),
          errorCorrectionLevel: errorLevel.value,

          color: {
            dark: "#081c25",
            light: "#ffffff"
          }
        },

        function(error, svg) {

          if (error) {

            setStatus(
              "error",
              "تعذر التنزيل",
              "حدث خطأ أثناء إنشاء SVG."
            );

            return;
          }


          const blob =
            new Blob(
              [svg],
              {
                type: "image/svg+xml;charset=utf-8"
              }
            );


          const url =
            URL.createObjectURL(blob);

          const link =
            document.createElement("a");

          link.download =
            "th-tech-qr-code.svg";

          link.href = url;

          document.body.appendChild(link);

          link.click();

          link.remove();

          URL.revokeObjectURL(url);


          setStatus(
            "success",
            "تم التنزيل",
            "تم حفظ QR Code بصيغة SVG."
          );

        }
      );

    }


    async function copyContent() {

      const value = getPayload();

      if (!value) {

        setStatus(
          "error",
          "لا يوجد محتوى",
          "أدخل المحتوى أولاً."
        );

        return;
      }


      try {

        await navigator.clipboard.writeText(value);

        setStatus(
          "success",
          "تم النسخ",
          "تم نسخ محتوى QR Code."
        );

      } catch (e) {

        setStatus(
          "error",
          "تعذر النسخ",
          "المتصفح لم يسمح بالوصول إلى الحافظة."
        );

      }

    }


    function loadExample(type) {

      currentType = type;


      if (type === "text") {

        mainInput.value =
          "مرحباً بك في Th.Tech - منصة تقنية مجانية.";

      }


      if (type === "url") {

        mainInput.value =
          "https://oumaystore-hub.github.io/Th-tech/";

      }


      if (type === "email") {

        mainInput.value =
          "hello@example.com";

      }


      if (type === "phone") {

        mainInput.value =
          "+212600000000";

      }


      if (type === "wifi") {

        wifiName.value =
          "Th-Tech WiFi";

        wifiPassword.value =
          "ThTech2026";

        wifiSecurity.value =
          "WPA";

      }


      updateType();

    }


    function clearAll() {

      currentType = "text";

      mainInput.value = "";

      wifiName.value = "";
      wifiPassword.value = "";
      wifiSecurity.value = "WPA";

      size.value = "300";
      margin.value = "2";
      errorLevel.value = "M";

      currentPayload = "";

      updateType();

      setStatus(
        "ready",
        "جاهز",
        "أدخل المحتوى لإنشاء QR Code."
      );

    }


    types.forEach(function(button) {

      button.addEventListener(
        "click",
        function() {

          currentType =
            button.dataset.type;

          updateType();

        }
      );

    });


    examples.forEach(function(button) {

      button.addEventListener(
        "click",
        function() {

          loadExample(
            button.dataset.example
          );

        }
      );

    });


    mainInput.addEventListener(
      "input",
      generate
    );

    wifiName.addEventListener(
      "input",
      generate
    );

    wifiPassword.addEventListener(
      "input",
      generate
    );

    wifiSecurity.addEventListener(
      "change",
      generate
    );

    size.addEventListener(
      "change",
      generate
    );

    margin.addEventListener(
      "change",
      generate
    );

    errorLevel.addEventListener(
      "change",
      generate
    );


    document
      .getElementById("pngBtn")
      .addEventListener(
        "click",
        downloadPNG
      );

    document
      .getElementById("mainPng")
      .addEventListener(
        "click",
        downloadPNG
      );

    document
      .getElementById("svgBtn")
      .addEventListener(
        "click",
        downloadSVG
      );

    document
      .getElementById("mainSvg")
      .addEventListener(
        "click",
        downloadSVG
      );

    document
      .getElementById("copyBtn")
      .addEventListener(
        "click",
        copyContent
      );

    document
      .getElementById("exampleBtn")
      .addEventListener(
        "click",
        function() {
          loadExample("url");
        }
      );

    document
      .getElementById("clearBtn")
      .addEventListener(
        "click",
        clearAll
      );


    updateType();

  </script>


