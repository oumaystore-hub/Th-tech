---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QR Code Generator | Th.Tech</title>
  <meta name="description" content="مولد QR Code احترافي لإنشاء رموز QR للنصوص والروابط والبريد الإلكتروني والهاتف وشبكات Wi-Fi." />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js" defer></script>
</head>

<body>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="crumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>QR Code Generator</span>
        </div>

        <div class="hero-grid">
          <div class="hero-icon">
            <i class="fa-solid fa-qrcode"></i>
          </div>

          <div class="hero-copy">
            <span class="eyebrow">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              أدوات الترميز
            </span>
            <h1>مولد <span>QR Code</span> احترافي</h1>
            <p>
              أنشئ رمز QR بسرعة للنصوص والروابط والبريد الإلكتروني والهاتف
              وشبكات Wi-Fi مع معاينة مباشرة وتنزيل PNG أو SVG.
            </p>

            <div class="tags">
              <span><i class="fa-solid fa-bolt"></i> مباشر</span>
              <span><i class="fa-solid fa-lock"></i> محلي</span>
              <span><i class="fa-solid fa-download"></i> PNG / SVG</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-section">
      <div class="tool-card">

        <div class="tool-head">
          <div>
            <div class="tool-label">
              <span>QR</span>
              <span>GENERATOR</span>
            </div>
            <h2>أنشئ رمز QR الخاص بك</h2>
            <p>أدخل البيانات وسيتم تحديث الرمز مباشرة.</p>
          </div>

          <div class="live">
            <span></span>
            مباشر
          </div>
        </div>

        <div class="workspace">

          <div class="panel settings-panel">
            <div class="section-title">
              <b>01</b>
              <div>
                <strong>المحتوى</strong>
                <small>اختر نوع البيانات وأدخلها</small>
              </div>
            </div>

            <div class="field">
              <label>نوع QR Code</label>
              <div class="type-grid">
                <button class="type-btn active" data-type="text" type="button">
                  <i class="fa-solid fa-font"></i>
                  <span>نص</span>
                </button>
                <button class="type-btn" data-type="url" type="button">
                  <i class="fa-solid fa-link"></i>
                  <span>رابط</span>
                </button>
                <button class="type-btn" data-type="email" type="button">
                  <i class="fa-solid fa-envelope"></i>
                  <span>بريد</span>
                </button>
                <button class="type-btn" data-type="phone" type="button">
                  <i class="fa-solid fa-phone"></i>
                  <span>هاتف</span>
                </button>
                <button class="type-btn" data-type="wifi" type="button">
                  <i class="fa-solid fa-wifi"></i>
                  <span>Wi-Fi</span>
                </button>
              </div>
            </div>

            <div id="dynamicFields"></div>

            <div class="divider"></div>

            <div class="section-title small-title">
              <b>02</b>
              <div>
                <strong>الإعدادات</strong>
                <small>تخصيص حجم ودقة الرمز</small>
              </div>
            </div>

            <div class="settings-grid">
              <div class="field">
                <label for="size">الحجم</label>
                <select id="size">
                  <option value="180">180 × 180</option>
                  <option value="220" selected>220 × 220</option>
                  <option value="280">280 × 280</option>
                  <option value="360">360 × 360</option>
                  <option value="500">500 × 500</option>
                </select>
              </div>

              <div class="field">
                <label for="margin">الهامش</label>
                <select id="margin">
                  <option value="1">صغير</option>
                  <option value="2" selected>متوسط</option>
                  <option value="4">كبير</option>
                  <option value="6">واسع</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="errorLevel">تصحيح الأخطاء</label>
              <select id="errorLevel">
                <option value="L">L — منخفض</option>
                <option value="M" selected>M — متوسط</option>
                <option value="Q">Q — مرتفع</option>
                <option value="H">H — عالٍ جداً</option>
              </select>
            </div>

            <div class="actions">
              <button id="resetBtn" class="btn secondary" type="button">
                <i class="fa-solid fa-rotate-left"></i>
                إعادة ضبط
              </button>
              <button id="copyBtn" class="btn primary" type="button">
                <i class="fa-regular fa-copy"></i>
                نسخ البيانات
              </button>
            </div>

            <div id="status" class="status">
              <i class="fa-solid fa-circle-check"></i>
              جاهز لإنشاء رمز QR
            </div>
          </div>

          <div class="panel preview-panel">
            <div class="section-title">
              <b>03</b>
              <div>
                <strong>المعاينة</strong>
                <small>الرمز الناتج يظهر هنا مباشرة</small>
              </div>
            </div>

            <div class="qr-stage">
              <div class="qr-box">
                <canvas id="qrCanvas" width="220" height="220"></canvas>
              </div>
              <div id="emptyState" class="empty-state">
                <i class="fa-solid fa-qrcode"></i>
                <span>أدخل البيانات لإنشاء QR Code</span>
              </div>
            </div>

            <div class="preview-info">
              <div>
                <span>الحالة</span>
                <strong id="qrState">جاهز</strong>
              </div>
              <div>
                <span>الحجم</span>
                <strong id="qrSize">220 px</strong>
              </div>
              <div>
                <span>النوع</span>
                <strong id="qrType">نص</strong>
              </div>
            </div>

            <div class="download-actions">
              <button id="pngBtn" class="download-btn" type="button">
                <i class="fa-solid fa-image"></i>
                <span>
                  <strong>تنزيل PNG</strong>
                  <small>صورة عالية الجودة</small>
                </span>
                <i class="fa-solid fa-arrow-down"></i>
              </button>

              <button id="svgBtn" class="download-btn" type="button">
                <i class="fa-solid fa-file-code"></i>
                <span>
                  <strong>تنزيل SVG</strong>
                  <small>صيغة متجهة قابلة للتكبير</small>
                </span>
                <i class="fa-solid fa-arrow-down"></i>
              </button>
            </div>
          </div>

        </div>

        <div class="privacy">
          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <div>
            <strong>خصوصيتك محفوظة</strong>
            <p>
              يتم إنشاء رمز QR داخل متصفحك. لا يتم إرسال البيانات إلى خادم.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="info-grid">

        <article class="info-card">
          <div class="info-icon"><i class="fa-solid fa-circle-info"></i></div>
          <h3>ما هو QR Code؟</h3>
          <p>
            رمز QR هو رمز ثنائي الأبعاد يمكن للهواتف والكاميرات قراءته للوصول
            بسرعة إلى معلومات مثل الروابط والنصوص وبيانات الاتصال وشبكات Wi-Fi.
          </p>
        </article>

        <article class="info-card">
          <div class="info-icon"><i class="fa-solid fa-list-check"></i></div>
          <h3>طريقة الاستخدام</h3>
          <ol>
            <li>اختر نوع البيانات.</li>
            <li>أدخل المحتوى المطلوب.</li>
            <li>خصص الحجم ودقة التصحيح.</li>
            <li>حمّل PNG أو SVG.</li>
          </ol>
        </article>

        <article class="info-card">
          <div class="info-icon"><i class="fa-solid fa-lightbulb"></i></div>
          <h3>نصيحة</h3>
          <p>
            إذا كان الرمز سيُطبع أو سيُستخدم في ظروف صعبة، اختر مستوى تصحيح
            أخطاء أعلى وحافظ على مساحة بيضاء حول الرمز.
          </p>
        </article>

      </div>
    </section>

    <section class="faq-section">
      <div class="section-heading">
        <span>FAQ</span>
        <h2>الأسئلة الشائعة</h2>
      </div>

      <div class="faq">
        <details>
          <summary>هل يتم إرسال البيانات إلى الإنترنت؟ <i class="fa-solid fa-plus"></i></summary>
          <p>لا. عملية إنشاء الرمز تتم محلياً داخل متصفحك.</p>
        </details>

        <details>
          <summary>هل يمكن تنزيل الرمز بجودة عالية؟ <i class="fa-solid fa-plus"></i></summary>
          <p>نعم، يمكنك تنزيله بصيغة PNG أو SVG. صيغة SVG مناسبة للطباعة والتكبير.</p>
        </details>

        <details>
          <summary>هل يدعم شبكات Wi-Fi؟ <i class="fa-solid fa-plus"></i></summary>
          <p>نعم. اختر Wi-Fi وأدخل اسم الشبكة وكلمة المرور ونوع الحماية.</p>
        </details>

        <details>
          <summary>ما مستوى تصحيح الأخطاء المناسب؟ <i class="fa-solid fa-plus"></i></summary>
          <p>المستوى M مناسب لمعظم الاستخدامات، بينما H مناسب للطباعة والاستخدامات التي قد يتعرض فيها الرمز للتلف.</p>
        </details>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    :root {
      --bg: #07111f;
      --bg2: #0b1728;
      --card: #0e1b2d;
      --card2: #111f33;
      --text: #f2f7ff;
      --muted: #91a4bc;
      --border: rgba(148, 190, 230, .14);
      --primary: #38bdf8;
      --primary2: #0ea5e9;
      --accent: #67e8f9;
      --input: #081525;
      --shadow: 0 22px 70px rgba(0,0,0,.25);
    }

    :global(html[data-theme="light"]) {
      --bg: #f4f9ff;
      --bg2: #ffffff;
      --card: #ffffff;
      --card2: #f7fbff;
      --text: #102033;
      --muted: #62758b;
      --border: rgba(23, 73, 116, .13);
      --primary: #0284c7;
      --primary2: #0369a1;
      --accent: #0891b2;
      --input: #f5f9fd;
      --shadow: 0 18px 55px rgba(30,70,110,.10);
    }

    :global(html:not(.dark-mode):not([data-theme="dark"])) {
      --bg: #f4f9ff;
      --bg2: #ffffff;
      --card: #ffffff;
      --card2: #f7fbff;
      --text: #102033;
      --muted: #62758b;
      --border: rgba(23, 73, 116, .13);
      --primary: #0284c7;
      --primary2: #0369a1;
      --accent: #0891b2;
      --input: #f5f9fd;
      --shadow: 0 18px 55px rgba(30,70,110,.10);
    }

    :global(html.dark-mode) {
      --bg: #07111f;
      --bg2: #0b1728;
      --card: #0e1b2d;
      --card2: #111f33;
      --text: #f2f7ff;
      --muted: #91a4bc;
      --border: rgba(148, 190, 230, .14);
      --primary: #38bdf8;
      --primary2: #0ea5e9;
      --accent: #67e8f9;
      --input: #081525;
      --shadow: 0 22px 70px rgba(0,0,0,.25);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at 85% 5%, rgba(14,165,233,.10), transparent 28rem),
        radial-gradient(circle at 10% 45%, rgba(56,189,248,.06), transparent 25rem),
        var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      transition: background .25s ease, color .25s ease;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .hero {
      padding: 48px 20px 35px;
      border-bottom: 1px solid var(--border);
    }

    .hero-inner,
    .tool-section,
    .info-section,
    .faq-section {
      width: min(1180px, calc(100% - 32px));
      margin-inline: auto;
    }

    .crumb {
      display: flex;
      align-items: center;
      gap: 9px;
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }

    .crumb a {
      color: var(--muted);
      text-decoration: none;
    }

    .crumb a:hover {
      color: var(--primary);
    }

    .crumb i {
      font-size: 9px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 108px 1fr;
      gap: 25px;
      align-items: center;
    }

    .hero-icon {
      width: 108px;
      height: 108px;
      border-radius: 28px;
      display: grid;
      place-items: center;
      font-size: 48px;
      color: var(--primary);
      background: linear-gradient(145deg, rgba(56,189,248,.18), rgba(14,165,233,.04));
      border: 1px solid rgba(56,189,248,.24);
      box-shadow: 0 18px 55px rgba(14,165,233,.10);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--primary);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .3px;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0;
      font-size: clamp(30px, 5vw, 48px);
      line-height: 1.2;
      font-weight: 800;
    }

    h1 span {
      color: var(--primary);
    }

    .hero-copy p {
      color: var(--muted);
      line-height: 1.9;
      font-size: 15px;
      max-width: 760px;
      margin: 12px 0 16px;
    }

    .tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tags span {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 999px;
      padding: 6px 11px;
      color: var(--muted);
      font-size: 11px;
    }

    .tags i {
      color: var(--primary);
      margin-left: 4px;
    }

    .tool-section {
      padding: 35px 0;
    }

    .tool-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 25px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .tool-head {
      padding: 25px 28px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(56,189,248,.05), transparent);
    }

    .tool-label {
      display: flex;
      gap: 7px;
      color: var(--primary);
      font: 600 10px "JetBrains Mono", monospace;
      letter-spacing: 1.2px;
      margin-bottom: 7px;
    }

    .tool-head h2 {
      margin: 0;
      font-size: 22px;
    }

    .tool-head p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .live {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      border-radius: 999px;
      color: #22c55e;
      background: rgba(34,197,94,.08);
      border: 1px solid rgba(34,197,94,.18);
      font-size: 11px;
      white-space: nowrap;
    }

    .live span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34,197,94,.10);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      50% { opacity: .35; }
    }

    .workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .panel {
      padding: 28px;
    }

    .settings-panel {
      border-left: 1px solid var(--border);
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
    }

    .section-title b {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      color: var(--primary);
      background: rgba(56,189,248,.09);
      border: 1px solid rgba(56,189,248,.14);
      font: 600 11px "JetBrains Mono", monospace;
    }

    .section-title strong {
      display: block;
      font-size: 16px;
    }

    .section-title small {
      color: var(--muted);
      font-size: 11px;
    }

    .small-title {
      margin-top: 22px;
    }

    .field {
      margin-bottom: 16px;
    }

    .field label {
      display: block;
      margin-bottom: 8px;
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
    }

    .type-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 7px;
    }

    .type-btn {
      min-height: 68px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--input);
      color: var(--muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: .2s ease;
      font-size: 11px;
    }

    .type-btn i {
      font-size: 17px;
    }

    .type-btn:hover,
    .type-btn.active {
      color: var(--primary);
      border-color: rgba(56,189,248,.45);
      background: rgba(56,189,248,.08);
      transform: translateY(-1px);
    }

    input,
    textarea,
    select {
      width: 100%;
      color: var(--text);
      background: var(--input);
      border: 1px solid var(--border);
      outline: none;
      border-radius: 11px;
      padding: 11px 13px;
      min-height: 47px;
      transition: .2s ease;
    }

    textarea {
      resize: vertical;
      min-height: 125px;
      line-height: 1.8;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(56,189,248,.08);
    }

    .input-hint {
      color: var(--muted);
      font-size: 10px;
      margin-top: 6px;
    }

    .settings-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .divider {
      height: 1px;
      background: var(--border);
      margin: 22px 0;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 20px;
    }

    .btn {
      border: 0;
      min-height: 46px;
      border-radius: 11px;
      font-weight: 700;
      font-size: 12px;
      transition: .2s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn i {
      margin-left: 5px;
    }

    .btn.primary {
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary2));
      box-shadow: 0 9px 25px rgba(14,165,233,.20);
    }

    .btn.secondary {
      color: var(--text);
      background: var(--input);
      border: 1px solid var(--border);
    }

    .status {
      margin-top: 12px;
      padding: 10px 12px;
      border-radius: 10px;
      color: var(--muted);
      background: var(--input);
      border: 1px solid var(--border);
      font-size: 11px;
    }

    .status i {
      color: #22c55e;
      margin-left: 5px;
    }

    .qr-stage {
      min-height: 345px;
      border: 1px dashed var(--border);
      border-radius: 18px;
      background:
        linear-gradient(45deg, rgba(128,150,170,.035) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(128,150,170,.035) 25%, transparent 25%),
        var(--input);
      background-size: 24px 24px;
      display: grid;
      place-items: center;
      position: relative;
      padding: 28px;
    }

    .qr-box {
      background: #fff;
      padding: 14px;
      border-radius: 14px;
      box-shadow: 0 15px 45px rgba(0,0,0,.18);
      line-height: 0;
    }

    #qrCanvas {
      display: block;
      max-width: 100%;
      height: auto;
    }

    .empty-state {
      display: none;
      position: absolute;
      inset: 0;
      place-items: center;
      align-content: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
      background: var(--input);
    }

    .empty-state i {
      color: var(--primary);
      font-size: 42px;
    }

    .preview-info {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 12px;
    }

    .preview-info div {
      padding: 11px;
      border-radius: 10px;
      background: var(--input);
      border: 1px solid var(--border);
      text-align: center;
    }

    .preview-info span {
      display: block;
      color: var(--muted);
      font-size: 9px;
      margin-bottom: 3px;
    }

    .preview-info strong {
      font-size: 11px;
    }

    .download-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 12px;
    }

    .download-btn {
      min-height: 66px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--input);
      color: var(--text);
      display: grid;
      grid-template-columns: 35px 1fr 18px;
      align-items: center;
      text-align: right;
      padding: 9px 12px;
      transition: .2s ease;
    }

    .download-btn > i:first-child {
      color: var(--primary);
      font-size: 18px;
      text-align: center;
    }

    .download-btn > i:last-child {
      color: var(--muted);
      font-size: 11px;
    }

    .download-btn span strong {
      display: block;
      font-size: 12px;
    }

    .download-btn span small {
      color: var(--muted);
      font-size: 9px;
    }

    .download-btn:hover {
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    .privacy {
      margin: 0 28px 28px;
      padding: 16px;
      border-radius: 14px;
      display: flex;
      gap: 12px;
      align-items: center;
      background: rgba(56,189,248,.055);
      border: 1px solid rgba(56,189,248,.12);
    }

    .privacy-icon {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      color: var(--primary);
      background: rgba(56,189,248,.10);
    }

    .privacy strong {
      font-size: 12px;
    }

    .privacy p {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 10px;
    }

    .info-section {
      padding: 5px 0 35px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .info-card {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--card);
    }

    .info-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      color: var(--primary);
      background: rgba(56,189,248,.08);
      margin-bottom: 13px;
    }

    .info-card h3 {
      margin: 0 0 7px;
      font-size: 15px;
    }

    .info-card p,
    .info-card li {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    .info-card p {
      margin: 0;
    }

    .info-card ol {
      margin: 0;
      padding-right: 19px;
    }

    .faq-section {
      padding: 5px 0 65px;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 22px;
    }

    .section-heading span {
      color: var(--primary);
      font: 600 10px "JetBrains Mono", monospace;
      letter-spacing: 2px;
    }

    .section-heading h2 {
      margin: 4px 0 0;
      font-size: 25px;
    }

    .faq {
      display: grid;
      gap: 9px;
    }

    details {
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--card);
      overflow: hidden;
    }

    summary {
      list-style: none;
      cursor: pointer;
      padding: 16px 18px;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);
      transition: .2s;
    }

    details[open] summary i {
      transform: rotate(45deg);
    }

    details p {
      margin: 0;
      padding: 0 18px 17px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
    }

    @media (max-width: 900px) {
      .workspace {
        grid-template-columns: 1fr;
      }

      .settings-panel {
        border-left: 0;
        border-bottom: 1px solid var(--border);
      }

      .info-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .hero {
        padding-top: 30px;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 17px;
      }

      .hero-icon {
        width: 78px;
        height: 78px;
        font-size: 32px;
        border-radius: 20px;
      }

      .hero-copy p {
        font-size: 13px;
      }

      .tool-head {
        padding: 20px;
        align-items: flex-start;
      }

      .tool-head h2 {
        font-size: 19px;
      }

      .panel {
        padding: 20px;
      }

      .type-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .settings-grid,
      .download-actions,
      .actions {
        grid-template-columns: 1fr;
      }

      .privacy {
        margin: 0 20px 20px;
      }

      .qr-stage {
        min-height: 300px;
      }
    }

    @media (max-width: 400px) {
      .hero-inner,
      .tool-section,
      .info-section,
      .faq-section {
        width: min(100% - 20px, 1180px);
      }

      .hero {
        padding-inline: 10px;
      }

      .crumb {
        font-size: 10px;
      }

      h1 {
        font-size: 27px;
      }

      .type-btn {
        min-height: 62px;
      }

      .type-btn i {
        font-size: 15px;
      }

      .type-btn span {
        font-size: 10px;
      }
    }
  </style>

  <script>
    (() => {
      const typeButtons = document.querySelectorAll('.type-btn');
      const dynamicFields = document.getElementById('dynamicFields');
      const canvas = document.getElementById('qrCanvas');
      const size = document.getElementById('size');
      const margin = document.getElementById('margin');
      const errorLevel = document.getElementById('errorLevel');
      const pngBtn = document.getElementById('pngBtn');
      const svgBtn = document.getElementById('svgBtn');
      const copyBtn = document.getElementById('copyBtn');
      const resetBtn = document.getElementById('resetBtn');
      const status = document.getElementById('status');
      const qrState = document.getElementById('qrState');
      const qrSize = document.getElementById('qrSize');
      const qrType = document.getElementById('qrType');
      const emptyState = document.getElementById('emptyState');

      let currentType = 'text';
      let currentPayload = '';
      let renderTimer = null;

      const typeNames = {
        text: 'نص',
        url: 'رابط',
        email: 'بريد',
        phone: 'هاتف',
        wifi: 'Wi-Fi'
      };

      function escapeValue(value) {
        return String(value)
          .replace(/\\/g, '\\\\')
          .replace(/;/g, '\\;')
          .replace(/,/g, '\\,')
          .replace(/:/g, '\\:');
      }

      function fieldInput(id, label, placeholder, type = 'text') {
        return `
          <div class="field">
            <label for="${id}">${label}</label>
            <input id="${id}" type="${type}" placeholder="${placeholder}" autocomplete="off">
          </div>
        `;
      }

      function renderFields() {
        if (currentType === 'text') {
          dynamicFields.innerHTML = `
            <div class="field">
              <label for="textValue">النص</label>
              <textarea id="textValue" placeholder="اكتب النص الذي تريد تحويله إلى QR Code..."></textarea>
              <div class="input-hint">يمكنك إدخال نص عربي أو إنجليزي أو أي محتوى نصي.</div>
            </div>
          `;
        }

        if (currentType === 'url') {
          dynamicFields.innerHTML = fieldInput(
            'urlValue',
            'الرابط',
            'https://example.com',
            'url'
          );
        }

        if (currentType === 'email') {
          dynamicFields.innerHTML = `
            ${fieldInput('emailValue', 'البريد الإلكتروني', 'name@example.com', 'email')}
            ${fieldInput('emailSubject', 'الموضوع', 'موضوع الرسالة')}
          `;
        }

        if (currentType === 'phone') {
          dynamicFields.innerHTML = fieldInput(
            'phoneValue',
            'رقم الهاتف',
            '+212600000000',
            'tel'
          );
        }

        if (currentType === 'wifi') {
          dynamicFields.innerHTML = `
            ${fieldInput('wifiSsid', 'اسم الشبكة SSID', 'My WiFi')}
            <div class="settings-grid">
              <div class="field">
                <label for="wifiSecurity">نوع الحماية</label>
                <select id="wifiSecurity">
                  <option value="WPA" selected>WPA / WPA2</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">بدون كلمة مرور</option>
                </select>
              </div>
              <div class="field">
                <label for="wifiHidden">الشبكة مخفية؟</label>
                <select id="wifiHidden">
                  <option value="false" selected>لا</option>
                  <option value="true">نعم</option>
                </select>
              </div>
            </div>
            <div class="field" id="wifiPasswordField">
              <label for="wifiPassword">كلمة المرور</label>
              <input id="wifiPassword" type="text" placeholder="كلمة مرور الشبكة" autocomplete="off">
            </div>
          `;

          const security = document.getElementById('wifiSecurity');
          security.addEventListener('change', () => {
            const passField = document.getElementById('wifiPasswordField');
            passField.style.display = security.value === 'nopass' ? 'none' : 'block';
            scheduleRender();
          });
        }

        dynamicFields.querySelectorAll('input, textarea, select').forEach((el) => {
          el.addEventListener('input', scheduleRender);
          el.addEventListener('change', scheduleRender);
        });

        scheduleRender();
      }

      function getPayload() {
        if (currentType === 'text') {
          return document.getElementById('textValue')?.value.trim() || '';
        }

        if (currentType === 'url') {
          const value = document.getElementById('urlValue')?.value.trim() || '';
          if (!value) return '';
          if (!/^https?:\\/\\//i.test(value)) {
            throw new Error('يجب أن يبدأ الرابط بـ http:// أو https://');
          }
          return value;
        }

        if (currentType === 'email') {
          const email = document.getElementById('emailValue')?.value.trim() || '';
          const subject = document.getElementById('emailSubject')?.value.trim() || '';

          if (!email) return '';

          if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {
            throw new Error('أدخل بريداً إلكترونياً صحيحاً.');
          }

          return `mailto:${email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
        }

        if (currentType === 'phone') {
          const phone = document.getElementById('phoneValue')?.value.trim() || '';
          if (!phone) return '';
          return `tel:${phone}`;
        }

        if (currentType === 'wifi') {
          const ssid = document.getElementById('wifiSsid')?.value || '';
          const security = document.getElementById('wifiSecurity')?.value || 'WPA';
          const password = document.getElementById('wifiPassword')?.value || '';
          const hidden = document.getElementById('wifiHidden')?.value || 'false';

          if (!ssid) return '';

          return `WIFI:T:${security};S:${escapeValue(ssid)};P:${escapeValue(password)};H:${hidden};;`;
        }

        return '';
      }

      function setStatus(message, good = true) {
        status.innerHTML = `
          <i class="fa-solid ${good ? 'fa-circle-check' : 'fa-circle-exclamation'}"></i>
          ${message}
        `;
        status.style.color = good ? '' : '#f87171';
      }

      function waitForQRCode(callback, tries = 0) {
        if (window.QRCode) {
          callback();
          return;
        }

        if (tries >= 50) {
          setStatus('تعذر تحميل محرك QR Code. تحقق من اتصال الإنترنت.', false);
          return;
        }

        setTimeout(() => waitForQRCode(callback, tries + 1), 100);
      }

      function renderQR() {
        let payload = '';

        try {
          payload = getPayload();
        } catch (error) {
          currentPayload = '';
          emptyState.style.display = 'grid';
          qrState.textContent = 'خطأ';
          setStatus(error.message, false);
          return;
        }

        currentPayload = payload;
        qrType.textContent = typeNames[currentType];
        qrSize.textContent = `${size.value} px`;

        if (!payload) {
          emptyState.style.display = 'grid';
          qrState.textContent = 'بانتظار البيانات';
          setStatus('أدخل البيانات لإنشاء رمز QR.');
          return;
        }

        emptyState.style.display = 'none';
        qrState.textContent = 'جاري الإنشاء...';

        waitForQRCode(() => {
          const levelMap = {
            L: QRCode.CorrectLevel.L,
            M: QRCode.CorrectLevel.M,
            Q: QRCode.CorrectLevel.Q,
            H: QRCode.CorrectLevel.H
          };

          const dimension = Number(size.value);

          QRCode.toCanvas(
            canvas,
            payload,
            {
              width: dimension,
              margin: Number(margin.value),
              errorCorrectionLevel: levelMap[errorLevel.value] || QRCode.CorrectLevel.M,
              color: {
                dark: '#000000',
                light: '#ffffff'
              }
            },
            (error) => {
              if (error) {
                qrState.textContent = 'خطأ';
                setStatus('تعذر إنشاء رمز QR.', false);
                return;
              }

              qrState.textContent = 'تم الإنشاء';
              setStatus('تم إنشاء رمز QR بنجاح.');
            }
          );
        });
      }

      function scheduleRender() {
        clearTimeout(renderTimer);
        renderTimer = setTimeout(renderQR, 80);
      }

      typeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          typeButtons.forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          currentType = button.dataset.type;
          renderFields();
        });
      });

      [size, margin, errorLevel].forEach((element) => {
        element.addEventListener('change', scheduleRender);
      });

      pngBtn.addEventListener('click', () => {
        if (!currentPayload) {
          setStatus('أدخل البيانات أولاً.', false);
          return;
        }

        canvas.toBlob((blob) => {
          if (!blob) return;

          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = 'th-tech-qr-code.png';
          document.body.appendChild(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(url);

          setStatus('تم تنزيل ملف PNG.');
        }, 'image/png');
      });

      svgBtn.addEventListener('click', () => {
        if (!currentPayload) {
          setStatus('أدخل البيانات أولاً.', false);
          return;
        }

        waitForQRCode(() => {
          QRCode.toString(
            currentPayload,
            {
              type: 'svg',
              width: Number(size.value),
              margin: Number(margin.value),
              errorCorrectionLevel: errorLevel.value
            },
            (error, svg) => {
              if (error) {
                setStatus('تعذر إنشاء ملف SVG.', false);
                return;
              }

              const blob = new Blob([svg], {
                type: 'image/svg+xml;charset=utf-8'
              });

              const url = URL.createObjectURL(blob);
              const link = document.createElement('a');
              link.href = url;
              link.download = 'th-tech-qr-code.svg';
              document.body.appendChild(link);
              link.click();
              link.remove();
              URL.revokeObjectURL(url);

              setStatus('تم تنزيل ملف SVG.');
            }
          );
        });
      });

      copyBtn.addEventListener('click', async () => {
        if (!currentPayload) {
          setStatus('لا توجد بيانات لنسخها.', false);
          return;
        }

        try {
          await navigator.clipboard.writeText(currentPayload);
          setStatus('تم نسخ البيانات إلى الحافظة.');
        } catch {
          setStatus('تعذر النسخ تلقائياً.', false);
        }
      });

      resetBtn.addEventListener('click', () => {
        currentType = 'text';

        typeButtons.forEach((button) => {
          button.classList.toggle('active', button.dataset.type === 'text');
        });

        size.value = '220';
        margin.value = '2';
        errorLevel.value = 'M';

        renderFields();
        setStatus('تمت إعادة ضبط الأداة.');
      });

      renderFields();
    })();
  </script>
</body>
</html>
