        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        letter-spacing: -1px;
      }

      .hero-text p {
