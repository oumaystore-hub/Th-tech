---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/qr-code-generator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>مولد QR Code احترافي | Th.Tech</title>

  <meta
    name="description"
    content="مولد QR Code مجاني وسريع لإنشاء رموز QR للنصوص والروابط والبريد والهاتف وشبكات Wi-Fi."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <!-- QRCode.js -->
  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
  ></script>
</head>

<body>
  <Header />

  <main class="page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-icon">
        <i class="fa-solid fa-qrcode"></i>
      </div>

      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>مولد QR Code</span>
      </div>

      <span class="eyebrow">
        <i class="fa-solid fa-bolt"></i>
        أداة مجانية وسريعة
      </span>

      <h1>
        مولد <span>QR Code</span> احترافي
      </h1>

      <p class="hero-description">
        أنشئ رمز QR للنصوص والروابط والبريد الإلكتروني وأرقام الهاتف
        وشبكات Wi-Fi بسهولة وسرعة.
      </p>

      <div class="hero-tags">
        <span>
          <i class="fa-solid fa-bolt"></i>
          فوري
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          آمن
        </span>

        <span>
          <i class="fa-solid fa-mobile-screen"></i>
          متجاوب
        </span>
      </div>

    </section>


    <!-- TOOL -->
    <section class="tool-card">

      <div class="tool-header">

        <div>
          <span class="section-label">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            مولد QR
          </span>

          <h2>أنشئ رمز QR الخاص بك</h2>

          <p>
            أدخل البيانات وسيظهر الرمز مباشرة.
          </p>
        </div>

        <div class="live-status" id="status">
          <span class="status-dot"></span>
          جاهز
        </div>

      </div>


      <!-- TYPES -->
      <div class="types">

        <button class="type-btn active" type="button" data-type="text">
          <i class="fa-solid fa-font"></i>
          <span>نص</span>
        </button>

        <button class="type-btn" type="button" data-type="url">
          <i class="fa-solid fa-link"></i>
          <span>رابط</span>
        </button>

        <button class="type-btn" type="button" data-type="email">
          <i class="fa-solid fa-envelope"></i>
          <span>بريد</span>
        </button>

        <button class="type-btn" type="button" data-type="phone">
          <i class="fa-solid fa-phone"></i>
          <span>هاتف</span>
        </button>

        <button class="type-btn" type="button" data-type="wifi">
          <i class="fa-solid fa-wifi"></i>
          <span>Wi-Fi</span>
        </button>

      </div>


      <!-- WORKSPACE -->
      <div class="workspace">

        <!-- INPUT -->
        <div class="input-panel">

          <div class="panel-title">

            <div class="panel-title-icon">
              <i class="fa-solid fa-pen"></i>
            </div>

            <div>
              <h3 id="inputTitle">النص</h3>

              <p id="inputHint">
                اكتب النص الذي تريد تحويله إلى QR Code
              </p>
            </div>

          </div>


          <!-- TEXT -->
          <div class="field-group" id="textFields">

            <label for="mainInput">
              المحتوى
              <span>*</span>
            </label>

            <textarea
              id="mainInput"
              rows="7"
              placeholder="اكتب النص هنا..."
            ></textarea>

            <div class="field-footer">
              <span id="charCount">0 حرف</span>
              <span>يدعم العربية وجميع اللغات</span>
            </div>

          </div>


          <!-- URL -->
          <div class="field-group hidden" id="urlFields">

            <label for="urlInput">
              رابط الموقع
              <span>*</span>
            </label>

            <input
              id="urlInput"
              type="url"
              placeholder="https://example.com"
            />

            <small>
              مثال: https://example.com
            </small>

          </div>


          <!-- EMAIL -->
          <div class="field-group hidden" id="emailFields">

            <label for="emailInput">
              البريد الإلكتروني
              <span>*</span>
            </label>

            <input
              id="emailInput"
              type="email"
              placeholder="example@email.com"
            />

            <label for="emailSubject">
              الموضوع
            </label>

            <input
              id="emailSubject"
              type="text"
              placeholder="موضوع اختياري"
            />

            <label for="emailBody">
              الرسالة
            </label>

            <textarea
              id="emailBody"
              rows="4"
              placeholder="نص الرسالة..."
            ></textarea>

          </div>


          <!-- PHONE -->
          <div class="field-group hidden" id="phoneFields">

            <label for="phoneInput">
              رقم الهاتف
              <span>*</span>
            </label>

            <input
              id="phoneInput"
              type="tel"
              placeholder="+212600000000"
            />

            <small>
              يفضل إدخال رمز الدولة.
            </small>

          </div>


          <!-- WIFI -->
          <div class="field-group hidden" id="wifiFields">

            <label for="wifiName">
              اسم الشبكة SSID
              <span>*</span>
            </label>

            <input
              id="wifiName"
              type="text"
              placeholder="اسم شبكة Wi-Fi"
            />

            <label for="wifiPassword">
              كلمة المرور
            </label>

            <input
              id="wifiPassword"
              type="text"
              placeholder="كلمة المرور"
            />

            <label for="wifiSecurity">
              نوع الحماية
            </label>

            <select id="wifiSecurity">
              <option value="WPA">WPA / WPA2 / WPA3</option>
              <option value="WEP">WEP</option>
              <option value="nopass">بدون كلمة مرور</option>
            </select>

            <label class="check-row">
              <input type="checkbox" id="wifiHidden" />
              <span>الشبكة مخفية</span>
            </label>

          </div>


          <!-- SETTINGS -->
          <div class="settings">

            <div class="settings-title">
              <i class="fa-solid fa-sliders"></i>
              الإعدادات
            </div>

            <div class="settings-grid">

              <div class="setting">
                <label for="sizeSelect">الحجم</label>

                <select id="sizeSelect">
                  <option value="180">صغير</option>
                  <option value="240" selected>متوسط</option>
                  <option value="320">كبير</option>
                  <option value="420">كبير جداً</option>
                </select>
              </div>

              <div class="setting">
                <label for="marginSelect">الهامش</label>

                <select id="marginSelect">
                  <option value="1">صغير</option>
                  <option value="2" selected>متوسط</option>
                  <option value="4">كبير</option>
                  <option value="6">كبير جداً</option>
                </select>
              </div>

              <div class="setting">
                <label for="errorSelect">تصحيح الخطأ</label>

                <select id="errorSelect">
                  <option value="L">منخفض</option>
                  <option value="M" selected>متوسط</option>
                  <option value="Q">مرتفع</option>
                  <option value="H">أقصى</option>
                </select>
              </div>

            </div>

          </div>


          <!-- ACTIONS -->
          <div class="actions">

            <button
              class="btn secondary"
              type="button"
              id="resetBtn"
            >
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

            <button
              class="btn primary"
              type="button"
              id="generateBtn"
            >
              <i class="fa-solid fa-qrcode"></i>
              إنشاء QR Code
            </button>

          </div>

          <div id="message" class="message"></div>

        </div>


        <!-- PREVIEW -->
        <div class="preview-panel">

          <div class="preview-head">

            <div>
              <span class="section-label small">
                <i class="fa-solid fa-eye"></i>
                المعاينة
              </span>

              <h3>رمز QR الخاص بك</h3>
            </div>

            <span id="previewState" class="preview-state">
              في انتظار البيانات
            </span>

          </div>


          <div class="qr-stage">

            <div id="qrEmpty" class="empty-preview">

              <div class="empty-icon">
                <i class="fa-solid fa-qrcode"></i>
              </div>

              <strong>
                سيظهر QR Code هنا
              </strong>

              <span>
                أدخل البيانات لبدء التوليد
              </span>

            </div>

            <div id="qrBox" class="qr-box"></div>

          </div>


          <div class="preview-info">

            <span>
              <i class="fa-solid fa-circle-check"></i>
              التوليد داخل المتصفح
            </span>

            <span id="dataTypeInfo">
              النوع: نص
            </span>

          </div>


          <!-- DOWNLOAD -->
          <div class="download-actions">

            <button
              id="pngBtn"
              class="download-btn"
              type="button"
              disabled
            >
              <i class="fa-solid fa-image"></i>

              <span>
                <strong>PNG</strong>
                <small>تحميل صورة</small>
              </span>
            </button>


            <button
              id="svgBtn"
              class="download-btn"
              type="button"
              disabled
            >
              <i class="fa-solid fa-vector-square"></i>

              <span>
                <strong>SVG</strong>
                <small>تحميل ملف</small>
              </span>
            </button>


            <button
              id="copyBtn"
              class="download-btn"
              type="button"
              disabled
            >
              <i class="fa-solid fa-copy"></i>

              <span>
                <strong>نسخ</strong>
                <small>نسخ المحتوى</small>
              </span>
            </button>

          </div>

        </div>

      </div>

    </section>


    <!-- STATS -->
    <section class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-bolt"></i>
        </div>

        <div>
          <strong>فوري</strong>
          <span>توليد مباشر</span>
        </div>
      </div>


      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>
          <strong>100%</strong>
          <span>محلي وآمن</span>
        </div>
      </div>


      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-download"></i>
        </div>

        <div>
          <strong>3</strong>
          <span>خيارات التصدير</span>
        </div>
      </div>


      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-layer-group"></i>
        </div>

        <div>
          <strong>5</strong>
          <span>أنواع البيانات</span>
        </div>
      </div>

    </section>


    <!-- PRIVACY -->
    <section class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>

      <div>
        <h2>خصوصيتك أولاً</h2>

        <p>
          يتم إنشاء QR Code داخل متصفحك مباشرة، ولا يتم إرسال البيانات
          التي تدخلها إلى خادم الأداة.
        </p>
      </div>

    </section>


    <!-- HOW TO -->
    <section class="info-card">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-content">

        <h2>طريقة الاستخدام</h2>

        <ol class="steps">

          <li>
            <span>1</span>

            <div>
              <strong>اختر نوع البيانات</strong>
              <p>
                نص أو رابط أو بريد أو هاتف أو Wi-Fi.
              </p>
            </div>
          </li>


          <li>
            <span>2</span>

            <div>
              <strong>أدخل البيانات</strong>
              <p>
                اكتب البيانات المطلوبة.
              </p>
            </div>
          </li>


          <li>
            <span>3</span>

            <div>
              <strong>خصص الرمز</strong>
              <p>
                اختر الحجم والهامش ومستوى تصحيح الخطأ.
              </p>
            </div>
          </li>


          <li>
            <span>4</span>

            <div>
              <strong>حمّل الرمز</strong>
              <p>
                احفظه بصيغة PNG أو SVG أو انسخ المحتوى.
              </p>
            </div>
          </li>

        </ol>

      </div>

    </section>


    <!-- TIP -->
    <section class="info-card note-card">

      <div class="info-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>
        <h2>نصيحة</h2>

        <p>
          اترك مساحة بيضاء حول QR Code عند طباعته حتى تتمكن كاميرات
          الهواتف من قراءته بسهولة.
        </p>
      </div>

    </section>


    <!-- FAQ -->
    <section class="faq">

      <div class="faq-heading">
        <span>دليل الاستخدام</span>
        <h2>الأسئلة الشائعة</h2>
      </div>


      <details>
        <summary>
          هل مولد QR Code مجاني؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، الأداة مجانية ولا تحتاج إلى إنشاء حساب.
        </p>
      </details>


      <details>
        <summary>
          هل يتم حفظ البيانات؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          لا، يتم إنشاء الرمز داخل المتصفح مباشرة.
        </p>
      </details>


      <details>
        <summary>
          ما الأنواع المدعومة؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          النصوص والروابط والبريد الإلكتروني وأرقام الهاتف وشبكات Wi-Fi.
        </p>
      </details>


      <details>
        <summary>
          هل يمكن تحميل الرمز؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          نعم، يمكن تحميله بصيغة PNG أو SVG.
        </p>
      </details>

    </section>

  </main>

  <Footer />


  <!-- ========================================================= -->
  <!-- QR GENERATOR -->
  <!-- ========================================================= -->

  <script is:inline>
    (function () {

      function initQR() {

        var qrBox = document.getElementById('qrBox');
        var qrEmpty = document.getElementById('qrEmpty');

        var mainInput = document.getElementById('mainInput');
        var urlInput = document.getElementById('urlInput');

        var emailInput = document.getElementById('emailInput');
        var emailSubject = document.getElementById('emailSubject');
        var emailBody = document.getElementById('emailBody');

        var phoneInput = document.getElementById('phoneInput');

        var wifiName = document.getElementById('wifiName');
        var wifiPassword = document.getElementById('wifiPassword');
        var wifiSecurity = document.getElementById('wifiSecurity');
        var wifiHidden = document.getElementById('wifiHidden');

        var sizeSelect = document.getElementById('sizeSelect');
        var marginSelect = document.getElementById('marginSelect');
        var errorSelect = document.getElementById('errorSelect');

        var generateBtn = document.getElementById('generateBtn');
        var resetBtn = document.getElementById('resetBtn');

        var pngBtn = document.getElementById('pngBtn');
        var svgBtn = document.getElementById('svgBtn');
        var copyBtn = document.getElementById('copyBtn');

        var message = document.getElementById('message');
        var status = document.getElementById('status');
        var previewState = document.getElementById('previewState');

        var inputTitle = document.getElementById('inputTitle');
        var inputHint = document.getElementById('inputHint');

        var charCount = document.getElementById('charCount');
        var dataTypeInfo = document.getElementById('dataTypeInfo');

        var textFields = document.getElementById('textFields');
        var urlFields = document.getElementById('urlFields');
        var emailFields = document.getElementById('emailFields');
        var phoneFields = document.getElementById('phoneFields');
        var wifiFields = document.getElementById('wifiFields');

        var typeButtons = document.querySelectorAll('.type-btn');

        var currentType = 'text';
        var currentPayload = '';
        var generated = false;


        var titles = {
          text: 'النص',
          url: 'الرابط',
          email: 'البريد الإلكتروني',
          phone: 'رقم الهاتف',
          wifi: 'شبكة Wi-Fi'
        };


        var hints = {
          text: 'اكتب النص الذي تريد تحويله إلى QR Code',
          url: 'أدخل رابط الموقع أو الصفحة',
          email: 'أدخل بيانات البريد الإلكتروني',
          phone: 'أدخل رقم الهاتف',
          wifi: 'أدخل بيانات شبكة Wi-Fi'
        };


        var names = {
          text: 'نص',
          url: 'رابط',
          email: 'بريد إلكتروني',
          phone: 'هاتف',
          wifi: 'Wi-Fi'
        };


        function setStatus(text, working) {

          status.innerHTML =
            '<span class="status-dot"></span>' + text;

          if (working) {
            status.classList.add('working');
          } else {
            status.classList.remove('working');
          }
        }


        function showMessage(text, type) {

          message.textContent = text || '';
          message.className = 'message';

          if (type) {
            message.classList.add(type);
          }
        }


        function clearQR() {

          qrBox.innerHTML = '';

          qrEmpty.style.display = 'flex';

          previewState.textContent =
            'في انتظار البيانات';

          pngBtn.disabled = true;
          svgBtn.disabled = true;
          copyBtn.disabled = true;

          generated = false;
        }


        function showFields(type) {

          textFields.classList.add('hidden');
          urlFields.classList.add('hidden');
          emailFields.classList.add('hidden');
          phoneFields.classList.add('hidden');
          wifiFields.classList.add('hidden');

          if (type === 'text') {
            textFields.classList.remove('hidden');
          }

          if (type === 'url') {
            urlFields.classList.remove('hidden');
          }

          if (type === 'email') {
            emailFields.classList.remove('hidden');
          }

          if (type === 'phone') {
            phoneFields.classList.remove('hidden');
          }

          if (type === 'wifi') {
            wifiFields.classList.remove('hidden');
          }

        }


        function escapeWifi(value) {

          var slash = String.fromCharCode(92);

          return value
            .split(slash)
            .join(slash + slash)
            .split(';')
            .join(slash + ';')
            .split(',')
            .join(slash + ',')
            .split(':')
            .join(slash + ':');

        }


        function getPayload() {

          if (currentType === 'text') {

            return mainInput.value.trim();

          }


          if (currentType === 'url') {

            var url = urlInput.value.trim();

            if (!url) {
              return '';
            }

            try {

              var parsed = new URL(url);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {
                return '';
              }

              return url;

            } catch (error) {

              return '';

            }

          }


          if (currentType === 'email') {

            var email = emailInput.value.trim();

            if (!email) {
              return '';
            }

            var subject = emailSubject.value.trim();
            var body = emailBody.value.trim();

            var result = 'mailto:' + email;
            var params = [];

            if (subject) {
              params.push(
                'subject=' + encodeURIComponent(subject)
              );
            }

            if (body) {
              params.push(
                'body=' + encodeURIComponent(body)
              );
            }

            if (params.length) {
              result += '?' + params.join('&');
            }

            return result;

          }


          if (currentType === 'phone') {

            var phone = phoneInput.value.trim();

            if (!phone) {
              return '';
            }

            return 'tel:' + phone;

          }


          if (currentType === 'wifi') {

            var name = wifiName.value.trim();

            if (!name) {
              return '';
            }

            var password = wifiPassword.value;
            var security = wifiSecurity.value;

            var hidden =
              wifiHidden.checked ? 'true' : 'false';

            return (
              'WIFI:T:' +
              security +
              ';S:' +
              escapeWifi(name) +
              ';P:' +
              escapeWifi(password) +
              ';H:' +
              hidden +
              ';;'
            );

          }

          return '';

        }


        function validEmail() {

          var email = emailInput.value.trim();

          var at = email.indexOf('@');
          var dot = email.lastIndexOf('.');

          return (
            at > 0 &&
            dot > at + 1 &&
            dot < email.length - 1
          );

        }


        function validate(payload) {

          if (!payload) {

            showMessage(
              'يرجى إدخال البيانات أولاً.',
              'error'
            );

            return false;

          }


          if (currentType === 'url') {

            try {

              var parsed = new URL(payload);

              if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
              ) {

                showMessage(
                  'الرابط يجب أن يبدأ بـ http:// أو https://',
                  'error'
                );

                return false;

              }

            } catch (error) {

              showMessage(
                'يرجى إدخال رابط صالح.',
                'error'
              );

              return false;

            }

          }


          if (
            currentType === 'email' &&
            !validEmail()
          ) {

            showMessage(
              'يرجى إدخال بريد إلكتروني صالح.',
              'error'
            );

            return false;

          }

          return true;

        }


        function generate() {

          if (
            typeof window.QRCode === 'undefined'
          ) {

            setStatus('المكتبة غير متاحة', false);

            showMessage(
              'تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت.',
              'error'
            );

            return;

          }


          var payload = getPayload();


          if (!validate(payload)) {

            clearQR();

            return;

          }


          currentPayload = payload;

          setStatus('جارٍ الإنشاء...', true);

          previewState.textContent =
            'جارٍ إنشاء الرمز...';

          qrBox.innerHTML = '';


          var size =
            parseInt(sizeSelect.value, 10);

          var margin =
            parseInt(marginSelect.value, 10);


          /*
           * QRCode.js uses its own margin model.
           * The selected margin is translated to a safe
           * CSS size around the generated code.
           */

          var totalSize =
            size + (margin * 8);


          try {

            new window.QRCode(
              qrBox,
              {
                text: payload,

                width: size,

                height: size,

                colorDark: '#07111f',

                colorLight: '#ffffff',

                correctLevel:
                  window.QRCode.CorrectLevel[
                    errorSelect.value
                  ]
              }
            );


            setTimeout(function () {

              var canvas =
                qrBox.querySelector('canvas');

              var image =
                qrBox.querySelector('img');


              if (!canvas && !image) {

                setStatus('خطأ', false);

                showMessage(
                  'لم يتم إنشاء QR Code.',
                  'error'
                );

                return;

              }


              qrEmpty.style.display = 'none';

              previewState.textContent =
                'تم الإنشاء';

              dataTypeInfo.textContent =
                'النوع: ' + names[currentType];

              pngBtn.disabled = false;
              svgBtn.disabled = false;
              copyBtn.disabled = false;

              generated = true;

              setStatus('جاهز', false);

              showMessage(
                'تم إنشاء QR Code بنجاح.',
                'success'
              );

            }, 80);


          } catch (error) {

            console.error(error);

            clearQR();

            setStatus('خطأ', false);

            showMessage(
              'حدث خطأ أثناء إنشاء QR Code.',
              'error'
            );

          }

        }


        function updateType() {

          inputTitle.textContent =
            titles[currentType];

          inputHint.textContent =
            hints[currentType];

          dataTypeInfo.textContent =
            'النوع: ' + names[currentType];

          showFields(currentType);


          typeButtons.forEach(function (button) {

            if (
              button.dataset.type === currentType
            ) {

              button.classList.add('active');

            } else {

              button.classList.remove('active');

            }

          });


          clearQR();

          showMessage('', '');

          setStatus('جاهز', false);

        }


        function updateCount() {

          charCount.textContent =
            mainInput.value.length + ' حرف';

        }


        /*
         * Type buttons
         */

        typeButtons.forEach(function (button) {

          button.addEventListener(
            'click',
            function () {

              currentType =
                button.dataset.type;

              updateType();

            }
          );

        });


        /*
         * Text counter
         */

        mainInput.addEventListener(
          'input',
          function () {

            updateCount();

            autoGenerate();

          }
        );


        /*
         * All inputs
         */

        [
          urlInput,
          emailInput,
          emailSubject,
          emailBody,
          phoneInput,
          wifiName,
          wifiPassword
        ].forEach(function (element) {

          element.addEventListener(
            'input',
            autoGenerate
          );

        });


        [
          wifiSecurity,
          wifiHidden,
          sizeSelect,
          marginSelect,
          errorSelect
        ].forEach(function (element) {

          element.addEventListener(
            'change',
            function () {

              if (getPayload()) {
                generate();
              }

            }
          );

        });


        function autoGenerate() {

          var payload = getPayload();

          if (!payload) {

            if (generated) {
              clearQR();
            }

            return;

          }


          /*
           * Small delay prevents generating hundreds
           * of QR codes during very fast typing.
           */

          clearTimeout(
            autoGenerate.timer
          );

          autoGenerate.timer =
            setTimeout(
              function () {
                generate();
              },
              180
            );

        }


        /*
         * Generate button
         */

        generateBtn.addEventListener(
          'click',
          generate
        );


        /*
         * Reset
         */

        resetBtn.addEventListener(
          'click',
          function () {

            mainInput.value = '';
            urlInput.value = '';

            emailInput.value = '';
            emailSubject.value = '';
            emailBody.value = '';

            phoneInput.value = '';

            wifiName.value = '';
            wifiPassword.value = '';
            wifiSecurity.value = 'WPA';
            wifiHidden.checked = false;

            sizeSelect.value = '240';
            marginSelect.value = '2';
            errorSelect.value = 'M';

            currentType = 'text';
            currentPayload = '';

            updateCount();
            updateType();

            showMessage(
              'تمت إعادة ضبط الأداة.',
              'success'
            );

          }
        );


        /*
         * Get generated canvas
         */

        function getCanvas() {

          var canvas =
            qrBox.querySelector('canvas');

          if (canvas) {
            return canvas;
          }


          var image =
            qrBox.querySelector('img');

          if (!image) {
            return null;
          }


          var tempCanvas =
            document.createElement('canvas');

          var ctx =
            tempCanvas.getContext('2d');


          tempCanvas.width =
            image.naturalWidth ||
            image.width ||
            Number(sizeSelect.value);

          tempCanvas.height =
            image.naturalHeight ||
            image.height ||
            Number(sizeSelect.value);


          ctx.fillStyle = '#ffffff';

          ctx.fillRect(
            0,
            0,
            tempCanvas.width,
            tempCanvas.height
          );


          ctx.drawImage(
            image,
            0,
            0,
            tempCanvas.width,
            tempCanvas.height
          );


          return tempCanvas;

        }


        /*
         * PNG
         */

        pngBtn.addEventListener(
          'click',
          function () {

            if (!generated) {
              return;
            }


            var canvas =
              getCanvas();

            if (!canvas) {
              return;
            }


            var link =
              document.createElement('a');

            link.download =
              'qr-code.png';

            link.href =
              canvas.toDataURL('image/png');

            document.body.appendChild(link);

            link.click();

            link.remove();


            showMessage(
              'تم تحميل QR Code بصيغة PNG.',
              'success'
            );

          }
        );


        /*
         * SVG
         *
         * QRCode.js generates a canvas/image.
         * We place that generated PNG inside an SVG
         * container so the exported file remains SVG.
         */

        svgBtn.addEventListener(
          'click',
          function () {

            if (!generated) {
              return;
            }


            var canvas =
              getCanvas();

            if (!canvas) {
              return;
            }


            var png =
              canvas.toDataURL('image/png');


            var width =
              canvas.width;

            var height =
              canvas.height;


            var svg =
              '<?xml version="1.0" encoding="UTF-8"?>' +
              '<svg xmlns="http://www.w3.org/2000/svg" ' +
              'width="' + width + '" ' +
              'height="' + height + '" ' +
              'viewBox="0 0 ' + width + ' ' + height + '">' +
              '<image href="' + png + '" ' +
              'width="' + width + '" ' +
              'height="' + height + '" />' +
              '</svg>';


            var blob =
              new Blob(
                [svg],
                {
                  type:
                    'image/svg+xml;charset=utf-8'
                }
              );


            var url =
              URL.createObjectURL(blob);


            var link =
              document.createElement('a');

            link.href = url;

            link.download =
              'qr-code.svg';

            document.body.appendChild(link);

            link.click();

            link.remove();


            setTimeout(
              function () {
                URL.revokeObjectURL(url);
              },
              1000
            );


            showMessage(
              'تم تحميل QR Code بصيغة SVG.',
              'success'
            );

          }
        );


        /*
         * Copy
         */

        copyBtn.addEventListener(
          'click',
          function () {

            if (
              !generated ||
              !currentPayload
            ) {
              return;
            }


            if (
              navigator.clipboard &&
              navigator.clipboard.writeText
            ) {

              navigator.clipboard
                .writeText(currentPayload)
                .then(
                  function () {

                    showMessage(
                      'تم نسخ المحتوى بنجاح.',
                      'success'
                    );

                  }
                )
                .catch(
                  fallbackCopy
                );

            } else {

              fallbackCopy();

            }

          }
        );


        function fallbackCopy() {

          var area =
            document.createElement('textarea');

          area.value =
            currentPayload;

          area.style.position =
            'fixed';

          area.style.opacity =
            '0';

          document.body.appendChild(area);

          area.focus();
          area.select();

          try {

            document.execCommand('copy');

            showMessage(
              'تم نسخ المحتوى.',
              'success'
            );

          } catch (error) {

            showMessage(
              'تعذر نسخ المحتوى.',
              'error'
            );

          }

          area.remove();

        }


        /*
         * Initial state
         */

        updateCount();

        updateType();


        /*
         * Library check
         */

        if (
          typeof window.QRCode === 'undefined'
        ) {

          setStatus(
            'جارٍ تحميل المكتبة...',
            true
          );


          var attempts = 0;


          var timer =
            setInterval(
              function () {

                attempts++;


                if (
                  typeof window.QRCode !==
                  'undefined'
                ) {

                  clearInterval(timer);

                  setStatus(
                    'جاهز',
                    false
                  );

                  return;

                }


                if (attempts >= 80) {

                  clearInterval(timer);

                  setStatus(
                    'تعذر التحميل',
                    false
                  );

                  showMessage(
                    'تعذر تحميل مكتبة QR Code. تحقق من اتصال الإنترنت.',
                    'error'
                  );

                }

              },
              100
            );

        } else {

          setStatus(
            'جاهز',
            false
          );

        }

      }


      if (
        document.readyState === 'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          initQR
        );

      } else {

        initQR();

      }

    })();
  </script>


