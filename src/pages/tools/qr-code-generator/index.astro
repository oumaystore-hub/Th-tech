              </div>

            </div>

            <!-- WIFI -->
            <div class="wifi-box" id="wifiBox">

              <div class="form-group">
                <label for="wifiName">اسم الشبكة</label>
                <input
                  id="wifiName"
                  type="text"
                  placeholder="My WiFi"
                />
              </div>

              <div class="form-group">
                <label for="wifiPassword">كلمة المرور</label>
                <input
                  id="wifiPassword"
                  type="text"
                  placeholder="Password"
                />
              </div>

              <div class="form-group full">
                <label for="wifiSecurity">نوع الحماية</label>

                <select id="wifiSecurity">
                  <option value="WPA">WPA / WPA2 / WPA3</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">بدون كلمة مرور</option>
                </select>
              </div>

