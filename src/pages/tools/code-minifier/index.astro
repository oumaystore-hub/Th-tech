      .info-grid {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .info-card {

        position:
          relative;

        padding:
          24px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          18px;

        background:
          var(--surface);

      }


      .info-number {

        position:
          absolute;

        top:
          15px;

        left:
          18px;

        color:
          var(--muted);

        opacity:
          .25;

        font:
          700 28px
          "JetBrains Mono",
          monospace;

      }


      .info-card-icon {

        width:
          42px;

        height:
          42px;

        display:
          grid;

        place-items:
          center;

        margin-bottom:
          13px;

        border-radius:
          11px;

        background:
          rgba(22,163,74,.1);

        color:
          var(--primary);

      }


      .info-card h3 {

        margin:
          0 0 7px;

        font-size:
          14px;

      }


      .info-card p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         HOW
      ======================================= */

      .how-section {

        margin-top:
          55px;

      }


      .steps {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .step {

        display:
          flex;

        align-items:
          flex-start;

        gap:
          12px;

        padding:
          20px;

        background:
          var(--surface);

        border:
          1px solid
          var(--border);

        border-radius:
          17px;

      }


      .step-icon {

        width:
          43px;

        height:
          43px;

        flex:
          0 0 43px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          12px;

        background:
          linear-gradient(
            135deg,
            rgba(22,163,74,.12),
            rgba(34,197,94,.12)
          );

        color:
          var(--primary);

        font:
          700 10px
          "JetBrains Mono",
          monospace;

      }


      .step h3 {

        margin:
          0 0 5px;

        font-size:
          13px;

      }


      .step p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          10px;

        line-height:
          1.8;

      }


      /* ======================================
         FAQ
      ======================================= */

      .faq-section {

        margin:
          55px auto 70px;

        max-width:
          850px;

      }


      .faq-list details {

        margin-bottom:
          9px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          14px;

        background:
          var(--surface);

      }


      .faq-list summary {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          15px;

        padding:
          16px 18px;

        cursor:
          pointer;

        list-style:
          none;

        font-size:
          12px;

        font-weight:
          700;

      }


      .faq-list summary::-webkit-details-marker {
        display:
          none;
      }


      .faq-list summary i {

        color:
          var(--muted);

        font-size:
          10px;

        transition:
          transform .2s ease;

      }


      .faq-list details[open]
      summary i {

        transform:
          rotate(180deg);

      }


      .faq-answer {

        padding:
          0 18px 17px;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         RESPONSIVE
      ======================================= */

      @media (max-width: 900px) {

        .editor-grid {

          grid-template-columns:
            1fr;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }

      }


      @media (max-width: 700px) {

        .tool-stats {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }


        .actionbar {

          flex-direction:
            column;

          align-items:
            stretch;

        }


        .action-group {

          width:
            100%;

        }


        .action {

          flex:
            1;

        }


        .compression-result {

          align-items:
            center;

        }

      }


      @media (max-width: 600px) {

        .container {

          width:
            calc(
              100% - 20px
            );

        }


        .hero {

          padding:
            25px 0 32px;

        }


        .hero-icon {

          width:
            60px;

          height:
            60px;

          font-size:
            20px;

        }


        .hero p {

          font-size:
            12px;

        }


        .topbar {

          padding:
            14px;

        }


        .topbar-status {

          display:
            none;

        }


        .actionbar {

          padding:
            10px;

        }


        .action {

          padding:
            9px 7px;

          font-size:
            10px;

        }


        .editor-grid {

          padding:
            10px;

        }


        .code-area {

          height:
            330px;

        }


        .compression-result {

          margin:
            0 10px 10px;

          padding:
            12px;

        }


        .compression-main span {

          max-width:
            170px;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            1fr;

        }


        .faq-section {

          margin-bottom:
            45px;

        }

      }

    </style>

  </body>
</html>
