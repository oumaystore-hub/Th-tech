---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "Code Minifier - تصغير وضغط الأكواد أونلاين مجاناً | Th.Tech";

const description =
  "أداة Code Minifier مجانية لتصغير وضغط الأكواد وإزالة المسافات والتعليقات غير الضرورية وتحسين حجم الكود مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو Code Minifier؟",
    a: "أداة تساعد على تصغير حجم الكود عن طريق إزالة المسافات والأسطر والتعليقات غير الضرورية مع الحفاظ على بنية الكود قدر الإمكان."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم معالجة الكود مباشرة داخل المتصفح، لذلك لا تحتاج إلى رفع الكود إلى خادم خارجي."
  },
  {
    q: "ما فائدة تصغير الكود؟",
    a: "تصغير الكود يقلل حجمه ويمكن أن يساعد في تقليل حجم الملفات وتسريع نقلها وتحسين أداء المواقع والتطبيقات."
  },
  {
    q: "هل يمكنني نسخ الكود بعد تصغيره؟",
    a: "نعم. يمكنك نسخ الكود المصغر مباشرة باستخدام زر النسخ."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم. الأداة مجانية ويمكن استخدامها مباشرة من المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
