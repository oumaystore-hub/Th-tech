    <script is:inline>
      (() => {

        const input =
          document.getElementById("inputCode");

        const output =
          document.getElementById("outputCode");

        const inputLines =
          document.getElementById("inputLines");

        const outputLines =
          document.getElementById("outputLines");

        const inputStats =
          document.getElementById("inputStats");

        const outputStats =
          document.getElementById("outputStats");

        const outputSize =
          document.getElementById("outputSize");

        const status =
          document.getElementById("status");

        const minifyBtn =
          document.getElementById("minifyBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const exampleBtn =
          document.getElementById("exampleBtn");

        const savingPercent =
          document.getElementById("savingPercent");

        const compressionText =
          document.getElementById("compressionText");


        /* ======================================
           EXAMPLE
        ======================================= */

        const exampleCode = `// User data
const users = [
  {
    id: 1,
    name: "Ahmed",
    role: "admin"
  },
  {
    id: 2,
    name: "Sara",
    role: "user"
  }
];

// Find admin users
function getAdmins(list) {
  return list.filter(function(user) {
    return user.role === "admin";
  });
}

const admins = getAdmins(users);

console.log("Admins:", admins);`;


        /* ======================================
           STATS
        ======================================= */

        function updateEditorStats() {

          const inputValue =
            input.value;

          const outputValue =
            output.value;


          const inputLineCount =
            inputValue
              ? inputValue.split("\n").length
              : 1;


          const outputLineCount =
            outputValue
              ? outputValue.split("\n").length
              : 1;


          inputLines.textContent =
            Array.from(
              { length: inputLineCount },
              (_, i) => i + 1
            ).join("\n");


          outputLines.textContent =
            Array.from(
              { length: outputLineCount },
              (_, i) => i + 1
            ).join("\n");


          inputStats.textContent =
            `${inputValue.length} حرف`;


          outputStats.textContent =
            `${outputValue.length} حرف`;


          const bytes =
            new Blob([outputValue]).size;


          if (bytes < 1024) {

            outputSize.textContent =
              `${bytes} B`;

          } else {

            outputSize.textContent =
              `${(bytes / 1024).toFixed(1)} KB`;

          }

        }


        /* ======================================
           STATUS
        ======================================= */

        function setStatus(type, text) {

          status.className =
            `status ${type}`;

          status.innerHTML = `
            <span class="status-dot"></span>
            ${text}
          `;

        }


        /* ======================================
           MINIFIER
        ======================================= */

        function minifyCode(code) {

          let result =
            code
              .replace(/\r\n/g, "\n")
              .replace(/\r/g, "\n");


          const placeholders = [];


          /*
           * Protect strings, template literals
           * and comments temporarily.
           */

          result =
            result.replace(
              /(["'`])(?:\\[\s\S]|(?!\1)[\s\S])*?\1|\/\/[^\n]*|\/\*[\s\S]*?\*\//g,
              (match) => {

                const index =
                  placeholders.length;

                placeholders.push(match);

                return `___CODE_MIN_${index}___`;

              }
            );


          /*
           * Remove unnecessary whitespace.
           */

          result =
            result
              .replace(/\s+/g, " ")
              .replace(/\s*([{}[\]();,:])\s*/g, "$1")
              .replace(/\s*([=+\-*\/%<>])\s*/g, "$1")
              .replace(/\s*&&\s*/g, "&&")
              .replace(/\s*\|\|\s*/g, "||")
              .replace(/\s*===\s*/g, "===")
              .replace(/\s*!==\s*/g, "!==")
              .replace(/\s*=>\s*/g, "=>")
              .trim();


          /*
           * Restore protected content.
           */

          result =
            result.replace(
              /___CODE_MIN_(\d+)___/g,
              (_, index) =>
                placeholders[
                  Number(index)
                ]
            );


          /*
           * Remove comments that were protected
           * and are actually comments.
           */

          result =
            result.replace(
              /\/\*[\s\S]*?\*\//g,
              ""
            );


          result =
            result.replace(
              /(^|[;\s{}])\/\/[^\n]*/g,
              "$1"
            );


          /*
           * Final whitespace cleanup.
           */

          result =
            result
              .replace(/\n\s*/g, "")
              .replace(/[ \t]+/g, " ")
              .trim();


          return result;

        }


        /* ======================================
           MINIFY
        ======================================= */

        function minify() {

          const code =
            input.value;


          if (!code.trim()) {

            output.value = "";

            updateEditorStats();

            savingPercent.textContent =
              "0%";

            compressionText.textContent =
              "أدخل الكود أولاً لمعرفة نسبة التوفير";

            setStatus(
              "warning",
              "أدخل الكود أولاً"
            );

            input.focus();

            return;

          }


          const started =
            performance.now();


          try {

            const originalBytes =
              new Blob([code]).size;


            const minified =
              minifyCode(code);


            const minifiedBytes =
              new Blob([minified]).size;


            output.value =
              minified;


            updateEditorStats();


            let saving = 0;


            if (originalBytes > 0) {

              saving =
                Math.max(
                  0,
                  (
                    (
                      1 -
                      minifiedBytes /
                      originalBytes
                    ) *
                    100
                  )
                );

            }


            savingPercent.textContent =
              `${saving.toFixed(1)}%`;


            compressionText.textContent =
              `${formatBytes(originalBytes)} → ${formatBytes(minifiedBytes)}`;


            const elapsed =
              performance.now() -
              started;


            setStatus(
              "success",
              `تم التصغير خلال ${elapsed.toFixed(1)} ms`
            );


          } catch {

            output.value = "";

            updateEditorStats();

            setStatus(
              "error",
              "تعذر تصغير الكود"
            );

          }

        }


        /* ======================================
           FORMAT BYTES
        ======================================= */

        function formatBytes(bytes) {

          if (bytes < 1024) {

            return `${bytes} B`;

          }


          if (bytes < 1024 * 1024) {

            return `${(bytes / 1024).toFixed(1)} KB`;

          }


          return `${(
            bytes /
            (1024 * 1024)
          ).toFixed(1)} MB`;

        }


        /* ======================================
           COPY
        ======================================= */

        async function copyOutput() {

          const value =
            output.value;


          if (!value) {

            setStatus(
              "warning",
              "لا يوجد كود لنسخه"
            );

            return;

          }


          try {

            await navigator.clipboard.writeText(
              value
            );


            const oldText =
              copyBtn.innerHTML;


            copyBtn.innerHTML = `
              <i class="fa-solid fa-check"></i>
              تم النسخ
            `;


            setStatus(
              "success",
              "تم نسخ الكود المصغر"
            );


            setTimeout(() => {

              copyBtn.innerHTML =
                oldText;

            }, 1500);


          } catch {

            output.select();

            document.execCommand("copy");

            setStatus(
              "success",
              "تم نسخ الكود"
            );

          }

        }


        /* ======================================
           CLEAR
        ======================================= */

        function clearAll() {

          input.value = "";

          output.value = "";

          savingPercent.textContent =
            "0%";

          compressionText.textContent =
            "قم بتصغير الكود لمعرفة نسبة التوفير";

          updateEditorStats();

          setStatus(
            "idle",
            "جاهز"
          );

          input.focus();

        }


        /* ======================================
           EXAMPLE
        ======================================= */

        exampleBtn.addEventListener(
          "click",
          () => {

            input.value =
              exampleCode;

            updateEditorStats();

            minify();

            input.focus();

          }
        );


        /* ======================================
           EVENTS
        ======================================= */

        minifyBtn.addEventListener(
          "click",
          minify
        );


        copyBtn.addEventListener(
          "click",
          copyOutput
        );


        clearBtn.addEventListener(
          "click",
          clearAll
        );


        input.addEventListener(
          "input",
          updateEditorStats
        );


        input.addEventListener(
          "scroll",
          () => {

            inputLines.scrollTop =
              input.scrollTop;

          }
        );


        output.addEventListener(
          "scroll",
          () => {

            outputLines.scrollTop =
              output.scrollTop;

          }
        );


        /* ======================================
           TAB + CTRL ENTER
        ======================================= */

        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();


              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;


              input.value =
                input.value.substring(
                  0,
                  start
                ) +
                "  " +
                input.value.substring(
                  end
                );


              input.selectionStart =
                input.selectionEnd =
                  start + 2;


              updateEditorStats();

            }


            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {

              event.preventDefault();

              minify();

            }

          }
        );


        /* ======================================
           INITIAL
        ======================================= */

        updateEditorStats();

      })();
    </script>


