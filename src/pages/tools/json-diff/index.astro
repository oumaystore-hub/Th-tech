---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JSON Diff - مقارنة JSON أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لمقارنة ملفي JSON واكتشاف الاختلافات بينهما بسرعة مع عرض القيم المضافة والمحذوفة والمتغيرة.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>JSON Diff</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-code-compare"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              JSON Tools
            </span>

            <h1>
              JSON <span>Diff</span>
            </h1>

            <p>
              قارن بين ملفي JSON واكتشف الاختلافات
              والإضافات والحذف والتغييرات بسهولة وسرعة.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-code-compare"></i>
              <span>JSON Diff</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="sampleBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-flask"></i>
                مثال
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Editors -->

          <div class="editors">

            <!-- JSON A -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  JSON الأول
                </div>

                <span id="sizeA">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="jsonA"
                  spellcheck="false"
                  placeholder='ضع JSON الأول هنا...

مثال:
{
  "name": "Th.Tech",
  "version": 1,
  "free": true
}'
                ></textarea>

              </div>

            </div>


            <!-- JSON B -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  JSON الثاني
                </div>

                <span id="sizeB">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="jsonB"
                  spellcheck="false"
                  placeholder='ضع JSON الثاني هنا...

مثال:
{
  "name": "Th.Tech",
  "version": 2,
  "premium": true
}'
                ></textarea>

              </div>

            </div>

          </div>


          <!-- Main action -->

          <div class="main-actions">

            <button
              id="compareBtn"
              class="compare-btn"
              type="button"
            >
              <i class="fas fa-code-compare"></i>
              مقارنة JSON
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- Status -->

          <div id="status" class="status hidden">

            <i id="statusIcon" class="fas fa-check-circle"></i>

            <span id="statusText"></span>

          </div>


          <!-- Results -->

          <div id="result" class="result hidden">

            <div class="result-header">

              <div>
                <i class="fas fa-chart-simple"></i>
                نتيجة المقارنة
              </div>

              <span id="resultCount">0 اختلاف</span>

            </div>


            <div class="result-summary">

              <div class="summary-card added">

                <div class="summary-icon">
                  <i class="fas fa-plus"></i>
                </div>

                <div>
                  <strong id="addedCount">0</strong>
                  <span>مضاف</span>
                </div>

              </div>


              <div class="summary-card removed">

                <div class="summary-icon">
                  <i class="fas fa-minus"></i>
                </div>

                <div>
                  <strong id="removedCount">0</strong>
                  <span>محذوف</span>
                </div>

              </div>


              <div class="summary-card changed">

                <div class="summary-icon">
                  <i class="fas fa-pen"></i>
                </div>

                <div>
                  <strong id="changedCount">0</strong>
                  <span>متغير</span>
                </div>

              </div>


              <div class="summary-card same">

                <div class="summary-icon">
                  <i class="fas fa-check"></i>
                </div>

                <div>
                  <strong id="sameCount">0</strong>
                  <span>متطابق</span>
                </div>

              </div>

            </div>


            <div class="diff-container">

              <div class="diff-title">
                <i class="fas fa-list"></i>
                التفاصيل
              </div>

              <div id="diffList" class="diff-list"></div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>مقارنة فورية</h3>

              <p>
                تتم مقارنة JSON مباشرة داخل المتصفح
                دون الحاجة إلى إرسال ملفاتك إلى خادم خارجي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>خصوصية أفضل</h3>

              <p>
                بيانات JSON تبقى داخل متصفحك أثناء عملية المقارنة.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-magnifying-glass"></i>
            </div>

            <div>

              <h3>اكتشف الاختلافات</h3>

              <p>
                تعرف بسهولة على المفاتيح المضافة والمحذوفة
                والقيم التي تغيرت.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>JSON Diff؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-file-code"></i>
              </div>

              <h3>أدخل JSON الأول</h3>

              <p>
                ضع نسخة JSON الأولى في مربع الإدخال الأيسر.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-file-circle-plus"></i>
              </div>

              <h3>أدخل JSON الثاني</h3>

              <p>
                ضع النسخة الثانية التي تريد مقارنتها.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-code-compare"></i>
              </div>

              <h3>قارن النتيجة</h3>

              <p>
                اضغط مقارنة JSON لرؤية جميع الاختلافات.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>JSON Diff</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو JSON Diff؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                JSON Diff هي أداة لمقارنة بنيتين من JSON
                ومعرفة المفاتيح والقيم التي تغيرت بينهما.
              </p>

            </details>


            <details>

              <summary>
                هل يتم إرسال JSON إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم عملية التحليل والمقارنة بالكامل
                باستخدام JavaScript داخل المتصفح.
              </p>

            </details>


            <details>

              <summary>
                ماذا يحدث إذا كان JSON غير صالح؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                ستظهر رسالة تخبرك بأن أحد ملفات JSON
                غير صالح ولن تتم المقارنة حتى يتم تصحيحه.
              </p>

            </details>


            <details>

              <summary>
                هل ترتيب المفاتيح يؤثر على المقارنة؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم مقارنة الكائنات حسب المفاتيح والقيم،
                لذلك تغيير ترتيب المفاتيح وحده لا يعتبر اختلافًا.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --orange: #ea580c;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;
      --orange: #f97316;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    textarea {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);

      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 700px;
      margin: 0;

      color: var(--muted);
      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);
      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;

      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(37, 99, 235, .35);

      color: var(--primary);

      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);

      border-color: rgba(220, 38, 38, .25);
    }


    /* ================= EDITORS ================= */

    .editors {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 18px;

      padding: 20px;
    }


    .editor-panel {
      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px 15px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;
      font-weight: 700;
    }


    .panel-header > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .panel-header i {
      color: var(--primary);
    }


    .editor-wrapper {
      height: 350px;
    }


    textarea {
      width: 100%;
      height: 100%;

      display: block;

      resize: none;

      outline: none;

      border: 0;

      padding: 18px;

      background: transparent;

      color: var(--text);

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .84rem;

      line-height: 1.8;
    }


    textarea::placeholder {
      color: var(--muted);
      opacity: .65;
    }


    #jsonA {
      color: var(--text);
    }


    #jsonB {
      color: var(--primary);
    }


    /* ================= ACTION ================= */

    .main-actions {
      display: flex;
      justify-content: center;

      padding: 0 20px 20px;
    }


    .compare-btn {
      min-width: 230px;
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 10px;

      border: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #3b82f6,
          #2563eb
        );

      color: white;

      font-family: inherit;

      font-size: .9rem;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(37, 99, 235, .22);

      transition: .25s ease;
    }


    .compare-btn:hover {
      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(37, 99, 235, .30);
    }


    /* ================= STATUS ================= */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border:
        1px solid
        rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background:
        rgba(220, 38, 38, .08);

      border-color:
        rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none !important;
    }


    /* ================= RESULT ================= */

    .result {
      margin: 0 20px 20px;

      overflow: hidden;

      border-radius: 17px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .result-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 14px 17px;

      border-bottom: 1px solid var(--border);

      font-size: .82rem;
      font-weight: 800;
    }


    .result-header > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }


    .result-header i {
      color: var(--primary);
    }


    #resultCount {
      color: var(--muted);
      font-size: .72rem;
    }


    .result-summary {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 1px;

      background: var(--border);
    }


    .summary-card {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 10px;

      padding: 17px;

      background: var(--card);
    }


    .summary-icon {
      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      font-size: .85rem;
    }


    .summary-card.added
    .summary-icon {
      color: var(--green);

      background:
        rgba(34, 197, 94, .10);
    }


    .summary-card.removed
    .summary-icon {
      color: var(--red);

      background:
        rgba(220, 38, 38, .10);
    }


    .summary-card.changed
    .summary-icon {
      color: var(--orange);

      background:
        rgba(234, 88, 12, .10);
    }


    .summary-card.same
    .summary-icon {
      color: var(--primary);

      background:
        rgba(37, 99, 235, .10);
    }


    .summary-card strong {
      display: block;

      font-size: 1rem;
      line-height: 1.2;
    }


    .summary-card span {
      display: block;

      color: var(--muted);

      font-size: .65rem;
    }


    /* ================= DIFF ================= */

    .diff-container {
      padding: 18px;
    }


    .diff-title {
      display: flex;
      align-items: center;

      gap: 8px;

      margin-bottom: 12px;

      color: var(--text);

      font-size: .78rem;
      font-weight: 800;
    }


    .diff-title i {
      color: var(--primary);
    }


    .diff-list {
      display: grid;

      gap: 8px;

      max-height: 500px;

      overflow-y: auto;
    }


    .diff-item {
      display: grid;

      grid-template-columns: 105px 1fr;

      gap: 12px;

      padding: 12px 14px;

      border-radius: 11px;

      border: 1px solid var(--border);

      background: var(--card);
    }


    .diff-type {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      align-self: start;

      min-height: 28px;

      padding: 4px 8px;

      border-radius: 8px;

      font-size: .65rem;

      font-weight: 800;
    }


    .diff-item.added
    .diff-type {
      color: var(--green);

      background:
        rgba(34, 197, 94, .10);
    }


    .diff-item.removed
    .diff-type {
      color: var(--red);

      background:
        rgba(220, 38, 38, .10);
    }


    .diff-item.changed
    .diff-type {
      color: var(--orange);

      background:
        rgba(234, 88, 12, .10);
    }


    .diff-item.same
    .diff-type {
      color: var(--primary);

      background:
        rgba(37, 99, 235, .10);
    }


    .diff-content {
      min-width: 0;
    }


    .diff-path {
      margin-bottom: 4px;

      color: var(--primary);

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .72rem;

      font-weight: 700;

      word-break: break-all;
    }


    .diff-values {
      display: grid;

      gap: 5px;
    }


    .diff-value {
      padding: 7px 9px;

      border-radius: 7px;

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .7rem;

      word-break: break-all;
    }


    .old-value {
      background:
        rgba(220, 38, 38, .07);

      color: var(--red);
    }


    .new-value {
      background:
        rgba(34, 197, 94, .07);

      color: var(--green);
    }


    .empty-result {
      padding: 25px;

      text-align: center;

      color: var(--muted);

      font-size: .78rem;
    }


    .empty-result i {
      display: block;

      margin-bottom: 8px;

      color: var(--green);

      font-size: 1.7rem;
    }


    /* ================= INFO ================= */

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;
    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* ================= STEPS ================= */

    .steps {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;

      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;

      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open]
    summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .editors {
        grid-template-columns: 1fr;
      }


      .result-summary {
        grid-template-columns:
          repeat(2, 1fr);
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .editors {
        padding: 12px;

        gap: 12px;
      }


      .editor-wrapper {
        height: 280px;
      }


      textarea {
        padding: 14px;

        font-size: .76rem;
      }


      .compare-btn {
        width: 100%;

        min-width: 0;
      }


      .result {
        margin-left: 12px;
        margin-right: 12px;
      }


      .result-summary {
        grid-template-columns: 1fr 1fr;
      }


      .summary-card {
        padding: 13px 8px;

        gap: 7px;
      }


      .summary-icon {
        width: 34px;
        height: 34px;
      }


      .diff-container {
        padding: 12px;
      }


      .diff-item {
        grid-template-columns: 1fr;

        gap: 7px;
      }


      .diff-type {
        justify-self: start;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {
            applyTheme(
              theme === 'dark'
            );
          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      /* ================= ELEMENTS ================= */

      const jsonA =
        document.getElementById('jsonA');

      const jsonB =
        document.getElementById('jsonB');

      const compareBtn =
        document.getElementById('compareBtn');

      const sampleBtn =
        document.getElementById('sampleBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const sizeA =
        document.getElementById('sizeA');

      const sizeB =
        document.getElementById('sizeB');

      const result =
        document.getElementById('result');

      const resultCount =
        document.getElementById('resultCount');

      const addedCount =
        document.getElementById('addedCount');

      const removedCount =
        document.getElementById('removedCount');

      const changedCount =
        document.getElementById('changedCount');

      const sameCount =
        document.getElementById('sameCount');

      const diffList =
        document.getElementById('diffList');


      /* ================= SIZE ================= */

      const getBytes = (text) => {

        return new Blob([text]).size;

      };


      const formatBytes = (bytes) => {

        if (!bytes) {
          return '0 B';
        }

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {
          return `${(bytes / 1024).toFixed(2)} KB`;
        }

        return `${(
          bytes /
          (1024 * 1024)
        ).toFixed(2)} MB`;

      };


      const updateSizes = () => {

        sizeA.textContent =
          formatBytes(
            getBytes(jsonA.value)
          );

        sizeB.textContent =
          formatBytes(
            getBytes(jsonB.value)
          );

      };


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add('hidden');

      };


      /* ================= VALUE ================= */

      const valueToText = (value) => {

        if (value === undefined) {
          return 'undefined';
        }

        if (typeof value === 'string') {
          return `"${value}"`;
        }

        return JSON.stringify(value);

      };


      /* ================= DIFF ENGINE ================= */

      const compareJSON = (
        first,
        second,
        path = '$',
        differences = []
      ) => {

        const firstIsObject =
          first !== null &&
          typeof first === 'object';

        const secondIsObject =
          second !== null &&
          typeof second === 'object';


        if (
          !firstIsObject ||
          !secondIsObject
        ) {

          if (
            JSON.stringify(first) ===
            JSON.stringify(second)
          ) {

            differences.push({
              type: 'same',
              path,
              oldValue: first,
              newValue: second
            });

          } else {

            differences.push({
              type: 'changed',
              path,
              oldValue: first,
              newValue: second
            });

          }

          return differences;

        }


        const firstArray =
          Array.isArray(first);

        const secondArray =
          Array.isArray(second);


        if (firstArray !== secondArray) {

          differences.push({
            type: 'changed',
            path,
            oldValue: first,
            newValue: second
          });

          return differences;

        }


        if (firstArray && secondArray) {

          const max =
            Math.max(
              first.length,
              second.length
            );

          for (
            let i = 0;
            i < max;
            i++
          ) {

            const currentPath =
              `${path}[${i}]`;

            if (
              i >= first.length
            ) {

              differences.push({
                type: 'added',
                path: currentPath,
                oldValue: undefined,
                newValue: second[i]
              });

            } else if (
              i >= second.length
            ) {

              differences.push({
                type: 'removed',
                path: currentPath,
                oldValue: first[i],
                newValue: undefined
              });

            } else {

              compareJSON(
                first[i],
                second[i],
                currentPath,
                differences
              );

            }

          }

          return differences;

        }


        const keys =
          new Set([
            ...Object.keys(first),
            ...Object.keys(second)
          ]);


        for (const key of keys) {

          const currentPath =
            path === '$'
              ? `$.${key}`
              : `${path}.${key}`;


          if (
            !Object.prototype.hasOwnProperty.call(
              first,
              key
            )
          ) {

            differences.push({
              type: 'added',
              path: currentPath,
              oldValue: undefined,
              newValue: second[key]
            });

            continue;

          }


          if (
            !Object.prototype.hasOwnProperty.call(
              second,
              key
            )
          ) {

            differences.push({
              type: 'removed',
              path: currentPath,
              oldValue: first[key],
              newValue: undefined
            });

            continue;

          }


          compareJSON(
            first[key],
            second[key],
            currentPath,
            differences
          );

        }


        return differences;

      };


      /* ================= RENDER ================= */

      const renderDiff = (
        differences
      ) => {

        diffList.innerHTML = '';


        const meaningful =
          differences.filter(
            item =>
              item.type !== 'same'
          );


        const same =
          differences.filter(
            item =>
              item.type === 'same'
          ).length;


        const added =
          differences.filter(
            item =>
              item.type === 'added'
          ).length;


        const removed =
          differences.filter(
            item =>
              item.type === 'removed'
          ).length;


        const changed =
          differences.filter(
            item =>
              item.type === 'changed'
          ).length;


        addedCount.textContent =
          added;

        removedCount.textContent =
          removed;

        changedCount.textContent =
          changed;

        sameCount.textContent =
          same;


        const total =
          added +
          removed +
          changed;


        resultCount.textContent =
          total === 0
            ? 'متطابق'
            : `${total} اختلاف`;


        if (!meaningful.length) {

          diffList.innerHTML = `
            <div class="empty-result">
              <i class="fas fa-circle-check"></i>
              ملفا JSON متطابقان تمامًا.
            </div>
          `;

          return;

        }


        meaningful.forEach(
          (item) => {

            const element =
              document.createElement('div');

            element.className =
              `diff-item ${item.type}`;


            let label = 'متغير';

            if (item.type === 'added') {
              label = 'مضاف';
            }

            if (item.type === 'removed') {
              label = 'محذوف';
            }


            let values = '';


            if (
              item.type === 'changed'
            ) {

              values = `
                <div class="diff-values">

                  <div class="diff-value old-value">
                    - ${escapeHTML(
                      valueToText(item.oldValue)
                    )}
                  </div>

                  <div class="diff-value new-value">
                    + ${escapeHTML(
                      valueToText(item.newValue)
                    )}
                  </div>

                </div>
              `;

            } else if (
              item.type === 'added'
            ) {

              values = `
                <div class="diff-value new-value">
                  + ${escapeHTML(
                    valueToText(item.newValue)
                  )}
                </div>
              `;

            } else {

              values = `
                <div class="diff-value old-value">
                  - ${escapeHTML(
                    valueToText(item.oldValue)
                  )}
                </div>
              `;

            }


            element.innerHTML = `

              <div class="diff-type">
                ${label}
              </div>

              <div class="diff-content">

                <div class="diff-path">
                  ${escapeHTML(item.path)}
                </div>

                ${values}

              </div>

            `;


            diffList.appendChild(
              element
            );

          }
        );

      };


      /* ================= ESCAPE ================= */

      const escapeHTML = (value) => {

        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      };


      /* ================= COMPARE ================= */

      const runComparison = () => {

        hideStatus();

        const valueA =
          jsonA.value.trim();

        const valueB =
          jsonB.value.trim();


        if (!valueA) {

          result.classList.add('hidden');

          showStatus(
            'أدخل JSON الأول أولاً.',
            true
          );

          jsonA.focus();

          return;

        }


        if (!valueB) {

          result.classList.add('hidden');

          showStatus(
            'أدخل JSON الثاني أولاً.',
            true
          );

          jsonB.focus();

          return;

        }


        let parsedA;
        let parsedB;


        try {

          parsedA =
            JSON.parse(valueA);

        } catch {

          result.classList.add('hidden');

          showStatus(
            'JSON الأول غير صالح. تحقق من الصيغة.',
            true
          );

          jsonA.focus();

          return;

        }


        try {

          parsedB =
            JSON.parse(valueB);

        } catch {

          result.classList.add('hidden');

          showStatus(
            'JSON الثاني غير صالح. تحقق من الصيغة.',
            true
          );

          jsonB.focus();

          return;

        }


        const differences =
          compareJSON(
            parsedA,
            parsedB
          );


        renderDiff(
          differences
        );


        result.classList.remove(
          'hidden'
        );


        const different =
          differences.some(
            item =>
              item.type !== 'same'
          );


        if (different) {

          showStatus(
            'تمت مقارنة JSON واكتشاف الاختلافات.'
          );

        } else {

          showStatus(
            'تمت المقارنة. ملفا JSON متطابقان.'
          );

        }

      };


      /* ================= SAMPLE ================= */

      const loadSample = () => {

        jsonA.value = `{
  "name": "Th.Tech",
  "version": 1,
  "description": "Technology Tools",
  "free": true,
  "tools": 100
}`;

        jsonB.value = `{
  "name": "Th.Tech",
  "version": 2,
  "description": "Developer Tools",
  "premium": true,
  "tools": 120
}`;

        updateSizes();

        runComparison();

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        jsonA.value = '';

        jsonB.value = '';

        result.classList.add(
          'hidden'
        );

        diffList.innerHTML = '';

        hideStatus();

        updateSizes();

        jsonA.focus();

      };


      /* ================= EVENTS ================= */

      compareBtn.addEventListener(
        'click',
        runComparison
      );


      sampleBtn.addEventListener(
        'click',
        loadSample
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      jsonA.addEventListener(
        'input',
        updateSizes
      );


      jsonB.addEventListener(
        'input',
        updateSizes
      );


      jsonA.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            runComparison();

          }

        }
      );


      jsonB.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            runComparison();

          }

        }
      );


      /* ================= INITIAL ================= */

      updateSizes();

    })();
  </script>

