---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "HEX to HSL - تحويل HEX إلى HSL أونلاين مجاناً | Th.Tech";

const description =
  "أداة HEX to HSL مجانية لتحويل ألوان HEX إلى HSL مباشرة داخل المتصفح، مع عرض Hue وSaturation وLightness وCSS.";

const faqs = [
  {
    q: "ما هو نظام HSL؟",
    a: "HSL هو نظام لتمثيل الألوان يعتمد على Hue وSaturation وLightness، أي درجة اللون والتشبع والإضاءة."
  },
  {
    q: "كيف أحول HEX إلى HSL؟",
    a: "أدخل قيمة HEX مثل #3498db ثم اضغط على زر تحويل HEX إلى HSL للحصول على القيم المقابلة مباشرة."
  },
  {
    q: "هل الأداة تدعم HEX المختصر؟",
    a: "نعم، الأداة تدعم صيغ HEX القياسية المكونة من 6 أحرف، كما تدعم الصيغة المختصرة المكونة من 3 أحرف مثل #fff."
  },
  {
    q: "هل يتم إرسال اللون إلى الخادم؟",
    a: "لا. تتم جميع عمليات التحويل داخل المتصفح باستخدام JavaScript، ولا يتم إرسال قيمة اللون إلى خادم خارجي."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/hex-to-hsl/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <span>HEX to HSL</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <div class="icon-glow"></div>
            <i class="fa-solid fa-palette"></i>
            <span>HSL</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>HEX to HSL</h1>

            <p>
              حوّل ألوان HEX إلى HSL بسرعة ودقة مباشرة من المتصفح.
            </p>

            <div class="tags">
              <span>HEX</span>
              <span>HSL</span>
