---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/unix-permission/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Unix Permission Calculator | حاسبة صلاحيات Unix - Th.Tech</title>

  <meta
    name="description"
    content="حاسبة صلاحيات Unix تفاعلية لحساب صلاحيات User وGroup وOthers وتحويلها إلى الصيغة الرقمية والرمزية وأمر chmod."
  />

  <meta
    name="keywords"
    content="Unix Permission Calculator, Unix permissions, Linux permissions, chmod calculator, حاسبة صلاحيات Unix, صلاحيات Linux"
  />

  <link rel="canonical" href={canonical} />

  <meta name="theme-color" content="#07111f" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="permission-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-icon">
        <i class="fa-solid fa-lock"></i>
      </div>

      <div class="hero-content">

        <span class="eyebrow">
          <i class="fa-brands fa-linux"></i>
          UNIX / LINUX DEVELOPER TOOL
        </span>

        <h1>
          حاسبة صلاحيات
          <span>Unix</span>
        </h1>

        <p>
          احسب صلاحيات الملفات والمجلدات بسهولة باستخدام
          User وGroup وOthers.
        </p>

      </div>

    </section>


    <!-- LIVE RESULT -->
    <section class="result-panel">

      <div class="result-item">

        <span class="result-label">
          الصيغة الرقمية
        </span>

        <strong id="numericResult">
          755
        </strong>

      </div>


      <div class="result-divider"></div>


      <div class="result-item symbolic-result">

        <span class="result-label">
          الصيغة الرمزية
        </span>

        <strong id="symbolicResult">
          rwxr-xr-x
        </strong>

      </div>


      <div class="result-divider"></div>


      <div class="result-item">

        <span class="result-label">
          القيمة الإجمالية
        </span>

        <strong id="totalValue">
          493
        </strong>

      </div>

    </section>


    <!-- PERMISSION CALCULATOR -->
    <section class="calculator-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-solid fa-sliders"></i>
        </div>

        <div>
          <h2>محدد الصلاحيات</h2>

          <p>
            فعّل أو عطّل الصلاحيات المطلوبة
          </p>
        </div>

      </div>


      <div class="permission-grid">


        <!-- USER -->
        <div class="permission-card">

          <div class="permission-card-header">

            <div class="role-icon user-icon">
              <i class="fa-solid fa-user"></i>
            </div>

            <div>
              <h3>المالك</h3>
              <span>User / Owner</span>
            </div>

            <strong
              id="userDigit"
              class="role-digit"
            >
              7
            </strong>

          </div>


          <div class="permission-list">

            <label class="permission-row">

              <input
                type="checkbox"
                data-role="user"
                data-permission="read"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Read</strong>
                <small>قراءة</small>
              </span>

              <span class="permission-letter">
                r
              </span>

              <span class="permission-value">
                4
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="user"
                data-permission="write"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Write</strong>
                <small>كتابة</small>
              </span>

              <span class="permission-letter">
                w
              </span>

              <span class="permission-value">
                2
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="user"
                data-permission="execute"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Execute</strong>
                <small>تنفيذ</small>
              </span>

              <span class="permission-letter">
                x
              </span>

              <span class="permission-value">
                1
              </span>

            </label>

          </div>

        </div>


        <!-- GROUP -->
        <div class="permission-card">

          <div class="permission-card-header">

            <div class="role-icon group-icon">
              <i class="fa-solid fa-users"></i>
            </div>

            <div>
              <h3>المجموعة</h3>
              <span>Group</span>
            </div>

            <strong
              id="groupDigit"
              class="role-digit"
            >
              5
            </strong>

          </div>


          <div class="permission-list">

            <label class="permission-row">

              <input
                type="checkbox"
                data-role="group"
                data-permission="read"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Read</strong>
                <small>قراءة</small>
              </span>

              <span class="permission-letter">
                r
              </span>

              <span class="permission-value">
                4
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="group"
                data-permission="write"
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Write</strong>
                <small>كتابة</small>
              </span>

              <span class="permission-letter">
                w
              </span>

              <span class="permission-value">
                2
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="group"
                data-permission="execute"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Execute</strong>
                <small>تنفيذ</small>
              </span>

              <span class="permission-letter">
                x
              </span>

              <span class="permission-value">
                1
              </span>

            </label>

          </div>

        </div>


        <!-- OTHERS -->
        <div class="permission-card">

          <div class="permission-card-header">

            <div class="role-icon others-icon">
              <i class="fa-solid fa-globe"></i>
            </div>

            <div>
              <h3>الآخرون</h3>
              <span>Others</span>
            </div>

            <strong
              id="othersDigit"
              class="role-digit"
            >
              5
            </strong>

          </div>


          <div class="permission-list">

            <label class="permission-row">

              <input
                type="checkbox"
                data-role="others"
                data-permission="read"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Read</strong>
                <small>قراءة</small>
              </span>

              <span class="permission-letter">
                r
              </span>

              <span class="permission-value">
                4
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="others"
                data-permission="write"
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Write</strong>
                <small>كتابة</small>
              </span>

              <span class="permission-letter">
                w
              </span>

              <span class="permission-value">
                2
              </span>

            </label>


            <label class="permission-row">

              <input
                type="checkbox"
                data-role="others"
                data-permission="execute"
                checked
              />

              <span class="custom-check">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="permission-name">
                <strong>Execute</strong>
                <small>تنفيذ</small>
              </span>

              <span class="permission-letter">
                x
              </span>

              <span class="permission-value">
                1
              </span>

            </label>

          </div>

        </div>

      </div>

    </section>


    <!-- COMMAND -->
    <section class="command-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-solid fa-terminal"></i>
        </div>

        <div>
          <h2>أمر chmod</h2>

          <p>
            الأمر الجاهز لتطبيق الصلاحيات
          </p>
        </div>

      </div>


      <div class="command-card">

        <div class="command-code">

          <span class="command-prefix">
            $
          </span>

          <code id="commandOutput">
            chmod 755 filename
          </code>

        </div>

        <button
          id="copyCommandBtn"
          class="copy-button"
          type="button"
          aria-label="نسخ الأمر"
          title="نسخ الأمر"
        >
          <i class="fa-regular fa-copy"></i>
          <span>نسخ</span>
        </button>

      </div>

    </section>


    <!-- FILENAME -->
    <section class="filename-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-regular fa-file-code"></i>
        </div>

        <div>
          <h2>اسم الملف</h2>

          <p>
            استخدم اسم ملفك لإنشاء الأمر النهائي
          </p>
        </div>

      </div>


      <div class="filename-card">

        <div class="filename-input">

          <i class="fa-regular fa-file"></i>

          <input
            id="filenameInput"
            type="text"
            value="filename"
            placeholder="filename"
            autocomplete="off"
          />

        </div>

        <div class="filename-preview">

          <span>
            الأمر:
          </span>

          <code id="filenameCommand">
            chmod 755 filename
          </code>

        </div>

      </div>

    </section>


    <!-- QUICK PRESETS -->
    <section class="preset-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-solid fa-bolt"></i>
        </div>

        <div>
          <h2>إعدادات جاهزة</h2>

          <p>
            اختر صلاحية شائعة بنقرة واحدة
          </p>
        </div>

      </div>


      <div class="preset-grid">

        <button
          class="preset"
          data-value="755"
          type="button"
        >
          <strong>755</strong>
          <span>rwxr-xr-x</span>
          <small>تنفيذ شائع</small>
        </button>


        <button
          class="preset"
          data-value="644"
          type="button"
        >
          <strong>644</strong>
          <span>rw-r--r--</span>
          <small>ملفات عادية</small>
        </button>


        <button
          class="preset"
          data-value="700"
          type="button"
        >
          <strong>700</strong>
          <span>rwx------</span>
          <small>خاص بالمالك</small>
        </button>


        <button
          class="preset"
          data-value="600"
          type="button"
        >
          <strong>600</strong>
          <span>rw-------</span>
          <small>ملف خاص</small>
        </button>


        <button
          class="preset"
          data-value="775"
          type="button"
        >
          <strong>775</strong>
          <span>rwxrwxr-x</span>
          <small>مجلدات مشتركة</small>
        </button>


        <button
          class="preset danger"
          data-value="777"
          type="button"
        >
          <strong>777</strong>
          <span>rwxrwxrwx</span>
          <small>صلاحيات كاملة</small>
        </button>

      </div>

    </section>


    <!-- ACTIONS -->
    <section class="actions">

      <button
        id="copyAllBtn"
        class="main-action"
        type="button"
      >
        <i class="fa-regular fa-copy"></i>
        نسخ النتائج
      </button>


      <button
        id="resetBtn"
        class="reset-action"
        type="button"
      >
        <i class="fa-solid fa-rotate-right"></i>
        إعادة ضبط
      </button>

    </section>


    <!-- EXPLANATION -->
    <section class="explanation">

      <div class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>

          <h2>
            كيف تعمل صلاحيات Unix؟
          </h2>

          <p>
            صلاحيات Unix تقسم الوصول إلى ثلاثة مستويات:
            المالك User، المجموعة Group، والآخرون Others.
          </p>

          <div class="permission-examples">

            <div>
              <strong>r</strong>
              <span>Read — قراءة</span>
              <b>4</b>
            </div>

            <div>
              <strong>w</strong>
              <span>Write — كتابة</span>
              <b>2</b>
            </div>

            <div>
              <strong>x</strong>
              <span>Execute — تنفيذ</span>
              <b>1</b>
            </div>

          </div>

        </div>

      </div>


      <div class="warning-card">

        <div class="warning-icon">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <div>

          <h3>
            انتبه إلى الصلاحية 777
          </h3>

          <p>
            تمنح 777 صلاحيات القراءة والكتابة والتنفيذ للمالك
            والمجموعة وجميع المستخدمين. استخدمها فقط عندما تكون
            هناك حاجة واضحة لذلك.
          </p>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="section-heading">

        <div class="heading-icon">
          <i class="fa-solid fa-circle-question"></i>
        </div>

        <div>
          <h2>الأسئلة الشائعة</h2>

          <p>
            معلومات سريعة حول Unix Permissions
          </p>
        </div>

      </div>


      <div class="faq-list">

        <details>

          <summary>
            <span>
              ماذا يعني الرقم 755؟
            </span>

            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            يعني أن المالك لديه القراءة والكتابة والتنفيذ،
            بينما المجموعة والآخرون لديهم القراءة والتنفيذ فقط.
          </p>

        </details>


        <details>

          <summary>
            <span>
              ماذا تعني الصيغة rwxr-xr-x؟
            </span>

            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            هي الصيغة الرمزية للصلاحية 755، وتتكون من ثلاث
            مجموعات، كل مجموعة مكونة من Read وWrite وExecute.
          </p>

        </details>


        <details>

          <summary>
            <span>
              ما قيمة Read وWrite وExecute؟
            </span>

            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            القراءة تساوي 4، والكتابة تساوي 2، والتنفيذ يساوي 1.
            يتم جمع القيم للحصول على رقم كل مجموعة.
          </p>

        </details>


        <details>

          <summary>
            <span>
              ما الفرق بين User وGroup وOthers؟
            </span>

            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            User هو مالك الملف، Group هي المجموعة المرتبطة بالملف،
            وOthers هم باقي المستخدمين الذين لا ينتمون إلى المالك
            أو المجموعة المحددة.
          </p>

        </details>

      </div>

    </section>

  





<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/unix-timestamp/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Unix Timestamp</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  /* الوضع الفاتح */
  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    color: #0f172a;
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card strong {
    color: #0f172a;
  }

  [data-theme="light"] .related-tool-card small {
    color: #64748b;
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }

  [data-theme="light"] .related-tool-icon {
    background: rgba(14, 165, 233, 0.12);
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


  <Footer />


  <!-- TOAST -->
  <div
    id="toast"
    class="toast"
    role="status"
    aria-live="polite"
  >

    <i class="fa-solid fa-check"></i>

    <span id="toastMessage">
      تم النسخ بنجاح
    </span>

  </div>


  <script>
    document.addEventListener('DOMContentLoaded', () => {

      /* ============================================
       * TH-TECH THEME SYNC
       * ============================================ */

      function syncTheme() {

        const theme =
          localStorage.getItem('theme');

        if (theme === 'light') {

          document.documentElement.setAttribute(
            'data-theme',
            'light'
          );

        } else {

          document.documentElement.removeAttribute(
            'data-theme'
          );

        }

      }

      syncTheme();


      const themeButton =
        document.getElementById('theme-btn');

      if (themeButton) {

        themeButton.addEventListener(
          'click',
          () => {

            setTimeout(() => {
              syncTheme();
            }, 0);

          }
        );

      }


      /* ============================================
       * ELEMENTS
       * ============================================ */

      const numericResult =
        document.getElementById(
          'numericResult'
        );

      const symbolicResult =
        document.getElementById(
          'symbolicResult'
        );

      const totalValue =
        document.getElementById(
          'totalValue'
        );

      const userDigit =
        document.getElementById(
          'userDigit'
        );

      const groupDigit =
        document.getElementById(
          'groupDigit'
        );

      const othersDigit =
        document.getElementById(
          'othersDigit'
        );

      const commandOutput =
        document.getElementById(
          'commandOutput'
        );

      const filenameCommand =
        document.getElementById(
          'filenameCommand'
        );

      const filenameInput =
        document.getElementById(
          'filenameInput'
        );

      const copyCommandBtn =
        document.getElementById(
          'copyCommandBtn'
        );

      const copyAllBtn =
        document.getElementById(
          'copyAllBtn'
        );

      const resetBtn =
        document.getElementById(
          'resetBtn'
        );

      const toast =
        document.getElementById(
          'toast'
        );

      const toastMessage =
        document.getElementById(
          'toastMessage'
        );


      /* ============================================
       * ROLE CALCULATIONS
       * ============================================ */

      function getRoleDigit(role) {

        let value = 0;


        const read =
          document.querySelector(
            `input[data-role="${role}"][data-permission="read"]`
          );

        const write =
          document.querySelector(
            `input[data-role="${role}"][data-permission="write"]`
          );

        const execute =
          document.querySelector(
            `input[data-role="${role}"][data-permission="execute"]`
          );


        if (read && read.checked) {
          value += 4;
        }


        if (write && write.checked) {
          value += 2;
        }


        if (execute && execute.checked) {
          value += 1;
        }


        return value;
      }


      /* ============================================
       * SYMBOLIC CONVERSION
       * ============================================ */

      function digitToSymbolic(digit) {

        const values = [
          '---',
          '--x',
          '-w-',
          '-wx',
          'r--',
          'r-x',
          'rw-',
          'rwx'
        ];

        return values[digit] || '---';
      }


      function numericToSymbolic(number) {

        const value =
          String(number);

        if (
          !/^[0-7]{3}$/.test(value)
        ) {
          return '---------';
        }


        return (
          digitToSymbolic(
            Number(value[0])
          ) +

          digitToSymbolic(
            Number(value[1])
          ) +

          digitToSymbolic(
            Number(value[2])
          )
        );

      }


      /* ============================================
       * UPDATE CALCULATOR
       * ============================================ */

      function updateCalculator() {

        const user =
          getRoleDigit('user');

        const group =
          getRoleDigit('group');

        const others =
          getRoleDigit('others');


        const numeric =
          `${user}${group}${others}`;


        const symbolic =
          numericToSymbolic(numeric);


        const total =
          user * 64 +
          group * 8 +
          others;


        numericResult.textContent =
          numeric;

        symbolicResult.textContent =
          symbolic;

        totalValue.textContent =
          total;


        userDigit.textContent =
          user;

        groupDigit.textContent =
          group;

        othersDigit.textContent =
          others;


        updateCommand(numeric);

      }


      /* ============================================
       * COMMAND
       * ============================================ */

      function updateCommand(numeric) {

        const filename =
          filenameInput.value.trim() ||
          'filename';


        const command =
          `chmod ${numeric} ${filename}`;


        commandOutput.textContent =
          command;

        filenameCommand.textContent =
          command;

      }


      /* ============================================
       * PERMISSION EVENTS
       * ============================================ */

      document
        .querySelectorAll(
          '.permission-row input'
        )
        .forEach(input => {

          input.addEventListener(
            'change',
            updateCalculator
          );

        });


      /* ============================================
       * FILENAME
       * ============================================ */

      filenameInput.addEventListener(
        'input',
        () => {

          const user =
            getRoleDigit('user');

          const group =
            getRoleDigit('group');

          const others =
            getRoleDigit('others');

          const numeric =
            `${user}${group}${others}`;

          updateCommand(numeric);

        }
      );


      /* ============================================
       * PRESETS
       * ============================================ */

      document
        .querySelectorAll('.preset')
        .forEach(button => {

          button.addEventListener(
            'click',
            () => {

              const value =
                button.dataset.value;


              if (
                !/^[0-7]{3}$/.test(value)
              ) {
                return;
              }


              setFromNumeric(value);


              showToast(
                `تم اختيار الصلاحية ${value}`
              );

            }
          );

        });


      /* ============================================
       * SET FROM NUMERIC
       * ============================================ */

      function setFromNumeric(number) {

        const roles = [
          {
            name: 'user',
            digit: Number(number[0])
          },
          {
            name: 'group',
            digit: Number(number[1])
          },
          {
            name: 'others',
            digit: Number(number[2])
          }
        ];


        roles.forEach(role => {

          const read =
            document.querySelector(
              `input[data-role="${role.name}"][data-permission="read"]`
            );

          const write =
            document.querySelector(
              `input[data-role="${role.name}"][data-permission="write"]`
            );

          const execute =
            document.querySelector(
              `input[data-role="${role.name}"][data-permission="execute"]`
            );


          if (read) {
            read.checked =
              Boolean(role.digit & 4);
          }


          if (write) {
            write.checked =
              Boolean(role.digit & 2);
          }


          if (execute) {
            execute.checked =
              Boolean(role.digit & 1);
          }

        });


        updateCalculator();

      }


      /* ============================================
       * COPY
       * ============================================ */

      async function copyText(text) {

        try {

          await navigator.clipboard.writeText(
            text
          );

          return true;

        } catch {

          const textarea =
            document.createElement(
              'textarea'
            );


          textarea.value =
            text;

          textarea.style.position =
            'fixed';

          textarea.style.opacity =
            '0';

          document.body.appendChild(
            textarea
          );

          textarea.select();


          let success = false;

          try {

            success =
              document.execCommand(
                'copy'
              );

          } catch {

            success = false;

          }


          textarea.remove();

          return success;

        }

      }


      copyCommandBtn.addEventListener(
        'click',
        async () => {

          const text =
            commandOutput.textContent.trim();


          const success =
            await copyText(text);


          if (success) {

            showToast(
              'تم نسخ أمر chmod'
            );

          }

        }
      );


      copyAllBtn.addEventListener(
        'click',
        async () => {

          const numeric =
            numericResult.textContent.trim();

          const symbolic =
            symbolicResult.textContent.trim();

          const total =
            totalValue.textContent.trim();

          const command =
            commandOutput.textContent.trim();


          const text =
`Unix Permissions
Numeric: ${numeric}
Symbolic: ${symbolic}
Value: ${total}
Command: ${command}`;


          const success =
            await copyText(text);


          if (success) {

            showToast(
              'تم نسخ جميع النتائج'
            );

          }

        }
      );


      /* ============================================
       * RESET
       * ============================================ */

      resetBtn.addEventListener(
        'click',
        () => {

          setFromNumeric('755');

          filenameInput.value =
            'filename';

          updateCalculator();

          showToast(
            'تمت إعادة ضبط الأداة'
          );

        }
      );


      /* ============================================
       * TOAST
       * ============================================ */

      let toastTimer;


      function showToast(message) {

        toastMessage.textContent =
          message;


        toast.classList.add(
          'show'
        );


        clearTimeout(
          toastTimer
        );


        toastTimer =
          setTimeout(() => {

            toast.classList.remove(
              'show'
            );

          }, 2200);

      }


      /* ============================================
       * INITIALIZE
       * ============================================ */

      updateCalculator();

    });
  </script>


