    .actions {

      display: flex;

      justify-content: center;

      gap: 12px;

      margin-bottom: 45px;
    }


    .main-action,
    .reset-action {

      min-width: 170px;

      padding: 13px 20px;

      border-radius: 12px;

      font-family:
        'Cairo',
        sans-serif;

      font-size: 13px;

      font-weight: 700;

      cursor: pointer;

      transition:
        transform 0.2s ease;
    }


    .main-action:hover,
    .reset-action:hover {

      transform:
        translateY(-2px);
    }


    .main-action {

      border: none;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          var(--up-primary),
          var(--up-primary-2)
        );
    }


    .reset-action {

      color:
        var(--up-text);

      background:
        var(--up-surface);

      border:
        1px solid var(--up-border);
    }


    /* ============================================
     * EXPLANATION
     * ============================================ */

    .explanation {

      display: grid;

      gap: 15px;

      margin-bottom: 42px;
    }


    .info-card,
    .warning-card {

      display: flex;

      gap: 15px;

      padding: 22px;

      border:
        1px solid var(--up-border);

      border-radius:
        var(--up-radius);

      background:
        var(--up-surface);
    }


    .info-icon,
    .warning-icon {

      width: 45px;
      height: 45px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 13px;

      font-size: 18px;
    }


    .info-icon {

      color:
        var(--up-primary);

      background:
        var(--up-primary-soft);
    }


    .warning-icon {

      color:
        var(--up-orange);

      background:
        var(--up-orange-soft);
    }


    .info-card h2,
    .warning-card h3 {

      margin:
        0 0 7px;

      font-size: 17px;
    }


    .info-card p,
    .warning-card p {

      margin:
        5px 0;

      color:
        var(--up-muted);

      font-size: 12px;

      line-height: 1.9;
    }


    .permission-examples {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 10px;

      margin-top: 15px;
    }


    .permission-examples div {

      display: flex;

      align-items: center;

      gap: 8px;

      padding: 9px;

      border:
        1px solid var(--up-border);

      border-radius: 10px;

      background:
        var(--up-surface-2);
    }


    .permission-examples strong {

      color:
        var(--up-primary);

      font-family:
        'JetBrains Mono',
        monospace;
    }


    .permission-examples span {

      flex: 1;

      color:
        var(--up-soft);

      font-size: 10px;
    }


    .permission-examples b {

      color:
        var(--up-muted);

      font-family:
        'JetBrains Mono',
        monospace;

      font-size: 10px;
    }


    .warning-card {

      border-color:
        rgba(245, 158, 11, 0.25);
    }


    /* ============================================
     * FAQ
     * ============================================ */

    .faq-section {

      margin-bottom: 25px;
    }


    .faq-list {

      display: grid;

      gap: 10px;
    }


    .faq-list details {

      border:
        1px solid var(--up-border);

      border-radius: 14px;

      background:
        var(--up-surface);

      overflow: hidden;
    }


    .faq-list details[open] {

      border-color:
        var(--up-border-strong);
    }


    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 17px 18px;

      cursor: pointer;

      list-style: none;

      color:
        var(--up-text);

      font-size: 13px;

      font-weight: 700;
    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color:
        var(--up-primary);

      transition:
        transform 0.2s ease;
    }


    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);
    }


    .faq-list details p {

      margin: 0;

      padding:
        0 18px 18px;

      color:
        var(--up-muted);

      font-size: 12px;

      line-height: 1.9;
    }


    /* ============================================
     * TOAST
     * ============================================ */

    .toast {

      position: fixed;

      z-index: 9999;

      left: 50%;

      bottom: 25px;

      display: flex;

      align-items: center;

      gap: 8px;

      padding: 12px 18px;

      border:
        1px solid var(--up-border-strong);

      border-radius: 12px;

      background:
        var(--up-surface);

      color:
        var(--up-text);

      box-shadow:
        var(--up-shadow);

      font-size: 12px;

      opacity: 0;

      pointer-events: none;

      transform:
        translate(-50%, 30px);

      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }


    .toast i {

      color:
        var(--up-green);
    }


    .toast.show {

      opacity: 1;

      transform:
        translate(-50%, 0);
    }


    /* ============================================
     * RESPONSIVE
     * ============================================ */

    @media (max-width: 950px) {

      .permission-grid {

        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }


      .preset-grid {

        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

    }


    @media (max-width: 700px) {

      .permission-page {

        width:
          min(
            calc(100% - 20px),
            620px
          );

        padding:
          30px 0 60px;
      }


      .hero {

        align-items: flex-start;

        padding: 21px;
      }


      .hero-icon {

        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 23px;
      }


      .hero h1 {

        font-size: 28px;
      }


      .hero p {

        font-size: 12px;
      }


      .result-panel {

        grid-template-columns:
          1fr;

        gap: 16px;
      }


      .result-divider {

        width: 70%;

        height: 1px;

        margin: 0 auto;
      }


      .permission-grid {

        grid-template-columns: 1fr;
      }


      .filename-card {

        grid-template-columns: 1fr;
      }


      .permission-examples {

        grid-template-columns: 1fr;
      }


      .actions {

        flex-direction: column;
      }


      .main-action,
      .reset-action {

        width: 100%;
      }

    }


    @media (max-width: 460px) {

      .hero {

        gap: 13px;
      }


      .hero-icon {

        width: 48px;
        height: 48px;

        font-size: 19px;
      }


      .hero h1 {

        font-size: 24px;
      }


      .preset-grid {

        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }


      .command-card {

        align-items: stretch;

        flex-direction: column;
      }


      .copy-button {

        width: 100%;
      }


      .result-item strong {

        font-size: 27px;
      }


      .symbolic-result strong {

        font-size: 21px;
      }

    }

  </style>

</body>
</html>
