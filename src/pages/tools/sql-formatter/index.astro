        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        0 14px;

      background:
        var(--code-bg-2);

      border-bottom:
        1px solid
        rgba(255,255,255,.06);

    }


    .editor-label {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

    }


    .file-icon {

      width:
        31px;

      height:
        31px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        8px;

    }


    .input-icon {

      background:
        rgba(124,58,237,.14);

      color:
        #a78bfa;

    }


    .output-icon {

      background:
        rgba(139,92,246,.14);

      color:
        #c4b5fd;

    }


    .editor-label strong,
    .editor-label small {

      display:
        block;

    }


    .editor-label strong {
      font-size: 11px;
    }


    .editor-label small {

      color:
        #64748b;

      font-size:
        9px;

    }


    .editor-stats {

      color:
        #64748b;

      font:
        9px
        "JetBrains Mono",
        monospace;

    }


    .code-area {

      display:
        flex;

      height:
        430px;

      direction:
        ltr;

      overflow:
        hidden;

    }


    .line-numbers {

      width:
        45px;

      flex:
        0 0 45px;

      padding:
        15px 8px;

      background:
        rgba(0,0,0,.14);

      border-right:
        1px solid
        rgba(255,255,255,.05);

      color:
        #475569;

      text-align:
        right;

      white-space:
        pre;

      overflow:
        hidden;

      user-select:
        none;

      font:
        12px/1.8
        "JetBrains Mono",
        monospace;

    }


    textarea {

      width:
        100%;

      height:
        100%;

      resize:
        none;

      outline:
        none;

      border:
        0;

      padding:
        15px;

      background:
        var(--code-bg);

      color:
        var(--code-text);

      font:
        12px/1.8
        "JetBrains Mono",
        monospace;

      direction:
        ltr;

      text-align:
        left;

      tab-size:
        2;

    }


    textarea::placeholder {
      color: #475569;
    }


    .editor-foot {

      min-height:
        38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        0 13px;

      border-top:
        1px solid
        rgba(255,255,255,.06);

      color:
        #64748b;

      font-size:
        9px;

    }


    .editor-foot span {

      display:
        flex;

      align-items:
        center;

      gap:
        5px;

    }


    .status {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

    }


    .status-dot {

      width:
        6px;

      height:
        6px;

      border-radius:
        50%;

      background:
        #64748b;

    }


    .status.success {
      color: #4ade80;
    }


    .status.success .status-dot {
      background: #22c55e;
    }


    .status.warning {
      color: #fbbf24;
    }


    .status.warning .status-dot {
      background: #f59e0b;
    }


    .status.error {
      color: #f87171;
    }


    .status.error .status-dot {
      background: #ef4444;
    }


    /* RESULT */

    .result-section {

      margin:
        0 16px 14px;

      overflow:
        hidden;

      border:
        1px solid
        rgba(124,58,237,.14);

      border-radius:
        15px;

      background:
        var(--surface-2);

    }


    .result-head {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        12px 14px;

      border-bottom:
        1px solid
        var(--border);

    }


    .result-title {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

    }


    .result-icon,
    .message-icon {

      display:
        grid;

      place-items:
        center;

      border-radius:
        9px;

      background:
        rgba(124,58,237,.1);

      color:
        var(--primary);

    }


    .result-icon {

      width:
        32px;

      height:
        32px;

    }


    .result-title strong,
    .result-title span {

      display:
        block;

    }


    .result-title strong {
      font-size: 11px;
    }


    .result-title span {

      color:
        var(--muted);

      font-size:
        9px;

    }


    .result-badge {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      padding:
        5px 8px;

      border:
        1px solid
        rgba(124,58,237,.16);

      border-radius:
        999px;

      color:
        var(--primary);

      font:
        600 9px
        "JetBrains Mono",
        monospace;

    }


    .result-dot {

      width:
        5px;

      height:
        5px;

      border-radius:
        50%;

      background:
        var(--primary);

    }


    .result-content {
      padding: 14px;
    }


    .result-message {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        10px;

      padding:
        12px;

      border:
        1px solid
        var(--border);

      border-radius:
        12px;

      background:
        var(--surface);

    }


    .message-icon {

      width:
        35px;

      height:
        35px;

      flex:
        0 0 35px;

    }


    .result-message strong {
      font-size: 11px;
    }


    .result-message p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        1.8;

    }


    .result-metrics,
    .tool-stats {

      display:
        grid;

      grid-template-columns:
        repeat(4,1fr);

      gap:
        9px;

    }


    .result-metrics {
      margin-top: 10px;
    }


    .metric {

      padding:
        11px;

      border:
        1px solid
        var(--border);

      border-radius:
        11px;

      background:
        var(--surface);

      text-align:
        center;

    }


    .metric span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        8px;

    }


    .metric strong {

      display:
        block;

      margin-top:
        3px;

      font:
        700 13px
        "JetBrains Mono",
        monospace;

    }


    .tool-stats {

      padding:
        0 16px 16px;

      gap:
        10px;

    }


    .tool-stat {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

      padding:
        12px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface-2);

    }


    .tool-stat-icon {

      width:
        34px;

      height:
        34px;

      flex:
        0 0 34px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        9px;

      background:
        rgba(124,58,237,.09);

      color:
        var(--primary);

    }


    .tool-stat strong,
    .tool-stat span {

      display:
        block;

    }


    .tool-stat strong {

      font:
        700 11px
        "JetBrains Mono",
        monospace;

    }


    .tool-stat span {

      margin-top:
        2px;

      color:
        var(--muted);

      font-size:
        8px;

    }


    /* CONTENT */

    .information,
    .how-section {
      margin-top: 55px;
    }


    .section-title {

      max-width:
        700px;

      margin:
        0 auto 25px;

      text-align:
        center;

    }


    .section-title > span {

      color:
        var(--primary);

      font-size:
        11px;

      font-weight:
        800;

    }


    .section-title h2 {

      margin:
        5px 0 7px;

      font-size:
        clamp(21px,4vw,28px);

    }


    .section-title p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;

    }


    .info-grid,
    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        14px;

    }


    .info-card,
    .step {

      border:
        1px solid
        var(--border);

      border-radius:
        18px;

      background:
        var(--surface);

    }


    .info-card {

      position:
        relative;

      overflow:
        hidden;

      padding:
        24px;

    }


    .info-number {

      position:
        absolute;

      top:
        15px;

      left:
        18px;

      color:
        var(--muted);

      opacity:
        .25;

      font:
        700 28px
        "JetBrains Mono",
        monospace;

    }


    .info-card-icon {

      width:
        42px;

      height:
        42px;

      display:
        grid;

      place-items:
        center;

      margin-bottom:
        13px;

      border-radius:
        11px;

      background:
        rgba(124,58,237,.1);

      color:
        var(--primary);

    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size:
        14px;

    }


    .info-card p,
    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.9;

    }


    .step {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        12px;

      padding:
        20px;

    }


    .step-icon {

      width:
        43px;

      height:
        43px;

      flex:
        0 0 43px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        12px;

      background:
        rgba(124,58,237,.1);

      color:
        var(--primary);

      font:
        700 10px
        "JetBrains Mono",
        monospace;

    }


    .step h3 {

      margin:
        0 0 5px;

      font-size:
        13px;

    }


    .faq-section {

      max-width:
        850px;

      margin:
        55px auto 40px;

    }


    .faq-list details {

      margin-bottom:
        9px;

      overflow:
        hidden;

      border:
        1px solid
        var(--border);

      border-radius:
        14px;

      background:
        var(--surface);

    }


    .faq-list summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding:
        16px 18px;

      cursor:
        pointer;

      list-style:
        none;

      font-size:
        12px;

      font-weight:
        700;

    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color:
        var(--muted);

      font-size:
        10px;

      transition:
        transform .2s ease;

    }


    .faq-list details[open] summary i {
      transform: rotate(180deg);
    }


    .faq-answer {

      padding:
        0 18px 17px;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.9;

    }


    /* RELATED */

    .related-tools {

      width:
        min(1000px,100%);

      margin:
        40px auto 25px;

      padding:
        22px;

      border-radius:
        18px;

      background:
        var(--surface);

      color:
        var(--text);

      border:
        1px solid
        var(--border);

      box-shadow:
        0 8px 24px
        rgba(15,23,42,.06);

    }


    .related-tools-header {
      margin-bottom: 17px;
    }


    .related-tools-label {

      display:
        inline-block;

      margin-bottom:
        5px;

      color:
        #0284c7;

      font-size:
        .78rem;

      font-weight:
        800;

    }


    .related-tools h2 {

      margin:
        0 0 5px;

      font-size:
        1.3rem;

      font-weight:
        800;

    }


    .related-tools-header p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        .85rem;

    }


    .related-tools-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,minmax(0,1fr));

      gap:
        10px;

    }


    .related-tool-card {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

      min-height:
        58px;

      padding:
        9px 10px;

      border-radius:
        12px;

      text-decoration:
        none;

      color:
        var(--text);

      background:
        var(--surface-2);

      border:
        1px solid
        var(--border);

      transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease;

    }


    .related-tool-card:hover {

      transform:
        translateY(-2px);

      border-color:
        #38bdf8;

      background:
        rgba(56,189,248,.08);

    }


    .related-tool-icon {

      display:
        grid;

      place-items:
        center;

      width:
        34px;

      height:
        34px;

      flex:
        0 0 34px;

      border-radius:
        9px;

      color:
        #0284c7;

      background:
        rgba(14,165,233,.10);

    }


    .related-tool-content {

      display:
        flex;

      flex-direction:
        column;

      gap:
        2px;

      min-width:
        0;

      flex:
        1;

    }


    .related-tool-content strong {

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font-size:
        .84rem;

    }


    .related-tool-content small {

      color:
        var(--muted);

      font-size:
        .68rem;

    }


    .related-tool-arrow {

      color:
        #94a3b8;

    }


    /* RESPONSIVE */

    @media (max-width: 900px) {

      .workspace {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 800px) {

      .info-grid,
      .steps {

        grid-template-columns:
          repeat(2,1fr);

      }

      .tool-stats {

        grid-template-columns:
          repeat(2,1fr);

      }

      .related-tools-grid {

        grid-template-columns:
          repeat(2,1fr);

      }

    }


    @media (max-width: 700px) {

      .actionbar {

        flex-direction:
          column;

        align-items:
          stretch;

      }

      .action-group {
        width: 100%;
      }

      .action {
        flex: 1;
      }

      .result-metrics {
        grid-template-columns:
          repeat(2,1fr);
      }

    }


    @media (max-width: 600px) {

      .container {
        width:
          calc(100% - 20px);
      }

      .hero {
        padding:
          25px 0 32px;
      }

      .hero-icon {
        width: 60px;
        height: 60px;
        font-size: 20px;
      }

      .hero p {
        font-size: 12px;
      }

      .topbar {
        padding: 14px;
      }

      .topbar-status {
        display: none;
      }

      .actionbar {
        padding: 10px;
      }

      .action {
        padding:
          9px 7px;
        font-size: 10px;
      }

      .workspace {
        padding: 10px;
      }

      .code-area {
        height: 330px;
      }

      .result-section {
        margin:
          0 10px 10px;
      }

      .result-content {
        padding: 10px;
      }

      .tool-stats {
        padding:
          0 10px 10px;
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .related-tools {
        padding: 16px;
      }

      .related-tools-grid {
        grid-template-columns: 1fr;
      }

      .tool-breadcrumbs {
        width:
          calc(100% - 20px);

        padding:
          8px 10px;

        font-size:
          12px;

      }

    }

  </style>

</body>
</html>
