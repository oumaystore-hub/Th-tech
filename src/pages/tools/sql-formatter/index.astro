  <!-- JAVASCRIPT -->

  <script is:inline>
    (() => {

      const sqlInput =
        document.getElementById("sqlInput");

      const sqlOutput =
        document.getElementById("sqlOutput");

      const inputLines =
        document.getElementById("inputLines");

      const outputLines =
        document.getElementById("outputLines");

      const inputStats =
        document.getElementById("inputStats");

      const outputStats =
        document.getElementById("outputStats");

      const inputSize =
        document.getElementById("inputSize");

      const outputSize =
        document.getElementById("outputSize");

      const inputStatus =
        document.getElementById("inputStatus");

      const outputStatus =
        document.getElementById("outputStatus");

      const formatBtn =
        document.getElementById("formatBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const resultBadge =
        document.getElementById("resultBadge");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultText =
        document.getElementById("resultText");

      const originalLines =
        document.getElementById("originalLines");

      const formattedLines =
        document.getElementById("formattedLines");

      const formattedChars =
        document.getElementById("formattedChars");

      const executionTime =
        document.getElementById("executionTime");


      const exampleSQL =
`SELECT u.id,u.name,u.email,COUNT(o.id) AS order_count,SUM(o.total) AS total_spent
FROM users u
LEFT JOIN orders o ON o.user_id=u.id
WHERE u.active=1 AND u.created_at>='2025-01-01'
GROUP BY u.id,u.name,u.email
HAVING COUNT(o.id)>0
ORDER BY total_spent DESC
LIMIT 20;`;


      function formatBytes(bytes) {

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {
          return `${(bytes / 1024).toFixed(2)} KB`;
        }

        return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;

      }


      function updateLineNumbers(textarea, numbers) {

        const value = textarea.value;

        const count =
          value
            ? value.replace(/\r\n/g, "\n").split("\n").length
            : 0;

        numbers.textContent =
          count > 0
            ? Array.from(
                { length: count },
                (_, i) => i + 1
              ).join("\n")
            : "1";

      }


      function updateInputStats() {

        const value = sqlInput.value;

        inputStats.textContent =
          `${value.length.toLocaleString()} chars`;

        inputSize.textContent =
          formatBytes(new Blob([value]).size);

        updateLineNumbers(
          sqlInput,
          inputLines
        );

      }


      function updateOutputStats() {

        const value = sqlOutput.value;

        outputStats.textContent =
          `${value.length.toLocaleString()} chars`;

        outputSize.textContent =
          formatBytes(new Blob([value]).size);

        updateLineNumbers(
          sqlOutput,
          outputLines
        );

      }


      function setStatus(element, type, text) {

        element.className =
          `status ${type}`;

        element.innerHTML = `
          <span class="status-dot"></span>
          ${text}
        `;

      }


      const keywords = [
        "SELECT",
        "FROM",
        "WHERE",
        "AND",
        "OR",
        "NOT",
        "NULL",
        "IS",
        "IN",
        "LIKE",
        "BETWEEN",
        "JOIN",
        "INNER",
        "LEFT",
        "RIGHT",
        "FULL",
        "OUTER",
        "CROSS",
        "ON",
        "AS",
        "GROUP",
        "BY",
        "ORDER",
        "ASC",
        "DESC",
        "HAVING",
        "LIMIT",
        "OFFSET",
        "UNION",
        "ALL",
        "DISTINCT",
        "INSERT",
        "INTO",
        "VALUES",
        "UPDATE",
        "SET",
        "DELETE",
        "CREATE",
        "ALTER",
        "DROP",
        "TABLE",
        "VIEW",
        "INDEX",
        "DATABASE",
        "PRIMARY",
        "KEY",
        "FOREIGN",
        "REFERENCES",
        "CASE",
        "WHEN",
        "THEN",
        "ELSE",
        "END",
        "EXISTS",
        "WITH",
        "RETURNING"
      ];


      const majorKeywords = new Set([
        "SELECT",
        "FROM",
        "WHERE",
        "GROUP",
        "ORDER",
        "HAVING",
        "LIMIT",
        "OFFSET",
        "UNION",
        "VALUES",
        "SET",
        "RETURNING"
      ]);


      const joinKeywords = new Set([
        "JOIN",
        "INNER",
        "LEFT",
        "RIGHT",
        "FULL",
        "CROSS"
      ]);


      function tokenizeSQL(sql) {

        const tokens = [];

        let current = "";
        let quote = null;
        let comment = null;


        for (let i = 0; i < sql.length; i++) {

          const char = sql[i];
          const next = sql[i + 1];


          if (comment === "line") {

            current += char;

            if (char === "\n") {

              tokens.push({
                type: "comment",
                value: current.trim()
              });

              current = "";
              comment = null;

            }

            continue;
          }


          if (comment === "block") {

            current += char;

            if (char === "*" && next === "/") {

              current += next;
              i++;

              tokens.push({
                type: "comment",
                value: current.trim()
              });

              current = "";
              comment = null;

            }

            continue;
          }


          if (!quote && char === "-" && next === "-") {

            if (current.trim()) {

              tokens.push({
                type: "text",
                value: current.trim()
              });

              current = "";

            }

            current = "--";
            comment = "line";
            i++;

            continue;
          }


          if (!quote && char === "/" && next === "*") {

            if (current.trim()) {

              tokens.push({
                type: "text",
                value: current.trim()
              });

              current = "";

            }

            current = "/*";
            comment = "block";
            i++;

            continue;
          }


          if (quote && char === quote) {

            current += char;

            if (next === quote) {

              current += next;
              i++;

              continue;

            }

            quote = null;

            continue;
          }


          if (
            !quote &&
            (
              char === "'" ||
              char === '"' ||
              char === "`"
            )
          ) {

            quote = char;
            current += char;

            continue;
          }


          if (!quote && /\s/.test(char)) {

            if (current.trim()) {

              tokens.push({
                type: "text",
                value: current.trim()
              });

              current = "";

            }

            continue;
          }


          if (
            !quote &&
            (
              char === "(" ||
              char === ")" ||
              char === "," ||
              char === ";"
            )
          ) {

            if (current.trim()) {

              tokens.push({
                type: "text",
                value: current.trim()
              });

              current = "";

            }

            tokens.push({
              type: "symbol",
              value: char
            });

            continue;
          }


          current += char;

        }


        if (current.trim()) {

          tokens.push({
            type: comment ? "comment" : "text",
            value: current.trim()
          });

        }


        return tokens;

      }


      function upperKeyword(value) {

        const upper = value.toUpperCase();

        if (keywords.includes(upper)) {
          return upper;
        }

        return value;

      }


      function formatSQL(sql) {

        const tokens =
          tokenizeSQL(sql);

        if (!tokens.length) {
          return "";
        }


        const lines = [];

        let current = "";
        let indent = 0;
        let parenDepth = 0;


        function indentString() {

          return "  ".repeat(
            Math.max(0, indent)
          );

        }


        function flush() {

          const clean =
            current.trim();

          if (clean) {

            lines.push(
              indentString() + clean
            );

          }

          current = "";

        }


        function add(value) {

          if (!current) {
            current = value;
          } else {
            current += " " + value;
          }

        }


        function addInline(value) {

          current += value;

        }


        /*
         * مهم:
         * استخدمنا for...of بدلاً من forEach
         * حتى تعمل continue بشكل صحيح.
         */

        for (const token of tokens) {

          const raw =
            token.value;

          const upper =
            raw.toUpperCase();


          if (token.type === "comment") {

            flush();

            lines.push(
              indentString() + raw
            );

            continue;

          }


          if (token.type === "symbol") {

            if (raw === "(") {

              if (current.endsWith(" ")) {
                current = current.slice(0, -1);
              }

              addInline("(");

              parenDepth++;

              continue;

            }


            if (raw === ")") {

              if (current.endsWith(" ")) {
                current = current.slice(0, -1);
              }

              addInline(")");

              parenDepth =
                Math.max(
                  0,
                  parenDepth - 1
                );

              continue;

            }


            if (raw === ",") {

              if (current.endsWith(" ")) {
                current = current.slice(0, -1);
              }

              addInline(",");

              if (parenDepth === 0) {
                flush();
              } else {
                current += " ";
              }

              continue;

            }


            if (raw === ";") {

              if (current.endsWith(" ")) {
                current = current.slice(0, -1);
              }

              addInline(";");

              flush();

              continue;

            }

          }


          if (majorKeywords.has(upper)) {

            if (current) {
              flush();
            }


            if (upper === "SELECT") {

              current = "SELECT";

              continue;

            }


            if (upper === "FROM") {

              current = "FROM";

              continue;

            }


            if (upper === "WHERE") {

              current = "WHERE";

              continue;

            }


            if (upper === "GROUP") {

              current = "GROUP BY";

              continue;

            }


            if (upper === "ORDER") {

              current = "ORDER BY";

              continue;

            }


            if (upper === "HAVING") {

              current = "HAVING";

              continue;

            }


            if (upper === "LIMIT") {

              current = "LIMIT";

              continue;

            }


            if (upper === "OFFSET") {

              current = "OFFSET";

              continue;

            }


            if (upper === "UNION") {

              current = "UNION";

              continue;

            }


            if (upper === "VALUES") {

              current = "VALUES";

              continue;

            }


            if (upper === "SET") {

              current = "SET";

              continue;

            }


            if (upper === "RETURNING") {

              current = "RETURNING";

              continue;

            }

          }


          if (joinKeywords.has(upper)) {

            if (
              upper === "INNER" ||
              upper === "LEFT" ||
              upper === "RIGHT" ||
              upper === "FULL" ||
              upper === "CROSS"
            ) {

              if (current) {
                flush();
              }

              current = upper;

              continue;

            }


            if (upper === "JOIN") {

              if (
                current === "INNER" ||
                current === "LEFT" ||
                current === "RIGHT" ||
                current === "FULL" ||
                current === "CROSS"
              ) {

                current += " JOIN";

              } else {

                if (current) {
                  flush();
                }

                current = "JOIN";

              }

              continue;

            }

          }


          if (upper === "ON") {

            if (current) {
              flush();
            }

            current = "ON";

            continue;

          }


          if (
            upper === "AND" ||
            upper === "OR"
          ) {

            if (current) {
              flush();
            }

            current = upper;

            continue;

          }


          add(
            upperKeyword(raw)
          );

        }


        flush();


        let result =
          lines.join("\n");


        result =
          result
            .replace(/\s*=\s*/g, " = ")
            .replace(/\s*<>\s*/g, " <> ")
            .replace(/\s*<=\s*/g, " <= ")
            .replace(/\s*>=\s*/g, " >= ")
            .replace(/\s+AND\s+/g, " AND ")
            .replace(/\s+OR\s+/g, " OR ");


        const resultLines =
          result.split("\n");

        let insideJoin = false;


        const finalLines =
          resultLines.map((line) => {

            const trimmed =
              line.trim();

            const upper =
              trimmed.toUpperCase();


            if (
              /^(INNER|LEFT|RIGHT|FULL|CROSS)?\s*JOIN\b/
                .test(upper)
            ) {

              insideJoin = true;

              return line;

            }


            if (
              insideJoin &&
              upper.startsWith("ON ")
            ) {

              return "  " + trimmed;

            }


            if (
              insideJoin &&
              (
                upper.startsWith("WHERE") ||
                upper.startsWith("GROUP BY") ||
                upper.startsWith("ORDER BY") ||
                upper.startsWith("HAVING") ||
                upper.startsWith("LIMIT") ||
                upper.startsWith("UNION")
              )
            ) {

              insideJoin = false;

            }


            return line;

          });


        return finalLines
          .join("\n")
          .trim();

      }


      function format() {

        const input =
          sqlInput.value.trim();


        if (!input) {

          sqlOutput.value = "";

          updateOutputStats();

          setStatus(
            inputStatus,
            "warning",
            "أدخل استعلام SQL أولاً"
          );

          setStatus(
            outputStatus,
            "idle",
            "في انتظار التنسيق"
          );

          resultBadge.innerHTML = `
            <span class="result-dot"></span>
            Waiting
          `;

          resultTitle.textContent =
            "أدخل استعلام SQL";

          resultText.textContent =
            "الصق استعلام SQL في المحرر ثم اضغط على زر التنسيق.";

          return;

        }


        const started =
          performance.now();


        try {

          const formatted =
            formatSQL(input);

          const elapsed =
            performance.now() - started;


          sqlOutput.value =
            formatted;

          updateOutputStats();


          const inputLineCount =
            input
              .replace(/\r\n/g, "\n")
              .split("\n")
              .length;


          const outputLineCount =
            formatted
              ? formatted
                  .replace(/\r\n/g, "\n")
                  .split("\n")
                  .length
              : 0;


          originalLines.textContent =
            inputLineCount.toLocaleString();

          formattedLines.textContent =
            outputLineCount.toLocaleString();

          formattedChars.textContent =
            formatted.length.toLocaleString();

          executionTime.textContent =
            `${elapsed.toFixed(1)} ms`;


          setStatus(
            inputStatus,
            "success",
            "تم التحليل"
          );

          setStatus(
            outputStatus,
            "success",
            "تم التنسيق"
          );


          resultBadge.innerHTML = `
            <span class="result-dot"></span>
            Formatted
          `;

          resultTitle.textContent =
            "تم تنسيق SQL بنجاح";

          resultText.textContent =
            `تم ترتيب الاستعلام وتحسين بنيته خلال ${elapsed.toFixed(1)} ms.`;

        } catch (error) {

          console.error(error);

          setStatus(
            outputStatus,
            "error",
            "حدث خطأ"
          );

          resultBadge.innerHTML = `
            <span class="result-dot"></span>
            Error
          `;

          resultTitle.textContent =
            "تعذر تنسيق الاستعلام";

          resultText.textContent =
            "حدث خطأ أثناء معالجة SQL. تحقق من النص وحاول مرة أخرى.";

        }

      }


      async function copyResult() {

        const value =
          sqlOutput.value;


        if (!value.trim()) {

          setStatus(
            outputStatus,
            "warning",
            "لا توجد نتيجة للنسخ"
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          setStatus(
            outputStatus,
            "success",
            "تم نسخ SQL"
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML = `
            <i class="fa-solid fa-check"></i>
            تم النسخ
          `;


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);


        } catch {

          sqlOutput.select();

          document.execCommand("copy");

          setStatus(
            outputStatus,
            "success",
            "تم نسخ SQL"
          );

        }

      }


      function clearAll() {

        sqlInput.value = "";
        sqlOutput.value = "";

        updateInputStats();
        updateOutputStats();


        originalLines.textContent = "0";
        formattedLines.textContent = "0";
        formattedChars.textContent = "0";
        executionTime.textContent = "0 ms";


        setStatus(
          inputStatus,
          "idle",
          "جاهز"
        );


        setStatus(
          outputStatus,
          "idle",
          "في انتظار التنسيق"
        );


        resultBadge.innerHTML = `
          <span class="result-dot"></span>
          Ready
        `;


        resultTitle.textContent =
          "SQL Formatter جاهز";


        resultText.textContent =
          'أدخل استعلام SQL ثم اضغط على "تنسيق SQL".';


        sqlInput.focus();

      }


      exampleBtn.addEventListener(
        "click",
        () => {

          sqlInput.value =
            exampleSQL;

          updateInputStats();

          format();

        }
      );


      sqlInput.addEventListener(
        "input",
        () => {

          updateInputStats();

          setStatus(
            inputStatus,
            "idle",
            "جاهز"
          );

        }
      );


      sqlOutput.addEventListener(
        "scroll",
        () => {

          outputLines.scrollTop =
            sqlOutput.scrollTop;

        }
      );


      sqlInput.addEventListener(
        "scroll",
        () => {

          inputLines.scrollTop =
            sqlInput.scrollTop;

        }
      );


      sqlInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Tab") {

            event.preventDefault();

            const start =
              sqlInput.selectionStart;

            const end =
              sqlInput.selectionEnd;


            sqlInput.value =
              sqlInput.value.substring(
                0,
                start
              ) +
              "  " +
              sqlInput.value.substring(
                end
              );


            sqlInput.selectionStart =
              sqlInput.selectionEnd =
                start + 2;


            updateInputStats();

          }


          if (
            event.key === "Enter" &&
            (event.ctrlKey || event.metaKey)
          ) {

            event.preventDefault();

            format();

          }

        }
      );


      formatBtn.addEventListener(
        "click",
        format
      );

      copyBtn.addEventListener(
        "click",
        copyResult
      );

      clearBtn.addEventListener(
        "click",
        clearAll
      );


      updateInputStats();
      updateOutputStats();

    })();
  </script>


