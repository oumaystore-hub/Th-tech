---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SQL Formatter - تنسيق SQL أونلاين مجانًا | Th.Tech";

const description =
  "أداة SQL Formatter مجانية لتنسيق وترتيب استعلامات SQL وجعلها أكثر وضوحًا وسهولة في القراءة.";

const canonical =
  `https://oumaystore-hub.github.io${base}/tools/sql-formatter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <link rel="canonical" href={canonical} />

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      font-family: Arial, "Segoe UI", sans-serif;
      background: #f5f9ff;
      color: #172033;
      transition:
        background 0.25s ease,
        color 0.25s ease;
    }

    :global(html.dark-mode body) {
      background: #07111f;
      color: #e7eef8;
    }

    .page {
      min-height: 100vh;
      padding: 40px 16px 70px;
    }

    .container {
      width: min(1100px, 100%);
      margin: 0 auto;
    }

    .hero {
      text-align: center;
      margin-bottom: 30px;
    }

    .icon {
      width: 76px;
      height: 76px;
      margin: 0 auto 18px;
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      box-shadow: 0 15px 35px rgba(37, 99, 235, 0.22);
    }

    .icon svg {
      width: 40px;
      height: 40px;
      fill: none;
      stroke: #fff;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    h1 {
      margin: 0 0 12px;
      font-size: clamp(28px, 5vw, 44px);
      line-height: 1.2;
    }

    .hero p {
      max-width: 760px;
      margin: 0 auto;
      color: #64748b;
      line-height: 1.9;
      font-size: 16px;
    }

    :global(html.dark-mode) .hero p {
      color: #9fb0c7;
    }

    .tool-card {
      background: #fff;
      border: 1px solid #dce8f5;
      border-radius: 24px;
      padding: 22px;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    :global(html.dark-mode) .tool-card {
      background: #0d1a2b;
      border-color: #1d3047;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
    }

    button {
      border: 0;
      cursor: pointer;
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      border-radius: 12px;
      padding: 11px 17px;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease,
        box-shadow 0.2s ease;
    }

    button:hover {
      transform: translateY(-2px);
    }

    button:active {
      transform: translateY(0);
    }

    .primary {
      background: linear-gradient(135deg, #2563eb, #0ea5e9);
      color: #fff;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }

    .secondary {
      background: #eaf2fb;
      color: #1e40af;
    }

    :global(html.dark-mode) .secondary {
      background: #17283d;
      color: #93c5fd;
    }

    .danger {
      background: #fee2e2;
      color: #b91c1c;
    }

    :global(html.dark-mode) .danger {
      background: #3a1c24;
      color: #fca5a5;
    }

    .editor-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .editor-box {
      min-width: 0;
    }

    .editor-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 9px;
      font-size: 15px;
      font-weight: 800;
    }

    .editor-title span:last-child {
      font-size: 12px;
      font-weight: 500;
      color: #64748b;
    }

    :global(html.dark-mode) .editor-title span:last-child {
      color: #8da2ba;
    }

    textarea {
      width: 100%;
      min-height: 430px;
      resize: vertical;
      border: 1px solid #d7e3f0;
      border-radius: 16px;
      padding: 18px;
      outline: none;
      font-family:
        "JetBrains Mono",
        "Fira Code",
        Consolas,
        monospace;
      font-size: 14px;
      line-height: 1.8;
      direction: ltr;
      text-align: left;
      background: #f8fbff;
      color: #172033;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    textarea:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    }

    :global(html.dark-mode) textarea {
      background: #081522;
      color: #e7eef8;
      border-color: #263d56;
    }

    .status {
      min-height: 24px;
      margin-top: 14px;
      font-size: 14px;
      font-weight: 700;
    }

    .status.success {
      color: #15803d;
    }

    .status.error {
      color: #dc2626;
    }

    :global(html.dark-mode) .status.success {
      color: #4ade80;
    }

    :global(html.dark-mode) .status.error {
      color: #f87171;
    }

    .info-section {
      margin-top: 24px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .info-card {
      padding: 20px;
      border-radius: 18px;
      background: #fff;
      border: 1px solid #dce8f5;
    }

    :global(html.dark-mode) .info-card {
      background: #0d1a2b;
      border-color: #1d3047;
    }

    .info-card h2 {
      margin: 0 0 8px;
      font-size: 17px;
    }

    .info-card p {
      margin: 0;
      color: #64748b;
      line-height: 1.8;
      font-size: 14px;
    }

    :global(html.dark-mode) .info-card p {
      color: #9fb0c7;
    }

    .related {
      margin-top: 24px;
      padding: 22px;
      border-radius: 20px;
      background: linear-gradient(
        135deg,
        rgba(37, 99, 235, 0.08),
        rgba(14, 165, 233, 0.08)
      );
      border: 1px solid #cfe0f5;
    }

    :global(html.dark-mode) .related {
      border-color: #23405e;
      background: rgba(37, 99, 235, 0.08);
    }

    .related h2 {
      margin: 0 0 14px;
      font-size: 19px;
    }

    .related-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .related-links a {
      text-decoration: none;
      color: #1d4ed8;
      background: #fff;
      border: 1px solid #d5e3f2;
      padding: 9px 14px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease;
    }

    .related-links a:hover {
      transform: translateY(-2px);
      border-color: #60a5fa;
    }

    :global(html.dark-mode) .related-links a {
      background: #102136;
      color: #93c5fd;
      border-color: #29415d;
    }

    @media (max-width: 800px) {
      .editor-grid {
        grid-template-columns: 1fr;
      }

      .info-section {
        grid-template-columns: 1fr;
      }

      textarea {
        min-height: 320px;
      }
    }

    @media (max-width: 520px) {
      .page {
        padding: 25px 10px 50px;
      }

      .tool-card {
        padding: 14px;
        border-radius: 18px;
      }

      .toolbar {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      button {
        width: 100%;
      }

      .icon {
        width: 64px;
        height: 64px;
      }

      textarea {
        min-height: 280px;
        padding: 14px;
        font-size: 13px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :global(html) {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition: none !important;
        animation: none !important;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="page">
    <div class="container">

      <section class="hero">
        <div class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 6h16"></path>
            <path d="M4 10h10"></path>
            <path d="M4 14h16"></path>
            <path d="M4 18h8"></path>
          </svg>
        </div>

        <h1>SQL Formatter</h1>

        <p>
          نسّق استعلامات SQL بطريقة واضحة ومنظمة، مع الحفاظ على محتوى
          الاستعلام دون الحاجة إلى تثبيت أي برنامج أو مكتبة.
        </p>
      </section>

      <section class="tool-card">

        <div class="toolbar">
          <button id="formatBtn" class="primary" type="button">
            تنسيق SQL
          </button>

          <button id="minifyBtn" class="secondary" type="button">
            ضغط SQL
          </button>

          <button id="copyBtn" class="secondary" type="button">
            نسخ النتيجة
          </button>

          <button id="clearBtn" class="danger" type="button">
            مسح
          </button>
        </div>

        <div class="editor-grid">

          <div class="editor-box">
            <div class="editor-title">
              <span>SQL Input</span>
              <span>أدخل الاستعلام</span>
            </div>

            <textarea
              id="sqlInput"
              spellcheck="false"
              placeholder="SELECT id, name FROM users WHERE active = 1 ORDER BY name;"
            ></textarea>
          </div>

          <div class="editor-box">
            <div class="editor-title">
              <span>Formatted SQL</span>
              <span>النتيجة</span>
            </div>

            <textarea
              id="sqlOutput"
              spellcheck="false"
              readonly
              placeholder="ستظهر النتيجة هنا..."
            ></textarea>
          </div>

        </div>

        <div id="status" class="status" aria-live="polite"></div>

      </section>

      <section class="info-section">

        <article class="info-card">
          <h2>تنسيق تلقائي</h2>
          <p>
            يحول الاستعلامات الطويلة إلى صيغة منظمة تسهّل القراءة والمراجعة.
          </p>
        </article>

        <article class="info-card">
          <h2>ضغط SQL</h2>
          <p>
            يزيل المسافات والأسطر الزائدة للحصول على نسخة مختصرة من الاستعلام.
          </p>
        </article>

        <article class="info-card">
          <h2>خصوصيتك</h2>
          <p>
            تتم معالجة SQL داخل المتصفح ولا يتم إرسال الاستعلام إلى خادم خارجي.
          </p>
        </article>

      </section>

      <section class="related">
        <h2>أدوات SQL ذات صلة</h2>

        <div class="related-links">
          <a href={`${base}/tools/sql-minifier/`}>
            SQL Minifier
          </a>

          <a href={`${base}/tools/sql-validator/`}>
            SQL Validator
          </a>

          <a href={`${base}/tools/sql-query-builder/`}>
            SQL Query Builder
          </a>

          <a href={`${base}/tools/json-formatter/`}>
            JSON Formatter
          </a>

          <a href={`${base}/tools/code-beautifier/`}>
            Code Beautifier
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    const input = document.getElementById("sqlInput");
    const output = document.getElementById("sqlOutput");
    const formatBtn = document.getElementById("formatBtn");
    const minifyBtn = document.getElementById("minifyBtn");
    const copyBtn = document.getElementById("copyBtn");
    const clearBtn = document.getElementById("clearBtn");
    const status = document.getElementById("status");

    const keywords = [
      "SELECT",
      "FROM",
      "WHERE",
      "GROUP BY",
      "ORDER BY",
      "HAVING",
      "LIMIT",
      "OFFSET",
      "JOIN",
      "LEFT JOIN",
      "RIGHT JOIN",
      "INNER JOIN",
      "FULL JOIN",
      "CROSS JOIN",
      "LEFT OUTER JOIN",
      "RIGHT OUTER JOIN",
      "FULL OUTER JOIN",
      "ON",
      "AND",
      "OR",
      "NOT",
      "IN",
      "IS NULL",
      "IS NOT NULL",
      "LIKE",
      "BETWEEN",
      "UNION",
      "UNION ALL",
      "EXCEPT",
      "INTERSECT",
      "VALUES",
      "INSERT INTO",
      "UPDATE",
      "SET",
      "DELETE FROM",
      "CREATE TABLE",
      "ALTER TABLE",
      "DROP TABLE",
      "CREATE INDEX",
      "DROP INDEX",
      "AS",
      "DISTINCT",
      "CASE",
      "WHEN",
      "THEN",
      "ELSE",
      "END",
      "RETURNING"
    ];

    function showStatus(message, type) {
      status.textContent = message;
      status.className = "status " + type;
    }

    function protectStrings(sql) {
      const strings = [];

      const protectedSql = sql.replace(
        /'(?:''|[^'])*'|"(?:[^"]|"")*"/g,
        function (match) {
          const index = strings.length;
          strings.push(match);
          return "___STRING_" + index + "___";
        }
      );

      return {
        sql: protectedSql,
        strings: strings
      };
    }

    function restoreStrings(sql, strings) {
      return sql.replace(
        /___STRING_(\d+)___/g,
        function (_, index) {
          return strings[Number(index)] || "";
        }
      );
    }

    function formatSQL(sql) {
      let text = sql.trim();

      if (!text) {
        return "";
      }

      const protectedData = protectStrings(text);

      text = protectedData.sql;

      text = text
        .replace(/\s+/g, " ")
        .replace(/\s*,\s*/g, ", ")
        .replace(/\s*;\s*/g, ";\n")
        .replace(/\(\s+/g, "(")
        .replace(/\s+\)/g, ")");

      const upper = text.toUpperCase();

      const sortedKeywords = keywords
        .slice()
        .sort(function (a, b) {
          return b.length - a.length;
        });

      sortedKeywords.forEach(function (keyword) {
        const pattern = new RegExp(
          "\\s*" +
          keyword
            .replace(/\s+/g, "\\s+")
            .replace(/[.*+?^${}()|[\]\\]/g, "\\$&") +
          "\\s*",
          "gi"
        );

        text = text.replace(pattern, "\n" + keyword + " ");
      });

      text = text
        .replace(/\n\s+/g, "\n")
        .replace(/\n{2,}/g, "\n")
        .replace(/[ \t]+/g, " ")
        .trim();

      const lines = text
        .split("\n")
        .map(function (line) {
          return line.trim();
        })
        .filter(Boolean);

      let level = 0;

      const formatted = [];

      lines.forEach(function (line) {
        if (line.startsWith(")") || line.startsWith("END")) {
          level = Math.max(0, level - 1);
        }

        formatted.push(
          "  ".repeat(level) + line
        );

        const openCount = (line.match(/\(/g) || []).length;
        const closeCount = (line.match(/\)/g) || []).length;

        if (
          openCount > closeCount &&
          !line.toUpperCase().includes("VALUES")
        ) {
          level++;
        }
      });

      text = formatted.join("\n");

      text = text
        .replace(/\nWHERE /gi, "\nWHERE ")
        .replace(/\nAND /gi, "\n  AND ")
        .replace(/\nOR /gi, "\n  OR ")
        .replace(/\nON /gi, "\n  ON ")
        .replace(/\nWHEN /gi, "\n  WHEN ")
        .replace(/\nTHEN /gi, "\n    THEN ")
        .replace(/\nELSE /gi, "\n    ELSE ")
        .replace(/\nEND/gi, "\nEND");

      text = text.replace(
        /SELECT ([\s\S]*?)\nFROM /i,
        function (_, columns) {
          const columnList = columns
            .split(",")
            .map(function (column) {
              return "  " + column.trim();
            })
            .join(",\n");

          return "SELECT\n" + columnList + "\nFROM ";
        }
      );

      text = restoreStrings(text, protectedData.strings);

      return text.trim();
    }

    function minifySQL(sql) {
      if (!sql.trim()) {
        return "";
      }

      const protectedData = protectStrings(sql);

      let text = protectedData.sql;

      text = text
        .replace(/--[^\n\r]*/g, "")
        .replace(/\/\*[\s\S]*?\*\//g, "")
        .replace(/\s+/g, " ")
        .replace(/\s*;\s*/g, ";")
        .replace(/\s*,\s*/g, ",")
        .replace(/\s*\(\s*/g, "(")
        .replace(/\s*\)\s*/g, ")")
        .trim();

      return restoreStrings(text, protectedData.strings);
    }

    formatBtn.addEventListener("click", function () {
      const sql = input.value;

      if (!sql.trim()) {
        output.value = "";
        showStatus("أدخل استعلام SQL أولاً.", "error");
        return;
      }

      try {
        output.value = formatSQL(sql);
        showStatus("تم تنسيق SQL بنجاح.", "success");
      } catch (error) {
        output.value = "";
        showStatus("حدث خطأ أثناء تنسيق SQL.", "error");
      }
    });

    minifyBtn.addEventListener("click", function () {
      const sql = input.value;

      if (!sql.trim()) {
        output.value = "";
        showStatus("أدخل استعلام SQL أولاً.", "error");
        return;
      }

      try {
        output.value = minifySQL(sql);
        showStatus("تم ضغط SQL بنجاح.", "success");
      } catch (error) {
        output.value = "";
        showStatus("حدث خطأ أثناء ضغط SQL.", "error");
      }
    });

    copyBtn.addEventListener("click", async function () {
      if (!output.value.trim()) {
        showStatus("لا توجد نتيجة لنسخها.", "error");
        return;
      }

      try {
        await navigator.clipboard.writeText(output.value);
        showStatus("تم نسخ النتيجة.", "success");
      } catch (error) {
        output.select();
        document.execCommand("copy");
        showStatus("تم نسخ النتيجة.", "success");
      }
    });

    clearBtn.addEventListener("click", function () {
      input.value = "";
      output.value = "";
      status.textContent = "";
      status.className = "status";
      input.focus();
    });

    input.addEventListener("keydown", function (event) {
      if (
        (event.ctrlKey || event.metaKey) &&
        event.key === "Enter"
      ) {
        event.preventDefault();
        formatBtn.click();
      }
    });
  </script>
</body>
</html>
