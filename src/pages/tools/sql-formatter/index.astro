---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SQL Formatter - تنسيق SQL أونلاين مجاناً | Th.Tech";

const description =
  "أداة SQL Formatter مجانية لتنسيق وترتيب استعلامات SQL وتحسين قراءتها مباشرة من المتصفح بدون رفع الكود.";

const faqs = [
  {
    q: "ما هي أداة SQL Formatter؟",
    a: "هي أداة مجانية لتنسيق وترتيب استعلامات SQL وجعلها أكثر وضوحاً وسهولة في القراءة والتعديل."
  },
  {
    q: "هل يتم إرسال استعلامات SQL إلى الخادم؟",
    a: "لا. تتم عملية التنسيق داخل المتصفح مباشرة، ولا تحتاج إلى رفع استعلام SQL إلى خادم خارجي."
  },
  {
    q: "ما قواعد SQL التي يمكن تنسيقها؟",
    a: "يمكن للأداة تنسيق معظم الاستعلامات الشائعة مثل SELECT وINSERT وUPDATE وDELETE وJOIN وGROUP BY وORDER BY وWHERE وغيرها."
  },
  {
    q: "هل يمكن تصغير SQL؟",
    a: "هذه الأداة مخصصة للتنسيق وتحسين القراءة. يمكن استخدام أداة SQL Minifier المخصصة لتصغير الاستعلامات."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم، SQL Formatter مجانية ويمكن استخدامها مباشرة من المتصفح."
  }
];
