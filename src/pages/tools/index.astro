  terminal: ['M5 5h14v14H5z','M8 9l3 3-3 3','M13 15h3'],
  linux: ['M12 4a4 4 0 0 0-4 4v3l-2 3 3 2h6l3-2-2-3V8a4 4 0 0 0-4-4z','M8 18h8'],
  api: ['M5 6h14v12H5z','M8 10h3','M8 14h6','M16 10h.01'],
  chart: ['M5 19V9','M10 19V5','M15 19v-7','M20 19V3']
};

const categoryNames: Record<string, string> = {
  all: 'كل الأدوات',
  JSON: 'JSON',
  HTML: 'HTML',
  CSS: 'CSS',
  JavaScript: 'JavaScript',
  SQL: 'SQL',
  Data: 'البيانات',
  Encoding: 'الترميز',
  Security: 'الأمان',
  'Date & Time': 'التاريخ والوقت',
  Colors: 'الألوان',
  Text: 'النصوص',
  Markdown: 'Markdown',
  Numbers: 'الأرقام',
  Developer: 'تطوير',
  Networking: 'الشبكات',
  Web: 'الويب',
  Linux: 'Linux',
  API: 'API'
};

const categories = [
  'all',
  'JSON',
  'HTML',
  'CSS',
  'JavaScript',
  'SQL',
  'Data',
  'Encoding',
  'Security',
  'Date & Time',
  'Colors',
  'Text',
  'Markdown',
  'Numbers',
  'Developer',
  'Networking',
  'Web',
  'Linux',
  'API'
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>أدوات المطورين | Th.Tech</title>

    <meta
      name="description"
      content="مجموعة متكاملة من أدوات المطورين المجانية والسريعة من Th.Tech."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/`}
    />

    <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- HERO -->
      <section class="hero">
        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <span>›</span>
          <strong>أدوات المطورين</strong>
        </div>

        <div class="hero-card">
          <div class="hero-shape shape-one"></div>
          <div class="hero-shape shape-two"></div>
          <div class="hero-shape shape-three"></div>

          <div class="hero-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v14H4z"></path>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
              <path d="M8 17h3"></path>
            </svg>
          </div>

          <div class="hero-text">
            <span class="eyebrow">TH.TECH TOOLBOX</span>

            <h1>أدوات المطورين</h1>

            <p>
              مجموعة احترافية من الأدوات السريعة والمجانية لإنجاز المهام
              التقنية اليومية.
            </p>
          </div>
        </div>
      </section>


      <!-- SEARCH -->
      <section class="tools-section">

        <div class="section-head">

          <div>
            <span class="section-label">DEVELOPER TOOLS</span>
            <h2>مركز الأدوات</h2>
          </div>

          <div class="count-box">
            <strong id="toolCount">{tools.length}</strong>
            <span>أداة</span>
          </div>

        </div>


        <div class="controls">

          <div class="search-box">

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>

            <input
              id="toolSearch"
              type="search"
              placeholder="ابحث عن أداة..."
              autocomplete="off"
              aria-label="البحث عن أداة"
            />

            <button
              id="clearSearch"
              type="button"
              aria-label="مسح البحث"
              title="مسح البحث"
            >
              ×
            </button>

          </div>


          <div class="category-scroll" id="categories">

            {categories.map((category) => (
              <button
                type="button"
                class={`category-btn ${category === 'all' ? 'active' : ''}`}
                data-category={category}
              >
                {categoryNames[category]}
              </button>
            ))}

          </div>

        </div>


        <!-- RESULT MESSAGE -->
        <div class="result-info" id="resultInfo">
          <span class="result-dot"></span>
          <span id="resultText">عرض جميع الأدوات</span>
        </div>


        <!-- TOOLS GRID -->
        <div class="tools-grid" id="toolsGrid">

          {tools.map((tool, index) => (
            <a
              href={`${base}/tools/${tool.slug}/`}
              class={`tool-card ${tool.color}`}
              data-name={tool.name.toLowerCase()}
              data-description={tool.desc.toLowerCase()}
              data-category={tool.category}
              aria-label={`فتح ${tool.name}`}
            >

              <div class="card-number">
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="card-corner"></div>

              <div class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {iconPaths[tool.icon].map((path) => (
                    <path d={path}></path>
                  ))}
                </svg>
              </div>

              <div class="tool-info">

                <span class="tool-category">
                  {categoryNames[tool.category]}
                </span>

                <h3>{tool.name}</h3>

                <p>{tool.desc}</p>

              </div>

              <div class="tool-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M5 12h13"></path>
                  <path d="M13 6l6 6-6 6"></path>
                </svg>
              </div>

            </a>
          ))}

        </div>


        <!-- EMPTY -->
        <div class="empty-state" id="emptyState" hidden>

          <div class="empty-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
              <path d="M8 11h6"></path>
            </svg>
          </div>

          <h3>لم يتم العثور على أداة</h3>

          <p>
            جرّب كلمة بحث أخرى أو اختر تصنيفًا مختلفًا.
          </p>

          <button type="button" id="resetFilters">
            عرض جميع الأدوات
          </button>

        </div>

      </section>


      <!-- INFO -->
      <section class="info-card">

        <div class="info-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v4"></path>
            <path d="M12 16h.01"></path>
          </svg>
        </div>

        <div>
          <span>TH.TECH</span>

          <h2>أدوات تقنية في مكان واحد</h2>

          <p>
            جميع الأدوات مصممة لتكون سريعة، بسيطة، ومتوافقة مع الهاتف والحاسوب.
          </p>
        </div>

      </section>

    </main>

    <Footer />
  </body>
</html>


<style>

  /* =========================================================
     GLOBAL / DARK MODE
     ========================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    background: #f4f7fb;
  }

  :global(html.dark) {
    background: #070b13;
    color-scheme: dark;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    font-family: "Cairo", sans-serif;
    background:
      radial-gradient(
        circle at 8% 5%,
        rgba(37, 99, 235, .065),
        transparent 27%
      ),
      radial-gradient(
        circle at 92% 20%,
        rgba(6, 182, 212, .055),
        transparent 30%
      ),
      #f4f7fb;
    color: #0f172a;
    transition:
      background-color .3s ease,
      color .3s ease;
  }

  :global(html.dark body) {
    background:
      radial-gradient(
        circle at 8% 5%,
        rgba(37, 99, 235, .12),
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(6, 182, 212, .07),
        transparent 30%
      ),
      #070b13;
    color: #f8fafc;
  }

  :global(html.dark body::selection) {
    background: rgba(59, 130, 246, .35);
  }

  :global(::selection) {
    background: rgba(37, 99, 235, .18);
  }


  /* =========================================================
     PAGE
     ========================================================= */

  .page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 75px;
  }


  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    margin-bottom: 35px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    color: #64748b;
    font-size: 11px;
  }

  .breadcrumb a {
    color: #2563eb;
    font-weight: 800;
    text-decoration: none;
  }

  .breadcrumb strong {
    color: #475569;
  }

  :global(html.dark) .breadcrumb strong {
    color: #cbd5e1;
  }

  .breadcrumb span {
    color: #94a3b8;
  }

  .hero-card {
    position: relative;
    min-height: 190px;
    display: flex;
    align-items: center;
    gap: 25px;
    overflow: hidden;
    padding: 35px 42px;
    border: 1px solid rgba(255,255,255,.9);
    border-radius: 30px;
    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.98),
        rgba(241,246,255,.97)
      );
    box-shadow:
      0 22px 60px rgba(15,23,42,.075),
      inset 0 1px 0 rgba(255,255,255,.95);
  }

  :global(html.dark) .hero-card {
    border-color: rgba(148,163,184,.13);
    background:
      linear-gradient(
        135deg,
        #111a2a,
        #0b1220
      );
    box-shadow:
      0 25px 65px rgba(0,0,0,.28),
      inset 0 1px 0 rgba(255,255,255,.025);
  }

  .hero-shape {
    position: absolute;
    pointer-events: none;
    border: 1px solid rgba(37,99,235,.09);
    transform: rotate(25deg);
  }

  .shape-one {
    width: 210px;
    height: 210px;
    left: -80px;
    top: -105px;
    border-radius: 48px;
  }

  .shape-two {
    width: 160px;
    height: 160px;
    right: -70px;
    bottom: -85px;
    border-radius: 42px;
  }

  .shape-three {
    width: 70px;
    height: 70px;
    right: 30%;
    top: -35px;
    border-radius: 18px;
    opacity: .45;
  }

  .hero-icon {
    position: relative;
    z-index: 2;
    width: 82px;
    height: 82px;
    flex: 0 0 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background: linear-gradient(
      145deg,
      #2563eb,
      #0891b2
    );
    box-shadow:
      0 18px 38px rgba(37,99,235,.27),
      inset 0 1px 0 rgba(255,255,255,.4);
    animation: heroFloat 4s ease-in-out infinite;
  }

  .hero-icon svg {
    width: 42px;
    height: 42px;
    fill: none;
    stroke: white;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-text {
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .section-label {
    display: block;
    color: #2563eb;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    margin: 5px 0 7px;
    color: #0f172a;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.2;
    font-weight: 800;
  }

  :global(html.dark) .hero h1 {
    color: #f8fafc;
  }

  .hero p {
    max-width: 680px;
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.9;
  }

  :global(html.dark) .hero p {
    color: #94a3b8;
  }


  /* =========================================================
     SECTION
     ========================================================= */

  .tools-section {
    margin-top: 15px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 19px;
  }

  .section-head h2 {
    margin: 4px 0 0;
    color: #0f172a;
    font-size: 23px;
    font-weight: 800;
  }

  :global(html.dark) .section-head h2 {
    color: #f8fafc;
  }

  .count-box {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
    font-size: 11px;
  }

  :global(html.dark) .count-box {
    color: #94a3b8;
  }

  .count-box strong {
    min-width: 40px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border: 1px solid rgba(37,99,235,.1);
    border-radius: 10px;
    background: #eaf1ff;
    color: #2563eb;
    font-size: 12px;
  }

  :global(html.dark) .count-box strong {
    border-color: rgba(59,130,246,.2);
    background: rgba(37,99,235,.13);
    color: #60a5fa;
  }


  /* =========================================================
     SEARCH
     ========================================================= */

  .controls {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 16px;
  }

  .search-box {
    position: relative;
    flex: 0 0 310px;
    height: 50px;
  }

  .search-box > svg {
    position: absolute;
    top: 50%;
    right: 17px;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: #64748b;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  :global(html.dark) .search-box > svg {
    stroke: #94a3b8;
  }

  .search-box input {
    width: 100%;
    height: 100%;
    padding: 0 48px 0 45px;
    border: 1px solid #dbe3ee;
    border-radius: 15px;
    outline: none;
    background: rgba(255,255,255,.92);
    color: #0f172a;
    font-family: inherit;
    font-size: 12px;
    transition:
      border-color .2s ease,
      box-shadow .2s ease,
      background .2s ease;
  }

  .search-box input::placeholder {
    color: #94a3b8;
  }

  .search-box input:focus {
    border-color: rgba(37,99,235,.55);
    box-shadow: 0 0 0 4px rgba(37,99,235,.08);
  }

  :global(html.dark) .search-box input {
    border-color: rgba(148,163,184,.16);
    background: #101827;
    color: #f8fafc;
  }

  :global(html.dark) .search-box input:focus {
    border-color: rgba(59,130,246,.55);
    background: #111c2e;
    box-shadow: 0 0 0 4px rgba(59,130,246,.1);
  }

  .search-box button {
    position: absolute;
    top: 50%;
    left: 10px;
    width: 29px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 0;
    border-radius: 9px;
    background: #f1f5f9;
    color: #64748b;
    font-family: Arial, sans-serif;
    font-size: 19px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity .2s ease,
      background .2s ease;
  }

  .search-box.has-value button {
    opacity: 1;
    pointer-events: auto;
  }

  .search-box button:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  :global(html.dark) .search-box button {
    background: #1a2639;
    color: #94a3b8;
  }

  :global(html.dark) .search-box button:hover {
    background: #243249;
    color: #f8fafc;
  }


  /* =========================================================
     CATEGORY BUTTONS
     ========================================================= */

  .category-scroll {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding: 3px 2px 7px;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  :global(html.dark) .category-scroll {
    scrollbar-color: #334155 transparent;
  }

  .category-btn {
    flex: 0 0 auto;
    height: 40px;
    padding: 0 15px;
    border: 1px solid #dce4ef;
    border-radius: 12px;
    background: rgba(255,255,255,.82);
    color: #64748b;
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .category-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(37,99,235,.3);
    color: #2563eb;
  }

  .category-btn.active {
    border-color: #2563eb;
    background: #2563eb;
    color: white;
    box-shadow: 0 7px 18px rgba(37,99,235,.18);
  }

  :global(html.dark) .category-btn {
    border-color: rgba(148,163,184,.15);
    background: #101827;
    color: #94a3b8;
  }

  :global(html.dark) .category-btn:hover {
    border-color: rgba(59,130,246,.45);
    background: #132038;
    color: #60a5fa;
  }

  :global(html.dark) .category-btn.active {
    border-color: #2563eb;
    background: #2563eb;
    color: white;
  }


  /* =========================================================
     RESULT INFO
     ========================================================= */

  .result-info {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 22px;
    margin-bottom: 11px;
    color: #64748b;
    font-size: 10px;
  }

  :global(html.dark) .result-info {
    color: #94a3b8;
  }

  .result-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34,197,94,.08);
  }


  /* =========================================================
     GRID
     ========================================================= */

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
  }


  /* =========================================================
     GEOMETRIC TOOL CARD
     ========================================================= */

  .tool-card {
    --accent: #2563eb;
    --soft: #eaf1ff;

    position: relative;
    min-height: 170px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    padding: 18px;
    border: 1px solid #e1e8f1;
    border-radius: 19px;
    background: rgba(255,255,255,.95);
    color: #0f172a;
    text-decoration: none;
    isolation: isolate;
    box-shadow:
      0 8px 25px rgba(15,23,42,.045),
      inset 0 1px 0 rgba(255,255,255,.95);
    transition:
      transform .25s cubic-bezier(.2,.8,.2,1),
      border-color .25s ease,
      box-shadow .25s ease,
      background .25s ease;
  }

  /*
   * هندسة البطاقة:
   * الشكل ليس دائرة ولا مستطيلاً عادياً.
   */
  .tool-card::before {
    content: "";
    position: absolute;
    width: 115px;
    height: 115px;
    top: -62px;
    left: -52px;
    border: 1px solid var(--accent);
    border-radius: 25px;
    transform: rotate(32deg);
    opacity: .10;
    pointer-events: none;
    z-index: -1;
  }

  .tool-card::after {
    content: "";
    position: absolute;
    width: 85px;
    height: 85px;
    right: -40px;
    bottom: -38px;
    border: 1px solid var(--accent);
    border-radius: 20px;
    transform: rotate(32deg);
    opacity: .075;
    pointer-events: none;
    z-index: -1;
  }

  :global(html.dark) .tool-card {
    border-color: rgba(148,163,184,.13);
    background: #0f1827;
    color: #f8fafc;
    box-shadow:
      0 12px 32px rgba(0,0,0,.19),
      inset 0 1px 0 rgba(255,255,255,.025);
  }

  .tool-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(
      in srgb,
      var(--accent) 38%,
      #e1e8f1
    );
    box-shadow:
      0 18px 40px rgba(15,23,42,.10),
      0 0 0 1px color-mix(
        in srgb,
        var(--accent) 7%,
        transparent
      );
  }

  :global(html.dark) .tool-card:hover {
    border-color: color-mix(
      in srgb,
      var(--accent) 48%,
      #1e293b
    );
    background: #111c2e;
    box-shadow:
      0 20px 48px rgba(0,0,0,.30),
      0 0 0 1px color-mix(
        in srgb,
        var(--accent) 9%,
        transparent
      );
  }

  .tool-card:active {
    transform: translateY(-2px) scale(.99);
  }


  /* =========================================================
     CARD NUMBER
     ========================================================= */

  .card-number {
    position: absolute;
    top: 11px;
    left: 14px;
    color: #cbd5e1;
    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .7px;
  }

  :global(html.dark) .card-number {
    color: #334155;
  }


  /* =========================================================
     CARD CORNER
     ========================================================= */

  .card-corner {
    position: absolute;
    right: -21px;
    top: -21px;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    transform: rotate(45deg);
    background: var(--soft);
    opacity: .65;
