    <circle cx="32" cy="38" r="2"/>
    <circle cx="39" cy="38" r="2"/>
  `,

  uuid: `
    <rect x="10" y="10" width="44" height="44" rx="9"/>
    <path d="M20 23v14a12 12 0 0 0 24 0V23"/>
  `,

  jwt: `
    <path d="M32 8l7 12h14l-11 9 4 14-14-8-14 8 4-14-11-9h14z"/>
  `,

  random: `
    <path d="M12 20h8c8 0 9 24 17 24h15"/>
    <path d="M12 44h8c8 0 9-24 17-24h15"/>
    <path d="M45 16l7 4-7 4M45 40l7 4-7 4"/>
  `,

  browser: `
    <rect x="9" y="11" width="46" height="42" rx="7"/>
    <path d="M9 22h46"/>
    <circle cx="17" cy="17" r="2"/>
    <circle cx="24" cy="17" r="2"/>
  `,

  http: `
    <rect x="9" y="12" width="46" height="40" rx="6"/>
    <path d="M17 25h30M17 34h22M17 43h14"/>
  `,

  file: `
    <path d="M16 8h21l11 11v37H16z"/>
    <path d="M37 8v12h11"/>
  `,

  meta: `
    <rect x="11" y="11" width="42" height="42" rx="7"/>
    <path d="M19 22h26M19 32h20M19 42h15"/>
  `,

  robot: `
    <rect x="13" y="19" width="38" height="31" rx="7"/>
    <path d="M32 19V11M25 11h14"/>
    <circle cx="24" cy="32" r="3"/>
    <circle cx="40" cy="32" r="3"/>
    <path d="M23 42h18"/>
  `,

  map: `
    <path d="M9 12l15-5 16 5 15-5v40l-15 5-16-5-15 5z"/>
    <path d="M24 7v40M40 12v40"/>
  `,

  regex: `
    <path d="M15 20h34M15 32h34M15 44h34"/>
    <path d="M32 12v40M21 26l22 12M43 26L21 38"/>
  `,

  binary: `
    <rect x="10" y="10" width="44" height="44" rx="8"/>
    <path d="M21 22v20M35 22v20M45 22v20"/>
  `,

  hex: `
    <path d="M32 8l20 12v24L32 56 12 44V20z"/>
    <path d="M23 28h18M23 36h18"/>
  `,

  number: `
    <path d="M22 10l-5 44M43 10l-5 44M10 25h44M8 41h44"/>
  `,

  ascii: `
    <rect x="10" y="10" width="44" height="44" rx="8"/>
    <path d="M20 42l12-22 12 22M24 35h16"/>
  `,

  roman: `
    <path d="M20 16l12 18 12-18M32 34v14"/>
  `,

  clock: `
    <circle cx="32" cy="32" r="23"/>
    <path d="M32 19v14l9 6"/>
  `,

  timestamp: `
    <circle cx="32" cy="32" r="22"/>
    <path d="M32 20v12l8 7"/>
    <path d="M15 14l-5 5M49 14l5 5"/>
  `,

  calendar: `
    <rect x="10" y="13" width="44" height="40" rx="6"/>
    <path d="M10 24h44M20 9v9M44 9v9"/>
  `,

  globe: `
    <circle cx="32" cy="32" r="23"/>
    <path d="M9 32h46M32 9c7 7 7 39 0 46M32 9c-7 7-7 39 0 46"/>
  `,

  color: `
    <circle cx="32" cy="32" r="22"/>
    <circle cx="24" cy="25" r="3"/>
    <circle cx="40" cy="25" r="3"/>
    <circle cx="21" cy="37" r="3"/>
    <circle cx="39" cy="40" r="3"/>
  `,

  palette: `
    <path d="M32 10a22 22 0 1 0 0 44h5c4 0 6-5 3-8-2-2-1-6 3-6h5c5 0 8-4 8-9A22 22 0 0 0 32 10z"/>
    <circle cx="22" cy="27" r="2"/>
    <circle cx="30" cy="20" r="2"/>
    <circle cx="40" cy="22" r="2"/>
  `,

  sql: `
    <path d="M12 16c0-5 40-5 40 0v10c0 5-40 5-40 0z"/>
    <path d="M12 26v10c0 5 40 5 40 0V26"/>
    <path d="M12 36v10c0 5 40 5 40 0V36"/>
  `,

  database: `
    <ellipse cx="32" cy="15" rx="20" ry="8"/>
    <path d="M12 15v17c0 5 9 8 20 8s20-3 20-8V15"/>
    <path d="M12 32c0 5 9 8 20 8s20-3 20-8"/>
  `,

  markdown: `
    <rect x="9" y="14" width="46" height="36" rx="5"/>
    <path d="M17 40V24l7 9 7-9v16M39 24v16M35 36l4 4 4-4"/>
  `,

  qr: `
    <rect x="10" y="10" width="16" height="16"/>
    <rect x="38" y="10" width="16" height="16"/>
    <rect x="10" y="38" width="16" height="16"/>
    <path d="M38 38h7v7h-7zM48 48h6v6h-6zM38 50h5"/>
  `,

  xml: `
    <path d="M22 20l-10 12 10 12M42 20l10 12-10 12M36 15L28 49"/>
  `,

  yaml: `
    <path d="M15 17h34M15 32h24M15 47h30"/>
    <circle cx="49" cy="32" r="4"/>
  `,

  encode: `
    <path d="M18 46l28-28"/>
    <path d="M20 20h24v24"/>
  `,

  button: `
    <rect x="12" y="20" width="40" height="24" rx="8"/>
    <path d="M25 32h14"/>
  `,

  card: `
    <rect x="10" y="12" width="44" height="40" rx="8"/>
    <path d="M10 24h44"/>
    <path d="M20 34h18M20 42h12"/>
  `,

  loader: `
    <path d="M32 8v8M32 48v8M8 32h8M48 32h8"/>
    <path d="M15 15l6 6M43 43l6 6M49 15l-6 6M21 43l-6 6"/>
  `,

  animation: `
    <path d="M10 40c7-20 13-20 20 0s13 20 24 0"/>
    <circle cx="10" cy="40" r="3"/>
    <circle cx="54" cy="40" r="3"/>
  `

};

function getIcon(icon) {
  return iconPaths[icon] || iconPaths.json;
}
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />

  <link
    rel="icon"
    type="image/png"
    href={`${base}/logo1.png`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

</head>


<body>

  <Header />


  <main class="page">


    <!-- HERO -->

    <section class="hero">

      <div class="hero-badge">

        <span class="dot"></span>

        TH.TECH · DEVELOPER TOOLS

      </div>


      <h1>
        أدوات المطورين
      </h1>


      <p>
        مجموعة متكاملة من الأدوات المجانية والسريعة
        لإنجاز مهامك البرمجية مباشرة من المتصفح.
      </p>


      <div class="hero-stats">

        <div>

          <strong>
            {tools.length}+
          </strong>

          <span>
            أداة
          </span>

        </div>


        <div>

          <strong>
            100%
          </strong>

          <span>
            مجانية
          </span>

        </div>


        <div>

          <strong>
            0
          </strong>

          <span>
            تسجيل
          </span>

        </div>

      </div>

    </section>


    <!-- CATEGORIES -->

    {
      categories.map((category) => (

        <section class="category">

          <div class="category-header">

            <div>

              <span class="category-label">
                DEVELOPER TOOLS
              </span>

              <h2>
                {category}
              </h2>

            </div>


            <span class="category-count">

              {
                tools.filter(
                  tool => tool.category === category
                ).length
              }

            </span>

          </div>


          <div class="tools-grid">

            {
              tools
                .filter(
                  tool => tool.category === category
                )
                .map((tool) => (

                  <a
                    href={`${base}/tools/${tool.slug}/`}
                    class="tool-card"
                    aria-label={`فتح ${tool.name}`}
                  >

                    <div class="tool-icon">

                      <svg
                        viewBox="0 0 64 64"
                        aria-hidden="true"
                        set:html={getIcon(tool.icon)}
                      />

                    </div>


                    <div class="tool-content">

                      <h3>
                        {tool.name}
                      </h3>

                      <p>
                        {tool.description}
                      </p>

                    </div>


                    <div class="tool-arrow">

                      <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >

                        <path
                          d="M15 18l-6-6 6-6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />

                      </svg>

                    </div>

                  </a>

                ))
            }

          </div>

        </section>

      ))
    }


    <!-- BOTTOM INFO -->

    <section class="bottom-info">

      <div class="info-card">

        <div class="info-icon">

          <svg viewBox="0 0 24 24">

            <path
              d="M13 2L4 14h7l-1 8 9-12h-7z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            />

          </svg>

        </div>

        <strong>
          سريعة
        </strong>

        <span>
          تعمل مباشرة داخل المتصفح
        </span>

      </div>


      <div class="info-card">

        <div class="info-icon">

          <svg viewBox="0 0 24 24">

            <path
              d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <path
              d="M9 12l2 2 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />

          </svg>

        </div>

        <strong>
          خصوصية
        </strong>

        <span>
          معالجة محلية للبيانات
        </span>

      </div>


      <div class="info-card">

        <div class="info-icon">

          <svg viewBox="0 0 24 24">

            <rect
              x="5"
              y="3"
              width="14"
              height="18"
              rx="3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <path
              d="M9 7h6M9 11h6M9 15h4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />

          </svg>

        </div>

        <strong>
          بدون تسجيل
        </strong>

        <span>
          استخدم الأدوات مباشرة
        </span>

      </div>

    </section>


  </main>


  <Footer />

</body>

</html>


<style>

:root {

  --bg: #f6f8fb;

  --card: #ffffff;

  --text: #0f172a;

  --muted: #64748b;

  --border: #e2e8f0;

  --soft: #f1f5f9;

  --primary: #2563eb;

}


* {

  box-sizing: border-box;

  margin: 0;

  padding: 0;

}


html {

  scroll-behavior: smooth;

}


body {

  background: var(--bg);

  color: var(--text);

  font-family: "Cairo", sans-serif;

  line-height: 1.7;

}


.page {

  width:
    min(
      1180px,
      calc(100% - 32px)
    );

  margin: auto;

  padding:
    45px 0 75px;

}


/* =========================
   HERO
========================= */

.hero {

  max-width: 760px;

  margin:
    0 auto 58px;

  text-align: center;

}


.hero-badge {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding:
    6px 13px;

  border:
    1px solid
    rgba(37,99,235,.14);

  border-radius:
    999px;

  background:
    rgba(37,99,235,.06);

  color:
    var(--primary);

  font-size:
    9px;

  font-weight:
    800;

  letter-spacing:
    1px;

}


.dot {

  width:
    6px;

  height:
    6px;

  border-radius:
    50%;

  background:
    var(--primary);

}


.hero h1 {

  margin-top:
    14px;

  font-size:
    38px;

  font-weight:
    800;

  line-height:
    1.3;

}


.hero p {

  max-width:
    650px;

  margin:
    10px auto 0;

  color:
    var(--muted);

  font-size:
    13px;

}


.hero-stats {

  display:
    flex;

  justify-content:
    center;

  gap:
    10px;

  margin-top:
    24px;

}


.hero-stats div {

  min-width:
    82px;

  padding:
    7px 12px;

  border:
    1px solid
    var(--border);

  border-radius:
    12px;

  background:
    var(--card);

}


.hero-stats strong {

  display:
    block;

  color:
    var(--primary);

  font-size:
    15px;

  font-weight:
    800;

  line-height:
    1.2;

}


.hero-stats span {

  color:
    var(--muted);

  font-size:
    8px;

}


/* =========================
   CATEGORY
========================= */

.category {

  margin-bottom:
    42px;

}


.category-header {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  margin-bottom:
    15px;

}


.category-label {

  display:
    block;

  color:
    var(--primary);

  font-size:
    8px;

  font-weight:
    800;

  letter-spacing:
    1.1px;

}


.category-header h2 {

  margin-top:
    2px;

  font-size:
    20px;

  font-weight:
    800;

}


.category-count {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  min-width:
    29px;

  height:
    29px;

  padding:
    0 8px;

  border-radius:
    999px;

  background:
    rgba(37,99,235,.08);

  color:
    var(--primary);

  font-size:
    10px;

  font-weight:
    800;

}


/* =========================
   GRID
========================= */

.tools-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap:
    15px;

}


/* =========================
   CARD
========================= */

.tool-card {

  position:
    relative;

  display:
    flex;

  align-items:
    center;

  gap:
    14px;

  min-height:
    112px;

  padding:
    16px;

  overflow:
    hidden;

  border:
    1px solid
    var(--border);

  border-radius:
    22px;

  background:
    var(--card);

  color:
    var(--text);

  text-decoration:
    none;

  transition:
    transform .22s ease,
    border-color .22s ease,
    box-shadow .22s ease;

}


.tool-card::after {

  content:
    "";

  position:
    absolute;

  width:
    100px;

  height:
    100px;

  left:
    -55px;

  bottom:
    -55px;

  border-radius:
    50%;

  background:
    rgba(37,99,235,.035);

  pointer-events:
    none;

}


.tool-card:hover {

  transform:
    translateY(-4px);

  border-color:
    rgba(37,99,235,.35);

  box-shadow:
    0 15px 35px
    rgba(15,23,42,.08);

}


.tool-card:active {

  transform:
    scale(.98);

}


/* =========================
   ICON
========================= */

.tool-icon {

  position:
    relative;

  z-index:
    1;

  width:
    59px;

  height:
    59px;

  flex:
    none;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    50%;

  background:
    rgba(37,99,235,.08);

  color:
    var(--primary);

  transition:
    .22s ease;

}


.tool-icon svg {

  width:
    31px;

  height:
    31px;

  fill:
    none;

  stroke:
    currentColor;

  stroke-width:
    3;

  stroke-linecap:
    round;

  stroke-linejoin:
    round;

}


.tool-card:hover .tool-icon {

  background:
    var(--primary);

  color:
    white;

  transform:
    scale(1.06)
    rotate(-4deg);

}


/* =========================
   CONTENT
========================= */

.tool-content {

  position:
    relative;

  z-index:
    1;

  min-width:
    0;

  flex:
    1;

}


.tool-content h3 {

  font-size:
    13px;

  font-weight:
    800;

  line-height:
    1.4;

}


.tool-content p {

  margin-top:
    3px;

  color:
    var(--muted);

  font-size:
    9px;

  line-height:
    1.6;

}


/* =========================
   ARROW
========================= */

.tool-arrow {

  position:
    relative;

  z-index:
    1;

  width:
    25px;

  height:
    25px;

  flex:
    none;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  color:
    #94a3b8;

  transition:
    .2s ease;

}


.tool-arrow svg {

  width:
    16px;

  height:
    16px;

}


.tool-card:hover .tool-arrow {

  color:
    var(--primary);

  transform:
    translateX(-3px);

}


/* =========================
   INFO
========================= */

.bottom-info {

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap:
    15px;

  margin-top:
    52px;

}


.info-card {

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  text-align:
    center;

  padding:
    20px;

  border:
    1px solid
    var(--border);

  border-radius:
    17px;

  background:
    var(--card);

}


.info-icon {

  width:
    43px;

  height:
    43px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  margin-bottom:
    7px;

  border-radius:
    50%;

  background:
    rgba(37,99,235,.08);

  color:
    var(--primary);

}


.info-icon svg {

  width:
    21px;

  height:
    21px;

}


.info-card strong {

  font-size:
    12px;

}


.info-card span {

  color:
    var(--muted);

  font-size:
    9px;

}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

  .tools-grid {

    grid-template-columns:
      repeat(2, 1fr);

  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

  .page {

    width:
      calc(100% - 16px);

    padding:
      28px 0 50px;

  }


  .hero {

    margin-bottom:
      38px;

  }


  .hero h1 {

    font-size:
      28px;

  }


  .hero p {

    padding:
      0 8px;

    font-size:
      11px;

  }


  .hero-stats {

    gap:
      7px;

  }


  .hero-stats div {

    min-width:
      70px;

    padding:
      6px 8px;

  }


  .hero-stats strong {

    font-size:
      13px;

  }


  .category {

    margin-bottom:
      32px;

  }


  .category-header h2 {

    font-size:
      17px;

  }


  .tools-grid {

    grid-template-columns:
      repeat(2, 1fr);

    gap:
      10px;

  }


  .tool-card {

    min-height:
      145px;

    padding:
      13px 8px;

    flex-direction:
      column;

    justify-content:
      center;

    text-align:
      center;

    gap:
      8px;

    border-radius:
      19px;

  }


  .tool-icon {

    width:
      56px;

    height:
      56px;

  }


  .tool-icon svg {

    width:
      29px;

    height:
      29px;

  }


  .tool-content h3 {

    font-size:
      10px;

  }


  .tool-content p {

    font-size:
      8px;

    line-height:
      1.5;

  }


  .tool-arrow {

    display:
      none;

  }


  .bottom-info {

    grid-template-columns:
      1fr;

    gap:
      10px;

    margin-top:
      38px;

  }


  .info-card {

    padding:
      16px;

  }

}

</style>
