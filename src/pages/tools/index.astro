<script>
  const searchInput = document.getElementById('searchInput');
  const cards = Array.from(document.querySelectorAll('.tool-card'));
  const categoryButtons = Array.from(document.querySelectorAll('#categories button'));
  const countElement = document.getElementById('toolCount');
  const emptyElement = document.getElementById('empty');

  let selectedCategory = 'الكل';

  function filterTools() {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const description = card.getAttribute('data-description') || '';
      const category = card.getAttribute('data-category') || '';

      const matchesSearch =
        query === '' ||
        name.includes(query) ||
        description.includes(query);

      const matchesCategory =
        selectedCategory === 'الكل' ||
        category === selectedCategory;

      const visible = matchesSearch && matchesCategory;

      card.hidden = !visible;

      if (visible) {
        visibleCount += 1;
      }
    });

    countElement.textContent = String(visibleCount);
    emptyElement.classList.toggle('show', visibleCount === 0);
  }

  searchInput.addEventListener('input', filterTools);

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedCategory = button.getAttribute('data-category') || 'الكل';

      categoryButtons.forEach((item) => {
        item.classList.remove('active');
      });

      button.classList.add('active');

      filterTools();
    });
  });
</script>

