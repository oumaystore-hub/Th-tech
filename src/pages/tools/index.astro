<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>أدوات المطورين | Th.Tech</title>
    <meta
      name="description"
      content="مجموعة متكاملة من أدوات المطورين المجانية والسريعة من Th.Tech."
    />
    <meta name="robots" content="index, follow" />
    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/`}
    />
    <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="page">

      <section class="hero">
        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <span>›</span>
          <strong>أدوات المطورين</strong>
        </div>

        <div class="hero-card">
          <div class="hero-decoration hero-decoration-one"></div>
          <div class="hero-decoration hero-decoration-two"></div>

          <div class="hero-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v14H4z"></path>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
              <path d="M8 17h3"></path>
            </svg>
          </div>

          <div class="hero-text">
            <span class="eyebrow">TH.TECH TOOLBOX</span>
            <h1>أدوات المطورين</h1>
            <p>
              مجموعة احترافية من الأدوات السريعة والمجانية لإنجاز المهام
              التقنية اليومية.
            </p>
          </div>
        </div>
      </section>

      <section class="tools-section">

        <div class="section-head">
          <div>
            <span class="section-label">DEVELOPER TOOLS</span>
            <h2>جميع الأدوات</h2>
          </div>

          <div class="count-box">
            <strong>{tools.length}</strong>
            <span>أداة</span>
          </div>
        </div>

        <div class="tools-grid">
          {tools.map((tool, index) => (
            <a
              href={`${base}/tools/${tool.slug}/`}
              class={`tool-card ${tool.color}`}
              aria-label={`فتح ${tool.name}`}
            >
              <div class="card-glow"></div>

              <div class="tool-number">
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {iconPaths[tool.icon].map((path) => (
                    <path d={path}></path>
                  ))}
                </svg>
              </div>

              <div class="tool-info">
                <h3>{tool.name}</h3>
                <p>{tool.desc}</p>
              </div>

              <div class="tool-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M5 12h13"></path>
                  <path d="M13 6l6 6-6 6"></path>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="info-card">
        <div class="info-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v4"></path>
            <path d="M12 16h.01"></path>
          </svg>
        </div>

        <div>
          <span>TH.TECH</span>
          <h2>أدوات تقنية في مكان واحد</h2>
          <p>
            جميع الأدوات مصممة لتكون سريعة، بسيطة، ومتوافقة مع الهاتف والحاسوب.
          </p>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: "Cairo", sans-serif;
