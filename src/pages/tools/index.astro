---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title} | Th.Tech</title>

    <meta
      name="description"
      content={description}
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        background: #f5f7fb;
        color: #172033;

        transition:
          background 0.3s ease,
          color 0.3s ease;
      }

      main {
        min-height: calc(100vh - 160px);
        padding: 42px 16px 70px;
      }

      .container {
        width: min(1150px, 100%);
        margin: auto;
      }

      /* =========================
         HERO
      ========================= */

      .hero {
        text-align: center;
        margin-bottom: 30px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 7px 14px;

        border-radius: 999px;

        background: rgba(0, 143, 245, 0.1);

        color: #0088ee;

        font-size: 13px;
        font-weight: 800;

        margin-bottom: 14px;
      }

      .hero h1 {
        margin: 0 0 12px;

        font-size: clamp(30px, 5vw, 50px);

        line-height: 1.15;
      }

      .hero p {
        max-width: 720px;

        margin: auto;

        color: #667085;

        font-size: 16px;

        line-height: 1.8;
      }

      /* =========================
         SEARCH
      ========================= */

      .search-box {
        position: relative;

        margin-bottom: 14px;
      }

      .search-box input {
        width: 100%;

        height: 50px;

        padding: 0 18px 0 45px;

        border: 1px solid #dce2eb;

        border-radius: 13px;

        background: white;

        color: #172033;

        outline: none;

        font: inherit;
      }

      .search-box input:focus {
        border-color: #008ff5;

        box-shadow:
          0 0 0 4px
          rgba(0, 143, 245, 0.1);
      }

      .search-icon {
        position: absolute;

        left: 15px;

        top: 50%;

        transform: translateY(-50%);

        color: #008ff5;

        pointer-events: none;
      }

      /* =========================
         CATEGORIES
      ========================= */

      .categories {
        display: flex;

        gap: 7px;

        overflow-x: auto;

        padding-bottom: 18px;

        scrollbar-width: thin;
      }

      .category-btn {
        flex-shrink: 0;

        padding: 8px 13px;

        border-radius: 9px;

        border: 1px solid #dce2eb;

        background: white;

        color: #475467;

        font: inherit;

        font-size: 12px;

        font-weight: 700;

        cursor: pointer;
      }

      .category-btn.active {
        background: #008ff5;

        border-color: #008ff5;

        color: white;
      }

      /* =========================
         GRID
      ========================= */

      .tools-grid {
        display: grid;

        grid-template-columns:
          repeat(
            3,
            minmax(0, 1fr)
          );

        gap: 16px;
      }

      .tool-card {
        display: flex;

        flex-direction: column;

        min-width: 0;

        min-height: 215px;

        padding: 19px;

        border-radius: 18px;

        background: white;

        border: 1px solid #e5e9f2;

        box-shadow:
          0 7px 22px
          rgba(20, 35, 60, 0.05);

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .tool-card:hover {
        transform: translateY(-3px);

        border-color:
          rgba(0, 143, 245, 0.35);

        box-shadow:
          0 13px 30px
          rgba(20, 35, 60, 0.09);
      }

      .tool-top {
        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 8px;

        margin-bottom: 15px;
      }

      /* =========================
         SVG ICON
      ========================= */

      .tool-icon {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        background:
          linear-gradient(
            145deg,
            rgba(0, 143, 245, 0.13),
            rgba(0, 143, 245, 0.05)
          );

        color: #0088ee;
      }

      .tool-icon svg {
        width: 27px;
        height: 27px;

        fill: none;

        stroke: currentColor;

        stroke-width: 1.8;

        stroke-linecap: round;

        stroke-linejoin: round;
      }

      .tool-icon svg .fill {
        fill: currentColor;

        stroke: none;
      }

      .status {
        padding: 4px 8px;

        border-radius: 999px;

        font-size: 10px;

        font-weight: 800;

        white-space: nowrap;
      }

      .status.available {
        background: #ecfdf3;

        color: #067647;
      }

      .status.soon {
        background: #f2f4f7;

        color: #667085;
      }

      .tool-card h2 {
        margin: 0 0 7px;

        font-size: 17px;

        line-height: 1.35;
      }

      .tool-card p {
        margin: 0;

        flex: 1;

        color: #667085;

        font-size: 13px;

        line-height: 1.65;
      }

      .tool-footer {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 7px;

        margin-top: 15px;

        padding-top: 12px;

        border-top: 1px solid #edf0f5;
      }

      .tool-category {
        color: #98a2b3;

        font-size: 11px;

        font-weight: 700;
      }

      .open-tool {
        color: #0088ee;

        text-decoration: none;

        font-size: 12px;

        font-weight: 800;
      }

      .open-tool:hover {
        text-decoration: underline;
      }

      .disabled {
        color: #98a2b3;

        pointer-events: none;
      }

      /* =========================
         EMPTY
      ========================= */

      .empty {
        display: none;

        text-align: center;

        padding: 55px 20px;

        color: #667085;
      }

      .empty-icon {
        font-size: 38px;

        margin-bottom: 8px;
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 600px) {
        main {
          padding:
            28px 10px 50px;
        }

        .hero {
          margin-bottom: 24px;
        }

        .hero h1 {
          font-size: 30px;
        }

        .hero p {
          font-size: 14px;
        }

        /* هاتف = عمودان */

        .tools-grid {
          grid-template-columns:
            repeat(
              2,
              minmax(0, 1fr)
            );

          gap: 9px;
        }

        .tool-card {
          min-height: 205px;

          padding: 13px;

          border-radius: 14px;
        }

        .tool-top {
          margin-bottom: 11px;
        }

        .tool-icon {
          width: 40px;
          height: 40px;

          border-radius: 11px;
        }

        .tool-icon svg {
          width: 22px;
          height: 22px;
        }

        .status {
          font-size: 8px;

          padding: 3px 6px;
        }

        .tool-card h2 {
          font-size: 14px;

          line-height: 1.3;
        }

        .tool-card p {
          font-size: 11px;

          line-height: 1.55;
        }

        .tool-footer {
          margin-top: 10px;

          padding-top: 9px;
        }

        .tool-category,
        .open-tool {
          font-size: 9px;
        }
      }

      /* =========================
         DARK MODE
      ========================= */

      :global(html.dark) body {
        background: #0b1220;

        color: #f2f4f7;
      }

      :global(html.dark) .hero p {
        color: #98a2b3;
      }

      :global(html.dark) .search-box input {
        background: #111a2b;

        border-color: #263247;

        color: #f2f4f7;
      }

      :global(html.dark) .category-btn {
        background: #111a2b;

        border-color: #263247;

        color: #cbd5e1;
      }

      :global(html.dark) .tool-card {
        background: #111a2b;

        border-color: #263247;

        box-shadow:
          0 10px 30px
          rgba(0, 0, 0, 0.2);
      }

      :global(html.dark) .tool-card p {
        color: #98a2b3;
      }

      :global(html.dark) .tool-footer {
        border-color: #263247;
      }

      :global(html.dark) .status.soon {
        background: #263247;

        color: #98a2b3;
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <div class="container">

        <section class="hero">

          <div class="badge">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2l2.1 6.4L20.5 10l-6.4 2.1L12 18.5l-2.1-6.4L3.5 10l6.4-1.6L12 2z" />
              <path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16z" />
            </svg>

            Th.Tech Tools
          </div>

          <h1>
            أدوات تقنية للمطورين
          </h1>

          <p>
            مجموعة متكاملة من الأدوات السريعة والمجانية
            للبرمجة، النصوص، الترميز، التحويل والتطوير.
          </p>

        </section>

        <div class="search-box">

          <input
            id="searchInput"
            type="search"
            placeholder="ابحث عن أداة..."
            autocomplete="off"
          />

          <span class="search-icon">
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
          </span>

        </div>

        <div
          class="categories"
          id="categories"
        >
          {categories.map((category) => (
            <button
              class:list={[
                'category-btn',
                category === 'الكل' &&
                  'active',
              ]}
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>

        <section
          class="tools-grid"
          id="toolsGrid"
        >

          {tools.map((tool) => (
            <article
              class="tool-card"
              data-name={tool.name.toLowerCase()}
              data-description={tool.description.toLowerCase()}
              data-category={tool.category}
            >

              <div class="tool-top">

                <div class="tool-icon">

                  <!-- JSON FORMATTER -->
