<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>أدوات المطورين | Th.Tech</title>

    <meta
      name="description"
      content="مجموعة احترافية من أدوات المطورين لتنسيق وتحويل وفحص JSON وHTML وCSS وJavaScript وSQL والنصوص والمزيد."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/`}
    />

    <link rel="icon" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="tools-page">

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <span>أدوات المطورين</span>
          </div>

          <div class="hero-card">

            <div class="hero-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16v13H4z"></path>
                <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <path d="M4 11h16"></path>
                <path d="M10 15h4"></path>
              </svg>
            </div>

            <div class="hero-content">
              <span class="eyebrow">TH.TECH TOOLBOX</span>

              <h1>أدوات المطورين</h1>

              <p>
                مجموعة متكاملة من الأدوات التقنية السريعة لتنسيق الأكواد،
                تحويل البيانات، اختبارها، تحليلها وإنجاز مهام التطوير اليومية.
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- TOOLS -->
      <section class="tools-section">

        <div class="container">

          <div class="section-heading">

            <div>
              <span class="section-label">DEVELOPER TOOLS</span>
              <h2>جميع الأدوات</h2>
            </div>

            <div class="tools-count">
              {tools.length} أداة
            </div>

          </div>

          <div class="tools-grid">

            {tools.map((tool, index) => (

              <a
                class={`tool-card tool-${tool.color}`}
                href={`${base}/tools/${tool.slug}/`}
              >

                <div class="tool-number">
                  {String(index + 1).padStart(2, '0')}
                </div>

                <div class="tool-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">

                    {(iconPaths[tool.icon] ?? iconPaths.code).map((path) => (
                      <path d={path}></path>
                    ))}

                  </svg>

                </div>

                <div class="tool-content">

                  <span class="tool-category">
                    {tool.cat}
                  </span>

                  <h3>
                    {tool.name}
                  </h3>

                  <p>
                    {tool.desc}
                  </p>

                </div>

                <div class="tool-arrow">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 5 7 7-7 7"></path>
                  </svg>

                </div>

              </a>

            ))}

          </div>

          <!-- INFO -->
          <div class="info-card">

            <div class="info-icon">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 10v6"></path>
                <path d="M12 7h.01"></path>
              </svg>

            </div>

            <div>

              <span>TH.TECH</span>

              <h3>
                أدوات تقنية في مكان واحد
              </h3>

              <p>
                مجموعة من الأدوات المصممة لمساعدة المطورين على إنجاز المهام
                اليومية بسرعة وسهولة.
              </p>

            </div>

          </div>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>

<style>
  /* =========================================================
     TH.TECH — DEVELOPER TOOLS
     Global Light / Dark Theme
     ========================================================= */

  :global(html) {
    background: #f5f8fc;
    color-scheme: light;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(14, 165, 233, 0.08),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(37, 99, 235, 0.07),
        transparent 30%
      ),
      #f5f8fc;

    color: #172033;

    font-family: "Cairo", sans-serif;

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  /*
   * =========================================================
   * DARK MODE
   *
   * يدعم الطريقتين:
   * html.dark
   * html[data-theme="dark"]
   *
   * وبالتالي لن يعتمد على طريقة واحدة فقط من Header.
   * =========================================================
   */

  :global(html.dark),
  :global(html[data-theme="dark"]) {
    color-scheme: dark;
    background: #080d16;
  }

  :global(html.dark body),
  :global(html[data-theme="dark"] body) {
    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(14, 165, 233, 0.09),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(37, 99, 235, 0.08),
        transparent 30%
      ),
      #080d16;

    color: #edf4ff;
  }

  /* =========================================================
     PAGE
     ========================================================= */

  .tools-page {
    width: 100%;
    min-height: 100vh;

    background: transparent;

    color: inherit;

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .container {
    width: min(1380px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    padding: 28px 0 30px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;

    margin-bottom: 18px;

    font-size: 13px;
    font-weight: 600;

    color: #64748b;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;

    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .breadcrumb a:hover {
    opacity: 0.75;
  }

  .breadcrumb span:last-child {
    color: #94a3b8;
  }

  .hero-card {
    position: relative;

    display: flex;
    align-items: center;
    gap: 24px;

    padding: 34px;

    overflow: hidden;

    border: 1px solid rgba(148, 163, 184, 0.18);

    border-radius: 28px;

    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.96),
        rgba(241, 248, 255, 0.96)
      );

    box-shadow:
      0 20px 60px rgba(15, 23, 42, 0.07),
      0 4px 14px rgba(15, 23, 42, 0.04);

    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .hero-card::before {
    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    left: -100px;
    top: -150px;

    border-radius: 50%;

    background: rgba(14, 165, 233, 0.08);

    pointer-events: none;
  }

  .hero-card::after {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    right: -120px;
    bottom: -180px;

    border-radius: 50%;

    background: rgba(37, 99, 235, 0.07);

    pointer-events: none;
  }

  .hero-icon {
    position: relative;
    z-index: 1;

    flex: 0 0 78px;

    width: 78px;
    height: 78px;

    display: grid;
    place-items: center;

    border-radius: 22px;

    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #0ea5e9,
        #2563eb
      );

    box-shadow:
      0 14px 30px rgba(37, 99, 235, 0.25);

    animation: heroFloat 5s ease-in-out infinite;
  }

  .hero-icon svg {
    width: 38px;
    height: 38px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-content {
    position: relative;
    z-index: 1;

    min-width: 0;
  }

  .eyebrow {
    display: inline-block;

    margin-bottom: 7px;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 1.5px;

    color: #0284c7;
  }

  .hero-content h1 {
    margin: 0 0 9px;

    font-size: clamp(28px, 4vw, 44px);

    line-height: 1.2;

    font-weight: 800;

    letter-spacing: -0.7px;

    color: #0f172a;
  }

  .hero-content p {
    max-width: 800px;

    margin: 0;

    font-size: 15px;
    line-height: 1.9;

    color: #64748b;
  }

  /* =========================================================
     HERO DARK
     ========================================================= */

  :global(html.dark) .hero-card,
  :global(html[data-theme="dark"]) .hero-card {
    background:
      linear-gradient(
        135deg,
        rgba(17, 25, 39, 0.96),
        rgba(12, 20, 34, 0.96)
      );

    border-color: rgba(71, 85, 105, 0.34);

    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.35),
      0 4px 18px rgba(0, 0, 0, 0.2);
  }

  :global(html.dark) .hero-content h1,
  :global(html[data-theme="dark"]) .hero-content h1 {
    color: #f8fafc;
  }

  :global(html.dark) .hero-content p,
  :global(html[data-theme="dark"]) .hero-content p {
    color: #94a3b8;
  }

  :global(html.dark) .breadcrumb,
  :global(html[data-theme="dark"]) .breadcrumb {
    color: #94a3b8;
  }

  :global(html.dark) .breadcrumb span:last-child,
  :global(html[data-theme="dark"]) .breadcrumb span:last-child {
    color: #64748b;
  }

  /* =========================================================
     SECTION
     ========================================================= */

  .tools-section {
    padding: 12px 0 70px;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
  }

  .section-label {
    display: block;

    margin-bottom: 4px;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1.5px;

    color: #0284c7;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 25px;
    line-height: 1.3;

    font-weight: 800;

    color: #172033;
  }

  .tools-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 82px;
    min-height: 38px;

    padding: 0 15px;

    border: 1px solid #e2e8f0;

    border-radius: 12px;

    background: #ffffff;

    color: #64748b;

    font-size: 13px;
    font-weight: 700;

    box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
  }

  :global(html.dark) .section-heading h2,
  :global(html[data-theme="dark"]) .section-heading h2 {
    color: #f8fafc;
  }

  :global(html.dark) .tools-count,
  :global(html[data-theme="dark"]) .tools-count {
    background: #111827;
    border-color: #263449;
    color: #94a3b8;
    box-shadow: none;
  }

  /* =========================================================
     GRID
     ========================================================= */

  .tools-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 15px;
  }

  /* =========================================================
     TOOL CARD
     ========================================================= */

  .tool-card {
    --accent: #2563eb;
    --soft: rgba(37, 99, 235, 0.08);

    position: relative;

    min-width: 0;

    display: grid;

    grid-template-columns: 42px 48px minmax(0, 1fr) 20px;

    align-items: center;

    gap: 13px;

    min-height: 112px;

    padding: 16px;

    overflow: hidden;

    text-decoration: none;

    border: 1px solid #e5eaf1;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 7px 25px rgba(15, 23, 42, 0.045);

    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      background-color 0.22s ease;
  }

  .tool-card::before {
    content: "";

    position: absolute;

    inset-inline-start: 0;
    top: 16px;
    bottom: 16px;

    width: 3px;

    border-radius: 0 5px 5px 0;

    background: var(--accent);

    opacity: 0.85;
  }

  .tool-card:hover {
    transform: translateY(-4px);

    border-color: color-mix(
      in srgb,
      var(--accent) 38%,
      #e5eaf1
    );

    box-shadow:
      0 15px 35px rgba(15, 23, 42, 0.09);
  }

  /* =========================================================
     CARD DARK
     ========================================================= */

  :global(html.dark) .tool-card,
  :global(html[data-theme="dark"]) .tool-card {
    background: #111827;

    border-color: #263449;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.22);
  }

  :global(html.dark) .tool-card:hover,
  :global(html[data-theme="dark"]) .tool-card:hover {
    background: #141e2e;

    border-color: color-mix(
      in srgb,
      var(--accent) 50%,
      #263449
    );

    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.32);
  }

  /* =========================================================
     CARD COLORS
     ========================================================= */

  .tool-blue {
    --accent: #2563eb;
    --soft: rgba(37, 99, 235, 0.09);
  }

  .tool-green {
    --accent: #16a34a;
    --soft: rgba(22, 163, 74, 0.09);
  }

  .tool-orange {
    --accent: #f97316;
    --soft: rgba(249, 115, 22, 0.09);
  }

  .tool-yellow {
    --accent: #ca8a04;
    --soft: rgba(202, 138, 4, 0.1);
  }

  .tool-purple {
    --accent: #9333ea;
    --soft: rgba(147, 51, 234, 0.09);
  }

  .tool-cyan {
    --accent: #0891b2;
    --soft: rgba(8, 145, 178, 0.09);
  }

  /* =========================================================
     NUMBER
     ========================================================= */

  .tool-number {
    align-self: start;

    padding-top: 3px;

    font-family: Arial, sans-serif;

    font-size: 10px;
    font-weight: 800;

    color: #94a3b8;

    opacity: 0.8;
  }

  /* =========================================================
     ICON
     ========================================================= */

  .tool-icon {
    width: 46px;
    height: 46px;

    display: grid;
    place-items: center;

    border-radius: 14px;

    color: var(--accent);

    background: var(--soft);

    transition:
      transform 0.22s ease,
      background-color 0.22s ease;
  }

  .tool-card:hover .tool-icon {
    transform: scale(1.06);
  }

  .tool-icon svg {
    width: 24px;
    height: 24px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================================================
     CONTENT
     ========================================================= */

  .tool-content {
    min-width: 0;
  }

  .tool-category {
    display: block;

    margin-bottom: 2px;

    font-family: Arial, sans-serif;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.8px;

    color: var(--accent);

    opacity: 0.9;
  }

  .tool-content h3 {
    margin: 0 0 3px;

    overflow: hidden;

    font-size: 14px;
    font-weight: 800;

    line-height: 1.5;

    white-space: nowrap;
    text-overflow: ellipsis;

    color: #172033;

    transition: color 0.2s ease;
  }

  .tool-content p {
    margin: 0;

    overflow: hidden;

    font-size: 11px;

    line-height: 1.6;

    white-space: nowrap;
    text-overflow: ellipsis;

    color: #7b8798;
  }

  :global(html.dark) .tool-content h3,
  :global(html[data-theme="dark"]) .tool-content h3 {
    color: #f1f5f9;
  }

  :global(html.dark) .tool-content p,
  :global(html[data-theme="dark"]) .tool-content p {
    color: #8fa0b5;
  }

  /* =========================================================
     ARROW
     ========================================================= */

  .tool-arrow {
    display: grid;
    place-items: center;

    color: #a0aec0;

    transition:
      transform 0.22s ease,
      color 0.22s ease;
  }

  .tool-arrow svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke: currentColor;

    stroke-width: 2;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-card:hover .tool-arrow {
    color: var(--accent);

    transform: translateX(-3px);
  }

  :global(html.dark) .tool-arrow,
  :global(html[data-theme="dark"]) .tool-arrow {
    color: #64748b;
  }

  /* =========================================================
     INFO CARD
     ========================================================= */

  .info-card {
    display: flex;
    align-items: center;

    gap: 18px;

    margin-top: 24px;

    padding: 22px 24px;

    border: 1px solid #e2e8f0;

    border-radius: 20px;

    background: #ffffff;

    box-shadow:
      0 8px 25px rgba(15, 23, 42, 0.04);

    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .info-icon {
    flex: 0 0 48px;

    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 14px;

    color: #0284c7;

    background: rgba(14, 165, 233, 0.09);
  }

  .info-icon svg {
    width: 24px;
    height: 24px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .info-card span {
    display: block;

    margin-bottom: 3px;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.2px;

    color: #0284c7;
  }

  .info-card h3 {
    margin: 0 0 3px;

    font-size: 15px;
    font-weight: 800;

    color: #172033;
  }

  .info-card p {
    margin: 0;

