<html lang="ar" dir="rtl"><head>
  <meta charset="UTF-8" /><meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

  <title>أدوات المطورين | Th.Tech</title><meta
name="description"
content="مجموعة احترافية من أدوات المطورين والمبرمجين المجانية."
/>

<meta
name="robots"
content="index, follow"
/>

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />  <link
    rel="icon"
    type="image/png"
    href={`${base}/logo1.png`}
  />  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head><body>  <Header />  <main class="page"><section class="hero">

  <div class="badge">
    <span class="pulse"></span>
    TH.TECH · DEVELOPER TOOLBOX
  </div>

  <h1>
    أدوات المطورين
    <strong>في مكان واحد</strong>
  </h1>

  <p>
    مجموعة احترافية من الأدوات المجانية للمطورين والمبرمجين.
    اضغط على أي بطاقة لفتح الأداة مباشرة.
  </p>

  <div class="stats">

    <div>
      <b>{tools.length}</b>
      <span>أداة</span>
    </div>

    <div>
      <b>100%</b>
      <span>مجانية</span>
    </div>

    <div>
      <b>0</b>
      <span>تسجيل مطلوب</span>
    </div>

  </div>

</section>


<section class="tools-section">

  <div class="section-head">

    <div>
      <small>DEVELOPER TOOLS</small>
      <h2>جميع الأدوات</h2>
    </div>

    <span class="count">
      {tools.length} أداة
    </span>

  </div>


  <div class="tools-grid">

    {
      tools.map((tool) => (
        <a
          class={`tool-card ${tool.color}`}
          href={`${base}/tools/${tool.slug}/`}
        >

          <div class="icon">
            <span>{tool.icon}</span>
          </div>

          <div class="content">

            <span class="english">
              {tool.name}
            </span>

            <h3>
              {tool.name}
            </h3>

            <p>
              {tool.ar}
            </p>

          </div>

          <span class="arrow">
            ‹
          </span>

        </a>
      ))
    }

  </div>

</section>

  </main>  <Footer /></body></html><style>

:root {
  --bg: #f5f8fc;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(37, 99, 235, 0.12),
      transparent 42%
    ),
    var(--bg);

  color: var(--text);

  font-family: "Cairo", sans-serif;
}

.page {
  width: min(1180px, calc(100% - 30px));

  margin: auto;

  padding: 35px 0 75px;
}


/* HERO */

.hero {
  text-align: center;

  padding: 25px 10px 50px;
}

.badge {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 8px 14px;

  border: 1px solid rgba(37, 99, 235, 0.15);

  border-radius: 999px;

  background: rgba(37, 99, 235, 0.06);

  color: #2563eb;

  font: 700 9px "Fira Code", monospace;

  letter-spacing: 0.7px;
}

.pulse {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #22c55e;

  animation: pulse 2s infinite;
}

.hero h1 {
  margin-top: 20px;

  font-size: clamp(30px, 5vw, 48px);

  line-height: 1.3;

  font-weight: 800;
}

.hero h1 strong {
  display: block;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed
    );

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;
}

.hero p {
  max-width: 650px;

  margin: 12px auto 0;

  color: var(--muted);

  font-size: 13px;
}


/* STATS */

.stats {
  display: flex;

  justify-content: center;

  gap: 9px;

  margin-top: 25px;
}

.stats div {
  min-width: 100px;

  padding: 9px 14px;

  border: 1px solid var(--border);

  border-radius: 13px;

  background: rgba(255, 255, 255, 0.9);

  box-shadow:
    0 5px 20px rgba(15, 23, 42, 0.035);
}

.stats b,
.stats span {
  display: block;
}

.stats b {
  color: #2563eb;

  font-size: 17px;
}

.stats span {
  color: var(--muted);

  font-size: 9px;
}


/* SECTION */

.section-head {
  display: flex;

  justify-content: space-between;

  align-items: end;

  margin-bottom: 18px;
}

.section-head small {
  color: #2563eb;

  font: 800 9px "Fira Code", monospace;

  letter-spacing: 1px;
}

.section-head h2 {
  margin-top: 2px;

  font-size: 24px;

  font-weight: 800;
}

.count {
  padding: 6px 11px;

  border-radius: 8px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 10px;

  font-weight: 800;
}


/* GRID */

.tools-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 13px;
}


/* CARD */

.tool-card {
  position: relative;

  display: flex;

  align-items: center;

  gap: 12px;

  min-height: 106px;

  padding: 14px;

  overflow: hidden;

  color: var(--text);

  text-decoration: none;

  border: 1px solid var(--border);

  border-radius: 20px;

  background: rgba(255, 255, 255, 0.96);

  box-shadow:
    0 5px 18px rgba(15, 23, 42, 0.035);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.tool-card::before {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  left: -60px;
  top: -60px;

  border-radius: 50%;

  background: currentColor;

  opacity: 0.05;

  transition: transform 0.45s ease;
}

.tool-card:hover {
  transform: translateY(-5px);

  border-color: currentColor;

  box-shadow:
    0 18px 40px rgba(15, 23, 42, 0.11);
}

.tool-card:hover::before {
  transform: scale(2.7);
}


/* ICON */

.icon {
  position: relative;

  z-index: 1;

  flex: none;

  width: 56px;
  height: 56px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 17px;

  background: currentColor;

  color: #ffffff;

  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.13);

  transition:
    transform 0.3s ease;
}

.icon span {
  max-width: 48px;

  overflow: hidden;

  font:
    800 11px
    "Fira Code",
    monospace;

  text-align: center;

  white-space: nowrap;
}

.tool-card:hover .icon {
  transform:
    rotate(-5deg)
    scale(1.08);
}


/* CONTENT */

.content {
  position: relative;

  z-index: 1;

  min-width: 0;

  flex: 1;
}

.english {
  display: block;

  overflow: hidden;

  color: var(--muted);

  font:
    600 8px
    "Fira Code",
    monospace;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.content h3 {
  margin-top: 1px;

  font-size: 13px;

  font-weight: 800;
}

.content p {
  margin-top: 2px;

  overflow: hidden;

  color: var(--muted);

  font-size: 9px;

  text-overflow: ellipsis;

  white-space: nowrap;
}


/* ARROW */

.arrow {
  position: relative;

  z-index: 1;

  flex: none;

  width: 27px;
  height: 27px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    rgba(100, 116, 139, 0.08);

  color: var(--muted);

  font-size: 23px;

  line-height: 1;

  transition: 0.25s ease;
}

.tool-card:hover .arrow {
  transform: translateX(-4px);

  background: currentColor;

  color: #ffffff;
}


/* COLORS */

.blue {
  color: #2563eb;
}

.green {
  color: #16a34a;
}

.orange {
  color: #ea580c;
}

.yellow {
  color: #ca8a04;
}

.purple {
  color: #9333ea;
}

.cyan {
  color: #0891b2;
}

.indigo {
  color: #4f46e5;
}

.violet {
  color: #7c3aed;
}

.red {
  color: #dc2626;
}

.pink {
  color: #db2777;
}


/* ANIMATION */

@keyframes pulse {

  0%,
  100% {
    box-shadow:
      0 0 0 5px
      rgba(34, 197, 94, 0.10);
  }

  50% {
    box-shadow:
      0 0 0 9px
      rgba(34, 197, 94, 0.02);
  }

}


/* TABLET */

@media (max-width: 900px) {

  .tools-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media (max-width: 600px) {

  .page {
    width: calc(100% - 14px);

    padding-top: 20px;
  }

  .hero {
    padding: 15px 5px 35px;
  }

  .hero h1 {
    font-size: 29px;
  }

  .hero p {
    font-size: 11px;
  }

  .stats {
    gap: 5px;
  }

  .stats div {
    min-width: 0;

    flex: 1;

    padding: 8px 4px;
  }

  .stats b {
    font-size: 14px;
  }

  .stats span {
    font-size: 8px;
  }

  .section-head h2 {
    font-size: 20px;
  }

  /* عمودان للهاتف */

  .tools-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .tool-card {
    min-height: 122px;

    padding: 10px 6px;

    flex-direction: column;

    justify-content: center;

    text-align: center;

    gap: 6px;

    border-radius: 18px;
  }

  .icon {
    width: 48px;
    height: 48px;

    border-radius: 15px;
  }

  .icon span {
    font-size: 10px;
  }

  .english {
    font-size: 6.5px;
  }

  .content h3 {
    font-size: 11px;
  }

  .content p {
    display: none;
  }

  .arrow {
    position: absolute;

    top: 6px;
    left: 6px;

    width: 19px;
    height: 19px;

    font-size: 16px;
  }

}

</style>
