:root {
  --bg: #f5f8fc;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(37, 99, 235, .12),
      transparent 42%
    ),
    var(--bg);
  color: var(--text);
  font-family: "Cairo", sans-serif;
}

.page {
  width: min(1180px, calc(100% - 30px));
  margin: auto;
  padding: 35px 0 75px;
}

.hero {
  text-align: center;
  padding: 25px 10px 50px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border: 1px solid rgba(37, 99, 235, .15);
  border-radius: 999px;
  background: rgba(37, 99, 235, .06);
  color: #2563eb;
  font: 700 9px "Fira Code", monospace;
}

.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  animation: pulse 2s infinite;
}

.hero h1 {
  margin-top: 20px;
  font-size: clamp(30px, 5vw, 48px);
  line-height: 1.3;
  font-weight: 800;
}

.hero h1 strong {
  display: block;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

