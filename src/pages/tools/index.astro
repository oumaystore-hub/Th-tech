{ name: 'XML Formatter', ar: 'تنسيق XML', slug: 'xml-formatter', icon: 'XML', color: 'orange' },
{ name: 'XML Validator', ar: 'التحقق من XML', slug: 'xml-validator', icon: '✓', color: 'green' },

