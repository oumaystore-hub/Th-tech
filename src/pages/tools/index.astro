      inset 0 1px 0 rgba(255,255,255,.35);
    animation: heroFloat 4s ease-in-out infinite;
  }

  .hero-icon svg {
    width: 42px;
    height: 42px;
    fill: none;
    stroke: white;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-text {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-label {
    display: block;
    color: #2563eb;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    margin: 4px 0 7px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.2;
    font-weight: 800;
  }

  .hero p {
    max-width: 680px;
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.9;
  }

  :global(html.dark) .hero p,
  :global(body.dark) .hero p {
    color: #94a3b8;
  }

  .tools-section {
    margin-top: 20px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .section-head h2 {
    margin: 4px 0 0;
    font-size: 23px;
    font-weight: 800;
  }

  .count-box {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #64748b;
    font-size: 11px;
  }

  .count-box strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 30px;
    padding: 0 9px;
    border-radius: 10px;
    background: #eaf1ff;
    color: #2563eb;
    font-size: 12px;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tool-card {
    --accent: #2563eb;
    --soft: #eaf1ff;

    position: relative;
    min-height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 19px;
    border: 1px solid #e2e8f0;
    border-radius: 26px;
    background: rgba(255,255,255,.96);
    color: #0f172a;
    text-decoration: none;
    box-shadow:
      0 9px 28px rgba(15,23,42,.055),
      inset 0 1px 0 rgba(255,255,255,.95);
    isolation: isolate;
    transition:
      transform .28s cubic-bezier(.2,.8,.2,1),
      box-shadow .28s ease,
      border-color .28s ease;
  }

  :global(html.dark) .tool-card,
  :global(body.dark) .tool-card {
    background: #101827;
    border-color: rgba(148,163,184,.12);
    color: #f8fafc;
    box-shadow: 0 12px 35px rgba(0,0,0,.18);
  }

  .tool-card::before {
    content: "";
    position: absolute;
    width: 115px;
    height: 115px;
    top: -60px;
    left: -50px;
    border-radius: 35px;
    transform: rotate(25deg);
    background: var(--soft);
    opacity: .8;
    z-index: -1;
  }

  .tool-card::after {
    content: "";
    position: absolute;
    width: 75px;
    height: 75px;
    right: -30px;
    bottom: -35px;
    border-radius: 24px;
    transform: rotate(25deg);
    border: 1px solid var(--accent);
    opacity: .07;
    z-index: -1;
  }

  .tool-card:hover {
    transform: translateY(-7px);
    border-color: color-mix(in srgb, var(--accent) 30%, #e2e8f0);
    box-shadow:
      0 20px 45px rgba(15,23,42,.12),
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .tool-card:active {
    transform: translateY(-2px) scale(.985);
  }

  .card-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    top: -45px;
    right: -45px;
    border-radius: 50%;
    background: var(--accent);
    opacity: .035;
    transition: transform .35s ease, opacity .35s ease;
  }

  .tool-card:hover .card-glow {
    transform: scale(2.1);
    opacity: .07;
  }

  .tool-number {
    position: absolute;
    top: 12px;
    left: 15px;
    color: #cbd5e1;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .5px;
  }

  :global(html.dark) .tool-number,
  :global(body.dark) .tool-number {
    color: #334155;
  }

  .tool-icon {
    position: relative;
    z-index: 2;
    width: 53px;
    height: 53px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 13px;
    border-radius: 18px;
    background: var(--soft);
    color: var(--accent);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
    transition:
      transform .3s ease,
      border-radius .3s ease;
  }

  .tool-card:hover .tool-icon {
    transform: rotate(-5deg) scale(1.08);
    border-radius: 15px;
  }

  .tool-icon svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-info {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding-right: 2px;
  }

  .tool-info h3 {
    margin: 0;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-info p {
    margin: 4px 0 0;
    overflow: hidden;
    color: #64748b;
    font-size: 10px;
    line-height: 1.7;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(html.dark) .tool-info p,
  :global(body.dark) .tool-info p {
    color: #94a3b8;
  }

  .tool-arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 29px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #f1f5f9;
    color: #64748b;
    opacity: .75;
    transition:
      background .25s ease,
      color .25s ease,
      transform .25s ease;
  }

  :global(html.dark) .tool-arrow,
  :global(body.dark) .tool-arrow {
    background: #172235;
    color: #94a3b8;
  }

  .tool-arrow svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-card:hover .tool-arrow {
    background: var(--accent);
    color: white;
    opacity: 1;
    transform: translateX(-4px);
  }

  .blue {
    --accent: #2563eb;
    --soft: #eaf1ff;
  }

  .green {
    --accent: #16a34a;
    --soft: #eaf9ef;
  }

  .orange {
