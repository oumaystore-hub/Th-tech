</style>


<script>
  const searchInput = document.querySelector('#toolSearch') as HTMLInputElement | null;
  const searchBox = document.querySelector('.search-box');
  const clearSearch = document.querySelector('#clearSearch') as HTMLButtonElement | null;

  const cards = Array.from(
    document.querySelectorAll('.tool-card')
  ) as HTMLElement[];

  const categoryButtons = Array.from(
    document.querySelectorAll('.category-btn')
  ) as HTMLButtonElement[];

  const countElement = document.querySelector('#toolCount');
  const resultText = document.querySelector('#resultText');
  const emptyState = document.querySelector('#emptyState');
  const resetFilters = document.querySelector('#resetFilters');

  let activeCategory = 'all';


  function normalize(value: string) {
    return value
      .toLowerCase()
      .trim()
      .replace(/\s+/g, ' ');
  }


  function updateTools() {

    const query = normalize(searchInput?.value || '');

    let visibleCount = 0;

    cards.forEach((card) => {

      const name = normalize(card.dataset.name || '');
      const description = normalize(card.dataset.description || '');
      const category = card.dataset.category || '';

      const matchesSearch =
        !query ||
        name.includes(query) ||
        description.includes(query);

      const matchesCategory =
        activeCategory === 'all' ||
        category === activeCategory;

      const visible =
        matchesSearch &&
        matchesCategory;

      card.hidden = !visible;

      if (visible) {
        visibleCount++;
      }
    });


    if (countElement) {
      countElement.textContent = String(visibleCount);
    }


    if (searchBox) {
      searchBox.classList.toggle(
        'has-value',
        query.length > 0
      );
    }


    if (resultText) {

      if (query && activeCategory !== 'all') {
        resultText.textContent =
          `نتائج البحث في ${getCategoryLabel(activeCategory)}`;

      } else if (query) {
        resultText.textContent =
          `نتائج البحث عن: ${searchInput?.value}`;

      } else if (activeCategory !== 'all') {
        resultText.textContent =
          `عرض أدوات ${getCategoryLabel(activeCategory)}`;

      } else {
        resultText.textContent =
          'عرض جميع الأدوات';
      }
    }


    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }

  }


  function getCategoryLabel(category: string) {

    const button = categoryButtons.find(
      (item) => item.dataset.category === category
    );

    return button?.textContent?.trim() || category;
  }


  categoryButtons.forEach((button) => {

    button.addEventListener('click', () => {

      activeCategory =
        button.dataset.category || 'all';

      categoryButtons.forEach((item) => {
        item.classList.toggle(
          'active',
          item === button
        );
      });

      updateTools();

    });

  });


  searchInput?.addEventListener('input', updateTools);


  clearSearch?.addEventListener('click', () => {

    if (!searchInput) return;

    searchInput.value = '';
    searchInput.focus();

    updateTools();

  });


  resetFilters?.addEventListener('click', () => {

    activeCategory = 'all';

    if (searchInput) {
      searchInput.value = '';
    }

    categoryButtons.forEach((button) => {

      button.classList.toggle(
        'active',
        button.dataset.category === 'all'
      );

    });

    updateTools();

  });


  updateTools();
</script>
