  margin: auto;

  padding:
    55px 0 80px;

}


/* =========================
   HERO
========================= */

.hero {

  text-align: center;

  max-width: 850px;

  margin:
    0 auto 45px;

}


.hero-badge {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding:
    6px 13px;

  border:
    1px solid rgba(37, 99, 235, .16);

  border-radius: 50px;

  background:
    rgba(37, 99, 235, .07);

  color: var(--primary);

  font-family:
    "Fira Code",
    monospace;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .7px;

  animation:
    badgeFloat 3s ease-in-out infinite;

}


.pulse {

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 0 rgba(34, 197, 94, .5);

  animation:
    pulse 2s infinite;

}


.hero h1 {

  margin-top: 17px;

  font-size: clamp(
    32px,
    5vw,
    48px
  );

  line-height: 1.25;

  font-weight: 800;

  letter-spacing: -.8px;

}


.hero h1 span {

  display: block;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #06b6d4,
      #7c3aed
    );

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;

}


.hero > p {

  max-width: 650px;

  margin:
    15px auto 0;

  color: var(--muted);

  font-size: 14px;

}


.hero-stats {

  display: flex;

  justify-content: center;

  gap: 10px;

  margin-top: 25px;

}


.hero-stats div {

  min-width: 105px;

  padding:
    9px 16px;

  border:
    1px solid var(--border);

  border-radius: 13px;

  background:
    rgba(255,255,255,.75);

  backdrop-filter:
    blur(10px);

}


.hero-stats strong {

  display: block;

  color: var(--primary);

  font-size: 16px;

  font-weight: 800;

}


.hero-stats span {

  color: var(--muted);

  font-size: 9px;

}


/* =========================
   CONTROLS
========================= */

.controls {

  margin-bottom: 38px;

}


.search-box {

  position: relative;

  max-width: 650px;

  margin: auto;

}


.search-box svg {

  position: absolute;

  right: 16px;
  top: 50%;

  width: 19px;
  height: 19px;

  transform:
    translateY(-50%);

  fill: none;

  stroke:
    #94a3b8;

  stroke-width: 1.7;

  stroke-linecap: round;

}


.search-box input {

  width: 100%;

  height: 52px;

  padding:
    0 48px 0 55px;

  border:
    1px solid var(--border);

  border-radius: 15px;

  outline: none;

  background: var(--card);

  color: var(--text);

  font-family: inherit;

  font-size: 12px;

  box-shadow:
    0 8px 30px
    rgba(15, 23, 42, .04);

  transition:
    .25s ease;

}


.search-box input:focus {

  border-color:
    rgba(37, 99, 235, .55);

  box-shadow:
    0 10px 35px
    rgba(37, 99, 235, .10);

}


.search-box span {

  position: absolute;

  left: 12px;
  top: 50%;

  transform:
    translateY(-50%);

  min-width: 30px;

  height: 27px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 8px;

  background:
    #eff6ff;

  color:
    var(--primary);

  font-family:
    "Fira Code",
    monospace;

  font-size: 9px;

  font-weight: 700;

}


.categories {

  display: flex;

  justify-content: center;

  gap: 7px;

  flex-wrap: wrap;

  margin-top: 17px;

}


.categories button {

  padding:
    6px 12px;

  border:
    1px solid var(--border);

  border-radius: 50px;

  background: var(--card);

  color: var(--muted);

  font-family: inherit;

  font-size: 10px;

  cursor: pointer;

  transition:
    .2s ease;

}


.categories button:hover {

  color: var(--primary);

  border-color:
    rgba(37, 99, 235, .3);

  transform:
    translateY(-2px);

}


.categories button.active {

  background:
    var(--primary);

  border-color:
    var(--primary);

  color: white;

  box-shadow:
    0 5px 15px
    rgba(37, 99, 235, .20);

}


/* =========================
   HEADING
========================= */

.section-heading {

  display: flex;

  align-items: end;

  gap: 20px;

  margin-bottom: 18px;

}


.section-heading span {

  color: var(--primary);

  font-family:
    "Fira Code",
    monospace;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 1px;

}


.section-heading h2 {

  font-size: 21px;

  font-weight: 800;

}


.section-heading .line {

  flex: 1;

  height: 1px;

  margin-bottom: 7px;

  background:
    var(--border);

}


/* =========================
   GRID
========================= */

.tools-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 13px;

}


/* =========================
   CARD
========================= */

.tool-card {

  position: relative;

  min-height: 138px;

  display: flex;

  align-items: center;

  gap: 13px;

  overflow: hidden;

  padding: 17px;

  border:
    1px solid var(--border);

  border-radius: 20px;

  background:
    rgba(255,255,255,.88);

  color: var(--text);

  text-decoration: none;

  isolation: isolate;

  opacity: 0;

  transform:
    translateY(18px)
    scale(.98);

  transition:
    transform .35s cubic-bezier(.2,.8,.2,1),
    border-color .25s ease,
    box-shadow .35s ease,
    background .25s ease;

  transition-delay:
    var(--delay);

}


.tool-card.visible {

  opacity: 1;

  transform:
    translateY(0)
    scale(1);

}


.tool-card:hover {

  z-index: 2;

  transform:
    translateY(-6px)
    scale(1.015);

  border-color:
    color-mix(
      in srgb,
      var(--tool-color) 35%,
      var(--border)
    );

  box-shadow:
    0 18px 45px
    rgba(15, 23, 42, .10);

}


.tool-card.pressed {

  transform:
    scale(.97);

}


.card-glow {

  position: absolute;

  width: 130px;
  height: 130px;

  right: -55px;
  top: -55px;

  border-radius: 50%;

  background:
    var(--tool-color);

  opacity: .055;

  filter:
    blur(5px);

  transition:
    .4s ease;

  z-index: -1;

}


.tool-card:hover .card-glow {

  width: 220px;
  height: 220px;

  opacity: .12;

}


/* =========================
   ICON
========================= */

.tool-icon {

  width: 55px;
  height: 55px;

  min-width: 55px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 17px;

  background:
    color-mix(
      in srgb,
      var(--tool-color) 10%,
      white
    );

  color:
    var(--tool-color);

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}


.tool-icon svg {

  width: 26px;
  height: 26px;

}


.tool-card:hover .tool-icon {

  transform:
    rotate(-5deg)
    scale(1.1);

  box-shadow:
    0 9px 20px
    color-mix(
      in srgb,
      var(--tool-color) 17%,
      transparent
