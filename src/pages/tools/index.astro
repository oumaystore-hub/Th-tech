const toolCount = tools.length;

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head><body>
  <Header />  <main class="page"><section class="hero">
  <div class="badge">
    <span class="pulse"></span>
    TH.TECH · DEVELOPER TOOLBOX
  </div>

  <h1>
    أدوات المطورين
    <strong>في مكان واحد</strong>
  </h1>

  <p>
    أدوات مجانية وسريعة للمبرمجين والمطورين.
    اختر الأداة واضغط عليها للبدء مباشرة.
  </p>

  <div class="stats">
    <div>
      <b>{toolCount}+</b>
      <span>أداة</span>
    </div>

    <div>
      <b>100%</b>
      <span>مجانية</span>
    </div>

    <div>
      <b>0</b>
      <span>تسجيل مطلوب</span>
    </div>
  </div>
</section>

<section class="tools-section">

  <div class="section-head">
    <div>
      <small>DEVELOPER TOOLS</small>
      <h2>جميع الأدوات</h2>
    </div>

    <span class="count">{toolCount} أداة</span>
  </div>

  <div class="tools-grid">
    {tools.map((tool, index) => (
      <a
        href={`${base}/tools/${tool[0]}/`}
        class={`tool-card ${tool[4]}`}
        style={`--delay:${Math.min(index * 0.018, 0.8)}s`}
      >
        <div class="icon">
          <span>{tool[5]}</span>
        </div>

        <div class="content">
          <span class="english">{tool[1]}</span>
          <h3>{tool[2]}</h3>
          <p>{tool[3]}</p>
        </div>

        <span class="arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </span>
      </a>
    ))}
  </div>

</section>

  </main>  <Footer />
</body>
</html><style>
:root {
  --bg: #f5f8fc;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --primary: #2563eb;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(37, 99, 235, .10),
      transparent 38%
    ),
    var(--bg);
  color: var(--text);
  font-family: "Cairo", sans-serif;
}

.page {
  width: min(1180px, calc(100% - 30px));
  margin: auto;
  padding: 45px 0 80px;
}

/* HERO */

.hero {
  padding: 25px 10px 55px;
  text-align: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 8px 14px;
  border: 1px solid rgba(37, 99, 235, .15);
  border-radius: 999px;
  background: rgba(37, 99, 235, .06);
  color: var(--primary);
  font: 700 9px "Fira Code", monospace;
  letter-spacing: .7px;
}

.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 5px rgba(34,197,94,.10);
  animation: pulse 2s infinite;
}

.hero h1 {
  margin-top: 20px;
  font-size: clamp(30px, 5vw, 48px);
  font-weight: 800;
  line-height: 1.3;
}

.hero h1 strong {
  display: block;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero > p {
  max-width: 650px;
  margin: 12px auto 0;
  color: var(--muted);
  font-size: 13px;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 27px;
}

.stats div {
  min-width: 100px;
  padding: 9px 15px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: rgba(255,255,255,.85);
}

.stats b,
.stats span {
  display: block;
}

.stats b {
  color: var(--primary);
  font-size: 17px;
  line-height: 1.3;
}

.stats span {
  color: var(--muted);
  font-size: 9px;
}

/* SECTION */

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-head small {
  color: var(--primary);
  font: 800 9px "Fira Code", monospace;
  letter-spacing: 1px;
}

.section-head h2 {
  margin-top: 2px;
  font-size: 24px;
  font-weight: 800;
}

.count {
  padding: 6px 11px;
  border-radius: 8px;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 10px;
  font-weight: 800;
}

/* GRID */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
}

/* CARD */

.tool-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 106px;
  padding: 14px;

  overflow: hidden;

  color: var(--text);
  text-decoration: none;

  border: 1px solid var(--border);
  border-radius: 20px;
  background: rgba(255,255,255,.94);

  box-shadow:
    0 5px 18px rgba(15,23,42,.035);

  opacity: 0;

  animation:
    cardIn .5s cubic-bezier(.2,.8,.2,1)
    forwards;

  animation-delay: var(--delay);

  transition:
    transform .25s ease,
    border-color .25s ease,
    box-shadow .25s ease;
}

.tool-card::before {
  content: "";
  position: absolute;
  width: 100px;
  height: 100px;
  top: -50px;
  left: -50px;
  border-radius: 50%;
  background: currentColor;
  opacity: .045;
  transition: transform .4s ease;
}

.tool-card:hover {
  transform: translateY(-5px);
  border-color: currentColor;
  box-shadow:
    0 16px 35px rgba(15,23,42,.09);
}

.tool-card:hover::before {
  transform: scale(2.5);
}

/* ICON */

.icon {
  position: relative;
  z-index: 1;

  flex: none;

  width: 56px;
  height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 17px;

  background: currentColor;
  color: #fff;

  box-shadow:
    0 8px 18px rgba(15,23,42,.13);

  transition:
    transform .3s ease;
}

.icon span {
  max-width: 48px;
  overflow: hidden;
  font-family: "Fira Code", monospace;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.tool-card:hover .icon {
  transform:
    rotate(-5deg)
    scale(1.08);
}

/* CONTENT */

.content {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.english {
  display: block;
  overflow: hidden;
  color: var(--muted);
  font: 600 8px "Fira Code", monospace;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content h3 {
  margin-top: 1px;
  font-size: 13px;
  font-weight: 800;
}

.content p {
  margin-top: 2px;
  overflow: hidden;
  color: var(--muted);
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ARROW */

.arrow {
  position: relative;
  z-index: 2;

  flex: none;

  width: 25px;
  height: 25px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(100,116,139,.08);
  color: var(--muted);

  transition:
    transform .25s ease,
    background .25s ease,
    color .25s ease;
}

.arrow svg {
  width: 13px;
  height: 13px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tool-card:hover .arrow {
  transform: translateX(-4px);
  background: currentColor;
  color: #fff;
}

/* COLORS */

.blue {
  color: #2563eb;
}

.green {
  color: #16a34a;
}

.orange {
  color: #ea580c;
}

.yellow {
  color: #ca8a04;
}

.purple {
  color: #9333ea;
}

.cyan {
  color: #0891b2;
}

.indigo {
  color: #4f46e5;
}

.violet {
  color: #7c3aed;
}

.red {
  color: #dc2626;
}

.pink {
  color: #db2777;
}

/* ANIMATION */

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(18px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes pulse {
  0%,
  100% {
    box-shadow:
      0 0 0 5px rgba(34,197,94,.10);
  }

  50% {
    box-shadow:
      0 0 0 9px rgba(34,197,94,.02);
  }
}

/* TABLET */

@media (max-width: 900px) {
  .tools-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */

@media (max-width: 600px) {
  .page {
    width: calc(100% - 14px);
    padding-top: 22px;
  }

  .hero {
    padding: 15px 5px 35px;
  }

  .hero h1 {
    font-size: 29px;
  }

  .hero > p {
    font-size: 11px;
  }

  .stats {
    gap: 5px;
  }

  .stats div {
    min-width: 0;
    flex: 1;
    padding: 8px 4px;
  }

  .stats b {
    font-size: 14px;
  }

  .stats span {
    font-size: 8px;
  }

  .section-head h2 {
    font-size: 20px;
  }

  .tools-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tool-card {
    min-height: 119px;
    padding: 10px 7px;

    flex-direction: column;
    justify-content: center;
    text-align: center;

    gap: 6px;
    border-radius: 18px;
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 15px;
