const categoryLabels: Record<string, string> = {
  All: 'الكل',
  JSON: 'JSON',
  HTML: 'HTML',
  CSS: 'CSS',
  JavaScript: 'JavaScript',
  SQL: 'SQL',
  'YAML / XML': 'YAML / XML',
  'Encoding / Security': 'Encoding / Security',
  'Date / Time': 'Date / Time',
  Colors: 'الألوان',
  Text: 'النصوص',
  'Markdown / Binary': 'Markdown / Binary',
  'Regex / Network': 'Regex / Network',
  Other: 'أخرى'
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>أدوات المطورين | Th.Tech</title>

    <meta
      name="description"
      content="مجموعة احترافية من أدوات المطورين لتنسيق وتحويل وفحص JSON وHTML وCSS وJavaScript وSQL والنصوص والمزيد."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/`}
    />

    <link rel="icon" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="tools-page">

      <!-- =========================
           HERO
      ========================== -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <span>أدوات المطورين</span>
          </div>

          <div class="hero-card">

            <div class="hero-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 5h16v14H4z"></path>
                <path d="M7 9h10"></path>
                <path d="M7 13h7"></path>
                <path d="M7 17h4"></path>
                <path d="m16 15 2 2 3-4"></path>
              </svg>
            </div>

            <div class="hero-content">
              <span class="eyebrow">TH.TECH TOOLBOX</span>

              <h1>أدوات المطورين</h1>

              <p>
                مجموعة متكاملة من الأدوات التقنية السريعة لتنسيق الأكواد،
                تحويل البيانات، اختبارها، تحليلها وإنجاز مهام التطوير اليومية.
              </p>

              <div class="hero-stats">
                <div class="hero-stat">
                  <strong>{tools.length}</strong>
                  <span>أداة</span>
                </div>

                <div class="hero-stat">
                  <strong>{categories.length - 1}</strong>
                  <span>تصنيف</span>
                </div>

                <div class="hero-stat">
                  <strong>100%</strong>
                  <span>سريعة</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>


      <!-- =========================
           TOOLS
      ========================== -->
      <section class="tools-section">
        <div class="container">

          <div class="section-heading">

            <div>
              <span class="section-label">DEVELOPER TOOLS</span>

              <h2>جميع الأدوات</h2>

              <p>
                ابحث عن الأداة التي تحتاجها أو اختر تصنيفًا للوصول إليها بسرعة.
              </p>
            </div>

            <div class="tools-count">
              <span id="visibleCount">{tools.length}</span>
              <small>أداة</small>
            </div>

          </div>


          <!-- =========================
               SEARCH
          ========================== -->
          <div class="tools-controls">

            <div class="search-box">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
              </svg>

              <input
                id="toolSearch"
                type="search"
                placeholder="ابحث عن أداة... مثال: JSON, CSS, Hash"
                autocomplete="off"
                aria-label="البحث عن أدوات المطورين"
              />

              <button
                id="clearSearch"
                class="clear-search"
                type="button"
                aria-label="مسح البحث"
                title="مسح البحث"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m7 7 10 10"></path>
                  <path d="m17 7-10 10"></path>
                </svg>
              </button>

            </div>


            <!-- =========================
                 FAVORITES
            ========================== -->
            <button
              id="favoritesToggle"
              class="favorites-toggle"
              type="button"
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 4 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 18l-5.6 2.2 1.1-6.2L3 9.6l6.2-.9z"></path>
              </svg>

              <span>المفضلة</span>

              <b id="favoriteCount">0</b>
            </button>

          </div>


          <!-- =========================
               CATEGORIES
          ========================== -->
          <div class="categories-wrap">

            <div class="categories-label">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16"></path>
                <path d="M7 12h10"></path>
                <path d="M10 18h4"></path>
              </svg>

              <span>التصنيفات</span>
            </div>

            <div
              class="categories"
              id="categories"
              role="tablist"
              aria-label="تصنيفات الأدوات"
            >
              {categories.map((category) => (
                <button
                  class:list={[
                    'category-btn',
                    category === 'All' && 'active'
                  ]}
                  type="button"
                  data-category={category}
                  role="tab"
                  aria-selected={category === 'All'}
                >
                  {categoryLabels[category] ?? category}
                  <span>
                    {category === 'All'
                      ? tools.length
                      : tools.filter((tool) => tool.cat === category).length}
                  </span>
                </button>
              ))}
            </div>

          </div>


          <!-- =========================
               TOOLS GRID
          ========================== -->
          <div class="tools-grid" id="toolsGrid">

            {tools.map((tool, index) => (
              <div
                class={`tool-card-wrap tool-${tool.color}`}
                data-tool-card
                data-name={tool.name.toLowerCase()}
                data-desc={tool.desc.toLowerCase()}
                data-category={tool.cat}
                data-slug={tool.slug}
              >

                <a
                  class="tool-card"
                  href={`${base}/tools/${tool.slug}/`}
                  aria-label={`${tool.name} - ${tool.desc}`}
                >

                  <div class="tool-number">
                    {String(index + 1).padStart(2, '0')}
                  </div>

                  <div class="tool-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      {(iconPaths[tool.icon] ?? iconPaths.code).map((path) => (
                        <path d={path}></path>
                      ))}
                    </svg>
                  </div>

                  <div class="tool-content">

                    <div class="tool-top">
                      <span class="tool-category">
                        {categoryLabels[tool.cat] ?? tool.cat}
                      </span>
                    </div>

                    <h3>{tool.name}</h3>

                    <p>{tool.desc}</p>

                  </div>

                  <div class="tool-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="m9 5 7 7-7 7"></path>
                    </svg>
                  </div>

                </a>

                <!-- Favorite button is outside the anchor -->
                <button
                  class="favorite-btn"
                  type="button"
                  data-favorite={tool.slug}
                  aria-label={`إضافة ${tool.name} إلى المفضلة`}
                  aria-pressed="false"
                  title="إضافة إلى المفضلة"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 4 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 18l-5.6 2.2 1.1-6.2L3 9.6l6.2-.9z"></path>
                  </svg>
                </button>

              </div>
            ))}

          </div>


          <!-- =========================
               EMPTY STATE
          ========================== -->
          <div class="empty-state" id="emptyState" hidden>

            <div class="empty-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
                <path d="M8 11h6"></path>
              </svg>
            </div>

            <h3>لم يتم العثور على أدوات</h3>

            <p>
              جرّب كلمة بحث مختلفة أو اختر تصنيفًا آخر.
            </p>

            <button id="resetFilters" type="button">
              إعادة ضبط البحث والتصنيفات
            </button>

          </div>


          <!-- =========================
               INFO
          ========================== -->
          <div class="info-card">

            <div class="info-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"></path>
                <path d="M12 10v6"></path>
                <path d="M12 7h.01"></path>
              </svg>
            </div>

            <div>
              <span>TH.TECH</span>

              <h3>أدوات تقنية في مكان واحد</h3>

              <p>
                احفظ الأدوات التي تستخدمها باستمرار في المفضلة للوصول إليها
                بسرعة في المرات القادمة.
              </p>
            </div>

          </div>

        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: 'Cairo', system-ui, sans-serif;
    background:
      radial-gradient(circle at 10% 5%, rgba(14, 165, 233, .08), transparent 25%),
      radial-gradient(circle at 90% 15%, rgba(59, 130, 246, .06), transparent 25%),
      #f7fafc;
    color: #0f172a;
    transition:
      background .3s ease,
      color .3s ease;
  }

  :global(html.dark body),
  :global(html[data-theme="dark"] body) {
    background:
      radial-gradient(circle at 10% 5%, rgba(14, 165, 233, .08), transparent 25%),
      radial-gradient(circle at 90% 15%, rgba(59, 130, 246, .07), transparent 25%),
      #07111f;
    color: #e5eef8;
  }

  .container {
    width: min(1380px, calc(100% - 40px));
    margin: auto;
  }

  .tools-page {
    min-height: 100vh;
    overflow: hidden;
  }

  /* =========================
     HERO
  ========================== */

  .hero {
    padding: 28px 0 42px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
  }

  .breadcrumb a {
    color: #0284c7;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  :global(html.dark) .breadcrumb,
  :global(html[data-theme="dark"]) .breadcrumb {
    color: #94a3b8;
  }

  .hero-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 42px;
    border: 1px solid rgba(14, 165, 233, .14);
    border-radius: 28px;
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.96),
        rgba(239,248,255,.92)
      );
    box-shadow:
      0 20px 60px rgba(15, 23, 42, .07),
      inset 0 1px 0 rgba(255,255,255,.8);
  }

  .hero-card::before {
    content: '';
    position: absolute;
    width: 260px;
    height: 260px;
    left: -100px;
    top: -130px;
    border-radius: 50%;
    background: rgba(14,165,233,.08);
    pointer-events: none;
  }

  .hero-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    right: -80px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(59,130,246,.07);
    pointer-events: none;
  }

  :global(html.dark) .hero-card,
  :global(html[data-theme="dark"]) .hero-card {
    background:
      linear-gradient(
        135deg,
        rgba(13, 27, 45, .96),
        rgba(9, 24, 40, .94)
      );
    border-color: rgba(56,189,248,.12);
    box-shadow:
      0 25px 70px rgba(0,0,0,.22),
      inset 0 1px 0 rgba(255,255,255,.025);
  }

  .hero-icon {
    position: relative;
    z-index: 1;
    flex: 0 0 112px;
    width: 112px;
    height: 112px;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background: linear-gradient(135deg, #0284c7, #06b6d4);
    color: white;
    box-shadow:
      0 18px 38px rgba(2,132,199,.24),
      0 0 0 8px rgba(14,165,233,.06);
    animation: floatIcon 4s ease-in-out infinite;
  }

  .hero-icon svg {
    width: 57px;
    height: 57px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes floatIcon {
    0%, 100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    color: #0284c7;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .hero-content h1 {
    margin: 8px 0 10px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.2;
    letter-spacing: -.8px;
  }

  .hero-content p {
    max-width: 760px;
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 2;
  }

  :global(html.dark) .hero-content p,
  :global(html[data-theme="dark"]) .hero-content p {
    color: #94a3b8;
  }

  .hero-stats {
    display: flex;
    gap: 12px;
    margin-top: 23px;
  }

  .hero-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 9px 13px;
    border: 1px solid rgba(14,165,233,.12);
    border-radius: 12px;
    background: rgba(14,165,233,.045);
  }

  .hero-stat strong {
    color: #0284c7;
    font-size: 17px;
  }

  .hero-stat span {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
  }

  /* =========================
     SECTION
  ========================== */

  .tools-section {
    padding: 10px 0 80px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .section-heading h2 {
    margin: 5px 0 4px;
    font-size: 28px;
    letter-spacing: -.4px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
  }

  :global(html.dark) .section-heading p,
  :global(html[data-theme="dark"]) .section-heading p {
    color: #94a3b8;
  }

  .tools-count {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 10px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 13px;
    background: rgba(255,255,255,.8);
    white-space: nowrap;
  }

  :global(html.dark) .tools-count,
  :global(html[data-theme="dark"]) .tools-count {
    background: #0d1b2d;
    border-color: #1e334b;
  }

  .tools-count span {
    color: #0284c7;
    font-size: 20px;
    font-weight: 800;
  }

  .tools-count small {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
  }

  /* =========================
     CONTROLS
  ========================== */

  .tools-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 17px;
  }

  .search-box {
    position: relative;
    flex: 1;
  }

  .search-box > svg {
    position: absolute;
    right: 17px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: #64748b;
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    height: 53px;
    padding: 0 52px 0 48px;
    border: 1px solid #dbe4ed;
    border-radius: 15px;
    outline: none;
    background: rgba(255,255,255,.88);
    color: #0f172a;
    font-family: inherit;
    font-size: 13px;
    transition:
      border .2s ease,
      box-shadow .2s ease,
      background .2s ease;
  }

  .search-box input::placeholder {
    color: #94a3b8;
  }

  .search-box input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 0 4px rgba(14,165,233,.08);
  }

  :global(html.dark) .search-box input,
  :global(html[data-theme="dark"]) .search-box input {
    background: #0b192a;
    border-color: #1e344c;
    color: #e2e8f0;
  }

  .clear-search {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: .2s ease;
  }

  .clear-search.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .clear-search:hover {
    background: #f1f5f9;
    color: #0284c7;
  }

  :global(html.dark) .clear-search:hover,
