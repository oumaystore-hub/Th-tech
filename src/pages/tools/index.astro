---

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(//$/, '');

const title = 'أدوات المطورين | Th.Tech';
const description =
'مجموعة متكاملة من أدوات المطورين المجانية لتنسيق وتحويل والتحقق من الأكواد والبيانات مباشرة من المتصفح.';

const icons = [
'M4 5h16v14H4z M8 9h8 M8 13h5',
'M5 4h14v16H5z M8 8h8 M8 12h8 M8 16h5',
'M4 5h16v14H4z M7 8l3 3-3 3 M12 14h5',
'M6 4h12v16H6z M9 8h6 M9 12h6 M9 16h4',
'M4 6h16v12H4z M7 9h10 M7 12h7 M7 15h4',
'M4 4h16v16H4z M8 8l3 3-3 3 M13 14h4',
'M5 5h14v14H5z M8 9h8 M8 13h8 M8 17h5',
'M4 7h16v10H4z M8 10h8 M8 13h5',
'M6 4h12v16H6z M9 8h6 M9 12h6 M9 16h6',
'M4 4h16v16H4z M7 8h10 M7 12h10 M7 16h6'
];

const tools = [
{ name: 'JSON Formatter', slug: 'json-formatter', desc: 'تنسيق وتجميل JSON', icon: 0, color: 'blue' },
{ name: 'JSON Validator', slug: 'json-validator', desc: 'التحقق من صحة JSON', icon: 1, color: 'green' },
{ name: 'HTML Formatter', slug: 'html-formatter', desc: 'تنسيق HTML وترتيبه', icon: 2, color: 'orange' },
{ name: 'JavaScript Formatter', slug: 'javascript-formatter', desc: 'تنسيق JavaScript', icon: 3, color: 'yellow' },
{ name: 'Word Counter', slug: 'word-counter', desc: 'حساب الكلمات والأحرف', icon: 4, color: 'purple' },

{ name: 'CSS Formatter', slug: 'css-formatter', desc: 'تنسيق CSS', icon: 5, color: 'cyan' },
