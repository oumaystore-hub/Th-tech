<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head><body>
  <Header />  <main class="page"><section class="hero">
  <div class="hero-badge">
    <span></span>
    TH.TECH DEVELOPER TOOLS
  </div>

  <h1>
    أدوات المطورين
    <strong>في مكان واحد</strong>
  </h1>

  <p>
    مجموعة من الأدوات السريعة والمجانية للمبرمجين والمطورين
    تعمل مباشرة من المتصفح.
  </p>

  <div class="hero-stats">
    <div>
      <strong>{tools.length}+</strong>
      <span>أداة</span>
    </div>

    <div>
      <strong>100%</strong>
      <span>مجانية</span>
    </div>

    <div>
      <strong>0</strong>
      <span>رفع للملفات</span>
    </div>
  </div>
</section>

<section class="tools-section">

  <div class="section-heading">
    <div>
      <span>DEVELOPER TOOLBOX</span>
      <h2>جميع الأدوات</h2>
    </div>

    <div class="tool-count">
      {tools.length} أدوات
    </div>
  </div>

  <div class="tools-grid">

    {tools.map((tool, index) => (
      <a
        href={`${base}/tools/${tool.slug}/`}
        class={`tool-card ${tool.color}`}
        style={`--delay:${Math.min(index * 0.025, 0.6)}s`}
        aria-label={`${tool.name} - ${tool.ar}`}
      >

        <div class="tool-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icon(tool.icon)}
          />
        </div>

