<Header /><main class="tools-page">  <section class="hero"><div class="badge">
  <span class="pulse"></span>
  TH.TECH · DEVELOPER TOOLS
</div>

<h1>
  أدوات المطورين
  <strong>في مكان واحد</strong>
</h1>

<p>
  مجموعة احترافية من الأدوات المجانية للمطورين والمبرمجين.
  اضغط على أي بطاقة لفتح الأداة مباشرة.
</p>

<div class="stats">

  <div class="stat">
    <strong>{tools.length}+</strong>
    <span>أداة</span>
  </div>

  <div class="stat">
    <strong>100%</strong>
    <span>مجانية</span>
  </div>

  <div class="stat">
    <strong>0</strong>
    <span>تسجيل مطلوب</span>
  </div>

</div>

  </section>  <section class="tools-section"><div class="section-header">

  <div>
    <span class="section-label">
      DEVELOPER TOOLBOX
    </span>

    <h2>
      جميع الأدوات
    </h2>
  </div>

  <span class="tool-count">
    {tools.length} Tools
  </span>

</div>


<div class="tools-grid">

  {tools.map((tool) => (

    <a
      href={`${base}/tools/${tool.slug}/`}
      class={`tool-card ${tool.color}`}
      aria-label={tool.name}
    >

      <div class="tool-icon">
        <span>{tool.icon}</span>
      </div>

      <div class="tool-info">

        <small>
          DEVELOPER TOOL
        </small>

        <h3>
          {tool.name}
        </h3>

        <p>
          {tool.ar}
        </p>

      </div>

      <span class="arrow">
        ‹
      </span>

    </a>

  ))}

</div>

  </section></main><Footer /><style>

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  min-height: 100vh;
  background: #f5f8fc;
  color: #0f172a;
  font-family: Arial, "Cairo", sans-serif;
}


/* PAGE */

.tools-page {
  width: min(1180px, calc(100% - 30px));
  margin: auto;
  padding: 30px 0 70px;
}


/* HERO */

.hero {
  text-align: center;
  padding: 25px 10px 45px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 7px 13px;

  border: 1px solid rgba(37, 99, 235, .15);
  border-radius: 999px;

  background: rgba(37, 99, 235, .06);

  color: #2563eb;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: .6px;
}

.pulse {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #22c55e;

  animation: pulse 2s infinite;
}

.hero h1 {
  margin: 20px 0 8px;

  font-size: clamp(30px, 5vw, 46px);
  line-height: 1.3;

  font-weight: 800;
}

.hero h1 strong {
  display: block;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.hero p {
  max-width: 650px;

  margin: 10px auto;

  color: #64748b;

  font-size: 13px;
  line-height: 1.9;
}


/* STATS */

.stats {
  display: flex;
  justify-content: center;

  gap: 8px;

  margin-top: 24px;
}

.stat {
  min-width: 100px;

  padding: 8px 13px;

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  background: #fff;

  box-shadow:
    0 5px 20px rgba(15, 23, 42, .04);
}

.stat strong,
.stat span {
  display: block;
}

.stat strong {
  color: #2563eb;
  font-size: 17px;
}

.stat span {
  color: #64748b;
  font-size: 9px;
}


/* SECTION */

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;

  margin-bottom: 18px;
}

.section-label {
  color: #2563eb;

  font-family: monospace;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1px;
}

.section-header h2 {
  margin: 2px 0 0;

  font-size: 24px;
  font-weight: 800;
}

.tool-count {
  padding: 6px 11px;

  border-radius: 8px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 9px;
  font-weight: 800;
}


/* GRID */

.tools-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 13px;
}


/* CARD */

.tool-card {
  position: relative;

  display: flex;
  align-items: center;

  gap: 13px;

  min-height: 106px;

  padding: 14px;

  overflow: hidden;

  border: 1px solid #e2e8f0;
  border-radius: 20px;

  background: #fff;

  color: #0f172a;

  text-decoration: none;

  box-shadow:
    0 6px 20px rgba(15, 23, 42, .04);

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.tool-card::before {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  top: -65px;
  left: -65px;

  border-radius: 50%;

  background: currentColor;

  opacity: .06;

  transition:
    transform .45s ease;
}

.tool-card:hover {
  transform: translateY(-5px);

  border-color: currentColor;

  box-shadow:
    0 18px 42px rgba(15, 23, 42, .12);
}

.tool-card:hover::before {
  transform: scale(3);
}


/* ICON */

.tool-icon {
  position: relative;
  z-index: 1;

  width: 56px;
  height: 56px;

  flex: none;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 17px;

  background: currentColor;

  color: #fff;

  box-shadow:
    0 8px 18px rgba(15, 23, 42, .14);

  transition:
    transform .3s ease;
}

.tool-icon span {
  max-width: 50px;

  overflow: hidden;

  font-family: monospace;

  font-size: 11px;
  font-weight: 800;

  white-space: nowrap;
}

.tool-card:hover .tool-icon {
  transform:
    rotate(-5deg)
    scale(1.08);
}


/* INFO */

.tool-info {
  position: relative;
  z-index: 1;

  min-width: 0;

  flex: 1;
}

.tool-info small {
  display: block;

  color: #94a3b8;

  font-family: monospace;

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .4px;

  white-space: nowrap;
}

.tool-info h3 {
  margin: 2px 0 0;

  font-size: 13px;
  font-weight: 800;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.tool-info p {
  margin: 2px 0 0;

  color: #64748b;

  font-size: 9px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


/* ARROW */

.arrow {
  position: relative;
  z-index: 1;

  width: 27px;
  height: 27px;

  flex: none;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #f1f5f9;

  color: #64748b;

  font-size: 23px;

  transition: .25s ease;
}

.tool-card:hover .arrow {
  background: currentColor;
  color: #fff;

  transform: translateX(-4px);
}


/* COLORS */

.blue {
  color: #2563eb;
}

.green {
  color: #16a34a;
}

.orange {
  color: #ea580c;
}

.yellow {
  color: #ca8a04;
}

.purple {
  color: #9333ea;
}

.cyan {
  color: #0891b2;
}

.indigo {
  color: #4f46e5;
}

.violet {
  color: #7c3aed;
}

.red {
  color: #dc2626;
}

.pink {
  color: #db2777;
}


/* ANIMATION */

@keyframes pulse {

  0%,
  100% {
    box-shadow:
      0 0 0 4px
      rgba(34, 197, 94, .10);
  }

  50% {
    box-shadow:
      0 0 0 8px
      rgba(34, 197, 94, .02);
  }

}


/* TABLET */

@media (max-width: 900px) {

  .tools-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media (max-width: 600px) {

  .tools-page {
    width: calc(100% - 14px);

    padding:
      18px 0 55px;
  }

  .hero {
    padding:
      15px 5px 32px;
  }

  .hero h1 {
    font-size: 29px;
  }

  .hero p {
    font-size: 11px;
  }

  .stats {
    gap: 5px;
  }

  .stat {
    min-width: 0;
    flex: 1;
    padding: 8px 4px;
  }

  .stat strong {
    font-size: 14px;
  }

  .stat span {
    font-size: 8px;
  }

  .section-header h2 {
    font-size: 20px;
  }

  .tool-count {
    font-size: 8px;
  }

  .tools-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .tool-card {
    min-height: 125px;

    padding: 10px 6px;

    flex-direction: column;

    justify-content: center;

    text-align: center;

    gap: 7px;

    border-radius: 18px;
  }

  .tool-icon {
    width: 48px;
    height: 48px;

    border-radius: 15px;
  }

  .tool-info small {
    font-size: 6px;
  }

  .tool-info h3 {
    font-size: 11px;
  }

  .tool-info p {
    display: none;
  }

  .arrow {
    position: absolute;

    top: 6px;
    left: 6px;

    width: 19px;
    height: 19px;

    font-size: 16px;
  }

}


/* SMALL PHONES */

@media (max-width: 360px) {

  .tools-grid {
    gap: 6px;
  }

  .tool-card {
    min-height: 115px;
  }

  .tool-icon {
    width: 44px;
    height: 44px;
  }

  .tool-info h3 {
    font-size: 10px;
  }

}

</style>
