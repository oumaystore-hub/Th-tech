---

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

<html lang="ar" dir="rtl"><head>  <meta charset="UTF-8" /><meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

  <title>أدوات المطورين | Th.Tech</title><meta
name="description"
content="مجموعة احترافية من أدوات المطورين والمبرمجين المجانية."
/>

<meta
name="robots"
content="index, follow"
/>

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${import.meta.env.BASE_URL}tools/`}
  />  <link
    rel="icon"
    type="image/png"
    href={`${import.meta.env.BASE_URL}logo1.png`}
  />  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  /></head><body>  <Header />  <main class="page"><!-- HERO -->

<section class="hero">

  <div class="badge">
    <span class="pulse"></span>
    TH.TECH · DEVELOPER TOOLBOX
  </div>

  <h1>
    أدوات المطورين
    <strong>في مكان واحد</strong>
  </h1>

  <p>
    مجموعة احترافية من الأدوات المجانية للمطورين والمبرمجين.
    اضغط على أي بطاقة لفتح الأداة مباشرة.
  </p>

  <div class="stats">

    <div>
      <b>100+</b>
      <span>أداة</span>
    </div>

    <div>
      <b>100%</b>
      <span>مجانية</span>
    </div>

    <div>
      <b>0</b>
      <span>تسجيل مطلوب</span>
    </div>

  </div>

</section>


<!-- TOOLS -->

<section class="tools-section">

