<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>أدوات المطورين | Th.Tech</title>

  <meta
    name="description"
    content="مجموعة متكاملة من أدوات المطورين المجانية والسريعة من Th.Tech."
  />

  <meta name="robots" content="index, follow" />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />

  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>

<body>

  <Header />

  <main class="page">

    <section class="hero">

      <div class="breadcrumb">
        <a href={`${base}/`}>الرئيسية</a>
        <span>‹</span>
        <strong>أدوات المطورين</strong>
      </div>

      <div class="hero-card">

        <div class="hero-decoration decoration-one"></div>
        <div class="hero-decoration decoration-two"></div>

        <div class="hero-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 5h16v14H4z"></path>
            <path d="M8 9h8"></path>
            <path d="M8 13h5"></path>
            <path d="M8 17h3"></path>
          </svg>
        </div>

        <div class="hero-text">
          <span class="eyebrow">TH.TECH TOOLBOX</span>

          <h1>أدوات المطورين</h1>

          <p>
            مجموعة احترافية من الأدوات السريعة والمجانية لإنجاز المهام التقنية اليومية.
          </p>
        </div>

      </div>

    </section>


    <section class="tools-section">

      <div class="section-head">

        <div>
          <span class="section-label">DEVELOPER TOOLS</span>
          <h2>جميع الأدوات</h2>
        </div>

        <div class="count-box">
          <strong>{tools.length}</strong>
          <span>أداة</span>
        </div>

      </div>


      <div class="tools-grid">

        {tools.map((tool, index) => (

          <a
            href={`${base}/tools/${tool.slug}/`}
            class={`tool-card ${tool.color}`}
            aria-label={`فتح ${tool.name}`}
          >

            <div class="card-background"></div>

            <span class="tool-number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div class="tool-icon">

              <svg viewBox="0 0 24 24" aria-hidden="true">

                {(iconPaths[tool.icon] || iconPaths.code).map((path) => (
                  <path d={path}></path>
                ))}

              </svg>

            </div>

            <div class="tool-content">

              <h3>{tool.name}</h3>

              <p>{tool.desc}</p>

            </div>

            <span class="tool-arrow" aria-hidden="true">

              <svg viewBox="0 0 24 24">
                <path d="M5 12h13"></path>
                <path d="M13 6l6 6-6 6"></path>
              </svg>

            </span>

          </a>

        ))}

      </div>

    </section>


    <section class="info-card">

      <div class="info-icon">

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 8v4"></path>
          <path d="M12 16h.01"></path>
        </svg>

      </div>

      <div class="info-content">

        <span>TH.TECH</span>

        <h2>أدوات تقنية في مكان واحد</h2>

        <p>
          جميع الأدوات مصممة لتكون سريعة، بسيطة، ومتوافقة مع الهاتف والحاسوب.
        </p>

      </div>

    </section>

  </main>

  <Footer />

</body>
</html>


<style>

:global(*) {
  box-sizing: border-box;
}


/* =========================================================
   THEME VARIABLES
   متوافقة مع الوضع الليلي/النهاري في Header.astro
   ========================================================= */

:global(:root) {

  --bg: #f6f8fb;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --soft: #f1f5f9;
  --primary: #2563eb;

  color-scheme: light;
}


/* DARK MODE */

:global(html.dark),
:global(html[data-theme="dark"]) {

  --bg: #070c15;
  --card: #111a2a;
  --text: #f8fafc;
  --muted: #94a3b8;
  --border: rgba(148, 163, 184, .14);
  --soft: #182337;
  --primary: #60a5fa;

  color-scheme: dark;
}


/* BODY */

:global(body) {

  margin: 0;

  min-width: 320px;

  font-family:
    "Cairo",
    sans-serif;

  background:
    radial-gradient(
      circle at 8% 8%,
      rgba(37, 99, 235, .065),
      transparent 28%
    ),
    radial-gradient(
      circle at 92% 24%,
      rgba(6, 182, 212, .055),
      transparent 30%
    ),
    var(--bg);

  color: var(--text);

  transition:
    background-color .3s ease,
    color .3s ease;

}


/* DARK BODY */

:global(html.dark body),
:global(html[data-theme="dark"] body) {

  background:
    radial-gradient(
      circle at 8% 8%,
      rgba(37, 99, 235, .13),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 30%,
      rgba(6, 182, 212, .08),
      transparent 32%
    ),
    var(--bg);

}


/* =========================================================
   PAGE
   ========================================================= */

.page {

  width:
    min(
      1180px,
      calc(100% - 32px)
    );

  margin: 0 auto;

  padding:
    28px 0 75px;

}


/* =========================================================
   BREADCRUMB
   ========================================================= */

.breadcrumb {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 21px;

  font-size: 11px;

  color: var(--muted);

}

.breadcrumb a {

  color: #2563eb;

  text-decoration: none;

  font-weight: 800;

  transition: color .2s ease;

}

.breadcrumb a:hover {

  color: #1d4ed8;

}

.breadcrumb span {

  color: #94a3b8;

}

.breadcrumb strong {

  font-weight: 700;

}


/* =========================================================
   HERO
   ========================================================= */

.hero {

  margin-bottom: 38px;

}

.hero-card {

  position: relative;

  min-height: 190px;

  display: flex;

  align-items: center;

  gap: 25px;

  overflow: hidden;

  padding: 35px 42px;

  border:
    1px solid rgba(255, 255, 255, .9);

  border-radius: 34px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, .99),
      rgba(239, 246, 255, .97)
    );

  box-shadow:
    0 22px 60px rgba(15, 23, 42, .075),
    inset 0 1px 0 rgba(255, 255, 255, .95);

  isolation: isolate;

}


/* DARK HERO */

:global(html.dark) .hero-card,
:global(html[data-theme="dark"]) .hero-card {

  border-color:
    rgba(148, 163, 184, .14);

  background:
    linear-gradient(
      135deg,
      #111b2d,
      #0c1422
    );

  box-shadow:
    0 25px 70px rgba(0, 0, 0, .30),
    inset 0 1px 0 rgba(255, 255, 255, .025);

}


.hero-decoration {

  position: absolute;

  pointer-events: none;

  border:
    1px solid rgba(37, 99, 235, .10);

  transform: rotate(28deg);

}

.decoration-one {

  width: 220px;
  height: 220px;

  left: -90px;
  top: -110px;

  border-radius: 52px;

}

.decoration-two {

  width: 180px;
  height: 180px;

  right: -75px;
  bottom: -100px;

  border-radius: 46px;

}


.hero-icon {

  position: relative;

  z-index: 2;

  width: 84px;
  height: 84px;

  flex: 0 0 84px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 25px;

  background:
    linear-gradient(
      145deg,
      #2563eb,
      #06b6d4
    );

  box-shadow:
    0 18px 38px rgba(37, 99, 235, .25),
    inset 0 1px 0 rgba(255, 255, 255, .35);

  animation:
    heroFloat 4s ease-in-out infinite;

}

.hero-icon svg {

  width: 43px;
  height: 43px;

  fill: none;

  stroke: #fff;

  stroke-width: 1.7;

  stroke-linecap: round;

  stroke-linejoin: round;

}

.hero-text {

  position: relative;

  z-index: 2;

}

.eyebrow,
.section-label {

  display: block;

  color: #2563eb;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.6px;

}

.hero h1 {

  margin:
    4px 0 7px;

  color: var(--text);

  font-size:
    clamp(
      29px,
      4vw,
      43px
    );

  line-height: 1.2;

  font-weight: 800;

  letter-spacing: -.4px;

}

.hero p {

  max-width: 690px;

  margin: 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.9;

}


/* =========================================================
   SECTION HEADER
   ========================================================= */

.tools-section {

  margin-top: 20px;

}

.section-head {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 22px;

}

.section-head h2 {

  margin:
    4px 0 0;

  color: var(--text);

  font-size: 24px;

  font-weight: 800;

}

.count-box {

  display: flex;

  align-items: center;

  gap: 7px;

  color: var(--muted);

  font-size: 11px;

}

.count-box strong {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 40px;

  height: 31px;

  padding:
    0 10px;

  border-radius: 11px;

  background: #eaf1ff;

  color: #2563eb;

  font-size: 12px;

  font-weight: 800;

}


/* =========================================================
   TOOLS GRID
   ========================================================= */

.tools-grid {

  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    );

  gap: 17px;

}


/* =========================================================
   TOOL CARD
   ========================================================= */

.tool-card {

  --accent: #2563eb;

  --soft:
    rgba(37, 99, 235, .10);

  position: relative;

  min-height: 168px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  overflow: hidden;

  padding: 20px;

  border:
    1px solid var(--border);

  border-radius:
    26px 10px 26px 10px;

  background:
    var(--card);

  color: var(--text);

  text-decoration: none;

  box-shadow:
    0 10px 30px rgba(15, 23, 42, .055),
    inset 0 1px 0 rgba(255, 255, 255, .95);

  isolation: isolate;

  transition:
    transform .28s cubic-bezier(.2, .8, .2, 1),
    box-shadow .28s ease,
    border-color .28s ease,
    border-radius .28s ease;

}


/* DARK CARD */

:global(html.dark) .tool-card,
:global(html[data-theme="dark"]) .tool-card {

  border-color:
    rgba(148, 163, 184, .14);

  background:
    linear-gradient(
      145deg,
      #111a2a,
      #0d1523
    );

  color: #f8fafc;

  box-shadow:
    0 13px 38px rgba(0, 0, 0, .25),
    inset 0 1px 0 rgba(255, 255, 255, .025);

}


.tool-card::before {

  content: "";

  position: absolute;

  width: 130px;
  height: 130px;

  top: -67px;
  left: -55px;

  border-radius: 35px;

  transform: rotate(28deg);

  background:
    var(--soft);

  opacity: .95;

  z-index: -1;

}


.tool-card::after {

  content: "";

  position: absolute;

  width: 95px;
  height: 95px;

  right: -42px;
  bottom: -47px;

  border-radius: 28px;

  transform: rotate(28deg);

  border:
    1px solid var(--accent);

  opacity: .09;

  z-index: -1;

}


.tool-card:hover {

  transform:
    translateY(-7px);

  border-color:
    var(--accent);

  border-radius:
    10px 26px 10px 26px;

  box-shadow:
    0 22px 48px rgba(15, 23, 42, .12),
    0 0 0 3px
    color-mix(
      in srgb,
      var(--accent) 7%,
      transparent
    );

}


:global(html.dark) .tool-card:hover,
:global(html[data-theme="dark"]) .tool-card:hover {

  box-shadow:
    0 24px 50px rgba(0, 0, 0, .34),
    0 0 0 3px
    color-mix(
      in srgb,
      var(--accent) 10%,
      transparent
    );

}


.tool-card:active {

  transform:
    translateY(-2px)
    scale(.985);

}


.card-background {

  position: absolute;

  width: 120px;
  height: 120px;

  top: -55px;
  right: -55px;

  border-radius: 50%;

  background:
    var(--accent);

  opacity: .045;

  transition:
    transform .35s ease,
    opacity .35s ease;

}


.tool-card:hover .card-background {

  transform:
    scale(2.2);

  opacity: .085;

}


.tool-number {

  position: absolute;

  top: 13px;
  left: 16px;

  color: #cbd5e1;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .6px;

}


:global(html.dark) .tool-number,
:global(html[data-theme="dark"]) .tool-number {

  color: #475569;

}


.tool-icon {

  position: relative;

  z-index: 2;

  width: 58px;
  height: 58px;

  flex: 0 0 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 14px;

  border-radius:
    18px 7px 18px 7px;

  background:
    var(--soft);

  color:
    var(--accent);

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .75);

  transition:
    transform .3s ease,
    border-radius .3s ease,
    background .3s ease;

}


.tool-card:hover .tool-icon {

  transform:
    rotate(-5deg)
    scale(1.08);

  border-radius:
    7px 18px 7px 18px;

}


.tool-icon svg {

  width: 31px;
  height: 31px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.65;

  stroke-linecap: round;

  stroke-linejoin: round;

}


.tool-content {

  position: relative;

  z-index: 2;

  min-width: 0;

  padding-right: 1px;

  padding-bottom: 28px;

}


.tool-content h3 {

  margin: 0;

  overflow: hidden;

  color: var(--text);

  font-size: 15px;

  line-height: 1.55;

  font-weight: 800;

  text-overflow: ellipsis;

  white-space: nowrap;

}


.tool-content p {

  margin:
    4px 0 0;

  overflow: hidden;

  color: var(--muted);

  font-size: 11px;

  line-height: 1.7;

  text-overflow: ellipsis;

  white-space: nowrap;

}


.tool-arrow {

  position: absolute;

  right: 17px;
  bottom: 16px;

  width: 32px;
  height: 32px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius:
    10px 5px 10px 5px;

  background:
    var(--soft);

  color:
    var(--muted);

  opacity: .9;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease,
    border-radius .25s ease;

}


.tool-arrow svg {

  width: 16px;
  height: 16px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.8;

  stroke-linecap: round;

  stroke-linejoin: round;

}


.tool-card:hover .tool-arrow {

  background:
    var(--accent);

  color: #fff;

  opacity: 1;

  transform:
    translateX(-4px);

  border-radius:
    5px 10px 5px 10px;

}


/* =========================================================
   TOOL COLORS
   ========================================================= */

.blue {

  --accent: #2563eb;

  --soft:
    rgba(37, 99, 235, .10);

}

.green {

  --accent: #16a34a;

  --soft:
    rgba(22, 163, 74, .10);

}

.orange {

  --accent: #ea580c;

  --soft:
    rgba(234, 88, 12, .10);

}

.yellow {

  --accent: #ca8a04;

  --soft:
    rgba(202, 138, 4, .12);

}

.purple {

  --accent: #7c3aed;

  --soft:
    rgba(124, 58, 237, .10);

}

.cyan {

  --accent: #0891b2;

  --soft:
    rgba(8, 145, 178, .10);

}


/* =========================================================
   INFO CARD
   ========================================================= */

.info-card {

  display: flex;

  align-items: center;

  gap: 19px;

  margin-top: 48px;

  padding: 26px;

  border:
    1px solid var(--border);

  border-radius:
    25px 10px 25px 10px;

  background:
    var(--card);

  color:
    var(--text);

  box-shadow:
    0 12px 34px rgba(15, 23, 42, .045);

}


/* DARK INFO */

:global(html.dark) .info-card,
:global(html[data-theme="dark"]) .info-card {

  border-color:
    rgba(148, 163, 184, .14);

  background:
    linear-gradient(
      145deg,
      #111a2a,
      #0d1523
    );

  color:
    #f8fafc;

  box-shadow:
    0 15px 40px rgba(0, 0, 0, .25);

}


.info-icon {

  width: 58px;
  height: 58px;

  flex: 0 0 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius:
    18px 7px 18px 7px;

  background:
    #eaf1ff;

  color:
    #2563eb;

}


:global(html.dark) .info-icon,
:global(html[data-theme="dark"]) .info-icon {

  background:
    rgba(37, 99, 235, .13);

  color:
    #60a5fa;

}


.info-icon svg {

  width: 28px;
  height: 28px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.7;

  stroke-linecap: round;

  stroke-linejoin: round;

}


.info-content {

  min-width: 0;

}


.info-card span {

  color:
    #2563eb;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 1px;

}


:global(html.dark) .info-card span,
:global(html[data-theme="dark"]) .info-card span {

  color:
    #60a5fa;

}


.info-card h2 {

  margin:
    2px 0 4px;

  color:
    var(--text);

  font-size: 17px;

  font-weight: 800;

}


.info-card p {

  margin: 0;

  color:
    var(--muted);

  font-size: 11px;

  line-height: 1.8;

}


/* =========================================================
   ANIMATION
   ========================================================= */

@keyframes heroFloat {

  0%,
  100% {

    transform:
      translateY(0);

  }

  50% {

    transform:
      translateY(-5px);

  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1050px) {

  .tools-grid {

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 760px) {

  .page {

    width:
      calc(100% - 18px);

    padding:
      20px 0 55px;

  }

  .hero {

    margin-bottom: 29px;

  }

  .breadcrumb {

    margin-bottom: 15px;

    font-size: 10px;

  }

  .hero-card {

    min-height: 153px;

    gap: 15px;

    padding:
      25px 19px;

    border-radius: 28px;

  }

  .hero-icon {

    width: 64px;
    height: 64px;

    flex-basis: 64px;

    border-radius: 19px;

  }

  .hero-icon svg {

    width: 33px;
    height: 33px;

  }

  .eyebrow {

    font-size: 8.5px;

    letter-spacing: 1.3px;

  }

  .hero h1 {

    margin:
      3px 0 6px;

    font-size: 25px;

    letter-spacing: -.3px;

  }

  .hero p {

    font-size: 10px;

    line-height: 1.85;

  }

  .section-head {

    margin-bottom: 16px;

  }

  .section-head h2 {

    font-size: 20px;

  }

  .section-label {

    font-size: 8.5px;

  }

  .count-box {

    font-size: 10px;

  }

  .count-box strong {

    min-width: 34px;

    height: 29px;

    font-size: 11px;

  }

  .tools-grid {

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

