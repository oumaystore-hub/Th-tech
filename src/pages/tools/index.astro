<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>أدوات المطورين | Th.Tech</title>

<meta
  name="description"
  content="مجموعة متكاملة من أدوات المطورين المجانية والسريعة."
/>

<meta name="robots" content="index, follow" />

<link
  rel="canonical"
  href={`https://oumaystore-hub.github.io${base}/tools/`}
/>

<link
  rel="icon"
  type="image/png"
  href={`${base}/logo1.png`}
/>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" />

<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

  </head>  <body>
    <Header /><main class="page">

  <section class="hero">

    <div class="breadcrumb">
      <a href={`${base}/`}>الرئيسية</a>
      <span>›</span>
      <strong>أدوات المطورين</strong>
    </div>

    <div class="hero-content">

      <div class="hero-icon">
        <svg viewBox="0 0 24 24">
          <path d="M4 5h16v14H4z M8 9h8 M8 13h5" />
        </svg>
      </div>

      <div>
        <span class="eyebrow">
          TH.TECH DEVELOPER TOOLS
        </span>

        <h1>أدوات المطورين</h1>

        <p>
          مجموعة متكاملة من الأدوات السريعة والمجانية
          للمطورين وصناع المحتوى والتقنيين.
        </p>
      </div>

    </div>

  </section>


  <section class="tools-section">

    <div class="section-head">

      <div>
        <span class="section-label">
          TOOLBOX
        </span>

        <h2>
          جميع الأدوات
        </h2>
      </div>

      <div class="count">
        <span>{tools.length}</span>
        أداة
      </div>

    </div>


    <div class="tools-grid">

      {
        tools.map((tool, index) => (
          <a
            href={`${base}/tools/${tool[1]}/`}
            class={`tool-card ${tool[3]}`}
          >

            <div class="number">
              {String(index + 1).padStart(2, '0')}
            </div>

            <div class="icon">

              <svg viewBox="0 0 24 24">
                <path d="M4 5h16v14H4z" />
                <path d="M8 9h8" />
                <path d="M8 13h5" />
              </svg>

            </div>

            <div class="content">

              <h3>
                {tool[0]}
              </h3>

              <p>
                {tool[2]}
              </p>

            </div>

            <div class="arrow">
              ←
            </div>

          </a>
        ))
      }

    </div>

  </section>


  <section class="info">

    <div class="info-icon">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 8v4l3 2" />
      </svg>
    </div>

    <div>
      <h2>
        أدوات مجانية وسريعة
      </h2>

      <p>
        أدوات Th.Tech مصممة لتعمل مباشرة من المتصفح
        وتساعدك على إنجاز المهام التقنية اليومية بسرعة.
      </p>
    </div>

  </section>

</main>

<Footer />

  </body>
</html><style>
:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #f6f8fc;
  color: #0f172a;
  font-family: "Cairo", sans-serif;
}

.page {
  width: min(1200px, calc(100% - 32px));
  margin: auto;
  padding: 32px 0 70px;
}

.hero {
  padding: 10px 0 35px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 28px;
  color: #64748b;
  font-size: 11px;
}

.breadcrumb a {
  color: #2563eb;
  text-decoration: none;
}

.breadcrumb span {
  color: #94a3b8;
}

.hero-content {
  display: flex;
  align-items: center;
  gap: 18px;
}

.hero-icon {
  width: 68px;
  height: 68px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  background: linear-gradient(135deg, #2563eb, #06b6d4);
  box-shadow: 0 15px 35px rgba(37, 99, 235, .2);
}

.hero-icon svg {
  width: 34px;
  height: 34px;
  fill: none;
  stroke: white;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.eyebrow,
.section-label {
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.hero h1 {
  margin: 3px 0;
  font-size: clamp(27px, 4vw, 38px);
  font-weight: 800;
}

.hero p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
}

.tools-section {
  margin-top: 10px;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.section-head h2 {
  margin: 3px 0 0;
  font-size: 21px;
}

.count {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #64748b;
  font-size: 11px;
}

.count span {
  padding: 5px 10px;
  border-radius: 9px;
  background: #eaf1ff;
  color: #2563eb;
  font-weight: 800;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.tool-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 116px;
  padding: 16px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
  border-radius: 22px;
  background: white;
  color: #0f172a;
  text-decoration: none;
  box-shadow: 0 7px 25px rgba(15, 23, 42, .05);
  transition: transform .25s ease, box-shadow .25s ease;
}

.tool-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 40px rgba(15, 23, 42, .11);
}

.icon {
  width: 52px;
  height: 52px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17px;
  transition: transform .3s ease;
}

.tool-card:hover .icon {
  transform: rotate(-6deg) scale(1.08);
}

.icon svg {
  width: 27px;
  height: 27px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.content {
  min-width: 0;
  flex: 1;
}

.content h3 {
  margin: 0;
  font-size: 13px;
  font-weight: 800;
}

.content p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 10px;
}

.number {
  position: absolute;
  top: 8px;
  left: 10px;
  color: #cbd5e1;
  font-size: 8px;
}

.arrow {
  width: 27px;
  height: 27px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  transition: .25s;
}

.tool-card:hover .arrow {
  background: #2563eb;
  color: white;
  transform: translateX(-3px);
}

.blue .icon {
  background: #eaf1ff;
  color: #2563eb;
}

.green .icon {
  background: #e9f9ef;
  color: #16a34a;
}

.orange .icon {
  background: #fff1e8;
  color: #ea580c;
}

.yellow .icon {
  background: #fff8d8;
  color: #ca8a04;
}

.purple .icon {
  background: #f2eaff;
  color: #7c3aed;
}

.cyan .icon {
  background: #e5f9fc;
  color: #0891b2;
}

.info {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 45px;
  padding: 25px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: white;
}

.info-icon {
  width: 52px;
  height: 52px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #eaf1ff;
  color: #2563eb;
}

.info-icon svg {
  width: 25px;
  height: 25px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
}

.info h2 {
  margin: 0;
  font-size: 16px;
}

.info p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 11px;
}

@media (max-width: 950px) {
  .tools-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .page {
    width: calc(100% - 16px);
    padding-top: 20px;
  }

  .hero-content {
    gap: 12px;
  }

  .hero-icon {
    width: 55px;
    height: 55px;
    border-radius: 16px;
  }

  .hero-icon svg {
    width: 27px;
    height: 27px;
  }

  .hero h1 {
    font-size: 24px;
  }

  .hero p {
    font-size: 10px;
  }

  .tools-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .tool-card {
    min-height: 108px;
    padding: 12px 9px;
    gap: 8px;
    border-radius: 17px;
  }

  .icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
  }

  .icon svg {
    width: 21px;
    height: 21px;
  }

  .content h3 {
    font-size: 10px;
  }

  .content p {
    font-size: 8px;
  }

  .arrow {
    width: 22px;
    height: 22px;
    font-size: 10px;
  }

  .number {
    font-size: 7px;
  }

  .info {
    align-items: flex-start;
    padding: 18px;
  }
}

@media (max-width: 370px) {
  .content p,
  .arrow {
    display: none;
  }

  .tool-card {
    justify-content: flex-start;
  }
}
</style>
