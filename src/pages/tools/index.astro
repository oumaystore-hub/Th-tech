---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "أدوات المطورين | Th.Tech";
const description =
  "مجموعة أدوات تقنية مجانية للمطورين: JSON، HTML، CSS، JavaScript، Regex، Base64، الألوان، الوقت والمزيد.";

const tools = [
  {
    name: "JSON Formatter",
    slug: "json-formatter",
    desc: "تنسيق وتجميل JSON والتحقق من صحته بسهولة.",
    category: "JSON",
    categoryLabel: "JSON",
    icon: "fa-code",
    color: "blue"
  },
  {
    name: "JSON Validator",
    slug: "json-validator",
    desc: "تحقق من صحة بيانات JSON واكتشف الأخطاء بسرعة.",
    category: "JSON",
    categoryLabel: "JSON",
    icon: "fa-circle-check",
    color: "cyan"
  },
  {
    name: "JSON Minifier",
    slug: "json-minifier",
    desc: "تصغير JSON وإزالة المسافات غير الضرورية.",
    category: "JSON",
    categoryLabel: "JSON",
    icon: "fa-compress",
    color: "indigo"
  },
  {
    name: "Base64 Encoder",
    slug: "base64-encoder",
    desc: "تشفير النصوص وتحويلها إلى Base64 مباشرة.",
    category: "Encoding",
    categoryLabel: "Encoding",
    icon: "fa-lock",
    color: "purple"
  },
  {
    name: "Base64 Decoder",
    slug: "base64-decoder",
    desc: "فك ترميز Base64 وتحويله إلى نص مقروء.",
    category: "Encoding",
    categoryLabel: "Encoding",
    icon: "fa-unlock",
    color: "violet"
  },
  {
    name: "URL Encoder",
    slug: "url-encoder",
    desc: "ترميز النصوص والروابط لاستخدامها بأمان في URLs.",
    category: "Web",
    categoryLabel: "Web",
    icon: "fa-link",
    color: "blue"
  },
  {
    name: "URL Decoder",
    slug: "url-decoder",
    desc: "فك ترميز الروابط والنصوص المشفرة.",
    category: "Web",
    categoryLabel: "Web",
    icon: "fa-link-slash",
    color: "cyan"
  },
  {
    name: "HTML Formatter",
    slug: "html-formatter",
    desc: "تنسيق HTML وترتيب الكود بطريقة واضحة.",
    category: "Web",
    categoryLabel: "Web",
    icon: "fa-file-code",
    color: "orange"
  },
  {
    name: "CSS Formatter",
    slug: "css-formatter",
    desc: "تنسيق CSS وترتيب قواعد التصميم تلقائيًا.",
    category: "Web",
    categoryLabel: "Web",
    icon: "fa-paintbrush",
    color: "sky"
  },
  {
    name: "JavaScript Formatter",
    slug: "javascript-formatter",
    desc: "تنسيق كود JavaScript وتحسين قابلية القراءة.",
    category: "JavaScript",
    categoryLabel: "JavaScript",
    icon: "fa-js",
    color: "yellow"
  },
  {
    name: "Regex Tester",
    slug: "regex-tester",
    desc: "اختبر Regular Expressions وشاهد النتائج مباشرة.",
    category: "Developer",
    categoryLabel: "Developer",
    icon: "fa-magnifying-glass",
    color: "green"
  },
  {
    name: "Color Picker",
    slug: "color-picker",
    desc: "اختر الألوان واحصل على HEX وRGB وHSL.",
    category: "Design",
    categoryLabel: "Design",
    icon: "fa-palette",
    color: "pink"
  },
  {
    name: "Timestamp Converter",
    slug: "timestamp-converter",
    desc: "تحويل Unix Timestamp إلى تاريخ ووقت والعكس.",
    category: "Date",
    categoryLabel: "Date & Time",
    icon: "fa-clock",
    color: "teal"
  },
  {
    name: "UUID Generator",
    slug: "uuid-generator",
    desc: "إنشاء UUIDs عشوائية للاستخدام في المشاريع.",
    category: "Developer",
    categoryLabel: "Developer",
    icon: "fa-fingerprint",
    color: "indigo"
  },
  {
    name: "Hash Generator",
    slug: "hash-generator",
    desc: "إنشاء Hash للنصوص باستخدام خوارزميات متعددة.",
    category: "Security",
    categoryLabel: "Security",
    icon: "fa-shield-halved",
    color: "red"
  },
  {
    name: "Text Case Converter",
    slug: "text-case-converter",
    desc: "تحويل النص بين UPPERCASE وlowercase وغيرها.",
    category: "Text",
    categoryLabel: "Text",
    icon: "fa-font",
    color: "purple"
  }
];

const categories = [
  { id: "all", label: "الكل", icon: "fa-layer-group" },
  { id: "JSON", label: "JSON", icon: "fa-code" },
  { id: "Web", label: "Web", icon: "fa-globe" },
  { id: "JavaScript", label: "JavaScript", icon: "fa-js" },
  { id: "Encoding", label: "Encoding", icon: "fa-lock" },
  { id: "Developer", label: "Developer", icon: "fa-terminal" },
  { id: "Security", label: "Security", icon: "fa-shield-halved" },
  { id: "Design", label: "Design", icon: "fa-palette" },
  { id: "Date", label: "Date & Time", icon: "fa-clock" },
  { id: "Text", label: "Text", icon: "fa-font" }
];
---

<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />

  <link
    rel="icon"
    type="image/png"
    href={`${base}/logo1.png`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- تطبيق الثيم قبل ظهور الصفحة -->
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tools-hero">

      <div class="hero-grid-bg"></div>

      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container">

        <div class="breadcrumb">

          <a href={`${base}/`}>
            الرئيسية
          </a>

          <i class="fas fa-chevron-left"></i>

          <span>
            أدوات المطورين
          </span>

        </div>

        <div class="hero-content">

          <div class="hero-badge">
            <span class="pulse"></span>
            <i class="fas fa-toolbox"></i>
            أدوات تقنية مجانية
          </div>

          <h1>
            أدواتك التقنية
            <span>في مكان واحد</span>
          </h1>

          <p>
            مجموعة من الأدوات السريعة والمجانية للمطورين والمصممين
            وصناع المحتوى. استخدمها مباشرة من المتصفح بدون تسجيل.
          </p>

        </div>

        <!-- SEARCH -->

        <div class="search-wrapper">

          <div class="search-box">

            <i class="fas fa-magnifying-glass search-icon"></i>

            <input
              id="toolSearch"
              type="search"
              placeholder="ابحث عن أداة... مثال: JSON, Base64, CSS"
              autocomplete="off"
              aria-label="البحث عن أداة"
            />

            <button
              id="clearSearch"
              type="button"
              aria-label="مسح البحث"
            >
              <i class="fas fa-xmark"></i>
            </button>

            <kbd>
              Ctrl K
            </kbd>

          </div>

        </div>

        <!-- CATEGORY -->

        <div class="categories-wrapper">

          <div class="categories" id="categories">

            {categories.map((category) => (
              <button
                type="button"
                class:list={[
                  "category-btn",
                  { active: category.id === "all" }
                ]}
                data-category={category.id}
              >
                <i class={`fas ${category.icon}`}></i>
                <span>{category.label}</span>
              </button>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ================= TOOLS ================= -->

    <section class="tools-section">

      <div class="container">

        <div class="tools-toolbar">

          <div>

            <span class="section-kicker">
              <i class="fas fa-cubes"></i>
              TOOLBOX
            </span>

            <h2>
              جميع الأدوات
            </h2>

          </div>

          <div class="tools-count">
            <strong id="toolsCount">
              {tools.length}
            </strong>

            <span>
              أداة متاحة
            </span>
          </div>

        </div>


        <div
          class="tools-grid"
          id="toolsGrid"
        >

          {tools.map((tool, index) => (

            <a
              href={`${base}/tools/${tool.slug}/`}
              class="tool-card"
              data-name={tool.name.toLowerCase()}
              data-description={tool.desc.toLowerCase()}
              data-category={tool.category}
              style={`--delay: ${index * 35}ms`}
            >

              <!-- الشكل الهندسي -->

              <div class="card-number">
                {(index + 1).toString().padStart(2, "0")}
              </div>

              <div class="geometric-shape shape-one"></div>
              <div class="geometric-shape shape-two"></div>

              <div class="tool-card-top">

                <div class={`tool-icon ${tool.color}`}>
                  <i class={`fas ${tool.icon}`}></i>
                </div>

                <span class="tool-category">
                  {tool.categoryLabel}
                </span>

              </div>

              <div class="tool-card-content">

                <h3>
                  {tool.name}
                </h3>

                <p>
                  {tool.desc}
                </p>

              </div>

              <div class="tool-card-footer">

                <span>
                  فتح الأداة
                </span>

                <span class="tool-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

            </a>

          ))}

        </div>


        <!-- NO RESULTS -->

        <div
          id="noResults"
          class="no-results"
          hidden
        >

          <div class="no-results-icon">
            <i class="fas fa-magnifying-glass"></i>
          </div>

          <h3>
            لم نجد أي أداة
          </h3>

          <p>
            جرّب البحث باسم مختلف أو اختر مجالاً آخر.
          </p>

          <button
            id="resetFilters"
            type="button"
            class="reset-btn"
          >
            <i class="fas fa-rotate-right"></i>
            إعادة ضبط البحث
          </button>

        </div>

      </div>

    </section>


    <!-- ================= INFO ================= -->

    <section class="tools-info">

      <div class="container">

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>
                سريعة
              </h3>

              <p>
                تعمل مباشرة داخل المتصفح بدون خطوات معقدة.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>
                آمنة
              </h3>

              <p>
                معظم العمليات تتم محليًا داخل جهازك.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-mobile-screen"></i>
            </div>

            <div>
              <h3>
                متجاوبة
              </h3>

              <p>
                مصممة للعمل على الهاتف والكمبيوتر واللوحي.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-gift"></i>
            </div>

            <div>
              <h3>
                مجانية
              </h3>

              <p>
                جميع الأدوات متاحة للاستخدام مجانًا.
              </p>
            </div>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- SCROLL TOP -->

  <button
    id="scrollTop"
    class="scroll-top"
    type="button"
    aria-label="العودة إلى الأعلى"
  >
    <i class="fas fa-arrow-up"></i>
  </button>


  <style>

    /* =========================================================
       THEME SYSTEM
       ========================================================= */

    :root {

      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --bg3: #eaf0f7;

      --text: #0f172a;
      --text-soft: #334155;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;

      --card: #ffffff;
      --card-solid: #ffffff;

      --border: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(37, 99, 235, 0.25);

      --shadow:
        0 18px 55px rgba(15, 23, 42, 0.08);

      --shadow-hover:
        0 25px 70px rgba(15, 23, 42, 0.14);

      --radius: 22px;

      --header-space: 80px;
    }


    html.dark-mode {

      --bg: #07101f;
      --bg2: #0b1426;
      --bg3: #111d32;

      --text: #f8fafc;
      --text-soft: #cbd5e1;
      --text-muted: #94a3b8;

      --primary: #3b82f6;
      --primary-hover: #60a5fa;
      --cyan: #06b6d4;

      --card: #101b2f;
      --card-solid: #111d32;

      --border: rgba(148, 163, 184, 0.12);
      --border-strong: rgba(59, 130, 246, 0.3);

      --shadow:
        0 20px 60px rgba(0, 0, 0, 0.3);

      --shadow-hover:
        0 30px 80px rgba(0, 0, 0, 0.45);
    }


    /* =========================================================
       RESET
       ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }


    body {

      min-height: 100vh;

      background:
        var(--bg);

      color:
        var(--text);

      font-family:
        'Cairo',
        sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color .25s ease,
        color .25s ease;
    }


    body,
    main,
    section,
    footer,
    header,
    div,
    article,
    aside {

      transition:
        background-color .25s ease,
        border-color .25s ease,
        color .25s ease;
    }


    img {
      max-width: 100%;
      display: block;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input {

      font-family: inherit;

      -webkit-tap-highlight-color:
        transparent;
    }


    button {
      border: 0;
    }


    .container {

      width: 100%;

      max-width: 1240px;

      margin: 0 auto;

      padding:
        0 24px;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .tools-hero {

      position: relative;

      overflow: hidden;

      padding:
        55px 0 70px;

      background:
        var(--bg);

      border-bottom:
        1px solid var(--border);
    }


    .hero-grid-bg {

      position: absolute;

      inset: 0;

      pointer-events: none;

      opacity: .55;

      background-image:
        linear-gradient(
          rgba(37,99,235,.055) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(37,99,235,.055) 1px,
          transparent 1px
        );

      background-size:
        52px 52px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 95%
        );
    }


    html.dark-mode .hero-grid-bg {

      opacity: .4;

      background-image:
        linear-gradient(
          rgba(59,130,246,.09) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(59,130,246,.09) 1px,
          transparent 1px
        );
    }


    .hero-glow {

      position: absolute;

      width: 420px;
      height: 420px;

      border-radius: 50%;

      filter:
        blur(100px);

      pointer-events: none;

      opacity: .1;
    }


    .hero-glow-one {

      top: -260px;
      right: 8%;

      background:
        var(--primary);
    }


    .hero-glow-two {

      bottom: -300px;
      left: 5%;

      background:
        var(--cyan);
    }


    .breadcrumb {

      position: relative;

      z-index: 2;

      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 10px;

      color:
        var(--text-muted);

      font-size:
        .78rem;

      margin-bottom:
        42px;
    }


    .breadcrumb a {

      transition:
        color .2s ease;
    }


    .breadcrumb a:hover {
      color:
        var(--primary);
    }


    .breadcrumb i {

      font-size:
        .6rem;

      opacity:
        .6;
    }


    .hero-content {

      position: relative;

      z-index: 2;

      text-align: center;

      max-width: 820px;

      margin:
        0 auto 38px;
    }


    .hero-badge {

      display: inline-flex;

      align-items: center;

      gap: 9px;

      padding:
        8px 17px;

      margin-bottom:
        20px;

      border:
        1px solid rgba(37,99,235,.2);

      border-radius:
        50px;

      color:
        var(--primary);

      background:
        rgba(37,99,235,.07);

      font-size:
        .78rem;

      font-weight:
        800;

      backdrop-filter:
        blur(12px);
    }


    html.dark-mode .hero-badge {

      background:
        rgba(59,130,246,.1);

      border-color:
        rgba(59,130,246,.22);
    }


    .pulse {

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background:
        #22c55e;

      box-shadow:
        0 0 0 5px
        rgba(34,197,94,.1);
    }


    .hero-content h1 {

      font-size:
        clamp(2.4rem, 5vw, 4rem);

      line-height:
        1.25;

      font-weight:
        800;

      letter-spacing:
        -.8px;

      margin-bottom:
        17px;
    }


    .hero-content h1 span {

      display: block;

      background:
        linear-gradient(
          135deg,
          #60a5fa,
          #2563eb 50%,
          #06b6d4
        );

      -webkit-background-clip:
        text;

      background-clip:
        text;

      -webkit-text-fill-color:
        transparent;
    }


    .hero-content p {

      max-width:
        700px;

      margin:
        auto;

      color:
        var(--text-muted);

      font-size:
        .98rem;

      line-height:
        2;
    }


    /* =========================================================
       SEARCH
       ========================================================= */

    .search-wrapper {

      position: relative;

      z-index: 5;

      max-width:
        760px;

      margin:
        0 auto 20px;
    }


    .search-box {

      position: relative;

      display: flex;

      align-items: center;

      height:
        64px;

      padding:
        0 18px;

      background:
        var(--card);

      border:
        1px solid var(--border);

      border-radius:
        17px;

      box-shadow:
        var(--shadow);

      transition:
        border-color .25s ease,
        box-shadow .25s ease,
        transform .25s ease;
    }


    .search-box:focus-within {

      border-color:
        var(--border-strong);

      box-shadow:
        0 20px 55px
        rgba(37,99,235,.13);

      transform:
        translateY(-2px);
    }


    .search-icon {

      flex-shrink: 0;

      color:
        var(--primary);

      font-size:
        1rem;

      margin-left:
        12px;
    }


    .search-box input {

      width: 100%;

      height: 100%;

      border: 0;

      outline: 0;

      background:
        transparent;

      color:
        var(--text);

      font-size:
        .9rem;
    }


    .search-box input::placeholder {
      color:
        var(--text-muted);
    }


    .search-box button {

      width:
        34px;

      height:
        34px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      flex-shrink: 0;

      border-radius:
        10px;

      background:
        var(--bg2);

      color:
        var(--text-muted);

      cursor:
        pointer;

      opacity:
        0;

      visibility:
        hidden;

      transition:
        all .2s ease;
    }


    .search-box.has-value button {

      opacity:
        1;

      visibility:
        visible;
    }


    .search-box button:hover {

      color:
        var(--primary);

      background:
        rgba(37,99,235,.1);
    }


    .search-box kbd {

      margin-right:
        9px;

      padding:
        4px 8px;

      border:
        1px solid var(--border);

      border-bottom-width:
        2px;

      border-radius:
        6px;

      color:
        var(--text-muted);

      background:
        var(--bg2);

      font-family:
        'Fira Code',
        monospace;

      font-size:
        .62rem;

      white-space:
        nowrap;
    }


    /* =========================================================
       CATEGORIES
       ========================================================= */

    .categories-wrapper {

      position: relative;

      z-index: 4;

      overflow-x: auto;

      scrollbar-width: none;

      padding-bottom:
        3px;
    }


