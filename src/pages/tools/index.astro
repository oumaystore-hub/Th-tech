  }

  .hero-card {
    position: relative;
    min-height: 190px;
    display: flex;
    align-items: center;
    gap: 25px;
    overflow: hidden;
    padding: 35px 42px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 34px;
    background:
      linear-gradient(135deg, rgba(255,255,255,.98), rgba(241,246,255,.96));
    box-shadow:
      0 20px 55px rgba(15, 23, 42, .08),
      inset 0 1px 0 rgba(255,255,255,.9);
  }

  :global(html.dark) .hero-card,
  :global(body.dark) .hero-card {
    background: linear-gradient(135deg, #111a2a, #0d1523);
    border-color: rgba(148,163,184,.12);
  }

  .hero-decoration {
    position: absolute;
    border: 1px solid rgba(37,99,235,.08);
    transform: rotate(25deg);
    pointer-events: none;
  }

  .hero-decoration-one {
    width: 210px;
    height: 210px;
    left: -80px;
    top: -100px;
    border-radius: 55px;
  }

  .hero-decoration-two {
    width: 170px;
    height: 170px;
    right: -70px;
    bottom: -90px;
    border-radius: 45px;
  }

  .hero-icon {
    position: relative;
    z-index: 1;
    width: 82px;
    height: 82px;
    flex: 0 0 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 26px;
    background: linear-gradient(145deg, #2563eb, #06b6d4);
    box-shadow:
