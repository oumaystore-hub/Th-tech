<Header /><main class="tools-page">  <section class="hero"><div class="badge">
  <span class="pulse"></span>
  TH.TECH · DEVELOPER TOOLS
</div>

<h1>
  أدوات المطورين
  <strong>في مكان واحد</strong>
</h1>

<p>
  مجموعة احترافية من الأدوات المجانية للمطورين والمبرمجين.
  اضغط على أي بطاقة لفتح الأداة مباشرة.
</p>

<div class="stats">

  <div class="stat">
    <strong>100</strong>
    <span>أداة</span>
  </div>

  <div class="stat">
    <strong>100%</strong>
    <span>مجانية</span>
  </div>

  <div class="stat">
    <strong>0</strong>
    <span>تسجيل مطلوب</span>
  </div>

</div>

  </section>  <section class="tools-section"><div class="section-header">

  <div>
    <span class="section-label">
      DEVELOPER TOOLBOX
    </span>

    <h2>
      جميع الأدوات
    </h2>
  </div>

  <span class="tool-count">
    100 Tools
  </span>

</div>


<div class="tools-grid">

  {tools.map((tool) => (

    <a
      href={`${base}/tools/${tool.slug}/`}
      class={`tool-card ${tool.color}`}
      aria-label={tool.name}
    >

      <div class="tool-icon">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={iconSvg(tool.icon)}
        />

      </div>

      <div class="tool-info">

        <small>
          DEVELOPER TOOL
        </small>

        <h3>
          {tool.name}
        </h3>

        <p>
          {tool.ar}
        </p>

      </div>

