---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "أدوات المطورين المجانية - Th.Tech";
const pageDesc =
  "مجموعة أدوات المطورين المجانية والسريعة: تنسيق JSON، التحقق من الصحة، تنسيق HTML وJavaScript، وعدّاد الكلمات. أدوات بسيطة تعمل مباشرة داخل المتصفح.";

const tools = [
  {
    name: "JSON Formatter",
    slug: "json-formatter",
    icon: "fa-code",
    color: "#2563eb",
    desc: "تنسيق وتجميل ملفات JSON وتحويل الكود غير المرتب إلى صيغة واضحة ومقروءة مع التحقق من صحة البيانات.",
    tags: ["JSON", "Format", "Beautify"]
  },
  {
    name: "JSON Validator",
    slug: "json-validator",
    icon: "fa-circle-check",
    color: "#10b981",
    desc: "فحص أكواد JSON واكتشاف الأخطاء مع تحديد موقع الخطأ.",
    tags: ["JSON", "Validate", "Debug"],
    soon: true
  },
  {
    name: "HTML Formatter",
    slug: "html-formatter",
    icon: "fa-html5",
    color: "#f97316",
    desc: "تنسيق كود HTML وجعله أكثر وضوحاً وتنظيماً.",
    tags: ["HTML", "Beautify", "Minify"],
    soon: true
  },
  {
    name: "JavaScript Formatter",
    slug: "javascript-formatter",
    icon: "fa-js",
    color: "#eab308",
    desc: "تنسيق وتجميل كود JavaScript وتحويل الكود المضغوط إلى بنية واضحة.",
    tags: ["JS", "Code", "Format"],
    soon: true
  },
  {
    name: "Word Counter",
    slug: "word-counter",
    icon: "fa-font",
    color: "#8b5cf6",
    desc: "حساب الكلمات والأحرف والجمل والفقرات ووقت القراءة.",
    tags: ["Text", "Counter", "SEO"],
    soon: true
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <link
    rel="canonical"
    href="https://th-tech.github.io/Th-tech/tools/"
  />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta
    property="og:url"
    content="https://th-tech.github.io/Th-tech/tools/"
  />
</head>

<body>

  <Header />

  <main class="tools-page">

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <span class="hero-badge">
          <i class="fas fa-wand-magic-sparkles"></i>
          Th.Tech Tools
        </span>

        <h1>
          أدوات المطورين
          <span>المجانية</span>
        </h1>

        <p>
          أدوات سريعة وبسيطة للمطورين وصناع المحتوى،
          تعمل مباشرة داخل المتصفح بدون الحاجة إلى رفع ملفاتك.
        </p>

      </div>
    </section>


    <!-- TOOLS -->
    <section class="tools-section">
      <div class="container">

        <div class="section-heading">
          <div>
            <span>TOOLKIT</span>
            <h2>اختر الأداة المناسبة</h2>
          </div>

          <p>
            أدوات عملية للاستخدام اليومي
          </p>
        </div>


        <div class="tools-grid">

          {tools.map((tool) => (

            <div
              class:list={[
                "tool-card",
                tool.soon && "coming-soon"
              ]}
            >

              {tool.soon && (
                <div class="soon-badge">
                  قريباً
                </div>
              )}

              {!tool.soon ? (
                <a
                  href={`${import.meta.env.BASE_URL}tools/${tool.slug}/`}
                  class="tool-link"
                  aria-label={`فتح ${tool.name}`}
                >
              ) : (
                <div class="tool-link">
              )}

                  <div class="card-header">

                    <div
                      class="icon-box"
                      style={`background:${tool.color}18;color:${tool.color};`}
                    >
                      <i class={`fas ${tool.icon}`}></i>
                    </div>

                    <div class="tags">
                      {tool.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>

                  </div>


                  <div class="card-body">

                    <h3>{tool.name}</h3>

                    <p>
                      {tool.desc}
                    </p>

                  </div>


                  <div class="card-footer">

                    {tool.soon ? (
                      <span class="action-text muted">
                        متوفرة قريباً
                        <i class="fas fa-clock"></i>
                      </span>
                    ) : (
                      <span class="action-text">
                        فتح الأداة
                        <i class="fas fa-arrow-left"></i>
                      </span>
                    )}

                  </div>

              {!tool.soon ? (
                </a>
              ) : (
                </div>
              )}

            </div>

          ))}

        </div>

      </div>
    </section>


    <!-- FEATURES -->
    <section class="info-section">

      <div class="container">

        <div class="info-title">

          <span>WHY TH.TECH?</span>

          <h2>
            لماذا أدوات Th.Tech؟
          </h2>

          <p>
            صممت لتكون سريعة، بسيطة، وآمنة.
          </p>

        </div>


        <div class="features-grid">

          <div class="feature">

            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>سرعة فائقة</h3>

            <p>
              تعمل الأدوات مباشرة داخل المتصفح بدون انتظار الخادم.
            </p>

          </div>


          <div class="feature">

            <div class="feature-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <h3>خصوصية</h3>

            <p>
              البيانات التي تدخلها في الأدوات تبقى داخل متصفحك.
            </p>

          </div>


          <div class="feature">

            <div class="feature-icon">
              <i class="fas fa-mobile-screen-button"></i>
            </div>

            <h3>متجاوبة</h3>

            <p>
              استخدم الأدوات من الهاتف أو الكمبيوتر بسهولة.
            </p>

          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</body>
</html>


<style>

:root {
  --bg: #f8fafc;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --primary: #2563eb;
  --border: #e2e8f0;
  --soft: #eff6ff;
}

html.dark-mode {
  --bg: #0b1120;
  --card: #111827;
  --text: #f8fafc;
  --muted: #94a3b8;
  --primary: #60a5fa;
  --border: #1e293b;
  --soft: #172554;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: "Cairo", sans-serif;
  line-height: 1.7;
  transition:
    background .3s ease,
    color .3s ease;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: auto;
}


/* HERO */

.hero {
  text-align: center;
  padding: 70px 0 45px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  border-radius: 30px;
  background: var(--soft);
  color: var(--primary);
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(2.1rem, 5vw, 3.3rem);
  line-height: 1.3;
  font-weight: 800;
  margin-bottom: 15px;
}

.hero h1 span {
  color: var(--primary);
}

.hero p {
  max-width: 680px;
  margin: auto;
  color: var(--muted);
  font-size: 1.05rem;
}


/* SECTION */

.tools-section {
  padding: 20px 0 80px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 25px;
}

.section-heading span,
.info-title > span {
  color: var(--primary);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.section-heading h2 {
  font-size: 1.7rem;
  margin-top: 4px;
}

.section-heading p {
  color: var(--muted);
  font-size: .9rem;
}


/* GRID */

.tools-grid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}


/* CARD */

.tool-card {
  position: relative;
  height: 100%;
}

.tool-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 270px;

  padding: 22px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 18px;

  text-decoration: none;
  color: inherit;

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

a.tool-link:hover {
  transform: translateY(-5px);

  border-color: var(--primary);

  box-shadow:
    0 18px 40px rgba(15, 23, 42, .10);
}


/* HEADER */

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;

  margin-bottom: 25px;
}

.icon-box {
  width: 54px;
  height: 54px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  font-size: 23px;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 5px;
}

.tag {
  border: 1px solid var(--border);
  background: var(--bg);

  color: var(--muted);

  border-radius: 20px;

  padding: 3px 8px;

  font-size: 10px;
  font-weight: 700;
}


/* BODY */

.card-body {
  flex: 1;
}

.card-body h3 {
  font-size: 1.2rem;
  margin-bottom: 8px;
}

.card-body p {
  color: var(--muted);
  font-size: .88rem;
  line-height: 1.7;
}


/* FOOTER */

.card-footer {
  border-top: 1px solid var(--border);

  padding-top: 15px;
  margin-top: 20px;
}

.action-text {
  color: var(--primary);

  display: flex;
  align-items: center;
  gap: 8px;

  font-size: .88rem;
  font-weight: 800;
}

.action-text i {
  transition: transform .2s ease;
}

.tool-link:hover .action-text i {
  transform: translateX(-5px);
}

.action-text.muted {
  color: var(--muted);
}


/* COMING SOON */

.coming-soon {
  opacity: .75;
}

.soon-badge {
  position: absolute;

  top: 12px;
  left: 12px;

  z-index: 2;

  background: var(--bg);
  border: 1px solid var(--border);

  color: var(--muted);

  padding: 4px 9px;

  border-radius: 20px;

  font-size: 10px;
  font-weight: 700;
}


/* INFO */

.info-section {
  border-top: 1px solid var(--border);
  padding: 75px 0;
  background: var(--card);
}

.info-title {
  text-align: center;
  margin-bottom: 45px;
}

.info-title h2 {
  font-size: 2rem;
  margin: 5px 0;
}

.info-title p {
  color: var(--muted);
}


.features-grid {
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);

  gap: 25px;
}

.feature {
  text-align: center;
  padding: 25px;
}

.feature-icon {
  width: 58px;
  height: 58px;

  margin: 0 auto 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background: var(--soft);
  color: var(--primary);

  font-size: 22px;
}

.feature h3 {
  margin-bottom: 7px;
}

.feature p {
  color: var(--muted);
  font-size: .88rem;
}


/* MOBILE */

@media (max-width: 700px) {

  .hero {
    padding: 45px 0 30px;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 5px;
  }

  .tools-grid {
    grid-template-columns: 1fr;
  }

  .features-grid {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .tool-link {
    min-height: 250px;
  }

}

</style>
