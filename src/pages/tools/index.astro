    <!-- 01 JSON FORMATTER -->

    <a
      class="tool-card blue"
      href={`${import.meta.env.BASE_URL}tools/json-formatter/`}
    >

      <div class="icon">
        <span>{}</span>
      </div>

      <div class="content">
        <span class="english">JSON FORMATTER</span>
        <h3>JSON Formatter</h3>
        <p>تنسيق وتجميل JSON</p>
      </div>

      <span class="arrow">‹</span>

    </a>


