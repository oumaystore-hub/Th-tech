---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tools = [
  { name: 'JSON Formatter', slug: 'json-formatter', desc: 'تنسيق وتجميل JSON', color: 'blue' },
  { name: 'JSON Validator', slug: 'json-validator', desc: 'التحقق من صحة JSON', color: 'green' },
  { name: 'JSON Minifier', slug: 'json-minifier', desc: 'تصغير JSON', color: 'cyan' },
  { name: 'JSON to CSV', slug: 'json-to-csv', desc: 'تحويل JSON إلى CSV', color: 'orange' },
  { name: 'CSV to JSON', slug: 'csv-to-json', desc: 'تحويل CSV إلى JSON', color: 'purple' },
  { name: 'JSON to XML', slug: 'json-to-xml', desc: 'تحويل JSON إلى XML', color: 'blue' },
  { name: 'XML to JSON', slug: 'xml-to-json', desc: 'تحويل XML إلى JSON', color: 'green' },
  { name: 'JSON Diff', slug: 'json-diff', desc: 'مقارنة ملفات JSON', color: 'orange' },
  { name: 'JSON Path Tester', slug: 'json-path-tester', desc: 'اختبار JSONPath', color: 'purple' },
  { name: 'JSON Escape', slug: 'json-escape', desc: 'تهريب نصوص JSON', color: 'cyan' },

  { name: 'HTML Formatter', slug: 'html-formatter', desc: 'تنسيق HTML', color: 'orange' },
  { name: 'HTML Minifier', slug: 'html-minifier', desc: 'تصغير HTML', color: 'blue' },
  { name: 'HTML Validator', slug: 'html-validator', desc: 'التحقق من HTML', color: 'green' },
  { name: 'HTML Preview', slug: 'html-preview', desc: 'معاينة HTML', color: 'purple' },
  { name: 'HTML Entity Encoder', slug: 'html-entity-encoder', desc: 'ترميز HTML Entities', color: 'cyan' },
  { name: 'HTML Entity Decoder', slug: 'html-entity-decoder', desc: 'فك ترميز HTML Entities', color: 'blue' },
  { name: 'HTML to Markdown', slug: 'html-to-markdown', desc: 'تحويل HTML إلى Markdown', color: 'green' },
  { name: 'Meta Tag Generator', slug: 'meta-tag-generator', desc: 'إنشاء Meta Tags', color: 'orange' },
  { name: 'Open Graph Generator', slug: 'open-graph-generator', desc: 'إنشاء Open Graph', color: 'purple' },
  { name: 'Favicon Generator', slug: 'favicon-generator', desc: 'إنشاء Favicon', color: 'cyan' },

  { name: 'CSS Formatter', slug: 'css-formatter', desc: 'تنسيق CSS', color: 'blue' },
  { name: 'CSS Minifier', slug: 'css-minifier', desc: 'تصغير CSS', color: 'cyan' },
  { name: 'CSS Gradient Generator', slug: 'css-gradient-generator', desc: 'إنشاء تدرجات CSS', color: 'purple' },
  { name: 'CSS Shadow Generator', slug: 'css-shadow-generator', desc: 'إنشاء ظلال CSS', color: 'green' },
  { name: 'CSS Border Radius', slug: 'css-border-radius', desc: 'إنشاء Border Radius', color: 'orange' },
  { name: 'CSS Color Generator', slug: 'css-color-generator', desc: 'إنشاء ألوان CSS', color: 'blue' },
  { name: 'CSS Flexbox Generator', slug: 'css-flexbox-generator', desc: 'مولد Flexbox', color: 'purple' },
  { name: 'CSS Grid Generator', slug: 'css-grid-generator', desc: 'مولد CSS Grid', color: 'green' },
  { name: 'CSS Clamp Generator', slug: 'css-clamp-generator', desc: 'إنشاء CSS Clamp', color: 'cyan' },
  { name: 'CSS Selector Tester', slug: 'css-selector-tester', desc: 'اختبار CSS Selectors', color: 'orange' },

  { name: 'JavaScript Formatter', slug: 'javascript-formatter', desc: 'تنسيق JavaScript', color: 'yellow' },
  { name: 'JavaScript Minifier', slug: 'javascript-minifier', desc: 'تصغير JavaScript', color: 'orange' },
  { name: 'JavaScript Validator', slug: 'javascript-validator', desc: 'التحقق من JavaScript', color: 'blue' },
  { name: 'JavaScript Playground', slug: 'javascript-playground', desc: 'تجربة JavaScript', color: 'yellow' },
  { name: 'TypeScript Formatter', slug: 'typescript-formatter', desc: 'تنسيق TypeScript', color: 'cyan' },
  { name: 'TypeScript Validator', slug: 'typescript-validator', desc: 'التحقق من TypeScript', color: 'blue' },
  { name: 'Code Formatter', slug: 'code-formatter', desc: 'تنسيق الأكواد', color: 'green' },
  { name: 'Code Minifier', slug: 'code-minifier', desc: 'تصغير الأكواد', color: 'purple' },
  { name: 'Code Diff', slug: 'code-diff', desc: 'مقارنة الأكواد', color: 'orange' },
  { name: 'Source Code Counter', slug: 'source-code-counter', desc: 'إحصائيات الكود', color: 'cyan' },

  { name: 'SQL Formatter', slug: 'sql-formatter', desc: 'تنسيق SQL', color: 'purple' },
  { name: 'SQL Minifier', slug: 'sql-minifier', desc: 'تصغير SQL', color: 'blue' },
  { name: 'SQL Validator', slug: 'sql-validator', desc: 'التحقق من SQL', color: 'green' },
  { name: 'SQL Query Builder', slug: 'sql-query-builder', desc: 'إنشاء استعلامات SQL', color: 'orange' },
  { name: 'YAML Formatter', slug: 'yaml-formatter', desc: 'تنسيق YAML', color: 'cyan' },
  { name: 'YAML Validator', slug: 'yaml-validator', desc: 'التحقق من YAML', color: 'blue' },
  { name: 'XML Formatter', slug: 'xml-formatter', desc: 'تنسيق XML', color: 'orange' },
  { name: 'XML Validator', slug: 'xml-validator', desc: 'التحقق من XML', color: 'green' },
  { name: 'Markdown Formatter', slug: 'markdown-formatter', desc: 'تنسيق Markdown', color: 'purple' },
  { name: 'Markdown Preview', slug: 'markdown-preview', desc: 'معاينة Markdown', color: 'cyan' },

  { name: 'Markdown to HTML', slug: 'markdown-to-html', desc: 'تحويل Markdown إلى HTML', color: 'blue' },
  { name: 'Lorem Ipsum Generator', slug: 'lorem-ipsum-generator', desc: 'إنشاء نص تجريبي', color: 'purple' },
  { name: 'Word Counter', slug: 'word-counter', desc: 'حساب الكلمات', color: 'green' },
  { name: 'Character Counter', slug: 'character-counter', desc: 'حساب الأحرف', color: 'orange' },
  { name: 'Line Counter', slug: 'line-counter', desc: 'حساب الأسطر', color: 'cyan' },
  { name: 'Text Case Converter', slug: 'text-case-converter', desc: 'تغيير حالة النص', color: 'blue' },
  { name: 'Text Cleaner', slug: 'text-cleaner', desc: 'تنظيف النصوص', color: 'green' },
  { name: 'Text Reverser', slug: 'text-reverser', desc: 'عكس النص', color: 'purple' },
  { name: 'Remove Duplicate Lines', slug: 'remove-duplicate-lines', desc: 'حذف الأسطر المتكررة', color: 'orange' },
  { name: 'Sort Lines', slug: 'sort-lines', desc: 'ترتيب الأسطر', color: 'cyan' },

  { name: 'Base64 Encoder', slug: 'base64-encoder', desc: 'ترميز Base64', color: 'blue' },
  { name: 'Base64 Decoder', slug: 'base64-decoder', desc: 'فك ترميز Base64', color: 'green' },
  { name: 'URL Encoder', slug: 'url-encoder', desc: 'ترميز URL', color: 'orange' },
  { name: 'URL Decoder', slug: 'url-decoder', desc: 'فك ترميز URL', color: 'purple' },
  { name: 'URL Parser', slug: 'url-parser', desc: 'تحليل URL', color: 'cyan' },
  { name: 'Query String Parser', slug: 'query-string-parser', desc: 'تحليل Query String', color: 'blue' },
  { name: 'JWT Decoder', slug: 'jwt-decoder', desc: 'قراءة JWT', color: 'purple' },
  { name: 'JWT Generator', slug: 'jwt-generator', desc: 'إنشاء JWT', color: 'green' },
  { name: 'UUID Generator', slug: 'uuid-generator', desc: 'إنشاء UUID', color: 'orange' },
  { name: 'Password Generator', slug: 'password-generator', desc: 'إنشاء كلمات مرور', color: 'cyan' },

  { name: 'Hash Generator', slug: 'hash-generator', desc: 'إنشاء Hash', color: 'purple' },
  { name: 'MD5 Generator', slug: 'md5-generator', desc: 'إنشاء MD5', color: 'blue' },
  { name: 'SHA256 Generator', slug: 'sha256-generator', desc: 'إنشاء SHA-256', color: 'green' },
  { name: 'SHA512 Generator', slug: 'sha512-generator', desc: 'إنشاء SHA-512', color: 'orange' },
  { name: 'Timestamp Converter', slug: 'timestamp-converter', desc: 'تحويل Unix Timestamp', color: 'cyan' },
  { name: 'Unix Timestamp', slug: 'unix-timestamp', desc: 'إنشاء Timestamp', color: 'blue' },
  { name: 'Date Formatter', slug: 'date-formatter', desc: 'تنسيق التاريخ', color: 'purple' },
  { name: 'Time Converter', slug: 'time-converter', desc: 'تحويل الوقت', color: 'green' },
  { name: 'Timezone Converter', slug: 'timezone-converter', desc: 'تحويل المناطق الزمنية', color: 'orange' },
  { name: 'Cron Generator', slug: 'cron-generator', desc: 'إنشاء Cron Expression', color: 'cyan' },

  { name: 'Color Converter', slug: 'color-converter', desc: 'تحويل الألوان', color: 'blue' },
  { name: 'HEX to RGB', slug: 'hex-to-rgb', desc: 'تحويل HEX إلى RGB', color: 'purple' },
  { name: 'RGB to HEX', slug: 'rgb-to-hex', desc: 'تحويل RGB إلى HEX', color: 'green' },
  { name: 'HEX to HSL', slug: 'hex-to-hsl', desc: 'تحويل HEX إلى HSL', color: 'orange' },
  { name: 'RGB to HSL', slug: 'rgb-to-hsl', desc: 'تحويل RGB إلى HSL', color: 'cyan' },
  { name: 'Color Palette', slug: 'color-palette', desc: 'إنشاء لوحة ألوان', color: 'blue' },
  { name: 'Contrast Checker', slug: 'contrast-checker', desc: 'فحص تباين الألوان', color: 'purple' },
  { name: 'QR Code Generator', slug: 'qr-code-generator', desc: 'إنشاء QR Code', color: 'green' },
  { name: 'Barcode Generator', slug: 'barcode-generator', desc: 'إنشاء Barcode', color: 'orange' },
  { name: 'ASCII Table', slug: 'ascii-table', desc: 'جدول ASCII', color: 'cyan' },

  { name: 'ASCII Converter', slug: 'ascii-converter', desc: 'تحويل ASCII', color: 'blue' },
  { name: 'Unicode Converter', slug: 'unicode-converter', desc: 'تحويل Unicode', color: 'purple' },
  { name: 'Text to Binary', slug: 'text-to-binary', desc: 'تحويل النص إلى Binary', color: 'green' },
  { name: 'Binary to Text', slug: 'binary-to-text', desc: 'تحويل Binary إلى نص', color: 'orange' },
  { name: 'Decimal to Binary', slug: 'decimal-to-binary', desc: 'Decimal إلى Binary', color: 'cyan' },
  { name: 'Binary to Decimal', slug: 'binary-to-decimal', desc: 'Binary إلى Decimal', color: 'blue' },
  { name: 'Hex to Decimal', slug: 'hex-to-decimal', desc: 'Hex إلى Decimal', color: 'purple' },
  { name: 'Decimal to Hex', slug: 'decimal-to-hex', desc: 'Decimal إلى Hex', color: 'green' },
  { name: 'Number Base Converter', slug: 'number-base-converter', desc: 'تحويل أنظمة الأعداد', color: 'orange' },
  { name: 'Regex Tester', slug: 'regex-tester', desc: 'اختبار Regex', color: 'cyan' }
];

const toolCount = tools.length;
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>أدوات المطورين | Th.Tech</title>

    <meta
      name="description"
      content="مجموعة كبيرة من أدوات المطورين المجانية والسريعة من Th.Tech."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/`}
    />

    <link
      rel="icon"
      type="image/png"
      href={`${base}/logo1.png`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- HERO -->
      <section class="hero">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <span>›</span>
          <strong>أدوات المطورين</strong>
        </div>

        <div class="hero-box">

          <div class="hero-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v14H4z"></path>
              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
              <path d="M8 17h3"></path>
            </svg>
          </div>

          <div class="hero-text">
            <span class="eyebrow">TH.TECH TOOLBOX</span>

            <h1>أدوات المطورين</h1>

            <p>
              أدوات تقنية سريعة ومجانية تساعدك على إنجاز مهامك اليومية
              مباشرة من المتصفح.
            </p>
          </div>

        </div>

      </section>


      <!-- SECTION HEADER -->
      <section class="tools-section">

        <div class="section-head">

          <div>
            <span class="section-label">DEVELOPER TOOLS</span>
            <h2>جميع الأدوات</h2>
          </div>

          <div class="count">
            <strong>{toolCount}</strong>
            <span>أداة</span>
          </div>

        </div>


        <!-- TOOLS -->
        <div class="tools-grid">

          {
            tools.map((tool, index) => (
              <a
                class={`tool-card ${tool.color}`}
                href={`${base}/tools/${tool.slug}/`}
                aria-label={tool.name}
              >

                <div class="tool-number">
                  {String(index + 1).padStart(2, '0')}
                </div>

                <div class="tool-icon">

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <rect
                      x="4"
                      y="4"
                      width="16"
                      height="16"
                      rx="4"
                    ></rect>

                    <path d="M8 9h8"></path>
                    <path d="M8 13h5"></path>
                    <path d="M8 16h3"></path>
                  </svg>

                </div>

                <div class="tool-info">

                  <h3>{tool.name}</h3>

                  <p>{tool.desc}</p>

                </div>

                <div class="tool-arrow">
                  ←
                </div>

              </a>
            ))
          }

        </div>

      </section>


      <!-- INFO -->
      <section class="info-box">

        <div class="info-icon">

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="9"
            ></circle>

            <path d="M12 8v4"></path>
            <circle
              cx="12"
              cy="16"
              r=".5"
            ></circle>
          </svg>

        </div>

        <div>

          <h2>أدوات مجانية وسريعة</h2>

          <p>
            اختر أي أداة بالضغط على البطاقة مباشرة.
            لا يوجد زر فتح منفصل، وكل بطاقة مرتبطة بصفحة الأداة الخاصة بها.
          </p>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(37, 99, 235, 0.06),
        transparent 30%
      ),
      #f6f8fc;
    color: #0f172a;
    font-family: "Cairo", sans-serif;
  }


  /* PAGE */

  .page {
    width: min(1200px, calc(100% - 32px));
    margin: 0 auto;
    padding: 30px 0 80px;
  }


  /* HERO */

  .hero {
    padding: 8px 0 35px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 28px;
    color: #64748b;
    font-size: 11px;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
    transition: color .2s ease;
  }

  .breadcrumb a:hover {
    color: #06b6d4;
  }

  .breadcrumb span {
    color: #94a3b8;
  }


  .hero-box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, .9);
    border-radius: 30px;
    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.98),
        rgba(248,250,252,.92)
      );
    box-shadow:
      0 15px 45px rgba(15, 23, 42, .07);
  }

  .hero-box::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    left: -80px;
    top: -90px;
    border-radius: 50%;
    background: rgba(37, 99, 235, .06);
    pointer-events: none;
  }


  .hero-icon {
    position: relative;
    width: 72px;
    height: 72px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background:
      linear-gradient(
        135deg,
        #2563eb,
        #06b6d4
      );
    box-shadow:
      0 15px 35px rgba(37, 99, 235, .22);
    animation: heroFloat 4s ease-in-out infinite;
  }

  .hero-icon svg {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: white;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes heroFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }

  }


  .hero-text {
    position: relative;
  }

  .eyebrow,
  .section-label {
    color: #2563eb;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .hero h1 {
    margin: 4px 0;
    font-size: clamp(27px, 4vw, 40px);
    line-height: 1.3;
    font-weight: 800;
  }

  .hero p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.8;
  }


  /* SECTION */

  .tools-section {
    margin-top: 10px;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .section-head h2 {
    margin: 3px 0 0;
    font-size: 21px;
    font-weight: 800;
  }

  .count {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #64748b;
    font-size: 11px;
  }

  .count strong {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 30px;
    padding: 0 9px;
    border-radius: 50px;
    background: #eaf1ff;
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
  }


  /* GRID */

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }


  /* CIRCULAR CARD */

  .tool-card {
    position: relative;
    aspect-ratio: 1 / 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow: hidden;

    border: 1px solid #e2e8f0;
    border-radius: 50%;

    background: rgba(255, 255, 255, .96);
    color: #0f172a;
    text-decoration: none;

    box-shadow:
      0 10px 28px rgba(15, 23, 42, .07);

    transition:
      transform .35s cubic-bezier(.2,.8,.2,1),
      box-shadow .35s ease,
      border-color .35s ease;
  }


  .tool-card::before {
    content: "";
    position: absolute;
    width: 55%;
    height: 55%;
    top: -22%;
    right: -15%;
    border-radius: 50%;
    background: currentColor;
    opacity: .035;
    transition:
      transform .45s ease,
      opacity .35s ease;
  }


  .tool-card::after {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px solid rgba(148, 163, 184, .12);
    pointer-events: none;
  }


  .tool-card:hover {
    transform:
      translateY(-8px)
      scale(1.025);

    border-color: rgba(37, 99, 235, .22);

    box-shadow:
      0 22px 50px rgba(15, 23, 42, .13);
  }

  .tool-card:hover::before {
    transform: scale(1.6);
    opacity: .07;
  }

  .tool-card:active {
    transform:
      translateY(-2px)
      scale(.98);
  }


  /* NUMBER */

  .tool-number {
    position: absolute;
    top: 15%;
    left: 20%;
    z-index: 2;

    color: #cbd5e1;
    font-size: 9px;
    font-weight: 700;

    transition:
      color .3s ease,
      transform .3s ease;
  }

  .tool-card:hover .tool-number {
    color: #94a3b8;
    transform: scale(1.1);
  }


  /* ICON */

  .tool-icon {
    position: relative;
    z-index: 2;

    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    transition:
      transform .35s cubic-bezier(.2,.8,.2,1),
      box-shadow .35s ease;
  }

  .tool-card:hover .tool-icon {
    transform:
      rotate(-8deg)
      scale(1.12);

    box-shadow:
      0 8px 22px rgba(15, 23, 42, .08);
  }

  .tool-icon svg {
    width: 28px;
    height: 28px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* CONTENT */

  .tool-info {
    position: relative;
    z-index: 2;

    width: 100%;
    margin-top: 11px;

    text-align: center;
  }

  .tool-info h3 {
    margin: 0;

    overflow: hidden;

    color: #0f172a;
    font-size: 12px;
    line-height: 1.45;
    font-weight: 800;

    text-overflow: ellipsis;
  }

  .tool-info p {
    margin: 5px 0 0;

    color: #64748b;
    font-size: 9px;
    line-height: 1.5;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    overflow: hidden;
  }


  /* ARROW */

  .tool-arrow {
    position: absolute;
    z-index: 3;

    left: 19%;
    bottom: 18%;

    width: 27px;
    height: 27px;

    display: flex;
    align-items: center;
