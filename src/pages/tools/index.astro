---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const pageTitle = "أدوات المطورين المجانية - Th.Tech";
const pageDesc =
  "مجموعة أدوات المطورين المجانية والسريعة: تنسيق JSON، التحقق من الصحة، تنسيق HTML وJavaScript، وعدّاد الكلمات.";

const tools = [
  {
    name: "JSON Formatter",
    slug: "json-formatter",
    icon: "fa-code",
    color: "#2563eb",
    desc: "تنسيق وتجميل ملفات JSON وتحويل JSON غير مرتب إلى كود مقروء مع التحقق من الصحة.",
    tags: ["JSON", "Format", "Developer"]
  },
  {
    name: "JSON Validator",
    slug: "json-validator",
    icon: "fa-check-circle",
    color: "#10b981",
    desc: "فحص أكواد JSON واكتشاف الأخطاء البرمجية.",
    tags: ["JSON", "Validate", "Debug"]
  },
  {
    name: "HTML Formatter",
    slug: "html-formatter",
    icon: "fa-html5",
    color: "#f97316",
    desc: "تنسيق كود HTML وجعله أكثر وضوحًا وتنظيمًا.",
    tags: ["HTML", "Beautify", "Minify"]
  },
  {
    name: "JavaScript Formatter",
    slug: "javascript-formatter",
    icon: "fa-js",
    color: "#eab308",
    desc: "تجميل وتنسيق كود JavaScript وتحويل الكود المضغوط إلى كود واضح.",
    tags: ["JS", "Code", "Format"]
  },
  {
    name: "Word Counter",
    slug: "word-counter",
    icon: "fa-font",
    color: "#8b5cf6",
    desc: "حساب الكلمات والأحرف والجمل والفقرات ووقت القراءة.",
    tags: ["Text", "Counter", "SEO"]
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <link rel="canonical" href={`https://th-tech.github.io${base}tools/`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
</head>

<body>

  <Header />

  <main>

    <section class="hero">
      <div class="container">
        <span class="hero-badge">
          <i class="fas fa-toolbox"></i>
          Th.Tech Tools
        </span>

        <h1>أدوات المطورين</h1>

        <p>
          أدوات مجانية وسريعة تساعدك على كتابة وفحص وتنسيق الأكواد
          مباشرة من المتصفح.
        </p>
      </div>
    </section>

    <section class="tools-section">
      <div class="container">

        <div class="tools-grid">

          {tools.map((tool) => (

            <a
              href={`${base}tools/${tool.slug}/`}
              class="tool-card"
              aria-label={`فتح ${tool.name}`}
            >

              <div class="card-header">

                <div
                  class="icon-box"
                  style={`background:${tool.color}18;color:${tool.color};`}
                >
                  <i class={`fas ${tool.icon}`}></i>
                </div>

                <div class="tags">
                  {tool.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>

              </div>

              <div class="card-body">

                <h2>{tool.name}</h2>

                <p>{tool.desc}</p>

              </div>

              <div class="card-footer">

                <span class="action-text">
                  فتح الأداة
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

            </a>

          ))}

        </div>

      </div>
    </section>

    <section class="info-section">

      <div class="container">

        <h2>لماذا Th.Tech Tools؟</h2>

        <div class="features-grid">

          <div class="feature">
            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>سريعة</h3>

            <p>
              الأدوات تعمل مباشرة داخل المتصفح بدون انتظار الخادم.
            </p>
          </div>

          <div class="feature">
            <div class="feature-icon">
              <i class="fas fa-lock"></i>
            </div>

            <h3>خصوصية</h3>

            <p>
              البيانات التي تدخلها في الأدوات لا تحتاج إلى رفعها إلى خادم.
            </p>
          </div>

          <div class="feature">
            <div class="feature-icon">
              <i class="fas fa-mobile-screen"></i>
            </div>

            <h3>متجاوبة</h3>

            <p>
              مصممة للعمل على الهاتف والكمبيوتر والتابلت.
            </p>
          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</body>
</html>

<style>

:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #f8fafc;
  color: #0f172a;
  font-family: 'Cairo', sans-serif;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: auto;
}

/* HERO */

.hero {
  text-align: center;
  padding: 70px 0 45px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  border-radius: 999px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 18px;
}

.hero h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 800;
}

.hero p {
  max-width: 650px;
  margin: auto;
  color: #64748b;
  font-size: 17px;
  line-height: 1.9;
}

/* GRID */

.tools-section {
  padding-bottom: 70px;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

/* CARD */

.tool-card {
  display: flex;
  flex-direction: column;
  min-height: 270px;
  padding: 24px;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  background: #fff;
  color: inherit;
  text-decoration: none;
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.tool-card:hover {
  transform: translateY(-5px);
  border-color: #2563eb;
  box-shadow: 0 15px 35px rgba(15,23,42,.10);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.icon-box {
  width: 54px;
  height: 54px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  font-size: 22px;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 5px;
}

.tag {
  padding: 3px 8px;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  color: #64748b;
  background: #f8fafc;
  font-size: 10px;
  font-weight: 700;
}

.card-body {
  flex: 1;
  padding-top: 25px;
}

.card-body h2 {
  margin: 0 0 8px;
  font-size: 20px;
  font-weight: 800;
}

.card-body p {
  margin: 0;
  color: #64748b;
  font-size: 14px;
  line-height: 1.8;
}

.card-footer {
  padding-top: 18px;
  margin-top: 20px;
  border-top: 1px solid #e2e8f0;
}

.action-text {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #2563eb;
  font-size: 14px;
  font-weight: 800;
}

.tool-card:hover .action-text i {
  transform: translateX(-5px);
}

.action-text i {
  transition: transform .2s ease;
}

/* INFO */

.info-section {
  padding: 70px 0;
  background: #fff;
  border-top: 1px solid #e2e8f0;
}

.info-section h2 {
  margin: 0 0 40px;
  text-align: center;
  font-size: 28px;
  font-weight: 800;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  text-align: center;
}

.feature {
  padding: 20px;
}

.feature-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22px;
}

.feature h3 {
  margin: 0 0 8px;
  font-size: 18px;
}

.feature p {
  margin: 0;
  color: #64748b;
  font-size: 14px;
  line-height: 1.8;
}

/* MOBILE */

@media (max-width: 900px) {

  .tools-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 600px) {

  .hero {
    padding: 45px 0 30px;
  }

  .tools-grid {
    grid-template-columns: 1fr;
  }

  .tool-card {
    min-height: 250px;
  }

  .tags {
    justify-content: flex-start;
  }

}

</style>
