<script>
  (() => {
    const searchInput = document.getElementById('toolSearch');
    const clearSearch = document.getElementById('clearSearch');
    const categories = document.getElementById('categories');
    const favoritesToggle = document.getElementById('favoritesToggle');
    const favoriteCount = document.getElementById('favoriteCount');
    const visibleCount = document.getElementById('visibleCount');
    const toolsGrid = document.getElementById('toolsGrid');
    const emptyState = document.getElementById('emptyState');
    const resetFilters = document.getElementById('resetFilters');

    if (
      !searchInput ||
      !clearSearch ||
      !categories ||
      !favoritesToggle ||
      !favoriteCount ||
      !visibleCount ||
      !toolsGrid ||
      !emptyState
    ) {
      return;
    }

    const cards = Array.from(
      toolsGrid.querySelectorAll('[data-tool-card]')
    );

    let activeCategory = 'All';
    let favoritesOnly = false;

    const STORAGE_KEY = 'thtech-developer-tools-favorites';

    const loadFavorites = () => {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);

        if (!stored) {
          return new Set();
        }

        const parsed = JSON.parse(stored);

        if (!Array.isArray(parsed)) {
          return new Set();
        }

        return new Set(parsed);
      } catch {
        return new Set();
      }
    };

    let favorites = loadFavorites();

    const saveFavorites = () => {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify([...favorites])
        );
      } catch {
        // localStorage may be unavailable.
      }
    };

    const updateFavoriteButtons = () => {
      cards.forEach((card) => {
        const slug = card.dataset.slug;
        const button = card.querySelector('[data-favorite]');

        if (!button || !slug) return;

        const active = favorites.has(slug);

        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));

        button.setAttribute(
          'aria-label',
          active
            ? 'إزالة الأداة من المفضلة'
            : 'إضافة الأداة إلى المفضلة'
        );

        button.setAttribute(
          'title',
          active
            ? 'إزالة من المفضلة'
            : 'إضافة إلى المفضلة'
        );
      });

      favoriteCount.textContent = String(favorites.size);
    };

    const updateCategoryButtons = () => {
      const buttons = categories.querySelectorAll('[data-category]');

      buttons.forEach((button) => {
        const active =
          button.dataset.category === activeCategory;

        button.classList.toggle('active', active);
        button.setAttribute(
          'aria-selected',
          String(active)
        );
      });
    };

    const updateClearButton = () => {
      const hasSearch = searchInput.value.trim().length > 0;

      clearSearch.classList.toggle(
        'visible',
        hasSearch
      );
    };

    const filterTools = () => {
      const query = searchInput.value
        .trim()
        .toLowerCase();

      let visible = 0;

      cards.forEach((card) => {
        const name =
          card.dataset.name || '';

        const desc =
          card.dataset.desc || '';

        const category =
          card.dataset.category || '';

        const slug =
          card.dataset.slug || '';

        const matchesSearch =
          !query ||
          name.includes(query) ||
          desc.includes(query) ||
          category.toLowerCase().includes(query) ||
          slug.includes(query);

        const matchesCategory =
          activeCategory === 'All' ||
          category === activeCategory;

        const matchesFavorites =
          !favoritesOnly ||
          favorites.has(slug);

        const shouldShow =
          matchesSearch &&
          matchesCategory &&
          matchesFavorites;

        card.classList.toggle(
          'hidden',
          !shouldShow
        );

        if (shouldShow) {
          visible++;
        }
      });

      visibleCount.textContent =
        String(visible);

      emptyState.hidden = visible !== 0;

      updateClearButton();
      updateCategoryButtons();
    };

    searchInput.addEventListener(
      'input',
      filterTools
    );

    clearSearch.addEventListener(
      'click',
      () => {
        searchInput.value = '';
        searchInput.focus();
        filterTools();
      }
    );

    categories.addEventListener(
      'click',
      (event) => {
        const button =
          event.target.closest('[data-category]');

        if (!button) return;

        activeCategory =
          button.dataset.category || 'All';

        filterTools();
      }
    );

    favoritesToggle.addEventListener(
      'click',
      () => {
        favoritesOnly = !favoritesOnly;

        favoritesToggle.classList.toggle(
          'active',
          favoritesOnly
        );

        favoritesToggle.setAttribute(
          'aria-pressed',
          String(favoritesOnly)
        );

        filterTools();
      }
    );

    toolsGrid.addEventListener(
      'click',
      (event) => {
        const button =
          event.target.closest('[data-favorite]');

        if (!button) return;

        event.preventDefault();
        event.stopPropagation();

        const slug =
          button.dataset.favorite;

        if (!slug) return;

        if (favorites.has(slug)) {
          favorites.delete(slug);
        } else {
          favorites.add(slug);
        }

        saveFavorites();
        updateFavoriteButtons();

        /*
         * Re-filter only when "المفضلة" mode is active.
         */
        if (favoritesOnly) {
          filterTools();
        }
      }
    );

    resetFilters?.addEventListener(
      'click',
      () => {
        searchInput.value = '';
        activeCategory = 'All';
        favoritesOnly = false;

        favoritesToggle.classList.remove(
          'active'
        );

        favoritesToggle.setAttribute(
          'aria-pressed',
          'false'
        );

        filterTools();
      }
    );

    /*
     * Keyboard shortcut:
     * "/" focuses the search box.
     */
    document.addEventListener(
      'keydown',
      (event) => {
        const target =
          event.target;

        const isTyping =
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target instanceof HTMLSelectElement ||
          target instanceof HTMLElement &&
          target.isContentEditable;

        if (
          event.key === '/' &&
          !isTyping
        ) {
          event.preventDefault();
          searchInput.focus();
        }

        if (
          event.key === 'Escape' &&
          document.activeElement === searchInput
        ) {
          searchInput.value = '';
          filterTools();
        }
      }
    );

    /*
     * Initial state.
     */
    updateFavoriteButtons();
    filterTools();

  })();
</script>
