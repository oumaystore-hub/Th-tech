const categories = [
{ name: 'الكل', value: 'all' },
{ name: 'JSON', value: 'json' },
{ name: 'HTML / CSS / JS', value: 'web' },
{ name: 'النصوص', value: 'text' },
{ name: 'الترميز والأمان', value: 'encoding' },
{ name: 'الشبكات', value: 'network' },
{ name: 'البيانات', value: 'data' },
{ name: 'الحسابات', value: 'utility' }
];

const categoryFor = (slug: string) => {
if (slug.startsWith('json')) return 'json';
if (
slug.includes('html') ||
slug.includes('javascript') ||
slug.startsWith('js-') ||
slug.includes('css-') ||
slug.includes('xml-')
) return 'web';
if (
slug.includes('word') ||
slug.includes('character') ||
slug.includes('line-') ||
slug.includes('text-') ||
slug.includes('lorem') ||
slug.includes('duplicate') ||
slug.includes('whitespace')
) return 'text';
if (
slug.includes('base64') ||
slug.includes('url-') ||
slug.includes('jwt') ||
slug.includes('oauth') ||
slug.includes('hash') ||
slug.includes('md5') ||
slug.includes('sha')
) return 'encoding';
if (
slug.includes('ip-') ||
slug.includes('ipv') ||
slug.includes('subnet') ||
slug.includes('mac-') ||
slug.includes('http-') ||
slug.includes('user-agent') ||
slug.includes('mime')
) return 'network';
if (
slug.includes('csv') ||
slug.includes('sql') ||
slug.includes('yaml') ||
slug.includes('markdown') ||
slug.includes('data-uri')
) return 'data';
return 'utility';
};

const toolsWithCategory = tools.map((tool) => ({
...tool,
category: categoryFor(tool.slug)
}));

