<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/`}
  />  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head><body>
  <Header />  <main class="page"><section class="hero">
  <div class="breadcrumb">
    <a href={`${base}/`}>الرئيسية</a>
    <span>›</span>
    <strong>أدوات المطورين</strong>
  </div>

  <div class="hero-content">
    <div class="hero-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 5h16v14H4z M8 9h8 M8 13h5" />
      </svg>
    </div>

    <div>
      <span class="eyebrow">TH.TECH DEVELOPER TOOLS</span>

      <h1>أدوات المطورين</h1>

      <p>
        مجموعة متكاملة من الأدوات السريعة والمجانية للمطورين
        وصناع المحتوى والتقنيين.
      </p>
    </div>
  </div>

  <div class="hero-line"></div>
</section>

<section class="tools-section">

  <div class="section-head">
    <div>
      <span class="section-label">TOOLBOX</span>
      <h2>جميع الأدوات</h2>
    </div>

    <div class="tool-count">
      <span>{tools.length}</span>
      أداة
    </div>
  </div>

  <div class="tools-grid">
    {
      tools.map((tool, index) => (
        <a
          class={`tool-card color-${tool.color}`}
          href={`${base}/tools/${tool.slug}/`}
          aria-label={tool.name}
        >
          <div class="card-glow"></div>

          <div class="tool-svg">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[tool.icon]} />
            </svg>
          </div>

          <div class="tool-number">
            {String(index + 1).padStart(2, '0')}
          </div>

          <div class="tool-info">
            <h3>{tool.name}</h3>
            <p>{tool.desc}</p>
          </div>

          <div class="arrow">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="bottom-info">
  <div class="info-icon">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 9 9 M12 7v5l3 2" />
    </svg>
  </div>

  <div>
    <h2>أدوات سريعة ومجانية</h2>
    <p>
      جميع الأدوات تعمل مباشرة من المتصفح وتهدف إلى تسريع
      المهام اليومية للمطورين دون الحاجة إلى تثبيت برامج إضافية.
    </p>
  </div>
</section>

  </main>  <Footer />
</body>
</html><style>
:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  background: #f6f8fc;
  color: #0f172a;
  font-family: "Cairo", sans-serif;
}

.page {
  width: min(1200px, calc(100% - 32px));
  margin: auto;
  padding: 32px 0 70px;
}

/* HERO */

.hero {
  position: relative;
  padding: 10px 0 35px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 28px;
  color: #64748b;
  font-size: 11px;
}

.breadcrumb a {
  color: #2563eb;
  text-decoration: none;
}

.breadcrumb span {
  color: #94a3b8;
}

.hero-content {
  display: flex;
  align-items: center;
  gap: 18px;
}

.hero-icon {
  width: 68px;
  height: 68px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  background: linear-gradient(135deg, #2563eb, #06b6d4);
  box-shadow: 0 15px 35px rgba(37, 99, 235, .20);
}

.hero-icon svg {
  width: 34px;
  height: 34px;
  fill: none;
  stroke: white;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.eyebrow,
.section-label {
  display: block;
  color: #2563eb;
  font-family: "Fira Code", monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
}

.hero h1 {
  margin: 3px 0 2px;
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.3;
  font-weight: 800;
}

.hero p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
}

.hero-line {
  width: 100%;
  height: 1px;
  margin-top: 30px;
  background: linear-gradient(
    90deg,
    transparent,
    #dbe4f0,
    transparent
  );
}

/* SECTION */

.tools-section {
  margin-top: 12px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-head h2 {
  margin: 2px 0 0;
  font-size: 21px;
  font-weight: 800;
}

.tool-count {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #64748b;
  font-size: 11px;
}

.tool-count span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 30px;
  padding: 0 8px;
  border-radius: 9px;
  background: #eaf1ff;
  color: #2563eb;
  font-family: "Fira Code", monospace;
  font-weight: 700;
}

/* GRID */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}

/* CARD */

.tool-card {
  position: relative;
  min-height: 118px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: #ffffff;
  color: #0f172a;
  text-decoration: none;
  box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.tool-card:hover {
  transform: translateY(-5px);
  border-color: #cbd5e1;
  box-shadow: 0 18px 40px rgba(15, 23, 42, .10);
}

.tool-card:active {
  transform: translateY(-1px) scale(.99);
}

.card-glow {
  position: absolute;
  width: 110px;
  height: 110px;
  top: -60px;
  left: -40px;
  border-radius: 50%;
  opacity: .10;
  transition: transform .35s ease;
}

.tool-card:hover .card-glow {
  transform: scale(1.7);
}

/* SVG */

.tool-svg {
  position: relative;
  z-index: 1;
  width: 52px;
  height: 52px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17px;
  transition: transform .3s ease;
}

.tool-card:hover .tool-svg {
  transform: rotate(-5deg) scale(1.08);
}

.tool-svg svg {
  width: 27px;
  height: 27px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* INFO */

.tool-info {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.tool-info h3 {
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
  font-weight: 800;
}

.tool-info p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 10px;
  line-height: 1.6;
}

.tool-number {
  position: absolute;
  z-index: 1;
  top: 9px;
  left: 12px;
  color: #cbd5e1;
  font-family: "Fira Code", monospace;
  font-size: 8px;
  font-weight: 600;
}

.arrow {
  position: relative;
  z-index: 1;
  width: 26px;
  height: 26px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  transition: .25s ease;
}

.arrow svg {
  width: 13px;
  height: 13px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.tool-card:hover .arrow {
  background: currentColor;
  color: white;
  transform: translateX(-3px);
}

/* COLORS */

.color-blue .tool-svg {
  background: #eaf1ff;
  color: #2563eb;
}

.color-blue .card-glow {
  background: #2563eb;
}

.color-green .tool-svg {
  background: #e9f9ef;
  color: #16a34a;
