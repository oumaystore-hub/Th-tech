<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>أدوات المطورين | Th.Tech</title>
    <meta name="description" content="مجموعة متكاملة من أدوات المطورين المجانية والسريعة." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://oumaystore-hub.github.io${base}/tools/`} />
    <link rel="icon" type="image/png" href={`${base}/logo1.png`} /><link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

  </head>  <body>
    <Header /><main class="page">
  <section class="hero">
    <div class="breadcrumb">
      <a href={`${base}/`}>الرئيسية</a>
      <span>›</span>
      <strong>أدوات المطورين</strong>
    </div>

    <div class="hero-content">
      <div class="hero-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 5h16v14H4z" />
          <path d="M8 9h8M8 13h5" />
          <path d="M8 17h3" />
        </svg>
      </div>

      <div>
        <span class="eyebrow">TH.TECH DEVELOPER TOOLS</span>
        <h1>أدوات المطورين</h1>
        <p>
          مجموعة احترافية من الأدوات السريعة والمجانية للمطورين وصناع المحتوى والتقنيين.
        </p>
      </div>
    </div>
  </section>

  <section class="tools-section">
    <div class="section-head">
      <div>
        <span class="section-label">TOOLBOX</span>
        <h2>جميع الأدوات</h2>
      </div>

      <div class="count">
        <span id="toolCount">{tools.length}</span>
        أداة
      </div>
    </div>

    <div class="controls">
      <div class="search-box">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-4-4" />
        </svg>

        <input
          id="searchInput"
          type="search"
          placeholder="ابحث عن أداة..."
          aria-label="البحث عن أداة"
        />
      </div>

      <div class="categories" id="categories">
        {
          categories.map((category, index) => (
            <button
              type="button"
              class:list={{ active: index === 0 }}
              data-category={category}
            >
              {category}
            </button>
          ))
        }
      </div>
    </div>

    <div class="tools-grid" id="toolsGrid">
      {
        tools.map((tool, index) => (
          <a
            href={`${base}/tools/${tool.slug}/`}
            class={`tool-card ${tool.color}`}
            data-name={tool.name.toLowerCase()}
            data-description={tool.desc.toLowerCase()}
            data-category={tool.cat}
          >
            <span class="number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <span class="icon">
              {tool.icon === 'braces' && (
                <svg viewBox="0 0 24 24">
                  <path d="M8 4c-2 0-2 2-2 4v1c0 2-1 3-3 3 2 0 3 1 3 3v1c0 2 0 4 2 4" />
                  <path d="M16 4c2 0 2 2 2 4v1c0 2 1 3 3 3-2 0-3 1-3 3v1c0 2 0 4-2 4" />
                </svg>
              )}

              {tool.icon === 'check' && (
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8 12 3 3 5-6" />
                </svg>
              )}

              {tool.icon === 'compress' && (
                <svg viewBox="0 0 24 24">
                  <path d="M8 3v5H3M16 3v5h5M8 21v-5H3M16 21v-5h5" />
                  <path d="M3 8l5-5M21 8l-5-5M3 16l5 5M21 16l-5 5" />
                </svg>
              )}

              {tool.icon === 'convert' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h13l-3-3M20 17H7l3 3" />
                  <path d="M17 4v3M7 17v3" />
                </svg>
              )}

              {tool.icon === 'table' && (
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="14" rx="2" />
                  <path d="M4 10h16M10 5v14M16 5v14" />
                </svg>
              )}

              {tool.icon === 'xml' && (
                <svg viewBox="0 0 24 24">
                  <path d="m9 7-5 5 5 5M15 7l5 5-5 5M13 5l-2 14" />
                </svg>
              )}

              {tool.icon === 'diff' && (
                <svg viewBox="0 0 24 24">
                  <path d="M5 5h14M5 9h8M5 13h14M5 17h9" />
                  <path d="M18 8v8M15 11h6" />
                </svg>
              )}

              {tool.icon === 'search' && (
                <svg viewBox="0 0 24 24">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="m16 16 5 5" />
                </svg>
              )}

              {tool.icon === 'code' && (
                <svg viewBox="0 0 24 24">
                  <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" />
                </svg>
              )}

              {tool.icon === 'html' && (
                <svg viewBox="0 0 24 24">
                  <path d="m8 5-5 7 5 7M16 5l5 7-5 7M13 3l-2 18" />
                </svg>
              )}

              {tool.icon === 'encode' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h16M4 12h10M4 17h16" />
                  <circle cx="17" cy="12" r="3" />
                </svg>
              )}

              {tool.icon === 'decode' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h16M4 12h10M4 17h16" />
                  <path d="m18 9 3 3-3 3" />
                </svg>
              )}

              {tool.icon === 'eye' && (
                <svg viewBox="0 0 24 24">
                  <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              )}

              {tool.icon === 'tag' && (
                <svg viewBox="0 0 24 24">
                  <path d="M4 5v7l8 8 8-8-8-8H4Z" />
                  <circle cx="8" cy="9" r="1" />
                </svg>
              )}

              {tool.icon === 'share' && (
                <svg viewBox="0 0 24 24">
                  <circle cx="18" cy="5" r="2.5" />
                  <circle cx="6" cy="12" r="2.5" />
                  <circle cx="18" cy="19" r="2.5" />
                  <path d="m8.2 10.8 7.5-4.5M8.2 13.2l7.5 4.5" />
                </svg>
              )}

              {tool.icon === 'star' && (
                <svg viewBox="0 0 24 24">
                  <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" />
                </svg>
              )}

              {tool.icon === 'css' && (
                <svg viewBox="0 0 24 24">
                  <path d="m5 4 1.5 16L12 22l5.5-2L19 4H5Z" />
                  <path d="M8 8h8M8.5 12h7M9 16h6" />
                </svg>
              )}

              {tool.icon === 'js' && (
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="4" width="16" height="16" rx="2" />
                  <path d="M9 9v6c0 1-1 2-2 2M13 17c2 1 4 0 4-2 0-2-1-2-3-3-2-1-1-3 1-3 1 0 2 0 2 1" />
                </svg>
              )}

              {tool.icon === 'wand' && (
                <svg viewBox="0 0 24 24">
                  <path d="m5 19 14-14" />
                  <path d="m16 3 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z" />
                </svg>
