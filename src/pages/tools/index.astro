---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "أدوات المطورين المجانية - Th.Tech";
const pageDesc = "مجموعة أدوات المطورين المجانية والسريعة: تنسيق JSON، التحقق من الصحة، تنسيق HTML و JavaScript، وعدّاد الكلمات. أدوات بسيطة تعمل على المتصفح مباشرة.";

// قائمة الأدوات (سنزيد هنا لاحقاً)
const tools = [
  {
    name: "JSON Formatter",
    slug: "json-formatter",
    icon: "fa-code", // Font Awesome class
    color: "#2563eb", // Blue
    desc: "تنسيق وتجميل ملفات JSON. تحويل JSON غير مرتب إلى كود مقروء، Minify، والتحقق من الصحة.",
    tags: ["JSON", "Format", "Validator"]
  },
  {
    name: "JSON Validator",
    slug: "json-validator",
    icon: "fa-check-circle",
    color: "#10b981", // Green
    desc: "فحص أكواد JSON واكتشاف الأخطاء البرمجية بدقة. معرفة رقم السطر والعمود للخطأ.",
    tags: ["JSON", "Validate", "Debug"]
  },
  {
    name: "HTML Formatter",
    slug: "html-formatter",
    icon: "fa-html5",
    color: "#f97316", // Orange
    desc: "تنسيق كود HTML وجعله قابلاً للقراءة. إزالة المسافات الزائدة (Minify) أو تجميل الكود.",
    tags: ["HTML", "Beautify", "Minify"]
  },
  {
    name: "JavaScript Formatter",
    slug: "javascript-formatter",
    icon: "fa-js",
    color: "#eab308", // Yellow
    desc: "تجميل وتنسيق كود JavaScript. تحويل الكود المضغوط إلى هيكل واضح ومنظم.",
    tags: ["JS", "Code", "Format"]
  },
  {
    name: "Word Counter",
    slug: "word-counter",
    icon: "fa-font",
    color: "#8b5cf6", // Purple
    desc: "أداة لحساب عدد الكلمات، الأحرف، الجمل، والفقرات، بالإضافة إلى وقت القراءة التقديري.",
    tags: ["Text", "Counter", "SEO"]
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href="https://th-tech.github.io/tools/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://th-tech.github.io/tools/" />
</head>
<body>
  <Header />

  <main class="tools-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <h1>️ أدوات المطورين</h1>
        <p>أدوات مجانية، سريعة، وآمنة تعمل مباشرة داخل المتصفح.</p>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="tools-section">
      <div class="container">
        <div class="tools-grid">
          {tools.map((tool) => (
            <a href={`/tools/${tool.slug}/`} class="tool-card">
              <div class="card-header">
                <div class="icon-box" style={`background: ${tool.color}15; color: ${tool.color};`}>
                  <i class={`fas ${tool.icon}`}></i>
                </div>
                <div class="tags">
                  {tool.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              </div>
              <div class="card-body">
                <h2>{tool.name}</h2>
                <p>{tool.desc}</p>
              </div>
              <div class="card-footer">
                <span class="action-text">
                  فتح الأداة <i class="fas fa-arrow-left"></i>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content / Intro -->
    <section class="info-section">
      <div class="container">
        <h2>لماذا استخدام أدوات Th.Tech؟</h2>
        <div class="features-grid">
          <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>سرعة فائقة</h3>
            <p>لا داعي لرفع ملفات أو انتظار الخوادم. كل شيء يعمل على جهازك فوراً.</p>
          </div>
          <div class="feature">
            <i class="fas fa-lock"></i>
            <h3>خصوصية تامة</h3>
            <p>بياناتك لا تغادر متصفحك. لا نقوم بتخزين أي أكواد أو مدخلات.</p>
          </div>
          <div class="feature">
            <i class="fas fa-mobile-alt"></i>
            <h3>متجاوب بالكامل</h3>
            <p>استخدم الأدوات من هاتفك المحمول أو الكمبيوتر بكفاءة عالية.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card-bg: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --primary: #2563eb;
    --border: #e2e8f0;
    --radius: 16px;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card-bg: #1e293b;
    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --primary: #3b82f6;
    --border: #334155;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  body {
    background: var(--bg);
    color: var(--text-main);
    font-family: 'Cairo', sans-serif;
    line-height: 1.6;
    transition: background 0.3s, color 0.3s;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .tools-page {
    padding-bottom: 4rem;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 4rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .hero p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Tools Grid */
  .tools-section {
    margin-bottom: 4rem;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  /* Tool Card */
  .tool-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    height: 100%;
  }

  .tool-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
    border-color: var(--primary);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .icon-box {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    font-size: 0.7rem;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    color: var(--text-muted);
    font-weight: 600;
  }

  .card-body h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-body p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .action-text {
    font-weight: 700;
    color: var(--primary);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .action-text i {
    font-size: 0.8rem;
    transition: transform 0.2s;
  }

  .tool-card:hover .action-text i {
    transform: translateX(-4px); /* RTL flip logic handled by transform direction usually, but here simple shift */
  }

  /* Info Section */
  .info-section {
    background: var(--card-bg);
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }
  
  .info-section h2 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 2rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    text-align: center;
  }

  .feature i {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .feature h3 {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .feature p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .hero h1 { font-size: 2rem; }
    .tools-grid { grid-template-columns: 1fr; }
    .card-header { flex-direction: column; gap: 1rem; }
    .tags { justify-content: flex-start; }
  }
</style>
