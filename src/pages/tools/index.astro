  </section></main><Footer /><style>

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(37, 99, 235, .12),
      transparent 45%
    ),
    #f5f8fc;
  color: #0f172a;
  font-family: Arial, "Cairo", sans-serif;
}


.tools-page {
  width: min(1180px, calc(100% - 30px));
  margin: auto;
  padding: 35px 0 80px;
}


/* HERO */

.hero {
  text-align: center;
  padding: 25px 10px 48px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border: 1px solid rgba(37, 99, 235, .15);
  border-radius: 999px;
  background: rgba(37, 99, 235, .06);
  color: #2563eb;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .6px;
}

.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  animation: pulse 2s infinite;
}

.hero h1 {
  margin: 20px 0 8px;
  font-size: clamp(30px, 5vw, 46px);
  line-height: 1.3;
  font-weight: 800;
}

.hero h1 strong {
  display: block;
  background: linear-gradient(
    90deg,
    #2563eb,
    #7c3aed
  );
  -webkit-background-clip: text;
