  <script is:inline>
    (() => {
      const input = document.getElementById("input");
      const output = document.getElementById("output");

      const fromBase = document.getElementById("fromBase");
      const toBase = document.getElementById("toBase");

      const fromName = document.getElementById("fromName");
      const toName = document.getElementById("toName");

      const fromLabel = document.getElementById("fromLabel");
      const toLabel = document.getElementById("toLabel");

      const inputHint = document.getElementById("inputHint");
      const inputLength = document.getElementById("inputLength");
      const outputLength = document.getElementById("outputLength");

      const convertBtn = document.getElementById("convertBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const copyBtn = document.getElementById("copyBtn");
      const resetBtn = document.getElementById("resetBtn");

      const status = document.getElementById("status");

      const inputDigits = document.getElementById("inputDigits");
      const outputDigits = document.getElementById("outputDigits");
      const bits = document.getElementById("bits");
      const bytes = document.getElementById("bytes");

      const baseNames = {
        2: "Binary",
        8: "Octal",
        10: "Decimal",
        16: "Hexadecimal"
      };

      const examples = {
        "2": "101101",
        "8": "755",
        "10": "255",
        "16": "FF"
      };

      function cleanValue(value) {
        return value
          .trim()
          .replace(/\s+/gu, "")
          .replace(/^0x/iu, "");
      }

      function getAllowedPattern(base) {
        if (base === 2) return /^[01]+$/u;
        if (base === 8) return /^[0-7]+$/u;
        if (base === 10) return /^\d+$/u;
        if (base === 16) return /^[0-9a-f]+$/iu;
        return /^$/u;
      }

      function updateNames() {
        const from = Number(fromBase.value);
        const to = Number(toBase.value);

        fromName.textContent = baseNames[from];
        toName.textContent = baseNames[to];

        fromLabel.textContent = `BASE ${from}`;
        toLabel.textContent = `BASE ${to}`;

        if (from === 2) {
          inputHint.textContent = "الأرقام المسموحة: 0 و1";
        } else if (from === 8) {
          inputHint.textContent = "الأرقام المسموحة: 0–7";
        } else if (from === 10) {
          inputHint.textContent = "الأرقام المسموحة: 0–9";
        } else {
          inputHint.textContent = "الأرقام المسموحة: 0–9 و A–F";
        }

        output.value = "";
        outputLength.textContent = "0 رمز";
        inputDigits.textContent = "0";
        outputDigits.textContent = "0";
        bits.textContent = "0";
        bytes.textContent = "0";

        setStatus(
          "info",
          "أدخل قيمة جديدة ثم اضغط على تحويل الآن."
        );
      }

      function setStatus(type, message) {
        status.className = "status";

        if (type === "success") {
          status.classList.add("success");
        }

        if (type === "error") {
          status.classList.add("error");
        }

        const icon = status.querySelector("i");
        const text = status.querySelector("span");

        if (type === "success") {
          icon.className = "fa-solid fa-circle-check";
        } else if (type === "error") {
          icon.className = "fa-solid fa-circle-exclamation";
        } else {
          icon.className = "fa-solid fa-circle-info";
        }

        text.textContent = message;
      }

      function updateStats(value, result) {
        inputDigits.textContent = value.length.toLocaleString("ar");
        outputDigits.textContent = result.length.toLocaleString("ar");

        let bitCount = 1;

        try {
          const decimalValue = BigInt(`0x${value}`);

          if (decimalValue > 0n) {
            bitCount = decimalValue.toString(2).length;
          }
        } catch {
          bitCount = Math.max(1, value.length);
        }

        const byteCount = Math.max(1, Math.ceil(bitCount / 8));

        bits.textContent = bitCount.toLocaleString("ar");
        bytes.textContent = byteCount.toLocaleString("ar");
      }

      function convert() {
        const raw = cleanValue(input.value);
        const sourceBase = Number(fromBase.value);
        const targetBase = Number(toBase.value);

        inputLength.textContent =
          `${raw.length.toLocaleString("ar")} رمز`;

        if (!raw) {
          output.value = "";
          outputLength.textContent = "0 رمز";

          inputDigits.textContent = "0";
          outputDigits.textContent = "0";
          bits.textContent = "0";
          bytes.textContent = "0";

          setStatus("info", "أدخل قيمة أولًا لبدء التحويل.");
          return;
        }

        const pattern = getAllowedPattern(sourceBase);

        if (!pattern.test(raw)) {
          output.value = "";
          outputLength.textContent = "0 رمز";

          setStatus(
            "error",
            `القيمة غير صالحة لنظام ${baseNames[sourceBase]}. تحقق من الرموز المسموحة.`
          );
          return;
        }

        try {
          const decimalValue = BigInt(
            parseInt(raw, sourceBase)
          );

          /*
           * parseInt + BigInt قد يفقد الدقة مع الأعداد الكبيرة،
           * لذلك نستخدم تحويلًا يدويًا من المصدر إلى BigInt.
           */
          let exactValue = 0n;

          for (const char of raw.toUpperCase()) {
            let digit;

            if (char >= "0" && char <= "9") {
              digit = BigInt(char.charCodeAt(0) - 48);
            } else {
              digit = BigInt(char.charCodeAt(0) - 55);
            }

            exactValue = exactValue * BigInt(sourceBase) + digit;
          }

          const result = exactValue
            .toString(targetBase)
            .toUpperCase();

          output.value = result;

          outputLength.textContent =
            `${result.length.toLocaleString("ar")} رمز`;

          updateStats(raw, result);

          setStatus(
            "success",
            `${baseNames[sourceBase]} → ${baseNames[targetBase]} تم التحويل بنجاح.`
          );

          void decimalValue;
        } catch {
          output.value = "";
          outputLength.textContent = "0 رمز";

          setStatus(
            "error",
            "تعذر تحويل القيمة. تحقق من الرقم وحاول مرة أخرى."
          );
        }
      }

      function copyOutput() {
        if (!output.value) {
          setStatus("info", "لا توجد نتيجة لنسخها.");
          return;
        }

        const copyText = output.value;

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(copyText)
            .then(() => {
              setStatus("success", "تم نسخ النتيجة إلى الحافظة.");
            })
            .catch(() => fallbackCopy(copyText));
        } else {
          fallbackCopy(copyText);
        }
      }

      function fallbackCopy(text) {
        output.focus();
        output.select();

        try {
          document.execCommand("copy");
          setStatus("success", "تم نسخ النتيجة إلى الحافظة.");
        } catch {
          setStatus("error", "تعذر النسخ تلقائيًا. انسخ النتيجة يدويًا.");
        }
      }

      function loadExample() {
        const sourceBase = fromBase.value;

        input.value = examples[sourceBase] || "255";

        convert();
      }

      function reset() {
        input.value = "";
        output.value = "";

        inputLength.textContent = "0 رمز";
        outputLength.textContent = "0 رمز";

        inputDigits.textContent = "0";
        outputDigits.textContent = "0";
        bits.textContent = "0";
        bytes.textContent = "0";

        setStatus(
          "info",
          "تمت إعادة ضبط الأداة. أدخل قيمة جديدة للبدء."
        );

        input.focus();
      }

      fromBase.addEventListener("change", updateNames);
      toBase.addEventListener("change", updateNames);

      input.addEventListener("input", () => {
        const raw = cleanValue(input.value);

        inputLength.textContent =
          `${raw.length.toLocaleString("ar")} رمز`;
      });

      input.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();
          convert();
        }
      });

      convertBtn.addEventListener("click", convert);
      exampleBtn.addEventListener("click", loadExample);
      copyBtn.addEventListener("click", copyOutput);
      resetBtn.addEventListener("click", reset);

      updateNames();
    })();
  </script>
</body>
</html>
