---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Number Base Converter | محول أنظمة الأعداد | Th.Tech";
const description =
  "محول أنظمة الأعداد المجاني لتحويل القيم بين Binary وDecimal وOctal وHexadecimal بسرعة ودقة، مع معالجة محلية داخل المتصفح.";
const canonical =
  `https://oumaystore-hub.github.io${base}/tools/number-base-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        } else {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>

  <style>
    :root {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --text: #102033;
      --muted: #64748b;
      --border: #dce7f3;
      --primary: #2563eb;
      --primary-2: #3b82f6;
      --cyan: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --code: #eef4fb;
      --shadow: 0 18px 50px rgba(37, 99, 235, 0.08);
    }

    html.dark-mode,
    html:not([data-theme="light"]).dark-mode {
      --bg: #07111f;
      --surface: #0d1b2a;
      --surface-2: #101f31;
      --text: #e8f1fb;
      --muted: #91a4b9;
      --border: #20364c;
      --primary: #60a5fa;
      --primary-2: #3b82f6;
      --cyan: #22d3ee;
      --success: #34d399;
      --danger: #f87171;
      --warning: #fbbf24;
      --code: #081522;
      --shadow: 0 18px 50px rgba(0, 0, 0, 0.25);
    }

    html[data-theme="light"] {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --text: #102033;
      --muted: #64748b;
      --border: #dce7f3;
      --primary: #2563eb;
      --primary-2: #3b82f6;
      --cyan: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --code: #eef4fb;
      --shadow: 0 18px 50px rgba(37, 99, 235, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at 10% 0%, rgba(37, 99, 235, 0.08), transparent 28%),
        radial-gradient(circle at 90% 10%, rgba(6, 182, 212, 0.07), transparent 25%),
        var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      transition: background 0.25s ease, color 0.25s ease;
    }

    button,
    textarea,
    select,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .page {
      min-height: 100vh;
      padding: 34px 18px 70px;
    }

    .container {
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
    }

    .breadcrumb i {
      font-size: 0.7rem;
      opacity: 0.7;
    }

    .hero {
      position: relative;
      text-align: center;
      padding: 26px 10px 34px;
    }

    .hero-icon {
      width: 74px;
      height: 74px;
      margin: 0 auto 18px;
      border-radius: 22px;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 1.8rem;
      background: linear-gradient(135deg, var(--primary), var(--cyan));
      box-shadow: 0 18px 38px rgba(37, 99, 235, 0.23);
      animation: floatIcon 4s ease-in-out infinite;
    }

    @keyframes floatIcon {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    .eyebrow {
      color: var(--primary);
      font-weight: 800;
      font-size: 0.88rem;
      margin-bottom: 7px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 3.3rem);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.7px;
    }

    .hero p {
      max-width: 760px;
      margin: 14px auto 0;
      color: var(--muted);
      font-size: 1.03rem;
    }

    .tags {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }

    .tag {
      padding: 6px 11px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
      box-shadow: 0 5px 18px rgba(37, 99, 235, 0.04);
    }

    .tool-card,
    .info-section,
    .privacy-card,
    .how-card,
    .faq-section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .tool-card {
      padding: 24px;
      overflow: hidden;
    }

    .tool-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 20px;
    }

    .tool-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .tool-title-icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
      font-size: 1.05rem;
    }

    .tool-title h2 {
      margin: 0;
      font-size: 1.2rem;
    }

    .tool-title p {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      color: var(--success);
      background: rgba(16, 185, 129, 0.09);
      font-size: 0.76rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      animation: pulse 1.6s infinite;
    }

    @keyframes pulse {
      50% { opacity: 0.35; transform: scale(0.8); }
    }

    .settings {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .setting-box {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 12px;
    }

    .setting-box label {
      display: block;
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    select {
      width: 100%;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      border-radius: 11px;
      padding: 10px 12px;
      outline: none;
    }

    select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .editor-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .panel {
      min-width: 0;
      border: 1px solid var(--border);
      background: var(--surface-2);
      border-radius: 18px;
      overflow: hidden;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
    }

    .panel-name {
      display: flex;
      align-items: center;
      gap: 9px;
      font-weight: 800;
      font-size: 0.9rem;
    }

    .panel-name i {
      color: var(--primary);
    }

    .base-label {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.7rem;
      color: var(--muted);
      background: var(--code);
      padding: 4px 7px;
      border-radius: 7px;
    }

    textarea {
      width: 100%;
      min-height: 260px;
      resize: vertical;
      display: block;
      border: 0;
      outline: 0;
      padding: 18px;
      background: transparent;
      color: var(--text);
      font-family: "JetBrains Mono", monospace;
      font-size: 1rem;
      line-height: 1.8;
      direction: ltr;
      text-align: left;
    }

    textarea::placeholder {
      color: var(--muted);
      opacity: 0.75;
    }

    #output {
      background: rgba(37, 99, 235, 0.025);
    }

    .panel-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 9px 12px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.72rem;
    }

    .actions {
      display: grid;
      grid-template-columns: 1.25fr 1fr 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
    }

    .btn {
      min-height: 46px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface);
      color: var(--text);
      font-weight: 800;
      transition: transform 0.18s ease, border-color 0.18s ease,
        background 0.18s ease, box-shadow 0.18s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
    }

    .btn-primary {
      border-color: transparent;
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
    }

    .btn-primary:hover {
      border-color: transparent;
      box-shadow: 0 13px 30px rgba(37, 99, 235, 0.28);
    }

    .btn i {
      margin-left: 6px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 48px;
      margin-top: 13px;
      padding: 11px 14px;
      border-radius: 13px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.82rem;
    }

    .status.success {
      color: var(--success);
      border-color: rgba(16, 185, 129, 0.25);
      background: rgba(16, 185, 129, 0.06);
    }

    .status.error {
      color: var(--danger);
      border-color: rgba(239, 68, 68, 0.25);
      background: rgba(239, 68, 68, 0.06);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 15px;
    }

    .stat {
      padding: 15px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      border-radius: 15px;
      text-align: center;
    }

    .stat-value {
      display: block;
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 1.1rem;
      font-weight: 800;
      direction: ltr;
    }

    .stat-label {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.72rem;
    }

    .privacy-card {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 17px 20px;
      margin-top: 18px;
    }

    .privacy-icon {
      flex: 0 0 auto;
      width: 43px;
      height: 43px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      color: var(--success);
      background: rgba(16, 185, 129, 0.1);
    }

    .privacy-card strong {
      display: block;
      font-size: 0.9rem;
    }

    .privacy-card span {
      color: var(--muted);
      font-size: 0.77rem;
    }

    .info-section {
      padding: 27px;
      margin-top: 20px;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 22px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 1.45rem;
    }

    .section-heading p {
      color: var(--muted);
      margin: 7px auto 0;
      max-width: 700px;
      font-size: 0.9rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 13px;
    }

    .info-box {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface-2);
    }

    .info-box-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(37, 99, 235, 0.1);
      color: var(--primary);
      margin-bottom: 12px;
    }

    .info-box h3 {
      margin: 0 0 5px;
      font-size: 0.96rem;
    }

    .info-box p {
      margin: 0;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .how-card {
      padding: 27px;
      margin-top: 20px;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .step {
      position: relative;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface-2);
    }

    .step-number {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--cyan));
      font-family: "JetBrains Mono", monospace;
      font-weight: 800;
      margin-bottom: 11px;
    }

    .step h3 {
      margin: 0 0 5px;
      font-size: 0.93rem;
    }

    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 0.79rem;
    }

    .faq-section {
      padding: 27px;
      margin-top: 20px;
    }

    .faq-list {
      display: grid;
      gap: 10px;
      max-width: 850px;
      margin: 0 auto;
    }

    details {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
      overflow: hidden;
    }

    summary {
      cursor: pointer;
      list-style: none;
      padding: 15px 17px;
      font-weight: 800;
      font-size: 0.88rem;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::after {
      content: "+";
      float: left;
      color: var(--primary);
      font-size: 1.1rem;
    }

    details[open] summary::after {
      content: "−";
    }

    details p {
      margin: 0;
      padding: 0 17px 16px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    @media (max-width: 850px) {
      .editor-grid,
      .settings,
      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .actions {
        grid-template-columns: 1fr 1fr;
      }

      .tool-header {
        align-items: flex-start;
      }
    }

    @media (max-width: 600px) {
      .page {
        padding: 22px 11px 45px;
      }

      .hero {
        padding: 18px 5px 25px;
      }

      .hero-icon {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        font-size: 1.45rem;
      }

      .hero p {
        font-size: 0.9rem;
      }

      .tool-card,
      .info-section,
      .privacy-card,
      .how-card,
      .faq-section {
        border-radius: 18px;
        padding: 17px;
      }

      .live-badge {
        font-size: 0.68rem;
      }

      textarea {
        min-height: 220px;
        padding: 15px;
      }

      .actions {
        grid-template-columns: 1fr;
      }

      .stats-grid {
        gap: 8px;
      }

      .stat {
        padding: 12px 8px;
      }

      .privacy-card {
        align-items: flex-start;
      }
    }

    @media (max-width: 390px) {
      .tool-header {
        flex-direction: column;
      }

      .live-badge {
        align-self: flex-start;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="page">
    <div class="container">

      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>Number Base Converter</span>
      </nav>

      <section class="hero">
        <div class="hero-icon">
          <i class="fa-solid fa-code-compare"></i>
        </div>

        <div class="eyebrow">محول أنظمة الأعداد</div>

        <h1>Number Base Converter</h1>

        <p>
          حوّل الأرقام بسهولة بين Binary وDecimal وOctal وHexadecimal
          باستخدام أداة سريعة ودقيقة تعمل بالكامل داخل المتصفح.
        </p>

        <div class="tags">
          <span class="tag">Binary</span>
          <span class="tag">Decimal</span>
          <span class="tag">Octal</span>
          <span class="tag">Hexadecimal</span>
          <span class="tag">Local Processing</span>
        </div>
      </section>

      <section class="tool-card">
        <div class="tool-header">
          <div class="tool-title">
            <div class="tool-title-icon">
              <i class="fa-solid fa-arrows-left-right"></i>
            </div>

            <div>
              <h2>تحويل أنظمة الأعداد</h2>
              <p>اختر النظامين ثم أدخل القيمة للتحويل الفوري</p>
            </div>
          </div>

          <div class="live-badge">
            <span class="live-dot"></span>
            تحويل فوري
          </div>
        </div>

        <div class="settings">
          <div class="setting-box">
            <label for="fromBase">النظام المصدر</label>

            <select id="fromBase">
              <option value="2">Binary — Base 2</option>
              <option value="8">Octal — Base 8</option>
              <option value="10" selected>Decimal — Base 10</option>
              <option value="16">Hexadecimal — Base 16</option>
            </select>
          </div>

          <div class="setting-box">
            <label for="toBase">النظام الهدف</label>

            <select id="toBase">
              <option value="2">Binary — Base 2</option>
              <option value="8">Octal — Base 8</option>
              <option value="10">Decimal — Base 10</option>
              <option value="16" selected>Hexadecimal — Base 16</option>
            </select>
          </div>
        </div>

        <div class="editor-grid">

          <div class="panel">
            <div class="panel-header">
              <div class="panel-name">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span id="fromName">Decimal</span>
              </div>

              <span class="base-label" id="fromLabel">BASE 10</span>
            </div>

            <textarea
              id="input"
              spellcheck="false"
              autocomplete="off"
              placeholder="أدخل الرقم هنا..."
              aria-label="القيمة المصدر"
            ></textarea>

            <div class="panel-footer">
              <span id="inputHint">الأرقام المسموحة: 0–9</span>
              <span id="inputLength">0 رمز</span>
            </div>
          </div>

          <div class="panel">
            <div class="panel-header">
              <div class="panel-name">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span id="toName">Hexadecimal</span>
              </div>

              <span class="base-label" id="toLabel">BASE 16</span>
            </div>

            <textarea
              id="output"
              readonly
              spellcheck="false"
              placeholder="ستظهر النتيجة هنا..."
              aria-label="القيمة الناتجة"
            ></textarea>

            <div class="panel-footer">
              <span>الناتج جاهز للنسخ</span>
              <span id="outputLength">0 رمز</span>
            </div>
          </div>

        </div>

        <div class="actions">
          <button class="btn btn-primary" id="convertBtn" type="button">
            <i class="fa-solid fa-bolt"></i>
            تحويل الآن
          </button>

          <button class="btn" id="exampleBtn" type="button">
            <i class="fa-solid fa-flask"></i>
            مثال
          </button>

          <button class="btn" id="copyBtn" type="button">
            <i class="fa-regular fa-copy"></i>
            نسخ النتيجة
          </button>

          <button class="btn" id="resetBtn" type="button">
            <i class="fa-solid fa-rotate-left"></i>
            إعادة ضبط
          </button>
        </div>

        <div class="status" id="status" aria-live="polite">
          <i class="fa-solid fa-circle-info"></i>
          <span>أدخل قيمة واختر النظام المصدر والهدف لبدء التحويل.</span>
        </div>

        <div class="stats-grid">
          <div class="stat">
            <span class="stat-value" id="inputDigits">0</span>
            <span class="stat-label">رموز الإدخال</span>
