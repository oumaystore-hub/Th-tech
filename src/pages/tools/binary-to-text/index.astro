---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${base}/tools/binary-to-text/`;

const title = 'Binary to Text | تحويل Binary إلى Text';
const description =
  'أداة مجانية لتحويل النص الثنائي Binary إلى نص عادي Text بسرعة، مع دعم التحويل المباشر والمعالجة محليًا داخل المتصفح.';
const keywords =
  'Binary to Text, Binary Converter, Binary Decoder, تحويل binary إلى text, binary decoder, ثنائي إلى نص';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#0ea5e9" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <Header />

    <main class="tool-page">
      <section class="hero">
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container hero-inner">
          <div class="breadcrumb">
            <a href={`${base}/`}>
              <i class="fa-solid fa-house"></i>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <a href={`${base}/tools/`}>الأدوات</a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <span>Binary to Text</span>
          </div>

          <div class="hero-icon">
            <i class="fa-solid fa-code"></i>
          </div>

          <h1>Binary <span>to Text</span></h1>

          <p>
            حوّل البيانات الثنائية Binary إلى نص عادي Text بسرعة وسهولة،
            مباشرة من متصفحك وبدون إرسال بياناتك إلى أي خادم.
          </p>

          <div class="hero-tags">
            <span><i class="fa-solid fa-binary"></i> Binary</span>
            <span><i class="fa-solid fa-font"></i> Text</span>
            <span><i class="fa-solid fa-arrows-rotate"></i> Converter</span>
            <span><i class="fa-solid fa-shield-halved"></i> Local</span>
          </div>
        </div>
      </section>

      <section class="tool-section">
        <div class="container">
          <div class="tool-card">
            <div class="tool-header">
              <div>
                <div class="tool-title">
                  <i class="fa-solid fa-code"></i>
                  <h2>Binary to Text Converter</h2>
                </div>
                <p>أدخل Binary وسيتم تحويله إلى نص بشكل فوري.</p>
              </div>

              <div class="status">
                <span class="status-dot"></span>
                يعمل محليًا
              </div>
            </div>

            <div class="settings-bar">
              <div class="setting-item">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                <span>Binary</span>
                <i class="fa-solid fa-arrow-left"></i>
                <span>Text</span>
              </div>

              <div class="setting-item">
                <i class="fa-solid fa-bolt"></i>
                <span>تحويل مباشر</span>
              </div>

              <div class="setting-item">
                <i class="fa-solid fa-lock"></i>
                <span>خصوصية كاملة</span>
              </div>
            </div>

            <div class="editor-grid">
              <div class="editor-box">
                <div class="editor-head">
                  <div class="editor-label">
                    <span class="label-icon binary-icon">
                      <i class="fa-solid fa-0"></i>
                    </span>
                    <div>
                      <strong>Binary</strong>
                      <small>النص الثنائي</small>
                    </div>
                  </div>

                  <button class="mini-btn" id="paste-btn" type="button">
                    <i class="fa-solid fa-paste"></i>
                    لصق
                  </button>
                </div>

                <textarea
                  id="binaryInput"
                  dir="ltr"
                  spellcheck="false"
                  autocomplete="off"
                  placeholder="01001000 01100101 01101100 01101100 01101111"
                ></textarea>

                <div class="editor-footer">
                  <span id="binaryStats">0 bits</span>

                  <button class="clear-btn" id="clear-input" type="button">
                    <i class="fa-solid fa-xmark"></i>
                    مسح
                  </button>
                </div>
              </div>

              <div class="conversion-arrow">
                <button id="convert-btn" type="button" title="تحويل">
                  <i class="fa-solid fa-arrow-left"></i>
                </button>
              </div>

              <div class="editor-box output-box">
                <div class="editor-head">
                  <div class="editor-label">
                    <span class="label-icon text-icon">
                      <i class="fa-solid fa-font"></i>
                    </span>
                    <div>
                      <strong>Text</strong>
                      <small>النص الناتج</small>
                    </div>
                  </div>

                  <button class="mini-btn" id="copy-btn" type="button">
                    <i class="fa-regular fa-copy"></i>
                    نسخ
                  </button>
                </div>

                <textarea
                  id="textOutput"
                  dir="auto"
                  readonly
                  spellcheck="false"
                  placeholder="سيظهر النص هنا..."
                ></textarea>

                <div class="editor-footer">
                  <span id="textStats">0 characters</span>

                  <button class="clear-btn" id="download-btn" type="button">
                    <i class="fa-solid fa-download"></i>
                    تنزيل
                  </button>
                </div>
              </div>
            </div>

            <div class="action-bar">
              <button class="action secondary" id="example-btn" type="button">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                مثال
              </button>

              <button class="action primary" id="main-convert" type="button">
                <i class="fa-solid fa-bolt"></i>
                تحويل إلى Text
              </button>

              <button class="action secondary" id="reset-btn" type="button">
                <i class="fa-solid fa-rotate-right"></i>
                إعادة ضبط
              </button>
            </div>

            <div class="message" id="message" aria-live="polite"></div>

            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-1"></i>
                </div>
                <div>
                  <strong id="stat-bits">0</strong>
                  <span>Bits</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                  <strong id="stat-bytes">0</strong>
                  <span>Bytes</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-font"></i>
                </div>
                <div>
                  <strong id="stat-chars">0</strong>
                  <span>Characters</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-check"></i>
                </div>
                <div>
                  <strong id="stat-valid">0%</strong>
                  <span>Valid</span>
                </div>
              </div>
            </div>
          </div>

          <div class="privacy-card">
            <div class="privacy-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
              <h3>بياناتك تبقى خاصة</h3>
              <p>
                تتم عملية تحويل Binary إلى Text بالكامل داخل متصفحك.
                لا يتم رفع البيانات أو إرسالها إلى أي خادم.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>معلومات الأداة</span>
            <h2>كل ما تحتاجه لتحويل Binary</h2>
            <p>
              أداة بسيطة وسريعة لفك ترميز البيانات الثنائية وتحويلها إلى نص.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-code"></i>
              </div>
              <h3>Binary Decoder</h3>
              <p>
                حوّل سلاسل الأرقام الثنائية التي تتكون من 0 و1 إلى أحرف
                مفهومة بسهولة.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>
              <h3>تحويل سريع</h3>
              <p>
                تتم معالجة البيانات مباشرة داخل المتصفح بدون انتظار أو
                اتصالات خارجية.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>
              <h3>دعم المسافات</h3>
              <p>
                يمكنك إدخال Binary بمسافات بين البايتات أو كسلسلة متصلة،
                وستقوم الأداة بالتعرف عليها.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-shield"></i>
              </div>
              <h3>معالجة محلية</h3>
              <p>
                لا يتم إرسال المحتوى إلى الخادم، مما يجعل الأداة مناسبة
                للبيانات التي تريد إبقاءها على جهازك.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>طريقة الاستخدام</span>
            <h2>كيف تحول Binary إلى Text؟</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">01</div>
              <div>
                <h3>أدخل Binary</h3>
                <p>
                  الصق أو اكتب سلسلة Binary مكونة من الأرقام 0 و1.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">02</div>
              <div>
                <h3>ابدأ التحويل</h3>
                <p>
                  اضغط على زر «تحويل إلى Text» لفك ترميز البيانات.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">03</div>
              <div>
                <h3>انسخ النتيجة</h3>
                <p>
                  انسخ النص الناتج أو قم بتنزيله كملف نصي.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>الأسئلة الشائعة</span>
            <h2>أسئلة حول Binary to Text</h2>
          </div>

          <div class="faq-list">
            <details>
              <summary>
                ما هو Binary؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                Binary أو النظام الثنائي هو نظام عددي يستخدم الرقمين 0 و1
                لتمثيل البيانات، وهو من الأساسيات التي تعتمد عليها الحواسيب.
              </p>
            </details>

            <details>
              <summary>
                كيف يتم تحويل Binary إلى Text؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                يتم تقسيم البيانات الثنائية إلى مجموعات من 8 Bits، ثم يتم
                تفسير كل مجموعة كقيمة Byte وتحويلها إلى الحرف المقابل لها.
              </p>
            </details>

            <details>
              <summary>
                هل يمكنني إدخال Binary بدون مسافات؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                نعم. يمكنك إدخال Binary سواء كان مفصولًا بمسافات أو كسلسلة
                متصلة من 0 و1.
              </p>
            </details>

            <details>
              <summary>
                هل يتم إرسال بياناتي إلى الخادم؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                لا. عملية التحويل تتم بالكامل داخل متصفحك ولا تحتاج إلى
                إرسال البيانات إلى خادم خارجي.
              </p>
            </details>

            <details>
              <summary>
                ماذا يحدث إذا كان عدد Bits غير قابل للقسمة على 8؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                سيتم اعتبار الإدخال غير مكتمل، لأن التمثيل النصي المعتاد
                يعتمد على Bytes مكونة من 8 Bits.
              </p>
            </details>
          </div>
        </div>
      </section>
    

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/text-to-binary/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Text To Binary</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/text-case-converter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Text Case Converter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/text-cleaner/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Text Cleaner</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/text-reverser/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Text Reverser</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/character-counter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Character Counter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/password-generator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Password Generator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: 'Cairo', sans-serif;
        background: #f8fbff;
        color: #0f172a;
      }

      :global(body.dark-mode) {
        background: #07111f;
        color: #e5eef9;
      }

      :global(button),
      :global(textarea) {
        font-family: inherit;
      }

      .tool-page {
        min-height: 100vh;
        overflow: hidden;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .hero {
        position: relative;
        padding: 55px 0 80px;
        background:
          radial-gradient(circle at 15% 25%, rgba(14, 165, 233, 0.15), transparent 32%),
          radial-gradient(circle at 85% 75%, rgba(59, 130, 246, 0.13), transparent 30%),
          linear-gradient(135deg, #eff8ff, #f8fbff);
        border-bottom: 1px solid #e2e8f0;
      }

      :global(body.dark-mode) .hero {
        background:
          radial-gradient(circle at 15% 25%, rgba(14, 165, 233, 0.12), transparent 32%),
          radial-gradient(circle at 85% 75%, rgba(59, 130, 246, 0.12), transparent 30%),
          linear-gradient(135deg, #081522, #07111f);
        border-color: #17283b;
      }

      .hero-glow {
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.3;
        pointer-events: none;
      }

      .glow-one {
        top: -130px;
        right: -80px;
        background: #38bdf8;
      }

      .glow-two {
        bottom: -150px;
        left: -100px;
        background: #2563eb;
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      .breadcrumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 32px;
        color: #64748b;
        font-size: 13px;
      }

      .breadcrumb a {
        color: #64748b;
        text-decoration: none;
        transition: 0.2s;
      }

      .breadcrumb a:hover {
        color: #0284c7;
      }

      .breadcrumb i {
        font-size: 10px;
      }

      .breadcrumb .separator {
        color: #94a3b8;
      }

      .hero-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 22px;
        display: grid;
        place-items: center;
        border-radius: 22px;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white;
        font-size: 30px;
        box-shadow: 0 18px 45px rgba(14, 165, 233, 0.28);
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(34px, 5vw, 54px);
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero h1 span {
        color: #0284c7;
      }

      .hero p {
        max-width: 720px;
        margin: 18px auto 0;
        color: #64748b;
        font-size: 16px;
        line-height: 2;
      }

      :global(body.dark-mode) .hero p,
      :global(body.dark-mode) .breadcrumb {
        color: #94a3b8;
      }

      .hero-tags {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .hero-tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border: 1px solid #dbeafe;
