    </style>

    <script is:inline>
      const binaryInput = document.getElementById('binaryInput');
      const textOutput = document.getElementById('textOutput');

      const convertBtn = document.getElementById('convert-btn');
      const mainConvert = document.getElementById('main-convert');
      const exampleBtn = document.getElementById('example-btn');
      const resetBtn = document.getElementById('reset-btn');
      const clearInput = document.getElementById('clear-input');
      const copyBtn = document.getElementById('copy-btn');
      const pasteBtn = document.getElementById('paste-btn');
      const downloadBtn = document.getElementById('download-btn');

      const binaryStats = document.getElementById('binaryStats');
      const textStats = document.getElementById('textStats');

      const statBits = document.getElementById('stat-bits');
      const statBytes = document.getElementById('stat-bytes');
      const statChars = document.getElementById('stat-chars');
      const statValid = document.getElementById('stat-valid');

      const message = document.getElementById('message');

      const example =
        '01001000 01100101 01101100 01101100 01101111 00100000 01010100 01101000 00101110 01010100 01100101 01100011 01101000';

      function showMessage(text, type = '') {
        message.textContent = text;
        message.className = `message ${type}`;

        if (text) {
          setTimeout(() => {
            if (message.textContent === text) {
              message.textContent = '';
              message.className = 'message';
            }
          }, 3000);
        }
      }

      function normalizeBinary(value) {
        return value.replace(/[^01]/g, '');
      }

      function convertBinaryToText() {
        const raw = binaryInput.value;
        const binary = normalizeBinary(raw);

        binaryStats.textContent = `${binary.length} bits`;

        if (!raw.trim()) {
          textOutput.value = '';
          updateStats(0, 0, 0, 0);
          showMessage('');
          return;
        }

        const invalidCharacters = raw.replace(/[01\s]/g, '');

        if (invalidCharacters.length > 0) {
          textOutput.value = '';
          updateStats(binary.length, 0, 0, 0);
          showMessage('الإدخال يحتوي على أحرف غير صالحة. استخدم 0 و1 فقط.', 'error');
          return;
        }

        if (binary.length % 8 !== 0) {
          textOutput.value = '';
          const completeBytes = Math.floor(binary.length / 8);

          updateStats(
            binary.length,
            completeBytes,
            0,
            Math.floor((binary.length / 8) * 100)
          );

          showMessage(
            'عدد الـ Bits يجب أن يكون من مضاعفات 8 لإكمال التحويل.',
            'error'
          );
          return;
        }

        let result = '';

        for (let i = 0; i < binary.length; i += 8) {
          const byte = binary.slice(i, i + 8);
          const value = parseInt(byte, 2);

          result += String.fromCharCode(value);
        }

        textOutput.value = result;

        const bytes = binary.length / 8;
        const validPercent = binary.length > 0 ? 100 : 0;

        updateStats(binary.length, bytes, result.length, validPercent);

        showMessage('تم تحويل Binary إلى Text بنجاح.', 'success');
      }

      function updateStats(bits, bytes, chars, valid) {
        statBits.textContent = bits.toLocaleString();
        statBytes.textContent = bytes.toLocaleString();
        statChars.textContent = chars.toLocaleString();
        statValid.textContent = `${valid}%`;

        binaryStats.textContent = `${bits.toLocaleString()} bits`;
        textStats.textContent = `${chars.toLocaleString()} characters`;
      }

      async function copyOutput() {
        if (!textOutput.value) {
          showMessage('لا توجد نتيجة لنسخها.', 'error');
          return;
        }

        try {
          await navigator.clipboard.writeText(textOutput.value);
          showMessage('تم نسخ النص إلى الحافظة.', 'success');
        } catch {
          textOutput.select();
          document.execCommand('copy');
          showMessage('تم نسخ النص.', 'success');
        }
      }

      async function pasteBinary() {
        try {
          const text = await navigator.clipboard.readText();

          if (!text) {
            showMessage('الحافظة فارغة.', 'error');
            return;
          }

          binaryInput.value = text;
          convertBinaryToText();
          binaryInput.focus();
        } catch {
          showMessage('تعذر الوصول إلى الحافظة. الصق النص يدويًا.', 'error');
        }
      }

      function downloadText() {
        if (!textOutput.value) {
          showMessage('لا توجد نتيجة لتنزيلها.', 'error');
          return;
        }

        const blob = new Blob([textOutput.value], {
          type: 'text/plain;charset=utf-8'
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = 'binary-to-text.txt';
        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);

        showMessage('تم تنزيل الملف بنجاح.', 'success');
      }

      function resetTool() {
        binaryInput.value = '';
        textOutput.value = '';

        updateStats(0, 0, 0, 0);
        showMessage('');

        binaryInput.focus();
      }

      function loadExample() {
        binaryInput.value = example;
        convertBinaryToText();
      }

      convertBtn.addEventListener('click', convertBinaryToText);
      mainConvert.addEventListener('click', convertBinaryToText);

      exampleBtn.addEventListener('click', loadExample);
      resetBtn.addEventListener('click', resetTool);
      clearInput.addEventListener('click', resetTool);

      copyBtn.addEventListener('click', copyOutput);
      pasteBtn.addEventListener('click', pasteBinary);
      downloadBtn.addEventListener('click', downloadText);

      binaryInput.addEventListener('input', () => {
        const binary = normalizeBinary(binaryInput.value);
        binaryStats.textContent = `${binary.length} bits`;

        if (!binaryInput.value.trim()) {
          textOutput.value = '';
          updateStats(0, 0, 0, 0);
          return;
        }

        convertBinaryToText();
      });

      binaryInput.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
          event.preventDefault();
          convertBinaryToText();
        }
      });

      function syncTheme() {
        const isDark =
          document.documentElement.classList.contains('dark-mode') ||
          document.body.classList.contains('dark-mode');

        document.body.classList.toggle('dark-mode', isDark);
      }

      syncTheme();

      window.addEventListener('storage', syncTheme);

      const observer = new MutationObserver(syncTheme);

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });

      observer.observe(document.body, {
        attributes: true,
        attributeFilter: ['class']
      });
    </script>
  </body>
