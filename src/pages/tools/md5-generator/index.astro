---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "MD5 Generator - إنشاء MD5 Hash أونلاين مجاناً | Th.Tech";

const description =
  "أداة MD5 Generator مجانية لإنشاء MD5 Hash من أي نص مباشرة داخل المتصفح، مع إمكانية النسخ والمسح واستخدام أمثلة جاهزة.";

const faqs = [
  {
    q: "ما هو MD5؟",
    a: "MD5 هي خوارزمية Hash تنتج قيمة بطول 128 بت، وتظهر عادةً كسلسلة hexadecimal مكونة من 32 حرفاً."
  },
  {
    q: "هل MD5 تشفير؟",
    a: "لا. MD5 هي دالة Hash وليست تشفيراً. لا يمكن استخدام MD5 كبديل عن التشفير لحماية البيانات السرية."
  },
  {
    q: "هل يتم إرسال النص إلى الخادم؟",
    a: "لا. يتم إنشاء MD5 بالكامل داخل المتصفح باستخدام JavaScript، ولا يتم إرسال النص إلى خادم خارجي."
  },
  {
    q: "هل MD5 آمنة لكلمات المرور؟",
    a: "لا ينصح باستخدام MD5 لتخزين كلمات المرور الحديثة لأنه قديم وسريع ويمكن كسره باستخدام تقنيات وأدوات متخصصة."
  }
];
---

<html lang="ar" dir="rtl">
<head>
