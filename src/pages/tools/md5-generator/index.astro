        input.value =
          "Hello, World!";


        updateStats();

        generateHash();
      }


      function clearAll() {

        input.value = "";

        updateStats();

        resetOutput();

        showReady();

        input.focus();
      }


      async function copyHash(
        button
      ) {

        if (!currentHash) {

          showError(
            "لا توجد نتيجة MD5 لنسخها."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            currentHash
          );


          const original =
            button.innerHTML;


          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            button.innerHTML =
              original;

          }, 1500);

        } catch {

          const temp =
            document.createElement(
              "textarea"
            );

          temp.value =
            currentHash;

          document.body.appendChild(
            temp
          );

          temp.select();

          document.execCommand(
            "copy"
          );

          temp.remove();


          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            button.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ Hash';

          }, 1500);
        }
      }


      input.addEventListener(
        "input",
        updateStats
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            generateHash();
          }

        }
