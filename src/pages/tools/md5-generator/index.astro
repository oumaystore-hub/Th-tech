          words[length >> 2] =
            words[length >> 2] |
            (
              0x80 <<
              ((length % 4) * 8)
            );


          const bitLength =
            length * 8;


          words[
            (((length + 8) >> 6) + 1) * 16 - 2
          ] =
            bitLength & 0xffffffff;


          words[
            (((length + 8) >> 6) + 1) * 16 - 1
          ] =
            Math.floor(
              bitLength / 0x100000000
            );


          return words;
        }


        function safeWord(
