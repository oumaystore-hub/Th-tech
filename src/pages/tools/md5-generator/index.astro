        function wordToHex(
          value
        ) {

          let result = "";

          for (
            let i = 0;
            i < 4;
            i++
          ) {

            const byte =
              (value >> (i * 8)) & 255;

            result +=
              ("0" + byte.toString(16))
                .slice(-2);

          }

          return result;
        }


        return (
          wordToHex(a) +
          wordToHex(b) +
          wordToHex(c) +
          wordToHex(d)
        );
      }


      function generateHash() {

        const text =
          input.value;


        updateStats();


        if (!text) {

          resetOutput();

          showError(
            "أدخل نصاً أولاً لإنشاء MD5 Hash."
          );

          return;
        }


        try {

          currentHash =
            md5(text);


          hashOutput.textContent =
            currentHash;


          statHashLength.textContent =
            currentHash.length;


          showSuccess(
            "تم إنشاء MD5 Hash داخل المتصفح بنجاح."
          );

        } catch {

          resetOutput();

          showError(
            "حدث خطأ أثناء إنشاء MD5 Hash."
          );
        }
      }


