      .project-info span {

        display:
          block;

        color:
          var(--muted);

        font-size:
          10px;

      }


      .topbar-status {

        display:
          flex;

        align-items:
          center;

        gap:
          7px;

        color:
          var(--muted);

        font-size:
          10px;

      }


      .online-dot {

        width:
          7px;

        height:
          7px;

        border-radius:
          50%;

        background:
          #22c55e;

        box-shadow:
          0 0 0 4px
          rgba(34,197,94,.08);

      }


      /* ======================================
         ACTION BAR
      ======================================= */

      .actionbar {

        display:
          flex;

        justify-content:
          space-between;

        align-items:
          center;

        gap:
          10px;

        padding:
          13px 18px;

        background:
          var(--surface-2);

        border-bottom:
          1px solid
          var(--border);

      }


      .action-group {

        display:
          flex;

        gap:
          8px;

      }


      .action {

        display:
          inline-flex;

        align-items:
          center;

        justify-content:
          center;

        gap:
          7px;

        border:
          1px solid
          var(--border);

        border-radius:
          10px;

        padding:
          9px 13px;

        cursor:
          pointer;

        font-size:
          11px;

        font-weight:
          700;

        transition:
          .2s ease;

      }


      .action:hover {

        transform:
          translateY(-1px);

      }


      .action.secondary {

        background:
          var(--surface);

        color:
          var(--text);

      }


      .action.secondary:hover {

        color:
          var(--primary);

        border-color:
          rgba(37,99,235,.25);

      }


      .action.primary {

        border-color:
          transparent;

        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--secondary)
          );

        color:
          white;

        box-shadow:
          0 8px 20px
          rgba(37,99,235,.2);

      }


      .action.primary:hover {

        box-shadow:
          0 11px 25px
          rgba(37,99,235,.3);

      }


      /* ======================================
         WORKSPACE
      ======================================= */

      .workspace {

        display:
          grid;

        grid-template-columns:
          minmax(0, 1.65fr)
          minmax(280px, .75fr);

        gap:
          14px;

        padding:
          16px;

      }


      .editor-card {

        min-width:
          0;

        overflow:
          hidden;

        border:
          1px solid
          rgba(148,163,184,.12);

        border-radius:
          16px;

        background:
          var(--code-bg);

        color:
          var(--code-text);

      }


      .editor-head {

        height:
          52px;

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          0 14px;

        background:
          var(--code-bg-2);

        border-bottom:
          1px solid
          rgba(255,255,255,.06);

      }


      .editor-label {

        display:
          flex;

        align-items:
          center;

        gap:
          9px;

      }


      .file-icon {

        width:
          31px;

        height:
          31px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          8px;

        background:
          rgba(37,99,235,.13);

        color:
          #60a5fa;

        font-size:
          12px;

      }


      .editor-label strong {

        display:
          block;

        font-size:
          11px;

      }


      .editor-label small {

        display:
          block;

        margin-top:
          1px;

        color:
          #64748b;

        font-size:
          9px;

      }


      .editor-stats {

        color:
          #64748b;

        font:
          9px
          "JetBrains Mono",
          monospace;

      }


      .code-area {

        display:
          flex;

        height:
          430px;

        direction:
          ltr;

        overflow:
          hidden;

      }


      .line-numbers {

        width:
          45px;

        flex:
          0 0 45px;

        padding:
          15px 8px;

        background:
          rgba(0,0,0,.14);

        border-right:
          1px solid
          rgba(255,255,255,.05);

        color:
          #475569;

        text-align:
          right;

        white-space:
          pre;

        overflow:
          hidden;

        user-select:
          none;

        font:
          12px/1.8
          "JetBrains Mono",
          monospace;

      }


      textarea {

        width:
          100%;

        height:
          100%;

        resize:
          none;

        outline:
          none;

        border:
          0;

        padding:
          15px;

        background:
          var(--code-bg);

        color:
          var(--code-text);

        font:
          12px/1.8
          "JetBrains Mono",
          monospace;

        direction:
          ltr;

        text-align:
          left;

        tab-size:
          2;

      }


      textarea::placeholder {

        color:
          #475569;

      }


      .editor-foot {

        min-height:
          38px;

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          0 13px;

        border-top:
          1px solid
          rgba(255,255,255,.06);

        color:
          #64748b;

        font-size:
          9px;

      }


      .editor-foot span {

        display:
          flex;

        align-items:
          center;

        gap:
          5px;

      }


      /* ======================================
         QUICK PANEL
      ======================================= */

      .quick-panel {

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          16px;

        background:
          var(--surface-2);

      }


      .quick-head {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        padding:
          16px;

        border-bottom:
          1px solid
          var(--border);

      }


      .quick-head strong {

        display:
          block;

        font-size:
          12px;

      }


      .quick-head span {

        display:
          block;

        margin-top:
          2px;

        color:
          var(--muted);

        font-size:
          9px;

      }


      .quick-head > i {

        color:
          var(--primary);

        font-size:
          18px;

      }


      .quick-grid {

        display:
          grid;

        grid-template-columns:
          repeat(
            2,
            1fr
          );

        gap:
          9px;

        padding:
          13px;

      }


      .quick-item {

        display:
          flex;

        align-items:
          center;

        gap:
          8px;

        min-width:
          0;

        padding:
          11px;

        border:
          1px solid
          var(--border);

        border-radius:
          11px;

        background:
          var(--surface);

      }


      .quick-icon {

        width:
          32px;

        height:
          32px;

        flex:
          0 0 32px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          8px;

        font-size:
          11px;

      }


      .quick-icon.blue {

        background:
          rgba(37,99,235,.1);

        color:
          var(--blue);

      }


      .quick-icon.purple {

        background:
          rgba(124,58,237,.1);

        color:
          var(--purple);

      }


      .quick-icon.cyan {

        background:
          rgba(8,145,178,.1);

        color:
          var(--cyan);

      }


      .quick-icon.green {

        background:
          rgba(22,163,74,.1);

        color:
          var(--green);

      }


      .quick-item strong {

        display:
          block;

        font:
          700 12px
          "JetBrains Mono",
          monospace;

      }


      .quick-item span:last-child {

        display:
          block;

        color:
          var(--muted);

        font-size:
          8px;

      }


      .quick-note {

        display:
          flex;

        align-items:
          center;

        gap:
          7px;

        margin:
          2px 13px 13px;

        padding:
          10px;

        border:
          1px solid
          rgba(37,99,235,.12);

        border-radius:
          10px;

        background:
          rgba(37,99,235,.05);

        color:
          var(--muted);

        font-size:
          8px;

      }


      .quick-note i {

        color:
          var(--primary);

      }


      /* ======================================
         STATUS
      ======================================= */

      .status {

        display:
          flex;

        align-items:
          center;

        gap:
          6px;

      }


      .status-dot {

        width:
          6px;

        height:
          6px;

        border-radius:
          50%;

        background:
          #64748b;

      }


      .status.success {

        color:
          #4ade80;

      }


      .status.success .status-dot {

        background:
          #22c55e;

      }


      .status.warning {

        color:
          #fbbf24;

      }


      .status.warning .status-dot {

        background:
          #f59e0b;

      }


      .status.error {

        color:
          #f87171;

      }


      .status.error .status-dot {

        background:
          #ef4444;

      }


      /* ======================================
         RESULT
      ======================================= */

      .result-section {

        margin:
          0 16px 14px;

        overflow:
          hidden;

        border:
          1px solid
          rgba(37,99,235,.14);

        border-radius:
          15px;

        background:
          var(--surface-2);

      }


      .result-head {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          12px;

        padding:
          12px 14px;

        border-bottom:
          1px solid
          var(--border);

      }


      .result-title {

        display:
          flex;

        align-items:
          center;

        gap:
          9px;

      }


      .result-icon {

        width:
          32px;

        height:
          32px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          8px;

        background:
          rgba(37,99,235,.1);

        color:
          var(--primary);

        font-size:
          12px;

      }


      .result-title strong {

        display:
          block;

        font-size:
          11px;

      }


      .result-title span {

        display:
          block;

        margin-top:
          1px;

        color:
          var(--muted);

        font-size:
          9px;

      }


      .result-badge {

        display:
          flex;

        align-items:
          center;

        gap:
          6px;

        padding:
          5px 8px;

        border:
          1px solid
          rgba(37,99,235,.16);

        border-radius:
          999px;

        color:
          var(--primary);

        font:
          600 9px
          "JetBrains Mono",
          monospace;

      }


      .result-dot {

        width:
          5px;

        height:
          5px;

        border-radius:
          50%;

        background:
          var(--primary);

      }


      .statistics-grid {

        display:
          grid;

        grid-template-columns:
          repeat(
            4,
            1fr
          );

        gap:
          10px;

        padding:
          14px;

      }


      .stat-card {

        display:
          flex;

        align-items:
          center;

        gap:
          10px;

        min-width:
          0;

        padding:
          13px;

        border:
          1px solid
          var(--border);

        border-radius:
          13px;

        background:
          var(--surface);

        transition:
          transform .2s ease,
          border-color .2s ease;

      }


      .stat-card:hover {

        transform:
          translateY(-2px);

        border-color:
          rgba(37,99,235,.2);

      }


      .stat-card-icon {

        width:
          38px;

        height:
          38px;

        flex:
          0 0 38px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          10px;

        font-size:
          12px;

      }


      .stat-card-icon.blue {

        background:
          rgba(37,99,235,.1);

        color:
          var(--blue);

      }


      .stat-card-icon.green {

        background:
          rgba(22,163,74,.1);

        color:
          var(--green);

      }


      .stat-card-icon.orange {

        background:
          rgba(234,88,12,.1);

        color:
          var(--orange);

      }


      .stat-card-icon.purple {

        background:
          rgba(124,58,237,.1);

        color:
          var(--purple);

      }


      .stat-card-icon.cyan {

        background:
          rgba(8,145,178,.1);

        color:
          var(--cyan);

      }


      .stat-card-icon.indigo {

        background:
          rgba(79,70,229,.1);

        color:
          var(--indigo);

      }


      .stat-card-icon.red {

        background:
          rgba(220,38,38,.1);

        color:
          var(--red);

      }


      .stat-card-icon.teal {

        background:
          rgba(15,118,110,.1);

        color:
          var(--teal);

      }


      .stat-content {

        min-width:
          0;

      }


      .stat-content > span {

        display:
          block;

        overflow:
          hidden;

        color:
          var(--muted);

        font-size:
          8px;

        text-overflow:
          ellipsis;

        white-space:
          nowrap;

      }


      .stat-content strong {

        display:
          block;

        margin-top:
          2px;

        font:
          700 14px
          "JetBrains Mono",
          monospace;

      }


      .stat-content small {

        display:
          block;

        margin-top:
          1px;

        color:
          var(--muted);

        opacity:
          .7;

        font-size:
          7px;

      }


      /* ======================================
         TOOL STATS
      ======================================= */

      .tool-stats {

        display:
          grid;

        grid-template-columns:
          repeat(
            4,
            1fr
          );

        gap:
          10px;

        padding:
          0 16px 16px;

      }


      .tool-stat {

        display:
          flex;

        align-items:
          center;

        gap:
          9px;

        padding:
          12px;

        border:
          1px solid
          var(--border);

        border-radius:
          13px;

        background:
          var(--surface-2);

      }


      .tool-stat-icon {

        width:
          34px;

        height:
          34px;

        flex:
          0 0 34px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          9px;

        background:
          rgba(37,99,235,.09);

        color:
          var(--primary);

        font-size:
          11px;

      }


      .tool-stat strong {

        display:
          block;

        font:
          700 11px
          "JetBrains Mono",
          monospace;

      }


      .tool-stat span {

        display:
          block;

        margin-top:
          2px;

        color:
          var(--muted);

        font-size:
          8px;

      }


      /* ======================================
         INFORMATION
      ======================================= */

      .information {

        margin-top:
          55px;

      }


      .section-title {

        max-width:
          700px;

        margin:
          0 auto 25px;

        text-align:
          center;

      }


      .section-title > span {

        color:
          var(--primary);

        font-size:
          11px;

        font-weight:
          800;

        letter-spacing:
          .5px;

      }


      .section-title h2 {

        margin:
          5px 0 7px;

        font-size:
          clamp(
            21px,
            4vw,
            28px
          );

      }


      .section-title p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          12px;

        line-height:
          1.9;

      }


      .info-grid {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .info-card {

        position:
          relative;

        overflow:
          hidden;

        padding:
          24px;

        border:
          1px solid
          var(--border);

        border-radius:
          18px;

        background:
          var(--surface);

      }


      .info-number {

        position:
          absolute;

        top:
          15px;

        left:
          18px;

        color:
          var(--muted);

        opacity:
          .25;

        font:
          700 28px
          "JetBrains Mono",
          monospace;

      }


      .info-card-icon {

        width:
          42px;

        height:
          42px;

        display:
          grid;

        place-items:
          center;

        margin-bottom:
          13px;

        border-radius:
          11px;

        background:
          rgba(37,99,235,.1);

        color:
          var(--primary);

      }


      .info-card h3 {

        margin:
          0 0 7px;

        font-size:
          14px;

      }


      .info-card p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         HOW
      ======================================= */

      .how-section {

        margin-top:
          55px;

      }


      .steps {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .step {

        display:
          flex;

        align-items:
          flex-start;

        gap:
          12px;

        padding:
          20px;

        border:
          1px solid
          var(--border);

        border-radius:
          17px;

        background:
          var(--surface);

      }


      .step-icon {

        width:
          43px;

        height:
          43px;

        flex:
          0 0 43px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          12px;

        background:
          rgba(37,99,235,.1);

        color:
          var(--primary);

        font:
          700 10px
          "JetBrains Mono",
          monospace;

      }


      .step h3 {

        margin:
          0 0 5px;

        font-size:
          13px;

      }


      .step p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          10px;

        line-height:
          1.8;

      }


      /* ======================================
         FAQ
      ======================================= */

      .faq-section {

        max-width:
          850px;

        margin:
          55px auto 70px;

      }


      .faq-list details {

        margin-bottom:
          9px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          14px;

        background:
          var(--surface);

      }


      .faq-list summary {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          15px;

        padding:
          16px 18px;

        cursor:
          pointer;

        list-style:
          none;

        font-size:
          12px;

        font-weight:
          700;

      }


      .faq-list summary::-webkit-details-marker {

        display:
          none;

      }


      .faq-list summary i {

        color:
          var(--muted);

        font-size:
          10px;

        transition:
          transform .2s ease;

      }


      .faq-list details[open]
      summary i {

        transform:
          rotate(180deg);

      }


      .faq-answer {

        padding:
          0 18px 17px;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         RESPONSIVE
      ======================================= */

      @media (max-width: 950px) {

        .workspace {

          grid-template-columns:
            1fr;

        }


        .statistics-grid {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }

      }


      @media (max-width: 800px) {

        .info-grid,
        .steps {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }


        .tool-stats {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }

      }


      @media (max-width: 700px) {

        .actionbar {

          flex-direction:
            column;

          align-items:
            stretch;

        }


        .action-group {

          width:
            100%;

        }


        .action {

          flex:
            1;

        }


        .statistics-grid {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }

      }


      @media (max-width: 600px) {

        .container {

          width:
            calc(
              100% - 20px
            );

        }


        .hero {

          padding:
            25px 0 32px;

        }


        .hero-icon {

          width:
            60px;

          height:
            60px;

          font-size:
            20px;

        }


        .hero p {

          font-size:
            12px;

        }


        .topbar {

          padding:
            14px;

        }


        .topbar-status {

          display:
            none;

        }


        .actionbar {

          padding:
            10px;

        }


        .action {

          padding:
            9px 7px;

          font-size:
            10px;

        }


        .workspace {

          padding:
            10px;

        }


        .code-area {

          height:
            330px;

        }


        .result-section {

          margin:
            0 10px 10px;

        }


        .statistics-grid {

          gap:
            8px;

          padding:
            10px;

        }


        .stat-card {

          padding:
            10px;

        }


        .stat-card-icon {

          width:
            33px;

          height:
            33px;

          flex-basis:
            33px;

        }


        .stat-content strong {

          font-size:
            11px;

        }


        .tool-stats {

          padding:
            0 10px 10px;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            1fr;

        }


        .quick-grid {

          padding:
            10px;

        }


        .quick-note {

          margin:
            2px 10px 10px;

        }


        .faq-section {

          margin-bottom:
            45px;

        }

      }

    </style>

  </body>
</html>
