    <!-- ======================================
         JAVASCRIPT
    ======================================= -->

    <script is:inline>
      (() => {

        const codeInput =
          document.getElementById("codeInput");

        const lineNumbers =
          document.getElementById("lineNumbers");

        const editorStats =
          document.getElementById("editorStats");

        const sizeInfo =
          document.getElementById("sizeInfo");

        const status =
          document.getElementById("status");

        const exampleBtn =
          document.getElementById("exampleBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const analyzeBtn =
          document.getElementById("analyzeBtn");


        const quickLines =
          document.getElementById("quickLines");

        const quickChars =
          document.getElementById("quickChars");

        const quickWords =
          document.getElementById("quickWords");

        const quickCodeLines =
          document.getElementById("quickCodeLines");


        const totalLines =
          document.getElementById("totalLines");

        const codeLines =
          document.getElementById("codeLines");

        const blankLines =
          document.getElementById("blankLines");

        const commentLines =
          document.getElementById("commentLines");

        const characters =
          document.getElementById("characters");

        const words =
          document.getElementById("words");

        const fileSize =
          document.getElementById("fileSize");

        const commentPercent =
          document.getElementById("commentPercent");


        /* ======================================
           EXAMPLE
        ======================================= */

        const exampleCode = `// Source Code Counter Example

function calculateTotal(items) {
  let total = 0;

  // Calculate the total price
  for (const item of items) {
    total += item.price;
  }

  return total;
}

const products = [
  { name: "Laptop", price: 800 },
  { name: "Mouse", price: 25 }
];

const total = calculateTotal(products);

console.log("Total:", total);`;


        /* ======================================
           FORMAT SIZE
        ======================================= */

        function formatBytes(bytes) {

          if (bytes < 1024) {
            return `${bytes} B`;
          }

          if (bytes < 1024 * 1024) {
            return `${(bytes / 1024).toFixed(2)} KB`;
          }

          return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;

        }


        /* ======================================
           UPDATE EDITOR
        ======================================= */

        function updateEditorStats() {

          const value =
            codeInput.value;


          const lines =
            value
              ? value.replace(/\r\n/g, "\n").split("\n")
              : [];


          const lineCount =
            lines.length;


          const chars =
            value.length;


          const byteCount =
            new Blob([value]).size;


          const wordCount =
            value.trim()
              ? value.trim().split(/\s+/).length
              : 0;


          editorStats.textContent =
            `${chars.toLocaleString()} حرف`;


          sizeInfo.textContent =
            formatBytes(byteCount);


          if (lineCount === 0) {

            lineNumbers.textContent =
              "1";

          } else {

            lineNumbers.textContent =
              Array.from(
                { length: lineCount },
                (_, index) => index + 1
              ).join("\n");

          }


          quickLines.textContent =
            lineCount.toLocaleString();


          quickChars.textContent =
            chars.toLocaleString();


          quickWords.textContent =
            wordCount.toLocaleString();


          updateLiveCodeLines(lines);

        }


        /* ======================================
           LIVE CODE LINES
        ======================================= */

        function updateLiveCodeLines(lines) {

          if (!lines.length) {

            quickCodeLines.textContent =
              "0";

            return;

          }


          let count = 0;


          lines.forEach((line) => {

            if (line.trim() !== "") {
              count++;
            }

          });


          quickCodeLines.textContent =
            count.toLocaleString();

        }


        /* ======================================
           STATUS
        ======================================= */

        function setStatus(type, text) {

          status.className =
            `status ${type}`;

          status.innerHTML = `
            <span class="status-dot"></span>
            ${text}
          `;

        }


        /* ======================================
           COMMENT DETECTION
        ======================================= */

        function isCommentLine(line) {

          const trimmed =
            line.trim();


          if (!trimmed) {
            return false;
          }


          if (
            trimmed.startsWith("//") ||
            trimmed.startsWith("#") ||
            trimmed.startsWith("--") ||
            trimmed.startsWith("<!--") ||
            trimmed.startsWith("/*") ||
            trimmed.startsWith("*")
          ) {

            return true;

          }


          return false;

        }


        /* ======================================
           ANALYZE
        ======================================= */

        function analyze() {

          const value =
            codeInput.value;


          if (!value.trim()) {

            resetResults();

            setStatus(
              "warning",
              "أدخل الكود أولاً"
            );

            codeInput.focus();

            return;

          }


          const started =
            performance.now();


          try {

            const normalized =
              value
                .replace(/\r\n/g, "\n")
                .replace(/\r/g, "\n");


            const lines =
              normalized.split("\n");


            const total =
              lines.length;


            let blank = 0;
            let comments = 0;
            let code = 0;


            lines.forEach((line) => {

              const trimmed =
                line.trim();


              if (!trimmed) {

                blank++;

              } else if (
                isCommentLine(trimmed)
              ) {

                comments++;

              } else {

                code++;

              }

            });


            const chars =
              value.length;


            const wordCount =
              value.trim()
                ? value.trim().split(/\s+/).length
                : 0;


            const bytes =
              new Blob([value]).size;


            const percentage =
              total > 0
                ? (comments / total) * 100
                : 0;


            totalLines.textContent =
              total.toLocaleString();


            codeLines.textContent =
              code.toLocaleString();


            blankLines.textContent =
              blank.toLocaleString();


            commentLines.textContent =
              comments.toLocaleString();


            characters.textContent =
              chars.toLocaleString();


            words.textContent =
              wordCount.toLocaleString();


            fileSize.textContent =
              formatBytes(bytes);


            commentPercent.textContent =
              `${percentage.toFixed(1)}%`;


            quickLines.textContent =
              total.toLocaleString();


            quickChars.textContent =
              chars.toLocaleString();


            quickWords.textContent =
              wordCount.toLocaleString();


            quickCodeLines.textContent =
              code.toLocaleString();


            const elapsed =
              performance.now() - started;


            setStatus(
              "success",
              `تم التحليل خلال ${elapsed.toFixed(1)} ms`
            );

          } catch {

            setStatus(
              "error",
              "تعذر تحليل الكود"
            );

          }

        }


        /* ======================================
           RESET
        ======================================= */

        function resetResults() {

          totalLines.textContent =
            "0";

          codeLines.textContent =
            "0";

          blankLines.textContent =
            "0";

          commentLines.textContent =
            "0";

          characters.textContent =
            "0";

          words.textContent =
            "0";

          fileSize.textContent =
            "0 B";

          commentPercent.textContent =
            "0%";


          quickLines.textContent =
            "0";

          quickChars.textContent =
            "0";

          quickWords.textContent =
            "0";

          quickCodeLines.textContent =
            "0";

        }


        /* ======================================
           CLEAR
        ======================================= */

        function clearAll() {

          codeInput.value =
            "";


          resetResults();

          updateEditorStats();


          setStatus(
            "idle",
            "جاهز"
          );


          codeInput.focus();

        }


        /* ======================================
           EXAMPLE
        ======================================= */

        exampleBtn.addEventListener(
          "click",
          () => {

            codeInput.value =
              exampleCode;


            updateEditorStats();

            analyze();

          }
        );


        /* ======================================
           EVENTS
        ======================================= */

        codeInput.addEventListener(
          "input",
          () => {

            updateEditorStats();

            if (codeInput.value.trim()) {
              analyze();
            } else {
              resetResults();

              setStatus(
                "idle",
                "جاهز"
              );
            }

          }
        );


        analyzeBtn.addEventListener(
          "click",
          analyze
        );


        clearBtn.addEventListener(
          "click",
          clearAll
        );


        /* ======================================
           SCROLL LINE NUMBERS
        ======================================= */

        codeInput.addEventListener(
          "scroll",
          () => {

            lineNumbers.scrollTop =
              codeInput.scrollTop;

          }
        );


        /* ======================================
           TAB SUPPORT
        ======================================= */

        codeInput.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();


              const start =
                codeInput.selectionStart;

              const end =
                codeInput.selectionEnd;


              codeInput.value =
                codeInput.value.substring(
                  0,
                  start
                ) +
                "  " +
                codeInput.value.substring(
                  end
                );


              codeInput.selectionStart =
                codeInput.selectionEnd =
                  start + 2;


              updateEditorStats();

              analyze();

            }


            if (
              event.key === "Enter" &&
              (event.ctrlKey ||
               event.metaKey)
            ) {

              event.preventDefault();

              analyze();

            }

          }
        );


        /* ======================================
           INITIAL
        ======================================= */

        updateEditorStats();

        resetResults();

      })();
    </script>


