---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "Source Code Counter - إحصائيات الكود أونلاين مجاناً | Th.Tech";

const description =
  "أداة Source Code Counter مجانية لحساب أسطر الكود والأحرف والكلمات والأسطر الفارغة والتعليقات وحجم الكود مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة Source Code Counter؟",
    a: "أداة لتحليل الكود وحساب عدد الأسطر والأحرف والكلمات والأسطر الفارغة وغير الفارغة والتعليقات وحجم النص البرمجي."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم جميع عمليات التحليل داخل المتصفح، لذلك لا تحتاج إلى إرسال الكود إلى خادم خارجي."
  },
  {
    q: "ما أنواع الأكواد التي يمكن تحليلها؟",
    a: "يمكنك تحليل JavaScript وTypeScript وHTML وCSS وJSON وPython وPHP وJava وC وC++ وغيرها من النصوص البرمجية."
  },
  {
    q: "هل يتم حساب الأسطر الفارغة؟",
    a: "نعم. تعرض الأداة عدد الأسطر الإجمالي والأسطر الفارغة والأسطر التي تحتوي على كود."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم. الأداة مجانية بالكامل ويمكن استخدامها مباشرة من المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      name="theme-color"
      content="#2563eb"
    />

    <link
      rel="icon"
      href={`${base}/logo1.png`}
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>

    <Header />

    <main>

      <!-- ======================================
           HERO
      ======================================= -->

      <section class="hero">

        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container">

          <div class="breadcrumb">

            <a href={`${base}/`}>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <span>
              Source Code Counter
            </span>

          </div>


          <div class="hero-badge">

            <span class="badge-dot"></span>

            Developer Tools

            <i class="fa-solid fa-chart-column"></i>

          </div>


          <div class="hero-icon">

            <i class="fa-solid fa-chart-column"></i>

            <span class="count-mark">
              #
            </span>

          </div>


          <h1>

            Source Code

            <span>Counter</span>

          </h1>


          <p>

            احصل على إحصائيات دقيقة للكود الخاص بك،
            واحسب الأسطر والأحرف والكلمات والتعليقات وحجم الملف مباشرة.

          </p>

        </div>

      </section>


      <!-- ======================================
           TOOL
      ======================================= -->

      <section class="tool-section">

        <div class="container">

          <div class="counter-card">


            <!-- TOP BAR -->

            <div class="topbar">

              <div class="project-info">

                <div class="project-logo">

                  <i class="fa-solid fa-chart-column"></i>

                </div>

                <div>

                  <strong>
                    Source Code Counter
                  </strong>

                  <span>
                    Code Statistics Analyzer
                  </span>

                </div>

              </div>


              <div class="topbar-status">

                <span class="online-dot"></span>

                Local Processing

              </div>

            </div>


            <!-- ACTION BAR -->

            <div class="actionbar">

              <div class="action-group">

                <button
                  id="exampleBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-solid fa-wand-magic-sparkles"></i>

                  مثال

                </button>


                <button
                  id="clearBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-solid fa-trash-can"></i>

                  مسح

                </button>

              </div>


              <div class="action-group">

                <button
                  id="analyzeBtn"
                  class="action primary"
                  type="button"
                >

                  <i class="fa-solid fa-chart-simple"></i>

                  تحليل الكود

                </button>

              </div>

            </div>


            <!-- EDITOR -->

            <div class="workspace">

              <div class="editor-card">

                <div class="editor-head">

                  <div class="editor-label">

                    <span class="file-icon">

                      <i class="fa-solid fa-file-code"></i>

                    </span>

                    <div>

                      <strong>
                        Source Code
                      </strong>

                      <small>
                        أدخل الكود المراد تحليله
                      </small>

                    </div>

                  </div>


                  <div
                    id="editorStats"
                    class="editor-stats"
                  >
                    0 حرف
                  </div>

                </div>


                <div class="code-area">

                  <div
                    id="lineNumbers"
                    class="line-numbers"
                  >
                    1
                  </div>


                  <textarea
                    id="codeInput"
                    spellcheck="false"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="// ضع الكود هنا..."
                  ></textarea>

                </div>


                <div class="editor-foot">

                  <span
                    id="status"
                    class="status idle"
                  >

                    <span class="status-dot"></span>

                    جاهز

                  </span>


                  <span id="sizeInfo">
                    0 B
                  </span>

                </div>

              </div>


              <!-- QUICK STATS -->

              <div class="quick-panel">

                <div class="quick-head">

                  <div>

                    <strong>
                      Live Statistics
                    </strong>

                    <span>
                      إحصائيات مباشرة
                    </span>

                  </div>

                  <i class="fa-solid fa-chart-pie"></i>

                </div>


                <div class="quick-grid">

                  <div class="quick-item">

                    <span class="quick-icon blue">

                      <i class="fa-solid fa-lines-leaning"></i>

                    </span>

                    <div>

                      <strong id="quickLines">
                        0
                      </strong>

                      <span>
                        الأسطر
                      </span>

                    </div>

                  </div>


                  <div class="quick-item">

                    <span class="quick-icon purple">

                      <i class="fa-solid fa-font"></i>

                    </span>

                    <div>

                      <strong id="quickChars">
                        0
                      </strong>

                      <span>
                        الأحرف
                      </span>

                    </div>

                  </div>


                  <div class="quick-item">

                    <span class="quick-icon cyan">

                      <i class="fa-solid fa-align-left"></i>

                    </span>

                    <div>

                      <strong id="quickWords">
                        0
                      </strong>

                      <span>
                        الكلمات
                      </span>

                    </div>

                  </div>


                  <div class="quick-item">

                    <span class="quick-icon green">

                      <i class="fa-solid fa-code"></i>

                    </span>

                    <div>

                      <strong id="quickCodeLines">
                        0
                      </strong>

                      <span>
                        أسطر الكود
                      </span>

                    </div>

                  </div>

                </div>


                <div class="quick-note">

                  <i class="fa-solid fa-shield-halved"></i>

                  تتم معالجة الكود محلياً داخل المتصفح

                </div>

              </div>

            </div>


            <!-- RESULT -->

            <div class="result-section">

              <div class="result-head">

                <div class="result-title">

                  <div class="result-icon">

                    <i class="fa-solid fa-chart-column"></i>

                  </div>

                  <div>

                    <strong>
                      Code Statistics
                    </strong>

                    <span>
                      إحصائيات وتحليل الكود
                    </span>

                  </div>

                </div>


                <div class="result-badge">

                  <span class="result-dot"></span>

                  Analyzed

                </div>

              </div>


              <div class="statistics-grid">


                <div class="stat-card">

                  <div class="stat-card-icon blue">

                    <i class="fa-solid fa-list-ol"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      إجمالي الأسطر
                    </span>

                    <strong id="totalLines">
                      0
                    </strong>

                    <small>
                      Total Lines
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon green">

                    <i class="fa-solid fa-code"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      أسطر الكود
                    </span>

                    <strong id="codeLines">
                      0
                    </strong>

                    <small>
                      Code Lines
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon orange">

                    <i class="fa-regular fa-square"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      أسطر فارغة
                    </span>

                    <strong id="blankLines">
                      0
                    </strong>

                    <small>
                      Blank Lines
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon purple">

                    <i class="fa-solid fa-comment"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      أسطر التعليقات
                    </span>

                    <strong id="commentLines">
                      0
                    </strong>

                    <small>
                      Comment Lines
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon cyan">

                    <i class="fa-solid fa-font"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      الأحرف
                    </span>

                    <strong id="characters">
                      0
                    </strong>

                    <small>
                      Characters
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon indigo">

                    <i class="fa-solid fa-align-left"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      الكلمات
                    </span>

                    <strong id="words">
                      0
                    </strong>

                    <small>
                      Words
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon red">

                    <i class="fa-solid fa-file-code"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      حجم الكود
                    </span>

                    <strong id="fileSize">
                      0 B
                    </strong>

                    <small>
                      File Size
                    </small>

                  </div>

                </div>


                <div class="stat-card">

                  <div class="stat-card-icon teal">

                    <i class="fa-solid fa-percent"></i>

                  </div>

                  <div class="stat-content">

                    <span>
                      نسبة التعليقات
                    </span>

                    <strong id="commentPercent">
                      0%
                    </strong>

                    <small>
                      Comments Ratio
                    </small>

                  </div>

                </div>

              </div>

            </div>


            <!-- TOOL STATS -->

            <div class="tool-stats">

              <div class="tool-stat">

                <div class="tool-stat-icon">

                  <i class="fa-solid fa-bolt"></i>

                </div>

                <div>

                  <strong>
                    Fast
                  </strong>

                  <span>
                    تحليل فوري
                  </span>

                </div>

              </div>


              <div class="tool-stat">

                <div class="tool-stat-icon">

                  <i class="fa-solid fa-chart-column"></i>

                </div>

                <div>

                  <strong>
                    8+
                  </strong>

                  <span>
                    إحصائيات
                  </span>

                </div>

              </div>


              <div class="tool-stat">

                <div class="tool-stat-icon">

                  <i class="fa-solid fa-lock"></i>

                </div>

                <div>

                  <strong>
                    Private
                  </strong>

                  <span>
                    بدون رفع الكود
                  </span>

                </div>

              </div>


              <div class="tool-stat">

                <div class="tool-stat-icon">

                  <i class="fa-solid fa-mobile-screen-button"></i>

                </div>

                <div>

                  <strong>
                    100%
                  </strong>

                  <span>
                    متوافق مع الهاتف
                  </span>

                </div>

              </div>

            </div>


          </div>


          <!-- ======================================
               INFORMATION
          ======================================= -->

          <section class="information">

            <div class="section-title">

              <span>
                Developer Tools
              </span>

              <h2>
                إحصائيات دقيقة للكود
              </h2>

              <p>
                حلّل الكود بسرعة واعرف حجمه وبنيته وعدد الأسطر
                والتعليقات والأحرف والكلمات.
              </p>

            </div>


            <div class="info-grid">


              <article class="info-card">

                <div class="info-number">
                  01
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-chart-column"></i>

                </div>

                <h3>
                  تحليل شامل
                </h3>

                <p>
                  احصل على مجموعة من الإحصائيات المهمة
                  حول الكود في نتيجة واحدة.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  02
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-list-ol"></i>

                </div>

                <h3>
                  حساب الأسطر
                </h3>

                <p>
                  تعرف على عدد الأسطر الإجمالي وأسطر الكود
                  والأسطر الفارغة والتعليقات.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  03
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-shield-halved"></i>

                </div>

                <h3>
                  خصوصية كاملة
                </h3>

                <p>
                  لا يتم إرسال الكود إلى أي خادم،
                  وجميع العمليات تتم محلياً في المتصفح.
                </p>

              </article>

            </div>

          </section>


          <!-- ======================================
               HOW TO
          ======================================= -->

          <section class="how-section">

            <div class="section-title">

              <span>
                How It Works
              </span>

              <h2>
                طريقة استخدام الأداة
              </h2>

            </div>


            <div class="steps">


              <div class="step">

                <div class="step-icon">

                  <span>
                    01
                  </span>

                </div>

                <div>

                  <h3>
                    أدخل الكود
                  </h3>

                  <p>
                    الصق الكود الذي تريد معرفة إحصائياته
                    داخل محرر Source Code.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    02
                  </span>

                </div>

                <div>

                  <h3>
                    ابدأ التحليل
                  </h3>

                  <p>
                    اضغط على زر تحليل الكود للحصول على
                    جميع الإحصائيات.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    03
                  </span>

                </div>

                <div>

                  <h3>
                    راجع النتائج
                  </h3>

                  <p>
                    راجع عدد الأسطر والأحرف والكلمات
                    والحجم والتعليقات.
                  </p>

                </div>

              </div>

            </div>

          </section>


          <!-- ======================================
               FAQ
          ======================================= -->

          <section class="faq-section">

            <div class="section-title">

              <span>
                FAQ
              </span>

              <h2>
                الأسئلة الشائعة
              </h2>

            </div>


            <div class="faq-list">

              {
                faqs.map((faq) => (
                  <details>

                    <summary>

                      <span>
                        {faq.q}
                      </span>

                      <i class="fa-solid fa-chevron-down"></i>

                    </summary>

                    <div class="faq-answer">
                      {faq.a}
                    </div>

                  </details>
                ))
              }

            </div>

          </section>

        </div>

      </section>

    









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/code-diff/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
