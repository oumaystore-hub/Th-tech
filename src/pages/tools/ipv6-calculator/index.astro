  <script>
    const ipInput = document.getElementById("ipInput");
    const prefixInput = document.getElementById("prefixInput");

    const errorBox = document.getElementById("errorBox");
    const errorText = document.getElementById("errorText");

    const networkAddress = document.getElementById("networkAddress");
    const normalizedAddress = document.getElementById("normalizedAddress");
    const prefixResult = document.getElementById("prefixResult");
    const maskResult = document.getElementById("maskResult");
    const firstAddress = document.getElementById("firstAddress");
    const lastAddress = document.getElementById("lastAddress");

    const prefixStat = document.getElementById("prefixStat");
    const totalAddresses = document.getElementById("totalAddresses");
    const ipType = document.getElementById("ipType");
    const formatResult = document.getElementById("formatResult");

    const fullAddress = document.getElementById("fullAddress");
    const networkFull = document.getElementById("networkFull");

    const networkTitle = document.getElementById("networkTitle");
    const validBadge = document.getElementById("validBadge");

    function parseIPv4(value) {
      const parts = value.split(".");

      if (parts.length !== 4) {
        return null;
      }

      const nums = parts.map(part => {
        if (!/^\d+$/.test(part)) {
          return null;
        }

        if (
          part.length > 1 &&
          part.startsWith("0")
        ) {
          return null;
        }

        const number = Number(part);

        if (
          !Number.isInteger(number) ||
          number < 0 ||
          number > 255
        ) {
          return null;
        }

        return number;
      });

      if (nums.some(value => value === null)) {
        return null;
      }

      return nums;
    }

    /*
     * تحويل IPv4 إلى مجموعتين Hex داخل IPv6.
     *
     * 192.168.1.1
     * تصبح:
     * c0a8:0101
     */
    function embeddedIPv4ToHex(value) {
      const parts = parseIPv4(value);

      if (!parts) {
        return null;
      }

      const high =
        ((parts[0] << 8) | parts[1])
          .toString(16)
          .padStart(4, "0");

      const low =
        ((parts[2] << 8) | parts[3])
          .toString(16)
          .padStart(4, "0");

      return [high, low];
    }

    /*
     * محلل IPv6 كامل.
     *
     * يدعم:
     * 2001:db8::1
     * ::1
     * ::
     * 2001:db8:0:0:0:0:0:1
     * ::ffff:192.168.1.1
     */
    function parseIPv6(value) {
      let ip = value.trim().toLowerCase();

      if (!ip || !ip.includes(":")) {
        return null;
      }

      /*
       * IPv6 لا يقبل النقاط إلا إذا كانت
       * في الجزء الأخير على شكل IPv4.
       */
      if (ip.includes(".")) {
        const lastColon = ip.lastIndexOf(":");

        if (lastColon < 0) {
          return null;
        }

        const ipv4Text = ip.slice(lastColon + 1);

        const ipv4Hex = embeddedIPv4ToHex(ipv4Text);

        if (!ipv4Hex) {
          return null;
        }

        ip =
          ip.slice(0, lastColon + 1) +
          ipv4Hex[0] +
          ":" +
          ipv4Hex[1];
      }

      /*
       * لا يسمح بأكثر من ::
       */
      const doubleColonMatches =
        ip.match(/::/g) || [];

      if (doubleColonMatches.length > 1) {
        return null;
      }

      const validGroup =
        group => /^[0-9a-f]{1,4}$/.test(group);

      let groups;

      if (ip.includes("::")) {
        const parts = ip.split("::");

        if (parts.length !== 2) {
          return null;
        }

        const left =
          parts[0]
            ? parts[0].split(":")
            : [];

        const right =
          parts[1]
            ? parts[1].split(":")
            : [];

        if (
          left.some(group => !validGroup(group)) ||
          right.some(group => !validGroup(group))
        ) {
          return null;
        }

        /*
         * :: يجب أن يستبدل مجموعة واحدة على الأقل.
         */
        const missing =
          8 - left.length - right.length;

        if (missing < 1) {
          return null;
        }

        groups = [
          ...left,
          ...Array(missing).fill("0"),
          ...right
        ];
      } else {
        groups = ip.split(":");

        if (groups.length !== 8) {
          return null;
        }

        if (
          groups.some(group => !validGroup(group))
        ) {
          return null;
        }
      }

      if (groups.length !== 8) {
        return null;
      }

      return groups.map(group =>
        parseInt(group, 16)
      );
    }

    function groupsToFull(groups) {
      return groups
        .map(group =>
          group
            .toString(16)
            .padStart(4, "0")
        )
        .join(":");
    }

    /*
     * ضغط IPv6 إلى أقصر صيغة صحيحة.
     *
     * يتم ضغط أطول سلسلة من الأصفار فقط،
     * وعند التعادل يتم اختيار السلسلة الأولى.
     */
    function compressIPv6(groups) {
      const hex = groups.map(group =>
        group.toString(16)
      );

      let bestStart = -1;
      let bestLength = 0;

      let currentStart = -1;
      let currentLength = 0;

      for (let i = 0; i <= 8; i++) {
        if (i < 8 && groups[i] === 0) {
          if (currentStart === -1) {
            currentStart = i;
            currentLength = 1;
          } else {
            currentLength++;
          }
        } else {
          if (currentLength > bestLength) {
            bestStart = currentStart;
            bestLength = currentLength;
          }

          currentStart = -1;
          currentLength = 0;
        }
      }

      /*
       * لا نستخدم :: إذا كان هناك صفر واحد فقط.
       */
      if (bestLength < 2) {
        return hex.join(":");
      }

      const left = hex
        .slice(0, bestStart)
        .join(":");

      const right = hex
        .slice(bestStart + bestLength)
        .join(":");

      if (!left && !right) {
        return "::";
      }

      if (!left) {
        return `::${right}`;
      }

      if (!right) {
        return `${left}::`;
      }

      return `${left}::${right}`;
    }

    function applyPrefix(groups, prefix) {
      const result = [...groups];

      for (let i = prefix; i < 128; i++) {
        const groupIndex = Math.floor(i / 16);
        const bitIndex = 15 - (i % 16);

        result[groupIndex] =
          result[groupIndex] &
          ~(1 << bitIndex);
      }

      return result;
    }

    function getLastAddress(groups, prefix) {
      const result = [...groups];

      for (let i = prefix; i < 128; i++) {
        const groupIndex = Math.floor(i / 16);
        const bitIndex = 15 - (i % 16);

        result[groupIndex] =
          result[groupIndex] |
          (1 << bitIndex);
      }

      return result;
    }

    function isAllZero(groups) {
      return groups.every(value => value === 0);
    }

    function isLoopback(groups) {
      return (
        groups.slice(0, 7).every(value => value === 0) &&
        groups[7] === 1
      );
    }

    function isMulticast(groups) {
      return (groups[0] & 0xff00) === 0xff00;
    }

    function isLinkLocal(groups) {
      return (
        (groups[0] & 0xffc0) === 0xfe80
      );
    }

    function isUniqueLocal(groups) {
      return (
        (groups[0] & 0xfe00) === 0xfc00
      );
    }

    function isDocumentation(groups) {
      return (
        groups[0] === 0x2001 &&
        groups[1] === 0x0db8
      );
    }

    function isIPv4Mapped(groups) {
      return (
        groups[0] === 0 &&
        groups[1] === 0 &&
        groups[2] === 0 &&
        groups[3] === 0 &&
        groups[4] === 0 &&
        groups[5] === 0xffff
      );
    }

    function classifyIPv6(groups) {
      if (isAllZero(groups)) {
        return "Unspecified";
      }

      if (isLoopback(groups)) {
        return "Loopback";
      }

      if (isIPv4Mapped(groups)) {
        return "IPv4-mapped";
      }

      if (isMulticast(groups)) {
        return "Multicast";
      }

      if (isLinkLocal(groups)) {
        return "Link-local";
      }

      if (isUniqueLocal(groups)) {
        return "Private / Unique Local";
      }

      if (isDocumentation(groups)) {
        return "Documentation";
      }

      return "Global Unicast";
    }

    function getFormat(value) {
      return value.includes("::")
        ? "Compressed"
        : "Full";
    }

    function addressCount(prefix) {
      const hostBits = 128 - prefix;

      if (hostBits === 0) {
        return "1";
      }

      if (hostBits <= 64) {
        return `2${toSuperscript(hostBits)}`;
      }

      return `2${toSuperscript(hostBits)}`;
    }

    function toSuperscript(number) {
      const chars = {
        "0": "⁰",
        "1": "¹",
        "2": "²",
        "3": "³",
        "4": "⁴",
        "5": "⁵",
        "6": "⁶",
        "7": "⁷",
        "8": "⁸",
        "9": "⁹"
      };

      return String(number)
        .split("")
        .map(char => chars[char] || char)
        .join("");
    }

    function showError(message) {
      errorText.textContent = message;
      errorBox.classList.add("show");

      validBadge.innerHTML =
        '<i class="fa-solid fa-xmark"></i> غير صالح';

      validBadge.style.color = "#fca5a5";
      validBadge.style.background =
        "rgba(239,68,68,.08)";
    }

    function hideError() {
      errorBox.classList.remove("show");

      validBadge.innerHTML =
        '<i class="fa-solid fa-check"></i> صالح';

      validBadge.style.color = "#86efac";
      validBadge.style.background =
        "rgba(34,197,94,.08)";
    }

    function calculate() {
      const value = ipInput.value.trim();
      const prefix = Number(prefixInput.value);

      const groups = parseIPv6(value);

      if (!groups) {
        showError(
          "أدخل عنوان IPv6 صحيحًا مثل 2001:db8::1."
        );
        return;
      }

      if (
        !Number.isInteger(prefix) ||
        prefix < 0 ||
        prefix > 128
      ) {
        showError(
          "قيمة Prefix يجب أن تكون بين /0 و /128."
        );
        return;
      }

      hideError();

      const networkGroups =
        applyPrefix(groups, prefix);

      const lastGroups =
        getLastAddress(groups, prefix);

      const full =
        groupsToFull(groups);

      const networkFullValue =
        groupsToFull(networkGroups);

      const normalized =
        compressIPv6(groups);

      const network =
        compressIPv6(networkGroups);

      const first =
        network;

      const last =
        compressIPv6(lastGroups);

      const type =
        classifyIPv6(groups);

      const format =
        getFormat(value);

      networkAddress.textContent = network;
      normalizedAddress.textContent = normalized;

      prefixResult.textContent = `/${prefix}`;
      maskResult.textContent = `/${prefix}`;

      firstAddress.textContent = first;
      lastAddress.textContent = last;

      prefixStat.textContent = `/${prefix}`;

      totalAddresses.textContent =
        addressCount(prefix);

      ipType.textContent = type;
      formatResult.textContent = format;

      fullAddress.textContent = full;
      networkFull.textContent =
        networkFullValue;

      networkTitle.textContent =
        `${network}/${prefix}`;
    }

    ipInput.addEventListener(
      "input",
      calculate
    );

    prefixInput.addEventListener(
      "input",
      calculate
    );

    document
      .querySelectorAll(".quick-btn")
      .forEach(button => {
        button.addEventListener("click", () => {
          ipInput.value =
            button.dataset.ip;

          prefixInput.value =
            button.dataset.prefix;

          calculate();
        });
      });

    document
      .getElementById("resetBtn")
      .addEventListener("click", () => {
        ipInput.value =
          "2001:db8:1234:5678::1";

        prefixInput.value = "64";

        calculate();
      });

    document
      .getElementById("copyBtn")
      .addEventListener("click", async () => {

        const text = [
          `IPv6: ${ipInput.value}/${prefixInput.value}`,
          `Network: ${networkAddress.textContent}`,
          `Normalized: ${normalizedAddress.textContent}`,
          `Prefix: ${prefixResult.textContent}`,
          `First Address: ${firstAddress.textContent}`,
          `Last Address: ${lastAddress.textContent}`,
          `Total Addresses: ${totalAddresses.textContent}`,
          `Type: ${ipType.textContent}`
        ].join("\n");

        try {
          await navigator.clipboard.writeText(text);

          const button =
            document.getElementById("copyBtn");

          const old =
            button.innerHTML;

          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            button.innerHTML = old;
          }, 1500);

        } catch {
          // Clipboard unavailable.
        }
      });

    calculate();
  </script>
</body>
</html>
