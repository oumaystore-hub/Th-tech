---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const canonical =
  `https://oumaystore-hub.github.io${base}/tools/ipv6-calculator/`;

const title = 'IPv6 Calculator | حاسبة IPv6 | Th.Tech';
const description =
  'حاسبة IPv6 مجانية لحساب عنوان الشبكة، البادئة، النطاق، عدد العناوين ونوع عنوان IPv6 مباشرة داخل المتصفح.';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      const theme = localStorage.getItem('theme');

      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark-mode');
      }
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-orb orb-one"></div>
      <div class="hero-orb orb-two"></div>

      <div class="container">
        <div class="breadcrumbs">
          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>

          <i class="fa-solid fa-chevron-left"></i>

          <span>IPv6 Calculator</span>
        </div>

        <div class="hero-content">
          <div class="tool-icon">
            <i class="fa-solid fa-network-wired"></i>
          </div>

          <div class="eyebrow">
            <span></span>
            أداة شبكات مجانية
          </div>

          <h1>حاسبة <strong>IPv6</strong></h1>

          <p>
            احسب شبكة IPv6 والبادئة والنطاق وعدد العناوين واكتشف نوع
            العنوان مباشرة وبشكل فوري داخل المتصفح.
          </p>

          <div class="tags">
            <span>
              <i class="fa-solid fa-bolt"></i>
              حساب فوري
            </span>

            <span>
              <i class="fa-solid fa-lock"></i>
              معالجة محلية
            </span>

            <span>
              <i class="fa-solid fa-network-wired"></i>
              IPv6
            </span>

            <span>
              <i class="fa-solid fa-code"></i>
              CIDR
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-section">
      <div class="container">

        <div class="tool-card">

          <div class="card-header">
            <div>
              <div class="card-title">
                <i class="fa-solid fa-calculator"></i>
                حاسبة IPv6
              </div>

              <p>
                أدخل عنوان IPv6 وقيمة البادئة للحصول على تفاصيل الشبكة.
              </p>
            </div>

            <div class="live-status">
              <span></span>
              مباشر
            </div>
          </div>

          <div class="input-grid">

            <div class="field">
              <label for="ipInput">
                <i class="fa-solid fa-location-dot"></i>
                عنوان IPv6
              </label>

              <div class="input-wrap">
                <input
                  id="ipInput"
                  type="text"
                  dir="ltr"
                  autocomplete="off"
                  spellcheck="false"
                  value="2001:db8:1234:5678::1"
                  placeholder="2001:db8:1234:5678::1"
                />
              </div>
            </div>

            <div class="field">
              <label for="prefixInput">
                <i class="fa-solid fa-slash"></i>
                Prefix Length
              </label>

              <div class="prefix-control">
                <input
                  id="prefixInput"
                  type="number"
                  min="0"
                  max="128"
                  value="64"
                  dir="ltr"
                  inputmode="numeric"
                />

                <span>/</span>
              </div>
            </div>

          </div>

          <div class="quick-row">
            <button
              class="quick-btn"
              data-ip="2001:db8:1234:5678::1"
              data-prefix="64"
            >
              2001:db8:1234:5678::1/64
            </button>

            <button
              class="quick-btn"
              data-ip="2001:db8::1"
              data-prefix="32"
            >
              2001:db8::1/32
            </button>

            <button
              class="quick-btn"
              data-ip="fe80::1"
              data-prefix="64"
            >
              fe80::1/64
            </button>

            <button
              class="quick-btn"
              data-ip="fc00::1"
              data-prefix="7"
            >
              fc00::1/7
            </button>
          </div>

          <div class="error-box" id="errorBox">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span id="errorText">عنوان IPv6 غير صالح.</span>
          </div>

          <div class="result-head">
            <div>
              <h2>نتائج الحساب</h2>
              <p id="networkTitle">2001:db8:1234:5678::/64</p>
            </div>

            <div class="valid-badge" id="validBadge">
              <i class="fa-solid fa-check"></i>
              صالح
            </div>
          </div>

          <div class="results-grid">

            <div class="result-box primary">
              <div class="result-label">
                <span>عنوان الشبكة</span>
                <i class="fa-solid fa-network-wired"></i>
              </div>

              <strong id="networkAddress">
                2001:db8:1234:5678::
              </strong>

              <small>Network Address</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>العنوان الأصلي</span>
                <i class="fa-solid fa-location-dot"></i>
              </div>

              <strong id="normalizedAddress">
                2001:db8:1234:5678::1
              </strong>

              <small>Normalized IPv6</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>Prefix</span>
                <i class="fa-solid fa-slash"></i>
              </div>

              <strong id="prefixResult">/64</strong>

              <small>Prefix Length</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>Subnet Mask</span>
                <i class="fa-solid fa-mask-face"></i>
              </div>

              <strong id="maskResult">/64</strong>

              <small>Network Prefix</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>أول عنوان</span>
                <i class="fa-solid fa-arrow-right"></i>
              </div>

              <strong id="firstAddress">
                2001:db8:1234:5678::
              </strong>

              <small>First Address</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>آخر عنوان</span>
                <i class="fa-solid fa-arrow-left"></i>
              </div>

              <strong id="lastAddress">
                2001:db8:1234:5678:ffff:ffff:ffff:ffff
              </strong>

              <small>Last Address</small>
            </div>

          </div>

          <div class="stats-grid">

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
              </span>

              <div>
                <small>Prefix</small>
                <strong id="prefixStat">/64</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-hashtag"></i>
              </span>

              <div>
                <small>عدد العناوين</small>
                <strong id="totalAddresses">2⁶⁴</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </span>

              <div>
                <small>نوع العنوان</small>
                <strong id="ipType">Documentation</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </span>

              <div>
                <small>الصيغة</small>
                <strong id="formatResult">Compressed</strong>
              </div>
            </div>

          </div>

          <div class="binary-card">

            <div class="binary-title">
              <i class="fa-solid fa-microchip"></i>
              التمثيل الكامل
            </div>

            <div class="binary-row">
              <span>FULL</span>

              <code id="fullAddress">
                2001:0db8:1234:5678:0000:0000:0000:0001
              </code>
            </div>

            <div class="binary-row">
              <span>NETWORK</span>

              <code id="networkFull">
                2001:0db8:1234:5678:0000:0000:0000:0000
              </code>
            </div>

          </div>

          <div class="action-row">
            <button class="action-btn secondary" id="copyBtn">
              <i class="fa-regular fa-copy"></i>
              نسخ النتائج
            </button>

            <button class="action-btn secondary" id="resetBtn">
              <i class="fa-solid fa-rotate-right"></i>
              إعادة تعيين
            </button>
          </div>

        </div>

        <div class="privacy-card">
          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>خصوصيتك محفوظة</h3>

            <p>
              جميع العمليات الحسابية تتم داخل المتصفح مباشرة ولا يتم
              إرسال عنوان IPv6 إلى أي خادم.
            </p>
          </div>
        </div>

      </div>
    </section>

    <section class="info-section">
      <div class="container">

        <div class="section-heading">
          <span>دليل سريع</span>

          <h2>ما هي حاسبة IPv6؟</h2>

          <p>
            تساعدك هذه الأداة على تحليل عناوين IPv6 وحساب الشبكة
            والنطاق وعدد العناوين وفق Prefix محدد.
          </p>
        </div>

        <div class="info-grid">

          <article class="info-card">
            <div class="info-number">01</div>

            <i class="fa-solid fa-network-wired"></i>

            <h3>Network Address</h3>

            <p>
              هو عنوان بداية الشبكة الناتج عن تطبيق الـ Prefix
              على عنوان IPv6.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">02</div>

            <i class="fa-solid fa-slash"></i>

            <h3>Prefix Length</h3>

            <p>
              يحدد عدد البتات التي تمثل جزء الشبكة، مثل
              <code>/64</code>.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">03</div>

            <i class="fa-solid fa-arrows-left-right"></i>

            <h3>Address Range</h3>

            <p>
              يعرض أول وآخر عنوان داخل نطاق IPv6 الناتج عن الـ Prefix.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">04</div>

            <i class="fa-solid fa-database"></i>

            <h3>عدد العناوين</h3>

            <p>
              شبكة IPv6 ذات Prefix بطول <code>/64</code> تحتوي على
              <code>2⁶⁴</code> عنوانًا.
            </p>
          </article>

        </div>

      </div>
    </section>

    <section class="how-section">
      <div class="container">

        <div class="section-heading">
          <span>طريقة الاستخدام</span>

          <h2>كيف تستخدم الأداة؟</h2>
        </div>

        <div class="steps">

          <div class="step">
            <span>1</span>

            <div>
              <h3>أدخل عنوان IPv6</h3>

              <p>
                مثال: 2001:db8:1234:5678::1
              </p>
            </div>
          </div>

          <div class="step">
            <span>2</span>

            <div>
              <h3>حدد Prefix</h3>

              <p>
                مثال: /64 أو /48 أو /32.
              </p>
            </div>
          </div>

          <div class="step">
            <span>3</span>

            <div>
              <h3>شاهد النتائج</h3>

              <p>
                سيتم حساب الشبكة والنطاق وعدد العناوين فورًا.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <section class="faq-section">
      <div class="container">

        <div class="section-heading">
          <span>FAQ</span>

          <h2>الأسئلة الشائعة</h2>
        </div>

        <div class="faq-list">

          <details>
            <summary>
              ماذا يعني /64 في IPv6؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              يعني أن أول 64 بت تمثل جزء الشبكة، بينما تبقى 64 بت
              لباقي العناوين داخل الشبكة.
            </p>
          </details>

          <details>
            <summary>
              هل تدعم الأداة الاختصار ::؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم. يمكن استخدام الصيغة المختصرة القياسية مثل
              2001:db8::1، مع التحقق من صحة موضع الاختصار.
            </p>
          </details>

          <details>
            <summary>
              هل تدعم IPv4 المضمّن داخل IPv6؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم، تدعم الأداة صيغ IPv4-mapped وIPv4-compatible
              مثل ::ffff:192.168.1.1.
            </p>
          </details>

          <details>
            <summary>
              هل تتم معالجة العنوان محليًا؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم. الحساب والتحقق يتمان بالكامل داخل المتصفح ولا
              يتم إرسال العنوان إلى خادم خارجي.
            </p>
          </details>

        </div>

      </div>
    </section>
  





<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/chmod-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Chmod Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/cidr-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Cidr Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv4-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Ipv4 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/subnet-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Subnet Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  /* الوضع الفاتح */
  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    color: #0f172a;
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card strong {
    color: #0f172a;
  }

  [data-theme="light"] .related-tool-card small {
    color: #64748b;
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }

  [data-theme="light"] .related-tool-icon {
    background: rgba(14, 165, 233, 0.12);
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

  <Footer />

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background: #07111f;
      color: #eaf4ff;
    }

    :global(body),
    :global(button),
    :global(input) {
      font-family: "Cairo", sans-serif;
    }

    :global(code),
    .result-box strong,
    .binary-row code {
      font-family: "JetBrains Mono", monospace;
    }

    :global(html[data-theme="light"] body) {
      background: #f4f9ff;
      color: #102033;
    }

    .container {
      width: min(1160px, calc(100% - 32px));
      margin: auto;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 44px 0 78px;
      background:
        radial-gradient(circle at 15% 25%, rgba(56,189,248,.15), transparent 28%),
        radial-gradient(circle at 85% 20%, rgba(37,99,235,.18), transparent 30%),
        linear-gradient(145deg, #07111f, #0a1830 60%, #07111f);
    }

    :global(html[data-theme="light"]) .hero {
      background:
        radial-gradient(circle at 15% 25%, rgba(56,189,248,.16), transparent 28%),
        radial-gradient(circle at 85% 20%, rgba(37,99,235,.13), transparent 30%),
        linear-gradient(145deg, #f2f9ff, #eaf5ff);
    }

    .hero-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
    }

    .orb-one {
      width: 180px;
      height: 180px;
      top: -80px;
      right: 8%;
      background: rgba(14,165,233,.1);
    }

    .orb-two {
      width: 140px;
      height: 140px;
      bottom: -70px;
      left: 8%;
      background: rgba(59,130,246,.1);
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      color: #91a9c3;
      font-size: .82rem;
      margin-bottom: 48px;
    }

    .breadcrumbs a {
      color: #a9c6e3;
      text-decoration: none;
      transition: .2s;
    }

    .breadcrumbs a:hover {
      color: #38bdf8;
    }

    .breadcrumbs i {
      font-size: .65rem;
      opacity: .55;
    }

    .hero-content {
      max-width: 780px;
    }

    .tool-icon {
      width: 66px;
      height: 66px;
      display: grid;
