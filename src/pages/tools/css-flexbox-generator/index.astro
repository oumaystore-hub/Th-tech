---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CSS Flexbox Generator - مولد Flexbox أونلاين | Th.Tech";
const description =
  "مولد CSS Flexbox مجاني لإنشاء تخطيطات Flexbox بسهولة مع معاينة مباشرة ونسخ كود CSS جاهز.";

const defaultItems = [
  { text: "Item 1", color: "#3b82f6" },
  { text: "Item 2", color: "#06b6d4" },
  { text: "Item 3", color: "#8b5cf6" },
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>
          <span>CSS Flexbox Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-layer-group"></i>
          </div>

          <div>
            <span class="kicker">
              <i class="fas fa-code"></i>
              CSS Tools
            </span>

            <h1>
              CSS <span>Flexbox Generator</span>
            </h1>

            <p>
              أنشئ تخطيطات Flexbox بسهولة مع معاينة مباشرة
              واحصل على كود CSS جاهز للنسخ والاستخدام.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- TOOLBAR -->
          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-sliders"></i>
              <span>Flexbox Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="resetBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-rotate-left"></i>
                إعادة ضبط
              </button>

              <button
                id="copyBtn"
                class="tool-btn primary-small"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ CSS
              </button>

            </div>

          </div>


          <!-- GENERATOR -->
          <div class="generator">

            <!-- CONTROLS -->
            <aside class="controls">

              <div class="control-section">

                <div class="control-title">
                  <i class="fas fa-box"></i>
                  الحاوية
                </div>


                <!-- FLEX DIRECTION -->
                <label class="control-label">
                  Flex Direction
                </label>

                <select id="direction">
                  <option value="row">row</option>
                  <option value="row-reverse">row-reverse</option>
                  <option value="column">column</option>
                  <option value="column-reverse">column-reverse</option>
                </select>


                <!-- JUSTIFY -->
                <label class="control-label">
                  Justify Content
                </label>

                <select id="justify">
                  <option value="flex-start">flex-start</option>
                  <option value="center">center</option>
                  <option value="flex-end">flex-end</option>
                  <option value="space-between">space-between</option>
                  <option value="space-around">space-around</option>
                  <option value="space-evenly">space-evenly</option>
                </select>


                <!-- ALIGN -->
                <label class="control-label">
                  Align Items
                </label>

                <select id="align">
                  <option value="stretch">stretch</option>
                  <option value="flex-start">flex-start</option>
                  <option value="center">center</option>
                  <option value="flex-end">flex-end</option>
                  <option value="baseline">baseline</option>
                </select>


                <!-- WRAP -->
                <label class="control-label">
                  Flex Wrap
                </label>

                <select id="wrap">
                  <option value="nowrap">nowrap</option>
                  <option value="wrap">wrap</option>
                  <option value="wrap-reverse">wrap-reverse</option>
                </select>


                <!-- GAP -->
                <label class="control-label">
                  Gap
                </label>

                <div class="range-row">
                  <input
                    id="gap"
                    type="range"
                    min="0"
                    max="60"
                    value="15"
                  />
                  <span id="gapValue">15px</span>
                </div>


                <!-- ROW GAP -->
                <label class="control-label">
                  Row Gap
                </label>

                <div class="range-row">
                  <input
                    id="rowGap"
                    type="range"
                    min="0"
                    max="60"
                    value="15"
                  />
                  <span id="rowGapValue">15px</span>
                </div>


                <!-- COLUMN GAP -->
                <label class="control-label">
                  Column Gap
                </label>

                <div class="range-row">
                  <input
                    id="columnGap"
                    type="range"
                    min="0"
                    max="60"
                    value="15"
                  />
                  <span id="columnGapValue">15px</span>
                </div>

              </div>


              <!-- ALIGN CONTENT -->
              <div class="control-section">

                <div class="control-title">
                  <i class="fas fa-align-center"></i>
                  Align Content
                </div>

                <select id="alignContent">
                  <option value="normal">normal</option>
                  <option value="flex-start">flex-start</option>
                  <option value="center">center</option>
                  <option value="flex-end">flex-end</option>
                  <option value="space-between">space-between</option>
                  <option value="space-around">space-around</option>
                  <option value="stretch">stretch</option>
                </select>

              </div>


              <!-- ITEMS -->
              <div class="control-section">

                <div class="control-title">
                  <i class="fas fa-cubes"></i>
                  العناصر
                </div>

                <label class="control-label">
                  عدد العناصر
                </label>

                <div class="items-buttons">

                  <button id="minusBtn" type="button">
                    <i class="fas fa-minus"></i>
                  </button>

                  <span id="itemCount">3</span>

                  <button id="plusBtn" type="button">
                    <i class="fas fa-plus"></i>
                  </button>

                </div>

              </div>

            </aside>


            <!-- PREVIEW -->
            <div class="preview-area">

              <div class="preview-header">

                <div>
                  <i class="fas fa-eye"></i>
                  المعاينة المباشرة
                </div>

                <span id="previewInfo">
                  3 عناصر
                </span>

              </div>

              <div class="preview-stage">

                <div id="flexPreview" class="flex-preview">

                  {
                    defaultItems.map((item) => (
                      <div
                        class="flex-item"
                        style={`background:${item.color}`}
                      >
                        {item.text}
                      </div>
                    ))
                  }

                </div>

              </div>

            </div>

          </div>


          <!-- CSS OUTPUT -->
          <div class="code-section">

            <div class="code-header">

              <div>
                <i class="fas fa-file-code"></i>
                CSS الناتج
              </div>

              <button
                id="copyCodeBtn"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ الكود
              </button>

            </div>

            <pre id="cssOutput"></pre>

          </div>


          <!-- STATUS -->
          <div id="status" class="status hidden">
            <i id="statusIcon" class="fas fa-check-circle"></i>
            <span id="statusText"></span>
          </div>

        </div>


        <!-- INFO -->
        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>معاينة مباشرة</h3>
              <p>
                شاهد تأثير خصائص Flexbox فوراً أثناء تغيير الإعدادات.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>CSS جاهز</h3>
              <p>
                احصل على كود CSS مرتب وجاهز للنسخ إلى مشروعك.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>يعمل محلياً</h3>
              <p>
                تتم جميع العمليات داخل المتصفح دون إرسال بياناتك إلى خادم خارجي.
              </p>
            </div>

          </div>

        </div>


        <!-- HOW -->
        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>Flexbox Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-sliders"></i>
              </div>

              <h3>اختر الخصائص</h3>

              <p>
                حدد اتجاه العناصر وطريقة المحاذاة والالتفاف والمسافات.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-eye"></i>
              </div>

              <h3>شاهد المعاينة</h3>

              <p>
                ستتغير المعاينة مباشرة عند تعديل أي خاصية.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>انسخ CSS</h3>

              <p>
                انسخ الكود الناتج واستخدمه مباشرة في مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- FAQ -->
        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>Flexbox</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>
              <summary>
                ما هو CSS Flexbox؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                Flexbox هو نظام تخطيط في CSS يساعد على ترتيب العناصر
                ومحاذاتها داخل الحاوية بطريقة مرنة وسريعة.
              </p>
            </details>


            <details>
              <summary>
                ما الفرق بين justify-content و align-items؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                تتحكم justify-content في توزيع العناصر على المحور الرئيسي،
                بينما تتحكم align-items في محاذاتها على المحور المتقاطع.
              </p>
            </details>


            <details>
              <summary>
                ما وظيفة flex-wrap؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                تحدد flex-wrap ما إذا كانت العناصر ستنتقل إلى سطر أو عمود جديد
                عندما لا تتوفر مساحة كافية.
              </p>
            </details>


            <details>
              <summary>
                هل الكود الناتج جاهز للاستخدام؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يمكنك نسخ CSS الناتج ووضعه مباشرة داخل ملف CSS في مشروعك.
              </p>
            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- CSS -->
  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15,23,42,.09);
      --shadow: 0 20px 60px rgba(15,23,42,.08);
    }

    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --border: rgba(148,163,184,.12);
      --shadow: 0 20px 60px rgba(0,0,0,.28);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    select,
    input {
      font-family: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }

    /* HERO */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37,99,235,.10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6,182,212,.08),
          transparent 35%
        );
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }

    .breadcrumb a:hover {
      color: var(--primary);
    }

    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }

    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 22px;
      color: var(--primary);
      background: rgba(37,99,235,.10);
      border: 1px solid rgba(37,99,235,.15);
      font-size: 2rem;
      box-shadow: 0 15px 35px rgba(37,99,235,.10);
    }

    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--primary);
      font-size: .76rem;
      font-weight: 800;
    }

    .hero-content h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem,5vw,3.2rem);
      line-height: 1.25;
    }

    .hero-content h1 span {
      color: var(--primary);
    }

    .hero-content p {
      max-width: 700px;
      margin: 0;
      color: var(--muted);
      font-size: .92rem;
    }

    /* TOOL */

    .tool-section {
      padding: 65px 0 90px;
    }

    .tool-card {
      overflow: hidden;
      border-radius: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--card2);
    }

    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: .9rem;
      font-weight: 800;
    }

    .toolbar-title i {
      color: var(--primary);
    }

    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 38px;
      padding: 7px 13px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      font-size: .76rem;
      font-weight: 700;
      cursor: pointer;
      transition: .2s ease;
    }

    .tool-btn:hover {
      transform: translateY(-2px);
    }

    .tool-btn.primary-small {
      color: white;
      background: var(--primary);
      border-color: var(--primary);
    }

    .tool-btn.primary-small:hover {
      background: var(--primary-hover);
    }

    /* GENERATOR */

    .generator {
      display: grid;
      grid-template-columns: 300px 1fr;
      min-height: 570px;
    }

    .controls {
      padding: 22px;
      border-left: 1px solid var(--border);
      background: var(--card2);
    }

    .control-section {
      padding-bottom: 22px;
      margin-bottom: 22px;
      border-bottom: 1px solid var(--border);
    }

    .control-section:last-child {
      border-bottom: 0;
      margin-bottom: 0;
    }

    .control-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 17px;
      font-size: .86rem;
      font-weight: 800;
    }

    .control-title i {
      color: var(--primary);
    }

    .control-label {
      display: block;
      margin: 13px 0 6px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 700;
    }

    select {
      width: 100%;
      height: 40px;
      padding: 0 10px;
      outline: none;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      cursor: pointer;
      font-size: .75rem;
    }

    select:focus {
      border-color: var(--primary);
    }

    .range-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .range-row input {
      flex: 1;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .range-row span {
      min-width: 43px;
      color: var(--primary);
      font-size: .7rem;
      font-weight: 800;
      direction: ltr;
      text-align: center;
    }

    .items-buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin-top: 10px;
    }

    .items-buttons button {
      width: 36px;
      height: 36px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--card);
      color: var(--primary);
      cursor: pointer;
    }

    .items-buttons button:hover {
      background: rgba(37,99,235,.08);
    }

    .items-buttons span {
      min-width: 25px;
      text-align: center;
      font-weight: 800;
    }

    /* PREVIEW */

    .preview-area {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      color: var(--muted);
      font-size: .75rem;
      font-weight: 700;
    }

    .preview-header > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .preview-header i {
      color: var(--primary);
    }

    .preview-stage {
      flex: 1;
      min-height: 500px;
      padding: 25px;
      display: flex;
      align-items: stretch;
      background:
        linear-gradient(
          45deg,
          rgba(100,116,139,.035) 25%,
          transparent 25%,
          transparent 75%,
          rgba(100,116,139,.035) 75%
        );
      background-size: 30px 30px;
    }

    .flex-preview {
      width: 100%;
      min-height: 450px;
      padding: 25px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      align-content: normal;
      flex-wrap: nowrap;
      gap: 15px;
      border: 2px dashed rgba(37,99,235,.22);
      border-radius: 16px;
      background: rgba(37,99,235,.025);
      overflow: auto;
    }

    .flex-item {
      min-width: 90px;
      min-height: 65px;
      padding: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border-radius: 12px;
      color: white;
      font-family: Consolas, monospace;
      font-size: .78rem;
      font-weight: 700;
      box-shadow: 0 8px 20px rgba(15,23,42,.12);
    }

    /* CODE */

    .code-section {
      margin: 0 20px 20px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: #0b1220;
    }

    .code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 15px;
      color: #cbd5e1;
      font-size: .75rem;
      font-weight: 700;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .code-header > div {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .code-header i {
      color: #60a5fa;
    }

    .code-header button {
      border: 0;
      background: rgba(255,255,255,.07);
      color: #e2e8f0;
      padding: 7px 11px;
      border-radius: 8px;
      cursor: pointer;
      font-size: .7rem;
    }

    .code-header button:hover {
      background: rgba(255,255,255,.12);
    }

    #cssOutput {
      margin: 0;
      padding: 20px;
      overflow-x: auto;
      color: #dbeafe;
      direction: ltr;
      text-align: left;
      font-family: Consolas,"Courier New",monospace;
      font-size: .78rem;
      line-height: 1.8;
      white-space: pre-wrap;
    }

    /* STATUS */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 0 20px 20px;
      padding: 11px 15px;
      border-radius: 11px;
      background: rgba(34,197,94,.08);
      border: 1px solid rgba(34,197,94,.15);
      color: var(--green);
      font-size: .78rem;
      font-weight: 700;
    }

    .status.error {
      background: rgba(220,38,38,.08);
      border-color: rgba(220,38,38,.15);
      color: var(--red);
    }

    .hidden {
      display: none;
    }

    /* INFO */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 17px;
      margin-top: 25px;
    }

    .info-card {
      display: flex;
      gap: 14px;
      padding: 22px;
      border-radius: 17px;
      background: var(--card);
      border: 1px solid var(--border);
      transition: .25s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);
      border-color: rgba(37,99,235,.25);
    }

    .info-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      color: var(--primary);
      background: rgba(37,99,235,.09);
    }

    .info-card h3 {
      margin: 0 0 5px;
      font-size: .9rem;
    }

    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: .74rem;
      line-height: 1.8;
    }

    /* SECTIONS */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(1.7rem,4vw,2.4rem);
    }

    .section-heading h2 span {
      color: var(--primary);
    }

    /* STEPS */

    .steps {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 18px;
    }

    .step {
      position: relative;
      overflow: hidden;
      padding: 30px 25px;
      text-align: center;
      border-radius: 20px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .step-number {
      position: absolute;
      top: 10px;
      left: 15px;
      color: var(--primary);
      opacity: .08;
      font-size: 3rem;
      font-weight: 800;
    }

    .step-icon {
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 17px;
      border-radius: 16px;
      color: var(--primary);
      background: rgba(37,99,235,.09);
    }

    .step h3 {
      margin: 0 0 7px;
      font-size: 1rem;
    }

    .step p {
      margin: 0;
      color: var(--muted);
      font-size: .76rem;
      line-height: 1.8;
    }

    /* FAQ */

    .faq-list {
      max-width: 900px;
      margin: auto;
      display: grid;
      gap: 12px;
    }

    details {
      padding: 0 20px;
      border-radius: 15px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 19px 0;
      cursor: pointer;
      list-style: none;
      font-size: .86rem;
      font-weight: 700;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary i {
      color: var(--primary);
      font-size: .7rem;
      transition: transform .2s ease;
    }

    details[open] summary i {
      transform: rotate(180deg);
    }

    details p {
      margin: 0;
      padding: 0 0 19px;
      color: var(--muted);
      font-size: .76rem;
      line-height: 1.9;
    }

    /* MOBILE */

    @media (max-width: 900px) {

      .generator {
        grid-template-columns: 1fr;
      }

      .controls {
        border-left: 0;
        border-bottom: 1px solid var(--border);
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

    }

    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }

      .tool-hero {
        padding: 30px 0 40px;
      }

      .hero-content {
        gap: 14px;
        align-items: flex-start;
      }

      .tool-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        font-size: 1.35rem;
      }

      .hero-content h1 {
        font-size: 1.65rem;
      }

      .hero-content p {
        font-size: .75rem;
      }

      .tool-section {
        padding: 45px 0 65px;
      }

      .tool-card {
        border-radius: 18px;
      }

      .toolbar {
        align-items: flex-start;
        flex-direction: column;
        padding: 14px;
      }

      .toolbar-actions {
        width: 100%;
      }

      .tool-btn {
        flex: 1;
      }

      .controls {
        padding: 17px;
      }

      .preview-stage {
        min-height: 360px;
        padding: 12px;
      }

      .flex-preview {
        min-height: 330px;
        padding: 15px;
      }

      .flex-item {
        min-width: 75px;
        min-height: 55px;
        padding: 10px;
        font-size: .7rem;
      }

      .code-section {
        margin: 0 12px 12px;
      }

      #cssOutput {
        padding: 15px;
        font-size: .7rem;
      }

      .info-card {
        padding: 18px;
      }

      .how-section,
      .faq-section {
        margin-top: 70px;
      }

    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }

      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      /* THEME */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }

        try {
          localStorage.setItem(
            "theme",
            isDark ? "dark" : "light"
          );
        } catch {}

      };

      window.addEventListener(
        "themeChange",
        (event) => {

          const theme = event?.detail;

          if (
            theme === "dark" ||
            theme === "light"
          ) {
            applyTheme(theme === "dark");
          }

        }
      );


      /* ELEMENTS */

      const preview =
        document.getElementById("flexPreview");

      const direction =
        document.getElementById("direction");

      const justify =
        document.getElementById("justify");

      const align =
        document.getElementById("align");

      const wrap =
        document.getElementById("wrap");

      const gap =
        document.getElementById("gap");

      const rowGap =
        document.getElementById("rowGap");

      const columnGap =
        document.getElementById("columnGap");

      const alignContent =
        document.getElementById("alignContent");

      const gapValue =
        document.getElementById("gapValue");

      const rowGapValue =
        document.getElementById("rowGapValue");

      const columnGapValue =
        document.getElementById("columnGapValue");

      const cssOutput =
        document.getElementById("cssOutput");

      const itemCount =
        document.getElementById("itemCount");

      const previewInfo =
        document.getElementById("previewInfo");

      const plusBtn =
        document.getElementById("plusBtn");

      const minusBtn =
        document.getElementById("minusBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const copyCodeBtn =
        document.getElementById("copyCodeBtn");

      const resetBtn =
        document.getElementById("resetBtn");

      const status =
        document.getElementById("status");

      const statusIcon =
        document.getElementById("statusIcon");

      const statusText =
        document.getElementById("statusText");


      let count = 3;


      /* ITEMS */

      const colors = [
        "#3b82f6",
        "#06b6d4",
        "#8b5cf6",
        "#ec4899",
        "#f59e0b",
        "#10b981",
        "#ef4444",
        "#6366f1",
        "#14b8a6",
        "#f97316"
      ];


      const renderItems = () => {

        preview.innerHTML = "";

        for (let i = 0; i < count; i++) {

          const item =
            document.createElement("div");

          item.className = "flex-item";

          item.textContent =
            `Item ${i + 1}`;

          item.style.background =
            colors[i % colors.length];

          preview.appendChild(item);

        }

        itemCount.textContent = count;

        previewInfo.textContent =
          `${count} عناصر`;

      };


      /* CSS */

      const generateCSS = () => {

        const css = `.container {
  display: flex;
  flex-direction: ${direction.value};
  justify-content: ${justify.value};
  align-items: ${align.value};
  align-content: ${alignContent.value};
  flex-wrap: ${wrap.value};
  gap: ${gap.value}px;
  row-gap: ${rowGap.value}px;
  column-gap: ${columnGap.value}px;
}`;

        cssOutput.textContent = css;

      };


      /* UPDATE */

      const update = () => {

        preview.style.flexDirection =
          direction.value;

        preview.style.justifyContent =
          justify.value;

        preview.style.alignItems =
          align.value;

        preview.style.alignContent =
          alignContent.value;

        preview.style.flexWrap =
          wrap.value;

        preview.style.gap =
          `${gap.value}px`;

        preview.style.rowGap =
          `${rowGap.value}px`;

        preview.style.columnGap =
          `${columnGap.value}px`;

        gapValue.textContent =
          `${gap.value}px`;

        rowGapValue.textContent =
          `${rowGap.value}px`;

        columnGapValue.textContent =
          `${columnGap.value}px`;

        generateCSS();

      };


      /* COPY */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove("hidden");

        status.classList.toggle(
          "error",
          isError
        );

        statusIcon.className =
          isError
            ? "fas fa-circle-exclamation"
            : "fas fa-check-circle";

        statusText.textContent =
          message;

      };


      const copyCSS = async () => {

        const code =
          cssOutput.textContent;

        try {

          await navigator.clipboard.writeText(code);

          showStatus(
            "تم نسخ كود CSS بنجاح."
          );

        } catch {

          const range =
            document.createRange();

          range.selectNodeContents(cssOutput);

          const selection =
            window.getSelection();

          selection.removeAllRanges();

          selection.addRange(range);

          document.execCommand("copy");

          selection.removeAllRanges();

          showStatus(
            "تم نسخ كود CSS."
          );

        }

      };


      /* EVENTS */

      [
        direction,
        justify,
        align,
        wrap,
        gap,
        rowGap,
        columnGap,
        alignContent
      ].forEach((element) => {

        element.addEventListener(
          "input",
          update
        );

        element.addEventListener(
          "change",
          update
        );

      });


      plusBtn.addEventListener(
        "click",
        () => {

          if (count < 10) {

            count++;

            renderItems();

            update();

          }

        }
      );


      minusBtn.addEventListener(
        "click",
        () => {

          if (count > 1) {

            count--;

            renderItems();

            update();

          }

        }
      );


      copyBtn.addEventListener(
        "click",
        copyCSS
      );


      copyCodeBtn.addEventListener(
        "click",
        copyCSS
      );


      /* RESET */

      resetBtn.addEventListener(
        "click",
        () => {

          direction.value = "row";
          justify.value = "flex-start";
          align.value = "stretch";
          wrap.value = "nowrap";
          gap.value = 15;
          rowGap.value = 15;
          columnGap.value = 15;
          alignContent.value = "normal";

          count = 3;

          renderItems();

          update();

          showStatus(
            "تمت إعادة ضبط الإعدادات."
          );

        }
      );


      /* INITIAL */

      renderItems();

      update();

    })();
  </script>

</body>
</html>
