---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Base64 Decoder - فك ترميز Base64 أونلاين مجاناً | Th.Tech";

const description =
  "أداة Base64 Decoder مجانية لفك ترميز Base64 إلى نص أصلي بسرعة، مع دعم كامل للعربية وUnicode مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو Base64 Decoder؟",
    a: "Base64 Decoder هي أداة لتحويل بيانات Base64 إلى النص الأصلي بطريقة سريعة ومباشرة من المتصفح."
  },
  {
    q: "هل يدعم فك ترميز النصوص العربية؟",
    a: "نعم. تستخدم الأداة UTF-8 لفك ترميز البيانات، لذلك يمكنها التعامل مع النصوص العربية واللغات المختلفة."
  },
  {
    q: "هل يتم إرسال بيانات Base64 إلى الخادم؟",
    a: "لا. تتم عملية فك الترميز محلياً داخل المتصفح ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "ماذا يحدث إذا كان Base64 غير صالح؟",
    a: "ستظهر رسالة خطأ توضح أن البيانات غير صالحة أو لا يمكن فك ترميزها."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- HERO -->
      <section class="hero">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>

          <span>Base64 Decoder</span>
        </div>

        <div class="hero-badge">
          <i class="fa-solid fa-code"></i>
          Developer Tools
        </div>

        <div class="hero-icon">
          <div class="icon-box">
            <i class="fa-solid fa-lock-open"></i>

            <span class="base64-mark">64</span>
          </div>
        </div>

        <h1>Base64 Decoder</h1>

        <p>
          فك ترميز Base64 وتحويله إلى النص الأصلي بسرعة مع دعم كامل
          للغة العربية وUnicode مباشرة من متصفحك.
        </p>

        <div class="hero-tags">

          <span>
            <i class="fa-solid fa-bolt"></i>
            سريع
          </span>

          <span>
            <i class="fa-solid fa-shield-halved"></i>
            محلي 100%
          </span>

          <span>
            <i class="fa-solid fa-language"></i>
            Unicode
          </span>

        </div>

      </section>

      <!-- TOOL -->
      <section class="tool-section">

        <div class="decoder-card">

          <div class="card-topbar">

            <div class="topbar-title">
              <span class="status-dot"></span>
              Base64 Decoder
            </div>

            <div class="topbar-type">
              <i class="fa-solid fa-lock-open"></i>
              BASE64
            </div>

          </div>

          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="action-btn secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="action-btn danger">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

            <button id="copyBtn" class="action-btn secondary">
              <i class="fa-solid fa-copy"></i>
              نسخ
            </button>

            <button id="decodeBtn" class="action-btn primary">
              <i class="fa-solid fa-unlock"></i>
              فك ترميز Base64
            </button>

          </div>

          <!-- EDITORS -->
          <div class="editors">

            <!-- INPUT -->
            <div class="editor-panel">

              <div class="editor-header">

                <div class="editor-title">

                  <span class="file-icon">
                    <i class="fa-solid fa-lock"></i>
                  </span>

                  <div>
                    <strong>Base64 Input</strong>
                    <small>بيانات Base64</small>
                  </div>

                </div>

                <span class="language-badge">
                  BASE64
                </span>

              </div>

              <div class="editor-wrap">

                <div id="inputLines" class="line-numbers">1</div>

                <textarea
                  id="base64Input"
                  spellcheck="false"
                  placeholder="ألصق نص Base64 هنا..."
                ></textarea>

              </div>

              <div class="editor-footer">

                <span>
                  <i class="fa-solid fa-keyboard"></i>
                  Ctrl + Enter لفك الترميز
                </span>

                <span id="inputStats">
                  0 حرف
                </span>

              </div>

            </div>

            <!-- OUTPUT -->
            <div class="editor-panel output-panel">

              <div class="editor-header">

                <div class="editor-title">

                  <span class="file-icon output-icon">
                    <i class="fa-solid fa-font"></i>
                  </span>

                  <div>
                    <strong>Decoded Text</strong>
                    <small>النص الأصلي</small>
                  </div>

                </div>

                <span id="outputStatus" class="language-badge success">
                  جاهز
                </span>

              </div>

              <div class="editor-wrap">

                <div id="outputLines" class="line-numbers">1</div>

                <textarea
                  id="decodedOutput"
                  readonly
                  spellcheck="false"
                  placeholder="سيظهر النص الأصلي هنا..."
                ></textarea>

              </div>

              <div class="editor-footer">

                <span id="statusText">
                  <i class="fa-solid fa-circle-check"></i>
                  في انتظار Base64
                </span>

                <span id="outputStats">
                  0 حرف
                </span>

              </div>

            </div>

          </div>

          <!-- RESULT -->
          <div id="resultBox" class="result-box hidden">

            <div id="resultIcon" class="result-icon">
              <i class="fa-solid fa-check"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                تم فك الترميز بنجاح
              </strong>

              <p id="resultMessage">
                تم تحويل Base64 إلى النص الأصلي.
              </p>

            </div>

          </div>

          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
