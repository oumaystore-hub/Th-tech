                <span>حروف Base64</span>
              </div>

            </div>

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <strong id="statOutput">0</strong>
                <span>حروف الناتج</span>
              </div>

            </div>

            <div class="stat-card">

              <div class="stat-icon">
