<script is:inline>
  (() => {
    const input = document.getElementById("sqlInput");
    const output = document.getElementById("sqlOutput");

    const minifyBtn = document.getElementById("minifyBtn");
    const clearBtn = document.getElementById("clearBtn");
    const copyBtn = document.getElementById("copyBtn");
    const exampleBtn = document.getElementById("exampleBtn");

    const inputLines = document.getElementById("inputLines");
    const outputLines = document.getElementById("outputLines");

    const inputStats = document.getElementById("inputStats");
    const outputStats = document.getElementById("outputStats");

    const originalSize = document.getElementById("originalSize");
    const minifiedSize = document.getElementById("minifiedSize");
    const savedSize = document.getElementById("savedSize");
    const savedPercent = document.getElementById("savedPercent");

    const progressBar = document.getElementById("progressBar");
    const compressionBadge = document.getElementById("compressionBadge");

    const statusText = document.getElementById("statusText");
    const outputStatus = document.getElementById("outputStatus");

    const exampleSQL = `-- Example SQL Query

SELECT
    users.id,
    users.name,
    users.email,
    users.status
FROM users
WHERE users.status = 'active'
    AND users.email IS NOT NULL
ORDER BY users.created_at DESC
LIMIT 50;`;

    function formatBytes(bytes) {
      if (!bytes || bytes <= 0) return "0 B";

      if (bytes < 1024) {
        return `${bytes} B`;
      }

      if (bytes < 1024 * 1024) {
        return `${(bytes / 1024).toFixed(2)} KB`;
      }

      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    function getBytes(text) {
      return new Blob([text]).size;
    }

    function updateLineNumbers(textarea, container) {
      const lines = Math.max(1, textarea.value.split("\n").length);

      let html = "";

      for (let i = 1; i <= lines; i++) {
        html += `<span>${i}</span>`;
      }

      container.innerHTML = html;
    }

    function updateStats() {
      const inputValue = input.value;
      const outputValue = output.value;

      const inputLineCount = Math.max(1, inputValue.split("\n").length);
      const outputLineCount = Math.max(1, outputValue.split("\n").length);

      inputStats.textContent =
        `${inputLineCount} سطر • ${inputValue.length} حرف`;

      outputStats.textContent =
        `${outputLineCount} سطر • ${outputValue.length} حرف`;

      updateLineNumbers(input, inputLines);
      updateLineNumbers(output, outputLines);
    }

    function setStatus(text, type = "ready") {
      statusText.textContent = text;

      const dot = document.querySelector(".status-dot");

      if (!dot) return;

      dot.classList.remove("success", "error", "processing");

      if (type === "success") {
        dot.classList.add("success");
      } else if (type === "error") {
        dot.classList.add("error");
      } else if (type === "processing") {
        dot.classList.add("processing");
      }
    }

    function minifySQL(sql) {
      let result = "";
      let i = 0;

      let quote = null;
      let pendingSpace = false;

      while (i < sql.length) {
        const char = sql[i];
        const next = sql[i + 1];

        /* داخل النصوص */
        if (quote) {
          result += char;

          if (char === quote) {
            if (next === quote) {
              result += next;
              i += 2;
              continue;
            }

            let backslashes = 0;
            let j = i - 1;

            while (j >= 0 && sql[j] === "\\") {
              backslashes++;
              j--;
            }

            if (backslashes % 2 === 0) {
              quote = null;
            }
          }

          i++;
          continue;
        }

        /* بداية النص */
        if (char === "'" || char === '"' || char === "`") {
          if (pendingSpace && result.length) {
            result += " ";
            pendingSpace = false;
          }

          quote = char;
          result += char;
          i++;
          continue;
        }

        /* تعليق -- */
        if (char === "-" && next === "-") {
          i += 2;

          while (i < sql.length && sql[i] !== "\n") {
            i++;
          }

          pendingSpace = true;
          continue;
        }

        /* تعليق # */
        if (char === "#") {
          i++;

          while (i < sql.length && sql[i] !== "\n") {
            i++;
          }

          pendingSpace = true;
          continue;
        }

        /* تعليق متعدد الأسطر */
        if (char === "/" && next === "*") {
          i += 2;

          while (
            i < sql.length &&
            !(sql[i] === "*" && sql[i + 1] === "/")
          ) {
            i++;
          }

          i += 2;
          pendingSpace = true;
          continue;
        }

        /* المسافات */
        if (/\s/.test(char)) {
          pendingSpace = true;
          i++;
          continue;
        }

        /* إضافة المسافة المطلوبة */
        if (pendingSpace && result.length) {
          const previous = result[result.length - 1];

          const noSpaceBefore =
            /[(),.;]/.test(char) ||
            char === "]";

          const noSpaceAfter =
            previous === "(" ||
            previous === "[";

          const operator =
            /[=<>+\-*/%]/.test(char) ||
            /[=<>+\-*/%]/.test(previous);

          if (!noSpaceBefore && !noSpaceAfter && !operator) {
            result += " ";
          }

          pendingSpace = false;
        }

        result += char;

        i++;
      }

      result = result
        .replace(/\s+/g, " ")
        .replace(/\s*([(),;])\s*/g, "$1")
        .replace(/\s*\.\s*/g, ".")
        .replace(/\s*=\s*/g, "=")
        .replace(/\s*<>\s*/g, "<>")
        .replace(/\s*<=\s*/g, "<=")
        .replace(/\s*>=\s*/g, ">=")
        .replace(/\s*<\s*/g, "<")
        .replace(/\s*>\s*/g, ">")
        .replace(/\s+\(/g, "(")
        .replace(/\(\s+/g, "(")
        .replace(/\s+\)/g, ")")
        .replace(/\s+/g, " ")
        .trim();

      return result;
    }

    function resetResult() {
      originalSize.textContent = "0 B";
      minifiedSize.textContent = "0 B";
      savedSize.textContent = "0 B";
      savedPercent.textContent = "0%";

      progressBar.style.width = "0%";

      compressionBadge.textContent = "لم يتم التصغير بعد";

      outputStatus.innerHTML =
        `<i class="fa-solid fa-circle-check"></i> جاهز`;

      setStatus("جاهز", "ready");

      updateStats();
    }

    function minify() {
      const sql = input.value.trim();

      if (!sql) {
        output.value = "";

        compressionBadge.textContent = "أدخل SQL أولاً";
        setStatus("لا يوجد كود", "error");

        outputStatus.innerHTML =
          `<i class="fa-solid fa-circle-exclamation"></i> لا يوجد كود`;

        resetResult();
        return;
      }

      setStatus("جارٍ التصغير...", "processing");

      const result = minifySQL(sql);

      output.value = result;

      const original = getBytes(sql);
      const minified = getBytes(result);

      const saved = Math.max(0, original - minified);

      const percent =
        original > 0
          ? Math.max(
              0,
              Math.round((saved / original) * 100)
            )
          : 0;

      originalSize.textContent = formatBytes(original);
      minifiedSize.textContent = formatBytes(minified);
      savedSize.textContent = formatBytes(saved);
      savedPercent.textContent = `${percent}%`;

      progressBar.style.width = `${Math.min(100, percent)}%`;

      compressionBadge.textContent =
        `${percent}% أصغر`;

      outputStatus.innerHTML =
        `<i class="fa-solid fa-circle-check"></i> تم التصغير`;

      setStatus("تم بنجاح", "success");

      updateStats();
    }

    function clearAll() {
      input.value = "";
      output.value = "";

      resetResult();

      compressionBadge.textContent = "لم يتم التصغير بعد";

      setStatus("تم المسح", "ready");

      input.focus();
    }

    async function copyOutput() {
      if (!output.value) {
        setStatus("لا توجد نتيجة", "error");
        return;
      }

      try {
        await navigator.clipboard.writeText(output.value);

        const oldHTML = copyBtn.innerHTML;

        copyBtn.innerHTML =
          `<i class="fa-solid fa-check"></i> تم النسخ`;

        setStatus("تم النسخ", "success");

        setTimeout(() => {
          copyBtn.innerHTML = oldHTML;
          setStatus("جاهز", "ready");
        }, 1500);

      } catch {
        output.select();
        document.execCommand("copy");

        setStatus("تم النسخ", "success");
      }
    }

    function loadExample() {
      input.value = exampleSQL;

      output.value = "";

      resetResult();

      setStatus("تم تحميل المثال", "ready");

      updateStats();

      input.focus();
    }

    input.addEventListener("input", updateStats);

    output.addEventListener("input", updateStats);

    input.addEventListener("scroll", () => {
      inputLines.scrollTop = input.scrollTop;
    });

    output.addEventListener("scroll", () => {
      outputLines.scrollTop = output.scrollTop;
    });

    minifyBtn.addEventListener("click", minify);
    clearBtn.addEventListener("click", clearAll);
    copyBtn.addEventListener("click", copyOutput);
    exampleBtn.addEventListener("click", loadExample);

    input.addEventListener("keydown", (event) => {
      if (event.ctrlKey && event.key === "Enter") {
        event.preventDefault();
        minify();
      }

      if (event.key === "Tab") {
        event.preventDefault();

        const start = input.selectionStart;
        const end = input.selectionEnd;

        input.value =
          input.value.substring(0, start) +
          "  " +
          input.value.substring(end);

        input.selectionStart = input.selectionEnd = start + 2;

        updateStats();
      }
    });

    updateStats();
  })();
</script>

