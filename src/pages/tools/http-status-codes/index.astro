---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/http-status-codes/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>HTTP Status Codes | أكواد حالة HTTP | Th.Tech</title>

  <meta
    name="description"
    content="أداة HTTP Status Codes لعرض وفهم أكواد حالة HTTP مثل 200 و404 و500 مع شرح معنى كل كود واستخدامه."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="status-page">

    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-server"></i>
        أداة HTTP
      </div>

      <h1>
        أكواد حالة <span>HTTP</span>
      </h1>

      <p>
        ابحث عن أكواد HTTP بسرعة واعرف معنى كل كود،
        فئته، واستخدامه في تطوير الويب وواجهات API.
      </p>

      <div class="hero-points">

        <span>
          <i class="fa-solid fa-magnifying-glass"></i>
          بحث سريع
        </span>

        <span>
          <i class="fa-solid fa-layer-group"></i>
          جميع الفئات
        </span>

        <span>
          <i class="fa-solid fa-mobile-screen"></i>
          يعمل على الهاتف
        </span>

      </div>

    </section>


    <section class="tool">

      <div class="tool-top">

        <div>

          <div class="mini-label">
            <i class="fa-solid fa-code"></i>
            HTTP Status Codes
          </div>

          <h2>ابحث عن كود HTTP</h2>

          <p>
            أدخل رقم الكود أو ابحث باسمه أو معناه.
          </p>

        </div>

        <div class="status" id="status">
          <span></span>
          جاهز
        </div>

      </div>


      <div class="search-area">

        <label for="codeInput">
          كود HTTP
        </label>

        <div class="search-box">

          <input
            id="codeInput"
            type="text"
            inputmode="numeric"
            placeholder="مثال: 404 أو Not Found"
            autocomplete="off"
          />

          <button
            id="searchBtn"
            type="button"
          >
            <i class="fa-solid fa-magnifying-glass"></i>
            بحث
          </button>

        </div>

        <div class="quick-codes">

          <button type="button" data-code="200">200</button>
          <button type="button" data-code="201">201</button>
          <button type="button" data-code="301">301</button>
          <button type="button" data-code="400">400</button>
          <button type="button" data-code="401">401</button>
          <button type="button" data-code="403">403</button>
          <button type="button" data-code="404">404</button>
          <button type="button" data-code="500">500</button>

        </div>

      </div>


      <div class="categories">

        <button class="category active" data-category="all">
          <i class="fa-solid fa-border-all"></i>
          الكل
        </button>

        <button class="category" data-category="1xx">
          <i class="fa-solid fa-circle-info"></i>
          1xx
        </button>

        <button class="category" data-category="2xx">
          <i class="fa-solid fa-circle-check"></i>
          2xx
        </button>

        <button class="category" data-category="3xx">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
          3xx
        </button>

        <button class="category" data-category="4xx">
          <i class="fa-solid fa-triangle-exclamation"></i>
          4xx
        </button>

        <button class="category" data-category="5xx">
          <i class="fa-solid fa-circle-xmark"></i>
          5xx
        </button>

      </div>


      <div class="results-area">

        <div class="results-head">

          <div>

            <h3>
              النتائج
            </h3>

            <p id="resultsCount">
              جميع أكواد HTTP
            </p>

          </div>

          <button
            id="clearBtn"
            type="button"
            class="clear-btn"
          >
            <i class="fa-solid fa-rotate-left"></i>
            إعادة ضبط
          </button>

        </div>

        <div
          id="results"
          class="codes-grid"
        ></div>

      </div>

    </section>


    <section class="features">

      <div class="feature">

        <div>
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>

        <section>

          <strong>بحث سريع</strong>

          <span>
            ابحث برقم الكود أو اسمه.
          </span>

        </section>

      </div>


      <div class="feature">

        <div>
          <i class="fa-solid fa-book"></i>
        </div>

        <section>

          <strong>شرح واضح</strong>

          <span>
            معنى واستخدام كل كود.
          </span>

        </section>

      </div>


      <div class="feature">

        <div>
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <section>

          <strong>خصوصية كاملة</strong>

          <span>
            المعالجة تتم داخل المتصفح.
          </span>

        </section>

      </div>

    </section>


    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-circle-info"></i>
      </div>

      <div>

        <h2>ما هي أكواد HTTP؟</h2>

        <p>
          أكواد حالة HTTP هي أرقام يرسلها خادم الويب
          لإخبار العميل بنتيجة الطلب. وتنقسم عادةً إلى
          خمس فئات تبدأ من 1xx إلى 5xx.
        </p>

      </div>

    </section>


    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-body">

        <h2>فئات أكواد HTTP</h2>

        <div class="steps">

          <div class="step">
            <span>1</span>
            <div>
              <strong>1xx — معلومات</strong>
              <p>استجابات معلوماتية مرتبطة بمعالجة الطلب.</p>
            </div>
          </div>

          <div class="step">
            <span>2</span>
            <div>
              <strong>2xx — نجاح</strong>
              <p>تشير إلى نجاح معالجة الطلب.</p>
            </div>
          </div>

          <div class="step">
            <span>3</span>
            <div>
              <strong>3xx — إعادة توجيه</strong>
              <p>تشير إلى الحاجة إلى إجراء إضافي أو إعادة توجيه.</p>
            </div>
          </div>

          <div class="step">
            <span>4</span>
            <div>
              <strong>4xx — خطأ العميل</strong>
              <p>ترتبط عادةً بمشكلة في الطلب المرسل من العميل.</p>
            </div>
          </div>

          <div class="step">
            <span>5</span>
            <div>
              <strong>5xx — خطأ الخادم</strong>
              <p>تشير إلى مشكلة أثناء معالجة الطلب على الخادم.</p>
            </div>
          </div>

        </div>

      </div>

    </section>


    <section class="tip">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>

        <strong>نصيحة للمطورين</strong>

        <p>
          عند اختبار API أو موقع ويب، يساعدك كود الحالة
          على تحديد ما إذا كان الطلب نجح أو تمت إعادة توجيهه
          أو حدث خطأ في العميل أو الخادم.
        </p>

      </div>

    </section>


    <section class="faq">

      <div class="faq-title">

        <span>دليل الأداة</span>

        <h2>الأسئلة الشائعة</h2>

      </div>


      <details>

        <summary>
          ماذا يعني HTTP 200؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          يشير HTTP 200 إلى أن الطلب تمت معالجته بنجاح.
        </p>

      </details>


      <details>

        <summary>
          ماذا يعني HTTP 404؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          يشير 404 عادةً إلى أن المورد المطلوب غير موجود
          على الخادم.
        </p>

      </details>


      <details>

        <summary>
          ما الفرق بين 4xx و5xx؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          أكواد 4xx ترتبط عادةً بمشكلات في الطلب أو العميل،
          بينما أكواد 5xx تشير إلى أخطاء أثناء معالجة الطلب
          على الخادم.
        </p>

      </details>


      <details>

        <summary>
          هل الأداة تحتاج إلى اتصال بالخادم؟
          <i class="fa-solid fa-plus"></i>
        </summary>

        <p>
          لا. قاعدة البيانات الموجودة داخل الأداة يتم التعامل
          معها محليًا داخل المتصفح.
        </p>

      </details>

    </section>

  





<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/api-request-builder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Api Request Builder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/barcode-generator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Barcode Generator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Base64 Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Base64 Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-diff/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Diff</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  /* الوضع الفاتح */
  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    color: #0f172a;
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card strong {
    color: #0f172a;
  }

  [data-theme="light"] .related-tool-card small {
    color: #64748b;
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }

  [data-theme="light"] .related-tool-icon {
    background: rgba(14, 165, 233, 0.12);
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

  <Footer />


  <script is:inline>
    (() => {

      function init() {

        const input =
          document.getElementById('codeInput');

        const searchBtn =
          document.getElementById('searchBtn');

        const clearBtn =
          document.getElementById('clearBtn');

        const results =
          document.getElementById('results');

        const resultsCount =
          document.getElementById('resultsCount');

        const status =
          document.getElementById('status');

        const categories =
          document.querySelectorAll('.category');

        const quickCodes =
          document.querySelectorAll('[data-code]');


        let currentCategory = 'all';


        const codes = [

          [100,'Continue','استمر','معلومات','يتم استخدامه لإخبار العميل أن الجزء الأول من الطلب تم استلامه ويمكن متابعة الطلب.'],

          [101,'Switching Protocols','تبديل البروتوكولات','معلومات','يشير إلى أن الخادم يوافق على تغيير البروتوكول.'],

          [200,'OK','نجاح الطلب','نجاح','تمت معالجة الطلب بنجاح.'],

          [201,'Created','تم الإنشاء','نجاح','تم إنشاء مورد جديد نتيجة للطلب.'],

          [202,'Accepted','تم القبول','نجاح','تم قبول الطلب للمعالجة لكنه لم يكتمل بعد.'],

          [204,'No Content','بدون محتوى','نجاح','تمت معالجة الطلب بنجاح ولا توجد بيانات لإرجاعها.'],

          [206,'Partial Content','محتوى جزئي','نجاح','تم إرسال جزء من المورد المطلوب.'],

          [301,'Moved Permanently','نقل دائم','إعادة توجيه','تم نقل المورد بشكل دائم إلى عنوان آخر.'],

          [302,'Found','تم العثور عليه','إعادة توجيه','يشير إلى إعادة توجيه مؤقتة للمورد.'],

          [303,'See Other','انظر إلى مورد آخر','إعادة توجيه','يطلب من العميل الوصول إلى مورد آخر.'],

          [304,'Not Modified','لم يتغير','إعادة توجيه','لم يتغير المورد منذ آخر طلب ويمكن استخدام النسخة المخزنة.'],

          [307,'Temporary Redirect','إعادة توجيه مؤقتة','إعادة توجيه','إعادة توجيه مؤقتة مع الحفاظ على طريقة الطلب.'],

          [308,'Permanent Redirect','إعادة توجيه دائم','إعادة توجيه','إعادة توجيه دائم مع الحفاظ على طريقة الطلب.'],

          [400,'Bad Request','طلب غير صالح','خطأ العميل','الخادم لم يتمكن من فهم الطلب بسبب صياغة غير صحيحة.'],

          [401,'Unauthorized','غير مصرح','خطأ العميل','يتطلب الطلب مصادقة صالحة.'],

          [402,'Payment Required','الدفع مطلوب','خطأ العميل','رمز محجوز للاستخدامات المستقبلية المرتبطة بالدفع.'],

          [403,'Forbidden','ممنوع','خطأ العميل','الخادم فهم الطلب لكنه يرفض تنفيذه.'],

          [404,'Not Found','غير موجود','خطأ العميل','المورد المطلوب غير موجود.'],

          [405,'Method Not Allowed','الطريقة غير مسموحة','خطأ العميل','طريقة HTTP المستخدمة غير مسموحة للمورد.'],

          [406,'Not Acceptable','غير مقبول','خطأ العميل','لا يستطيع الخادم إنتاج استجابة مقبولة وفق ترويسات الطلب.'],

          [408,'Request Timeout','انتهت مهلة الطلب','خطأ العميل','انتظر الخادم الطلب لفترة أطول من المسموح.'],

          [409,'Conflict','تعارض','خطأ العميل','حدث تعارض أثناء معالجة الطلب.'],

          [410,'Gone','تمت إزالته','خطأ العميل','المورد لم يعد متاحًا بشكل دائم.'],

          [413,'Content Too Large','المحتوى كبير جدًا','خطأ العميل','حجم محتوى الطلب أكبر من الحد المسموح.'],

          [415,'Unsupported Media Type','نوع الوسائط غير مدعوم','خطأ العميل','نوع البيانات المرسل غير مدعوم.'],

          [422,'Unprocessable Content','تعذر معالجة المحتوى','خطأ العميل','صياغة الطلب صحيحة لكن لا يمكن معالجة محتواه.'],

          [429,'Too Many Requests','طلبات كثيرة جدًا','خطأ العميل','تم إرسال عدد كبير من الطلبات خلال فترة زمنية قصيرة.'],

          [500,'Internal Server Error','خطأ داخلي في الخادم','خطأ الخادم','حدث خطأ عام أثناء معالجة الطلب على الخادم.'],

          [501,'Not Implemented','غير مطبق','خطأ الخادم','الخادم لا يدعم الوظيفة المطلوبة.'],

          [502,'Bad Gateway','بوابة غير صالحة','خطأ الخادم','تلقى الخادم الوسيط استجابة غير صالحة من خادم آخر.'],

          [503,'Service Unavailable','الخدمة غير متاحة','خطأ الخادم','الخادم غير قادر حاليًا على معالجة الطلب.'],

          [504,'Gateway Timeout','انتهت مهلة البوابة','خطأ الخادم','لم يحصل الخادم الوسيط على استجابة في الوقت المناسب.'],

          [505,'HTTP Version Not Supported','إصدار HTTP غير مدعوم','خطأ الخادم','إصدار HTTP المستخدم في الطلب غير مدعوم.']

        ];


        function setStatus(text, working = false) {

          status.innerHTML =
            '<span></span>' + text;

          status.classList.toggle(
            'working',
            working
          );

        }


        function categoryOf(code) {

          return Math.floor(code / 100) + 'xx';

        }


        function render(list) {

          results.innerHTML = '';

          if (!list.length) {

            results.innerHTML = `
              <div class="empty-result">
                <i class="fa-solid fa-magnifying-glass"></i>
                <strong>لم يتم العثور على نتيجة</strong>
                <span>جرّب كودًا آخر أو كلمة بحث مختلفة.</span>
              </div>
            `;

            resultsCount.textContent =
              'لا توجد نتائج';

            return;
          }


          resultsCount.textContent =
            `${list.length} كود`;


          list.forEach(item => {

            const card =
              document.createElement('article');

            const code = item[0];

            card.className =
              `code-card code-${Math.floor(code / 100)}`;

            card.innerHTML = `
              <div class="code-number">${code}</div>

              <div class="code-content">
                <h3>${escapeHTML(item[1])}</h3>
                <strong>${escapeHTML(item[2])}</strong>
                <span>${escapeHTML(item[3])}</span>
                <p>${escapeHTML(item[4])}</p>
              </div>
            `;

            results.appendChild(card);

          });

        }


        function search() {

          const query =
            input.value.trim().toLowerCase();


          setStatus(
            'جارٍ البحث...',
            true
          );


          setTimeout(() => {

            let list =
              codes.filter(item => {

                const matchesCategory =
                  currentCategory === 'all' ||
                  categoryOf(item[0]) === currentCategory;

                const searchable =
                  `${item[0]} ${item[1]} ${item[2]} ${item[3]} ${item[4]}`
                    .toLowerCase();

                const matchesSearch =
                  !query ||
                  searchable.includes(query);

                return (
                  matchesCategory &&
                  matchesSearch
                );

              });


            render(list);

            setStatus(
              'جاهز',
              false
            );

          }, 100);

        }


        categories.forEach(button => {

          button.addEventListener(
            'click',
            () => {

              categories.forEach(
                item =>
                  item.classList.remove('active')
              );

              button.classList.add('active');

              currentCategory =
                button.dataset.category;

              search();

            }
          );

        });


        quickCodes.forEach(button => {

          button.addEventListener(
            'click',
            () => {

              input.value =
                button.dataset.code;

              search();

              input.focus();

            }
          );

        });


        searchBtn.addEventListener(
          'click',
          search
        );


        input.addEventListener(
          'keydown',
          event => {

            if (event.key === 'Enter') {

              event.preventDefault();

              search();

            }

          }
        );


        clearBtn.addEventListener(
          'click',
          () => {

            input.value = '';

            currentCategory = 'all';

            categories.forEach(
              item =>
                item.classList.toggle(
                  'active',
                  item.dataset.category === 'all'
                )
            );

            render(codes);

            setStatus(
              'جاهز',
              false
            );

            input.focus();

          }
        );


        function escapeHTML(value) {

          return value
            .replace(/&/g,'&amp;')
            .replace(/</g,'&lt;')
            .replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;')
            .replace(/'/g,'&#039;');

        }


        function getThemeState() {

          const html =
            document.documentElement;

          const stored =
            localStorage.getItem('theme');


          if (stored === 'light') {
            return 'light';
          }

          if (stored === 'dark') {
            return 'dark';
          }

          if (html.dataset.theme === 'light') {
            return 'light';
          }

          if (html.dataset.theme === 'dark') {
            return 'dark';
          }

          if (html.classList.contains('light')) {
            return 'light';
          }

          if (html.classList.contains('dark')) {
            return 'dark';
          }

          return 'dark';

        }


        function syncTheme() {

          const light =
            getThemeState() === 'light';


          document.body.classList.toggle(
            'status-light',
            light
          );


          document.body.classList.toggle(
            'status-dark',
            !light
          );

        }


        syncTheme();


        window.addEventListener(
          'storage',
          event => {

            if (event.key === 'theme') {
              syncTheme();
            }

          }
        );


        const themeObserver =
          new MutationObserver(() => {
            syncTheme();
          });


        themeObserver.observe(
          document.documentElement,
          {
            attributes: true,
            attributeFilter: [
              'class',
              'data-theme'
            ]
          }
        );


        render(codes);

        setStatus('جاهز', false);

      }


      if (document.readyState === 'loading') {

        document.addEventListener(
          'DOMContentLoaded',
          init,
          { once: true }
        );

      } else {

        init();

      }

    })();
  </script>


