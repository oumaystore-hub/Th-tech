---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Text Cleaner - تنظيف النصوص أونلاين مجاناً | Th.Tech';

const description =
  'أداة Text Cleaner مجانية لتنظيف النصوص وإزالة المسافات الزائدة والأسطر الفارغة وتنسيق النص بسرعة من المتصفح.';

const canonical =
  'https://oumaystore-hub.github.io' + base + '/tools/text-cleaner/';

const faqs = [
  [
    'ما هي أداة Text Cleaner؟',
    'أداة مجانية لتنظيف النصوص وإزالة المسافات والفراغات والأسطر غير الضرورية للحصول على نص مرتب.'
  ],
  [
    'هل يتم إرسال النص إلى الخادم؟',
    'لا. تتم معالجة النص بالكامل داخل المتصفح ولا يتم إرساله إلى خادم خارجي.'
  ],
  [
    'هل يمكن إزالة الأسطر الفارغة؟',
    'نعم، يمكنك إزالة جميع الأسطر الفارغة بنقرة واحدة.'
  ],
  [
    'هل يمكن إزالة المسافات الزائدة؟',
    'نعم. تقوم الأداة بإزالة المسافات المتكررة بين الكلمات وتنظيف بداية ونهاية الأسطر.'
  ],
  [
    'هل الأداة مجانية؟',
    'نعم، Text Cleaner مجانية ويمكن استخدامها مباشرة دون تسجيل.'
  ]
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07111f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');

          if (saved === 'dark') {
            document.documentElement.classList.add('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="tool-page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container hero-content">

          <div class="breadcrumb">
            <a href={base + '/'}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={base + '/tools/'}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Text Cleaner</span>
          </div>

          <div class="tool-icon">
            <i class="fa-solid fa-broom"></i>
          </div>

          <div class="hero-badge">
            <span class="badge-dot"></span>
            أداة مجانية
          </div>

          <h1>Text Cleaner</h1>

          <p>
            نظّف النصوص ورتّبها بسرعة بإزالة المسافات الزائدة والأسطر
            الفارغة والفراغات غير الضرورية.
          </p>

          <div class="hero-tags">
            <span>
              <i class="fa-solid fa-broom"></i>
              Clean
            </span>

            <span>
              <i class="fa-solid fa-eraser"></i>
              Remove Spaces
            </span>

            <span>
              <i class="fa-solid fa-align-left"></i>
              Format
            </span>

            <span>
              <i class="fa-solid fa-lock"></i>
              Local
            </span>
          </div>

        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">

          <div class="cleaner-card">

            <div class="card-top">

              <div>
                <span class="eyebrow">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  منظف النصوص
                </span>

                <h2>تنظيف النص</h2>

                <p>
                  اختر خيارات التنظيف ثم طبّقها على النص مباشرة.
                </p>
              </div>

              <div class="local-status">
                <span class="status-dot"></span>
                يعمل محلياً
              </div>

            </div>

            <!-- OPTIONS -->
            <div class="options">

              <label class="option active">
                <input
                  type="checkbox"
                  id="trimLines"
                  checked
                />

                <span class="check-box">
                  <i class="fa-solid fa-check"></i>
                </span>

                <span class="option-content">
                  <strong>تنظيف بداية ونهاية الأسطر</strong>
                  <small>إزالة المسافات غير الضرورية</small>
                </span>
              </label>

              <label class="option active">
                <input
                  type="checkbox"
                  id="multipleSpaces"
                  checked
                />

                <span class="check-box">
                  <i class="fa-solid fa-check"></i>
                </span>

                <span class="option-content">
                  <strong>إزالة المسافات المتكررة</strong>
                  <small>تحويل عدة مسافات إلى مسافة واحدة</small>
                </span>
              </label>

              <label class="option active">
                <input
                  type="checkbox"
                  id="emptyLines"
                  checked
                />

                <span class="check-box">
                  <i class="fa-solid fa-check"></i>
                </span>

                <span class="option-content">
                  <strong>إزالة الأسطر الفارغة</strong>
                  <small>تنظيف الفراغات بين الأسطر</small>
                </span>
              </label>

              <label class="option active">
                <input
                  type="checkbox"
                  id="normalizeLines"
                  checked
                />

                <span class="check-box">
                  <i class="fa-solid fa-check"></i>
                </span>

                <span class="option-content">
                  <strong>توحيد فواصل الأسطر</strong>
                  <small>تنسيق الأسطر بشكل موحد</small>
                </span>
              </label>

            </div>

            <!-- ACTIONS -->
            <div class="actions">

              <button
                class="action-btn primary"
                id="cleanBtn"
                type="button"
              >
                <i class="fa-solid fa-broom"></i>
                <span>تنظيف النص</span>
              </button>

              <button
                class="action-btn"
                id="copyBtn"
                type="button"
              >
                <i class="fa-regular fa-copy"></i>
                <span>نسخ النتيجة</span>
              </button>

              <button
                class="action-btn"
                id="sampleBtn"
                type="button"
              >
                <i class="fa-solid fa-flask"></i>
                <span>مثال</span>
              </button>

              <button
                class="action-btn danger"
                id="clearBtn"
                type="button"
              >
                <i class="fa-solid fa-trash-can"></i>
                <span>مسح</span>
              </button>

            </div>

            <!-- EDITORS -->
            <div class="editors">

              <!-- INPUT -->
              <div class="editor-box">

                <div class="editor-head">

                  <div class="editor-title">
                    <span class="editor-number">01</span>

                    <div>
                      <strong>النص الأصلي</strong>
                      <small>INPUT</small>
                    </div>
                  </div>

                  <span class="editor-label">
                    <i class="fa-solid fa-pen"></i>
                    قابل للتعديل
                  </span>

                </div>

                <textarea
                  id="inputText"
                  dir="auto"
                  spellcheck="false"
                  placeholder="اكتب أو الصق النص الذي تريد تنظيفه هنا..."
                ></textarea>

                <div class="editor-footer">

                  <span id="inputStatus">
                    <i class="fa-solid fa-circle-info"></i>
                    أدخل النص
                  </span>

                  <span>
                    <b id="inputChars">0</b>
                    حرف
                  </span>

                </div>

              </div>

              <!-- ARROW -->
              <div class="direction-arrow">
                <i class="fa-solid fa-arrow-left"></i>
              </div>

              <!-- OUTPUT -->
              <div class="editor-box output-box">

                <div class="editor-head">

                  <div class="editor-title">
                    <span class="editor-number output-number">02</span>

                    <div>
                      <strong>النص النظيف</strong>
                      <small>OUTPUT</small>
                    </div>
                  </div>

                  <button
                    class="small-btn"
                    id="copySmallBtn"
                    type="button"
                  >
                    <i class="fa-regular fa-copy"></i>
                    نسخ
                  </button>

                </div>

                <textarea
                  id="outputText"
                  dir="auto"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر النتيجة هنا..."
                ></textarea>

                <div class="editor-footer">

                  <span id="resultStatus">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    جاهز
                  </span>

                  <span>
                    <b id="outputChars">0</b>
                    حرف
                  </span>

                </div>

              </div>

            </div>

            <!-- STATUS -->
            <div class="live-status" id="liveStatus">

              <div class="status-icon">
                <i class="fa-solid fa-broom"></i>
              </div>

              <div>
                <strong>جاهز للتنظيف</strong>
                <span>
                  أدخل النص واختر خيارات التنظيف المناسبة.
                </span>
              </div>

            </div>

            <!-- STATS -->
            <div class="stats-grid">

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-font"></i>
                </div>

                <div>
                  <span>الأحرف الأصلية</span>
                  <strong id="originalChars">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-broom"></i>
                </div>

                <div>
                  <span>الأحرف بعد التنظيف</span>
                  <strong id="cleanChars">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-scissors"></i>
                </div>

                <div>
                  <span>تمت إزالتها</span>
                  <strong id="removedChars">0</strong>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon">
                  <i class="fa-solid fa-percent"></i>
                </div>

                <div>
                  <span>نسبة التنظيف</span>
                  <strong id="cleanPercent">0%</strong>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- PRIVACY -->
      <section class="privacy-section">
        <div class="container">

          <div class="privacy-card">

            <div class="privacy-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
              <h3>النص يبقى على جهازك</h3>

              <p>
                تتم جميع عمليات تنظيف النص داخل المتصفح مباشرة،
                ولا يتم رفع المحتوى إلى أي خادم.
              </p>
            </div>

            <div class="privacy-checks">

              <span>
                <i class="fa-solid fa-check"></i>
                معالجة محلية
              </span>

              <span>
                <i class="fa-solid fa-check"></i>
                بدون تسجيل
              </span>

              <span>
                <i class="fa-solid fa-check"></i>
                مجانية
              </span>

            </div>

          </div>

        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">

          <div class="section-heading">

            <span class="section-kicker">
              TEXT CLEANING
            </span>

            <h2>تنظيف النصوص بسهولة</h2>

            <p>
              تخلص من المشاكل الشائعة في النصوص المنسوخة أو المولدة
              أو المستخرجة من مصادر مختلفة.
            </p>

          </div>

          <div class="info-grid">

            <article class="info-card">

              <div class="info-card-icon">
                <i class="fa-solid fa-arrows-left-right"></i>
              </div>

              <h3>المسافات الزائدة</h3>

              <p>
                إزالة المسافات المتكررة بين الكلمات للحصول على نص مرتب.
              </p>

              <code>Hello     World → Hello World</code>

            </article>

            <article class="info-card">

              <div class="info-card-icon">
                <i class="fa-solid fa-minus"></i>
              </div>

              <h3>الأسطر الفارغة</h3>

              <p>
                إزالة الأسطر الفارغة غير الضرورية من النص.
              </p>

              <code>Line 1\n\nLine 2 → Line 1\nLine 2</code>

            </article>

            <article class="info-card">

              <div class="info-card-icon">
                <i class="fa-solid fa-align-left"></i>
              </div>

              <h3>تنظيف الأسطر</h3>

              <p>
                حذف الفراغات الموجودة في بداية ونهاية كل سطر.
              </p>

              <code>  Hello World  → Hello World</code>

            </article>

            <article class="info-card">

              <div class="info-card-icon">
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <h3>توحيد النص</h3>

              <p>
                توحيد فواصل الأسطر للحصول على محتوى أكثر تنظيماً.
              </p>

              <code>CRLF / CR / LF → LF</code>

            </article>

          </div>

        </div>
      </section>

      <!-- STEPS -->
      <section class="steps-section">
        <div class="container">

          <div class="section-heading">

            <span class="section-kicker">
              HOW IT WORKS
            </span>

            <h2>كيفية استخدام Text Cleaner؟</h2>

            <p>
              نظّف النص خلال ثوانٍ قليلة.
            </p>

          </div>

          <div class="steps-grid">

            <div class="step-card">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fa-solid fa-paste"></i>
              </div>

              <h3>الصق النص</h3>

              <p>
                اكتب النص أو الصقه في مربع الإدخال.
              </p>

            </div>

            <div class="step-card">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fa-solid fa-sliders"></i>
              </div>

              <h3>اختر الخيارات</h3>

              <p>
                فعّل أو عطّل خيارات التنظيف التي تحتاجها.
              </p>

            </div>

            <div class="step-card">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fa-solid fa-check"></i>
              </div>

              <h3>انسخ النتيجة</h3>

              <p>
                طبّق التنظيف ثم انسخ النص الناتج مباشرة.
              </p>

            </div>

          </div>

        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-heading">

            <span class="section-kicker">
              FAQ
            </span>

            <h2>الأسئلة الشائعة</h2>

            <p>
              كل ما تحتاج معرفته عن تنظيف النصوص.
            </p>

          </div>

          <div class="faq-list">

            {
              faqs.map((faq, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary>
                    <span>{faq[0]}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <div class="faq-answer">
                    <p>{faq[1]}</p>
                  </div>
                </details>
              ))
            }

          </div>

        </div>
      </section>

    </main>

    <Footer />

    <script is:inline>
      (() => {
        const input = document.getElementById('inputText');
        const output = document.getElementById('outputText');

        const cleanBtn = document.getElementById('cleanBtn');
        const copyBtn = document.getElementById('copyBtn');
        const copySmallBtn = document.getElementById('copySmallBtn');
        const sampleBtn = document.getElementById('sampleBtn');
        const clearBtn = document.getElementById('clearBtn');

        const trimLines = document.getElementById('trimLines');
        const multipleSpaces = document.getElementById('multipleSpaces');
        const emptyLines = document.getElementById('emptyLines');
        const normalizeLines = document.getElementById('normalizeLines');

        const inputChars = document.getElementById('inputChars');
        const outputChars = document.getElementById('outputChars');

        const originalChars = document.getElementById('originalChars');
        const cleanChars = document.getElementById('cleanChars');
        const removedChars = document.getElementById('removedChars');
        const cleanPercent = document.getElementById('cleanPercent');

        const inputStatus = document.getElementById('inputStatus');
        const resultStatus = document.getElementById('resultStatus');
        const liveStatus = document.getElementById('liveStatus');

        const optionInputs = document.querySelectorAll(
          '.option input[type="checkbox"]'
        );

        function updateOptionVisuals() {
          optionInputs.forEach(function(checkbox) {
            const option = checkbox.closest('.option');

            if (!option) {
              return;
            }

            if (checkbox.checked) {
              option.classList.add('active');
            } else {
              option.classList.remove('active');
            }
          });
        }

        function updateStats() {
          const original = input.value || '';
          const cleaned = output.value || '';

          const originalLength = original.length;
          const cleanedLength = cleaned.length;
          const removed = Math.max(
            originalLength - cleanedLength,
            0
          );

          let percentage = 0;

          if (originalLength > 0) {
            percentage = Math.round(
              (removed / originalLength) * 100
            );
          }

          inputChars.textContent = String(originalLength);
          outputChars.textContent = String(cleanedLength);

          originalChars.textContent = String(originalLength);
          cleanChars.textContent = String(cleanedLength);
          removedChars.textContent = String(removed);
          cleanPercent.textContent = String(percentage) + '%';
        }

        function setStatus(titleText, messageText, type) {
          const strong = liveStatus.querySelector('strong');
          const span = liveStatus.querySelector('span');
          const icon = liveStatus.querySelector('.status-icon i');

          strong.textContent = titleText;
          span.textContent = messageText;

          liveStatus.classList.remove(
            'success-status',
            'warning-status',
            'error-status'
          );

          if (type === 'success') {
            liveStatus.classList.add('success-status');
            icon.className = 'fa-solid fa-check';
          } else if (type === 'warning') {
            liveStatus.classList.add('warning-status');
            icon.className = 'fa-solid fa-circle-exclamation';
          } else if (type === 'error') {
            liveStatus.classList.add('error-status');
            icon.className = 'fa-solid fa-xmark';
          } else {
            icon.className = 'fa-solid fa-broom';
          }
        }

        function cleanText(text) {
          let result = text;

          if (normalizeLines.checked) {
            result = result.replace(/\r\n/g, '\n');
            result = result.replace(/\r/g, '\n');
          }

          if (trimLines.checked) {
            const lines = result.split('\n');

            for (let i = 0; i < lines.length; i++) {
              lines[i] = lines[i].trim();
            }

            result = lines.join('\n');
          }

          if (multipleSpaces.checked) {
            const lines = result.split('\n');

            for (let i = 0; i < lines.length; i++) {
              lines[i] = lines[i].replace(/[ \t]+/g, ' ');
            }

            result = lines.join('\n');
          }

          if (emptyLines.checked) {
            const lines = result.split('\n');

            result = lines
              .filter(function(line) {
                return line.trim() !== '';
              })
              .join('\n');
          }

          return result.trim();
        }

        function clean() {
          const text = input.value || '';

          if (!text.trim()) {
            output.value = '';

            setStatus(
              'لا يوجد نص',
              'أدخل نصاً أولاً ثم اضغط على تنظيف النص.',
              'warning'
            );

            inputStatus.innerHTML =
              '<i class="fa-solid fa-circle-exclamation"></i> أدخل نصاً أولاً';

            resultStatus.innerHTML =
              '<i class="fa-solid fa-circle-exclamation"></i> لا توجد نتيجة';

            updateStats();
            return;
          }

          const result = cleanText(text);

          output.value = result;

          inputStatus.innerHTML =
            '<i class="fa-solid fa-check"></i> تمت المعالجة';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-circle-check"></i> النتيجة جاهزة';

          setStatus(
            'تم تنظيف النص',
            'تم تطبيق خيارات التنظيف المحددة بنجاح.',
            'success'
          );

          updateStats();
        }

        async function copyResult() {
          const text = output.value || '';

          if (!text) {
            setStatus(
              'لا توجد نتيجة',
              'قم بتنظيف النص أولاً ثم حاول النسخ.',
              'warning'
            );
            return;
          }

          try {
            await navigator.clipboard.writeText(text);

            setStatus(
              'تم النسخ',
              'تم نسخ النص النظيف إلى الحافظة.',
              'success'
            );

            copyBtn.innerHTML =
              '<i class="fa-solid fa-check"></i><span>تم النسخ</span>';

            copySmallBtn.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(function() {
              copyBtn.innerHTML =
                '<i class="fa-regular fa-copy"></i><span>نسخ النتيجة</span>';

              copySmallBtn.innerHTML =
                '<i class="fa-regular fa-copy"></i> نسخ';
            }, 1500);

          } catch (error) {
            output.focus();
            output.select();

            try {
              document.execCommand('copy');

              setStatus(
                'تم النسخ',
                'تم نسخ النص إلى الحافظة.',
                'success'
              );
            } catch (copyError) {
              setStatus(
                'تعذر النسخ',
                'حدد النص يدوياً وانسخه.',
                'warning'
              );
            }
          }
        }

        function loadSample() {
          input.value =
            '   Hello     World   \n\n' +
            '   This    is    a    sample    text.   \n' +
            '\n' +
            '   Remove     extra     spaces     easily.   ';

          output.value = '';

          inputStatus.innerHTML =
            '<i class="fa-solid fa-flask"></i> تم تحميل المثال';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-wand-magic-sparkles"></i> جاهز للتنظيف';

          setStatus(
            'مثال جاهز',
            'اضغط على تنظيف النص لرؤية النتيجة.',
            ''
          );

          updateStats();
          input.focus();
        }

        function clearAll() {
          input.value = '';
          output.value = '';

          inputStatus.innerHTML =
            '<i class="fa-solid fa-circle-info"></i> أدخل النص';

          resultStatus.innerHTML =
            '<i class="fa-solid fa-wand-magic-sparkles"></i> جاهز';

          setStatus(
            'تم المسح',
            'تم مسح النص والنتيجة.',
            'success'
          );

          updateStats();
          input.focus();
        }

        input.addEventListener('input', function() {
          updateStats();

          if (!input.value.trim()) {
            output.value = '';

            inputStatus.innerHTML =
              '<i class="fa-solid fa-circle-info"></i> أدخل النص';

            resultStatus.innerHTML =
              '<i class="fa-solid fa-wand-magic-sparkles"></i> جاهز';

            setStatus(
              'جاهز للتنظيف',
              'أدخل النص واختر خيارات التنظيف المناسبة.',
              ''
            );
          } else {
            inputStatus.innerHTML =
              '<i class="fa-solid fa-pen"></i> نص جاهز';

            setStatus(
              'جاهز للتنظيف',
              'اضغط على تنظيف النص لمعالجة المحتوى.',
              ''
            );
          }
        });

        optionInputs.forEach(function(checkbox) {
          checkbox.addEventListener(
            'change',
            updateOptionVisuals
          );
        });

        cleanBtn.addEventListener('click', clean);
        copyBtn.addEventListener('click', copyResult);
        copySmallBtn.addEventListener('click', copyResult);
        sampleBtn.addEventListener('click', loadSample);
        clearBtn.addEventListener('click', clearAll);

        input.addEventListener('keydown', function(event) {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === 'Enter'
          ) {
            clean();
          }
        });

        function syncTheme() {
          try {
            const saved = localStorage.getItem('theme');

            if (saved === 'dark') {
              document.documentElement.classList.add(
                'dark-mode'
              );
            } else {
              document.documentElement.classList.remove(
                'dark-mode'
              );
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener(
          'themeChange',
          syncTheme
        );

        document.addEventListener(
          'click',
          function(event) {
            const target = event.target;

            if (
              target &&
              target.closest &&
              target.closest('#theme-btn')
            ) {
              setTimeout(syncTheme, 0);
            }
          }
        );

        updateOptionVisuals();
        updateStats();
      })();
    </script>

    <style>
      :root {
        --bg: #f4f8fc;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --border: #dce7f2;
        --text: #0b1728;
        --muted: #64748b;
        --primary: #1688e8;
        --primary-dark: #0867b7;
        --cyan: #06b6d4;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --shadow: 0 18px 50px rgba(15, 52, 87, 0.1);
        --radius: 22px;
      }

      html.dark-mode {
        --bg: #050b14;
        --surface: #0b1524;
        --surface-2: #0f1c2e;
        --border: #1c3047;
        --text: #edf6ff;
        --muted: #91a4ba;
        --primary: #39a8ff;
        --primary-dark: #1583d2;
        --cyan: #22d3ee;
        --success: #4ade80;
        --warning: #fbbf24;
        --danger: #fb7185;
        --shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Cairo', sans-serif;
      }

      button,
      textarea,
      input {
        font-family: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 70px 0 100px;
        background:
          radial-gradient(
            circle at 15% 30%,
            rgba(22, 136, 232, 0.2),
            transparent 32%
          ),
          radial-gradient(
            circle at 85% 10%,
            rgba(6, 182, 212, 0.14),
            transparent 28%
          ),
          linear-gradient(
            135deg,
            #07111f,
            #0b1b2d 55%,
            #07111f
          );
        color: #fff;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        pointer-events: none;
      }

      .glow-one {
        width: 250px;
        height: 250px;
        background: rgba(22, 136, 232, 0.2);
        top: 40px;
        right: -100px;
      }

      .glow-two {
        width: 220px;
        height: 220px;
        background: rgba(6, 182, 212, 0.15);
        bottom: -80px;
        left: -80px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
        color: #8ea4bc;
        font-size: 13px;
      }

      .breadcrumb a {
        color: #b9cbe0;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: #55b9ff;
      }

      .tool-icon {
        width: 82px;
        height: 82px;
        display: grid;
        place-items: center;
        margin: 0 auto 18px;
        border: 1px solid rgba(96, 190, 255, 0.3);
        border-radius: 24px;
        background: linear-gradient(
          135deg,
          rgba(22, 136, 232, 0.28),
          rgba(6, 182, 212, 0.2)
        );
        box-shadow:
          0 20px 50px rgba(0, 0, 0, 0.22),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
        color: #66c7ff;
        font-size: 32px;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        border: 1px solid rgba(100, 190, 255, 0.25);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.05);
        color: #b7dfff;
        font-size: 12px;
        font-weight: 700;
      }

      .badge-dot,
      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #35e27d;
        box-shadow: 0 0 12px rgba(53, 226, 125, 0.8);
      }

      .hero h1 {
        margin: 18px 0 12px;
        font-size: clamp(34px, 6vw, 58px);
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -1.5px;
      }

      .hero p {
        max-width: 680px;
        margin: 0 auto;
        color: #a8bad0;
        font-size: 16px;
        line-height: 1.9;
      }

      .hero-tags {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .hero-tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border: 1px solid rgba(126, 190, 230, 0.18);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.045);
        color: #bcd0e5;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
      }

      /* TOOL */

      .tool-section {
        position: relative;
        margin-top: -50px;
        padding-bottom: 70px;
      }

      .cleaner-card {
        position: relative;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .card-top h2 {
        margin: 0;
        font-size: 25px;
      }

      .card-top p {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .local-status {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
      }

      /* OPTIONS */

      .options {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 9px;
        margin-bottom: 15px;
      }

      .option {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
        cursor: pointer;
        transition: 0.2s ease;
      }

      .option:hover {
        border-color: rgba(22, 136, 232, 0.4);
        transform: translateY(-2px);
      }

      .option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .check-box {
        width: 27px;
        height: 27px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: transparent;
        font-size: 11px;
        transition: 0.2s;
      }

      .option.active {
        border-color: rgba(22, 136, 232, 0.28);
        background: rgba(22, 136, 232, 0.045);
      }

      .option.active .check-box {
        border-color: transparent;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--cyan)
        );
        color: #fff;
      }

      .option-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }

      .option-content strong {
        font-size: 10px;
      }

      .option-content small {
        overflow: hidden;
        color: var(--muted);
        font-size: 8px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ACTIONS */

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
      }

      .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: var(--surface-2);
        color: var(--text);
        font-size: 11px;
        font-weight: 700;
        transition: 0.2s ease;
      }

      .action-btn:hover {
        border-color: rgba(22, 136, 232, 0.5);
        color: var(--primary);
        transform: translateY(-2px);
      }

      .action-btn.primary {
        border-color: transparent;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--cyan)
        );
        color: #fff;
        box-shadow: 0 8px 22px rgba(22, 136, 232, 0.22);
      }

      .action-btn.danger:hover {
        border-color: rgba(220, 38, 38, 0.35);
        color: var(--danger);
      }

      /* EDITORS */

      .editors {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1fr);
        align-items: stretch;
        gap: 14px;
      }

      .editor-box {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface-2);
      }

      .editor-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 13px 15px;
        border-bottom: 1px solid var(--border);
      }

      .editor-title {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .editor-title > div {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .editor-title strong {
        font-size: 13px;
      }

      .editor-title small {
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
      }

      .editor-number {
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: rgba(22, 136, 232, 0.12);
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
      }

      .output-number {
        background: rgba(6, 182, 212, 0.12);
        color: var(--cyan);
      }

      .editor-label {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 9px;
      }

      .small-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font-size: 10px;
        font-weight: 700;
      }

      .small-btn:hover {
        border-color: rgba(22, 136, 232, 0.5);
        color: var(--primary);
      }

      textarea {
        display: block;
        width: 100%;
        min-height: 230px;
        resize: vertical;
        padding: 17px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.8;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: 0.75;
      }

      .output-box textarea {
        background: rgba(22, 136, 232, 0.025);
      }

      .editor-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 10px;
      }

      .editor-footer span:first-child {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .editor-footer b {
        color: var(--text);
        font-family: 'JetBrains Mono', monospace;
      }

      .direction-arrow {
        display: grid;
        place-items: center;
        color: var(--primary);
        font-size: 20px;
      }

      /* STATUS */

      .live-status {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding: 13px 15px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
      }

      .status-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .live-status > div:last-child {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .live-status strong {
        font-size: 12px;
      }

      .live-status span {
        color: var(--muted);
        font-size: 10px;
      }

      .success-status .status-icon {
        background: rgba(22, 163, 74, 0.11);
        color: var(--success);
      }

      .warning-status .status-icon {
        background: rgba(217, 119, 6, 0.11);
        color: var(--warning);
      }

      .error-status .status-icon {
        background: rgba(220, 38, 38, 0.11);
        color: var(--danger);
      }

      /* STATS */

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 14px;
      }

      .stat-card {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
      }

      .stat-icon {
        width: 35px;
        height: 35px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 9px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
        font-size: 13px;
      }

      .stat-card div:last-child {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .stat-card span {
        color: var(--muted);
        font-size: 9px;
      }

      .stat-card strong {
        font-family: 'JetBrains Mono', monospace;
        font-size: 17px;
      }

      /* PRIVACY */

      .privacy-section {
        padding: 0 0 75px;
      }

      .privacy-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;
        border: 1px solid rgba(22, 136, 232, 0.18);
        border-radius: 18px;
        background:
          linear-gradient(
            135deg,
            rgba(22, 136, 232, 0.06),
            rgba(6, 182, 212, 0.025)
          ),
          var(--surface);
      }

      .privacy-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
        font-size: 19px;
      }

      .privacy-card h3 {
        margin: 0 0 4px;
        font-size: 14px;
      }

      .privacy-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .privacy-checks {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-right: auto;
      }

      .privacy-checks span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 9px;
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 9px;
      }

      .privacy-checks i {
        color: var(--success);
      }

      /* SECTIONS */

      .info-section,
      .steps-section,
      .faq-section {
        padding: 80px 0;
      }

      .info-section {
        background: var(--surface);
      }

      .section-heading {
        max-width: 650px;
        margin: 0 auto 35px;
        text-align: center;
      }

      .section-kicker {
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 8px 0 7px;
        font-size: 28px;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }

      .info-card {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--surface-2);
        transition: 0.25s ease;
      }

      .info-card:hover {
        transform: translateY(-4px);
        border-color: rgba(22, 136, 232, 0.35);
        box-shadow: var(--shadow);
      }

      .info-card-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        margin-bottom: 15px;
        border-radius: 11px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
      }

      .info-card p {
        min-height: 54px;
        margin: 0 0 15px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .info-card code {
        display: block;
        padding: 9px;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 8px;
        direction: ltr;
        text-align: left;
      }

      /* STEPS */

      .steps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .step-card {
        position: relative;
        padding: 27px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
      }

      .step-number {
        position: absolute;
        top: 18px;
        left: 20px;
        color: var(--border);
        font-family: 'JetBrains Mono', monospace;
        font-size: 32px;
        font-weight: 700;
      }

      .step-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        margin-bottom: 17px;
        border-radius: 13px;
        background: rgba(22, 136, 232, 0.1);
        color: var(--primary);
      }

      .step-card h3 {
        margin: 0 0 7px;
        font-size: 15px;
      }

      .step-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        max-width: 820px;
        margin: 0 auto;
      }

      .faq-item {
        margin-bottom: 9px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
      }

      .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 19px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--muted);
        transition: 0.2s;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
        color: var(--primary);
      }

      .faq-answer {
        padding: 0 19px 17px;
      }

      .faq-answer p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
