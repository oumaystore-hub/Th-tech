---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "YAML Validator - التحقق من YAML أونلاين مجاناً | Th.Tech";
const description =
  "أداة YAML Validator مجانية للتحقق من بنية وصحة YAML واكتشاف أخطاء المسافات والاقتباسات والبنية مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة YAML Validator؟",
    a: "هي أداة تساعدك على فحص بنية YAML واكتشاف مجموعة من الأخطاء الشائعة قبل استخدام الملف داخل مشروعك."
  },
  {
    q: "هل يتم إرسال YAML إلى الخادم؟",
    a: "لا. تتم عملية الفحص داخل المتصفح، لذلك لا يتم إرسال محتوى YAML إلى خادم خارجي."
  },
  {
    q: "ما الأخطاء التي يمكن اكتشافها؟",
    a: "يمكن للأداة اكتشاف علامات تبويب داخل المسافات البادئة، مشاكل شائعة في الاقتباسات والأقواس، بعض مشاكل المفاتيح والبنية والمسافات."
  },
  {
    q: "هل Validator بديل كامل لمحلل YAML؟",
    a: "الأداة مناسبة للفحص السريع والأخطاء الشائعة، لكنها لا تحل محل محلل YAML متخصص عند استخدام جميع ميزات مواصفة YAML."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0891b2" />

  <link rel="icon" href={`${base}/favicon.svg`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>

          <span>YAML Validator</span>
        </div>


        <div class="hero-content">

          <div class="hero-icon">

            <div class="icon-glow"></div>

            <i class="fa-solid fa-shield-halved"></i>

            <span class="mini-icon">
              <i class="fa-solid fa-check"></i>
            </span>

          </div>


          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>


            <h1>
              YAML Validator
              <span>مدقق YAML</span>
            </h1>


            <p>
              تحقق من بنية YAML واكتشف الأخطاء الشائعة
              في المسافات والاقتباسات والبنية بسرعة مباشرة من المتصفح.
            </p>


            <div class="hero-features">

              <span>
                <i class="fa-solid fa-shield-check"></i>
                فحص سريع
              </span>

              <span>
                <i class="fa-solid fa-bolt"></i>
                فوري
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                يعمل محلياً
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- TOOL -->
    <section class="tool-section">

      <div class="container">

        <div class="validator-card">

          <!-- TOPBAR -->
          <div class="card-topbar">

            <div class="topbar-title">

              <div class="yaml-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>
                <strong>YAML Validator</strong>
                <small>فحص صحة وبنية YAML</small>
              </div>

            </div>


            <div class="status">

              <span
                id="statusDot"
                class="status-dot"
              ></span>

              <span id="statusText">
                جاهز للفحص
              </span>

            </div>

          </div>


          <!-- ACTIONBAR -->
          <div class="actionbar">

            <div class="action-group">

              <button
                id="exampleBtn"
                class="btn btn-example"
              >
                <i class="fa-solid fa-flask"></i>
                مثال
              </button>


              <button
                id="clearBtn"
                class="btn btn-clear"
              >
                <i class="fa-solid fa-eraser"></i>
                مسح
              </button>

            </div>


            <div class="action-group">

              <button
                id="copyBtn"
                class="btn btn-copy"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>


              <button
                id="validateBtn"
                class="btn btn-validate"
              >
                <i class="fa-solid fa-shield-check"></i>
                تحقق من YAML
              </button>

            </div>

          </div>


          <!-- EDITOR -->
          <div class="editor-wrapper">

            <div class="editor-panel">

              <div class="panel-header">

                <div class="panel-title">

                  <span class="panel-dot"></span>

                  <div>
                    <strong>YAML Input</strong>
                    <small>أدخل YAML للتحقق منه</small>
                  </div>

                </div>


                <span class="language-badge">
                  YAML
                </span>

              </div>


              <div class="editor">

                <div
                  id="lineNumbers"
                  class="line-numbers"
                >1</div>


                <textarea
                  id="yamlInput"
                  spellcheck="false"
                  autocomplete="off"
                  placeholder="name: Th.Tech&#10;version: 1.0.0&#10;settings:&#10;  theme: dark&#10;  language: ar"
                ></textarea>

              </div>


              <div class="editor-footer">

                <span>
                  <i class="fa-solid fa-code"></i>
                  YAML
                </span>

                <span id="inputStats">
                  0 سطر · 0 حرف
                </span>

              </div>

            </div>

          </div>


          <!-- VALIDATION RESULT -->
          <div class="validation-section">

            <div class="validation-header">

              <div>

                <span class="section-label">
                  VALIDATION RESULT
                </span>

                <h2 id="validationTitle">
                  جاهز للفحص
                </h2>

              </div>


              <div
                id="validationBadge"
                class="validation-badge neutral"
              >
                READY
              </div>

            </div>


            <div
              id="resultBox"
              class="result-box neutral"
            >

              <div
                id="resultIcon"
                class="result-icon"
              >
                <i class="fa-solid fa-circle-info"></i>
              </div>


              <div class="result-content">

                <strong id="resultMessage">
                  أدخل YAML ثم اضغط على «تحقق من YAML».
                </strong>

                <div
                  id="issuesList"
                  class="issues-list"
                ></div>

              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats">

            <div class="stat">

              <div class="stat-icon cyan">
                <i class="fa-solid fa-align-left"></i>
              </div>

              <div>
                <strong id="statLines">0</strong>
                <span>الأسطر</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon blue">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <strong id="statChars">0</strong>
                <span>الأحرف</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon orange">
                <i class="fa-solid fa-key"></i>
              </div>

              <div>
                <strong id="statKeys">0</strong>
                <span>المفاتيح</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon green">
                <i class="fa-solid fa-circle-check"></i>
              </div>

              <div>
                <strong id="statStatus">—</strong>
                <span>الحالة</span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- INFO -->
    <section class="info-section">

      <div class="container">

        <div class="section-heading">

          <span>YAML VALIDATOR</span>

          <h2>
            اكتشف أخطاء YAML قبل استخدامها
          </h2>

          <p>
            افحص بنية YAML بسرعة واحصل على نتيجة واضحة دون تثبيت أي برنامج.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon cyan-icon">
              <i class="fa-solid fa-shield-check"></i>
            </div>

            <h3>
              فحص سريع
            </h3>

            <p>
              تحقق من مجموعة من المشاكل الشائعة في بنية YAML
              والمسافات والاقتباسات.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon blue-icon">
              <i class="fa-solid fa-bug"></i>
            </div>

            <h3>
              اكتشاف الأخطاء
            </h3>

            <p>
              تعرض الأداة الأسطر التي تحتوي على مشاكل محتملة
              لمساعدتك على تصحيح الملف.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon green-icon">
              <i class="fa-solid fa-lock"></i>
            </div>

            <h3>
              خصوصية كاملة
            </h3>

            <p>
              تتم عملية التحقق محلياً داخل المتصفح ولا يتم
              رفع محتوى YAML إلى خادم خارجي.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="how-section">

      <div class="container">

        <div class="section-heading">

          <span>طريقة الاستخدام</span>

          <h2>
            كيف تتحقق من YAML؟
          </h2>

          <p>
            افحص ملف YAML في ثلاث خطوات بسيطة.
          </p>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-paste"></i>
            </div>

            <h3>
              أدخل YAML
            </h3>

            <p>
              الصق أو اكتب محتوى YAML داخل المحرر.
            </p>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-shield-check"></i>
            </div>

            <h3>
              ابدأ الفحص
            </h3>

            <p>
              اضغط على «تحقق من YAML» لفحص البنية.
            </p>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-circle-check"></i>
            </div>

            <h3>
              صحح الأخطاء
            </h3>

            <p>
              راجع التنبيهات وأصلح الأسطر التي تحتاج إلى تعديل.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

          <p>
            معلومات مهمة حول YAML Validator.
          </p>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details class="faq-item">

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>

    </section>

  









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/yaml-formatter/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3h8l4 4v14H6z"/>
        <path d="M14 3v5h5M9 12h6M9 16h6"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Yaml Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/email-validator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Email Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-validator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m7 5-5 7 5 7M17 5l5 7-5 7M14 3l-4 18"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Html Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ip-validator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Ip Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-validator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="3"/>
        <path d="M8 9v7l2 2 2-2M15 9v7"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Javascript Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/json-validator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 4c-2 1-3 3-3 6s1 5 3 6"/>
        <path d="M16 4c2 1 3 3 3 6s-1 5-3 6"/>
        <path d="M9 8h6M9 12h4M9 16h6"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Json Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
  </div>
</section>

<style>
  /* =========================================
     Related Tools
     الوضع الافتراضي = فاتح
     ========================================= */

  .related-tools {
    width: min(1000px, 100%);
    margin: 40px auto 25px;
    padding: 22px;

    border-radius: 18px;

    background: #ffffff !important;
    color: #0f172a !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 8px 24px rgba(15, 23, 42, 0.06) !important;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .related-tools-header {
    margin-bottom: 17px;
  }

  .related-tools-label {
    display: inline-block;

    margin-bottom: 5px;

    color: #0284c7 !important;

    font-size: 0.78rem;
    font-weight: 800;
  }

  .related-tools h2 {
    margin: 0 0 5px;

    color: #0f172a !important;

    font-size: 1.3rem;
    line-height: 1.4;
    font-weight: 800;
  }

  .related-tools p {
    margin: 0;

    color: #64748b !important;

    font-size: 0.85rem;
  }

  /* =========================================
     Cards
     ========================================= */

  .related-tools-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;

    gap: 9px;

    min-height: 58px;

    padding: 9px 10px;

    border-radius: 12px;

    text-decoration: none !important;

    color: #0f172a !important;

    background: #f8fafc !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.035) !important;

    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-2px);

    color: #0f172a !important;

    background: #f0f9ff !important;

    border-color: #38bdf8 !important;

    box-shadow:
      0 6px 14px rgba(14, 165, 233, 0.10) !important;
  }

  /* =========================================
     SVG icon
     ========================================= */

  .related-tool-icon {
    display: grid;
    place-items: center;

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    border-radius: 9px;

    color: #0284c7 !important;

    background: rgba(14, 165, 233, 0.10) !important;
  }

  .related-tool-icon svg {
    width: 18px;
    height: 18px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;

    justify-content: center;

    gap: 2px;

    min-width: 0;
    flex: 1;
  }

  .related-tool-content strong {
    display: block;

    color: #0f172a !important;

    font-size: 0.84rem;
    line-height: 1.25;
    font-weight: 750;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    color: #64748b !important;

    font-size: 0.68rem;
    line-height: 1.2;
  }

  .related-tool-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    flex: 0 0 22px;

    color: #94a3b8 !important;

    font-size: 0.85rem;

    transition:
      transform 0.18s ease,
      color 0.18s ease;
  }

  .related-tool-card:hover .related-tool-arrow {
    color: #0284c7 !important;

    transform: translateX(-2px);
  }

  /* =========================================
     الوضع الليلي الحقيقي في المشروع
     يعتمد على class وليس data-theme
     ========================================= */

  html.dark-mode .related-tools,
  body.dark-mode .related-tools,
  html.dark .related-tools,
  body.dark .related-tools {
    background: #111827 !important;
    color: #f8fafc !important;

    border-color: rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.20) !important;
  }

  html.dark-mode .related-tools h2,
  body.dark-mode .related-tools h2,
  html.dark .related-tools h2,
  body.dark .related-tools h2 {
    color: #f8fafc !important;
  }

  html.dark-mode .related-tools p,
  body.dark-mode .related-tools p,
  html.dark .related-tools p,
  body.dark .related-tools p {
    color: #cbd5e1 !important;
  }

  html.dark-mode .related-tool-card,
  body.dark-mode .related-tool-card,
  html.dark .related-tool-card,
  body.dark .related-tool-card {
    color: #f8fafc !important;

    background: #1e293b !important;

    border-color: rgba(255, 255, 255, 0.08) !important;

    box-shadow: none !important;
  }

  html.dark-mode .related-tool-card:hover,
  body.dark-mode .related-tool-card:hover,
  html.dark .related-tool-card:hover,
  body.dark .related-tool-card:hover {
    color: #ffffff !important;

    background: #263449 !important;

    border-color: #38bdf8 !important;
  }

  html.dark-mode .related-tool-content strong,
  body.dark-mode .related-tool-content strong,
  html.dark .related-tool-content strong,
  body.dark .related-tool-content strong {
    color: #f8fafc !important;
  }

  html.dark-mode .related-tool-content small,
  body.dark-mode .related-tool-content small,
