<script is:inline>
  (() => {

    const input =
      document.getElementById("yamlInput");

    const validateBtn =
      document.getElementById("validateBtn");

    const clearBtn =
      document.getElementById("clearBtn");

    const exampleBtn =
      document.getElementById("exampleBtn");

    const copyBtn =
      document.getElementById("copyBtn");

    const lineNumbers =
      document.getElementById("lineNumbers");

    const inputStats =
      document.getElementById("inputStats");

    const statusText =
      document.getElementById("statusText");

    const statusDot =
      document.getElementById("statusDot");

    const validationTitle =
      document.getElementById("validationTitle");

    const validationBadge =
      document.getElementById("validationBadge");

    const resultBox =
      document.getElementById("resultBox");

    const resultIcon =
      document.getElementById("resultIcon");

    const resultMessage =
      document.getElementById("resultMessage");

    const issuesList =
      document.getElementById("issuesList");

    const statLines =
      document.getElementById("statLines");

    const statChars =
      document.getElementById("statChars");

    const statKeys =
      document.getElementById("statKeys");

    const statStatus =
      document.getElementById("statStatus");


    function updateLineNumbers() {

      const count =
        Math.max(
          1,
          input.value.split("\n").length
        );

      lineNumbers.textContent =
        Array.from(
          { length: count },
          (_, index) => index + 1
        ).join("\n");

      return count;

    }


    function updateStats() {

      const value =
        input.value;

      const lines =
        updateLineNumbers();

      inputStats.textContent =
        `${value.trim() ? lines : 0} سطر · ${value.length} حرف`;

      statLines.textContent =
        value.trim()
          ? lines
          : 0;

      statChars.textContent =
        value.length;

      statKeys.textContent =
        countKeys(value);

    }


    function setStatus(
      text,
      type
    ) {

      statusText.textContent =
        text;

      statusDot.className =
        "status-dot";

      if (type) {
        statusDot.classList.add(type);
      }

    }


    function setResult(
      type,
      title,
      message,
      issues
    ) {

      resultBox.className =
        `result-box ${type}`;

      validationTitle.textContent =
        title;

      resultMessage.textContent =
        message;


      if (type === "success") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-check"></i>`;

        validationBadge.textContent =
          "VALID";

        validationBadge.className =
          "validation-badge valid";

        statStatus.textContent =
          "صالح";

      } else if (type === "error") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-xmark"></i>`;

        validationBadge.textContent =
          "INVALID";

        validationBadge.className =
          "validation-badge invalid";

        statStatus.textContent =
          "خطأ";

      } else if (type === "warning") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-triangle-exclamation"></i>`;

        validationBadge.textContent =
          "WARNING";

        validationBadge.className =
          "validation-badge warning";

        statStatus.textContent =
          "تنبيه";

      } else {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-info"></i>`;

        validationBadge.textContent =
          "READY";

        validationBadge.className =
          "validation-badge neutral";

        statStatus.textContent =
          "—";

      }


      issuesList.innerHTML = "";


      if (
        issues &&
        issues.length
      ) {

        issues
          .slice(0, 8)
          .forEach(
            (issue) => {

              const item =
                document.createElement("div");

              item.className =
                "issue-item";

              item.innerHTML =
                `<i class="fa-solid fa-circle-exclamation"></i><span>${escapeHtml(issue)}</span>`;

              issuesList.appendChild(
                item
              );

            }
          );

      }

    }


    function escapeHtml(
      value
    ) {

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    function countKeys(
      source
    ) {

      let count = 0;

      source
        .replace(/\r\n/g, "\n")
        .split("\n")
        .forEach(
          (line) => {

            const trimmed =
              line.trim();

            if (
              !trimmed ||
              trimmed.startsWith("#") ||
              trimmed.startsWith("-") ||
              trimmed === "---" ||
              trimmed === "..."
            ) {
              return;
            }

            if (
              /^[^:#][^:]*:\s*(.*)$/.test(
                trimmed
              )
            ) {

              count++;

            }

          }
        );

      return count;

    }


    function stripComment(
      line
    ) {

      let quote = null;

      for (
        let i = 0;
        i < line.length;
        i++
      ) {

        const char =
          line[i];


        if (quote) {

          if (
            char === quote &&
            line[i - 1] !== "\\"
          ) {

            quote = null;

          }

          continue;

        }


        if (
          char === "'" ||
          char === '"'
        ) {

          quote = char;
          continue;

        }


        if (
          char === "#" &&
          (
            i === 0 ||
            /\s/.test(line[i - 1])
          )
        ) {

          return line
            .slice(0, i);

        }

      }


      return line;

    }


    function checkQuotes(
      source,
      issues
    ) {

      source
        .replace(/\r\n/g, "\n")
        .split("\n")
        .forEach(
          (line, index) => {

            const clean =
              stripComment(line);

            let single =
              0;

            let double =
              0;

            for (
              let i = 0;
              i < clean.length;
              i++
            ) {

              if (
                clean[i] === "'" &&
                clean[i - 1] !== "\\"
              ) {
                single++;
              }

              if (
                clean[i] === '"' &&
                clean[i - 1] !== "\\"
              ) {
                double++;
              }

            }


            if (
              single % 2 !== 0
            ) {

              issues.push(
                `السطر ${index + 1}: اقتباس مفرد غير مغلق.`
              );

            }


            if (
              double % 2 !== 0
            ) {

              issues.push(
                `السطر ${index + 1}: اقتباس مزدوج غير مغلق.`
              );

            }

          }
        );

    }


    function checkBrackets(
      source,
      issues
    ) {

      const stack = [];

      const pairs = {
        ")": "(",
        "]": "[",
        "}": "{"
      };

      source
        .replace(/\r\n/g, "\n")
        .split("\n")
        .forEach(
          (line, index) => {

            const clean =
              stripComment(line);

            let quote = null;

            for (
              let i = 0;
              i < clean.length;
              i++
            ) {

              const char =
                clean[i];


              if (
                quote
              ) {

                if (
                  char === quote &&
                  clean[i - 1] !== "\\"
                ) {

                  quote = null;

                }

                continue;

              }


              if (
                char === "'" ||
                char === '"'
              ) {

                quote = char;
                continue;

              }


              if (
                char === "(" ||
                char === "[" ||
                char === "{"
              ) {

                stack.push({
                  char,
                  line: index + 1
                });

              }


              if (
                char === ")" ||
                char === "]" ||
                char === "}"
              ) {

                if (
                  !stack.length ||
                  stack[stack.length - 1].char !== pairs[char]
                ) {

                  issues.push(
                    `السطر ${index + 1}: قوس غير متطابق (${char}).`
                  );

                } else {

                  stack.pop();

                }

              }

            }

          }
        );


      stack.forEach(
        (item) => {

          issues.push(
            `السطر ${item.line}: القوس ${item.char} غير مغلق.`
          );

        }
      );

    }


    function checkIndentation(
      source,
      issues
    ) {

      const lines =
        source
          .replace(/\r\n/g, "\n")
          .split("\n");


      let previousIndent =
        0;

      let previousContent =
        "";


      lines.forEach(
        (originalLine, index) => {

          if (
            !originalLine.trim()
          ) {
            return;
          }


          const leading =
            originalLine.match(
              /^[ \t]*/
            )?.[0] || "";


          if (
            leading.includes("\t")
          ) {

            issues.push(
              `السطر ${index + 1}: لا تستخدم Tab في المسافة البادئة؛ استخدم المسافات.`
            );

          }


          const spaces =
            leading.replace(
              /\t/g,
              "  "
            ).length;


          if (
            spaces % 2 !== 0
          ) {

            issues.push(
              `السطر ${index + 1}: المسافة البادئة ليست من مضاعفات 2.`
            );

          }


          if (
            spaces > previousIndent + 2
          ) {

            issues.push(
              `السطر ${index + 1}: المسافة البادئة زادت بأكثر من مستوى واحد.`
            );

          }


          const content =
            originalLine.trim();


          if (
            previousContent.endsWith(":") &&
            spaces <= previousIndent &&
            !content.startsWith("-")
          ) {

            issues.push(
              `السطر ${index + 1}: المحتوى بعد المفتاح السابق يحتاج إلى مسافة بادئة.`
            );

          }


          previousIndent =
            spaces;

          previousContent =
            content;

        }
      );

    }


    function checkSyntax(
      source,
      issues
    ) {

      const lines =
        source
          .replace(/\r\n/g, "\n")
          .split("\n");


      lines.forEach(
        (originalLine, index) => {

          const trimmed =
            originalLine.trim();


          if (
            !trimmed ||
            trimmed.startsWith("#") ||
            trimmed === "---" ||
            trimmed === "..."
          ) {

            return;

          }


          const content =
            stripComment(trimmed)
              .trim();


          if (
            !content
          ) {
            return;
          }


          if (
            content.startsWith("-")
          ) {

            if (
              content !== "-" &&
              !/^-\s+/.test(content) &&
              !/^-[\[\{]/.test(content)
            ) {

              issues.push(
                `السطر ${index + 1}: عنصر القائمة يجب أن يفصل بمسافة بعد "-".`
              );

            }

            return;

          }


          if (
            !content.includes(":")
          ) {

            const scalar =
              /^["'].*["']$/.test(content) ||
              /^(true|false|null|~)$/i.test(content) ||
              /^-?\d+(\.\d+)?$/.test(content) ||
              /^[>|]$/.test(content);

            if (!scalar) {

              issues.push(
                `السطر ${index + 1}: لا يحتوي السطر على بنية مفتاح: قيمة واضحة.`
              );

            }

            return;

          }


          const colon =
            content.indexOf(":");


          const key =
            content
              .slice(0, colon)
              .trim();


          if (!key) {

            issues.push(
              `السطر ${index + 1}: يوجد مفتاح YAML فارغ.`
            );

          }


          if (
            /[:#\[\]\{\},&*!|>'"%@`]/.test(
              key
            ) &&
            !/^["'].*["']$/.test(key)
          ) {

            issues.push(
              `السطر ${index + 1}: قد يحتاج اسم المفتاح إلى اقتباس.`
            );

          }

        }
      );

    }


    function findDuplicateKeys(
      source,
      issues
    ) {

      const lines =
        source
          .replace(/\r\n/g, "\n")
          .split("\n");


      const scopes = {};


      lines.forEach(
        (line, index) => {

          const trimmed =
            line.trim();

          if (
            !trimmed ||
            trimmed.startsWith("#") ||
            trimmed.startsWith("-")
          ) {
            return;
          }


          const match =
            trimmed.match(
              /^([^:#][^:]*):/
            );


          if (!match) {
            return;
          }


          const key =
            match[1].trim();

          const indent =
            countSpaces(line);


          const scope =
            `${indent}`;

          if (!scopes[scope]) {
            scopes[scope] = {};
          }


          if (
            scopes[scope][key]
          ) {

            issues.push(
              `السطر ${index + 1}: المفتاح "${key}" مكرر في نفس المستوى.`
            );

          }


          scopes[scope][key] =
            true;

        }
      );

    }


    function countSpaces(
      line
    ) {

      let count = 0;

      for (
        let i = 0;
        i < line.length;
        i++
      ) {

        if (
          line[i] === " "
        ) {

          count++;

        } else {

          break;

        }

      }

      return count;

    }


    function validate() {

      const source =
        input.value;


      if (
        !source.trim()
      ) {

        setStatus(
          "لا يوجد محتوى",
          "warning"
        );

        setResult(
          "warning",
          "المحرر فارغ",
          "أدخل محتوى YAML أولاً ثم ابدأ عملية التحقق.",
          []
        );

        return;

      }


      setStatus(
        "جارٍ الفحص...",
        "processing"
      );


      validationBadge.textContent =
        "CHECKING";

      validationBadge.className =
        "validation-badge checking";


      setTimeout(() => {

        const issues = [];


        checkQuotes(
          source,
          issues
        );


        checkBrackets(
          source,
          issues
        );


        checkIndentation(
          source,
          issues
        );


        checkSyntax(
          source,
          issues
        );


        findDuplicateKeys(
          source,
          issues
        );


        const uniqueIssues =
          [...new Set(issues)];


        if (
          uniqueIssues.length === 0
        ) {

          setStatus(
            "YAML صالح",
            "success"
          );

          setResult(
            "success",
            "YAML صالح",
            "لم يتم العثور على أخطاء شائعة في البنية.",
            []
          );

        } else {

          setStatus(
            `${uniqueIssues.length} مشكلة`,
            "error"
          );

          setResult(
            "error",
            "تم العثور على مشاكل",
            `تم اكتشاف ${uniqueIssues.length} مشكلة محتملة. راجع التفاصيل أدناه.`,
            uniqueIssues
          );

        }

        updateStats();

      }, 100);

    }


    function loadExample() {

      input.value =
`name: Th.Tech
version: "1.0.0"
description: "Developer tools platform"

settings:
  theme: dark
  language: ar
  editor:
    fontSize: 14
    tabSize: 2

tools:
  - name: JSON Formatter
    slug: json-formatter
    category: JSON

  - name: YAML Validator
    slug: yaml-validator
    category: YAML

database:
  host: localhost
  port: 3306
  enabled: true`;


      updateStats();
      validate();

      input.focus();

    }


    function clearAll() {

      input.value = "";

      updateStats();

      setStatus(
        "جاهز للفحص",
        ""
      );

      validationBadge.textContent =
        "READY";

      validationBadge.className =
        "validation-badge neutral";

      setResult(
        "neutral",
        "جاهز للفحص",
        "أدخل YAML ثم اضغط على «تحقق من YAML».",
        []
      );

    }


    async function copyYaml() {

      if (
        !input.value.trim()
      ) {

        setStatus(
          "لا توجد بيانات للنسخ",
          "warning"
        );

        return;

      }


      try {

        await navigator.clipboard.writeText(
          input.value
        );


        const old =
          copyBtn.innerHTML;


        copyBtn.innerHTML =
          `<i class="fa-solid fa-check"></i> تم النسخ`;


        setStatus(
          "تم النسخ",
          "success"
        );


        setTimeout(() => {

          copyBtn.innerHTML =
            old;

          setStatus(
            "جاهز للفحص",
            ""
          );

        }, 1500);


      } catch {

        input.select();

        document.execCommand(
          "copy"
        );

        setStatus(
          "تم النسخ",
          "success"
        );

      }

    }


    input.addEventListener(
      "input",
      updateStats
    );


    input.addEventListener(
      "scroll",
      () => {

        lineNumbers.scrollTop =
          input.scrollTop;

      }
    );


    input.addEventListener(
      "keydown",
      (event) => {

        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {

          event.preventDefault();

          validate();

        }


        if (
          event.key === "Tab"
        ) {

          event.preventDefault();

          const start =
            input.selectionStart;

          const end =
            input.selectionEnd;


          input.value =
            input.value.substring(
              0,
              start
            ) +
            "  " +
            input.value.substring(
              end
            );


          input.selectionStart =
            input.selectionEnd =
              start + 2;


          updateStats();

        }

      }
    );


    validateBtn.addEventListener(
      "click",
      validate
    );


    exampleBtn.addEventListener(
      "click",
      loadExample
    );


    clearBtn.addEventListener(
      "click",
      clearAll
    );


    copyBtn.addEventListener(
      "click",
      copyYaml
    );


    updateStats();

  })();
</script>


