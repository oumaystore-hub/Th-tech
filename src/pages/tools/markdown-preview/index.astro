        place-items: center;
        border-radius: 14px;
        margin-bottom: 15px;
        font-size: 20px;
      }

      .info-icon.blue {
        background: rgba(37, 99, 235, 0.1);
        color: var(--primary);
      }

      .info-icon.cyan {
        background: rgba(6, 182, 212, 0.1);
        color: var(--cyan);
      }

      .info-icon.purple {
