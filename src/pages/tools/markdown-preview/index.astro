          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
      }

      button,
      textarea {
        font-family: inherit;
      }

      .page {
        min-height: 100vh;
        padding: 28px 16px 70px;
      }

      .container {
        width: min(1120px, 100%);
        margin: auto;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 30px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: 0.2s;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .separator {
        font-size: 10px;
        opacity: 0.6;
      }

      .hero {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 28px;
      }

      .hero-icon {
        width: 76px;
        height: 76px;
        flex: 0 0 76px;
        display: grid;
        place-items: center;
        border-radius: 22px;
        color: white;
        font-size: 32px;
        background: linear-gradient(
          135deg,
          #2563eb,
          #06b6d4
        );
        box-shadow:
          0 15px 35px rgba(37, 99, 235, 0.22);
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 5px;
      }

      .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow:
          0 0 0 5px rgba(16, 185, 129, 0.1);
      }

      .hero h1 {
        margin: 0 0 6px;
        font-size: clamp(30px, 5vw, 44px);
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero p {
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }

      .tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--muted);
        font-size: 11px;
        font-family: "JetBrains Mono", monospace;
      }

      .tool-card,
      .privacy-card,
      .info-card,
      .step {
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .tool-card {
        padding: 24px;
        border-radius: 24px;
      }

      .tool-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
      }

      .tool-header h2 {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 4px;
        font-size: 20px;
      }

      .tool-header h2 i {
        color: var(--primary);
      }

      .tool-header p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
      }

      .live-badge span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
      }

      .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 10px;
        margin-bottom: 12px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .tool-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 8px 11px;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        transition: 0.2s;
      }

      .tool-btn:hover {
        color: var(--primary);
        border-color: var(--primary);
        transform: translateY(-1px);
      }

      .tool-btn i {
        color: var(--primary);
      }

      .editor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      .panel {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface-2);
      }

      .panel-header,
      .panel-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 15px;
        color: var(--muted);
        font-size: 11px;
      }

      .panel-header {
        border-bottom: 1px solid var(--border);
      }

      .panel-header div {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text);
        font-weight: 700;
      }

      .panel-header i {
        color: var(--primary);
      }

      .panel-footer {
        border-top: 1px solid var(--border);
      }

      textarea {
        display: block;
        width: 100%;
        min-height: 430px;
        resize: vertical;
        padding: 18px;
        border: 0;
        outline: none;
        background: transparent;
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.8;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: 0.75;
      }

      .markdown-body {
        min-height: 430px;
        max-height: 620px;
        overflow: auto;
        padding: 22px;
        color: var(--text);
        line-height: 1.9;
        text-align: right;
      }

      .markdown-body h1,
      .markdown-body h2,
      .markdown-body h3,
      .markdown-body h4,
      .markdown-body h5,
      .markdown-body h6 {
        line-height: 1.45;
        margin-top: 0;
        margin-bottom: 14px;
      }

      .markdown-body h1 {
        font-size: 30px;
      }

      .markdown-body h2 {
        font-size: 24px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
      }

      .markdown-body h3 {
        font-size: 20px;
      }

      .markdown-body h4 {
        font-size: 18px;
      }

      .markdown-body p {
        margin: 0 0 15px;
      }

      .markdown-body a {
        color: var(--primary);
        font-weight: 700;
      }

      .markdown-body ul,
      .markdown-body ol {
        padding-right: 25px;
        margin: 0 0 16px;
      }

      .markdown-body li {
        margin-bottom: 5px;
      }

      .markdown-body blockquote {
        margin: 15px 0;
        padding: 12px 16px;
        border-right: 4px solid var(--primary);
        background: rgba(37, 99, 235, 0.07);
        color: var(--muted);
        border-radius: 8px;
      }

      .markdown-body blockquote p {
        margin: 0;
      }

      .markdown-body code {
        padding: 3px 7px;
        border-radius: 6px;
        background: var(--code);
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;
      }

      .markdown-body pre {
        direction: ltr;
        overflow-x: auto;
        margin: 15px 0;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #08111d;
        color: #dbeafe;
        text-align: left;
      }

      .markdown-body pre code {
        padding: 0;
        background: transparent;
        color: inherit;
      }

      .markdown-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
        overflow: hidden;
      }

      .markdown-body th,
      .markdown-body td {
        padding: 9px 11px;
        border: 1px solid var(--border);
        text-align: right;
      }

      .markdown-body th {
        background: rgba(37, 99, 235, 0.08);
        font-weight: 800;
      }

      .markdown-body img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
      }

      .markdown-body hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 22px 0;
      }

      .empty-preview {
        min-height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        color: var(--muted);
      }

      .empty-preview > i {
        font-size: 48px;
        color: var(--primary);
        margin-bottom: 12px;
        opacity: 0.7;
      }

      .empty-preview h3 {
        margin: 0 0 5px;
        color: var(--text);
      }

      .empty-preview p {
        margin: 0;
        font-size: 12px;
      }

      .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 17px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 17px;
        border: 0;
        border-radius: 13px;
        cursor: pointer;
        font-weight: 700;
        transition: 0.2s;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .primary-btn {
        color: white;
        background: linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );
        box-shadow:
          0 10px 25px rgba(37, 99, 235, 0.18);
