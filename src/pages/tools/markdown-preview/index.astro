        color: #8b5cf6;
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 12px;
      }

      .privacy-card {
