---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Markdown Preview - معاينة Markdown أونلاين | Th.Tech";
const description =
  "أداة Markdown Preview مجانية لكتابة ومعاينة Markdown مباشرة مع دعم العناوين والقوائم والروابط والجداول والأكواد.";
const canonical =
  `https://oumaystore-hub.github.io${base}/tools/markdown-preview/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page">
      <div class="container">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="مسار التنقل">
          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <span>Markdown Preview</span>
        </nav>

        <!-- Hero -->
        <section class="hero">
          <div class="hero-icon">
            <i class="fa-brands fa-markdown"></i>
          </div>

          <div class="hero-content">
            <div class="eyebrow">
              <span class="dot"></span>
              محرر ومعاينة Markdown
            </div>

            <h1>Markdown Preview</h1>

            <p>
              اكتب Markdown وشاهد النتيجة مباشرة في معاينة احترافية
              داخل متصفحك.
            </p>

            <div class="tags">
              <span>
                <i class="fa-brands fa-markdown"></i>
                Markdown
              </span>

              <span>
                <i class="fa-solid fa-eye"></i>
                Live Preview
              </span>

              <span>
                <i class="fa-solid fa-code"></i>
                Code
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                Local
              </span>
            </div>
          </div>
        </section>

        <!-- Main Tool -->
        <section class="tool-card">

          <div class="tool-header">
            <div>
              <h2>
                <i class="fa-solid fa-pen-to-square"></i>
                محرر Markdown
              </h2>

              <p>
                اكتب في المحرر وستتحدث المعاينة تلقائياً.
              </p>
            </div>

            <div class="live-badge">
              <span></span>
              معاينة مباشرة
            </div>
          </div>

          <!-- Toolbar -->
          <div class="toolbar">

            <button class="tool-btn" type="button" data-insert="# ">
              <i class="fa-solid fa-heading"></i>
              عنوان
            </button>

            <button class="tool-btn" type="button" data-wrap="**">
              <i class="fa-solid fa-bold"></i>
              عريض
            </button>

            <button class="tool-btn" type="button" data-wrap="*">
              <i class="fa-solid fa-italic"></i>
              مائل
            </button>

            <button class="tool-btn" type="button" data-insert="- ">
              <i class="fa-solid fa-list"></i>
              قائمة
            </button>

            <button class="tool-btn" type="button" data-insert="> ">
              <i class="fa-solid fa-quote-right"></i>
              اقتباس
            </button>

            <button class="tool-btn" type="button" data-wrap="`">
              <i class="fa-solid fa-code"></i>
              كود
            </button>

            <button class="tool-btn" type="button" data-link="true">
              <i class="fa-solid fa-link"></i>
              رابط
            </button>

          </div>

          <!-- Editor Grid -->
          <div class="editor-grid">

            <!-- Editor -->
            <div class="panel">

              <div class="panel-header">
                <div>
                  <i class="fa-solid fa-file-code"></i>
                  Markdown
                </div>

                <span id="editorStats">0 كلمة</span>
              </div>

              <textarea
                id="markdownInput"
                dir="ltr"
                spellcheck="false"
                placeholder="# اكتب Markdown هنا...

**مثال:**
- عنصر أول
- عنصر ثان

> اقتباس رائع

`code`"
              ></textarea>

              <div class="panel-footer">
                <span>
                  <i class="fa-solid fa-keyboard"></i>
                  Markdown
                </span>

                <span id="charCount">0 حرف</span>
              </div>

            </div>

            <!-- Preview -->
            <div class="panel preview-panel">

              <div class="panel-header">
                <div>
                  <i class="fa-solid fa-eye"></i>
                  المعاينة
                </div>

                <span>
                  <i class="fa-solid fa-bolt"></i>
                  Live
                </span>
              </div>

              <div
                id="preview"
                class="markdown-body"
                dir="auto"
              >
                <div class="empty-preview">
                  <i class="fa-brands fa-markdown"></i>
                  <h3>المعاينة ستظهر هنا</h3>
                  <p>
                    ابدأ بكتابة Markdown في المحرر.
                  </p>
                </div>
              </div>

              <div class="panel-footer">
                <span>
                  <i class="fa-solid fa-display"></i>
                  Preview
                </span>

                <span id="previewWords">0 كلمة</span>
              </div>

            </div>

          </div>

          <!-- Actions -->
          <div class="actions">

            <button id="sampleBtn" class="btn secondary" type="button">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              مثال
            </button>

            <button id="copyBtn" class="btn primary-btn" type="button">
              <i class="fa-regular fa-copy"></i>
              نسخ Markdown
            </button>

            <button id="clearBtn" class="btn danger" type="button">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

          </div>

          <div id="status" class="status">
            <i class="fa-solid fa-circle-info"></i>
            ابدأ بكتابة Markdown لعرض المعاينة.
          </div>

        </section>

        <!-- Features -->
        <section class="info-section">

          <div class="section-title centered">
            <div class="section-title-icon">
              <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
              <h2>ما الذي يدعمه المحرر؟</h2>
              <p>أهم عناصر Markdown المتاحة في المعاينة.</p>
            </div>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-icon blue">
                <i class="fa-solid fa-heading"></i>
              </div>

              <h3>العناوين والتنسيق</h3>

              <p>
                دعم العناوين بمستوياتها المختلفة مع النص العريض
                والمائل والمسطّر والمشطوب.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon cyan">
                <i class="fa-solid fa-list"></i>
              </div>

              <h3>القوائم والاقتباسات</h3>

              <p>
                إنشاء القوائم النقطية والمرقمة والاقتباسات
                بسهولة باستخدام صيغة Markdown.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon purple">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>الأكواد والجداول</h3>

              <p>
                عرض الأكواد البرمجية والروابط والجداول
                بتنسيق واضح داخل المعاينة.
              </p>
            </article>

          </div>

        </section>

        <!-- Privacy -->
        <section class="privacy-card">

          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>معالجة محلية</h3>

            <p>
              تتم معالجة Markdown داخل متصفحك مباشرة.
              لا يتم إرسال المحتوى إلى خادم خارجي.
            </p>
          </div>

        </section>

        <!-- How To -->
        <section class="how-section">

          <div class="section-title centered">
            <div class="section-title-icon">
              <i class="fa-solid fa-route"></i>
            </div>

            <div>
              <h2>كيفية الاستخدام</h2>
              <p>أنشئ Markdown وشاهد النتيجة في ثوانٍ.</p>
            </div>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>اكتب Markdown</h3>

                <p>
                  أدخل النص أو الصق كود Markdown في المحرر.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>شاهد المعاينة</h3>

                <p>
                  ستظهر النتيجة المنسقة مباشرة في الجهة المقابلة.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>انسخ المحتوى</h3>

                <p>
                  انسخ Markdown النهائي واستخدمه في مشروعك.
                </p>
              </div>
            </div>

          </div>

        </section>

        <!-- FAQ -->
        <section class="faq-section">

          <div class="section-title centered">
            <div class="section-title-icon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div>
              <h2>الأسئلة الشائعة</h2>
              <p>معلومات سريعة حول Markdown Preview.</p>
            </div>
          </div>

          <div class="faq-list">

            <details>
              <summary>
                ما هو Markdown؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                Markdown هي لغة تنسيق نصية بسيطة تستخدم لإنشاء
                مستندات منسقة باستخدام رموز سهلة القراءة والكتابة.
              </p>
            </details>

            <details>
              <summary>
                هل المعاينة مباشرة؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يتم تحديث المعاينة تلقائياً أثناء الكتابة
                دون الحاجة إلى الضغط على زر.
              </p>
            </details>

            <details>
              <summary>
                هل يتم حفظ النص؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                لا يتم إرسال النص إلى خادم خارجي. تتم المعالجة
                داخل المتصفح فقط.
              </p>
            </details>

            <details>
              <summary>
                هل يمكن استخدام الأداة للمشاريع البرمجية؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يمكنك استخدامها لكتابة README وملفات التوثيق
                والملاحظات والمحتوى التقني.
              </p>
            </details>

          </div>

        </section>

      </div>
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const input = document.getElementById("markdownInput");
        const preview = document.getElementById("preview");

        const editorStats = document.getElementById("editorStats");
        const previewWords = document.getElementById("previewWords");
        const charCount = document.getElementById("charCount");

        const status = document.getElementById("status");

        const sampleBtn = document.getElementById("sampleBtn");
        const copyBtn = document.getElementById("copyBtn");
        const clearBtn = document.getElementById("clearBtn");

        if (!input || !preview) return;

        function escapeHtml(value) {
          return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
        }

        function inlineMarkdown(text) {
          let value = escapeHtml(text);

          value = value.replace(
            /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
            '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
          );

          value = value.replace(
            /!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)/g,
            '<img src="$2" alt="$1" loading="lazy">'
          );

          value = value.replace(
            /`([^`]+)`/g,
            "<code>$1</code>"
          );

          value = value.replace(
            /\*\*([^*]+)\*\*/g,
            "<strong>$1</strong>"
          );

          value = value.replace(
            /__([^_]+)__/g,
            "<strong>$1</strong>"
          );

          value = value.replace(
            /\*([^*]+)\*/g,
            "<em>$1</em>"
          );

          value = value.replace(
            /_([^_]+)_/g,
            "<em>$1</em>"
          );

          value = value.replace(
            /~~([^~]+)~~/g,
            "<del>$1</del>"
          );

          return value;
        }

        function renderMarkdown(markdown) {
          if (!markdown.trim()) {
            return (
              '<div class="empty-preview">' +
                '<i class="fa-brands fa-markdown"></i>' +
                '<h3>المعاينة ستظهر هنا</h3>' +
                '<p>ابدأ بكتابة Markdown في المحرر.</p>' +
              '</div>'
            );
          }

          const lines = markdown.split(/\r?\n/u);
          let html = "";
          let inCode = false;
          let codeBuffer = [];
          let inUl = false;
          let inOl = false;
          let inQuote = false;

          function closeLists() {
            if (inUl) {
              html += "</ul>";
              inUl = false;
            }

            if (inOl) {
              html += "</ol>";
              inOl = false;
            }
          }

          function closeQuote() {
            if (inQuote) {
              html += "</blockquote>";
              inQuote = false;
            }
          }

          function flushCode() {
            if (codeBuffer.length) {
              html +=
                "<pre><code>" +
                escapeHtml(codeBuffer.join("\n")) +
                "</code></pre>";

              codeBuffer = [];
            }
          }

          for (let i = 0; i < lines.length; i++) {
            const line = lines[i];

            if (line.trim().startsWith("```")) {
              closeLists();
              closeQuote();

              if (inCode) {
                flushCode();
                inCode = false;
              } else {
                inCode = true;
              }

              continue;
            }

            if (inCode) {
              codeBuffer.push(line);
              continue;
            }

            if (/^#{1,6}\s+/u.test(line)) {
              closeLists();
              closeQuote();

              const match = line.match(/^(#{1,6})\s+(.+)$/u);

              if (match) {
                const level = match[1].length;

                html +=
                  "<h" +
                  level +
                  ">" +
                  inlineMarkdown(match[2]) +
                  "</h" +
                  level +
                  ">";
              }

              continue;
            }

            if (/^>\s?/u.test(line)) {
              closeLists();

              if (!inQuote) {
                html += "<blockquote>";
                inQuote = true;
              }

              html +=
                "<p>" +
                inlineMarkdown(line.replace(/^>\s?/u, "")) +
                "</p>";

              continue;
            }

            if (/^[-*+]\s+/u.test(line)) {
              closeQuote();

              if (!inUl) {
                closeLists();
                html += "<ul>";
                inUl = true;
              }

              html +=
                "<li>" +
                inlineMarkdown(line.replace(/^[-*+]\s+/u, "")) +
                "</li>";

              continue;
            }

            if (/^\d+\.\s+/u.test(line)) {
              closeQuote();

              if (!inOl) {
                closeLists();
                html += "<ol>";
                inOl = true;
              }

              html +=
                "<li>" +
                inlineMarkdown(line.replace(/^\d+\.\s+/u, "")) +
                "</li>";

              continue;
            }

            closeLists();
            closeQuote();

            if (!line.trim()) {
              continue;
            }

            if (i + 1 < lines.length && /^[-=]{3,}$/u.test(lines[i + 1])) {
              html +=
                "<h2>" +
                inlineMarkdown(line) +
                "</h2>";

              i++;
              continue;
            }

            if (line.includes("|")) {
              const cells = line
                .split("|")
                .map(function(cell) {
                  return cell.trim();
                })
                .filter(function(cell, index, array) {
                  return !(index === 0 && cell === "") &&
                    !(index === array.length - 1 && cell === "");
                });

              const next = lines[i + 1] || "";

              if (
                cells.length > 0 &&
                /\|/.test(next) &&
                /^[\s|:-]+$/u.test(next)
              ) {
                html += "<table><thead><tr>";

                for (let c = 0; c < cells.length; c++) {
                  html +=
                    "<th>" +
                    inlineMarkdown(cells[c]) +
                    "</th>";
                }

                html += "</tr></thead><tbody>";

                i += 2;

                while (
                  i < lines.length &&
                  lines[i].includes("|") &&
                  lines[i].trim() !== ""
                ) {
                  const rowCells = lines[i]
                    .split("|")
                    .map(function(cell) {
                      return cell.trim();
                    })
                    .filter(function(cell, index, array) {
                      return !(index === 0 && cell === "") &&
                        !(index === array.length - 1 && cell === "");
                    });

                  html += "<tr>";

                  for (let r = 0; r < rowCells.length; r++) {
                    html +=
                      "<td>" +
                      inlineMarkdown(rowCells[r]) +
                      "</td>";
                  }

                  html += "</tr>";
                  i++;
                }

                html += "</tbody></table>";
                i--;
                continue;
              }
            }

            if (/^---+$/u.test(line)) {
              html += "<hr>";
              continue;
            }

            html +=
              "<p>" +
              inlineMarkdown(line) +
              "</p>";
          }

          if (inCode) {
            flushCode();
          }

          closeLists();
          closeQuote();

          return html;
        }

        function updateStats() {
          const text = input.value || "";
          const words = text.trim()
            ? text.trim().split(/\s+/u).length
            : 0;

          const chars = text.length;

          editorStats.textContent =
            words.toLocaleString("ar") + " كلمة";

          previewWords.textContent =
            words.toLocaleString("ar") + " كلمة";

          charCount.textContent =
            chars.toLocaleString("ar") + " حرف";

          preview.innerHTML = renderMarkdown(text);

          if (!text.trim()) {
            status.innerHTML =
              '<i class="fa-solid fa-circle-info"></i>' +
              ' ابدأ بكتابة Markdown لعرض المعاينة.';
          } else {
            status.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>' +
              ' تمت المعاينة بنجاح داخل المتصفح.';
          }
        }

        function insertAtCursor(value) {
          const start = input.selectionStart;
          const end = input.selectionEnd;

          const before = input.value.substring(0, start);
          const after = input.value.substring(end);

          input.value = before + value + after;

          const position = start + value.length;

          input.focus();
          input.setSelectionRange(position, position);

          updateStats();
        }

        function wrapSelection(wrapper) {
          const start = input.selectionStart;
          const end = input.selectionEnd;

          const selected = input.value.substring(start, end);

          if (!selected) {
            insertAtCursor(wrapper + wrapper);
            input.setSelectionRange(
              start + wrapper.length,
              start + wrapper.length
            );
            return;
          }

          const replacement =
            wrapper + selected + wrapper;

          input.value =
            input.value.substring(0, start) +
            replacement +
            input.value.substring(end);

          input.focus();

          input.setSelectionRange(
            start + replacement.length,
            start + replacement.length
          );

          updateStats();
        }

        const toolbarButtons =
          document.querySelectorAll(".tool-btn");

        toolbarButtons.forEach(function(button) {
          button.addEventListener("click", function() {
            const wrapper = button.getAttribute("data-wrap");
            const insert = button.getAttribute("data-insert");
            const link = button.getAttribute("data-link");

            if (wrapper) {
              wrapSelection(wrapper);
              return;
            }

            if (insert) {
              insertAtCursor(insert);
              return;
            }

            if (link) {
              const start = input.selectionStart;
              const end = input.selectionEnd;

              const selected =
                input.value.substring(start, end) || "رابط";

              const value =
                "[" +
                selected +
                "](https://example.com)";

              input.value =
                input.value.substring(0, start) +
                value +
                input.value.substring(end);

              input.focus();
              updateStats();
            }
          });
        });

        input.addEventListener("input", updateStats);

        sampleBtn.addEventListener("click", function() {
          input.value =
            "# مرحباً بك في Th.Tech\n\n" +
            "هذه **معاينة Markdown** احترافية.\n\n" +
            "## المميزات\n\n" +
            "- كتابة Markdown\n" +
            "- معاينة مباشرة\n" +
            "- دعم الأكواد\n" +
            "- دعم الروابط\n\n" +
            "> أدوات تقنية مجانية وسهلة الاستخدام.\n\n" +
            "### مثال على الكود\n\n" +
            "```js\n" +
            "const message = \"Hello World\";\n" +
            "console.log(message);\n" +
            "```\n\n" +
            "[زيارة Th.Tech](https://oumaystore-hub.github.io/Th-tech/)";

          updateStats();
          input.focus();
        });

        clearBtn.addEventListener("click", function() {
          input.value = "";
          updateStats();
          input.focus();
        });

        copyBtn.addEventListener("click", async function() {
          const text = input.value;

          if (!text.trim()) {
            status.innerHTML =
              '<i class="fa-solid fa-triangle-exclamation"></i>' +
              ' لا يوجد Markdown لنسخه.';
            return;
          }

          try {
            await navigator.clipboard.writeText(text);

            status.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>' +
              ' تم نسخ Markdown بنجاح.';
          } catch {
            input.select();
            document.execCommand("copy");

            status.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>' +
              ' تم نسخ Markdown بنجاح.';
          }
        });

        input.addEventListener("keydown", function(event) {
          if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
            updateStats();
          }
        });

        function syncTheme() {
          try {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function(event) {
          const target = event.target;

          if (
            target &&
            (
              target.id === "theme-btn" ||
              target.closest("#theme-btn")
            )
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        updateStats();
      })();
    </script>

    <style>
      :root {
        --bg: #f5f9ff;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --text: #102033;
        --muted: #64748b;
        --border: #dce7f3;
        --primary: #2563eb;
        --cyan: #06b6d4;
        --danger: #ef4444;
        --success: #10b981;
        --code: #eef4fb;
        --shadow: 0 18px 50px rgba(37, 99, 235, 0.08);
      }

      html.dark-mode {
        --bg: #07111f;
        --surface: #0d1b2a;
        --surface-2: #101f31;
        --text: #e8f1fb;
        --muted: #91a4b9;
        --border: #20364c;
        --primary: #60a5fa;
        --cyan: #22d3ee;
        --danger: #f87171;
        --success: #34d399;
        --code: #081522;
        --shadow: 0 18px 50px rgba(0, 0, 0, 0.25);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at top right,
            rgba(37, 99, 235, 0.08),
            transparent 32%
