        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .danger {
        color: var(--danger);
        background: rgba(239, 68, 68, 0.09);
      }

      .status {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 11px 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 12px;
      }

      .status i {
        color: var(--primary);
