        line-height: 1.9;
        font-size: 12px;
      }

      @media (max-width: 850px) {
        .editor-grid {
          grid-template-columns: 1fr;
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .page {
          padding: 20px 12px 55px;
        }

        .hero {
          align-items: flex-start;
        }

        .hero-icon {
          width: 62px;
          height: 62px;
          flex-basis: 62px;
          border-radius: 18px;
          font-size: 25px;
        }

        .hero h1 {
          font-size: 30px;
        }

        .tool-card {
          padding: 17px;
          border-radius: 19px;
        }

        .tool-header {
          flex-direction: column;
        }

        .toolbar {
          gap: 6px;
        }

        .tool-btn {
          padding: 7px 9px;
        }

        textarea,
        .markdown-body {
          min-height: 330px;
        }

        .actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .actions .primary-btn {
          grid-column: span 2;
          order: -1;
        }

        .privacy-card {
          align-items: flex-start;
        }

        .section-title.centered {
          justify-content: flex-start;
        }
      }

      @media (max-width: 390px) {
        .actions {
          grid-template-columns: 1fr;
        }

        .actions .primary-btn {
          grid-column: auto;
        }

        .tool-btn {
          flex: 1 1 auto;
        }
      }
    </style>
  </body>
</html>
