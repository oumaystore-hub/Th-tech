        40px;
    }


    .hero-icon span {

      font:
        700 13px
        "JetBrains Mono",
        monospace;
    }


    .badge {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        7px 13px;

      border-radius:
        999px;

      background:
        rgba(124, 58, 237, 0.10);

      color:
        var(--primary);

      font-size:
        12px;

      font-weight:
        700;
    }


    h1 {

      margin:
        12px 0 8px;

      font-size:
        clamp(
          32px,
          5vw,
          52px
        );

      line-height:
        1.1;
    }


    .hero-text p {

      margin:
        0;

      max-width:
        700px;

      color:
        var(--muted);

      font-size:
        16px;

      line-height:
        1.9;
    }


    .tags {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        8px;

      margin-top:
        17px;
    }


    .tags span {

      padding:
        5px 10px;

      border:
        1px solid
        var(--border);

      border-radius:
        8px;

      color:
        var(--muted);

      background:
        var(--surface);

      font:
        500 11px
        "JetBrains Mono",
        monospace;
    }


    /* TOOL */

    .tool-section {

      padding-bottom:
        70px;
    }


    .generator-card {

      overflow:
        hidden;

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      border-radius:
        22px;

      box-shadow:
        var(--shadow);
    }


    .card-topbar {

      min-height:
        55px;

      padding:
        0 20px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      border-bottom:
        1px solid
        var(--border);

      background:
        var(--surface-2);
    }


    .window-dots {

      display:
        flex;

      gap:
        6px;
    }


    .window-dots span {

      width:
        9px;

      height:
        9px;

      border-radius:
        50%;

      background:
        var(--border);
    }


    .tool-name {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--text);

      font:
        600 13px
        "JetBrains Mono",
        monospace;
    }


    .tool-name i {

      color:
        var(--primary);
    }


    .secure {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      color:
        var(--success);

      font-size:
        11px;

      font-weight:
        700;
    }


    /* ACTIONBAR */

    .actionbar {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        9px;

      padding:
        15px 18px;

      border-bottom:
        1px solid
        var(--border);
    }


    .btn {

      border:
        1px solid
        var(--border);

      border-radius:
        10px;

      padding:
        10px 15px;

      font-family:
        "Cairo",
        sans-serif;

      font-size:
        12px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        0.2s;
    }


    .btn:hover {

      transform:
        translateY(-1px);
    }


    .btn i {

      margin-left:
        6px;
    }


    .btn-secondary {

      color:
        var(--text);

      background:
        var(--surface-2);
    }


    .btn-primary {

      color:
        white;

      background:
        var(--primary);

      border-color:
        var(--primary);
    }


    .btn-primary:hover {

      background:
        var(--primary-dark);
    }


    .btn:disabled {

      opacity:
        0.65;

      cursor:
        wait;
    }


    /* EDITOR */

    .editor-section,
    .output-section {

      margin:
        20px;

      overflow:
        hidden;

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .editor-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        11px 14px;

      border-bottom:
        1px solid
        var(--border);

      color:
        var(--muted);

      font-size:
        12px;

      font-weight:
        700;
    }


    .editor-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--text);
    }


    .editor-header i {

      color:
        var(--primary);
    }


    .editor-header span {

      font:
        10px
        "JetBrains Mono",
        monospace;
    }


    #textInput {

      width:
        100%;

      min-height:
        150px;

      display:
        block;

      resize:
        vertical;

      padding:
        18px;

      border:
        0;

      outline:
        0;

      background:
        transparent;

      color:
        var(--text);

      direction:
        rtl;

      text-align:
        right;

      font:
        13px/1.9
        "Cairo",
        sans-serif;
    }


    #textInput::placeholder {

      color:
        var(--muted);

      opacity:
        0.65;
    }


    /* RESULT */

    .result-box {

      margin:
        0 20px 15px;

      display:
        flex;

      align-items:
        center;

      gap:
        14px;

      padding:
        15px 17px;

      border:
        1px solid
        var(--border);

      border-radius:
        14px;

      background:
        var(--surface-2);
    }


    .result-icon {

      width:
        42px;

      height:
        42px;

      flex:
        0 0 42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      background:
        rgba(124, 58, 237, 0.10);

      color:
        var(--primary);

      font-size:
        17px;
    }


    .result-box strong {

      display:
        block;

      font-size:
        13px;
    }


    .result-box p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.7;
    }


    .result-box.success {

      border-color:
        rgba(22, 163, 74, 0.25);
    }


    .result-box.success .result-icon {

      color:
        var(--success);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .result-box.error {

      border-color:
        rgba(220, 38, 38, 0.25);
    }


    .result-box.error .result-icon {

      color:
        var(--danger);

      background:
        rgba(220, 38, 38, 0.10);
    }


    /* OUTPUT */

    .hash-output {

      min-height:
        110px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      padding:
        20px;

      overflow:
        auto;

      direction:
        ltr;

      text-align:
        center;

      word-break:
        break-all;

      color:
        var(--primary);

      font:
        600 20px/1.7
        "JetBrains Mono",
        monospace;
    }


    .copy-output {

      margin:
        0 14px 14px;

      padding:
        8px 12px;

      border:
        1px solid
        var(--border);

      border-radius:
        8px;

      background:
        var(--surface);

      color:
        var(--muted);

      font:
        10px
        "Cairo",
        sans-serif;

      cursor:
        pointer;
    }


    .copy-output:hover {

      color:
        var(--primary);
    }


    .copy-output i {

      margin-left:
        5px;
    }


    /* STATS */

    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        12px;

      padding:
        0 20px 20px;
    }


    .stat {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      min-width:
        0;

      padding:
        14px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface-2);
    }


    .stat-icon {

      width:
        36px;

      height:
        36px;

      flex:
        0 0 36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        9px;

      color:
        var(--primary);

      background:
        rgba(124, 58, 237, 0.10);
    }


    .stat span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        9px;
    }


    .stat strong {

      display:
        block;

      max-width:
        150px;

      overflow:
        hidden;

      margin-top:
        2px;

      color:
        var(--text);

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    /* SECURITY */

    .security-note {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        12px;

      margin:
        0 20px 20px;

      padding:
        15px;

      border:
        1px solid
        rgba(22, 163, 74, 0.20);

      border-radius:
        13px;

      background:
        rgba(22, 163, 74, 0.06);
    }


    .security-icon {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      color:
        var(--success);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .security-note strong {

      display:
        block;

      font-size:
        12px;
    }


    .security-note p {

      margin:
        4px 0 0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.8;
    }


    /* SECTIONS */

    .info-section,
    .how-section,
    .faq-section {

      padding:
        70px 0;
    }


    .info-section {

      background:
        var(--surface-2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);
    }


    .section-heading {

      max-width:
        700px;

      margin:
        0 auto 35px;

      text-align:
        center;
    }


    .section-heading > span {

      color:
        var(--primary);

      font:
        700 11px
        "JetBrains Mono",
        monospace;

      letter-spacing:
        1px;
    }


    .section-heading h2 {

      margin:
        8px 0;

      font-size:
        clamp(
          25px,
          4vw,
          34px
        );
    }


    .section-heading p {

      margin:
        0;

      color:
        var(--muted);

      line-height:
        1.9;

      font-size:
        14px;
    }


    .info-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .info-card {

      padding:
        25px;

      border:
        1px solid
        var(--border);

      border-radius:
        17px;

      background:
        var(--surface);
    }


    .info-icon {

      width:
        48px;

      height:
        48px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        17px;

      border-radius:
        13px;

      color:
        var(--primary);

      background:
        rgba(124, 58, 237, 0.10);
    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size:
        16px;
    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        13px;

      line-height:
        1.9;
    }


    /* STEPS */

    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .step {

      display:
        flex;

      gap:
        15px;

      padding:
        22px;

      border:
        1px solid
        var(--border);

      border-radius:
        16px;

      background:
        var(--surface);
    }


    .step-number {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      color:
        white;

      background:
        var(--primary);

      font-weight:
        800;
    }


    .step h3 {

      margin:
        0 0 5px;

      font-size:
        14px;
    }


    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.8;
    }


    /* FAQ */

    .faq-list {

      max-width:
        850px;

      margin:
        auto;
    }


    details {

      margin-bottom:
        10px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface);

      overflow:
        hidden;
    }


    summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        17px 19px;

      cursor:
        pointer;

      font-size:
        13px;

      font-weight:
        700;

      list-style:
        none;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {

      color:
        var(--primary);

      transition:
        transform 0.2s;
    }


    details[open] summary i {

      transform:
        rotate(180deg);
    }


    details p {

      margin:
        0;

      padding:
        0 19px 18px;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 850px) {

      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }
    }


    @media (max-width: 600px) {

      .container {

        width:
          min(
            100% - 22px,
            1180px
          );
      }


      .hero {

        padding-top:
          25px;
      }


      .hero-content {

        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .hero-icon {

        width:
          88px;

        height:
          88px;

        flex-basis:
          88px;

        border-radius:
          23px;
      }


      .hero-icon i {

        font-size:
          31px;
      }


      .card-topbar {

        padding:
          0 13px;
      }


      .actionbar {

        padding:
          12px;
      }


      .btn {

        flex:
          1 1
          calc(50% - 8px);

        padding:
          9px 8px;
      }


      .editor-section,
      .output-section {

        margin:
          12px;
      }


      #textInput {

        min-height:
          140px;

        padding:
          14px;

        font-size:
          12px;
      }


      .result-box {

        margin:
          0 12px 12px;
      }


      .hash-output {

        min-height:
          100px;

        padding:
          15px;

        font-size:
          14px;
      }


      .stats-grid {

        padding:
          0 12px 12px;

        gap:
          8px;
      }


      .stat {

        padding:
          11px 9px;
      }


      .stat-icon {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;
      }


      .stat span {

        font-size:
          8px;
      }


      .stat strong {

        max-width:
          100px;

        font-size:
          9px;
      }


      .security-note {

        margin:
          0 12px 12px;

        padding:
          12px;
      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;
      }

    }

  </style>

</body>
</html>
