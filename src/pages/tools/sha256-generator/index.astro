---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SHA-256 Generator - إنشاء SHA-256 Hash أونلاين مجاناً | Th.Tech";

const description =
  "أداة SHA-256 Generator مجانية لإنشاء SHA-256 Hash من أي نص مباشرة داخل المتصفح، مع إمكانية النسخ والمسح واستخدام أمثلة جاهزة.";

const faqs = [
  {
    q: "ما هو SHA-256؟",
    a: "SHA-256 هي خوارزمية Hash تشفيرية تنتج قيمة بطول 256 بت، وتظهر عادةً كسلسلة hexadecimal مكونة من 64 حرفاً."
  },
  {
    q: "هل SHA-256 تشفير؟",
    a: "لا. SHA-256 هي دالة Hash أحادية الاتجاه وليست تشفيراً. تستخدم للتحقق من سلامة البيانات وإنشاء بصمات رقمية."
  },
  {
    q: "هل يتم إرسال النص إلى الخادم؟",
    a: "لا. يتم إنشاء SHA-256 بالكامل داخل المتصفح باستخدام Web Crypto API، ولا يتم إرسال النص إلى خادم خارجي."
  },
  {
    q: "هل SHA-256 مناسبة لكلمات المرور؟",
    a: "SHA-256 أقوى بكثير من MD5، لكنها ليست الخيار المناسب وحدها لتخزين كلمات المرور. يفضل استخدام خوارزميات مخصصة لكلمات المرور مثل Argon2 أو bcrypt أو scrypt."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/sha256-generator/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>SHA-256 Generator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-fingerprint"></i>
            <span>SHA-256</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>SHA-256 Generator</h1>

            <p>
              أنشئ SHA-256 Hash من أي نص بسرعة وسهولة
              مباشرة من المتصفح.
            </p>

            <div class="tags">
              <span>SHA-256</span>
              <span>Hash</span>
              <span>256-bit</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="generator-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-fingerprint"></i>
              SHA-256 Generator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary" type="button">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary" type="button">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary" type="button">
              <i class="fa-regular fa-copy"></i>
              نسخ Hash
            </button>

            <button id="generateBtn" class="btn btn-primary" type="button">
              <i class="fa-solid fa-fingerprint"></i>
              إنشاء SHA-256
            </button>

          </div>


          <!-- INPUT -->
          <div class="editor-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-pen"></i>
                Input
              </div>

              <span id="inputCount">0 حرف</span>

            </div>

            <textarea
              id="textInput"
              spellcheck="false"
              placeholder="اكتب النص الذي تريد إنشاء SHA-256 Hash له..."
            ></textarea>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز لإنشاء Hash
              </strong>

              <p id="resultMessage">
                أدخل نصاً ثم اضغط على إنشاء SHA-256.
              </p>

            </div>

          </div>


          <!-- OUTPUT -->
          <div class="output-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-hashtag"></i>
                SHA-256 Hash
              </div>

              <span>64 HEX</span>

            </div>

            <div class="hash-output" id="hashOutput">
              —
            </div>

            <button id="outputCopyBtn" class="copy-output" type="button">
              <i class="fa-regular fa-copy"></i>
              نسخ Hash
            </button>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>الأحرف</span>
                <strong id="statChars">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-database"></i>
              </div>

              <div>
                <span>Bytes</span>
                <strong id="statBytes">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-fingerprint"></i>
              </div>

              <div>
                <span>Hash Length</span>
                <strong id="statHashLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>


          <!-- SECURITY NOTE -->
          <div class="security-note">

            <div class="security-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
              <strong>ملاحظة أمنية</strong>

              <p>
                SHA-256 خوارزمية Hash قوية ومستخدمة على نطاق واسع
                للتحقق من سلامة البيانات وإنشاء البصمات الرقمية.
                لتخزين كلمات المرور استخدم خوارزميات مخصصة مثل
                Argon2 أو bcrypt أو scrypt.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>SHA-256 GENERATOR</span>

          <h2>
            ما هو SHA-256 Generator؟
          </h2>

          <p>
            أداة تساعد المطورين على إنشاء SHA-256 Hash
            من النصوص مباشرة داخل المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-fingerprint"></i>
            </div>

            <h3>
              Hash بطول 256-bit
            </h3>

            <p>
              ينتج SHA-256 قيمة Hash بطول 256 بت تظهر عادةً
              على شكل 64 حرفاً بنظام hexadecimal.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-laptop-code"></i>
            </div>

            <h3>
              يعمل محلياً
            </h3>

            <p>
              تتم عملية إنشاء Hash داخل المتصفح باستخدام
              Web Crypto API ولا يحتاج النص إلى الإرسال للخادم.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>
              سريع وسهل
            </h3>

            <p>
              أدخل النص واضغط على إنشاء SHA-256 للحصول
              على النتيجة فوراً.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام SHA-256 Generator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل النص
              </h3>

              <p>
                اكتب أو الصق النص الذي تريد تحويله
                إلى SHA-256 Hash.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                أنشئ Hash
              </h3>

              <p>
                اضغط على زر إنشاء SHA-256 لمعالجة النص
                مباشرة داخل المتصفح.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                انسخ النتيجة
              </h3>

              <p>
                انسخ SHA-256 Hash الناتج واستخدمه
                في مشروعك.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>


  <Footer />


  <!-- SHA-256 + THEME -->
  <script is:inline>
    (() => {

      /*
       * Theme synchronization
       *
       * يحافظ على توافق الصفحة مع Header
       * ويجعل التغيير فورياً بدون Refresh.
       */

      const root =
        document.documentElement;


      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");


          if (saved === "dark") {

            root.classList.add(
              "dark-mode"
            );

          } else {

            root.classList.remove(
              "dark-mode"
            );
          }

        } catch {}
      }


      syncTheme();


      window.addEventListener(
        "themeChange",
        syncTheme
      );


      document.addEventListener(
        "click",
        (event) => {

          const target =
            event.target;

          if (
            !(target instanceof Element)
          ) {
            return;
          }


          const button =
            target.closest(
              "#theme-btn"
            );


          if (button) {

            setTimeout(
              syncTheme,
              0
            );
          }

        }
      );


      const observer =
        new MutationObserver(() => {

          try {

            const saved =
              localStorage.getItem(
                "theme"
              );


            if (saved === "dark") {

              if (
                !root.classList.contains(
                  "dark-mode"
                )
              ) {

                root.classList.add(
                  "dark-mode"
                );
              }

            } else {

              if (
                root.classList.contains(
                  "dark-mode"
                )
              ) {

                root.classList.remove(
                  "dark-mode"
                );
              }

            }

          } catch {}

        });


      observer.observe(
        root,
        {
          attributes: true,
          attributeFilter: ["class"]
        }
      );

    })();
  </script>


  <!-- TOOL SCRIPT -->
  <script is:inline>
    (() => {

      const input =
        document.getElementById(
          "textInput"
        );

      const generateBtn =
        document.getElementById(
          "generateBtn"
        );

      const exampleBtn =
        document.getElementById(
          "exampleBtn"
        );

      const clearBtn =
        document.getElementById(
          "clearBtn"
        );

      const copyBtn =
        document.getElementById(
          "copyBtn"
        );

      const outputCopyBtn =
        document.getElementById(
          "outputCopyBtn"
        );

      const inputCount =
        document.getElementById(
          "inputCount"
        );

      const hashOutput =
        document.getElementById(
          "hashOutput"
        );

      const resultBox =
        document.getElementById(
          "resultBox"
        );

      const resultIcon =
        document.getElementById(
          "resultIcon"
        );

      const resultTitle =
        document.getElementById(
          "resultTitle"
        );

      const resultMessage =
        document.getElementById(
          "resultMessage"
        );

      const statChars =
        document.getElementById(
          "statChars"
        );

      const statBytes =
        document.getElementById(
          "statBytes"
        );

      const statHashLength =
        document.getElementById(
          "statHashLength"
        );

      const statStatus =
        document.getElementById(
          "statStatus"
        );


      if (
        !input ||
        !generateBtn ||
        !exampleBtn ||
        !clearBtn ||
        !copyBtn ||
        !outputCopyBtn
      ) {
        return;
      }


      let currentHash = "";


      function updateStats() {

        const text =
          input.value;


        const chars =
          text.length;


        const bytes =
          new TextEncoder()
            .encode(text)
            .length;


        inputCount.textContent =
          `${chars.toLocaleString()} حرف`;


        statChars.textContent =
          chars.toLocaleString();


        statBytes.textContent =
          bytes.toLocaleString();
      }


      function showReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';


        resultTitle.textContent =
          "جاهز لإنشاء Hash";


        resultMessage.textContent =
          "أدخل نصاً ثم اضغط على إنشاء SHA-256.";


        statStatus.textContent =
          "جاهز";
      }


      function showSuccess(message) {

        resultBox.classList.remove(
          "error"
        );


        resultBox.classList.add(
          "success"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';


        resultTitle.textContent =
          "تم إنشاء SHA-256 بنجاح";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "تم الإنشاء";
      }


      function showError(message) {

        resultBox.classList.remove(
          "success"
        );


        resultBox.classList.add(
          "error"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';


        resultTitle.textContent =
          "تعذر إنشاء Hash";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "خطأ";
      }


      function resetOutput() {

        currentHash = "";


        hashOutput.textContent =
          "—";


        statHashLength.textContent =
          "0";
      }


      async function sha256(text) {

        const encoder =
          new TextEncoder();


        const data =
          encoder.encode(text);


        const hashBuffer =
          await crypto.subtle.digest(
            "SHA-256",
            data
          );


        const hashArray =
          Array.from(
            new Uint8Array(
              hashBuffer
            )
          );


        return hashArray
          .map(
            byte =>
              byte
                .toString(16)
                .padStart(2, "0")
          )
          .join("");
      }


      async function generateHash() {

        const text =
          input.value;


        updateStats();


        if (!text) {

          resetOutput();


          showError(
            "أدخل نصاً أولاً لإنشاء SHA-256 Hash."
          );


          return;
        }


        generateBtn.disabled =
          true;


        const originalButton =
          generateBtn.innerHTML;


        generateBtn.innerHTML =
          '<i class="fa-solid fa-spinner fa-spin"></i> إنشاء...';


        try {

          currentHash =
            await sha256(text);


          hashOutput.textContent =
            currentHash;


          statHashLength.textContent =
            currentHash.length;


          showSuccess(
            "تم إنشاء SHA-256 Hash داخل المتصفح بنجاح."
          );

        } catch (error) {

          console.error(error);


          resetOutput();


          showError(
            "حدث خطأ أثناء إنشاء SHA-256 Hash."
          );

        } finally {

          generateBtn.disabled =
            false;


          generateBtn.innerHTML =
            originalButton;
        }
      }


      function loadExample() {

        input.value =
          "Hello, World!";


        updateStats();


        generateHash();
      }


      function clearAll() {

        input.value =
          "";


        updateStats();


        resetOutput();


        showReady();


        input.focus();
      }


      async function copyHash(button) {

        if (!currentHash) {

          showError(
            "لا توجد نتيجة SHA-256 لنسخها."
          );


          return;
        }


        try {

          await navigator.clipboard.writeText(
            currentHash
          );


          const original =
            button.innerHTML;


          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            button.innerHTML =
              original;

          }, 1500);

        } catch {

          const temp =
            document.createElement(
              "textarea"
            );


          temp.value =
            currentHash;


          document.body.appendChild(
            temp
          );


          temp.select();


          document.execCommand(
            "copy"
          );


          temp.remove();


          const original =
            button.innerHTML;


          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            button.innerHTML =
              original;

          }, 1500);
        }
      }


      input.addEventListener(
        "input",
        updateStats
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            generateHash();
          }

        }
      );


      generateBtn.addEventListener(
        "click",
        generateHash
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        () => {
          copyHash(copyBtn);
        }
      );


      outputCopyBtn.addEventListener(
        "click",
        () => {
          copyHash(outputCopyBtn);
        }
      );


      updateStats();


      resetOutput();

    })();
  </script>


  <style>

    :root {

      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f8fafc;

      --text: #172033;
      --muted: #718096;

