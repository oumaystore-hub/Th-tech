---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>SHA-256 Generator - إنشاء SHA-256 أونلاين مجاناً | Th.Tech</title>

  <meta
    name="description"
    content="أنشئ SHA-256 Hash لأي نص بسهولة ومجاناً. أداة SHA-256 تعمل محلياً داخل المتصفح بدون إرسال بياناتك إلى الخادم."
  />

  <meta
    name="keywords"
    content="SHA-256, SHA256, SHA-256 Generator, Hash Generator, تشفير SHA256, مولد Hash"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/sha-256-generator/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>SHA-256 Generator</span>
        </div>

        <div class="hero-content">
          <div class="tool-icon">
            <i class="fa-solid fa-fingerprint"></i>
          </div>

          <div class="hero-text">
            <div class="badge">
              <i class="fa-solid fa-bolt"></i>
              أداة مجانية
            </div>

            <h1>SHA-256 Generator</h1>

            <p>
              أنشئ Hash من نوع SHA-256 لأي نص بسرعة وأمان، مباشرة داخل متصفحك
              وبدون إرسال بياناتك إلى أي خادم.
            </p>

            <div class="tags">
              <span>SHA-256</span>
              <span>Hash</span>
              <span>Secure</span>
              <span>Local</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">
        <div class="tool-card">

          <div class="window-bar">
            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="window-title">
              <i class="fa-solid fa-fingerprint"></i>
              SHA-256 Generator
            </div>

            <div class="local-badge">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>
          </div>

          <!-- ACTION BAR -->
          <div class="action-bar">
            <button id="exampleBtn" class="action-btn">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="action-btn">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

            <button id="generateBtn" class="action-btn primary">
              <i class="fa-solid fa-fingerprint"></i>
              إنشاء SHA-256
            </button>
          </div>

          <!-- INPUT -->
          <div class="editor-area">
            <div class="editor-header">
              <div>
                <i class="fa-solid fa-keyboard"></i>
                النص المراد تحويله
              </div>

              <span id="charCount">0 حرف</span>
            </div>

            <textarea
              id="inputText"
              spellcheck="false"
              placeholder="اكتب النص الذي تريد إنشاء SHA-256 له..."
            ></textarea>
          </div>

          <!-- RESULT -->
          <div class="result-area">
            <div class="result-header">
              <div>
                <i class="fa-solid fa-hashtag"></i>
                SHA-256 Hash
              </div>

              <button id="copyBtn" class="copy-btn" disabled>
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>
            </div>

            <div id="resultBox" class="result-box empty">
              <span id="resultText">
                سيظهر SHA-256 Hash هنا...
              </span>
            </div>
          </div>

          <!-- STATUS -->
          <div id="statusMessage" class="status-message"></div>

          <!-- INFO STATS -->
          <div class="stats">
            <div class="stat">
              <i class="fa-solid fa-ruler-horizontal"></i>
              <div>
                <strong>256-bit</strong>
                <span>طول الهاش</span>
              </div>
            </div>

            <div class="stat">
              <i class="fa-solid fa-font"></i>
              <div>
                <strong>64</strong>
                <span>Hex Characters</span>
              </div>
            </div>

            <div class="stat">
              <i class="fa-solid fa-lock"></i>
              <div>
                <strong>Local</strong>
                <span>المعالجة</span>
              </div>
            </div>

            <div class="stat">
              <i class="fa-solid fa-server"></i>
              <div>
                <strong>0</strong>
                <span>رفع البيانات</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- INFORMATION -->
    <section class="info-section">
      <div class="container">

        <div class="info-grid">

          <article class="info-card">
            <div class="info-icon">
              <i class="fa-solid fa-circle-info"></i>
            </div>

            <h2>ما هو SHA-256؟</h2>

            <p>
              SHA-256 هو خوارزمية Hash من عائلة SHA-2 تقوم بتحويل البيانات
              مهما كان حجمها إلى قيمة ثابتة بطول 256 بت، أي 64 حرفاً بالنظام
              السداسي عشري.
            </p>

            <p>
              تختلف دالة Hash عن التشفير التقليدي؛ فالـ Hash مصمم ليكون
              أحادي الاتجاه، ولذلك لا يمكن عملياً إعادة النص الأصلي من قيمة
              SHA-256 وحدها.
            </p>
          </article>

          <article class="info-card">
            <div class="info-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h2>هل بياناتي آمنة؟</h2>

            <p>
              نعم. هذه الأداة تستخدم Web Crypto API المتوفرة في المتصفح
              لإنشاء SHA-256 مباشرة على جهازك.
            </p>

            <p>
              لا يتم إرسال النص الذي تدخله إلى خادم خارجي أثناء عملية إنشاء
              الـ Hash.
            </p>
          </article>

        </div>

        <!-- HOW TO -->
        <article class="how-to">
          <div class="section-heading">
            <span class="section-number">01</span>

            <div>
              <h2>كيفية استخدام SHA-256 Generator</h2>
              <p>أنشئ Hash في ثلاث خطوات بسيطة.</p>
            </div>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>
              <div>
                <h3>أدخل النص</h3>
                <p>
                  اكتب أو الصق النص الذي تريد تحويله إلى SHA-256.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>
              <div>
                <h3>اضغط إنشاء SHA-256</h3>
                <p>
                  ستتم معالجة النص مباشرة باستخدام Web Crypto API.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>
              <div>
                <h3>انسخ النتيجة</h3>
                <p>
                  اضغط على زر النسخ لاستخدام قيمة الـ Hash في مشروعك.
                </p>
              </div>
            </div>

          </div>
        </article>

        <!-- FAQ -->
        <article class="faq">
          <div class="section-heading">
            <span class="section-number">02</span>

            <div>
              <h2>الأسئلة الشائعة</h2>
              <p>أهم الأسئلة حول SHA-256.</p>
            </div>
          </div>

          <div class="faq-list">

            <details>
              <summary>
                <span>هل يمكن فك SHA-256؟</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                SHA-256 دالة Hash أحادية الاتجاه وليست تشفيراً قابلاً للفك.
                لا توجد طريقة مباشرة لاستعادة النص الأصلي من الـ Hash.
              </p>
            </details>

            <details>
              <summary>
                <span>كم يبلغ طول SHA-256؟</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                ينتج SHA-256 قيمة بطول 256 بت، وتظهر عادةً على شكل 64 حرفاً
                بالنظام السداسي عشري.
              </p>
            </details>

            <details>
              <summary>
                <span>هل SHA-256 آمن؟</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                SHA-256 يعتبر خوارزمية Hash قوية ومستخدمة على نطاق واسع في
                التطبيقات الأمنية والتحقق من سلامة البيانات. ومع ذلك، اختيار
                الخوارزمية المناسبة يعتمد على حالة الاستخدام.
              </p>
            </details>

            <details>
              <summary>
                <span>هل يتم إرسال البيانات إلى الخادم؟</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                لا. عملية إنشاء SHA-256 في هذه الصفحة تتم محلياً داخل
                المتصفح باستخدام Web Crypto API.
              </p>
            </details>

          </div>
        </article>

      </div>
    </section>
  </main>

  <Footer />

  <script>
    const inputText = document.getElementById('inputText');
    const resultText = document.getElementById('resultText');
    const resultBox = document.getElementById('resultBox');
    const generateBtn = document.getElementById('generateBtn');
    const copyBtn = document.getElementById('copyBtn');
    const clearBtn = document.getElementById('clearBtn');
    const exampleBtn = document.getElementById('exampleBtn');
    const charCount = document.getElementById('charCount');
    const statusMessage = document.getElementById('statusMessage');

    let currentHash = '';

    function updateCharCount() {
      const length = inputText.value.length;
      charCount.textContent = `${length} حرف`;
    }

    function showStatus(message, type = 'success') {
      statusMessage.textContent = message;
      statusMessage.className = `status-message ${type}`;

      setTimeout(() => {
        statusMessage.textContent = '';
        statusMessage.className = 'status-message';
      }, 3000);
    }

    async function sha256(text) {
      const encoder = new TextEncoder();
      const data = encoder.encode(text);

      const hashBuffer = await crypto.subtle.digest(
        'SHA-256',
        data
      );

      const hashArray = Array.from(new Uint8Array(hashBuffer));

      return hashArray
        .map(byte => byte.toString(16).padStart(2, '0'))
        .join('');
    }

    async function generateHash() {
      const text = inputText.value;

      if (!text) {
        resultText.textContent = 'أدخل نصاً أولاً...';
        resultBox.classList.add('empty');
        copyBtn.disabled = true;
        currentHash = '';

        showStatus('يرجى إدخال النص أولاً.', 'error');
        inputText.focus();
        return;
      }

      generateBtn.disabled = true;
      generateBtn.innerHTML =
        '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإنشاء...';

      try {
        currentHash = await sha256(text);

        resultText.textContent = currentHash;
        resultBox.classList.remove('empty');

        copyBtn.disabled = false;

        showStatus(
          'تم إنشاء SHA-256 بنجاح.',
          'success'
        );
      } catch (error) {
        console.error(error);

        resultText.textContent =
          'حدث خطأ أثناء إنشاء SHA-256.';

        resultBox.classList.add('empty');
        copyBtn.disabled = true;
        currentHash = '';

        showStatus(
          'حدث خطأ أثناء معالجة النص.',
          'error'
        );
      } finally {
        generateBtn.disabled = false;
        generateBtn.innerHTML =
          '<i class="fa-solid fa-fingerprint"></i> إنشاء SHA-256';
      }
    }

    async function copyHash() {
      if (!currentHash) return;

      try {
        await navigator.clipboard.writeText(currentHash);

        copyBtn.innerHTML =
          '<i class="fa-solid fa-check"></i> تم النسخ';

        showStatus('تم نسخ SHA-256 إلى الحافظة.', 'success');

        setTimeout(() => {
          copyBtn.innerHTML =
            '<i class="fa-regular fa-copy"></i> نسخ';
        }, 1800);
      } catch (error) {
        const textarea = document.createElement('textarea');

        textarea.value = currentHash;
        document.body.appendChild(textarea);
        textarea.select();

        try {
          document.execCommand('copy');

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          showStatus(
            'تم نسخ SHA-256 إلى الحافظة.',
            'success'
          );
        } catch (e) {
          showStatus(
            'تعذر نسخ النتيجة تلقائياً.',
            'error'
          );
        }

        textarea.remove();

        setTimeout(() => {
          copyBtn.innerHTML =
            '<i class="fa-regular fa-copy"></i> نسخ';
        }, 1800);
      }
    }

    function clearTool() {
      inputText.value = '';
      currentHash = '';

      resultText.textContent =
        'سيظهر SHA-256 Hash هنا...';

      resultBox.classList.add('empty');
      copyBtn.disabled = true;

      updateCharCount();

      statusMessage.textContent = '';
      statusMessage.className = 'status-message';

      inputText.focus();
    }

    function loadExample() {
      inputText.value =
        'Hello, World! مرحباً بالعالم';

      updateCharCount();
      generateHash();
    }

    inputText.addEventListener('input', updateCharCount);

    inputText.addEventListener('keydown', event => {
      if (
        (event.ctrlKey || event.metaKey) &&
        event.key === 'Enter'
      ) {
        event.preventDefault();
        generateHash();
      }
    });

    generateBtn.addEventListener('click', generateHash);
    copyBtn.addEventListener('click', copyHash);
    clearBtn.addEventListener('click', clearTool);
    exampleBtn.addEventListener('click', loadExample);

    updateCharCount();
  </script>
</body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: 'Cairo', sans-serif;
    background: #f8fafc;
    color: #172033;
  }

  :global(html[data-theme='light'] body) {
    background: #f8fafc;
    color: #172033;
  }

  :global(html:not([data-theme='light']) body) {
    background: #0b1120;
    color: #e5e7eb;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  /* HERO */

  .hero {
    padding: 42px 0 50px;
    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(124, 58, 237, 0.13),
        transparent 32%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(59, 130, 246, 0.11),
        transparent 30%
      );
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 34px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #7c3aed;
  }

  .breadcrumb i {
    font-size: 9px;
    opacity: 0.7;
  }

  :global(html:not([data-theme='light'])) .breadcrumb,
  :global(html:not([data-theme='light'])) .breadcrumb a {
    color: #94a3b8;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .tool-icon {
    width: 88px;
    height: 88px;
    flex: 0 0 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background: linear-gradient(
      135deg,
      #7c3aed,
      #5b21b6
    );
    color: white;
    font-size: 35px;
    box-shadow:
      0 18px 40px rgba(124, 58, 237, 0.25);
  }

  .hero-text {
    min-width: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    margin-bottom: 9px;
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
    font-size: 12px;
    font-weight: 700;
  }

  .hero h1 {
    margin: 0 0 8px;
    font-size: clamp(29px, 5vw, 44px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .hero p {
    max-width: 760px;
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.9;
  }

  :global(html:not([data-theme='light'])) .hero p {
    color: #94a3b8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tags span {
    padding: 5px 10px;
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 8px;
    background: rgba(124, 58, 237, 0.05);
    color: #7c3aed;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
  }

  /* TOOL */

  .tool-section {
    padding: 48px 0;
  }

  .tool-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: white;
    box-shadow:
      0 20px 60px rgba(15, 23, 42, 0.08);
  }

  :global(html:not([data-theme='light'])) .tool-card {
    border-color: #1e293b;
    background: #111827;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .window-bar {
    min-height: 56px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  :global(html:not([data-theme='light'])) .window-bar {
    background: #0f172a;
    border-color: #1e293b;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .window-dots span:nth-child(1) {
    background: #f87171;
  }

  .window-dots span:nth-child(2) {
    background: #fbbf24;
  }

  .window-dots span:nth-child(3) {
    background: #34d399;
  }

  .window-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    font-weight: 700;
    color: #334155;
  }

  .window-title i {
    color: #7c3aed;
  }

  :global(html:not([data-theme='light'])) .window-title {
    color: #cbd5e1;
  }

  .local-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #059669;
    font-size: 11px;
    font-weight: 700;
  }

  .local-badge i {
    font-size: 12px;
  }

  .action-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 9px;
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
  }

  :global(html:not([data-theme='light'])) .action-bar {
    border-color: #1e293b;
  }

  .action-btn,
  .copy-btn {
    border: 1px solid #dbe2ea;
    border-radius: 9px;
    padding: 9px 14px;
    background: #fff;
    color: #475569;
    font-family: 'Cairo', sans-serif;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  :global(html:not([data-theme='light'])) .action-btn,
  :global(html:not([data-theme='light'])) .copy-btn {
    border-color: #334155;
    background: #172033;
    color: #cbd5e1;
  }

  .action-btn:hover,
  .copy-btn:not(:disabled):hover {
    transform: translateY(-1px);
    border-color: #7c3aed;
  }

  .action-btn.primary {
    border-color: #7c3aed;
    background: #7c3aed;
    color: white;
  }

  .action-btn.primary:hover {
    background: #6d28d9;
  }

  .action-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .editor-area,
  .result-area {
    padding: 20px;
  }

  .editor-header,
  .result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
  }

  :global(html:not([data-theme='light'])) .editor-header,
  :global(html:not([data-theme='light'])) .result-header {
    color: #cbd5e1;
  }

  .editor-header > div,
  .result-header > div {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .editor-header i,
  .result-header i {
    color: #7c3aed;
  }

