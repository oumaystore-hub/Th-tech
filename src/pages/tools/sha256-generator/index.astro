---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SHA-256 Generator - إنشاء SHA-256 أونلاين | Th.Tech</title>

    <meta
      name="description"
      content="أداة مجانية لإنشاء Hash SHA-256 للنصوص مباشرة أونلاين. سريعة وآمنة وتعمل بالكامل داخل المتصفح."
    />

    <meta
      name="keywords"
      content="SHA-256, SHA256 Generator, Hash Generator, تشفير, هاش, أمان, أدوات تقنية"
    />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/sha256-generator/`}
    />

    <meta name="theme-color" content="#0f172a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- تهيئة الثيم قبل ظهور الصفحة -->
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme');

          if (theme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (error) {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page-wrapper">

      <!-- Hero -->
      <section class="hero">
        <div class="hero-badge">
          <i class="fa-solid fa-shield-halved"></i>
          أداة أمنية مجانية
        </div>

        <h1>
          مولّد
          <span>SHA-256</span>
        </h1>

        <p>
          أنشئ قيمة SHA-256 لأي نص بسرعة وسهولة، مباشرة داخل متصفحك
          وبدون إرسال بياناتك إلى أي خادم.
        </p>

        <div class="breadcrumb">
          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <span>SHA-256 Generator</span>
        </div>
      </section>

      <!-- Tool -->
      <section class="tool-section">

        <div class="tool-card">

          <div class="tool-header">
            <div class="tool-icon">
              <i class="fa-solid fa-fingerprint"></i>
            </div>

            <div class="tool-title">
              <h2>SHA-256 Generator</h2>
              <p>
                إنشاء Hash SHA-256 للنصوص
              </p>
            </div>

            <div class="security-badge">
              <i class="fa-solid fa-lock"></i>
              محلي 100%
            </div>
          </div>

          <div class="tool-content">

            <!-- Input -->
            <div class="field-group">
              <div class="field-label">
                <label for="inputText">
                  النص المراد تشفيره
                </label>

                <span id="charCount">0 حرف</span>
              </div>

              <textarea
                id="inputText"
                placeholder="اكتب أو الصق النص هنا..."
                spellcheck="false"
                autocomplete="off"
              ></textarea>
            </div>

            <!-- Buttons -->
            <div class="actions">

              <button
                id="generateBtn"
                class="btn btn-primary"
                type="button"
              >
                <i class="fa-solid fa-bolt"></i>
                إنشاء SHA-256
              </button>

              <button
                id="exampleBtn"
                class="btn btn-secondary"
                type="button"
              >
                <i class="fa-solid fa-flask"></i>
                مثال
              </button>

              <button
                id="clearBtn"
                class="btn btn-danger"
                type="button"
              >
                <i class="fa-solid fa-trash"></i>
                مسح
              </button>

            </div>

            <!-- Result -->
            <div class="result-section">

              <div class="result-header">
                <div>
                  <i class="fa-solid fa-hashtag"></i>
                  النتيجة
                </div>

                <button
                  id="copyBtn"
                  class="copy-btn"
                  type="button"
                  disabled
                >
                  <i class="fa-regular fa-copy"></i>
                  نسخ
                </button>
              </div>

              <div
                id="resultBox"
                class="result-box empty"
              >
                <span id="resultText">
                  ستظهر قيمة SHA-256 هنا...
                </span>
              </div>

              <div
                id="status"
                class="status"
              ></div>

            </div>

            <!-- Stats -->
            <div class="stats">

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-ruler-horizontal"></i>
                </div>

                <div>
                  <strong>64</strong>
                  <span>حرف Hex</span>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-database"></i>
                </div>

                <div>
                  <strong>256</strong>
                  <span>بت</span>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-shield"></i>
                </div>

                <div>
                  <strong>SHA-256</strong>
                  <span>خوارزمية</span>
                </div>
              </div>

            </div>

          </div>
        </div>

      </section>

      <!-- Information -->
      <section class="info-grid">

        <article class="info-card">
          <div class="info-card-icon blue">
            <i class="fa-solid fa-circle-info"></i>
          </div>

          <h3>ما هو SHA-256؟</h3>

          <p>
            SHA-256 هي خوارزمية تجزئة تشفيرية تنتج قيمة ثابتة بطول
            256 بت، وتستخدم على نطاق واسع في الأمن السيبراني،
            التحقق من البيانات، وتخزين بصمات الملفات.
          </p>
        </article>

        <article class="info-card">
          <div class="info-card-icon green">
            <i class="fa-solid fa-user-shield"></i>
          </div>

          <h3>هل بياناتي آمنة؟</h3>

          <p>
            نعم. تتم عملية إنشاء SHA-256 بالكامل داخل متصفحك
            باستخدام Web Crypto API. لا يتم إرسال النص الذي تدخله
            إلى خادم خارجي.
          </p>
        </article>

        <article class="info-card">
          <div class="info-card-icon purple">
            <i class="fa-solid fa-code"></i>
          </div>

          <h3>أين يستخدم SHA-256؟</h3>

          <p>
            يستخدم في التحقق من الملفات، أنظمة الأمان، Git،
            التوقيعات الرقمية، Blockchain والعديد من تطبيقات
            البرمجيات الحديثة.
          </p>
        </article>

      </section>

      <!-- How to -->
      <section class="guide-section">

        <div class="section-heading">
          <span class="section-number">01</span>

          <div>
            <h2>كيفية استخدام الأداة</h2>
            <p>إنشاء SHA-256 في ثلاث خطوات بسيطة</p>
          </div>
        </div>

        <div class="steps">

          <div class="step">
            <span class="step-number">1</span>

            <div>
              <h3>أدخل النص</h3>
              <p>
                اكتب النص أو الصق المحتوى الذي تريد إنشاء بصمته.
              </p>
            </div>
          </div>

          <div class="step">
            <span class="step-number">2</span>

            <div>
              <h3>اضغط إنشاء</h3>
              <p>
                اضغط على زر "إنشاء SHA-256" لمعالجة النص فورًا.
              </p>
            </div>
          </div>

          <div class="step">
            <span class="step-number">3</span>

            <div>
              <h3>انسخ النتيجة</h3>
              <p>
                ستظهر قيمة SHA-256 المكونة من 64 حرفًا ويمكنك نسخها
                بضغطة واحدة.
              </p>
            </div>
          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="faq-section">

        <div class="section-heading">
          <span class="section-number">02</span>

          <div>
            <h2>الأسئلة الشائعة</h2>
            <p>أهم المعلومات حول SHA-256</p>
          </div>
        </div>

        <div class="faq-list">

          <details>
            <summary>
              <span>
                هل SHA-256 تشفير قابل لفكّه؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              لا. SHA-256 هي خوارزمية Hash أحادية الاتجاه وليست
              تشفيرًا تقليديًا. لا توجد عملية عكسية مباشرة لاستعادة
              النص الأصلي من قيمة الـ Hash.
            </p>
          </details>

          <details>
            <summary>
              <span>
                كم يبلغ طول SHA-256؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              تنتج SHA-256 قيمة بطول 256 بت، وعند تمثيلها بالنظام
              الست عشري Hexadecimal تكون النتيجة 64 حرفًا.
            </p>
          </details>

          <details>
            <summary>
              <span>
                هل يمكن استخدام الأداة للتحقق من الملفات؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              هذه النسخة مخصصة للنصوص. يمكن استخدام SHA-256 أيضًا
              للتحقق من سلامة الملفات من خلال مقارنة قيمة Hash
              للملف مع القيمة الأصلية.
            </p>
          </details>

          <details>
            <summary>
              <span>
                هل يتم تخزين النص الذي أدخله؟
              </span>

              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              لا. عملية إنشاء Hash تتم محليًا داخل المتصفح باستخدام
              Web Crypto API ولا يتم إرسال النص إلى الخادم.
            </p>
          </details>

        </div>

      </section>

    </main>

    <Footer />

    <!-- =========================================================
         SHA-256 + THEME SYNC
         ========================================================= -->

    <script is:inline>
      (() => {
        const root = document.documentElement;

        /*
         * مزامنة الثيم مع Header
         * تعمل مباشرة بدون الحاجة إلى Refresh
         */
        function syncTheme() {
          try {
            const theme = localStorage.getItem('theme');

            if (theme === 'light') {
              root.setAttribute('data-theme', 'light');
            } else {
              root.removeAttribute('data-theme');
            }
          } catch (error) {
            // تجاهل أخطاء localStorage
          }
        }

        // أول تحميل
        syncTheme();

        /*
         * إذا كان Header يرسل هذا الحدث
         */
        window.addEventListener('themeChange', syncTheme);

        /*
         * مراقبة تغيير data-theme مباشرة
         */
        const observer = new MutationObserver(() => {
          try {
            const theme = localStorage.getItem('theme');

            if (theme === 'light') {
              if (root.getAttribute('data-theme') !== 'light') {
                root.setAttribute('data-theme', 'light');
              }
            } else {
              if (root.hasAttribute('data-theme')) {
                root.removeAttribute('data-theme');
              }
            }
          } catch (error) {}
        });

        observer.observe(root, {
          attributes: true,
          attributeFilter: ['data-theme']
        });

        /*
         * التقاط زر الثيم الموجود في Header
         */
        document.addEventListener('click', (event) => {
          const target = event.target;

          if (!(target instanceof Element)) return;

          const themeButton = target.closest('#theme-btn');

          if (themeButton) {
            setTimeout(() => {
              syncTheme();
            }, 0);
          }
        });
      })();
    </script>

    <!-- =========================================================
         SHA-256 TOOL
         ========================================================= -->

    <script is:inline>
      (() => {
        const input = document.getElementById('inputText');
        const resultBox = document.getElementById('resultBox');
        const resultText = document.getElementById('resultText');
        const generateBtn = document.getElementById('generateBtn');
        const copyBtn = document.getElementById('copyBtn');
        const clearBtn = document.getElementById('clearBtn');
        const exampleBtn = document.getElementById('exampleBtn');
        const status = document.getElementById('status');
        const charCount = document.getElementById('charCount');

        if (
          !input ||
          !resultBox ||
          !resultText ||
          !generateBtn ||
          !copyBtn ||
          !clearBtn ||
          !exampleBtn ||
          !status ||
          !charCount
        ) {
          return;
        }

        let currentHash = '';

        /* تحديث عدد الأحرف */
        function updateCharCount() {
          const length = input.value.length;

          charCount.textContent =
            `${length.toLocaleString('ar-MA')} حرف`;
        }

        /* عرض الحالة */
        function showStatus(message, type = '') {
          status.textContent = message;
          status.className = 'status';

          if (type) {
            status.classList.add(type);
          }
        }

        /* إنشاء SHA-256 */
        async function generateSHA256(text) {
          const encoder = new TextEncoder();
          const data = encoder.encode(text);

          const hashBuffer = await crypto.subtle.digest(
            'SHA-256',
            data
          );

          const hashArray = Array.from(
            new Uint8Array(hashBuffer)
          );

          return hashArray
            .map((byte) =>
              byte.toString(16).padStart(2, '0')
            )
            .join('');
        }

        /* إنشاء Hash */
        async function handleGenerate() {
          const text = input.value;

          if (!text) {
            resultBox.classList.add('error-result');

            resultText.textContent =
              'يرجى إدخال نص أولاً...';

            copyBtn.disabled = true;
            currentHash = '';

            showStatus(
              'الرجاء إدخال النص الذي تريد إنشاء SHA-256 له.',
              'error'
            );

            input.focus();

            setTimeout(() => {
              resultBox.classList.remove('error-result');
            }, 1800);

            return;
          }

          generateBtn.disabled = true;
          generateBtn.classList.add('loading');

          generateBtn.innerHTML = `
            <i class="fa-solid fa-spinner fa-spin"></i>
            جارٍ الإنشاء...
          `;

          showStatus('');

          try {
            const hash = await generateSHA256(text);

            currentHash = hash;

            resultBox.classList.remove(
              'empty',
              'error-result'
            );

            resultBox.classList.add('success-result');

            resultText.textContent = hash;

            copyBtn.disabled = false;

            showStatus(
              'تم إنشاء SHA-256 بنجاح.',
              'success'
            );

          } catch (error) {
            console.error(error);

            resultBox.classList.remove('success-result');
            resultBox.classList.add('error-result');

            resultText.textContent =
              'حدث خطأ أثناء إنشاء SHA-256.';

            copyBtn.disabled = true;

            showStatus(
              'تعذر إنشاء Hash.',
              'error'
            );

          } finally {
            generateBtn.disabled = false;
            generateBtn.classList.remove('loading');

            generateBtn.innerHTML = `
              <i class="fa-solid fa-bolt"></i>
              إنشاء SHA-256
            `;
          }
        }

        /* نسخ النتيجة */
        async function handleCopy() {
          if (!currentHash) return;

          try {
            await navigator.clipboard.writeText(currentHash);

            copyBtn.innerHTML = `
              <i class="fa-solid fa-check"></i>
              تم النسخ
            `;

            copyBtn.classList.add('copied');

            showStatus(
              'تم نسخ SHA-256 إلى الحافظة.',
              'success'
            );

            setTimeout(() => {
              copyBtn.innerHTML = `
                <i class="fa-regular fa-copy"></i>
                نسخ
              `;

              copyBtn.classList.remove('copied');
            }, 1800);

          } catch (error) {
            /*
             * Fallback للمتصفحات التي لا تدعم clipboard
             */
            const textarea =
              document.createElement('textarea');

            textarea.value = currentHash;

            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';

            document.body.appendChild(textarea);

            textarea.select();

            try {
              document.execCommand('copy');

              showStatus(
                'تم نسخ SHA-256.',
                'success'
              );
            } catch (copyError) {
              showStatus(
                'تعذر النسخ تلقائيًا.',
                'error'
              );
            }

            textarea.remove();
          }
        }

        /* مسح */
        function handleClear() {
          input.value = '';

          currentHash = '';

          resultText.textContent =
            'ستظهر قيمة SHA-256 هنا...';

          resultBox.classList.remove(
            'success-result',
            'error-result'
          );

          resultBox.classList.add('empty');

          copyBtn.disabled = true;

          showStatus('');

          updateCharCount();

          input.focus();
        }

        /* مثال */
        function handleExample() {
          input.value =
            'Hello, World!';

          updateCharCount();

          handleGenerate();
        }

        input.addEventListener(
          'input',
          updateCharCount
        );

        generateBtn.addEventListener(
          'click',
          handleGenerate
        );

        copyBtn.addEventListener(
          'click',
          handleCopy
        );

        clearBtn.addEventListener(
          'click',
          handleClear
        );

        exampleBtn.addEventListener(
          'click',
          handleExample
        );

        input.addEventListener(
          'keydown',
          (event) => {
            if (
              (event.ctrlKey || event.metaKey) &&
              event.key === 'Enter'
            ) {
              event.preventDefault();
              handleGenerate();
            }
          }
        );

        updateCharCount();
      })();
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: 'Cairo', sans-serif;
      }

      /* =========================================================
         DARK THEME
         ========================================================= */

      :global(body) {
        background: #070d18;
        color: #e5edf7;
        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      /* =========================================================
         LIGHT THEME
         ========================================================= */

      :global(html[data-theme='light'] body) {
        background: #f4f8fc;
        color: #172033;
      }

      .page-wrapper {
        min-height: 100vh;
        padding-bottom: 70px;
      }

      /* =========================================================
         HERO
         ========================================================= */

      .hero {
        position: relative;
        text-align: center;
        padding: 75px 20px 45px;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.08);
        filter: blur(80px);
        top: -280px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
      }

      .hero-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 15px;
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 999px;
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.08);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
      }

      .hero h1 {
        position: relative;
        margin: 0;
        font-size: clamp(34px, 6vw, 58px);
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero h1 span {
        color: #3b82f6;
      }

      .hero p {
        position: relative;
        max-width: 700px;
        margin: 18px auto 25px;
        color: #94a3b8;
        font-size: 16px;
        line-height: 2;
      }

      :global(html[data-theme='light']) .hero p {
        color: #64748b;
      }

      .breadcrumb {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        color: #64748b;
        font-size: 13px;
      }

      .breadcrumb a {
        color: #60a5fa;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .breadcrumb a:hover {
        color: #93c5fd;
      }

      .breadcrumb i {
        font-size: 9px;
        color: #475569;
      }

      /* =========================================================
         TOOL SECTION
         ========================================================= */

      .tool-section {
        width: min(950px, calc(100% - 30px));
        margin: 0 auto 50px;
      }

      .tool-card {
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        overflow: hidden;
        background: rgba(15, 23, 42, 0.88);
        box-shadow:
          0 20px 70px rgba(0, 0, 0, 0.25),
          0 0 0 1px rgba(59, 130, 246, 0.03);
        backdrop-filter: blur(15px);
      }

      :global(html[data-theme='light']) .tool-card {
        background: #ffffff;
        border-color: #e2e8f0;
        box-shadow:
          0 20px 60px rgba(15, 23, 42, 0.08);
      }

      .tool-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px 25px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.12);
        background: rgba(30, 41, 59, 0.35);
      }

      :global(html[data-theme='light']) .tool-header {
        background: #f8fafc;
        border-color: #e2e8f0;
      }

      .tool-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.2);
        font-size: 22px;
      }

      .tool-title {
        flex: 1;
      }

      .tool-title h2 {
        margin: 0 0 3px;
        font-size: 19px;
        font-weight: 800;
      }

      .tool-title p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
      }

      .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        color: #4ade80;
        background: rgba(34, 197, 94, 0.08);
        border: 1px solid rgba(34, 197, 94, 0.15);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
      }

      .tool-content {
        padding: 28px;
      }

      /* =========================================================
         INPUT
         ========================================================= */

      .field-group {
        margin-bottom: 18px;
      }

      .field-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
      }

      .field-label label {
        font-size: 14px;
        font-weight: 700;
      }

      .field-label span {
        color: #64748b;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
      }

      textarea {
        width: 100%;
        min-height: 180px;
        resize: vertical;
        display: block;
        padding: 17px;
        border: 1px solid #334155;
        border-radius: 14px;
        outline: none;
        background: #0b1220;
        color: #e2e8f0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        line-height: 1.8;
        direction: auto;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      textarea::placeholder {
        color: #475569;
      }

      textarea:focus {
        border-color: #3b82f6;
        box-shadow:
          0 0 0 3px rgba(59, 130, 246, 0.12);
      }

      :global(html[data-theme='light']) textarea {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #172033;
      }

      :global(html[data-theme='light']) textarea::placeholder {
        color: #94a3b8;
      }

      /* =========================================================
         BUTTONS
         ========================================================= */

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
      }

      .btn {
        min-height: 46px;
        border-radius: 12px;
        padding: 0 18px;
        border: 1px solid transparent;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-family: 'Cairo', sans-serif;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          opacity 0.2s ease;
      }

      .btn:hover:not(:disabled) {
        transform: translateY(-2px);
      }

      .btn:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .btn-primary {
        flex: 1;
        background: #2563eb;
        color: white;
        box-shadow:
          0 8px 25px rgba(37, 99, 235, 0.25);
      }

      .btn-primary:hover:not(:disabled) {
        background: #1d4ed8;
        box-shadow:
          0 10px 30px rgba(37, 99, 235, 0.35);
      }

      .btn-secondary {
        color: #cbd5e1;
        background: #1e293b;
        border-color: #334155;
      }

      :global(html[data-theme='light']) .btn-secondary {
        color: #334155;
        background: #f1f5f9;
        border-color: #cbd5e1;
      }

      .btn-danger {
        color: #fca5a5;
        background: rgba(239, 68, 68, 0.08);
        border-color: rgba(239, 68, 68, 0.2);
      }

      :global(html[data-theme='light']) .btn-danger {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
      }

      /* =========================================================
         RESULT
         ========================================================= */

      .result-section {
        margin-top: 5px;
      }

      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 14px;
        font-weight: 700;
      }

      .result-header > div {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .result-header > div i {
        color: #60a5fa;
      }

      .copy-btn {
        border: 1px solid #334155;
        background: #1e293b;
        color: #cbd5e1;
        border-radius: 9px;
        padding: 7px 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        font-family: 'Cairo', sans-serif;
        font-size: 11px;
        font-weight: 700;
        transition: all 0.2s ease;
      }

      .copy-btn:hover:not(:disabled) {
        border-color: #3b82f6;
        color: #60a5fa;
      }

      .copy-btn:disabled {
        cursor: not-allowed;
        opacity: 0.45;
      }

      .copy-btn.copied {
        color: #4ade80;
        border-color: rgba(34, 197, 94, 0.3);
      }

      :global(html[data-theme='light']) .copy-btn {
        background: #f8fafc;
        color: #475569;
        border-color: #cbd5e1;
      }

      .result-box {
        min-height: 85px;
        display: flex;
        align-items: center;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #334155;
        background: #080f1d;
        overflow-x: auto;
      }

      :global(html[data-theme='light']) .result-box {
        background: #f8fafc;
        border-color: #cbd5e1;
      }

      .result-box span {
        width: 100%;
        word-break: break-all;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.8;
        direction: ltr;
        text-align: left;
      }

      .result-box.empty span {
        color: #475569;
        text-align: center;
      }

      .result-box.success-result {
        border-color: rgba(34, 197, 94, 0.35);
        background: rgba(34, 197, 94, 0.035);
      }

      .result-box.success-result span {
        color: #4ade80;
      }

      :global(html[data-theme='light'])
        .result-box.success-result span {
        color: #15803d;
      }

      .result-box.error-result {
        border-color: rgba(239, 68, 68, 0.4);
        background: rgba(239, 68, 68, 0.05);
      }

      .result-box.error-result span {
        color: #f87171;
        text-align: center;
        font-family: 'Cairo', sans-serif;
      }

      .status {
        min-height: 22px;
        margin-top: 8px;
        font-size: 12px;
      }

      .status.success {
        color: #4ade80;
      }

      .status.error {
        color: #f87171;
      }

      /* =========================================================
         STATS
         ========================================================= */

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 24px;
      }

      .stat {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px;
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 13px;
        background: rgba(30, 41, 59, 0.3);
      }

      :global(html[data-theme='light']) .stat {
        background: #f8fafc;
        border-color: #e2e8f0;
      }

      .stat-icon {
        width: 37px;
        height: 37px;
        display: grid;
        place-items: center;
        flex: 0 0 37px;
        border-radius: 10px;
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.1);
      }

      .stat strong {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: #e2e8f0;
      }

      :global(html[data-theme='light']) .stat strong {
        color: #1e293b;
      }

      .stat span {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: 10px;
      }

      /* =========================================================
         INFO
         ========================================================= */

      .info-grid {
        width: min(1100px, calc(100% - 30px));
        margin: 0 auto 70px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .info-card {
        padding: 24px;
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: 18px;
        background: rgba(15, 23, 42, 0.55);
      }

      :global(html[data-theme='light']) .info-card {
        background: white;
        border-color: #e2e8f0;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
      }

      .info-card-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        margin-bottom: 16px;
        font-size: 18px;
      }

      .info-card-icon.blue {
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.1);
      }

      .info-card-icon.green {
        color: #4ade80;
        background: rgba(34, 197, 94, 0.1);
      }

      .info-card-icon.purple {
        color: #c084fc;
        background: rgba(168, 85, 247, 0.1);
      }

      .info-card h3 {
        margin: 0 0 9px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 2;
      }

      :global(html[data-theme='light']) .info-card p {
        color: #64748b;
      }

      /* =========================================================
         GUIDE
         ========================================================= */

      .guide-section,
      .faq-section {
        width: min(950px, calc(100% - 30px));
        margin: 0 auto 70px;
      }

      .section-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
      }

      .section-number {
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.1);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 700;
      }

      .section-heading h2 {
        margin: 0 0 3px;
        font-size: 22px;
      }

      .section-heading p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .step {
        display: flex;
        gap: 13px;
        padding: 20px;
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.5);
      }

      :global(html[data-theme='light']) .step {
        background: white;
        border-color: #e2e8f0;
      }

      .step-number {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        flex: 0 0 32px;
        border-radius: 9px;
        color: white;
        background: #2563eb;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 700;
      }

      .step h3 {
        margin: 0 0 5px;
        font-size: 13px;
      }

      .step p {
        margin: 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.8;
      }

      /* =========================================================
         FAQ
         ========================================================= */

      .faq-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .faq-list details {
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: 14px;
        background: rgba(15, 23, 42, 0.5);
        overflow: hidden;
      }

      :global(html[data-theme='light']) .faq-list details {
        background: white;
        border-color: #e2e8f0;
      }

      .faq-list summary {
        min-height: 58px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 0 18px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-list summary::-webkit-details-marker {
        display: none;
      }

      .faq-list summary i {
        color: #64748b;
        font-size: 11px;
        transition: transform 0.2s ease;
      }

      .faq-list details[open] summary i {
        transform: rotate(180deg);
      }

      .faq-list details p {
        margin: 0;
        padding: 0 18px 18px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 2;
      }

      :global(html[data-theme='light']) .faq-list details p {
        color: #64748b;
      }

      /* =========================================================
         RESPONSIVE
         ========================================================= */

      @media (max-width: 800px) {
        .info-grid {
          grid-template-columns: 1fr;
        }

        .steps {
          grid-template-columns: 1fr;
        }

        .tool-header {
          flex-wrap: wrap;
        }

        .security-badge {
          margin-right: auto;
        }
      }

      @media (max-width: 600px) {
        .hero {
          padding-top: 50px;
          padding-bottom: 35px;
        }

        .hero h1 {
          font-size: 36px;
        }

        .hero p {
          font-size: 13px;
          line-height: 1.9;
        }

        .tool-section,
        .info-grid,
        .guide-section,
        .faq-section {
          width: min(100% - 20px, 950px);
        }

        .tool-card {
          border-radius: 18px;
        }

        .tool-header {
          padding: 18px;
        }

        .tool-content {
          padding: 18px;
        }

        .tool-icon {
          width: 45px;
          height: 45px;
          flex-basis: 45px;
        }

        .tool-title h2 {
          font-size: 16px;
        }

        .security-badge {
          width: 100%;
          justify-content: center;
          margin-top: 2px;
        }

        textarea {
          min-height: 150px;
          font-size: 12px;
        }

        .actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .btn-primary {
          grid-column: 1 / -1;
        }

        .stats {
          grid-template-columns: 1fr;
        }

        .stat {
          justify-content: flex-start;
        }

        .section-heading h2 {
          font-size: 19px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </body>
</html>
