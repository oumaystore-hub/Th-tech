      function setStatus(message, type = "info") {
        status.className = "status";

        if (type === "success") {
          status.classList.add("success");
        }

        if (type === "error") {
          status.classList.add("error");
        }

        const icon = status.querySelector("i");
        const text = status.querySelector("span");

        if (type === "success") {
          icon.className = "fa-solid fa-circle-check";
        } else if (type === "error") {
          icon.className = "fa-solid fa-circle-xmark";
        } else {
          icon.className = "fa-solid fa-circle-info";
        }

        text.textContent = message;
      }

      function setCheck(element, state, customText = null) {
        element.className = "check-status";

        if (customText) {
          element.textContent = customText;
          element.classList.add(
            state ? "ok" : "bad"
          );
          return;
        }

        if (state === true) {
          element.classList.add("ok");
          element.textContent = "✓";
        } else if (state === false) {
          element.classList.add("bad");
          element.textContent = "✕";
        } else {
          element.textContent = "—";
        }
      }

      function resetChecks() {
        [
          checkFormat,
          checkVersion,
          checkPrivate,
          checkLoopback,
          checkMulticast
        ].forEach((element) => setCheck(element, null));
      }

      function parseIPv4(value) {
        const parts = value.split(".");

        if (parts.length !== 4) {
          return null;
        }

        const numbers = [];

        for (const part of parts) {
          if (!/^\d+$/.test(part)) {
            return null;
          }

          if (part.length > 1 && part.startsWith("0")) {
            return null;
          }

          const number = Number(part);

          if (
            !Number.isInteger(number) ||
            number < 0 ||
            number > 255
          ) {
            return null;
          }

          numbers.push(number);
        }

        return numbers;
      }

      function isIPv4(value) {
        return parseIPv4(value) !== null;
      }

      function isIPv6(value) {
        if (!value || !value.includes(":")) {
          return false;
        }

        if (value.includes(".")) {
          const lastColon = value.lastIndexOf(":");
          const embeddedIPv4 = value.slice(lastColon + 1);

          if (!isIPv4(embeddedIPv4)) {
            return false;
          }

          value =
            value.slice(0, lastColon + 1) +
            "0:0";
        }

        if ((value.match(/::/g) || []).length > 1) {
          return false;
        }

        const hasCompression = value.includes("::");
        const groups = value.split(":");

        if (hasCompression) {
          if (
            groups.length > 8 ||
            value.indexOf("::") !== value.lastIndexOf("::")
          ) {
            return false;
          }
        } else if (groups.length !== 8) {
          return false;
        }

        for (const group of groups) {
          if (group === "") {
            continue;
          }

          if (!/^[0-9a-fA-F]{1,4}$/.test(group)) {
            return false;
          }
        }

        if (hasCompression) {
          const explicitGroups = groups.filter(
            (group) => group !== ""
          );

          if (explicitGroups.length >= 8) {
            return false;
          }
        }

        return true;
      }

      function ipv4ToNumber(parts) {
        return (
          parts[0] * 16777216 +
          parts[1] * 65536 +
          parts[2] * 256 +
          parts[3]
        );
      }

      function inRange(number, start, end) {
        return number >= start && number <= end;
      }

      function getIPv4Info(parts) {
        const number = ipv4ToNumber(parts);

        const privateIp =
          inRange(number, 0x0A000000, 0x0AFFFFFF) ||
          inRange(number, 0xAC100000, 0xAC1FFFFF) ||
          inRange(number, 0xC0A80000, 0xC0A8FFFF);

        const loopback =
          inRange(number, 0x7F000000, 0x7FFFFFFF);

        const multicast =
          inRange(number, 0xE0000000, 0xEFFFFFFF);

        const linkLocal =
          inRange(number, 0xA9FE0000, 0xA9FEFFFF);

        const broadcast =
          number === 0xFFFFFFFF;

        return {
          privateIp,
          loopback,
          multicast,
          linkLocal,
          broadcast
        };
      }

      function getIPv6Info(value) {
        const normalized = value.toLowerCase();

        const loopback =
          normalized === "::1";

        const unspecified =
          normalized === "::";

        const multicast =
          normalized.startsWith("ff");

        const uniqueLocal =
          normalized.startsWith("fc") ||
          normalized.startsWith("fd");

        const linkLocal =
          normalized.startsWith("fe8") ||
          normalized.startsWith("fe9") ||
          normalized.startsWith("fea") ||
          normalized.startsWith("feb");

        return {
          privateIp: uniqueLocal,
          loopback,
          multicast,
          linkLocal,
          unspecified
        };
      }

      function validateIP() {
        const value = ipInput.value.trim();

        statLength.textContent =
          value.length.toLocaleString("ar");

        ipInput.classList.remove("valid", "invalid");

        typePill.hidden = true;

        if (!value) {
          result.className = "result";

          resultIcon.className = "result-icon";
          resultIcon.innerHTML =
            '<i class="fa-solid fa-network-wired"></i>';

          resultTitle.textContent =
            "بانتظار عنوان IP";

          resultText.textContent =
            "أدخل عنوان IPv4 أو IPv6 لبدء الفحص.";

          statVersion.textContent = "—";
          statClass.textContent = "—";
          statStatus.textContent = "—";

          resetChecks();

          setStatus(
            "أدخل عنوان IP لبدء الفحص.",
            "info"
          );

          return;
        }

        const ipv4 = isIPv4(value);
        const ipv6 = !ipv4 && isIPv6(value);
        const valid = ipv4 || ipv6;

        setCheck(checkFormat, valid);

        if (!valid) {
          ipInput.classList.add("invalid");

          result.className = "result invalid";

          resultIcon.className = "result-icon";
          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-xmark"></i>';

          resultTitle.textContent =
            "عنوان IP غير صالح";

          resultText.textContent =
            "لم يتم التعرف على العنوان كـ IPv4 أو IPv6 صالح.";

          statVersion.textContent = "—";
          statClass.textContent = "INVALID";
          statStatus.textContent = "INVALID";

          setCheck(checkVersion, false);
          setCheck(checkPrivate, null);
          setCheck(checkLoopback, null);
          setCheck(checkMulticast, null);

          setStatus(
            "عنوان IP غير صالح. تحقق من الصيغة.",
            "error"
          );

          return;
        }

        ipInput.classList.add("valid");

        const version = ipv4 ? "IPv4" : "IPv6";

        statVersion.textContent = version;

        setCheck(
          checkVersion,
          true,
          version
        );

        let info;

        if (ipv4) {
          const parts = parseIPv4(value);
          info = getIPv4Info(parts);
        } else {
          info = getIPv6Info(value);
        }

        const specialPrivate =
          info.privateIp;

        const specialLoopback =
          info.loopback;

        const specialMulticast =
          info.multicast;

        const specialLabel =
          specialPrivate
            ? "Private"
            : specialLoopback
              ? "Loopback"
              : specialMulticast
                ? "Multicast"
                : "Public";

        statClass.textContent = specialLabel;
        statStatus.textContent = "VALID";

        setCheck(
          checkPrivate,
          true,
          specialPrivate ? "YES" : "NO"
        );

        setCheck(
          checkLoopback,
          true,
          specialLoopback ? "YES" : "NO"
        );

        setCheck(
          checkMulticast,
          true,
          specialMulticast ? "YES" : "NO"
        );

        result.className = "result valid";

        resultIcon.className = "result-icon";
        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "عنوان IP صالح";

        resultText.textContent =
          `تم التعرف على عنوان ${version} صالح.`;

        typePill.hidden = false;
        typePillText.textContent =
          `${version} • ${specialLabel}`;

        setStatus(
          `العنوان صالح — ${version}.`,
          "success"
        );
      }

      function loadIPv4() {
        ipInput.value = "192.168.1.1";
        validateIP();
        ipInput.focus();
      }

      function loadIPv6() {
        ipInput.value = "2001:db8::1";
        validateIP();
        ipInput.focus();
      }

      function clearIP() {
        ipInput.value = "";
        validateIP();
        ipInput.focus();
      }

      ipInput.addEventListener(
        "input",
        validateIP
      );

      validateBtn.addEventListener(
        "click",
        validateIP
      );

      ipv4Btn.addEventListener(
        "click",
        loadIPv4
      );

      ipv6Btn.addEventListener(
        "click",
        loadIPv6
      );

      clearBtn.addEventListener(
        "click",
        clearIP
      );

      ipInput.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            validateIP();
          }
        }
      );

      validateIP();
    })();
  </script>
</body>
</html>
