---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "IP Address Validator | مدقق عنوان IP | Th.Tech";
const description =
  "أداة مجانية للتحقق من صحة عناوين IPv4 وIPv6 ومعرفة نوع عنوان IP وخصائصه الأساسية مباشرة داخل المتصفح.";
const canonical =
  `https://oumaystore-hub.github.io${base}/tools/ip-address-validator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        } else {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>

  <style>
    :root {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --text: #102033;
      --muted: #64748b;
      --border: #dce7f3;
      --primary: #2563eb;
      --primary-2: #3b82f6;
      --cyan: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --code: #eef4fb;
      --shadow: 0 18px 50px rgba(37, 99, 235, 0.08);
    }

    html.dark-mode,
    html:not([data-theme="light"]).dark-mode {
      --bg: #07111f;
      --surface: #0d1b2a;
      --surface-2: #101f31;
      --text: #e8f1fb;
      --muted: #91a4b9;
      --border: #20364c;
      --primary: #60a5fa;
      --primary-2: #3b82f6;
      --cyan: #22d3ee;
      --success: #34d399;
      --danger: #f87171;
      --warning: #fbbf24;
      --code: #081522;
      --shadow: 0 18px 50px rgba(0, 0, 0, 0.25);
    }

    html[data-theme="light"] {
      --bg: #f5f9ff;
      --surface: #ffffff;
      --surface-2: #f8fbff;
      --text: #102033;
      --muted: #64748b;
      --border: #dce7f3;
      --primary: #2563eb;
      --primary-2: #3b82f6;
      --cyan: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --code: #eef4fb;
      --shadow: 0 18px 50px rgba(37, 99, 235, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at 10% 0%, rgba(37, 99, 235, 0.08), transparent 28%),
        radial-gradient(circle at 90% 10%, rgba(6, 182, 212, 0.07), transparent 25%),
        var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      transition: background 0.25s ease, color 0.25s ease;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .page {
      min-height: 100vh;
      padding: 34px 18px 70px;
    }

    .container {
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 22px;
    }

    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
    }

    .breadcrumb i {
      font-size: 0.7rem;
      opacity: 0.7;
    }

    .hero {
      text-align: center;
      padding: 25px 10px 35px;
    }

    .hero-icon {
      width: 74px;
      height: 74px;
      margin: 0 auto 18px;
      display: grid;
      place-items: center;
      border-radius: 22px;
      color: #fff;
      font-size: 1.75rem;
      background: linear-gradient(135deg, var(--primary), var(--cyan));
      box-shadow: 0 18px 38px rgba(37, 99, 235, 0.23);
      animation: floatIcon 4s ease-in-out infinite;
    }

    @keyframes floatIcon {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-5px);
      }
    }

    .eyebrow {
      color: var(--primary);
      font-size: 0.87rem;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.7px;
    }

    .hero p {
      max-width: 770px;
      margin: 14px auto 0;
      color: var(--muted);
      font-size: 1rem;
    }

    .tags {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }

    .tag {
      padding: 6px 11px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      font-size: 0.76rem;
      font-weight: 700;
    }

    .tool-card,
    .info-section,
    .how-card,
    .faq-section,
    .privacy-card {
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .tool-card {
      padding: 24px;
    }

    .tool-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 20px;
    }

    .tool-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .tool-title-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: rgba(37, 99, 235, 0.1);
      color: var(--primary);
    }

    .tool-title h2 {
      margin: 0;
      font-size: 1.2rem;
    }

    .tool-title p {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      color: var(--success);
      background: rgba(16, 185, 129, 0.09);
      font-size: 0.75rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      animation: pulse 1.6s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: 0.35;
        transform: scale(0.8);
      }
    }

    .validator-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 16px;
    }

    .panel {
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--surface-2);
      overflow: hidden;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 13px 15px;
      border-bottom: 1px solid var(--border);
    }

    .panel-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 0.9rem;
      font-weight: 800;
    }

    .panel-title i {
      color: var(--primary);
    }

    .panel-badge {
      padding: 4px 8px;
      border-radius: 7px;
      background: var(--code);
      color: var(--muted);
      font-family: "JetBrains Mono", monospace;
      font-size: 0.67rem;
    }

    .input-area {
      padding: 15px;
    }

    .ip-input {
      width: 100%;
      min-height: 58px;
      border: 1px solid var(--border);
      border-radius: 14px;
      outline: 0;
      padding: 0 16px;
      background: var(--surface);
      color: var(--text);
      direction: ltr;
      text-align: left;
      font-family: "JetBrains Mono", monospace;
      font-size: 1rem;
      transition: 0.2s ease;
    }

    .ip-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }

    .ip-input.valid {
      border-color: var(--success);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.08);
    }

    .ip-input.invalid {
      border-color: var(--danger);
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08);
    }

    .hint {
      margin-top: 9px;
      color: var(--muted);
      font-size: 0.74rem;
    }

    .result {
      min-height: 180px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      text-align: center;
    }

    .result-icon {
      width: 65px;
      height: 65px;
      display: grid;
      place-items: center;
      border-radius: 19px;
      margin-bottom: 12px;
      background: rgba(37, 99, 235, 0.09);
      color: var(--primary);
      font-size: 1.55rem;
      transition: 0.25s ease;
    }

    .result.valid .result-icon {
      background: rgba(16, 185, 129, 0.1);
      color: var(--success);
    }

    .result.invalid .result-icon {
      background: rgba(239, 68, 68, 0.1);
      color: var(--danger);
    }

    .result h3 {
      margin: 0;
      font-size: 1.15rem;
    }

    .result p {
      max-width: 450px;
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .type-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--code);
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .checks {
      display: grid;
      gap: 8px;
      padding: 15px;
    }

    .check-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--surface);
      font-size: 0.77rem;
    }

    .check-name {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
    }

    .check-name i {
      width: 17px;
      text-align: center;
    }

    .check-status {
      color: var(--muted);
      font-weight: 800;
    }

    .check-status.ok {
      color: var(--success);
    }

    .check-status.bad {
      color: var(--danger);
    }

    .actions {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
    }

    .btn {
      min-height: 46px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface);
      color: var(--text);
      font-weight: 800;
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
    }

    .btn-primary {
      border-color: transparent;
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
    }

    .btn-primary:hover {
      border-color: transparent;
      box-shadow: 0 13px 30px rgba(37, 99, 235, 0.28);
    }

    .btn i {
      margin-left: 6px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 47px;
      margin-top: 13px;
      padding: 11px 14px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface-2);
      color: var(--muted);
      font-size: 0.81rem;
    }

    .status.success {
      color: var(--success);
      border-color: rgba(16, 185, 129, 0.25);
      background: rgba(16, 185, 129, 0.06);
    }

    .status.error {
      color: var(--danger);
      border-color: rgba(239, 68, 68, 0.25);
      background: rgba(239, 68, 68, 0.06);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 15px;
    }

    .stat {
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--surface-2);
      text-align: center;
    }

    .stat-value {
      display: block;
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 0.95rem;
      font-weight: 800;
      direction: ltr;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .stat-label {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 0.7rem;
    }

    .privacy-card {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 17px 20px;
      margin-top: 18px;
    }

    .privacy-icon {
      flex: 0 0 auto;
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.1);
      color: var(--success);
    }

    .privacy-card strong {
      display: block;
      font-size: 0.9rem;
    }

    .privacy-card span {
      color: var(--muted);
      font-size: 0.77rem;
    }

    .info-section,
    .how-card,
    .faq-section {
      padding: 27px;
      margin-top: 20px;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 22px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 1.45rem;
    }

    .section-heading p {
      max-width: 700px;
      margin: 7px auto 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .info-grid,
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 13px;
    }

    .info-box,
    .step {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface-2);
    }

    .info-box-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      margin-bottom: 12px;
      border-radius: 12px;
      background: rgba(37, 99, 235, 0.1);
      color: var(--primary);
    }

    .info-box h3,
    .step h3 {
      margin: 0 0 5px;
      font-size: 0.96rem;
    }

    .info-box p,
    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .step-number {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      margin-bottom: 11px;
      border-radius: 10px;
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--cyan));
      font-family: "JetBrains Mono", monospace;
      font-weight: 800;
    }

    .faq-list {
      display: grid;
      gap: 10px;
      max-width: 850px;
      margin: 0 auto;
    }

    details {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
      overflow: hidden;
    }

    summary {
      cursor: pointer;
      list-style: none;
      padding: 15px 17px;
      font-size: 0.88rem;
      font-weight: 800;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::after {
      content: "+";
      float: left;
      color: var(--primary);
      font-size: 1.1rem;
    }

    details[open] summary::after {
      content: "−";
    }

    details p {
      margin: 0;
      padding: 0 17px 16px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    @media (max-width: 900px) {
      .validator-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 850px) {
      .actions {
        grid-template-columns: 1fr 1fr;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .tool-header {
        align-items: flex-start;
      }
    }

    @media (max-width: 600px) {
      .page {
        padding: 22px 11px 45px;
      }

      .hero {
        padding: 18px 5px 25px;
      }

      .hero-icon {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        font-size: 1.45rem;
      }

      .hero p {
        font-size: 0.9rem;
      }

      .tool-card,
      .info-section,
      .how-card,
      .faq-section,
      .privacy-card {
        padding: 17px;
        border-radius: 18px;
      }

      .actions {
        grid-template-columns: 1fr;
      }

      .privacy-card {
        align-items: flex-start;
      }
    }

    @media (max-width: 390px) {
      .tool-header {
        flex-direction: column;
      }

      .live-badge {
        align-self: flex-start;
      }
    }
  </style>
</head>

<body>
  <Header />

  <main class="page">
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
  <a href="https://oumaystore-hub.github.io/Th-tech/">الرئيسية</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/">الأدوات</a>
  <span aria-hidden="true">←</span>

  <a href="https://oumaystore-hub.github.io/Th-tech/tools/?category=tools">
    أدوات تقنية
  </a>

  <span aria-hidden="true">←</span>

  <span aria-current="page">IP Address Validator</span>
</nav>

<style>
.tool-breadcrumbs {
  width: min(100% - 32px, 1000px);
  margin: 0 auto 18px;
  padding: 10px 14px;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  font-size: 13px;
  line-height: 1.7;

  color: #64748b;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  box-sizing: border-box;
}

.tool-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease;
}

.tool-breadcrumbs a:hover {
  text-decoration: underline;
}

.tool-breadcrumbs span[aria-hidden="true"] {
  color: #94a3b8;
}

.tool-breadcrumbs span[aria-current="page"] {
  color: #334155;
  font-weight: 600;
}

html.dark-mode .tool-breadcrumbs {
  color: #94a3b8;
  background: #111827;
  border-color: #263449;
}

html.dark-mode .tool-breadcrumbs a {
  color: #60a5fa;
}

html.dark-mode .tool-breadcrumbs span[aria-hidden="true"] {
  color: #64748b;
}

html.dark-mode .tool-breadcrumbs span[aria-current="page"] {
  color: #e2e8f0;
}

@media (max-width: 520px) {
  .tool-breadcrumbs {
    width: calc(100% - 20px);
    margin-bottom: 14px;
    padding: 8px 10px;
    font-size: 12px;
    gap: 5px;
  }
}
</style>
<!-- TH-BREADCRUMBS-END -->

    <div class="container">

      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href={`${base}/`}>الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <a href={`${base}/tools/`}>الأدوات</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>IP Address Validator</span>
      </nav>

      <section class="hero">
        <div class="hero-icon">
          <i class="fa-solid fa-network-wired"></i>
        </div>

        <div class="eyebrow">أداة الشبكات</div>

        <h1>IP Address Validator</h1>

        <p>
          تحقق من صحة عناوين IPv4 وIPv6 فورًا، واكتشف نوع العنوان
          وبعض خصائصه الأساسية مباشرة داخل المتصفح.
        </p>

        <div class="tags">
          <span class="tag">IPv4</span>
          <span class="tag">IPv6</span>
          <span class="tag">IP Address</span>
          <span class="tag">Network</span>
          <span class="tag">Validator</span>
        </div>
      </section>

      <section class="tool-card">

        <div class="tool-header">
          <div class="tool-title">
            <div class="tool-title-icon">
              <i class="fa-solid fa-network-wired"></i>
            </div>

            <div>
              <h2>مدقق عنوان IP</h2>
              <p>التحقق يتم تلقائيًا أثناء الكتابة</p>
            </div>
          </div>

          <div class="live-badge">
            <span class="live-dot"></span>
            فحص فوري
          </div>
        </div>

        <div class="validator-grid">

          <div class="panel">

            <div class="panel-header">
              <div class="panel-title">
