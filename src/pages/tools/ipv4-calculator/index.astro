  </style>

  <script>
    const ipInput = document.getElementById("ipInput");
    const cidrInput = document.getElementById("cidrInput");

    const errorBox = document.getElementById("errorBox");
    const errorText = document.getElementById("errorText");

    const networkAddress = document.getElementById("networkAddress");
    const broadcastAddress = document.getElementById("broadcastAddress");
    const subnetMask = document.getElementById("subnetMask");
    const wildcardMask = document.getElementById("wildcardMask");
    const firstHost = document.getElementById("firstHost");
    const lastHost = document.getElementById("lastHost");

    const cidrResult = document.getElementById("cidrResult");
    const totalAddresses = document.getElementById("totalAddresses");
    const usableHosts = document.getElementById("usableHosts");
    const ipType = document.getElementById("ipType");

    const binaryIp = document.getElementById("binaryIp");
    const binaryMask = document.getElementById("binaryMask");

    const networkTitle = document.getElementById("networkTitle");
    const validBadge = document.getElementById("validBadge");

    function parseIPv4(value) {
      const parts = value.trim().split(".");

      if (parts.length !== 4) return null;

      const nums = [];

      for (const part of parts) {
        if (!/^\d+$/.test(part)) return null;

        if (part.length > 1 && part.startsWith("0")) {
          return null;
        }

        const num = Number(part);

        if (num < 0 || num > 255) {
          return null;
        }

        nums.push(num);
      }

      return nums;
    }

    function ipToNumber(parts) {
      return (
        (((parts[0] * 256 + parts[1]) * 256 + parts[2]) * 256) +
        parts[3]
      ) >>> 0;
    }

    function numberToIp(num) {
      return [
        (num >>> 24) & 255,
        (num >>> 16) & 255,
        (num >>> 8) & 255,
        num & 255
      ].join(".");
    }

    function cidrToMask(cidr) {
      if (cidr === 0) return 0;

      return (0xffffffff << (32 - cidr)) >>> 0;
    }

    function isPrivateIP(parts) {
      const [a, b] = parts;

      if (a === 10) return true;

      if (a === 172 && b >= 16 && b <= 31) {
        return true;
      }

      if (a === 192 && b === 168) {
        return true;
      }

      return false;
    }

    function isLoopback(parts) {
      return parts[0] === 127;
    }

    function isLinkLocal(parts) {
      return parts[0] === 169 && parts[1] === 254;
    }

    function isMulticast(parts) {
      return parts[0] >= 224 && parts[0] <= 239;
    }

    function getIpType(parts) {
      if (isLoopback(parts)) return "Loopback";
      if (isMulticast(parts)) return "Multicast";
      if (isLinkLocal(parts)) return "Link-local";
      if (isPrivateIP(parts)) return "Private";

      if (
        parts[0] === 192 &&
        parts[1] === 0 &&
        parts[2] === 2
      ) {
        return "Documentation";
      }

      if (
        parts[0] === 198 &&
        parts[1] === 51 &&
        parts[2] === 100
      ) {
        return "Documentation";
      }

      if (
        parts[0] === 203 &&
        parts[1] === 0 &&
        parts[2] === 113
      ) {
        return "Documentation";
      }

      return "Public";
    }

    function toBinary(num) {
      return num
        .toString(2)
        .padStart(8, "0");
    }

    function ipToBinary(parts) {
      return parts.map(toBinary).join(".");
    }

    function formatNumber(num) {
      return new Intl.NumberFormat("en-US").format(num);
    }

    function showError(message) {
      errorText.textContent = message;
      errorBox.classList.add("show");
      validBadge.innerHTML =
        '<i class="fa-solid fa-xmark"></i> غير صالح';
      validBadge.style.color = "#fca5a5";
      validBadge.style.background = "rgba(239,68,68,.08)";
    }

    function hideError() {
      errorBox.classList.remove("show");
      validBadge.innerHTML =
        '<i class="fa-solid fa-check"></i> صالح';
      validBadge.style.color = "#86efac";
      validBadge.style.background = "rgba(34,197,94,.08)";
    }

    function calculate() {
      const parts = parseIPv4(ipInput.value);
      const cidr = Number(cidrInput.value);

      if (!parts) {
        showError("أدخل عنوان IPv4 صحيحًا مثل 192.168.1.10.");
        return;
      }

      if (
        !Number.isInteger(cidr) ||
        cidr < 0 ||
        cidr > 32
      ) {
        showError("قيمة CIDR يجب أن تكون بين /0 و /32.");
        return;
      }

      hideError();

      const ipNumber = ipToNumber(parts);
      const mask = cidrToMask(cidr);
      const wildcard = (~mask) >>> 0;

      const network = (ipNumber & mask) >>> 0;
      const broadcast = (network | wildcard) >>> 0;

      let first = network;
      let last = broadcast;
      let usable = broadcast - network + 1;

      if (cidr === 32) {
        first = network;
        last = network;
        usable = 1;
      } else if (cidr === 31) {
        first = network;
        last = broadcast;
        usable = 2;
      } else {
        first = (network + 1) >>> 0;
        last = (broadcast - 1) >>> 0;
        usable = broadcast - network - 1;
      }

      const total = broadcast - network + 1;

      networkAddress.textContent = numberToIp(network);
      broadcastAddress.textContent = numberToIp(broadcast);
      subnetMask.textContent = numberToIp(mask);
      wildcardMask.textContent = numberToIp(wildcard);
      firstHost.textContent = numberToIp(first);
      lastHost.textContent = numberToIp(last);

      cidrResult.textContent = `/${cidr}`;
      totalAddresses.textContent = formatNumber(total);
      usableHosts.textContent = formatNumber(usable);
      ipType.textContent = getIpType(parts);

      binaryIp.textContent = ipToBinary(parts);
      binaryMask.textContent = ipToBinary([
        (mask >>> 24) & 255,
        (mask >>> 16) & 255,
        (mask >>> 8) & 255,
        mask & 255
      ]);

      networkTitle.textContent =
        `${numberToIp(network)}/${cidr}`;
    }

    ipInput.addEventListener("input", calculate);
    cidrInput.addEventListener("input", calculate);

    document.querySelectorAll(".quick-btn").forEach(button => {
      button.addEventListener("click", () => {
        ipInput.value = button.dataset.ip;
        cidrInput.value = button.dataset.cidr;
        calculate();
      });
    });

    document.getElementById("resetBtn").addEventListener("click", () => {
      ipInput.value = "192.168.1.10";
      cidrInput.value = "24";
      calculate();
    });

    document.getElementById("copyBtn").addEventListener("click", async () => {
      const text = [
        `IPv4: ${ipInput.value}/${cidrInput.value}`,
        `Network: ${networkAddress.textContent}`,
        `Broadcast: ${broadcastAddress.textContent}`,
        `Subnet Mask: ${subnetMask.textContent}`,
        `Wildcard: ${wildcardMask.textContent}`,
        `First Host: ${firstHost.textContent}`,
        `Last Host: ${lastHost.textContent}`,
        `Total Addresses: ${totalAddresses.textContent}`,
        `Usable Hosts: ${usableHosts.textContent}`,
        `Type: ${ipType.textContent}`
      ].join("\n");

      try {
        await navigator.clipboard.writeText(text);

        const button = document.getElementById("copyBtn");
        const old = button.innerHTML;

        button.innerHTML =
          '<i class="fa-solid fa-check"></i> تم النسخ';

        setTimeout(() => {
          button.innerHTML = old;
        }, 1500);
      } catch {
        // Clipboard may be unavailable in some browsers.
      }
    });

    calculate();
  </script>
</body>
</html>
