---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const canonical =
  `https://oumaystore-hub.github.io${base}/tools/ipv4-calculator/`;

const title = 'IPv4 Calculator | حاسبة IPv4 | Th.Tech';
const description =
  'حاسبة IPv4 مجانية لحساب عنوان الشبكة والبث وقناع الشبكة وعدد العناوين والأجهزة والنطاق مباشرة داخل المتصفح.';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark-mode');
      }
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-orb orb-one"></div>
      <div class="hero-orb orb-two"></div>

      <div class="container">
        <div class="breadcrumbs">
          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>

          <i class="fa-solid fa-chevron-left"></i>

          <span>IPv4 Calculator</span>
        </div>

        <div class="hero-content">
          <div class="tool-icon">
            <i class="fa-solid fa-network-wired"></i>
          </div>

          <div class="eyebrow">
            <span></span>
            أداة شبكات مجانية
          </div>

          <h1>حاسبة <strong>IPv4</strong></h1>

          <p>
            احسب تفاصيل شبكة IPv4 بسرعة ودقة، بما في ذلك عنوان الشبكة،
            عنوان البث، النطاق، وقناع الشبكة وعدد الأجهزة.
          </p>

          <div class="tags">
            <span><i class="fa-solid fa-bolt"></i> حساب فوري</span>
            <span><i class="fa-solid fa-lock"></i> معالجة محلية</span>
            <span><i class="fa-solid fa-code"></i> CIDR</span>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-section">
      <div class="container">
        <div class="tool-card">

          <div class="card-header">
            <div>
              <div class="card-title">
                <i class="fa-solid fa-calculator"></i>
                حاسبة IPv4
              </div>
              <p>أدخل عنوان IPv4 وقيمة CIDR للحصول على تفاصيل الشبكة.</p>
            </div>

            <div class="live-status">
              <span></span>
              مباشر
            </div>
          </div>

          <div class="input-grid">

            <div class="field">
              <label for="ipInput">
                <i class="fa-solid fa-location-dot"></i>
                عنوان IPv4
              </label>

              <div class="input-wrap">
                <input
                  id="ipInput"
                  type="text"
                  inputmode="decimal"
                  dir="ltr"
                  autocomplete="off"
                  spellcheck="false"
                  value="192.168.1.10"
                  placeholder="192.168.1.10"
                />
              </div>
            </div>

            <div class="field">
              <label for="cidrInput">
                <i class="fa-solid fa-slash"></i>
                CIDR
              </label>

              <div class="cidr-control">
                <input
                  id="cidrInput"
                  type="number"
                  min="0"
                  max="32"
                  value="24"
                  dir="ltr"
                  inputmode="numeric"
                />
                <span>/</span>
              </div>
            </div>

          </div>

          <div class="quick-row">
            <button class="quick-btn" data-ip="192.168.1.10" data-cidr="24">
              192.168.1.10/24
            </button>

            <button class="quick-btn" data-ip="10.0.0.15" data-cidr="8">
              10.0.0.15/8
            </button>

            <button class="quick-btn" data-ip="172.16.5.20" data-cidr="16">
              172.16.5.20/16
            </button>

            <button class="quick-btn" data-ip="8.8.8.8" data-cidr="24">
              8.8.8.8/24
            </button>
          </div>

          <div class="error-box" id="errorBox">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span id="errorText">عنوان IPv4 غير صالح.</span>
          </div>

          <div class="result-head">
            <div>
              <h2>نتائج الحساب</h2>
              <p id="networkTitle">192.168.1.0/24</p>
            </div>

            <div class="valid-badge" id="validBadge">
              <i class="fa-solid fa-check"></i>
              صالح
            </div>
          </div>

          <div class="results-grid">

            <div class="result-box primary">
              <div class="result-label">
                <span>عنوان الشبكة</span>
                <i class="fa-solid fa-network-wired"></i>
              </div>
              <strong id="networkAddress">192.168.1.0</strong>
              <small>Network Address</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>عنوان البث</span>
                <i class="fa-solid fa-tower-broadcast"></i>
              </div>
              <strong id="broadcastAddress">192.168.1.255</strong>
              <small>Broadcast Address</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>قناع الشبكة</span>
                <i class="fa-solid fa-mask-face"></i>
              </div>
              <strong id="subnetMask">255.255.255.0</strong>
              <small>Subnet Mask</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>Wildcard Mask</span>
                <i class="fa-solid fa-filter"></i>
              </div>
              <strong id="wildcardMask">0.0.0.255</strong>
              <small>Wildcard</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>أول عنوان قابل للاستخدام</span>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
              <strong id="firstHost">192.168.1.1</strong>
              <small>First Host</small>
            </div>

            <div class="result-box">
              <div class="result-label">
                <span>آخر عنوان قابل للاستخدام</span>
                <i class="fa-solid fa-arrow-left"></i>
              </div>
              <strong id="lastHost">192.168.1.254</strong>
              <small>Last Host</small>
            </div>

          </div>

          <div class="stats-grid">

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
              </span>
              <div>
                <small>CIDR</small>
                <strong id="cidrResult">/24</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-hashtag"></i>
              </span>
              <div>
                <small>إجمالي العناوين</small>
                <strong id="totalAddresses">256</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-computer"></i>
              </span>
              <div>
                <small>الأجهزة القابلة للاستخدام</small>
                <strong id="usableHosts">254</strong>
              </div>
            </div>

            <div class="stat">
              <span class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </span>
              <div>
                <small>نوع العنوان</small>
                <strong id="ipType">Private</strong>
              </div>
            </div>

          </div>

          <div class="binary-card">
            <div class="binary-title">
              <i class="fa-solid fa-microchip"></i>
              التمثيل الثنائي
            </div>

            <div class="binary-row">
              <span>IP</span>
              <code id="binaryIp">11000000.10101000.00000001.00001010</code>
            </div>

            <div class="binary-row">
              <span>MASK</span>
              <code id="binaryMask">11111111.11111111.11111111.00000000</code>
            </div>
          </div>

          <div class="action-row">
            <button class="action-btn secondary" id="copyBtn">
              <i class="fa-regular fa-copy"></i>
              نسخ النتائج
            </button>

            <button class="action-btn secondary" id="resetBtn">
              <i class="fa-solid fa-rotate-right"></i>
              إعادة تعيين
            </button>
          </div>

        </div>

        <div class="privacy-card">
          <div class="privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <h3>خصوصيتك محفوظة</h3>
            <p>
              جميع الحسابات تتم داخل المتصفح مباشرة. لا يتم إرسال عنوان
              IP الذي تدخله إلى أي خادم.
            </p>
          </div>
        </div>

      </div>
    </section>

    <section class="info-section">
      <div class="container">

        <div class="section-heading">
          <span>دليل سريع</span>
          <h2>ما هي حاسبة IPv4؟</h2>
          <p>
            تساعدك هذه الأداة على تحليل شبكة IPv4 وتقسيمها ومعرفة
            نطاق العناوين المتاح داخل الشبكة.
          </p>
        </div>

        <div class="info-grid">

          <article class="info-card">
            <div class="info-number">01</div>
            <i class="fa-solid fa-network-wired"></i>
            <h3>عنوان الشبكة</h3>
            <p>
              هو أول عنوان في الشبكة ويستخدم لتعريف الشبكة نفسها.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">02</div>
            <i class="fa-solid fa-tower-broadcast"></i>
            <h3>عنوان البث</h3>
            <p>
              هو آخر عنوان في الشبكة ويستخدم لإرسال البيانات إلى
              جميع الأجهزة داخل الشبكة.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">03</div>
            <i class="fa-solid fa-layer-group"></i>
            <h3>CIDR</h3>
            <p>
              يحدد عدد البتات المستخدمة لجزء الشبكة مثل
              <code>/24</code> أو <code>/16</code>.
            </p>
          </article>

          <article class="info-card">
            <div class="info-number">04</div>
            <i class="fa-solid fa-computer"></i>
            <h3>Hosts</h3>
            <p>
              يمثل عدد عناوين IPv4 التي يمكن تخصيصها للأجهزة
              داخل الشبكة.
            </p>
          </article>

        </div>

      </div>
    </section>

    <section class="how-section">
      <div class="container">

        <div class="section-heading">
          <span>طريقة الاستخدام</span>
          <h2>كيف تستخدم الأداة؟</h2>
        </div>

        <div class="steps">

          <div class="step">
            <span>1</span>
            <div>
              <h3>أدخل عنوان IPv4</h3>
              <p>مثال: 192.168.1.10</p>
            </div>
          </div>

          <div class="step">
            <span>2</span>
            <div>
              <h3>حدد CIDR</h3>
              <p>مثال: /24 أو /16 أو /8.</p>
            </div>
          </div>

          <div class="step">
            <span>3</span>
            <div>
              <h3>شاهد النتائج</h3>
              <p>
                يتم حساب الشبكة والنطاق والبث والأجهزة بشكل فوري.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <section class="faq-section">
      <div class="container">

        <div class="section-heading">
          <span>FAQ</span>
          <h2>الأسئلة الشائعة</h2>
        </div>

        <div class="faq-list">

          <details>
            <summary>
              ما الفرق بين IP و Network Address؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <p>
              عنوان IP يمثل جهازًا أو واجهة شبكة، بينما Network Address
              يمثل الشبكة نفسها ولا يُستخدم عادةً لتعيين جهاز.
            </p>
          </details>

          <details>
            <summary>
              ماذا يعني /24؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <p>
              يعني أن أول 24 بت من عنوان IPv4 مخصصة لجزء الشبكة،
              ويكون القناع المقابل لها 255.255.255.0.
            </p>
          </details>

          <details>
            <summary>
              هل يمكنني استخدام الأداة دون اتصال بالإنترنت؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <p>
              نعم. الحسابات نفسها تتم محليًا داخل المتصفح ولا تحتاج
              إلى إرسال البيانات إلى خادم خارجي.
            </p>
          </details>

          <details>
            <summary>
              هل الأداة تدعم جميع قيم CIDR؟
              <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <p>
              نعم، يمكنك استخدام أي قيمة من /0 إلى /32.
            </p>
          </details>

        </div>

      </div>
    </section>
  

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/chmod-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Chmod Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/cidr-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Cidr Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv6-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Ipv6 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/subnet-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Subnet Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

  <Footer />

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background: #07111f;
      color: #eaf4ff;
    }

    :global(body),
    :global(button),
    :global(input) {
      font-family: "Cairo", sans-serif;
    }

    :global(code),
    .result-box strong,
    .binary-row code {
      font-family: "JetBrains Mono", monospace;
    }

    :global(html[data-theme="light"] body) {
      background: #f4f9ff;
      color: #102033;
    }

    .container {
      width: min(1160px, calc(100% - 32px));
      margin: auto;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 44px 0 78px;
      background:
        radial-gradient(circle at 15% 25%, rgba(56,189,248,.15), transparent 28%),
        radial-gradient(circle at 85% 20%, rgba(37,99,235,.18), transparent 30%),
        linear-gradient(145deg, #07111f, #0a1830 60%, #07111f);
    }

    :global(html[data-theme="light"]) .hero {
      background:
        radial-gradient(circle at 15% 25%, rgba(56,189,248,.16), transparent 28%),
        radial-gradient(circle at 85% 20%, rgba(37,99,235,.13), transparent 30%),
        linear-gradient(145deg, #f2f9ff, #eaf5ff);
    }

    .hero-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(2px);
      pointer-events: none;
    }

    .orb-one {
      width: 180px;
      height: 180px;
      top: -80px;
      right: 8%;
      background: rgba(14,165,233,.1);
    }

    .orb-two {
      width: 140px;
      height: 140px;
      bottom: -70px;
      left: 8%;
      background: rgba(59,130,246,.1);
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      color: #91a9c3;
      font-size: .82rem;
      margin-bottom: 48px;
    }

    .breadcrumbs a {
      color: #a9c6e3;
      text-decoration: none;
      transition: .2s;
    }

    .breadcrumbs a:hover {
      color: #38bdf8;
    }

    .breadcrumbs i {
      font-size: .65rem;
      opacity: .55;
    }

    .hero-content {
      max-width: 760px;
    }

    .tool-icon {
      width: 66px;
      height: 66px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      margin-bottom: 22px;
      font-size: 1.65rem;
      color: #e0f7ff;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      box-shadow: 0 15px 45px rgba(14,165,233,.25);
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 9px;
      color: #38bdf8;
      font-size: .88rem;
      font-weight: 700;
      margin-bottom: 9px;
    }

    .eyebrow span,
    .live-status span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
