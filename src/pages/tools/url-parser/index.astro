---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "URL Parser - تحليل URL أونلاين مجاناً | Th.Tech";

const description =
  "أداة URL Parser مجانية لتحليل عناوين URL واستخراج البروتوكول والنطاق والمنفذ والمسار والمعلمات وFragment مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة URL Parser؟",
    a: "URL Parser تقوم بتقسيم عنوان URL إلى مكوناته الأساسية مثل البروتوكول والنطاق والمنفذ والمسار ومعلمات البحث وFragment."
  },
  {
    q: "هل يمكنني تحليل URL يحتوي على Query Parameters؟",
    a: "نعم. تقوم الأداة باستخراج Query String وتحليل المعلمات الموجودة فيه وعرضها بشكل منفصل."
  },
  {
    q: "هل يتم إرسال عنوان URL إلى الخادم؟",
    a: "لا. تتم عملية التحليل بالكامل داخل المتصفح، لذلك لا تحتاج الأداة إلى إرسال الرابط إلى خادم خارجي."
  },
  {
    q: "ما الفرق بين URL Parser وURL Validator؟",
    a: "Validator يركز على التحقق من صحة الرابط، بينما Parser يقوم بتقسيم الرابط الصحيح إلى مكوناته وتحليل كل جزء منه."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>URL Parser</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-magnifying-glass-chart"></i>
            <span>URL</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>URL Parser</h1>

            <p>
              حلّل أي عنوان URL واستخرج مكوناته الأساسية
              بسرعة ووضوح من داخل المتصفح.
            </p>

            <div class="tags">
              <span>URL Parser</span>
              <span>Query Params</span>
              <span>URL Parts</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="parser-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-magnifying-glass-chart"></i>
              URL Parser
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button id="parseBtn" class="btn btn-primary">
              <i class="fa-solid fa-magnifying-glass-chart"></i>
              تحليل URL
            </button>

          </div>


          <!-- INPUT -->
          <div class="input-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-link"></i>
                عنوان URL
              </div>

              <span id="inputCount">0 حرف</span>

            </div>

            <div class="url-editor">

              <div class="url-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <textarea
                id="urlInput"
                rows="3"
                spellcheck="false"
                placeholder="https://example.com:8080/path/page?name=thtech&lang=ar#result"
              ></textarea>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للتحليل
              </strong>

              <p id="resultMessage">
                أدخل عنوان URL ثم اضغط على تحليل URL.
              </p>

            </div>

          </div>


          <!-- URL COMPONENTS -->
          <div class="components-panel" id="componentsPanel">

            <div class="panel-title">
              <i class="fa-solid fa-layer-group"></i>
              مكونات URL
            </div>

            <div class="components-grid">

              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-globe"></i>
                </div>

                <div class="component-content">
                  <span>Protocol</span>
                  <strong id="protocolValue">—</strong>
                </div>
              </div>


              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-server"></i>
                </div>

                <div class="component-content">
                  <span>Hostname</span>
                  <strong id="hostnameValue">—</strong>
                </div>
              </div>


              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-plug"></i>
                </div>

                <div class="component-content">
                  <span>Port</span>
                  <strong id="portValue">—</strong>
                </div>
              </div>


              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-folder-tree"></i>
                </div>

                <div class="component-content">
                  <span>Pathname</span>
                  <strong id="pathnameValue">—</strong>
                </div>
              </div>


              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <div class="component-content">
                  <span>Search</span>
                  <strong id="searchValue">—</strong>
                </div>
              </div>


              <div class="component">
                <div class="component-icon">
                  <i class="fa-solid fa-hashtag"></i>
                </div>

                <div class="component-content">
                  <span>Hash</span>
                  <strong id="hashValue">—</strong>
                </div>
              </div>


              <div class="component full">
                <div class="component-icon">
                  <i class="fa-solid fa-link"></i>
                </div>

                <div class="component-content">
                  <span>Origin</span>
                  <strong id="originValue">—</strong>
                </div>
              </div>

            </div>

          </div>


          <!-- QUERY PARAMETERS -->
          <div class="query-panel" id="queryPanel">

            <div class="panel-title">
              <i class="fa-solid fa-list"></i>
              Query Parameters
            </div>

            <div id="queryList" class="query-list">

              <div class="empty-query">
                لا توجد معلمات Query.
              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>طول URL</span>
                <strong id="statLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-list"></i>
              </div>

              <div>
                <span>Parameters</span>
                <strong id="statParams">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <span>Protocol</span>
                <strong id="statProtocol">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>URL PARSER</span>

          <h2>
            ما هو URL Parser؟
          </h2>

          <p>
            أداة تساعد المطورين على تفكيك عناوين URL
            ومعرفة كل مكون من مكوناته بشكل واضح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-puzzle-piece"></i>
            </div>

            <h3>
              تقسيم URL
            </h3>

            <p>
              قم بتقسيم الرابط إلى البروتوكول والنطاق
              والمنفذ والمسار وبقية المكونات.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-list-check"></i>
            </div>

            <h3>
              Query Parameters
            </h3>

            <p>
              استخرج جميع معاملات البحث وقيمها من عنوان
              URL واعرضها بطريقة منظمة.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>
              معالجة محلية
            </h3>

            <p>
              تتم عملية تحليل الرابط داخل المتصفح دون
              الحاجة إلى رفع البيانات إلى الخادم.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام URL Parser
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل الرابط
              </h3>

              <p>
                الصق عنوان URL الذي تريد تحليله داخل المحرر.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                ابدأ التحليل
              </h3>

              <p>
                اضغط على زر تحليل URL لاستخراج المكونات.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                راجع النتائج
              </h3>

              <p>
                ستظهر جميع مكونات الرابط ومعلمات البحث بالتفصيل.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/url-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/url-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/url-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/cron-parser/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Cron Parser</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/query-string-parser/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Query String Parser</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/user-agent-parser/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>User Agent Parser</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const input =
        document.getElementById("urlInput");

      const parseBtn =
        document.getElementById("parseBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");


      const inputCount =
        document.getElementById("inputCount");


      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");


      const componentsPanel =
        document.getElementById("componentsPanel");

      const queryPanel =
        document.getElementById("queryPanel");

      const queryList =
        document.getElementById("queryList");


      const protocolValue =
        document.getElementById("protocolValue");

      const hostnameValue =
        document.getElementById("hostnameValue");

      const portValue =
        document.getElementById("portValue");

      const pathnameValue =
        document.getElementById("pathnameValue");

      const searchValue =
        document.getElementById("searchValue");

      const hashValue =
        document.getElementById("hashValue");

      const originValue =
        document.getElementById("originValue");


      const statLength =
        document.getElementById("statLength");

      const statParams =
        document.getElementById("statParams");

      const statProtocol =
        document.getElementById("statProtocol");

      const statStatus =
        document.getElementById("statStatus");


      function updateCount() {

        const length =
          input.value.length;

        inputCount.textContent =
          `${length.toLocaleString()} حرف`;

        statLength.textContent =
          length.toLocaleString();
      }


      function resetUI() {

        protocolValue.textContent = "—";
        hostnameValue.textContent = "—";
        portValue.textContent = "—";
        pathnameValue.textContent = "—";
        searchValue.textContent = "—";
        hashValue.textContent = "—";
        originValue.textContent = "—";

        statParams.textContent = "0";
        statProtocol.textContent = "—";

        statStatus.textContent =
          "جاهز";

        componentsPanel.classList.remove(
          "visible"
        );

        queryPanel.classList.remove(
          "visible"
        );

        queryList.innerHTML =
          '<div class="empty-query">لا توجد معلمات Query.</div>';
      }


      function showSuccess(message) {

        resultBox.classList.remove(
          "error"
        );

        resultBox.classList.add(
          "success"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم تحليل URL بنجاح";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "تم التحليل";
      }


      function showError(message) {

        resultBox.classList.remove(
          "success"
        );

        resultBox.classList.add(
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر تحليل URL";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";

        componentsPanel.classList.remove(
          "visible"
        );

        queryPanel.classList.remove(
          "visible"
        );

        statParams.textContent =
          "0";

        statProtocol.textContent =
          "—";
      }


      function showReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز للتحليل";

        resultMessage.textContent =
          "أدخل عنوان URL ثم اضغط على تحليل URL.";

        statStatus.textContent =
          "جاهز";
      }


      function createQueryRows(searchParams) {

        queryList.innerHTML = "";

        if (searchParams.size === 0) {

          queryList.innerHTML =
            '<div class="empty-query">لا توجد معلمات Query في هذا الرابط.</div>';

          queryPanel.classList.add(
            "visible"
          );

          statParams.textContent =
            "0";

          return;
        }


        let count = 0;


        searchParams.forEach(
          (value, key) => {

            count++;

            const row =
              document.createElement("div");

            row.className =
              "query-row";


            const keyBox =
              document.createElement("div");

            keyBox.className =
              "query-key";


            const keyLabel =
              document.createElement("span");

            keyLabel.textContent =
              "KEY";


            const keyValue =
              document.createElement("strong");

            keyValue.textContent =
              key;


            keyBox.appendChild(
              keyLabel
            );

            keyBox.appendChild(
              keyValue
            );


            const valueBox =
              document.createElement("div");

            valueBox.className =
              "query-value";


            const valueLabel =
              document.createElement("span");

            valueLabel.textContent =
              "VALUE";


            const valueText =
              document.createElement("strong");

            valueText.textContent =
              value || "(فارغة)";


            valueBox.appendChild(
              valueLabel
            );

            valueBox.appendChild(
              valueText
            );


            row.appendChild(
              keyBox
            );

            row.appendChild(
              valueBox
            );


            queryList.appendChild(
              row
            );

          }
        );


        statParams.textContent =
          count.toLocaleString();


        queryPanel.classList.add(
          "visible"
        );
      }


      function parseURL() {

        const value =
          input.value.trim();


        updateCount();


        if (!value) {

          showError(
            "أدخل عنوان URL أولاً."
          );

          return;
        }


        const start =
          performance.now();


        try {

          const url =
            new URL(value);


          protocolValue.textContent =
            url.protocol.replace(
              ":",
              ""
            ).toUpperCase();


          hostnameValue.textContent =
            url.hostname ||
            "—";


          portValue.textContent =
            url.port ||
            "الافتراضي";


          pathnameValue.textContent =
            url.pathname ||
            "/";


          searchValue.textContent =
            url.search ||
            "لا يوجد";


          hashValue.textContent =
            url.hash ||
            "لا يوجد";


          originValue.textContent =
            url.origin;


          statProtocol.textContent =
            url.protocol
              .replace(":", "")
              .toUpperCase();


          createQueryRows(
            url.searchParams
          );


          componentsPanel.classList.add(
            "visible"
          );


          const elapsed =
            performance.now() - start;


          showSuccess(
            `تم استخراج مكونات الرابط خلال ${elapsed.toFixed(2)} ms.`
          );

        } catch {

          showError(
            "عنوان URL غير صالح أو غير قابل للتحليل. تأكد من كتابة الرابط بالشكل الصحيح."
          );
        }
      }


      function loadExample() {

        input.value =
          "https://example.com:8080/products/details?category=tech&lang=ar&page=2#specifications";

        updateCount();

        parseURL();
      }


      function clearAll() {

        input.value = "";

        updateCount();

        resetUI();

        showReady();

        input.focus();
      }


      async function copyURL() {

        const value =
          input.value.trim();


        if (!value) {

          showError(
            "لا يوجد URL لنسخه."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);

        } catch {

          input.select();

          document.execCommand(
            "copy"
          );


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ';

          }, 1500);
        }
      }


      input.addEventListener(
        "input",
        updateCount
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            parseURL();
          }

        }
      );


      parseBtn.addEventListener(
        "click",
        parseURL
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyURL
      );


      updateCount();

      resetUI();

    })();
  </script>


