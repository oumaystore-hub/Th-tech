---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CIDR Calculator - حاسبة CIDR أونلاين مجاناً | Th.Tech";

const description =
  "حاسبة CIDR مجانية لحساب Network Address وBroadcast وSubnet Mask وWildcard وأول وآخر عنوان وعدد العناوين مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة CIDR Calculator؟",
    a: "CIDR Calculator تقوم بتحليل عنوان IPv4 مع Prefix Length مثل /24 وحساب معلومات الشبكة والـSubnet Mask والـBroadcast ونطاق عناوين الأجهزة."
  },
  {
    q: "ماذا يعني /24؟",
    a: "يشير /24 إلى أن أول 24 بت من عنوان IPv4 مخصصة للشبكة، بينما تبقى 8 بت لعناوين الأجهزة داخل الشبكة."
  },
  {
    q: "هل يتم إرسال عنوان IP إلى الخادم؟",
    a: "لا. جميع الحسابات تتم داخل المتصفح باستخدام JavaScript، ولا يتم إرسال عنوان IP إلى خادم خارجي."
  },
  {
    q: "هل تدعم الأداة /31 و /32؟",
    a: "نعم. تدعم الأداة جميع Prefix Length من /0 إلى /32، مع معالجة خاصة لشبكات /31 و/32."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={`https://oumaystore-hub.github.io${base}/tools/cidr-calculator/`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>CIDR Calculator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-network-wired"></i>
            <span>CIDR</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-network-wired"></i>
              Network & Subnetting
            </div>

            <h1>CIDR Calculator</h1>

            <p>
              احسب معلومات شبكة IPv4 بسهولة،
              من Network Address وBroadcast إلى Subnet Mask
              ونطاق عناوين الأجهزة.
            </p>

            <div class="tags">
              <span>IPv4</span>
              <span>CIDR</span>
              <span>Subnetting</span>
              <span>Network Calculator</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="cidr-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-network-wired"></i>
              CIDR Calculator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ النتائج
            </button>

            <button id="calculateBtn" class="btn btn-primary">
              <i class="fa-solid fa-calculator"></i>
              حساب CIDR
            </button>

          </div>


          <!-- INPUT -->
          <div class="input-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-network-wired"></i>
                عنوان IPv4 وPrefix
              </div>

              <span id="inputStatus">
                IPv4 / CIDR
              </span>

            </div>

            <div class="cidr-input-grid">

              <div class="field-box">

                <label for="ipInput">
                  <i class="fa-solid fa-globe"></i>
                  IPv4 Address
                </label>

                <input
                  id="ipInput"
                  type="text"
                  value="192.168.1.0"
                  inputmode="decimal"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="192.168.1.0"
                />

              </div>


              <div class="slash-box">
                /
              </div>


              <div class="field-box prefix-field">

                <label for="prefixInput">
                  <i class="fa-solid fa-hashtag"></i>
                  Prefix Length
                </label>

                <input
                  id="prefixInput"
                  type="number"
                  min="0"
                  max="32"
                  value="24"
                  inputmode="numeric"
                />

              </div>

            </div>


            <!-- QUICK EXAMPLES -->
            <div class="quick-section">

              <div class="quick-title">
                <i class="fa-solid fa-bolt"></i>
                أمثلة سريعة
              </div>

              <div class="quick-list">

                <button class="quick-btn" data-ip="192.168.1.0" data-prefix="24">
                  192.168.1.0/24
                </button>

                <button class="quick-btn" data-ip="10.0.0.0" data-prefix="8">
                  10.0.0.0/8
                </button>

                <button class="quick-btn" data-ip="172.16.0.0" data-prefix="16">
                  172.16.0.0/16
                </button>

                <button class="quick-btn" data-ip="192.168.10.64" data-prefix="26">
                  192.168.10.64/26
                </button>

                <button class="quick-btn" data-ip="192.168.1.128" data-prefix="25">
                  192.168.1.128/25
                </button>

              </div>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للحساب
              </strong>

              <p id="resultMessage">
                أدخل عنوان IPv4 وPrefix Length ثم اضغط على حساب CIDR.
              </p>

            </div>

          </div>


          <!-- RESULTS -->
          <div class="results-panel" id="resultsPanel">

            <div class="panel-title">
              <i class="fa-solid fa-layer-group"></i>
              نتائج تحليل الشبكة
            </div>

            <div class="results-grid">

              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-house"></i>
                </div>

                <div class="result-item-content">
                  <span>Network Address</span>
                  <strong id="networkValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="networkValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-tower-broadcast"></i>
                </div>

                <div class="result-item-content">
                  <span>Broadcast Address</span>
                  <strong id="broadcastValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="broadcastValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-mask-face"></i>
                </div>

                <div class="result-item-content">
                  <span>Subnet Mask</span>
                  <strong id="maskValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="maskValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-eraser"></i>
                </div>

                <div class="result-item-content">
                  <span>Wildcard Mask</span>
                  <strong id="wildcardValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="wildcardValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-arrow-right"></i>
                </div>

                <div class="result-item-content">
                  <span>First Host</span>
                  <strong id="firstHostValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="firstHostValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-arrow-left"></i>
                </div>

                <div class="result-item-content">
                  <span>Last Host</span>
                  <strong id="lastHostValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="lastHostValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-code"></i>
                </div>

                <div class="result-item-content">
                  <span>CIDR</span>
                  <strong id="cidrValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="cidrValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-cubes"></i>
                </div>

                <div class="result-item-content">
                  <span>Total Addresses</span>
                  <strong id="totalValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="totalValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-users"></i>
                </div>

                <div class="result-item-content">
                  <span>Usable Hosts</span>
                  <strong id="usableValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="usableValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item">
                <div class="result-item-icon">
                  <i class="fa-solid fa-tag"></i>
                </div>

                <div class="result-item-content">
                  <span>Network Type</span>
                  <strong id="typeValue">—</strong>
                </div>
              </div>


              <div class="result-item full">
                <div class="result-item-icon">
                  <i class="fa-solid fa-binary"></i>
                </div>

                <div class="result-item-content">
                  <span>Binary Representation</span>
                  <strong id="binaryValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="binaryValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>


              <div class="result-item full">
                <div class="result-item-icon">
                  <i class="fa-solid fa-link"></i>
                </div>

                <div class="result-item-content">
                  <span>Network / CIDR</span>
                  <strong id="networkCidrValue">—</strong>
                </div>

                <button class="mini-copy" data-copy="networkCidrValue">
                  <i class="fa-regular fa-copy"></i>
                </button>
              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-hashtag"></i>
              </div>

              <div>
                <span>Prefix</span>
                <strong id="statPrefix">/24</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-microchip"></i>
              </div>

              <div>
                <span>Host Bits</span>
                <strong id="statHostBits">8</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-network-wired"></i>
              </div>

              <div>
                <span>Network Bits</span>
                <strong id="statNetworkBits">24</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>Addresses</span>
                <strong id="statAddresses">256</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>CIDR CALCULATOR</span>

          <h2>
            ما هو CIDR؟
          </h2>

          <p>
            CIDR هو اختصار لـ Classless Inter-Domain Routing،
            ويستخدم لتحديد حجم شبكة IPv4 ونطاق عناوينها بطريقة مرنة.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-network-wired"></i>
            </div>

            <h3>
              Network Address
            </h3>

            <p>
              تحدد الأداة عنوان بداية الشبكة بناءً على
              عنوان IPv4 والـPrefix المحدد.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-mask-face"></i>
            </div>

            <h3>
              Subnet Mask
            </h3>

            <p>
              يتم تحويل Prefix Length مثل /24 إلى
              Subnet Mask مثل 255.255.255.0.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-arrows-left-right"></i>
            </div>

            <h3>
              Host Range
            </h3>

            <p>
              تعرض الأداة أول وآخر عنوان قابل للاستخدام
              داخل الشبكة بالإضافة إلى عنوان Broadcast.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام CIDR Calculator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل عنوان IPv4
              </h3>

              <p>
                أدخل عنوان الشبكة أو أي عنوان IPv4
                تريد حساب معلومات الشبكة الخاصة به.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                حدد Prefix
              </h3>

              <p>
                اختر قيمة من /0 إلى /32 مثل /24 أو /16
                لتحديد حجم الشبكة.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                راجع النتائج
              </h3>

              <p>
                ستظهر Network وBroadcast وMask
                ونطاق الأجهزة وعدد العناوين مباشرة.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/chmod-calculator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Chmod Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv4-calculator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Ipv4 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv6-calculator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Ipv6 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/subnet-calculator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Subnet Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
  </div>
</section>

<style>
  /* =========================================
     Related Tools
     الوضع الافتراضي = فاتح
     ========================================= */

  .related-tools {
    width: min(1000px, 100%);
    margin: 40px auto 25px;
    padding: 22px;

    border-radius: 18px;

    background: #ffffff !important;
    color: #0f172a !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 8px 24px rgba(15, 23, 42, 0.06) !important;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .related-tools-header {
    margin-bottom: 17px;
  }

  .related-tools-label {
    display: inline-block;

    margin-bottom: 5px;

    color: #0284c7 !important;

    font-size: 0.78rem;
    font-weight: 800;
  }

  .related-tools h2 {
    margin: 0 0 5px;

    color: #0f172a !important;

    font-size: 1.3rem;
    line-height: 1.4;
    font-weight: 800;
  }

  .related-tools p {
    margin: 0;

    color: #64748b !important;

    font-size: 0.85rem;
  }

  /* =========================================
     Cards
     ========================================= */

  .related-tools-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;

    gap: 9px;

    min-height: 58px;

    padding: 9px 10px;

    border-radius: 12px;

    text-decoration: none !important;

    color: #0f172a !important;

    background: #f8fafc !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.035) !important;

    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-2px);

    color: #0f172a !important;

    background: #f0f9ff !important;

    border-color: #38bdf8 !important;

    box-shadow:
      0 6px 14px rgba(14, 165, 233, 0.10) !important;
  }

  /* =========================================
     SVG icon
     ========================================= */

  .related-tool-icon {
    display: grid;
    place-items: center;

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    border-radius: 9px;

    color: #0284c7 !important;

    background: rgba(14, 165, 233, 0.10) !important;
  }

  .related-tool-icon svg {
    width: 18px;
    height: 18px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

