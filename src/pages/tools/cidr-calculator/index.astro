  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const ipInput =
        document.getElementById("ipInput");

      const prefixInput =
        document.getElementById("prefixInput");

      const calculateBtn =
        document.getElementById("calculateBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");


      const inputStatus =
        document.getElementById("inputStatus");


      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");


      const resultsPanel =
        document.getElementById("resultsPanel");


      const networkValue =
        document.getElementById("networkValue");

      const broadcastValue =
        document.getElementById("broadcastValue");

      const maskValue =
        document.getElementById("maskValue");

      const wildcardValue =
        document.getElementById("wildcardValue");

      const firstHostValue =
        document.getElementById("firstHostValue");

      const lastHostValue =
        document.getElementById("lastHostValue");

      const cidrValue =
        document.getElementById("cidrValue");

      const totalValue =
        document.getElementById("totalValue");

      const usableValue =
        document.getElementById("usableValue");

      const typeValue =
        document.getElementById("typeValue");

      const binaryValue =
        document.getElementById("binaryValue");

      const networkCidrValue =
        document.getElementById("networkCidrValue");


      const statPrefix =
        document.getElementById("statPrefix");

      const statHostBits =
        document.getElementById("statHostBits");

      const statNetworkBits =
        document.getElementById("statNetworkBits");

      const statAddresses =
        document.getElementById("statAddresses");


      function ipToNumber(ip) {

        const parts =
          ip.trim().split(".");

        if (parts.length !== 4) {
          return null;
        }

        const numbers =
          parts.map(part => {

            if (!/^\d+$/.test(part)) {
              return null;
            }

            const value =
              Number(part);

            if (
              value < 0 ||
              value > 255
            ) {
              return null;
            }

            return value;
          });


        if (
          numbers.some(
            value => value === null
          )
        ) {
          return null;
        }


        return (
          (
            numbers[0] * 16777216 +
            numbers[1] * 65536 +
            numbers[2] * 256 +
            numbers[3]
          ) >>> 0
        );
      }


      function numberToIp(number) {

        return [
          (number >>> 24) & 255,
          (number >>> 16) & 255,
          (number >>> 8) & 255,
          number & 255
        ].join(".");
      }


      function cidrToMask(prefix) {

        if (prefix === 0) {
          return 0;
        }

        return (
          (0xffffffff <<
            (32 - prefix)) >>> 0
        );
      }


      function numberToBinary(number) {

        return [
          ((number >>> 24) & 255)
            .toString(2)
            .padStart(8, "0"),

          ((number >>> 16) & 255)
            .toString(2)
            .padStart(8, "0"),

          ((number >>> 8) & 255)
            .toString(2)
            .padStart(8, "0"),

          (number & 255)
            .toString(2)
            .padStart(8, "0")
        ].join(".");
      }


      function formatNumber(number) {

        return Number(number)
          .toLocaleString();
      }


      function getType(ip) {

        const parts =
          ip.split(".").map(Number);

        const first =
          parts[0];

        const second =
          parts[1];


        if (first === 127) {
          return "Loopback";
        }


        if (
          first >= 224 &&
          first <= 239
        ) {
          return "Multicast";
        }


        if (
          first === 10 ||
          (
            first === 172 &&
            second >= 16 &&
            second <= 31
          ) ||
          (
            first === 192 &&
            second === 168
          )
        ) {
          return "Private";
        }


        if (
          first === 169 &&
          second === 254
        ) {
          return "Link-local";
        }


        if (
          (
            first === 192 &&
            second === 0
          ) ||
          (
            first === 198 &&
            second === 51
          ) ||
          (
            first === 203 &&
            second === 0
          )
        ) {
          return "Documentation";
        }


        return "Public";
      }


      function resetResults() {

        networkValue.textContent = "—";
        broadcastValue.textContent = "—";
        maskValue.textContent = "—";
        wildcardValue.textContent = "—";
        firstHostValue.textContent = "—";
        lastHostValue.textContent = "—";
        cidrValue.textContent = "—";
        totalValue.textContent = "—";
        usableValue.textContent = "—";
        typeValue.textContent = "—";
        binaryValue.textContent = "—";
        networkCidrValue.textContent = "—";

        statPrefix.textContent = "—";
        statHostBits.textContent = "—";
        statNetworkBits.textContent = "—";
        statAddresses.textContent = "—";

        inputStatus.textContent =
          "IPv4 / CIDR";

        resultsPanel.classList.remove(
          "visible"
        );
      }


      function showSuccess(message) {

        resultBox.classList.remove(
          "error"
        );

        resultBox.classList.add(
          "success"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم حساب CIDR بنجاح";

        resultMessage.textContent =
          message;

        inputStatus.textContent =
          "Valid";
      }


      function showError(message) {

        resultBox.classList.remove(
          "success"
        );

        resultBox.classList.add(
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر حساب CIDR";

        resultMessage.textContent =
          message;

        inputStatus.textContent =
          "Invalid";

        resultsPanel.classList.remove(
          "visible"
        );

        resetResults();
      }


      function showReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز للحساب";

        resultMessage.textContent =
          "أدخل عنوان IPv4 وPrefix Length ثم اضغط على حساب CIDR.";

        inputStatus.textContent =
          "IPv4 / CIDR";
      }


      function calculate() {

        const ip =
          ipInput.value.trim();

        const prefix =
          Number(prefixInput.value);


        if (!ip) {

          showError(
            "أدخل عنوان IPv4 أولاً."
          );

          return;
        }


        if (
          !Number.isInteger(prefix) ||
          prefix < 0 ||
          prefix > 32
        ) {

          showError(
            "Prefix Length يجب أن يكون رقماً صحيحاً بين 0 و32."
          );

          return;
        }


        const ipNumber =
          ipToNumber(ip);


        if (ipNumber === null) {

          showError(
            "عنوان IPv4 غير صالح. استخدم الصيغة مثل 192.168.1.0."
          );

          return;
        }


        const start =
          performance.now();


        const mask =
          cidrToMask(prefix);


        const wildcard =
          (~mask) >>> 0;


        const network =
          (ipNumber & mask) >>> 0;


        const broadcast =
          (network | wildcard) >>> 0;


        const hostBits =
          32 - prefix;


        const total =
          2 ** hostBits;


        let firstHost;
        let lastHost;
        let usable;


        if (prefix === 32) {

          firstHost =
            network;

          lastHost =
            network;

          usable =
            1;

        } else if (prefix === 31) {

          firstHost =
            network;

          lastHost =
            broadcast;

          usable =
            2;

        } else {

          firstHost =
            (network + 1) >>> 0;

          lastHost =
            (broadcast - 1) >>> 0;

          usable =
            Math.max(
              0,
              total - 2
            );
        }


        const networkIp =
          numberToIp(network);

        const broadcastIp =
          numberToIp(broadcast);

        const maskIp =
          numberToIp(mask);

        const wildcardIp =
          numberToIp(wildcard);

        const firstHostIp =
          numberToIp(firstHost);

        const lastHostIp =
          numberToIp(lastHost);


        networkValue.textContent =
          networkIp;

        broadcastValue.textContent =
          broadcastIp;

        maskValue.textContent =
          maskIp;

        wildcardValue.textContent =
          wildcardIp;

        firstHostValue.textContent =
          firstHostIp;

        lastHostValue.textContent =
          lastHostIp;

        cidrValue.textContent =
          `/${prefix}`;

        totalValue.textContent =
          formatNumber(total);

        usableValue.textContent =
          formatNumber(usable);

        typeValue.textContent =
          getType(ip);

        binaryValue.textContent =
          numberToBinary(ipNumber);

        networkCidrValue.textContent =
          `${networkIp}/${prefix}`;


        statPrefix.textContent =
          `/${prefix}`;

        statHostBits.textContent =
          hostBits.toString();

        statNetworkBits.textContent =
          prefix.toString();

        statAddresses.textContent =
          formatNumber(total);


        resultsPanel.classList.add(
          "visible"
        );


        const elapsed =
          performance.now() - start;


        showSuccess(
          `تم حساب معلومات الشبكة خلال ${elapsed.toFixed(2)} ms.`
        );
      }


      function loadExample() {

        ipInput.value =
          "192.168.10.64";

        prefixInput.value =
          "26";

        calculate();
      }


      function clearAll() {

        ipInput.value = "";

        prefixInput.value =
          "24";

        resetResults();

        showReady();

        ipInput.focus();
      }


      async function copyText(text) {

        if (!text || text === "—") {
          return false;
        }


        try {

          await navigator.clipboard.writeText(
            text
          );

          return true;

        } catch {

          const area =
            document.createElement("textarea");

          area.value =
            text;

          area.style.position =
            "fixed";

          area.style.opacity =
            "0";

          document.body.appendChild(
            area
          );

          area.select();

          const success =
            document.execCommand("copy");

          area.remove();

          return success;
        }
      }


      async function copyAll() {

        if (
          !resultsPanel.classList.contains(
            "visible"
          )
        ) {

          showError(
            "احسب CIDR أولاً ثم انسخ النتائج."
          );

          return;
        }


        const text = [
          `Network Address: ${networkValue.textContent}`,
          `Broadcast Address: ${broadcastValue.textContent}`,
          `Subnet Mask: ${maskValue.textContent}`,
          `Wildcard Mask: ${wildcardValue.textContent}`,
          `First Host: ${firstHostValue.textContent}`,
          `Last Host: ${lastHostValue.textContent}`,
          `CIDR: ${cidrValue.textContent}`,
          `Total Addresses: ${totalValue.textContent}`,
          `Usable Hosts: ${usableValue.textContent}`,
          `Network Type: ${typeValue.textContent}`,
          `Binary: ${binaryValue.textContent}`,
          `Network / CIDR: ${networkCidrValue.textContent}`
        ].join("\n");


        const success =
          await copyText(text);


        if (success) {

          const original =
            copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1600);
        }
      }


      async function copyMini(button) {

        const id =
          button.dataset.copy;

        const element =
          document.getElementById(id);

        if (!element) {
          return;
        }


        const text =
          element.textContent.trim();


        const success =
          await copyText(text);


        if (success) {

          const original =
            button.innerHTML;

          button.innerHTML =
            '<i class="fa-solid fa-check"></i>';

          setTimeout(() => {

            button.innerHTML =
              original;

          }, 1200);
        }
      }


      ipInput.addEventListener(
        "input",
        () => {

          if (
            resultsPanel.classList.contains(
              "visible"
            )
          ) {
            calculate();
          }

        }
      );


      prefixInput.addEventListener(
        "input",
        () => {

          if (
            resultsPanel.classList.contains(
              "visible"
            )
          ) {
            calculate();
          }

        }
      );


      ipInput.addEventListener(
        "keydown",
        event => {

          if (
            event.key === "Enter"
          ) {

            event.preventDefault();

            calculate();
          }

        }
      );


      prefixInput.addEventListener(
        "keydown",
        event => {

          if (
            event.key === "Enter"
          ) {

            event.preventDefault();

            calculate();
          }

        }
      );


      calculateBtn.addEventListener(
        "click",
        calculate
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyAll
      );


      document
        .querySelectorAll(".quick-btn")
        .forEach(button => {

          button.addEventListener(
            "click",
            () => {

              ipInput.value =
                button.dataset.ip;

              prefixInput.value =
                button.dataset.prefix;

              calculate();
            }
          );

        });


      document
        .querySelectorAll(".mini-copy")
        .forEach(button => {

          button.addEventListener(
            "click",
            () => {

              copyMini(button);
            }
          );

        });


      resetResults();

      showReady();

    })();
  </script>


