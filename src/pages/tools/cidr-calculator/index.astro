      min-height:
        55px;

      padding:
        0 20px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      border-bottom:
        1px solid
        var(--border);

      background:
        var(--surface-2);
    }


    .window-dots {

      display:
        flex;

      gap:
        6px;
    }


    .window-dots span {

      width:
        9px;

      height:
        9px;

      border-radius:
        50%;

      background:
        var(--border);
    }


    .tool-name {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--text);

      font:
        600 13px
        "JetBrains Mono",
        monospace;
    }


    .tool-name i {

      color:
        var(--primary);
    }


    .secure {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      color:
        var(--success);

      font-size:
        11px;

      font-weight:
        700;
    }


    /* ACTIONS */

    .actionbar {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        9px;

      padding:
        15px 18px;

      border-bottom:
        1px solid
        var(--border);
    }


    .btn {

      border:
        1px solid
        var(--border);

      border-radius:
        10px;

      padding:
        10px 15px;

      font-family:
        "Cairo",
        sans-serif;

      font-size:
        12px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        0.2s;
    }


    .btn:hover {

      transform:
        translateY(-1px);
    }


    .btn i {

      margin-left:
        6px;
    }


    .btn-secondary {

      color:
        var(--text);

      background:
        var(--surface-2);
    }


    .btn-primary {

      color:
        white;

      background:
        var(--primary);

      border-color:
        var(--primary);
    }


    .btn-primary:hover {

      background:
        var(--primary-dark);
    }


    /* INPUT */

    .input-section {

      margin:
        20px;

      overflow:
        hidden;

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .editor-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        11px 14px;

      border-bottom:
        1px solid
        var(--border);

      color:
        var(--muted);

      font-size:
        12px;

      font-weight:
        700;
    }


    .editor-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--text);
    }


    .editor-header i {

      color:
        var(--primary);
    }


    .editor-header span {

      font:
        10px
        "JetBrains Mono",
        monospace;
    }


    .cidr-input-grid {

      display:
        grid;

      grid-template-columns:
        1fr 42px 180px;

      align-items:
        end;

      gap:
        12px;

      padding:
        18px;
    }


    .field-box {

      min-width:
        0;
    }


    .field-box label {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      margin-bottom:
        8px;

      color:
        var(--muted);

      font-size:
        11px;

      font-weight:
        700;
    }


    .field-box label i {

      color:
        var(--primary);
    }


    .field-box input {

      width:
        100%;

      height:
        48px;

      padding:
        0 13px;

      border:
        1px solid
        var(--border);

      border-radius:
        11px;

      outline:
        none;

      background:
        var(--surface);

      color:
        var(--text);

      direction:
        ltr;

      text-align:
        left;

      font:
        500 14px
        "JetBrains Mono",
        monospace;

      transition:
        0.2s;
    }


    .field-box input:focus {

      border-color:
        var(--primary);

      box-shadow:
        0 0 0 3px
        rgba(8, 145, 178, 0.10);
    }


    .prefix-field input {

      text-align:
        center;
    }


    .slash-box {

      height:
        48px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      color:
        var(--primary);

      font:
        700 24px
        "JetBrains Mono",
        monospace;
    }


    /* QUICK */

    .quick-section {

      padding:
        0 18px 18px;
    }


    .quick-title {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      margin-bottom:
        9px;

      color:
        var(--muted);

      font-size:
        10px;

      font-weight:
        700;
    }


    .quick-title i {

      color:
        var(--primary);
    }


    .quick-list {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        7px;
    }


    .quick-btn {

      padding:
        7px 10px;

      border:
        1px solid
        var(--border);

      border-radius:
        8px;

      background:
        var(--surface);

      color:
        var(--muted);

      cursor:
        pointer;

      font:
        500 10px
        "JetBrains Mono",
        monospace;

      transition:
        0.2s;
    }


    .quick-btn:hover {

      color:
        var(--primary);

      border-color:
        var(--primary);

      transform:
        translateY(-1px);
    }


    /* RESULT */

    .result-box {

      margin:
        0 20px 15px;

      display:
        flex;

      align-items:
        center;

      gap:
        14px;

      padding:
        15px 17px;

      border:
        1px solid
        var(--border);

      border-radius:
        14px;

      background:
        var(--surface-2);
    }


    .result-icon {

      width:
        42px;

      height:
        42px;

      flex:
        0 0 42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      background:
        rgba(8, 145, 178, 0.10);

      color:
        var(--primary);

      font-size:
        17px;
    }


    .result-box strong {

      display:
        block;

      font-size:
        13px;
    }


    .result-box p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.7;
    }


    .result-box.success {

      border-color:
        rgba(22, 163, 74, 0.25);
    }


    .result-box.success .result-icon {

      color:
        var(--success);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .result-box.error {

      border-color:
        rgba(220, 38, 38, 0.25);
    }


    .result-box.error .result-icon {

      color:
        var(--danger);

      background:
        rgba(220, 38, 38, 0.10);
    }


    /* RESULTS */

    .results-panel {

      display:
        none;

      margin:
        0 20px 15px;

      padding:
        18px;

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .results-panel.visible {

      display:
        block;
    }


    .panel-title {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      margin-bottom:
        15px;

      font-size:
        13px;

      font-weight:
        800;
    }


    .panel-title i {

      color:
        var(--primary);
    }


    .results-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        10px;
    }


    .result-item {

      position:
        relative;

      min-width:
        0;

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      padding:
        13px;

      padding-left:
        42px;

      border:
        1px solid
        var(--border);

      border-radius:
        11px;

      background:
        var(--surface);
    }


    .result-item.full {

      grid-column:
        1 / -1;
    }


    .result-item-icon {

      width:
        36px;

      height:
        36px;

      flex:
        0 0 36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        9px;

      color:
        var(--primary);

      background:
        rgba(8, 145, 178, 0.10);
    }


    .result-item-content {

      min-width:
        0;
    }


    .result-item-content span {

      display:
        block;

      color:
        var(--muted);

      font:
        9px
        "JetBrains Mono",
        monospace;

      margin-bottom:
        3px;
    }


    .result-item-content strong {

      display:
        block;

      overflow:
        hidden;

      color:
        var(--text);

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      direction:
        ltr;

      text-align:
        left;

      font:
        500 11px
        "JetBrains Mono",
        monospace;
    }


    .mini-copy {

      position:
        absolute;

      left:
        9px;

      top:
        50%;

      transform:
        translateY(-50%);

      width:
        27px;

      height:
        27px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        var(--border);

      border-radius:
        7px;

      color:
        var(--muted);

      background:
        var(--surface-2);

      cursor:
        pointer;

      transition:
        0.2s;
    }


    .mini-copy:hover {

      color:
        var(--primary);

      border-color:
        var(--primary);
    }


    /* STATS */

    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        12px;

      padding:
        0 20px 20px;
    }


    .stat {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      min-width:
        0;

      padding:
        14px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface-2);
    }


    .stat-icon {

      width:
        36px;

      height:
        36px;

      flex:
        0 0 36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        9px;

      color:
        var(--primary);

      background:
        rgba(8, 145, 178, 0.10);
    }


    .stat span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        9px;
    }


    .stat strong {

      display:
        block;

      max-width:
        150px;

      overflow:
        hidden;

      margin-top:
        2px;

      color:
        var(--text);

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    /* SECTIONS */

    .info-section,
    .how-section,
    .faq-section {

      padding:
        70px 0;
    }


    .info-section {

      background:
        var(--surface-2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);
    }


    .section-heading {

      max-width:
        700px;

      margin:
        0 auto 35px;

      text-align:
        center;
    }


    .section-heading > span {

      color:
        var(--primary);

      font:
        700 11px
        "JetBrains Mono",
        monospace;

      letter-spacing:
        1px;
    }


    .section-heading h2 {

      margin:
        8px 0;

      font-size:
        clamp(
          25px,
          4vw,
          34px
        );
    }


    .section-heading p {

      margin:
        0;

      color:
        var(--muted);

      line-height:
        1.9;

      font-size:
        14px;
    }


    .info-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .info-card {

      padding:
        25px;

      border:
        1px solid
        var(--border);

      border-radius:
        17px;

      background:
        var(--surface);
    }


    .info-icon {

      width:
        48px;

      height:
        48px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        17px;

      border-radius:
        13px;

      color:
        var(--primary);

      background:
        rgba(8, 145, 178, 0.10);
    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size:
        16px;
    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        13px;

      line-height:
        1.9;
    }


    /* STEPS */

    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .step {

      display:
        flex;

      gap:
        15px;

      padding:
        22px;

      border:
        1px solid
        var(--border);

      border-radius:
        16px;

      background:
        var(--surface);
    }


    .step-number {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      color:
        white;

      background:
        var(--primary);

      font-weight:
        800;
    }


    .step h3 {

      margin:
        0 0 5px;

      font-size:
        14px;
    }


    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.8;
    }


    /* FAQ */

    .faq-list {

      max-width:
        850px;

      margin:
        auto;
    }


    details {

      margin-bottom:
        10px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface);

      overflow:
        hidden;
    }


    summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        17px 19px;

      cursor:
        pointer;

      font-size:
        13px;

      font-weight:
        700;

      list-style:
        none;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {

      color:
        var(--primary);

      transition:
        transform 0.2s;
    }


    details[open] summary i {

      transform:
        rotate(180deg);
    }


    details p {

      margin:
        0;

      padding:
        0 19px 18px;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 900px) {

      .results-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }
    }


    @media (max-width: 700px) {

      .cidr-input-grid {

        grid-template-columns:
          1fr;

        gap:
          10px;
      }


      .slash-box {

        display:
          none;
      }


      .results-grid {

        grid-template-columns:
          1fr 1fr;
      }


      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }
    }


    @media (max-width: 600px) {

      .container {

        width:
          min(
            100% - 22px,
            1180px
          );
      }


      .hero {

        padding-top:
          25px;
      }


      .hero-content {

        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .hero-icon {

        width:
          88px;

        height:
          88px;

        flex-basis:
          88px;

        border-radius:
          23px;
      }


      .hero-icon i {

        font-size:
          31px;
      }


      .card-topbar {

        padding:
          0 13px;
      }


      .actionbar {

        padding:
          12px;
      }


      .btn {

        flex:
          1 1
          calc(50% - 8px);

        padding:
          9px 8px;
      }


      .input-section {

        margin:
          12px;
      }


      .cidr-input-grid {

        padding:
          13px;
      }


      .quick-section {

        padding:
          0 13px 13px;
      }


      .field-box input {

        height:
          44px;

        font-size:
          12px;
      }


      .result-box {

        margin:
          0 12px 12px;
      }


      .results-panel {

        margin:
          0 12px 12px;

        padding:
          13px;
      }


      .results-grid {

        grid-template-columns:
          1fr;

        gap:
          8px;
      }


      .result-item.full {

        grid-column:
          auto;
      }


      .result-item {

        padding:
          10px;

        padding-left:
          40px;
      }


      .result-item-icon {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;
      }


      .result-item-content strong {

        font-size:
          9px;
      }


      .stats-grid {

        padding:
          0 12px 12px;

        gap:
          8px;
      }


      .stat {

        padding:
          11px 9px;
      }


      .stat-icon {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;
      }


      .stat span {

        font-size:
          8px;
      }


      .stat strong {

        max-width:
          95px;

        font-size:
          9px;
      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;
      }

    }

  </style>

</body>
</html>
