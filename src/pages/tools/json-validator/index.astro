---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "JSON Validator - التحقق من صحة JSON أونلاين مجاناً | Th.Tech";

const description =
  "أداة JSON Validator مجانية للتحقق من صحة JSON واكتشاف أخطاء الصياغة والبنية مباشرة من المتصفح.";
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/json-validator/`}
  />

  <link
    rel="icon"
    type="image/png"
    href={`${base}/logo1.png`}
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

</head>


<body>

  <Header />


  <main class="page">

    <!-- HEADER -->

    <section class="tool-hero">

      <div class="breadcrumb">

        <a href={`${base}/`}>
          الرئيسية
        </a>

        <i class="fas fa-chevron-left"></i>

        <a href={`${base}/tools/`}>
          أدوات المطورين
        </a>

        <i class="fas fa-chevron-left"></i>

        <span>
          JSON Validator
        </span>

      </div>


      <div class="tool-title">

        <div class="tool-icon">

          <i class="fas fa-circle-check"></i>

        </div>


        <div>

          <span class="eyebrow">
            DEVELOPER TOOL
          </span>

          <h1>
            JSON Validator
          </h1>

          <p>
            تحقّق من صحة JSON واكتشف الأخطاء في الصياغة والبنية بسهولة.
          </p>

        </div>

      </div>

    </section>


    <!-- TOOL -->

    <section class="workspace">


      <!-- TOOLBAR -->

      <div class="toolbar">


        <div class="toolbar-group">

          <button
            id="validateBtn"
            class="primary"
          >

            <i class="fas fa-circle-check"></i>

            تحقق

          </button>


          <button
            id="formatBtn"
          >

            <i class="fas fa-wand-magic-sparkles"></i>

            تنسيق

          </button>


          <button
            id="exampleBtn"
          >

            <i class="fas fa-flask"></i>

            مثال

          </button>

        </div>


        <div class="toolbar-group">

          <button
            id="copyBtn"
          >

            <i class="fas fa-copy"></i>

            نسخ

          </button>


          <button
            id="clearBtn"
          >

            <i class="fas fa-trash"></i>

            مسح

          </button>

        </div>


      </div>


      <!-- STATUS -->

      <div
        id="status"
        class="status"
        aria-live="polite"
      >

        <i class="fas fa-circle-info"></i>

        أدخل JSON ثم اضغط «تحقق».

      </div>


      <!-- EDITOR -->

      <div class="editor-grid">


        <div class="editor-card">


          <div class="editor-header">

            <span>

              <i class="fas fa-pen"></i>

              JSON INPUT

            </span>


            <span id="inputStats">
              0 chars
            </span>

          </div>


          <textarea
            id="input"
            spellcheck="false"
            placeholder={`{
  "name": "Th.Tech",
  "version": "1.0",
  "active": true
}`}
          ></textarea>


        </div>


      </div>


    </section>


    <!-- INFO -->

    <section class="info">


      <h2>
        JSON Validator أونلاين
      </h2>


      <p>
        JSON Validator من Th.Tech هي أداة مجانية تساعد المطورين
        على التحقق من صحة JSON واكتشاف أخطاء الصياغة والبنية بسرعة.
        تتم معالجة البيانات مباشرة داخل المتصفح دون الحاجة إلى رفعها إلى خادم.
      </p>


      <div class="info-grid">


        <div>

          <i class="fas fa-bolt"></i>

          <strong>
            سريعة
          </strong>

          <span>
            تحقق فوري من صحة JSON.
          </span>

        </div>


        <div>

          <i class="fas fa-lock"></i>

          <strong>
            خصوصية
          </strong>

          <span>
            البيانات تبقى داخل المتصفح.
          </span>

        </div>


        <div>

          <i class="fas fa-bug-slash"></i>

          <strong>
            كشف الأخطاء
          </strong>

          <span>
            تحديد موقع الخطأ في السطر والعمود.
          </span>

        </div>


      </div>


    </section>


  </main>


  <Footer />


<script>

const input =
  document.getElementById("input");


const status =
  document.getElementById("status");


const inputStats =
  document.getElementById("inputStats");


const validateBtn =
  document.getElementById("validateBtn");


const formatBtn =
  document.getElementById("formatBtn");


const exampleBtn =
  document.getElementById("exampleBtn");


const copyBtn =
  document.getElementById("copyBtn");


const clearBtn =
  document.getElementById("clearBtn");


/* =========================
   EXAMPLE
========================= */

const example = {

  name: "Th.Tech",

  website: "Developer Tools",

  language: "Arabic",

  free: true,

  tools: [
    "JSON Formatter",
    "JSON Validator",
    "HTML Formatter"
  ],

  features: {

    fast: true,

    private: true,

    responsive: true

  }

};


/* =========================
   STATS
========================= */

function updateStats() {

  inputStats.textContent =
    `${input.value.length} chars`;

}


/* =========================
   STATUS
========================= */

function showStatus(
  message,
  type = "info"
) {

  const icons = {

    info:
      "fa-circle-info",

    success:
      "fa-circle-check",

    error:
      "fa-circle-xmark"

  };


  status.className =
    `status ${type}`;


  status.innerHTML =
    `<i class="fas ${icons[type]}"></i> ${message}`;

}


/* =========================
   ERROR POSITION
========================= */

function getJSONError(error) {

  const message =
    error?.message ||
    "JSON غير صالح.";


  /*
    معظم المتصفحات الحديثة
    تعطي position داخل رسالة الخطأ
  */

  const match =
    message.match(
      /position\s+(\d+)/i
    );


  if (match) {

    const position =
      Number(match[1]);


    const before =
      input.value.slice(
        0,
        position
      );


    const line =
      before.split("\n").length;


    const lastNewLine =
      before.lastIndexOf("\n");


    const column =
      position -
      lastNewLine;


    return `
      JSON غير صالح — السطر ${line}،
      العمود ${column}.
    `;

  }


  /*
    دعم رسائل بعض المتصفحات
    مثل line/column
  */

  const lineMatch =
    message.match(
      /line\s+(\d+)/i
    );


  const columnMatch =
    message.match(
      /column\s+(\d+)/i
    );


  if (
    lineMatch &&
    columnMatch
  ) {

    return `
      JSON غير صالح — السطر
      ${lineMatch[1]}،
      العمود ${columnMatch[1]}.
    `;

  }


  return `
    JSON غير صالح: ${message}
  `;

}


/* =========================
   VALIDATE
========================= */

function validateJSON() {


  if (
    !input.value.trim()
  ) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }


  try {

    const data =
      JSON.parse(
        input.value
      );


    let type =
      Array.isArray(data)
        ? "Array"
        : data !== null &&
          typeof data === "object"
        ? "Object"
        : typeof data;


    showStatus(
      `JSON صالح ✓ — نوع البيانات: ${type}. لا توجد أخطاء في البنية.`,
      "success"
    );


    input.classList.remove(
      "invalid"
    );


    input.classList.add(
      "valid"
    );


  } catch (error) {


    showStatus(
      getJSONError(error),
      "error"
    );


    input.classList.remove(
      "valid"
    );


    input.classList.add(
      "invalid"
    );

  }

}


/* =========================
   FORMAT
========================= */

function formatJSON() {


  if (
    !input.value.trim()
  ) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }


  try {

    const data =
      JSON.parse(
        input.value
      );


    input.value =
      JSON.stringify(
        data,
        null,
        2
      );


    updateStats();


    input.classList.remove(
      "invalid"
    );


    input.classList.add(
      "valid"
    );


    showStatus(
      "JSON صالح وتم تنسيقه بنجاح.",
      "success"
    );


  } catch (error) {


    showStatus(
      getJSONError(error),
      "error"
    );


    input.classList.remove(
      "valid"
    );


    input.classList.add(
      "invalid"
    );

  }

}


/* =========================
   EXAMPLE
========================= */

function loadExample() {


  input.value =
    JSON.stringify(
      example,
      null,
      2
    );


  input.classList.remove(
    "valid",
    "invalid"
  );


  updateStats();


  showStatus(
    "تم تحميل مثال JSON صالح.",
    "info"
  );

}


/* =========================
   COPY
========================= */

async function copyJSON() {


  if (
    !input.value
  ) {

    showStatus(
      "لا توجد بيانات لنسخها.",
      "error"
    );

    return;

  }


  try {

    await navigator.clipboard.writeText(
      input.value
    );


    showStatus(
      "تم نسخ JSON إلى الحافظة.",
      "success"
    );


  } catch {


    input.select();

    document.execCommand(
      "copy"
    );


    showStatus(
      "تم نسخ JSON.",
      "success"
    );

  }

}


/* =========================
   CLEAR
========================= */

function clearAll() {


  input.value = "";


  input.classList.remove(
    "valid",
    "invalid"
  );


  updateStats();


  showStatus(
    "تم مسح المحتوى.",
    "info"
  );


  input.focus();

}


/* =========================
   EVENTS
========================= */

validateBtn.addEventListener(
  "click",
  validateJSON
);


formatBtn.addEventListener(
  "click",
  formatJSON
);


exampleBtn.addEventListener(
  "click",
  loadExample
);


copyBtn.addEventListener(
  "click",
  copyJSON
);


clearBtn.addEventListener(
  "click",
  clearAll
);


input.addEventListener(
  "input",
  () => {

    updateStats();

    input.classList.remove(
      "valid",
      "invalid"
    );

    status.className =
      "status";

    status.innerHTML =
      `
        <i class="fas fa-circle-info"></i>
        أدخل JSON ثم اضغط «تحقق».
      `;

  }
);


/* =========================
   CTRL + ENTER
========================= */

input.addEventListener(
  "keydown",
  (event) => {

    if (
      event.ctrlKey &&
      event.key === "Enter"
    ) {

      event.preventDefault();

      validateJSON();

    }


    /*
      Tab داخل المحرر
    */

    if (
      event.key === "Tab"
    ) {

      event.preventDefault();


      const start =
        input.selectionStart;


      const end =
        input.selectionEnd;


      input.value =
        input.value.substring(
          0,
          start
        ) +
        "  " +
        input.value.substring(
          end
        );


      input.selectionStart =
        input.selectionEnd =
          start + 2;


      updateStats();

    }

  }
);


/* =========================
   INIT
========================= */

updateStats();

</script>

</body>

</html>


<style>

:root {

  --bg: #f6f8fb;

  --card: #ffffff;

  --text: #0f172a;

  --muted: #64748b;

  --border: #e2e8f0;

  --soft: #f1f5f9;

  --primary: #2563eb;

}


/* =========================
   BASE
========================= */

* {

  box-sizing: border-box;

  margin: 0;

  padding: 0;

}


body {

  background:
    var(--bg);

  color:
    var(--text);

  font-family:
    "Cairo",
    sans-serif;

  line-height: 1.7;

}


/* =========================
   PAGE
========================= */

.page {

  width:
    min(
      1180px,
      calc(100% - 32px)
    );

  margin:
    auto;

  padding:
    35px 0 70px;

}


/* =========================
   BREADCRUMB
========================= */

.breadcrumb {

  display:
    flex;

  align-items:
    center;

  gap: 9px;

  margin-bottom:
    30px;

  color:
    var(--muted);

  font-size:
    11px;

}


.breadcrumb a {

  color:
    var(--primary);

  text-decoration:
    none;

}


.breadcrumb i {

  font-size:
    8px;

}


/* =========================
   TOOL TITLE
========================= */

.tool-title {

  display:
    flex;

  align-items:
    center;

  gap: 17px;

  margin-bottom:
    30px;

}


.tool-icon {

  width: 65px;

  height: 65px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    17px;

  background:
    rgba(37, 99, 235, .10);

  color:
    var(--primary);

  font-size:
    27px;

  flex:
    none;

}


.eyebrow {

  display:
    block;

  color:
    var(--primary);

  font-size:
    10px;

  font-weight:
    800;

  letter-spacing:
    1.2px;

}


.tool-title h1 {

  font-size:
    30px;

  font-weight:
    800;

  line-height:
    1.3;

}


.tool-title p {

  color:
    var(--muted);

  font-size:
    13px;

  margin-top:
    3px;

}


/* =========================
   WORKSPACE
========================= */

.workspace {

  background:
    var(--card);

  border:
    1px solid var(--border);

  border-radius:
    18px;

  overflow:
    hidden;

  box-shadow:
    0 20px 60px
    rgba(15, 23, 42, .07);

}


/* =========================
   TOOLBAR
========================= */

.toolbar {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    10px;

  padding:
    12px;

  border-bottom:
    1px solid var(--border);

  background:
    var(--soft);

}


.toolbar-group {

  display:
    flex;

  gap:
    7px;

  flex-wrap:
    wrap;

}


.toolbar button {

  height:
    37px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    7px;

  padding:
    0 13px;

  border:
    1px solid var(--border);

  border-radius:
    8px;

  background:
    var(--card);

  color:
    var(--text);

  font-family:
    inherit;

  font-size:
    11px;

  font-weight:
    700;

  cursor:
    pointer;

  transition:
    .2s ease;

}


.toolbar button:hover {

  border-color:
    var(--primary);

  color:
    var(--primary);

}


.toolbar button.primary {

  background:
    var(--primary);

  border-color:
    var(--primary);

  color:
    white;

}


/* =========================
   STATUS
========================= */

.status {

  display:
    flex;

  align-items:
    center;

  gap:
    8px;

  min-height:
    43px;

  padding:
    8px 15px;

  border-bottom:
    1px solid var(--border);

  color:
    var(--muted);

  font-size:
    11px;

}


.status.success {

  color:
    #15803d;

  background:
    rgba(34, 197, 94, .06);

}


.status.error {

  color:
    #dc2626;

  background:
    rgba(239, 68, 68, .06);

}


/* =========================
   EDITOR
========================= */

.editor-grid {

  display:
    grid;

  grid-template-columns:
    1fr;

  min-height:
    480px;

}


.editor-card {

  display:
    flex;

  flex-direction:
    column;

  min-width:
    0;

}


.editor-header {

  height:
    43px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  padding:
    0 13px;

  background:
    var(--soft);

  border-bottom:
    1px solid var(--border);

  color:
    var(--muted);

  font-size:
    10px;

  font-weight:
    800;

  letter-spacing:
    .7px;

}


.editor-header span:first-child {

  display:
    flex;

  align-items:
    center;

  gap:
    7px;

}


.editor-header i {

  color:
    var(--primary);

}


.editor-header span:last-child {

  font-family:
    "Fira Code",
    monospace;

  font-size:
    9px;

}


textarea {

  flex:
    1;

  width:
    100%;

  min-height:
    437px;

  resize:
    vertical;

  border:
    0;

  outline:
    0;

  padding:
    18px;

  background:
    var(--card);

  color:
    var(--text);

  direction:
    ltr;

  text-align:
    left;

  font:
    13px / 1.8
    "Fira Code",
    monospace;

  tab-size:
    2;

  transition:
    .2s ease;

}


textarea::placeholder {

  color:
    #94a3b8;

}


textarea:focus {

  background:
    #fbfdff;

}


textarea.valid {

  background:
    rgba(34, 197, 94, .025);

}


textarea.invalid {

  background:
    rgba(239, 68, 68, .025);

}


/* =========================
   INFO
========================= */

.info {

  margin-top:
    50px;

  text-align:
    center;

}


.info h2 {

  font-size:
    25px;

  font-weight:
    800;

}


.info > p {

  max-width:
    750px;

  margin:
    10px auto;

  color:
    var(--muted);

  font-size:
    13px;

}


.info-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap:
    15px;

  margin-top:
    25px;

}


.info-grid div {

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    3px;

  padding:
    20px;

  border:
    1px solid var(--border);

  border-radius:
    13px;

  background:
    var(--card);

}


.info-grid i {

  color:
    var(--primary);

  font-size:
    20px;

  margin-bottom:
    5px;

}


.info-grid strong {

  font-size:
    13px;

}


.info-grid span {

  color:
    var(--muted);

  font-size:
    10px;

}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

  .toolbar {

    flex-direction:
      column;

    align-items:
      stretch;

  }


  .toolbar-group {

    justify-content:
      center;

  }


  .toolbar button {

    flex:
      1;

  }

}


@media (max-width: 600px) {

  .page {

    width:
      calc(100% - 16px);

    padding-top:
      22px;

  }


  .tool-title {

    gap:
      12px;

  }


  .tool-title h1 {

    font-size:
      24px;

  }


  .tool-title p {

    font-size:
      11px;

  }


  .tool-icon {

    width:
      54px;

    height:
      54px;

    font-size:
      22px;

    border-radius:
      14px;

  }


  .breadcrumb {

    overflow-x:
      auto;

    white-space:
      nowrap;

  }


  .toolbar {

    padding:
      10px;

  }


  .toolbar-group {

    width:
      100%;

    display:
      grid;

    grid-template-columns:
      repeat(3, 1fr);

  }


  .toolbar-group:last-child {

    grid-template-columns:
      repeat(2, 1fr);

  }


  .toolbar button {

    width:
      100%;

    padding:
      0 7px;

    font-size:
      10px;

  }


  .editor-grid {

    min-height:
      400px;

  }


  textarea {

    min-height:
      400px;

    padding:
      14px;

    font-size:
      12px;

  }


  .info {

    margin-top:
      38px;

  }


  .info h2 {

    font-size:
      21px;

  }


  .info > p {

    font-size:
      11px;

  }


  .info-grid {

    grid-template-columns:
      1fr;

  }

}

</style>
