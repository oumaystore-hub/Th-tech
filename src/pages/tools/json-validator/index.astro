---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export const title = 'JSON Validator';
export const description =
  'تحقق من صحة JSON واكتشف الأخطاء في البنية والصياغة بسرعة وسهولة.';
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>JSON Validator | Th.Tech</title>

    <meta
      name="description"
      content={description}
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;

        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        background: #f5f7fb;

        color: #172033;

        transition:
          background 0.3s ease,
          color 0.3s ease;
      }

      main {
        min-height: calc(100vh - 160px);

        padding:
          35px 16px 65px;
      }

      .container {
        width: min(1100px, 100%);

        margin: auto;
      }

      /* =========================
         BACK LINK
      ========================= */

      .back {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-bottom: 18px;

        color: #667085;

        text-decoration: none;

        font-size: 13px;

        font-weight: 700;

        transition:
          color 0.2s ease;
      }

      .back:hover {
        color: #008ff5;
      }

      /* =========================
         HERO
      ========================= */

      .hero {
        text-align: center;

        margin-bottom: 28px;
      }

      .tool-badge {
        display: inline-flex;

        align-items: center;

        gap: 8px;

        padding:
          7px 13px;

        border-radius: 999px;

        background:
          rgba(0, 143, 245, 0.1);

        color: #0088ee;

        font-size: 12px;

        font-weight: 800;

        margin-bottom: 13px;
      }

      .tool-badge svg {
        width: 16px;
        height: 16px;
      }

      .hero h1 {
        margin: 0 0 10px;

        font-size:
          clamp(29px, 5vw, 45px);

        line-height: 1.2;
      }

      .hero p {
        max-width: 680px;

        margin: auto;

        color: #667085;

        font-size: 15px;

        line-height: 1.8;
      }

      /* =========================
         TOOL CARD
      ========================= */

      .tool-box {
        overflow: hidden;

        border:
          1px solid #e3e8f0;

        border-radius: 20px;

        background: #ffffff;

        box-shadow:
          0 12px 35px
          rgba(20, 35, 60, 0.07);
      }

      /* =========================
         TOOL HEADER
      ========================= */

      .tool-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 12px;

        padding:
          15px 18px;

        border-bottom:
          1px solid #edf0f5;

        background:
          linear-gradient(
            180deg,
            #ffffff,
            #fbfcfe
          );
      }

      .tool-title {
        display: flex;

        align-items: center;

        gap: 10px;
      }

      .mini-icon {
        display: flex;

        align-items: center;

        justify-content: center;

        width: 38px;
        height: 38px;

        border-radius: 11px;

        background:
          rgba(0, 143, 245, 0.1);

        color: #0088ee;
      }

      .mini-icon svg {
        width: 22px;
        height: 22px;

        fill: none;

        stroke: currentColor;

        stroke-width: 1.8;

        stroke-linecap: round;

        stroke-linejoin: round;
      }

      .tool-title strong {
        display: block;

        font-size: 14px;
      }

      .tool-title span {
        display: block;

        margin-top: 2px;

        color: #98a2b3;

        font-size: 11px;
      }

      /* =========================
         EDITOR
      ========================= */

      .editor-area {
        position: relative;

        padding: 18px;
      }

      textarea {
        display: block;

        width: 100%;

        min-height: 360px;

        resize: vertical;

        padding: 17px;

        border:
          1px solid #dce3ec;

        border-radius: 14px;

        outline: none;

        background:
          #f9fafc;

        color: #172033;

        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;

        font-size: 13px;

        line-height: 1.7;

        direction: ltr;

        text-align: left;

        tab-size: 2;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      textarea:focus {
        border-color:
          #008ff5;

        box-shadow:
          0 0 0 4px
          rgba(0, 143, 245, 0.1);
      }

      textarea.valid {
        border-color: #12b76a;

        box-shadow:
          0 0 0 3px
          rgba(18, 183, 106, 0.08);
      }

      textarea.invalid {
        border-color: #f04438;

        box-shadow:
          0 0 0 3px
          rgba(240, 68, 56, 0.08);
      }

      /* =========================
         ACTIONS
      ========================= */

      .actions {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 12px;
      }

      button {
        font-family: inherit;
      }

      .action {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        min-height: 40px;

        padding:
          0 14px;

        border-radius: 10px;

        border:
          1px solid #dce3ec;

        background: #ffffff;

        color: #344054;

        font-size: 12px;

        font-weight: 800;

        cursor: pointer;

        transition:
          transform 0.15s ease,
          border-color 0.2s ease,
          background 0.2s ease;
      }

      .action:hover {
        transform:
          translateY(-1px);

        border-color:
          #b8c3d2;
      }

      .action.primary {
        border-color:
          #008ff5;

        background:
          #008ff5;

        color: white;
      }

      .action.primary:hover {
        background:
          #007bd4;

        border-color:
          #007bd4;
      }

      .action svg {
        width: 16px;
        height: 16px;

        fill: none;

        stroke: currentColor;

        stroke-width: 1.8;

        stroke-linecap: round;

        stroke-linejoin: round;
      }

      /* =========================
         RESULT
      ========================= */

      .result {
        display: none;

        margin:
          0 18px 18px;

        padding: 15px;

        border-radius: 13px;

        border: 1px solid;
      }

      .result.show {
        display: block;
      }

      .result.valid {
        border-color:
          #abefc6;

        background:
          #ecfdf3;

        color:
          #067647;
      }

      .result.invalid {
        border-color:
          #fecdca;

        background:
          #fef3f2;

        color:
          #b42318;
      }

      .result-title {
        display: flex;

        align-items: center;

        gap: 8px;

        font-size: 14px;

        font-weight: 900;
      }

      .result-title svg {
        width: 20px;
        height: 20px;

        fill: none;

        stroke: currentColor;

        stroke-width: 2;

        stroke-linecap: round;

        stroke-linejoin: round;
      }

      .result-message {
        margin-top: 6px;

        font-size: 12px;

        line-height: 1.7;

        word-break: break-word;
      }

      /* =========================
         INFO
      ========================= */

      .info-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 12px;

        margin-top: 16px;
      }

      .info-card {
        padding: 15px;

        border:
          1px solid #e5e9f0;

        border-radius: 14px;

        background: white;
      }

      .info-card strong {
        display: block;

        margin-bottom: 5px;

        font-size: 13px;
      }

      .info-card span {
        color: #667085;

        font-size: 11px;

        line-height: 1.6;
      }

      /* =========================
         DARK MODE
      ========================= */

      :global(html.dark) body {
        background: #0b1220;

        color: #f2f4f7;
      }

      :global(html.dark) .back {
        color: #98a2b3;
      }

      :global(html.dark) .hero p {
        color: #98a2b3;
      }

      :global(html.dark) .tool-box {
        background: #111a2b;

        border-color:
          #263247;

        box-shadow:
          0 15px 40px
          rgba(0, 0, 0, 0.25);
      }

      :global(html.dark) .tool-header {
        background:
          linear-gradient(
            180deg,
            #111a2b,
            #0f1727
          );

        border-color:
          #263247;
      }

      :global(html.dark) textarea {
        background:
          #0b1220;

        border-color:
          #2b3950;

        color: #e6edf5;
      }

      :global(html.dark) .action {
        background: #172236;

        border-color:
          #2b3950;

        color: #d0d5dd;
      }

      :global(html.dark) .action.primary {
        background:
          #008ff5;

        border-color:
          #008ff5;

        color: white;
      }

      :global(html.dark) .info-card {
        background: #111a2b;

        border-color:
          #263247;
      }

      :global(html.dark) .info-card span {
        color: #98a2b3;
      }

      :global(html.dark) .result.valid {
        background:
          rgba(6, 118, 71, 0.12);

        border-color:
          rgba(18, 183, 106, 0.35);

        color:
          #75e0a7;
      }

      :global(html.dark) .result.invalid {
        background:
          rgba(180, 35, 24, 0.12);

        border-color:
          rgba(240, 68, 56, 0.35);

        color:
          #fda29b;
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 650px) {
        main {
          padding:
            25px 10px 50px;
        }

        .hero {
          margin-bottom: 22px;
        }

        .hero h1 {
          font-size: 30px;
        }

        .hero p {
          font-size: 13px;
        }

        .tool-box {
          border-radius: 16px;
        }

        .tool-header {
          padding:
            12px 13px;
        }

        .editor-area {
          padding: 11px;
        }

        textarea {
          min-height: 310px;

          padding: 13px;

          font-size: 12px;
        }

        .actions {
          display: grid;

          grid-template-columns:
            repeat(2, 1fr);

          gap: 7px;
        }

        .action {
          width: 100%;

          padding:
            0 8px;

          font-size: 11px;
        }

        .result {
          margin:
            0 11px 11px;

          padding: 13px;
        }

        .info-grid {
          grid-template-columns:
            1fr;

          gap: 8px;
        }

        .info-card {
          padding: 13px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <div class="container">

        <a
          class="back"
          href={`${base}/tools/`}
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>

          العودة إلى الأدوات
        </a>

        <section class="hero">

          <div class="tool-badge">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 3h9l4 4v14H6z" />
              <path d="M15 3v5h5" />
              <path d="m9 15 2 2 4-5" />
            </svg>

            JSON Tool

          </div>

          <h1>
            JSON Validator
          </h1>

          <p>
            تحقق من صحة JSON بسرعة واكتشف أخطاء الصياغة
            والبنية قبل استخدام البيانات في مشروعك.
          </p>

        </section>

        <section class="tool-box">

          <header class="tool-header">

            <div class="tool-title">

              <div class="mini-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M6 3h9l4 4v14H6z" />
                  <path d="M15 3v5h5" />
                  <path d="m9 15 2 2 4-5" />
                </svg>
              </div>

              <div>
                <strong>
                  JSON Validator
                </strong>

                <span>
                  التحقق من صحة JSON
                </span>
              </div>

            </div>

          </header>

          <div class="editor-area">

            <textarea
              id="jsonInput"
              spellcheck="false"
              placeholder={`{
  "name": "Th.Tech",
  "version": "1.0",
  "tools": [
    "JSON Formatter",
    "JSON Validator"
  ]
}`}
            ></textarea>

            <div class="actions">

              <button
                class="action primary"
                id="validateBtn"
                type="button"
              >
                <svg viewBox="0 0 24 24">
                  <path d="m5 12 4 4L19 6" />
                </svg>

                تحقق من JSON
              </button>

              <button
                class="action"
                id="formatBtn"
                type="button"
              >
                <svg viewBox="0 0 24 24">
                  <path d="M8 4h8M8 8h8M8 12h5M8 16h8M8 20h8" />
                </svg>

                تنسيق
              </button>

              <button
                class="action"
                id="copyBtn"
                type="button"
              >
                <svg viewBox="0 0 24 24">
                  <rect
                    x="8"
                    y="8"
                    width="12"
                    height="12"
                    rx="2"
                  />

                  <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                </svg>

                نسخ
              </button>

              <button
                class="action"
                id="clearBtn"
                type="button"
              >
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h16" />
                  <path d="M10 11v6M14 11v6" />
                  <path d="M6 7l1 13h10l1-13" />
                  <path d="M9 7V4h6v3" />
                </svg>

                مسح
              </button>

            </div>

          </div>

          <div
            class="result"
            id="result"
            aria-live="polite"
          >

            <div class="result-title">
              <svg
                id="resultIcon"
                viewBox="0 0 24 24"
              ></svg>

              <span id="resultTitle">
                النتيجة
              </span>
            </div>

            <div
              class="result-message"
              id="resultMessage"
            ></div>

          </div>

        </section>

        <section class="info-grid">

          <div class="info-card">

            <strong>
              ✓ تحقق فوري
            </strong>

            <span>
              يتم تحليل JSON مباشرة داخل المتصفح
              دون إرسال البيانات إلى خادم خارجي.
            </span>

          </div>

          <div class="info-card">

            <strong>
              ⚡ سريع وآمن
            </strong>

            <span>
              بياناتك تبقى على جهازك أثناء عملية
              التحقق والتنسيق.
            </span>

          </div>

          <div class="info-card">

            <strong>
              {} JSON
            </strong>

            <span>
              يدعم الكائنات والمصفوفات والقيم النصية
              والأرقام والقيم المنطقية.
            </span>

          </div>

        </section>

      </div>
    </main>

    <Footer />

    <script>
      const input =
        document.getElementById(
          'jsonInput'
        ) as HTMLTextAreaElement;

      const validateBtn =
        document.getElementById(
          'validateBtn'
        ) as HTMLButtonElement;

      const formatBtn =
        document.getElementById(
          'formatBtn'
        ) as HTMLButtonElement;

      const copyBtn =
        document.getElementById(
          'copyBtn'
        ) as HTMLButtonElement;

      const clearBtn =
        document.getElementById(
          'clearBtn'
        ) as HTMLButtonElement;

      const result =
        document.getElementById(
          'result'
        ) as HTMLDivElement;

      const resultTitle =
        document.getElementById(
          'resultTitle'
        ) as HTMLSpanElement;

      const resultMessage =
        document.getElementById(
          'resultMessage'
        ) as HTMLDivElement;

      const resultIcon =
        document.getElementById(
          'resultIcon'
        ) as SVGElement;

      function showResult(
        valid: boolean,
        message: string
      ) {
        result.className =
          `result show ${
            valid
              ? 'valid'
              : 'invalid'
          }`;

        resultTitle.textContent =
          valid
            ? 'JSON صالح'
            : 'JSON غير صالح';

        resultMessage.textContent =
          message;

        resultIcon.innerHTML =
          valid
            ? `
              <path d="m5 12 4 4L19 6"></path>
            `
            : `
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 8v5"></path>
              <path d="M12 16h.01"></path>
            `;

        input.classList.toggle(
          'valid',
          valid
        );

        input.classList.toggle(
          'invalid',
          !valid
        );
      }

      function validateJSON() {
        const value =
          input.value.trim();

        if (!value) {
          showResult(
            false,
            'يرجى إدخال JSON للتحقق منه.'
          );

          return;
        }

        try {
          const parsed =
            JSON.parse(value);

          let type =
            Array.isArray(parsed)
              ? 'مصفوفة Array'
              : typeof parsed ===
                  'object' &&
                parsed !== null
              ? 'كائن Object'
              : typeof parsed;

          showResult(
            true,
            `تم التحقق بنجاح. نوع البيانات: ${type}.`
          );
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : 'خطأ غير معروف في JSON.';

          showResult(
            false,
            `تفاصيل الخطأ: ${message}`
          );
        }
      }

      validateBtn.addEventListener(
        'click',
        validateJSON
      );

      formatBtn.addEventListener(
        'click',
        () => {
          const value =
            input.value.trim();

          if (!value) {
            showResult(
              false,
              'أدخل JSON أولًا حتى يتم تنسيقه.'
            );

            return;
          }

          try {
            const parsed =
              JSON.parse(value);

            input.value =
              JSON.stringify(
                parsed,
                null,
                2
              );

            showResult(
              true,
              'JSON صالح وتم تنسيقه بنجاح.'
            );
          } catch (error) {
            const message =
              error instanceof Error
                ? error.message
                : 'JSON غير صالح.';

            showResult(
              false,
              `لا يمكن التنسيق لأن JSON غير صالح. ${message}`
            );
          }
        }
      );

      copyBtn.addEventListener(
        'click',
        async () => {
          if (!input.value) {
            showResult(
              false,
              'لا يوجد محتوى لنسخه.'
            );

            return;
          }

          try {
            await navigator.clipboard.writeText(
              input.value
            );

            const original =
              copyBtn.innerHTML;

            copyBtn.innerHTML = `
              <svg viewBox="0 0 24 24">
                <path d="m5 12 4 4L19 6"></path>
              </svg>
              تم النسخ
            `;

            setTimeout(() => {
              copyBtn.innerHTML =
                original;
            }, 1400);

          } catch {
            showResult(
              false,
              'تعذر نسخ النص. حاول النسخ يدويًا.'
            );
          }
        }
      );

      clearBtn.addEventListener(
        'click',
        () => {
          input.value = '';

          result.className =
            'result';

          input.classList.remove(
            'valid',
            'invalid'
          );

          input.focus();
        }
      );

      input.addEventListener(
        'input',
        () => {
          result.className =
            'result';

          input.classList.remove(
            'valid',
            'invalid'
          );
        }
      );

      input.addEventListener(
        'keydown',
        (event) => {
          if (
            event.ctrlKey &&
            event.key === 'Enter'
          ) {
            event.preventDefault();

            validateJSON();
          }

          if (
            event.key === 'Tab'
          ) {
            event.preventDefault();

            const start =
              input.selectionStart;

            const end =
              input.selectionEnd;

            input.value =
              input.value.substring(
                0,
                start
              ) +
              '  ' +
              input.value.substring(
                end
              );

            input.selectionStart =
              input.selectionEnd =
                start + 2;
          }
        }
      );
    </script>
  </body>
</html>
