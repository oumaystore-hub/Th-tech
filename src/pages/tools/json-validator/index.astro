<script>

const input =
  document.getElementById("input");


const status =
  document.getElementById("status");


const inputStats =
  document.getElementById("inputStats");


const validateBtn =
  document.getElementById("validateBtn");


const formatBtn =
  document.getElementById("formatBtn");


const exampleBtn =
  document.getElementById("exampleBtn");


const copyBtn =
  document.getElementById("copyBtn");


const clearBtn =
  document.getElementById("clearBtn");


/* =========================
   EXAMPLE
========================= */

const example = {

  name: "Th.Tech",

  website: "Developer Tools",

  language: "Arabic",

  free: true,

  tools: [
    "JSON Formatter",
    "JSON Validator",
    "HTML Formatter"
  ],

  features: {

    fast: true,

    private: true,

    responsive: true

  }

};


/* =========================
   STATS
========================= */

function updateStats() {

  inputStats.textContent =
    `${input.value.length} chars`;

}


/* =========================
   STATUS
========================= */

function showStatus(
  message,
  type = "info"
) {

  const icons = {

    info:
      "fa-circle-info",

    success:
      "fa-circle-check",

    error:
      "fa-circle-xmark"

  };


  status.className =
    `status ${type}`;


  status.innerHTML =
    `<i class="fas ${icons[type]}"></i> ${message}`;

}


/* =========================
   ERROR POSITION
========================= */

function getJSONError(error) {

  const message =
    error?.message ||
    "JSON غير صالح.";


  /*
    معظم المتصفحات الحديثة
    تعطي position داخل رسالة الخطأ
  */

  const match =
    message.match(
      /position\s+(\d+)/i
    );


  if (match) {

    const position =
      Number(match[1]);


    const before =
      input.value.slice(
        0,
        position
      );


    const line =
      before.split("\n").length;


    const lastNewLine =
      before.lastIndexOf("\n");


    const column =
      position -
      lastNewLine;


    return `
      JSON غير صالح — السطر ${line}،
      العمود ${column}.
    `;

  }


  /*
    دعم رسائل بعض المتصفحات
    مثل line/column
  */

  const lineMatch =
    message.match(
      /line\s+(\d+)/i
    );


  const columnMatch =
    message.match(
      /column\s+(\d+)/i
    );


  if (
    lineMatch &&
    columnMatch
  ) {

    return `
      JSON غير صالح — السطر
      ${lineMatch[1]}،
      العمود ${columnMatch[1]}.
    `;

  }


  return `
    JSON غير صالح: ${message}
  `;

}


/* =========================
   VALIDATE
========================= */

function validateJSON() {


  if (
    !input.value.trim()
  ) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }


  try {

    const data =
      JSON.parse(
        input.value
      );


    let type =
      Array.isArray(data)
        ? "Array"
        : data !== null &&
          typeof data === "object"
        ? "Object"
        : typeof data;


    showStatus(
      `JSON صالح ✓ — نوع البيانات: ${type}. لا توجد أخطاء في البنية.`,
      "success"
    );


    input.classList.remove(
      "invalid"
    );


    input.classList.add(
      "valid"
    );


  } catch (error) {


    showStatus(
      getJSONError(error),
      "error"
    );


    input.classList.remove(
      "valid"
    );


    input.classList.add(
      "invalid"
    );

  }

}


/* =========================
   FORMAT
========================= */

function formatJSON() {


  if (
    !input.value.trim()
  ) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }


  try {

    const data =
      JSON.parse(
        input.value
      );


    input.value =
      JSON.stringify(
        data,
        null,
        2
      );


    updateStats();


    input.classList.remove(
      "invalid"
    );


    input.classList.add(
      "valid"
    );


    showStatus(
      "JSON صالح وتم تنسيقه بنجاح.",
      "success"
    );


  } catch (error) {


    showStatus(
      getJSONError(error),
      "error"
    );


    input.classList.remove(
      "valid"
    );


    input.classList.add(
      "invalid"
    );

  }

}


/* =========================
   EXAMPLE
========================= */

function loadExample() {


  input.value =
    JSON.stringify(
      example,
      null,
      2
    );


  input.classList.remove(
    "valid",
    "invalid"
  );


  updateStats();


  showStatus(
    "تم تحميل مثال JSON صالح.",
    "info"
  );

}


/* =========================
   COPY
========================= */

async function copyJSON() {


  if (
    !input.value
  ) {

    showStatus(
      "لا توجد بيانات لنسخها.",
      "error"
    );

    return;

  }


  try {

    await navigator.clipboard.writeText(
      input.value
    );


    showStatus(
      "تم نسخ JSON إلى الحافظة.",
      "success"
    );


  } catch {


    input.select();

    document.execCommand(
      "copy"
    );


    showStatus(
      "تم نسخ JSON.",
      "success"
    );

  }

}


/* =========================
   CLEAR
========================= */

function clearAll() {


  input.value = "";


  input.classList.remove(
    "valid",
    "invalid"
  );


  updateStats();


  showStatus(
    "تم مسح المحتوى.",
    "info"
  );


  input.focus();

}


/* =========================
   EVENTS
========================= */

validateBtn.addEventListener(
  "click",
  validateJSON
);


formatBtn.addEventListener(
  "click",
  formatJSON
);


exampleBtn.addEventListener(
  "click",
  loadExample
);


copyBtn.addEventListener(
  "click",
  copyJSON
);


clearBtn.addEventListener(
  "click",
  clearAll
);


input.addEventListener(
  "input",
  () => {

    updateStats();

    input.classList.remove(
      "valid",
      "invalid"
    );

    status.className =
      "status";

    status.innerHTML =
      `
        <i class="fas fa-circle-info"></i>
        أدخل JSON ثم اضغط «تحقق».
      `;

  }
);


/* =========================
   CTRL + ENTER
========================= */

input.addEventListener(
  "keydown",
  (event) => {

    if (
      event.ctrlKey &&
      event.key === "Enter"
    ) {

      event.preventDefault();

      validateJSON();

    }


    /*
      Tab داخل المحرر
    */

    if (
      event.key === "Tab"
    ) {

      event.preventDefault();


      const start =
        input.selectionStart;


      const end =
        input.selectionEnd;


      input.value =
        input.value.substring(
          0,
          start
        ) +
        "  " +
        input.value.substring(
          end
        );


      input.selectionStart =
        input.selectionEnd =
          start + 2;


      updateStats();

    }

  }
);


/* =========================
   INIT
========================= */

updateStats();

</script>

</body>

</html>


