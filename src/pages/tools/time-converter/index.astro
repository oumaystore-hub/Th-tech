---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Time Converter - تحويل الوقت أونلاين مجاناً | Th.Tech";

const description =
  "أداة Time Converter مجانية لتحويل الوقت بين الثواني والدقائق والساعات والأيام بسرعة، مع دعم النسخ والمسح والعمل مباشرة داخل المتصفح.";

const faqs = [
  {
    q: "ما هي أداة Time Converter؟",
    a: "هي أداة لتحويل القيم الزمنية بين الثواني والدقائق والساعات والأيام بطريقة سريعة وسهلة."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. جميع الحسابات تتم داخل المتصفح باستخدام JavaScript ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "كم ثانية توجد في الدقيقة؟",
    a: "الدقيقة الواحدة تساوي 60 ثانية."
  },
  {
    q: "كم دقيقة توجد في الساعة؟",
    a: "الساعة الواحدة تساوي 60 دقيقة، أي 3600 ثانية."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/time-converter/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          function syncTheme() {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          }

          syncTheme();

          window.addEventListener("themeChange", syncTheme);

          document.addEventListener("click", (event) => {
            const button = event.target.closest("#theme-btn");

            if (button) {
              setTimeout(syncTheme, 0);
            }
          });
        } catch {}
      })();
    </script>

    <style>
      :root {
        --bg: #f5f7fb;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #e3e8f1;

        --text: #172033;
        --muted: #6b7486;

        --primary: #16a34a;
        --primary-2: #22c55e;
        --primary-soft: rgba(22, 163, 74, 0.1);

        --blue: #2563eb;
        --blue-soft: rgba(37, 99, 235, 0.1);

        --orange: #ea580c;
        --orange-soft: rgba(234, 88, 12, 0.1);

        --shadow: 0 18px 55px rgba(15, 23, 42, 0.08);

        --radius: 22px;
      }

      html.dark-mode {
        --bg: #080d0b;
        --surface: #101713;
        --surface-2: #151d18;
        --border: #27332c;

        --text: #edf7f0;
        --muted: #8f9e94;

        --primary: #22c55e;
        --primary-2: #4ade80;
        --primary-soft: rgba(34, 197, 94, 0.12);

        --blue: #60a5fa;
        --blue-soft: rgba(96, 165, 250, 0.11);

        --orange: #fb923c;
        --orange-soft: rgba(251, 146, 60, 0.11);

        --shadow: 0 22px 65px rgba(0, 0, 0, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 85% 5%,
            var(--primary-soft),
            transparent 25%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      button,
      input,
      select {
        font: inherit;
      }

      .container {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 52px 0 45px;
        border-bottom: 1px solid var(--border);
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        right: -120px;
        bottom: -180px;
        border-radius: 50%;
        background: var(--primary-soft);
        pointer-events: none;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 30px;
        color: var(--muted);
        font-size: 13px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
      }

      .hero-content {
        display: grid;
        grid-template-columns: 125px 1fr;
        align-items: center;
        gap: 28px;
      }

      .hero-icon {
        width: 125px;
        height: 125px;
        border-radius: 35px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: #fff;
        background:
          linear-gradient(
            145deg,
            var(--primary),
            var(--primary-2)
          );
        box-shadow:
          0 20px 40px rgba(22, 163, 74, 0.25),
          inset 0 1px 0 rgba(255, 255, 255, 0.25);
        transform: rotate(3deg);
      }

      .hero-icon i {
        font-size: 39px;
      }

      .hero-icon span {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        opacity: 0.9;
      }

      .hero-text {
        min-width: 0;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        color: var(--primary);
        background: var(--primary-soft);
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero-text > p {
        margin: 0;
        max-width: 700px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 17px;
      }

      .tags span {
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      /* TOOL */

      .tool-section {
        padding: 45px 0 25px;
      }

      .converter {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .converter-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        min-height: 65px;
        padding: 0 23px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .header-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 14px;
      }

      .header-title i {
        color: var(--primary);
      }

      .local {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      .converter-body {
        padding: 25px;
      }

      .main-grid {
        display: grid;
        grid-template-columns: 1fr 80px 1fr;
        gap: 15px;
        align-items: stretch;
      }

      .input-card {
        border: 1px solid var(--border);
        border-radius: 19px;
        background: var(--surface-2);
        overflow: hidden;
      }

      .input-head {
        min-height: 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 15px;
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        font-weight: 700;
      }

      .input-head div {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .input-head i {
        color: var(--primary);
      }

      .input-head span {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
      }

      .input-area {
        padding: 18px;
      }

      .value-input {
        width: 100%;
        height: 68px;
        padding: 0 15px;
        border: 1px solid var(--border);
        border-radius: 13px;
        outline: none;
        background: var(--surface);
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 22px;
        direction: ltr;
        text-align: left;
        transition: 0.2s;
      }

      .value-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
      }

      .unit-select {
        width: 100%;
        margin-top: 12px;
        height: 45px;
        padding: 0 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        outline: none;
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
      }

      .swap-area {
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .swap-btn {
        width: 56px;
        height: 56px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--surface-2);
        color: var(--primary);
        cursor: pointer;
        font-size: 20px;
        transition: 0.25s;
      }

      .swap-btn:hover {
        transform: rotate(180deg);
        border-color: var(--primary);
        background: var(--primary-soft);
      }

      .result-card {
        border: 1px solid rgba(22, 163, 74, 0.25);
        border-radius: 19px;
        background: var(--primary-soft);
        overflow: hidden;
      }

      .result-head {
        min-height: 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 15px;
        border-bottom: 1px solid rgba(22, 163, 74, 0.15);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
      }

      .result-head div {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .copy-result {
        border: 0;
        background: transparent;
        color: var(--primary);
        cursor: pointer;
        font-size: 11px;
      }

      .result-body {
        padding: 18px;
      }

      .result-value {
        min-height: 68px;
        padding: 0 15px;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        direction: ltr;
        text-align: left;
        word-break: break-word;
        border: 1px solid rgba(22, 163, 74, 0.15);
        border-radius: 13px;
        background: var(--surface);
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 21px;
        font-weight: 600;
      }

      .result-unit {
        margin-top: 11px;
        color: var(--muted);
        font-size: 11px;
      }

      /* QUICK CONVERSION */

      .quick-title {
        margin: 25px 0 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .quick-title span {
        color: var(--muted);
        font-size: 10px;
        font-family: "JetBrains Mono", monospace;
        font-weight: 400;
      }

      .quick-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
      }

      .quick-btn {
        min-height: 52px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface-2);
        color: var(--text);
        cursor: pointer;
        transition: 0.2s;
      }

      .quick-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-soft);
        transform: translateY(-2px);
      }

      .quick-btn strong {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
      }

      .quick-btn small {
        color: var(--muted);
        font-size: 9px;
      }

      /* ACTIONS */

      .actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
      }

      .action-group {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
      }

      .btn {
        min-height: 43px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 11px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        transition: 0.2s;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        border: 0;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );
        color: white;
        box-shadow: 0 8px 20px rgba(22, 163, 74, 0.2);
      }

      .btn-secondary {
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--text);
      }

      /* STATUS */

      .status {
        margin-top: 17px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 12px;
        background: var(--blue-soft);
        color: var(--blue);
        font-size: 11px;
      }

      /* STATS */

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 11px;
        margin-top: 17px;
      }

      .stat {
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .stat-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--muted);
        font-size: 9px;
        margin-bottom: 6px;
      }

      .stat-label i {
        color: var(--primary);
      }

      .stat strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
      }

      /* INFO */

      .info-section,
      .how-section,
      .faq-section {
        padding: 55px 0;
      }

      .section-heading {
        max-width: 700px;
        margin: 0 auto 30px;
        text-align: center;
      }

      .section-heading > span {
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 7px 0;
        font-size: clamp(24px, 4vw, 32px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .info-card {
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
        transition: 0.2s;
      }

      .info-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
      }

      .info-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        color: var(--primary);
        background: var(--primary-soft);
        margin-bottom: 16px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 15px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* STEPS */

      .steps {
        max-width: 900px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        padding: 23px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
      }

      .step-number {
        width: 39px;
        height: 39px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--primary);
        color: white;
        font-weight: 800;
        margin-bottom: 17px;
      }

      .step h3 {
        margin: 0 0 7px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 9px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        list-style: none;
        cursor: pointer;
        padding: 17px 19px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        font-size: 12px;
        font-weight: 700;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: transform 0.2s;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        margin: 0;
        padding: 0 19px 17px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 850px) {
        .hero-content {
          grid-template-columns: 90px 1fr;
        }

        .hero-icon {
          width: 90px;
          height: 90px;
          border-radius: 26px;
        }

        .hero-icon i {
          font-size: 29px;
        }

        .main-grid {
          grid-template-columns: 1fr;
        }

        .swap-area {
          height: 50px;
        }

        .swap-btn {
          transform: rotate(90deg);
        }

        .swap-btn:hover {
          transform: rotate(270deg);
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .container {
          width: min(100% - 22px, 1120px);
        }

        .hero {
          padding: 35px 0;
        }

        .hero-content {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 20px;
        }

        .hero-icon {
          width: 78px;
          height: 78px;
          flex-basis: 78px;
        }

        .hero-icon i {
          font-size: 25px;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text > p {
          font-size: 13px;
        }

        .converter-body {
          padding: 14px;
        }

        .converter-header {
          padding: 0 14px;
        }

        .quick-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .actions {
          flex-direction: column-reverse;
          align-items: stretch;
        }

        .action-group {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
        }

        .btn {
          width: 100%;
          padding: 0 8px;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .value-input,
        .result-value {
          font-size: 17px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 40px 0;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Time Converter</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-regular fa-clock"></i>
              <span>TIME</span>
            </div>

            <div class="hero-text">
              <div class="badge">
                <i class="fa-solid fa-bolt"></i>
                Developer Tools
              </div>

              <h1>Time Converter</h1>

              <p>
                حوّل القيم الزمنية بسرعة بين الثواني والدقائق والساعات
                والأيام باستخدام أداة بسيطة وسريعة.
              </p>

              <div class="tags">
                <span>Seconds</span>
                <span>Minutes</span>
                <span>Hours</span>
                <span>Days</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="converter">
            <div class="converter-header">
              <div class="header-title">
                <i class="fa-regular fa-clock"></i>
                Time Converter
              </div>

              <div class="local">
                <i class="fa-solid fa-shield-halved"></i>
                LOCAL
              </div>
            </div>

            <div class="converter-body">
              <div class="main-grid">
                <!-- INPUT -->
                <div class="input-card">
                  <div class="input-head">
                    <div>
                      <i class="fa-solid fa-arrow-down"></i>
                      القيمة
                    </div>
                    <span>INPUT</span>
                  </div>

                  <div class="input-area">
                    <input
                      id="valueInput"
                      class="value-input"
                      type="number"
                      min="0"
                      step="any"
                      value="1"
                      placeholder="0"
                    />

                    <select id="fromUnit" class="unit-select">
                      <option value="seconds">ثواني — Seconds</option>
                      <option value="minutes">دقائق — Minutes</option>
                      <option value="hours">ساعات — Hours</option>
                      <option value="days">أيام — Days</option>
                    </select>
                  </div>
                </div>

                <!-- SWAP -->
                <div class="swap-area">
                  <button
                    id="swapBtn"
                    class="swap-btn"
                    title="تبديل الوحدات"
                    aria-label="تبديل الوحدات"
                  >
                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                  </button>
                </div>

                <!-- RESULT -->
                <div class="result-card">
                  <div class="result-head">
                    <div>
                      <i class="fa-solid fa-arrow-up"></i>
                      النتيجة
                    </div>

                    <button id="copyBtn" class="copy-result">
                      <i class="fa-regular fa-copy"></i>
                      نسخ
                    </button>
                  </div>

                  <div class="result-body">
                    <div id="resultValue" class="result-value">
                      60
                    </div>

                    <div id="resultUnit" class="result-unit">
                      Minutes
                    </div>

                    <select id="toUnit" class="unit-select">
                      <option value="seconds">ثواني — Seconds</option>
                      <option value="minutes" selected>
                        دقائق — Minutes
                      </option>
                      <option value="hours">ساعات — Hours</option>
                      <option value="days">أيام — Days</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- QUICK -->
              <div class="quick-title">
                <div>
                  تحويل سريع
                </div>
                <span>QUICK VALUES</span>
              </div>

              <div class="quick-grid">
                <button class="quick-btn" data-value="60" data-unit="seconds">
                  <strong>60 sec</strong>
                  <small>دقيقة واحدة</small>
                </button>

                <button class="quick-btn" data-value="60" data-unit="minutes">
                  <strong>60 min</strong>
                  <small>ساعة واحدة</small>
                </button>

                <button class="quick-btn" data-value="24" data-unit="hours">
                  <strong>24 hours</strong>
                  <small>يوم واحد</small>
                </button>

                <button class="quick-btn" data-value="7" data-unit="days">
                  <strong>7 days</strong>
                  <small>أسبوع واحد</small>
                </button>
              </div>

              <!-- ACTIONS -->
              <div class="actions">
                <div class="action-group">
                  <button id="convertBtn" class="btn btn-primary">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    تحويل
                  </button>

                  <button id="exampleBtn" class="btn btn-secondary">
                    <i class="fa-solid fa-flask"></i>
                    مثال
                  </button>
                </div>

                <div class="action-group">
                  <button id="clearBtn" class="btn btn-secondary">
                    <i class="fa-solid fa-eraser"></i>
                    مسح
                  </button>
                </div>
              </div>

              <div class="status">
                <i class="fa-solid fa-circle-check"></i>
                <span id="statusText">
                  جاهز للتحويل.
                </span>
              </div>

              <!-- STATS -->
              <div class="stats">
                <div class="stat">
                  <div class="stat-label">
                    <span>SECONDS</span>
                    <i class="fa-solid fa-stopwatch"></i>
                  </div>
                  <strong id="statSeconds">1</strong>
                </div>

                <div class="stat">
                  <div class="stat-label">
                    <span>MINUTES</span>
                    <i class="fa-regular fa-clock"></i>
                  </div>
                  <strong id="statMinutes">0.0167</strong>
                </div>

                <div class="stat">
                  <div class="stat-label">
                    <span>HOURS</span>
                    <i class="fa-solid fa-hourglass-half"></i>
                  </div>
                  <strong id="statHours">0.0003</strong>
                </div>

                <div class="stat">
                  <div class="stat-label">
                    <span>DAYS</span>
                    <i class="fa-solid fa-calendar-day"></i>
                  </div>
                  <strong id="statDays">0.000012</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>TIME CONVERTER</span>
            <h2>تحويل الوقت بسهولة</h2>
            <p>
              حوّل أي قيمة زمنية إلى الوحدة التي تحتاجها دون إجراء
              الحسابات يدوياً.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-stopwatch"></i>
              </div>

              <h3>الثواني</h3>

              <p>
                الوحدة الأساسية المستخدمة لقياس الوقت ويمكن تحويلها
                مباشرة إلى دقائق وساعات وأيام.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-regular fa-clock"></i>
              </div>

              <h3>الدقائق والساعات</h3>

              <p>
                حوّل بين الدقائق والساعات بسهولة، مع نتائج دقيقة وسريعة.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-calendar-day"></i>
              </div>

              <h3>الأيام</h3>

              <p>
                استخدم التحويل بين الأيام والساعات والدقائق والثواني
                في المشاريع والحسابات اليومية.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>HOW IT WORKS</span>
            <h2>كيفية استخدام Time Converter</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>

              <h3>أدخل القيمة</h3>

              <p>
                اكتب القيمة الزمنية التي تريد تحويلها.
              </p>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <h3>حدد الوحدات</h3>

              <p>
                اختر الوحدة الأصلية والوحدة التي تريد التحويل إليها.
              </p>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <h3>احصل على النتيجة</h3>

              <p>
                اضغط على تحويل ثم انسخ النتيجة مباشرة.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>FAQ</span>
            <h2>الأسئلة الشائعة</h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const valueInput =
          document.getElementById("valueInput");

        const fromUnit =
          document.getElementById("fromUnit");

        const toUnit =
          document.getElementById("toUnit");

        const resultValue =
          document.getElementById("resultValue");

        const resultUnit =
          document.getElementById("resultUnit");

        const statusText =
          document.getElementById("statusText");

        const statSeconds =
          document.getElementById("statSeconds");

        const statMinutes =
          document.getElementById("statMinutes");

        const statHours =
          document.getElementById("statHours");

        const statDays =
          document.getElementById("statDays");

        const units = {
          seconds: 1,
          minutes: 60,
          hours: 3600,
          days: 86400
        };

        const unitNames = {
          seconds: "Seconds",
          minutes: "Minutes",
          hours: "Hours",
          days: "Days"
        };

        function cleanNumber(number) {
          if (!Number.isFinite(number)) return "—";

          const absolute = Math.abs(number);

          if (
            absolute !== 0 &&
            (absolute >= 1e12 || absolute < 1e-6)
          ) {
            return number.toExponential(6);
          }

          return Number(number.toFixed(8)).toString();
        }

        function convert() {
          const value = Number(valueInput.value);

          if (
            valueInput.value === "" ||
            !Number.isFinite(value)
          ) {
            resultValue.textContent = "—";
            resultUnit.textContent = "Invalid value";

            statusText.textContent =
              "أدخل قيمة زمنية صحيحة.";

            return;
          }

          const seconds =
            value * units[fromUnit.value];

          const result =
            seconds / units[toUnit.value];

          resultValue.textContent =
            cleanNumber(result);

          resultUnit.textContent =
            unitNames[toUnit.value];

          statSeconds.textContent =
            cleanNumber(seconds);

          statMinutes.textContent =
            cleanNumber(seconds / 60);

          statHours.textContent =
            cleanNumber(seconds / 3600);

          statDays.textContent =
            cleanNumber(seconds / 86400);

          statusText.textContent =
            "تم التحويل بنجاح.";
        }

        function swapUnits() {
          const currentFrom = fromUnit.value;

          fromUnit.value = toUnit.value;
          toUnit.value = currentFrom;

          convert();
        }

        function clearAll() {
          valueInput.value = "";

          resultValue.textContent = "—";
          resultUnit.textContent = "—";

          statSeconds.textContent = "—";
          statMinutes.textContent = "—";
          statHours.textContent = "—";
          statDays.textContent = "—";

          statusText.textContent =
            "تم مسح البيانات. أدخل قيمة جديدة.";
        }

        function setExample() {
          valueInput.value = "3600";
          fromUnit.value = "seconds";
          toUnit.value = "hours";

          convert();
        }

        async function copyResult() {
          const text = resultValue.textContent;

          if (!text || text === "—") return;

          try {
            await navigator.clipboard.writeText(text);

            statusText.textContent =
              "تم نسخ النتيجة إلى الحافظة.";
          } catch {
            const textarea =
              document.createElement("textarea");

            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);

            textarea.select();
            document.execCommand("copy");

            textarea.remove();

            statusText.textContent =
              "تم نسخ النتيجة إلى الحافظة.";
          }
        }

        document
          .getElementById("convertBtn")
          .addEventListener("click", convert);

        document
          .getElementById("swapBtn")
          .addEventListener("click", swapUnits);

        document
          .getElementById("clearBtn")
          .addEventListener("click", clearAll);

        document
          .getElementById("exampleBtn")
          .addEventListener("click", setExample);

        document
          .getElementById("copyBtn")
          .addEventListener("click", copyResult);

        valueInput.addEventListener(
          "input",
          convert
        );

        fromUnit.addEventListener(
          "change",
          convert
        );

        toUnit.addEventListener(
          "change",
          convert
        );

        document
          .querySelectorAll(".quick-btn")
          .forEach((button) => {
            button.addEventListener("click", () => {
              valueInput.value =
                button.dataset.value || "";

              fromUnit.value =
                button.dataset.unit || "seconds";

              if (fromUnit.value === "seconds") {
                toUnit.value = "minutes";
              } else if (fromUnit.value === "minutes") {
                toUnit.value = "hours";
              } else if (fromUnit.value === "hours") {
                toUnit.value = "days";
              } else {
                toUnit.value = "hours";
              }

              convert();
            });
          });

        document.addEventListener("keydown", (event) => {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {
            convert();
          }
        });

        convert();
      })();
    </script>
  </body>
</html>
