  <script is:inline>
    (() => {
      const emailInput = document.getElementById("emailInput");

      const result = document.getElementById("result");
      const resultIcon = document.getElementById("resultIcon");
      const resultTitle = document.getElementById("resultTitle");
      const resultText = document.getElementById("resultText");

      const checkStructure = document.getElementById("checkStructure");
      const checkLocal = document.getElementById("checkLocal");
      const checkDomain = document.getElementById("checkDomain");
      const checkTld = document.getElementById("checkTld");
      const checkChars = document.getElementById("checkChars");

      const validateBtn = document.getElementById("validateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");

      const status = document.getElementById("status");

      const statLength = document.getElementById("statLength");
      const statLocal = document.getElementById("statLocal");
      const statDomain = document.getElementById("statDomain");
      const statStatus = document.getElementById("statStatus");

      function setStatus(message, type = "info") {
        status.className = "status";

        if (type === "success") {
          status.classList.add("success");
        }

        if (type === "error") {
          status.classList.add("error");
        }

        const icon = status.querySelector("i");
        const text = status.querySelector("span");

        if (type === "success") {
          icon.className = "fa-solid fa-circle-check";
        } else if (type === "error") {
          icon.className = "fa-solid fa-circle-xmark";
        } else {
          icon.className = "fa-solid fa-circle-info";
        }

        text.textContent = message;
      }

      function setCheck(element, state) {
        element.className = "check-status";

        if (state === true) {
          element.classList.add("ok");
          element.textContent = "✓";
        } else if (state === false) {
          element.classList.add("bad");
          element.textContent = "✕";
        } else {
          element.textContent = "—";
        }
      }

      function resetChecks() {
        [
          checkStructure,
          checkLocal,
          checkDomain,
          checkTld,
          checkChars
        ].forEach((element) => setCheck(element, null));
      }

      function validateEmail() {
        const value = emailInput.value.trim();

        statLength.textContent =
          value.length.toLocaleString("ar");

        emailInput.classList.remove("valid", "invalid");

        if (!value) {
          result.className = "result";

          resultIcon.className = "result-icon";
          resultIcon.innerHTML =
            '<i class="fa-solid fa-envelope"></i>';

          resultTitle.textContent =
            "بانتظار البريد الإلكتروني";

          resultText.textContent =
            "أدخل عنوان بريد لفحصه.";

          statLocal.textContent = "—";
          statDomain.textContent = "—";
          statStatus.textContent = "—";

          resetChecks();

          setStatus(
            "أدخل بريدًا إلكترونيًا لبدء الفحص.",
            "info"
          );

          return;
        }

        const structure =
          /^[^\s@]+@[^\s@]+$/.test(value);

        const parts = value.split("@");

        const local =
          parts.length === 2 &&
          parts[0].length > 0 &&
          parts[0].length <= 64 &&
          !/\s/.test(parts[0]) &&
          !/^[.]/.test(parts[0]) &&
          !/[.]$/.test(parts[0]) &&
          !/[.]{2,}/.test(parts[0]);

        const domain =
          parts.length === 2 &&
          parts[1].length > 0 &&
          parts[1].length <= 253 &&
          /^[A-Za-z0-9.-]+$/.test(parts[1]) &&
          !/^-/.test(parts[1]) &&
          !/-$/.test(parts[1]) &&
          !/\.\./.test(parts[1]);

        const tld =
          parts.length === 2 &&
          /^[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$/.test(parts[1]);

        const invalidChars =
          /[\s<>()[\]\\,;:"]/g.test(value);

        const finalValid =
          structure &&
          local &&
          domain &&
          tld &&
          !invalidChars &&
          value.length <= 254;

        setCheck(checkStructure, structure);
        setCheck(checkLocal, local);
        setCheck(checkDomain, domain);
        setCheck(checkTld, tld);
        setCheck(checkChars, !invalidChars);

        statLocal.textContent =
          parts.length === 2 && parts[0]
            ? parts[0]
            : "—";

        statDomain.textContent =
          parts.length === 2 && parts[1]
            ? parts[1]
            : "—";

        if (finalValid) {
          emailInput.classList.add("valid");

          result.className = "result valid";

          resultIcon.className =
            "result-icon";

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-check"></i>';

          resultTitle.textContent =
            "البريد صالح";

          resultText.textContent =
            "صيغة عنوان البريد الإلكتروني تبدو صحيحة.";

          statStatus.textContent = "VALID";

          setStatus(
            "تم اجتياز جميع الاختبارات الأساسية.",
            "success"
          );
        } else {
          emailInput.classList.add("invalid");

          result.className = "result invalid";

          resultIcon.className =
            "result-icon";

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-xmark"></i>';

          resultTitle.textContent =
            "البريد غير صالح";

          resultText.textContent =
            "تحقق من صيغة العنوان والمجال والرموز المستخدمة.";

          statStatus.textContent = "INVALID";

          setStatus(
            "فشل البريد في واحد أو أكثر من الاختبارات الأساسية.",
            "error"
          );
        }
      }

      function loadExample() {
        emailInput.value = "developer@example.com";
        validateEmail();
        emailInput.focus();
      }

      function clearEmail() {
        emailInput.value = "";
        validateEmail();
        emailInput.focus();
      }

      emailInput.addEventListener(
        "input",
        validateEmail
      );

      validateBtn.addEventListener(
        "click",
        validateEmail
      );

      exampleBtn.addEventListener(
        "click",
        loadExample
      );

      clearBtn.addEventListener(
        "click",
        clearEmail
      );

      emailInput.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            validateEmail();
          }
        }
      );

      validateEmail();
    })();
  </script>
</body>
</html>
