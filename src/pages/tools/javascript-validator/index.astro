---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Validator - فحص JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "أداة JavaScript Validator مجانية للتحقق من صحة كود JavaScript واكتشاف أخطاء Syntax مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JavaScript Validator؟",
    a: "أداة تساعدك على فحص كود JavaScript والتأكد من خلوه من أخطاء بناء الجملة Syntax Errors."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. يتم فحص الكود مباشرة داخل المتصفح، لذلك لا تحتاج إلى رفع ملفاتك إلى أي خادم."
  },
  {
    q: "هل الأداة تصلحح الأخطاء تلقائياً؟",
    a: "الأداة تحدد أخطاء بناء الجملة وتعرض رسالة تساعدك على معرفة المشكلة، لكنها لا تعدّل الكود تلقائياً."
  },
  {
    q: "هل يمكن فحص JavaScript الحديث؟",
    a: "نعم، يستخدم الفحص محرك JavaScript الموجود في المتصفح ويدعم صياغات JavaScript الحديثة التي يدعمها المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>

    <Header />

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <a href={`${base}/tools/`}>الأدوات</a>
            <span>/</span>
            <span>JavaScript Validator</span>
          </div>

          <div class="tool-icon">
            <i class="fa-brands fa-js"></i>
          </div>

          <div class="eyebrow">
            <i class="fa-solid fa-circle-check"></i>
            JavaScript
          </div>

          <h1>
            JavaScript <span>Validator</span>
          </h1>

          <p>
            تحقق من صحة كود JavaScript واكتشف أخطاء Syntax بسرعة
            مباشرة من المتصفح.
          </p>

        </div>
      </section>


      <!-- VALIDATOR -->
      <section class="validator-section">
        <div class="container">

          <div class="validator-card">

            <!-- TOP BAR -->
            <div class="topbar">

              <div class="tool-name">

                <div class="mini-icon">
                  <i class="fa-brands fa-js"></i>
                </div>

                <div>
                  <strong>JavaScript Validator</strong>
                  <small>فحص صحة كود JavaScript</small>
                </div>

              </div>

              <div class="local-badge">
                <span></span>
                يعمل محلياً
              </div>

            </div>


            <!-- TOOLBAR -->
            <div class="toolbar">

              <button
                id="validateBtn"
                class="btn btn-primary"
              >
                <i class="fa-solid fa-circle-check"></i>
                فحص الكود
              </button>

              <button
                id="formatBtn"
                class="btn"
              >
                <i class="fa-solid fa-align-left"></i>
                تنسيق
              </button>

              <button
                id="copyBtn"
                class="btn"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="btn btn-clear"
              >
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

            </div>


            <!-- EDITOR -->
            <div class="editor-wrapper">

              <div class="editor-header">

                <div class="editor-title">

                  <span class="indicator"></span>

                  <strong>JavaScript Code</strong>

                </div>

                <div class="editor-info">

                  <span id="lineCount">
                    0 سطر
                  </span>

                  <span>•</span>

                  <span id="charCount">
                    0 حرف
                  </span>

                  <span>•</span>

                  <span id="byteCount">
                    0 B
                  </span>

                </div>

              </div>


              <div class="editor-body">

                <div
                  class="line-numbers"
                  id="lineNumbers"
                >1</div>

                <textarea
                  id="codeInput"
                  spellcheck="false"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder={`// اكتب أو الصق كود JavaScript هنا

function greet(name) {
  const message = "Hello " + name;
  console.log(message);
}

greet("Ahmed");`}
                ></textarea>

              </div>

            </div>


            <!-- RESULT -->
            <div
              id="result"
              class="result neutral"
            >

              <div class="result-icon">
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div class="result-content">

                <strong id="resultTitle">
                  جاهز للفحص
                </strong>

                <span id="resultMessage">
                  أدخل كود JavaScript واضغط على "فحص الكود".
                </span>

              </div>

            </div>


            <!-- ERROR DETAILS -->
            <div
              id="errorDetails"
              class="error-details hidden"
            >

              <div class="error-header">

                <div>
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  تفاصيل الخطأ
                </div>

                <span id="errorLine">
                  —
                </span>

              </div>

              <pre id="errorText"></pre>

            </div>


            <!-- STATUS -->
            <div class="bottom-bar">

              <div class="privacy">
                <i class="fa-solid fa-shield-halved"></i>
                تتم معالجة الكود داخل المتصفح
              </div>

              <div class="status-ready">
                <span></span>
                JavaScript Ready
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FEATURES -->
      <section class="features-section">
        <div class="container">

          <div class="section-title">

            <span>المميزات</span>

            <h2>
              فحص JavaScript بسهولة
            </h2>

            <p>
              أداة بسيطة وسريعة لاكتشاف أخطاء بناء الجملة في كود JavaScript.
            </p>

          </div>


          <div class="features-grid">

            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-circle-check"></i>
              </div>

              <div>
                <h3>فحص سريع</h3>

                <p>
                  تحقق من صحة الكود خلال ثوانٍ.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-bug"></i>
              </div>

              <div>
                <h3>اكتشاف الأخطاء</h3>

                <p>
                  اكتشف أخطاء Syntax في الكود بسهولة.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <div>
                <h3>خصوصية كاملة</h3>

                <p>
                  لا يتم إرسال الكود إلى أي خادم.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-mobile-screen"></i>
              </div>

              <div>
                <h3>متوافق مع الهاتف</h3>

                <p>
                  يعمل على الهاتف والكمبيوتر والأجهزة اللوحية.
                </p>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-title">

            <span>طريقة الاستخدام</span>

            <h2>
              كيف تستخدم JavaScript Validator؟
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <b>01</b>

              <div>
                <h3>أدخل الكود</h3>

                <p>
                  الصق كود JavaScript في المحرر.
                </p>
              </div>

            </div>


            <div class="step">

              <b>02</b>

              <div>
                <h3>ابدأ الفحص</h3>

                <p>
                  اضغط على زر "فحص الكود".
                </p>
              </div>

            </div>


            <div class="step">

              <b>03</b>

              <div>
                <h3>راجع النتيجة</h3>

                <p>
                  ستظهر لك حالة الكود ورسالة الخطأ عند وجود مشكلة.
                </p>
              </div>

            </div>


            <div class="step">

              <b>04</b>

              <div>
                <h3>أصلح الخطأ</h3>

                <p>
                  عدّل الكود وأعد الفحص حتى يصبح صحيحاً.
                </p>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-title">

            <span>FAQ</span>

            <h2>
              الأسئلة الشائعة
            </h2>

          </div>


          <div class="faq-list">

            {
              faqs.map((faq) => (
                <details class="faq-item">

                  <summary>

                    <span>
                      {faq.q}
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>

                  </summary>

                  <p>
                    {faq.a}
                  </p>

                </details>
              ))
            }

          </div>

        </div>
      </section>

    

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-minifier/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Minifier</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-playground/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Playground</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/json-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Json Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/csv-to-json/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Csv To Json</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/json-diff/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Json Diff</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />


    <style>

      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }


      :global(:root) {

        --bg: #f8fafc;
        --section: #f1f5f9;
        --card: #ffffff;
        --editor: #f8fafc;

        --text: #0f172a;
        --muted: #64748b;

        --border:
          rgba(15, 23, 42, .09);

        --primary: #2563eb;
        --primary-hover: #1d4ed8;

        --cyan: #0891b2;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #ea580c;

        --shadow:
          0 18px 55px
          rgba(15, 23, 42, .08);
      }


      :global(html.dark-mode) {

        --bg: #07101f;
        --section: #0b1426;
        --card: #111d32;
        --editor: #0d1729;

        --text: #f8fafc;
        --muted: #94a3b8;

        --border:
          rgba(148, 163, 184, .12);

        --primary: #3b82f6;
        --primary-hover: #2563eb;

        --cyan: #06b6d4;
        --green: #22c55e;
        --red: #ef4444;
        --orange: #fb923c;

        --shadow:
          0 20px 65px
          rgba(0, 0, 0, .3);
      }


      .container {

        width:
          min(1120px, calc(100% - 28px));

        margin-inline: auto;
      }


      /* HERO */

      .hero {

        padding:
          38px 0 30px;

        text-align: center;
      }


      .breadcrumb {

        display: flex;

        justify-content: center;
        align-items: center;

        flex-wrap: wrap;

        gap: 8px;

        margin-bottom: 22px;

        color: var(--muted);

        font-size: 11px;
      }


      .breadcrumb a {

        color: var(--primary);

        text-decoration: none;
      }


      .tool-icon {

        width: 58px;
        height: 58px;

        margin:
          0 auto 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 16px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);

        font-size: 28px;
      }


      .eyebrow {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        color: var(--cyan);

        font-size: 11px;

        font-weight: 700;
      }


      .hero h1 {

        margin:
          5px 0 7px;

        font-size:
          clamp(30px, 5vw, 46px);

        line-height: 1.25;

        font-weight: 800;

        letter-spacing: -.8px;
      }


      .hero h1 span {
        color: var(--primary);
      }


      .hero p {

        max-width: 680px;

        margin: auto;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.9;
      }


      /* TOOL */

      .validator-section {

        padding:
          5px 0 65px;
      }


      .validator-card {

        overflow: hidden;

        background: var(--card);

        border:
          1px solid var(--border);

        border-radius: 20px;

        box-shadow: var(--shadow);
      }


      /* TOPBAR */

      .topbar {

        min-height: 65px;

        padding:
          12px 17px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;

        border-bottom:
          1px solid var(--border);
      }


      .tool-name {

        display: flex;

        align-items: center;

        gap: 10px;
      }


      .mini-icon {

        width: 38px;
        height: 38px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);

        font-size: 19px;
      }


      .tool-name strong {

        display: block;

        font-size: 13px;
      }


      .tool-name small {

        display: block;

        margin-top: 1px;

        color: var(--muted);

        font-size: 9px;
      }


      .local-badge {

        display: flex;

        align-items: center;

        gap: 6px;

        color: var(--green);

        font-size: 10px;

        font-weight: 700;
      }


      .local-badge span {

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--green);

        box-shadow:
          0 0 0 4px
          rgba(22, 163, 74, .1);
      }


      /* TOOLBAR */

      .toolbar {

        padding:
          10px 13px;

        display: flex;

        align-items: center;

        gap: 7px;

        border-bottom:
          1px solid var(--border);

        background: var(--section);
      }


      .btn {

        height: 36px;

        padding:
          0 13px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        border:
          1px solid var(--border);

        border-radius: 9px;

        background: var(--card);

        color: var(--text);

        font-family: inherit;

        font-size: 11px;

        font-weight: 700;

        cursor: pointer;

        transition: .2s ease;
      }


      .btn:hover {

        border-color: var(--primary);

        color: var(--primary);

        transform:
          translateY(-1px);
      }


      .btn-primary {

        padding-inline: 17px;

        background: var(--primary);

        border-color: var(--primary);

        color: #fff;

        box-shadow:
          0 5px 15px
          rgba(37, 99, 235, .18);
      }


      .btn-primary:hover {

        background:
          var(--primary-hover);

        color: #fff;
      }


      .btn-clear {
        color: var(--red);
      }


      /* EDITOR */

      .editor-wrapper {

        background: var(--card);
      }


      .editor-header {

        height: 45px;

        padding:
          0 14px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 10px;

        border-bottom:
          1px solid var(--border);
      }


      .editor-title {

        display: flex;

        align-items: center;

        gap: 8px;
      }


      .editor-title strong {

        font-size: 11px;
      }


      .indicator {

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--cyan);

        box-shadow:
          0 0 0 4px
          rgba(8, 145, 178, .1);
      }


      .editor-info {

        display: flex;

        gap: 5px;

        color: var(--muted);

        font-size: 9px;
      }


      .editor-body {

        height: 390px;

        display: flex;

        overflow: hidden;

        background: var(--editor);
      }


      .line-numbers {

        width: 43px;

        flex-shrink: 0;

        padding:
          17px 8px;

        overflow: hidden;

        border-left:
          1px solid var(--border);

        color: var(--muted);

        opacity: .5;

        font:
          12px/1.8
          Consolas,
          Monaco,
          monospace;

        text-align: center;

        user-select: none;
      }


      textarea {

        width:
          calc(100% - 43px);

        height: 100%;

        padding:
          17px 14px;

        border: 0;

        outline: none;

        resize: none;

        background: transparent;

        color: var(--text);

        font:
          12px/1.8
          Consolas,
          Monaco,
          "Courier New",
          monospace;

        direction: ltr;

        text-align: left;

        tab-size: 2;

        white-space: pre;

        overflow: auto;
      }


      textarea::placeholder {

        color: var(--muted);

        opacity: .55;
      }


      /* RESULT */

      .result {

        margin:
          13px;

        padding:
          13px;

        display: flex;

        align-items: center;

        gap: 12px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        transition: .25s ease;
      }


      .result-icon {

        width: 40px;
        height: 40px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 10px;

        font-size: 17px;
      }


      .result-content {

        min-width: 0;
      }


      .result-content strong {

        display: block;

        margin-bottom: 2px;

        font-size: 11px;
      }


      .result-content span {

        display: block;

        color: var(--muted);

        font-size: 9px;

        line-height: 1.7;
      }


      .result.neutral {

        background:
          rgba(37, 99, 235, .05);

        border-color:
          rgba(37, 99, 235, .12);
      }


      .result.neutral
      .result-icon {

        background:
          rgba(37, 99, 235, .1);

        color: var(--primary);
      }


      .result.success {

        background:
          rgba(22, 163, 74, .06);

        border-color:
          rgba(22, 163, 74, .15);
      }


      .result.success
      .result-icon {

        background:
          rgba(22, 163, 74, .1);

        color: var(--green);
      }


      .result.error {

        background:
          rgba(220, 38, 38, .06);

        border-color:
          rgba(220, 38, 38, .15);
      }


      .result.error
      .result-icon {

        background:
          rgba(220, 38, 38, .1);

        color: var(--red);
      }


      /* ERROR */

      .error-details {

        margin:
          -3px 13px 13px;

        overflow: hidden;

        border:
          1px solid
          rgba(220, 38, 38, .16);

        border-radius: 11px;

        background:
          rgba(220, 38, 38, .035);
      }


      .error-details.hidden {
        display: none;
      }


      .error-header {

        padding:
          9px 12px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 10px;

        border-bottom:
          1px solid
