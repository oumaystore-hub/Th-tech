        font-size: 9px;
      }


      .privacy i {
        color: var(--green);
      }


      .status-ready {

        display: flex;

        align-items: center;

        gap: 6px;

        color: var(--muted);

        font-size: 9px;
      }


      .status-ready span {

        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: var(--green);

        box-shadow:
          0 0 0 3px
          rgba(22, 163, 74, .1);
      }


      /* SECTIONS */

      .features-section {

        padding:
          65px 0;

        background: var(--section);
      }


      .how-section,
      .faq-section {

        padding:
          65px 0;
      }


      .section-title {

        margin-bottom: 30px;

        text-align: center;
      }


      .section-title > span {

        color: var(--primary);

        font-size: 11px;

        font-weight: 800;
      }


      .section-title h2 {

        margin:
          5px 0 6px;

        font-size:
          clamp(23px, 4vw, 31px);

        font-weight: 800;
      }


      .section-title p {

        margin: auto;

        color: var(--muted);

        font-size: 12px;
      }


      /* FEATURES */

      .features-grid {

        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 13px;
      }


      .feature {

        padding: 19px;

        display: flex;

        align-items: flex-start;

        gap: 12px;

        background: var(--card);

        border:
          1px solid var(--border);

        border-radius: 14px;

        transition: .2s ease;
      }


      .feature:hover {

        transform:
          translateY(-3px);

        box-shadow: var(--shadow);
      }


      .feature-icon {

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);
      }


      .feature h3 {

        margin:
          0 0 3px;

        font-size: 13px;
      }


      .feature p {

        margin: 0;

        color: var(--muted);

        font-size: 10px;

        line-height: 1.7;
      }


      /* STEPS */

      .steps {

        max-width: 820px;

        margin: auto;

        display: grid;

        grid-template-columns:
          1fr 1fr;

        gap: 12px;
      }


      .step {

        padding: 18px;

        display: flex;

        align-items: flex-start;

        gap: 12px;

        border:
          1px solid var(--border);

        border-radius: 14px;

        background: var(--card);
      }


      .step > b {

        width: 38px;
        height: 38px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);

        font-size: 9px;
      }


      .step h3 {

        margin:
          0 0 3px;

        font-size: 13px;
      }


      .step p {

        margin: 0;

        color: var(--muted);

        font-size: 10px;

        line-height: 1.7;
      }


      /* FAQ */

      .faq-list {

        max-width: 820px;

        margin: auto;

        display: grid;

        gap: 8px;
      }


      .faq-item {

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius: 13px;

        background: var(--card);
      }


      .faq-item summary {

        padding:
          15px 17px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 12px;

        cursor: pointer;

        list-style: none;

        font-size: 12px;

        font-weight: 700;
      }


      .faq-item summary::-webkit-details-marker {
        display: none;
      }


      .faq-item summary i {

        color: var(--primary);

        font-size: 9px;

        transition: .2s;
      }


      .faq-item[open]
      summary i {

        transform:
          rotate(180deg);
      }


      .faq-item p {

        margin: 0;

        padding:
          0 17px 16px;

        color: var(--muted);

        font-size: 11px;

        line-height: 1.8;
      }


      /* TABLET */

      @media (max-width: 900px) {

        .features-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

      }


      /* MOBILE */

      @media (max-width: 700px) {

        .editor-body {
          height: 300px;
        }

        .local-badge {
          display: none;
        }

        .steps {
          grid-template-columns: 1fr;
        }

      }


      @media (max-width: 520px) {

        .container {
          width:
            calc(100% - 18px);
        }


        .hero {
          padding:
            28px 0 24px;
        }


        .hero h1 {
          font-size: 31px;
        }


        .hero p {
          font-size: 11px;
        }


        .validator-card {
          border-radius: 16px;
        }


        .topbar {
          padding: 11px;
        }


        .mini-icon {

          width: 34px;
          height: 34px;
        }


        .tool-name strong {
          font-size: 11px;
        }


        .toolbar {

          display: grid;

          grid-template-columns:
            1.35fr 1fr 1fr 1fr;

          gap: 5px;

          padding: 8px;
        }


        .btn {

          padding:
            0 5px;

          height: 34px;

          font-size: 9px;

          gap: 4px;
        }


        .editor-header {
          padding: 0 10px;
        }


        .editor-title strong {
          font-size: 10px;
        }


        .editor-info {
          font-size: 8px;
        }


        .editor-body {
          height: 270px;
        }


        .line-numbers {

          width: 34px;

          padding-inline: 4px;

          font-size: 10px;
        }


        textarea {

          width:
            calc(100% - 34px);

          padding:
            14px 10px;

          font-size: 11px;
        }


        .result {

          margin: 9px;

          padding: 10px;
        }


        .result-icon {

          width: 35px;
          height: 35px;
        }


        .error-details {

          margin:
            -1px 9px 9px;
        }


        .bottom-bar {

          padding:
            9px 11px;
        }


        .privacy {

          font-size: 8px;
        }


        .status-ready {
          font-size: 8px;
        }


        .features-grid {

          grid-template-columns:
            1fr 1fr;

          gap: 8px;
        }


        .feature {

          padding: 13px;

          gap: 8px;

          flex-direction: column;
        }


        .feature-icon {

          width: 34px;
          height: 34px;
        }

      }


      @media (max-width: 360px) {

        .features-grid {
          grid-template-columns: 1fr;
        }


        .toolbar .btn {
          font-size: 0;
        }


        .toolbar .btn i {
          font-size: 12px;
        }

      }

    </style>


    <script is:inline>
      (() => {

        const input =
          document.getElementById("codeInput");

        const validateBtn =
          document.getElementById("validateBtn");

        const formatBtn =
          document.getElementById("formatBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const result =
          document.getElementById("result");

        const resultTitle =
          document.getElementById("resultTitle");

        const resultMessage =
          document.getElementById("resultMessage");

        const resultIcon =
          result.querySelector(".result-icon i");

        const errorDetails =
          document.getElementById("errorDetails");

        const errorText =
          document.getElementById("errorText");

        const errorLine =
          document.getElementById("errorLine");

        const lineNumbers =
          document.getElementById("lineNumbers");

        const lineCount =
          document.getElementById("lineCount");

        const charCount =
          document.getElementById("charCount");

        const byteCount =
          document.getElementById("byteCount");


        function getBytes(text) {

          return new Blob([text]).size;
        }


        function formatBytes(bytes) {

          if (!bytes) return "0 B";

          if (bytes < 1024) {
            return `${bytes} B`;
          }

          if (bytes < 1024 * 1024) {
            return `${(bytes / 1024).toFixed(1)} KB`;
          }

          return `${(
            bytes /
            (1024 * 1024)
          ).toFixed(2)} MB`;
        }


        function getLines(text) {

          if (!text) return 0;

          return text
            .split(/\r\n|\r|\n/)
            .length;
        }


        function updateLineNumbers() {

          const lines =
            Math.max(
              1,
              getLines(input.value)
            );

          let html = "";

          for (
            let i = 1;
            i <= lines;
            i++
          ) {

            html += `${i}<br>`;
          }

          lineNumbers.innerHTML =
            html;

          lineCount.textContent =
            `${lines} ${lines === 1 ? "سطر" : "أسطر"}`;

          charCount.textContent =
            `${input.value.length.toLocaleString()} حرف`;

          byteCount.textContent =
            formatBytes(
              getBytes(input.value)
            );
        }


        function setResult(
          type,
          titleText,
          message
        ) {

          result.className =
            `result ${type}`;

          resultTitle.textContent =
            titleText;

          resultMessage.textContent =
            message;


          if (type === "success") {

            resultIcon.className =
              "fa-solid fa-circle-check";

          } else if (type === "error") {

            resultIcon.className =
              "fa-solid fa-circle-xmark";

          } else {

            resultIcon.className =
              "fa-solid fa-circle-info";
          }
        }


        function hideError() {

          errorDetails.classList.add(
            "hidden"
          );

          errorText.textContent =
            "";

          errorLine.textContent =
            "—";
        }


        function showError(error) {

          errorDetails.classList.remove(
            "hidden"
          );


          let message =
            error &&
            error.message
              ? error.message
              : "JavaScript Syntax Error";


          /*
           * Remove browser-specific prefixes
           * where possible.
           */

          message =
            message
              .replace(/^Uncaught\s*/i, "")
              .trim();


          errorText.textContent =
            message;


          const match =
            message.match(
              /(?:line\s+|:)(\d+)/i
            );


          if (match) {

            errorLine.textContent =
              `السطر ${match[1]}`;

          } else {

            errorLine.textContent =
              "تحقق من الكود";
          }
        }


        function validateJavaScript() {

          const code =
            input.value.trim();


          if (!code) {

            hideError();

            setResult(
              "neutral",
              "لا يوجد كود",
              "أدخل كود JavaScript أولاً ثم اضغط على فحص الكود."
            );

            input.focus();

            return;
          }


          hideError();


          try {

            /*
             * Function constructor performs
             * JavaScript syntax parsing without
             * executing the supplied function body.
             *
             * The created function is never called.
             */

            new Function(code);


            setResult(
              "success",
              "الكود صحيح",
              "لم يتم العثور على أخطاء في بناء جملة JavaScript."
            );

          } catch (error) {

            setResult(
              "error",
              "تم العثور على خطأ",
              "يوجد خطأ في بناء جملة JavaScript."
            );

            showError(error);
          }
        }


        /*
         * Lightweight formatter.
         * It intentionally avoids aggressive
         * transformations that could alter code.
         */

        function formatJavaScript(code) {

          let result = "";

          let indent = 0;

          let quote = null;

          let template = false;

          let escaped = false;

          let line = "";

          const pushLine = () => {

            const clean =
              line.trim();

            if (clean) {

              result +=
                "  ".repeat(
                  Math.max(0, indent)
                ) +
                clean +
                "\n";
            }

            line = "";
          };


          for (
            let i = 0;
            i < code.length;
            i++
          ) {

            const ch = code[i];


            if (quote) {

              line += ch;

              if (escaped) {

                escaped = false;

              } else if (
                ch === "\\"
              ) {

                escaped = true;

              } else if (
                ch === quote
              ) {

                quote = null;
              }

              continue;
            }


            if (template) {

              line += ch;

              if (escaped) {

                escaped = false;

              } else if (
                ch === "\\"
              ) {

                escaped = true;

              } else if (
                ch === "`"
              ) {

                template = false;
              }

              continue;
            }


            if (
              ch === "'" ||
              ch === '"'
            ) {

              quote = ch;

              line += ch;

              continue;
            }


            if (ch === "`") {

              template = true;

              line += ch;

              continue;
            }


            if (ch === "{") {

              line += " {";

              pushLine();

              indent++;

              continue;
            }


            if (ch === "}") {

              if (line.trim()) {
                pushLine();
              }

              indent =
                Math.max(
                  0,
                  indent - 1
                );

              line = "}";

              const next =
                code[i + 1];

              if (
                next === ";" ||
                next === ","
              ) {

                continue;
              }

              pushLine();

              continue;
            }


            if (ch === ";") {

              line += ";";

              pushLine();

              continue;
            }


            if (ch === "\n" || ch === "\r") {

              pushLine();

              continue;
            }


            line += ch;
          }


          if (line.trim()) {
            pushLine();
          }


          return result.trim();
        }


        validateBtn.addEventListener(
          "click",
          validateJavaScript
        );


        formatBtn.addEventListener(
          "click",
          () => {

            const code =
              input.value.trim();


            if (!code) {

              setResult(
                "neutral",
                "لا يوجد كود",
                "أدخل كود JavaScript أولاً."
              );

              input.focus();

              return;
            }


            try {

              /*
               * Validate first so the formatter
               * doesn't make an invalid script
               * appear valid.
               */

              new Function(code);

              input.value =
                formatJavaScript(code);

              updateLineNumbers();

              setResult(
                "success",
                "تم تنسيق الكود",
                "تم ترتيب الكود مع الحفاظ على بنيته."
              );

            } catch (error) {

              setResult(
                "error",
                "الكود يحتوي على خطأ",
                "صحح خطأ JavaScript قبل محاولة التنسيق."
              );

              showError(error);
            }

          }
        );


        copyBtn.addEventListener(
          "click",
          async () => {

            if (!input.value) {

              setResult(
                "neutral",
                "لا يوجد كود",
                "أدخل الكود أولاً."
              );

              return;
            }


            try {

              await navigator.clipboard.writeText(
                input.value
              );

              setResult(
                "success",
                "تم النسخ",
                "تم نسخ كود JavaScript إلى الحافظة."
              );

            } catch {

              input.focus();

              input.select();

              document.execCommand(
                "copy"
              );

              setResult(
                "success",
                "تم النسخ",
                "تم نسخ الكود إلى الحافظة."
              );
            }
          }
        );


        clearBtn.addEventListener(
          "click",
          () => {

            input.value = "";

            updateLineNumbers();

            hideError();

            setResult(
              "neutral",
              "جاهز للفحص",
              "أدخل كود JavaScript واضغط على فحص الكود."
            );

            input.focus();
          }
        );


        input.addEventListener(
          "input",
          () => {

            updateLineNumbers();

            hideError();

            setResult(
              "neutral",
              "جاهز للفحص",
              "اضغط على فحص الكود للتحقق من JavaScript."
            );
          }
        );


        input.addEventListener(
          "scroll",
          () => {

            lineNumbers.scrollTop =
              input.scrollTop;
          }
        );


        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();

              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;

              input.value =
                input.value.substring(
                  0,
                  start
                ) +
                "  " +
                input.value.substring(
                  end
                );

              input.selectionStart =
                input.selectionEnd =
                  start + 2;

              updateLineNumbers();
            }


            if (
              (event.ctrlKey ||
                event.metaKey) &&
              event.key === "Enter"
            ) {

              event.preventDefault();

              validateJavaScript();
            }

          }
        );


        updateLineNumbers();

      })();
    </script>

  </body>
