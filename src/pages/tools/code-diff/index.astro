  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  /* الوضع الفاتح */
  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    color: #0f172a;
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card strong {
    color: #0f172a;
  }

  [data-theme="light"] .related-tool-card small {
    color: #64748b;
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }

  [data-theme="light"] .related-tool-icon {
    background: rgba(14, 165, 233, 0.12);
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


    <Footer />


    <!-- ======================================
         JAVASCRIPT
    ======================================= -->

    <script is:inline>
      (() => {

        const oldCode =
          document.getElementById("oldCode");

        const newCode =
          document.getElementById("newCode");

        const oldLines =
          document.getElementById("oldLines");

        const newLines =
          document.getElementById("newLines");

        const oldStats =
          document.getElementById("oldStats");

        const newStats =
          document.getElementById("newStats");

        const newSize =
          document.getElementById("newSize");

        const status =
          document.getElementById("status");

        const compareBtn =
          document.getElementById("compareBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const swapBtn =
          document.getElementById("swapBtn");

        const exampleBtn =
          document.getElementById("exampleBtn");

        const diffOutput =
          document.getElementById("diffOutput");

        const addedCount =
          document.getElementById("addedCount");

        const removedCount =
          document.getElementById("removedCount");

        const sameCount =
          document.getElementById("sameCount");

        const totalCount =
          document.getElementById("totalCount");


        /* ======================================
           EXAMPLE
        ======================================= */

        const originalExample = `function calculateTotal(items) {
  let total = 0;

  for (const item of items) {
    total += item.price;
  }

  return total;
}

const products = [
  { name: "Laptop", price: 800 },
  { name: "Mouse", price: 25 }
];

console.log(calculateTotal(products));`;


        const modifiedExample = `function calculateTotal(items) {
  let total = 0;

  for (const item of items) {
    total += item.price * item.quantity;
  }

  return total;
}

const products = [
  { name: "Laptop", price: 800, quantity: 1 },
  { name: "Mouse", price: 25, quantity: 2 }
];

console.log("Total:", calculateTotal(products));`;


        /* ======================================
           STATS
        ======================================= */

        function updateStats() {

          const oldValue =
            oldCode.value;

          const newValue =
            newCode.value;


          const oldLineCount =
            oldValue
              ? oldValue.split("\n").length
              : 1;


          const newLineCount =
            newValue
              ? newValue.split("\n").length
              : 1;


          oldLines.textContent =
            Array.from(
              { length: oldLineCount },
              (_, i) => i + 1
            ).join("\n");


          newLines.textContent =
            Array.from(
              { length: newLineCount },
              (_, i) => i + 1
            ).join("\n");


          oldStats.textContent =
            `${oldValue.length} حرف`;


          newStats.textContent =
            `${newValue.length} حرف`;


          const bytes =
            new Blob([newValue]).size;


          if (bytes < 1024) {

            newSize.textContent =
              `${bytes} B`;

          } else {

            newSize.textContent =
              `${(bytes / 1024).toFixed(1)} KB`;

          }

        }


        /* ======================================
           STATUS
        ======================================= */

        function setStatus(type, text) {

          status.className =
            `status ${type}`;

          status.innerHTML = `
            <span class="status-dot"></span>
            ${text}
          `;

        }


        /* ======================================
           ESCAPE HTML
        ======================================= */

        function escapeHtml(value) {

          return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

        }


        /* ======================================
           GET LINES
        ======================================= */

        function getLines(value) {

          if (!value) {
            return [];
          }

          return value
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .split("\n");

        }


        /* ======================================
           LCS DIFF
        ======================================= */

        function createDiff(oldArr, newArr) {

          const rows =
            oldArr.length + 1;

          const cols =
            newArr.length + 1;


          const matrix =
            Array.from(
              { length: rows },
              () =>
                new Array(cols).fill(0)
            );


          for (
            let i = oldArr.length - 1;
            i >= 0;
            i--
          ) {

            for (
              let j = newArr.length - 1;
              j >= 0;
              j--
            ) {

              if (
                oldArr[i] === newArr[j]
              ) {

                matrix[i][j] =
                  matrix[i + 1][j + 1] + 1;

              } else {

                matrix[i][j] =
                  Math.max(
                    matrix[i + 1][j],
                    matrix[i][j + 1]
                  );

              }

            }

          }


          const result = [];

          let i = 0;
          let j = 0;


          while (
            i < oldArr.length &&
            j < newArr.length
          ) {

            if (
              oldArr[i] === newArr[j]
            ) {

              result.push({
                type: "same",
                oldLine: i + 1,
                newLine: j + 1,
                text: oldArr[i]
              });

              i++;
              j++;

            } else if (
              matrix[i + 1][j] >=
              matrix[i][j + 1]
            ) {

              result.push({
                type: "removed",
                oldLine: i + 1,
                newLine: null,
                text: oldArr[i]
              });

              i++;

            } else {

              result.push({
                type: "added",
                oldLine: null,
                newLine: j + 1,
                text: newArr[j]
              });

              j++;

            }

          }


          while (
            i < oldArr.length
          ) {

            result.push({
              type: "removed",
              oldLine: i + 1,
              newLine: null,
              text: oldArr[i]
            });

            i++;

          }


          while (
            j < newArr.length
          ) {

            result.push({
              type: "added",
              oldLine: null,
              newLine: j + 1,
              text: newArr[j]
            });

            j++;

          }


          return result;

        }


        /* ======================================
           RENDER DIFF
        ======================================= */

        function renderDiff(diff) {

          if (!diff.length) {

            diffOutput.innerHTML = `
              <div class="empty-result">
                <i class="fa-solid fa-code-compare"></i>
                <strong>لا توجد مقارنة بعد</strong>
                <span>أدخل الكودين ثم اضغط على "مقارنة الكود"</span>
              </div>
            `;

            return;

          }


          diffOutput.innerHTML =
            diff
              .map((item) => {

                let symbol = " ";

                if (item.type === "added") {
                  symbol = "+";
                }

                if (item.type === "removed") {
                  symbol = "−";
                }


                const oldNumber =
                  item.oldLine === null
                    ? ""
                    : item.oldLine;


                const newNumber =
                  item.newLine === null
                    ? ""
                    : item.newLine;


                return `
                  <div class="diff-row ${item.type}">

                    <span class="diff-old-number">
                      ${oldNumber}
                    </span>

                    <span class="diff-new-number">
                      ${newNumber}
                    </span>

                    <span class="diff-symbol">
                      ${symbol}
                    </span>

                    <code>
                      ${escapeHtml(item.text)}
                    </code>

                  </div>
                `;

              })
              .join("");

        }


        /* ======================================
           COMPARE
        ======================================= */

        function compare() {

          const oldValue =
            oldCode.value;

          const newValue =
            newCode.value;


          if (
            !oldValue.trim() &&
            !newValue.trim()
          ) {

            addedCount.textContent =
              "0";

            removedCount.textContent =
              "0";

            sameCount.textContent =
              "0";

            totalCount.textContent =
              "0";


            renderDiff([]);

            setStatus(
              "warning",
              "أدخل الكود أولاً"
            );

            oldCode.focus();

            return;

          }


          const started =
            performance.now();


          try {

            const oldArr =
              getLines(oldValue);

            const newArr =
              getLines(newValue);


            const diff =
              createDiff(
                oldArr,
                newArr
              );


            let added = 0;
            let removed = 0;
            let same = 0;


            diff.forEach((item) => {

              if (item.type === "added") {
                added++;
              }

              if (item.type === "removed") {
                removed++;
              }

              if (item.type === "same") {
                same++;
              }

            });


            addedCount.textContent =
              added;

            removedCount.textContent =
              removed;

            sameCount.textContent =
              same;

            totalCount.textContent =
              oldArr.length +
              newArr.length;


            renderDiff(diff);


            const elapsed =
              performance.now() -
              started;


            setStatus(
              "success",
              `تمت المقارنة خلال ${elapsed.toFixed(1)} ms`
            );

          } catch {

            renderDiff([]);

            setStatus(
              "error",
              "تعذر مقارنة الأكواد"
            );

          }

        }


        /* ======================================
           COPY
        ======================================= */

        async function copyResult() {

          const rows =
            diffOutput.querySelectorAll(
              ".diff-row"
            );


          if (!rows.length) {

            setStatus(
              "warning",
              "لا توجد نتيجة لنسخها"
            );

            return;

          }


          const result =
            Array.from(rows)
              .map((row) => {

                const symbol =
                  row.querySelector(
                    ".diff-symbol"
                  )?.textContent
                    .trim() || "";

                const code =
                  row.querySelector(
                    "code"
                  )?.textContent || "";

                return `${symbol} ${code}`;

              })
              .join("\n");


          try {

            await navigator.clipboard.writeText(
              result
            );


            const oldText =
              copyBtn.innerHTML;


            copyBtn.innerHTML = `
              <i class="fa-solid fa-check"></i>
              تم النسخ
            `;


            setStatus(
              "success",
              "تم نسخ نتيجة المقارنة"
            );


            setTimeout(() => {

              copyBtn.innerHTML =
                oldText;

            }, 1500);

          } catch {

            setStatus(
              "error",
              "تعذر نسخ النتيجة"
            );

          }

        }


        /* ======================================
           CLEAR
        ======================================= */

        function clearAll() {

          oldCode.value = "";

          newCode.value = "";


          addedCount.textContent =
            "0";

          removedCount.textContent =
            "0";

          sameCount.textContent =
            "0";

          totalCount.textContent =
            "0";


          renderDiff([]);

          updateStats();


          setStatus(
            "idle",
            "جاهز"
          );


          oldCode.focus();

        }


        /* ======================================
           SWAP
        ======================================= */

        function swapCodes() {

          const temporary =
            oldCode.value;


          oldCode.value =
            newCode.value;

          newCode.value =
            temporary;


          updateStats();

          compare();

        }


        /* ======================================
           EXAMPLE
        ======================================= */

        exampleBtn.addEventListener(
          "click",
          () => {

            oldCode.value =
              originalExample;

            newCode.value =
              modifiedExample;


            updateStats();

            compare();

          }
        );


        /* ======================================
           EVENTS
        ======================================= */

        compareBtn.addEventListener(
          "click",
          compare
        );


        copyBtn.addEventListener(
          "click",
          copyResult
        );


        clearBtn.addEventListener(
          "click",
          clearAll
        );


        swapBtn.addEventListener(
          "click",
          swapCodes
        );


        oldCode.addEventListener(
          "input",
          updateStats
        );


        newCode.addEventListener(
          "input",
          updateStats
        );


        oldCode.addEventListener(
          "scroll",
          () => {

            oldLines.scrollTop =
              oldCode.scrollTop;

          }
        );


        newCode.addEventListener(
          "scroll",
          () => {

            newLines.scrollTop =
              newCode.scrollTop;

          }
        );


        /* ======================================
           TAB + CTRL ENTER
        ======================================= */

        function setupEditor(editor) {

          editor.addEventListener(
            "keydown",
            (event) => {

              if (
                event.key === "Tab"
              ) {

                event.preventDefault();


                const start =
                  editor.selectionStart;

                const end =
                  editor.selectionEnd;


                editor.value =
                  editor.value.substring(
                    0,
                    start
                  ) +
                  "  " +
                  editor.value.substring(
                    end
                  );


                editor.selectionStart =
                  editor.selectionEnd =
                    start + 2;


                updateStats();

              }


              if (
                event.key === "Enter" &&
                (event.ctrlKey ||
                 event.metaKey)
              ) {

                event.preventDefault();

                compare();

              }

            }
          );

        }


        setupEditor(oldCode);
        setupEditor(newCode);


        /* ======================================
           INITIAL
        ======================================= */

        updateStats();

      })();
    </script>


