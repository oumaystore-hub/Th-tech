---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "Code Diff - مقارنة الأكواد أونلاين مجاناً | Th.Tech";

const description =
  "أداة Code Diff مجانية لمقارنة نسختين من الأكواد ومعرفة الأسطر المضافة والمحذوفة والمتطابقة مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة Code Diff؟",
    a: "أداة تساعدك على مقارنة نسختين من الكود ومعرفة الأسطر التي تمت إضافتها أو حذفها أو بقيت كما هي."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم مقارنة الأكواد مباشرة داخل المتصفح، ولا تحتاج إلى إرسال الكود إلى خادم خارجي."
  },
  {
    q: "ما فائدة مقارنة الأكواد؟",
    a: "تساعد مقارنة الأكواد على اكتشاف التغييرات والأخطاء ومراجعة الفرق بين إصدارين من الملف بسرعة."
  },
  {
    q: "هل يمكن مقارنة أي نوع من الأكواد؟",
    a: "نعم. يمكن استخدام الأداة لمقارنة JavaScript وTypeScript وHTML وCSS وJSON وPython وغيرها من النصوص البرمجية."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم. الأداة مجانية ويمكن استخدامها مباشرة من المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      name="theme-color"
      content="#4f46e5"
    />

    <link
      rel="icon"
      href={`${base}/logo1.png`}
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>

    <Header />

    <main>

      <!-- ======================================
           HERO
      ======================================= -->

      <section class="hero">

        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container">

          <div class="breadcrumb">

            <a href={`${base}/`}>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left"></i>

            <span>
              Code Diff
            </span>

          </div>


          <div class="hero-badge">

            <span class="badge-dot"></span>

            Developer Tools

            <i class="fa-solid fa-code-compare"></i>

          </div>


          <div class="hero-icon">

            <i class="fa-solid fa-code-compare"></i>

            <span class="diff-mark">
              ±
            </span>

          </div>


          <h1>

            Code

            <span>Diff</span>

          </h1>


          <p>

            قارن بين نسختين من الكود بسرعة واحترافية،
            واكتشف الأسطر المضافة والمحذوفة والمتطابقة مباشرة من المتصفح.

          </p>

        </div>

      </section>


      <!-- ======================================
           TOOL
      ======================================= -->

      <section class="tool-section">

        <div class="container">

          <div class="diff-card">


            <!-- TOP BAR -->

            <div class="topbar">

              <div class="project-info">

                <div class="project-logo">

                  <i class="fa-solid fa-code-compare"></i>

                </div>

                <div>

                  <strong>
                    Code Diff
                  </strong>

                  <span>
                    Online Code Comparison Tool
                  </span>

                </div>

              </div>


              <div class="topbar-status">

                <span class="online-dot"></span>

                Local Processing

              </div>

            </div>


            <!-- ACTION BAR -->

            <div class="actionbar">

              <div class="action-group">

                <button
                  id="exampleBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-solid fa-wand-magic-sparkles"></i>

                  مثال

                </button>


                <button
                  id="swapBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-solid fa-right-left"></i>

                  تبديل

                </button>


                <button
                  id="clearBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-solid fa-trash-can"></i>

                  مسح

                </button>

              </div>


              <div class="action-group">

                <button
                  id="copyBtn"
                  class="action secondary"
                  type="button"
                >

                  <i class="fa-regular fa-copy"></i>

                  نسخ النتيجة

                </button>


                <button
                  id="compareBtn"
                  class="action primary"
                  type="button"
                >

                  <i class="fa-solid fa-code-compare"></i>

                  مقارنة الكود

                </button>

              </div>

            </div>


            <!-- EDITORS -->

            <div class="editor-grid">


              <!-- ORIGINAL -->

              <div class="editor-card">

                <div class="editor-head">

                  <div class="editor-label">

                    <span class="file-icon original-icon">

                      <i class="fa-solid fa-file-code"></i>

                    </span>

                    <div>

                      <strong>
                        Original
                      </strong>

                      <small>
                        Original Code
                      </small>

                    </div>

                  </div>


                  <div
                    id="oldStats"
                    class="editor-stats"
                  >
                    0 حرف
                  </div>

                </div>


                <div class="code-area">

                  <div
                    id="oldLines"
                    class="line-numbers"
                  >
                    1
                  </div>


                  <textarea
                    id="oldCode"
                    spellcheck="false"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="// الكود الأصلي..."
                  ></textarea>

                </div>


                <div class="editor-foot">

                  <span>

                    <i class="fa-solid fa-keyboard"></i>

                    Ctrl + Enter

                  </span>

                  <span>
                    Original
                  </span>

                </div>

              </div>


              <!-- MODIFIED -->

              <div class="editor-card">

                <div class="editor-head">

                  <div class="editor-label">

                    <span class="file-icon modified-icon">

                      <i class="fa-solid fa-file-pen"></i>

                    </span>

                    <div>

                      <strong>
                        Modified
                      </strong>

                      <small>
                        Modified Code
                      </small>

                    </div>

                  </div>


                  <div
                    id="newStats"
                    class="editor-stats"
                  >
                    0 حرف
                  </div>

                </div>


                <div class="code-area">

                  <div
                    id="newLines"
                    class="line-numbers"
                  >
                    1
                  </div>


                  <textarea
                    id="newCode"
                    spellcheck="false"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="// الكود المعدل..."
                  ></textarea>

                </div>


                <div class="editor-foot">

                  <span
                    id="status"
                    class="status idle"
                  >

                    <span class="status-dot"></span>

                    جاهز

                  </span>

                  <span id="newSize">
                    0 B
                  </span>

                </div>

              </div>

            </div>


            <!-- DIFF RESULT -->

            <div class="result-section">

              <div class="result-head">

                <div class="result-title">

                  <div class="result-icon">

                    <i class="fa-solid fa-code-compare"></i>

                  </div>

                  <div>

                    <strong>
                      Comparison Result
                    </strong>

                    <span>
                      نتائج مقارنة الأكواد
                    </span>

                  </div>

                </div>


                <div class="result-badge">

                  <span class="result-dot"></span>

                  Diff

                </div>

              </div>


              <div
                id="diffOutput"
                class="diff-output"
              >

                <div class="empty-result">

                  <i class="fa-solid fa-code-compare"></i>

                  <strong>
                    لا توجد مقارنة بعد
                  </strong>

                  <span>
                    أدخل الكودين ثم اضغط على "مقارنة الكود"
                  </span>

                </div>

              </div>

            </div>


            <!-- DIFF STATS -->

            <div class="diff-stats">

              <div class="mini-stat">

                <div class="mini-icon added">

                  <i class="fa-solid fa-plus"></i>

                </div>

                <div>

                  <strong id="addedCount">
                    0
                  </strong>

                  <span>
                    أسطر مضافة
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon removed">

                  <i class="fa-solid fa-minus"></i>

                </div>

                <div>

                  <strong id="removedCount">
                    0
                  </strong>

                  <span>
                    أسطر محذوفة
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon same">

                  <i class="fa-solid fa-equals"></i>

                </div>

                <div>

                  <strong id="sameCount">
                    0
                  </strong>

                  <span>
                    أسطر متطابقة
                  </span>

                </div>

              </div>


              <div class="mini-stat">

                <div class="mini-icon blue">

                  <i class="fa-solid fa-code"></i>

                </div>

                <div>

                  <strong id="totalCount">
                    0
                  </strong>

                  <span>
                    إجمالي الأسطر
                  </span>

                </div>

              </div>

            </div>


          </div>


          <!-- ======================================
               INFORMATION
          ======================================= -->

          <section class="information">

            <div class="section-title">

              <span>
                Developer Tools
              </span>

              <h2>
                أداة مقارنة الأكواد الاحترافية
              </h2>

              <p>
                اكتشف التغييرات بين نسختين من الكود
                بطريقة واضحة وسريعة ومنظمة.
              </p>

            </div>


            <div class="info-grid">


              <article class="info-card">

                <div class="info-number">
                  01
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-code-compare"></i>

                </div>

                <h3>
                  مقارنة دقيقة
                </h3>

                <p>
                  مقارنة الأسطر بين النسخة الأصلية
                  والنسخة المعدلة وإظهار الاختلافات.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  02
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-list-check"></i>

                </div>

                <h3>
                  معرفة التغييرات
                </h3>

                <p>
                  تعرف بسهولة على الأسطر التي تمت إضافتها
                  أو حذفها أو بقيت متطابقة.
                </p>

              </article>


              <article class="info-card">

                <div class="info-number">
                  03
                </div>

                <div class="info-card-icon">

                  <i class="fa-solid fa-shield-halved"></i>

                </div>

                <h3>
                  معالجة محلية
                </h3>

                <p>
                  تتم المقارنة داخل المتصفح دون إرسال
                  الأكواد إلى خادم خارجي.
                </p>

              </article>

            </div>

          </section>


          <!-- ======================================
               HOW TO
          ======================================= -->

          <section class="how-section">

            <div class="section-title">

              <span>
                How It Works
              </span>

              <h2>
                طريقة استخدام الأداة
              </h2>

            </div>


            <div class="steps">


              <div class="step">

                <div class="step-icon">

                  <span>
                    01
                  </span>

                </div>

                <div>

                  <h3>
                    أدخل الكود الأصلي
                  </h3>

                  <p>
                    ضع النسخة الأصلية من الكود داخل مربع Original.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    02
                  </span>

                </div>

                <div>

                  <h3>
                    أدخل الكود المعدل
                  </h3>

                  <p>
                    ضع النسخة الجديدة داخل مربع Modified.
                  </p>

                </div>

              </div>


              <div class="step">

                <div class="step-icon">

                  <span>
                    03
                  </span>

                </div>

                <div>

                  <h3>
                    اعرض الفرق
                  </h3>

                  <p>
                    اضغط على مقارنة الكود لرؤية جميع التغييرات.
                  </p>

                </div>

              </div>

            </div>

          </section>


          <!-- ======================================
               FAQ
          ======================================= -->

          <section class="faq-section">

            <div class="section-title">

              <span>
                FAQ
              </span>

              <h2>
                الأسئلة الشائعة
              </h2>

            </div>


            <div class="faq-list">

              {
                faqs.map((faq) => (
                  <details>

                    <summary>

                      <span>
                        {faq.q}
                      </span>

                      <i class="fa-solid fa-chevron-down"></i>

                    </summary>

                    <div class="faq-answer">
                      {faq.a}
                    </div>

                  </details>
                ))
              }

            </div>

          </section>

        </div>

      </section>

    





<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
