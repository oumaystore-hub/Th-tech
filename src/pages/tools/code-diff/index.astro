      }


      .status.error {

        color:
          #f87171;

      }


      .status.error .status-dot {

        background:
          #ef4444;

      }


      /* ======================================
         RESULT
      ======================================= */

      .result-section {

        margin:
          0 16px 14px;

        overflow:
          hidden;

        border:
          1px solid
          rgba(79,70,229,.14);

        border-radius:
          15px;

        background:
          var(--code-bg);

        color:
          var(--code-text);

      }


      .result-head {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          12px;

        padding:
          12px 14px;

        background:
          var(--code-bg-2);

        border-bottom:
          1px solid
          rgba(255,255,255,.06);

      }


      .result-title {

        display:
          flex;

        align-items:
          center;

        gap:
          9px;

      }


      .result-icon {

        width:
          32px;

        height:
          32px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          8px;

        background:
          rgba(99,102,241,.13);

        color:
          #818cf8;

        font-size:
          12px;

      }


      .result-title strong {

        display:
          block;

        font-size:
          11px;

      }


      .result-title span {

        display:
          block;

        margin-top:
          1px;

        color:
          #64748b;

        font-size:
          9px;

      }


      .result-badge {

        display:
          flex;

        align-items:
          center;

        gap:
          6px;

        padding:
          5px 8px;

        border:
          1px solid
          rgba(99,102,241,.2);

        border-radius:
          999px;

        color:
          #a5b4fc;

        font:
          600 9px
          "JetBrains Mono",
          monospace;

      }


      .result-dot {

        width:
          5px;

        height:
          5px;

        border-radius:
          50%;

        background:
          #818cf8;

      }


      .diff-output {

        min-height:
          120px;

        max-height:
          460px;

        overflow:
          auto;

        direction:
          ltr;

        font:
          11px/1.8
          "JetBrains Mono",
          monospace;

      }


      .empty-result {

        min-height:
          150px;

        display:
          flex;

        flex-direction:
          column;

        align-items:
          center;

        justify-content:
          center;

        gap:
          5px;

        padding:
          25px;

        text-align:
          center;

        color:
          #64748b;

      }


      .empty-result i {

        margin-bottom:
          5px;

        color:
          #6366f1;

        font-size:
          22px;

      }


      .empty-result strong {

        color:
          #cbd5e1;

        font-size:
          11px;

      }


      .empty-result span {

        font-size:
          9px;

      }


      .diff-row {

        display:
          grid;

        grid-template-columns:
          45px 45px 28px minmax(0,1fr);

        min-height:
          28px;

        border-bottom:
          1px solid
          rgba(255,255,255,.025);

      }


      .diff-row > span {

        display:
          flex;

        align-items:
          center;

        min-width:
          0;

      }


      .diff-old-number,
      .diff-new-number {

        justify-content:
          center;

        color:
          #475569;

        background:
          rgba(0,0,0,.12);

        user-select:
          none;

        font-size:
          9px;

      }


      .diff-symbol {

        justify-content:
          center;

        color:
          #64748b;

        font-weight:
          700;

      }


      .diff-row code {

        display:
          block;

        min-width:
          0;

        padding:
          4px 10px;

        color:
          #d1d5db;

        white-space:
          pre;

        overflow-x:
          auto;

        font:
          inherit;

      }


      .diff-row.added {

        background:
          rgba(34,197,94,.09);

      }


      .diff-row.added .diff-symbol {

        color:
          #4ade80;

      }


      .diff-row.added code {

        color:
          #bbf7d0;

      }


      .diff-row.removed {

        background:
          rgba(239,68,68,.09);

      }


      .diff-row.removed .diff-symbol {

        color:
          #f87171;

      }


      .diff-row.removed code {

        color:
          #fecaca;

      }


      .diff-row.same:hover {

        background:
          rgba(255,255,255,.025);

      }


      /* ======================================
         STATS
      ======================================= */

      .diff-stats {

        display:
          grid;

        grid-template-columns:
          repeat(
            4,
            1fr
          );

        gap:
          10px;

        padding:
          0 16px 16px;

      }


      .mini-stat {

        display:
          flex;

        align-items:
          center;

        gap:
          10px;

        padding:
          12px;

        border:
          1px solid
          var(--border);

        border-radius:
          13px;

        background:
          var(--surface-2);

      }


      .mini-icon {

        width:
          35px;

        height:
          35px;

        flex:
          0 0 35px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          9px;

      }


      .mini-icon.added {

        background:
          rgba(22,163,74,.1);

        color:
          var(--green);

      }


      .mini-icon.removed {

        background:
          rgba(220,38,38,.1);

        color:
          var(--red);

      }


      .mini-icon.same {

        background:
          rgba(124,58,237,.1);

        color:
          var(--purple);

      }


      .mini-icon.blue {

        background:
          rgba(37,99,235,.1);

        color:
          var(--blue);

      }


      .mini-stat strong {

        display:
          block;

        font:
          700 12px
          "JetBrains Mono",
          monospace;

      }


      .mini-stat span {

        display:
          block;

        margin-top:
          2px;

        color:
          var(--muted);

        font-size:
          8px;

      }


      /* ======================================
         INFORMATION
      ======================================= */

      .information {

        margin-top:
          55px;

      }


      .section-title {

        text-align:
          center;

        max-width:
          700px;

        margin:
          0 auto 25px;

      }


      .section-title > span {

        color:
          var(--primary);

        font-size:
          11px;

        font-weight:
          800;

        letter-spacing:
          .5px;

      }


      .section-title h2 {

        margin:
          5px 0 7px;

        font-size:
          clamp(
            21px,
            4vw,
            28px
          );

      }


      .section-title p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          12px;

        line-height:
          1.9;

      }


      .info-grid {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .info-card {

        position:
          relative;

        padding:
          24px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          18px;

        background:
          var(--surface);

      }


      .info-number {

        position:
          absolute;

        top:
          15px;

        left:
          18px;

        color:
          var(--muted);

        opacity:
          .25;

        font:
          700 28px
          "JetBrains Mono",
          monospace;

      }


      .info-card-icon {

        width:
          42px;

        height:
          42px;

        display:
          grid;

        place-items:
          center;

        margin-bottom:
          13px;

        border-radius:
          11px;

        background:
          rgba(79,70,229,.1);

        color:
          var(--primary);

      }


      .info-card h3 {

        margin:
          0 0 7px;

        font-size:
          14px;

      }


      .info-card p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         HOW
      ======================================= */

      .how-section {

        margin-top:
          55px;

      }


      .steps {

        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            1fr
          );

        gap:
          14px;

      }


      .step {

        display:
          flex;

        align-items:
          flex-start;

        gap:
          12px;

        padding:
          20px;

        background:
          var(--surface);

        border:
          1px solid
          var(--border);

        border-radius:
          17px;

      }


      .step-icon {

        width:
          43px;

        height:
          43px;

        flex:
          0 0 43px;

        display:
          grid;

        place-items:
          center;

        border-radius:
          12px;

        background:
          linear-gradient(
            135deg,
            rgba(79,70,229,.12),
            rgba(99,102,241,.12)
          );

        color:
          var(--primary);

        font:
          700 10px
          "JetBrains Mono",
          monospace;

      }


      .step h3 {

        margin:
          0 0 5px;

        font-size:
          13px;

      }


      .step p {

        margin:
          0;

        color:
          var(--muted);

        font-size:
          10px;

        line-height:
          1.8;

      }


      /* ======================================
         FAQ
      ======================================= */

      .faq-section {

        margin:
          55px auto 70px;

        max-width:
          850px;

      }


      .faq-list details {

        margin-bottom:
          9px;

        overflow:
          hidden;

        border:
          1px solid
          var(--border);

        border-radius:
          14px;

        background:
          var(--surface);

      }


      .faq-list summary {

        display:
          flex;

        align-items:
          center;

        justify-content:
          space-between;

        gap:
          15px;

        padding:
          16px 18px;

        cursor:
          pointer;

        list-style:
          none;

        font-size:
          12px;

        font-weight:
          700;

      }


      .faq-list summary::-webkit-details-marker {

        display:
          none;

      }


      .faq-list summary i {

        color:
          var(--muted);

        font-size:
          10px;

        transition:
          transform .2s ease;

      }


      .faq-list details[open]
      summary i {

        transform:
          rotate(180deg);

      }


      .faq-answer {

        padding:
          0 18px 17px;

        color:
          var(--muted);

        font-size:
          11px;

        line-height:
          1.9;

      }


      /* ======================================
         RESPONSIVE
      ======================================= */

      @media (max-width: 900px) {

        .editor-grid {

          grid-template-columns:
            1fr;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }

      }


      @media (max-width: 700px) {

        .diff-stats {

          grid-template-columns:
            repeat(
              2,
              1fr
            );

        }


        .actionbar {

          flex-direction:
            column;

          align-items:
            stretch;

        }


        .action-group {

          width:
            100%;

        }


        .action {

          flex:
            1;

        }


        .diff-row {

          grid-template-columns:
            36px 36px 25px minmax(0,1fr);

        }

      }


      @media (max-width: 600px) {

        .container {

          width:
            calc(
              100% - 20px
            );

        }


        .hero {

          padding:
            25px 0 32px;

        }


        .hero-icon {

          width:
            60px;

          height:
            60px;

          font-size:
            20px;

        }


        .hero p {

          font-size:
            12px;

        }


        .topbar {

          padding:
            14px;

        }


        .topbar-status {

          display:
            none;

        }


        .actionbar {

          padding:
            10px;

        }


        .action {

          padding:
            9px 7px;

          font-size:
            10px;

        }


        .editor-grid {

          padding:
            10px;

        }


        .code-area {

          height:
            330px;

        }


        .result-section {

          margin:
            0 10px 10px;

        }


        .diff-stats {

          padding:
            0 10px 10px;

        }


        .diff-output {

          max-height:
            360px;

        }


        .diff-row {

          grid-template-columns:
            31px 31px 24px minmax(0,1fr);

          font-size:
            10px;

        }


        .diff-row code {

          padding:
            4px 7px;

        }


        .info-grid,
        .steps {

          grid-template-columns:
            1fr;

        }


        .faq-section {

          margin-bottom:
            45px;

        }

      }

    </style>

  </body>
</html>
