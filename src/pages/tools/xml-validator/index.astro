---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "XML Validator - التحقق من XML أونلاين مجاناً | Th.Tech";

const description =
  "أداة XML Validator مجانية للتحقق من صحة XML واكتشاف أخطاء البنية والعناصر والخصائص مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة XML Validator؟",
    a: "أداة XML Validator تساعدك على التحقق من صحة بنية XML واكتشاف الأخطاء قبل استخدام الملف في مشروعك."
  },
  {
    q: "هل يتم إرسال XML إلى الخادم؟",
    a: "لا. تتم عملية التحقق مباشرة داخل المتصفح، لذلك لا تحتاج إلى رفع XML إلى خادم خارجي."
  },
  {
    q: "ما الأخطاء التي يمكن اكتشافها؟",
    a: "يمكن اكتشاف أخطاء مثل العناصر غير المغلقة، العناصر المتداخلة بشكل غير صحيح، الخصائص غير الصالحة، ومشاكل بناء XML."
  },
  {
    q: "هل يمكن استخدام الأداة مع XML كبير؟",
    a: "نعم، يمكن استخدامها مع معظم ملفات XML المعتادة، ويعتمد الحد العملي على حجم الملف وإمكانيات جهازك."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- HERO -->
      <section class="hero">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>

          <span>XML Validator</span>
        </div>

        <div class="hero-badge">
          <i class="fa-solid fa-code"></i>
          Developer Tools
        </div>

        <div class="hero-icon">
          <div class="icon-box">
            <i class="fa-solid fa-circle-check"></i>

            <span class="xml-mark">&lt;/&gt;</span>
          </div>
        </div>

        <h1>XML Validator</h1>

        <p>
          تحقق من صحة XML واكتشف أخطاء البنية والعناصر والخصائص
          بسرعة مباشرة من متصفحك.
        </p>

        <div class="hero-tags">

          <span>
            <i class="fa-solid fa-bolt"></i>
            سريع
          </span>

          <span>
            <i class="fa-solid fa-shield-halved"></i>
            آمن
          </span>

          <span>
            <i class="fa-solid fa-lock"></i>
            محلي 100%
          </span>

        </div>

      </section>

      <!-- TOOL -->
      <section class="tool-section">

        <div class="validator-card">

          <div class="card-topbar">

            <div class="topbar-title">
              <span class="status-dot"></span>
              XML Validator
            </div>

            <div class="topbar-type">
              <i class="fa-solid fa-file-code"></i>
              XML
            </div>

          </div>

          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="action-btn secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="action-btn danger">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

            <button id="copyBtn" class="action-btn secondary">
              <i class="fa-solid fa-copy"></i>
              نسخ
            </button>

            <button id="validateBtn" class="action-btn primary">
              <i class="fa-solid fa-circle-check"></i>
              تحقق من XML
            </button>

          </div>

          <!-- EDITOR -->
          <div class="editor-panel">

            <div class="editor-header">

              <div class="editor-title">

                <span class="file-icon">
                  <i class="fa-solid fa-file-code"></i>
                </span>

                <div>
                  <strong>XML Input</strong>
                  <small>XML للتحقق</small>
                </div>

              </div>

              <span id="languageBadge" class="language-badge">
                XML
              </span>

            </div>

            <div class="editor-wrap">

              <div id="lineNumbers" class="line-numbers">1</div>

              <textarea
                id="xmlInput"
                spellcheck="false"
                placeholder={`<?xml version="1.0" encoding="UTF-8"?>
<root>
  <item>
    <name>Th.Tech</name>
  </item>
</root>`}
              ></textarea>

            </div>

            <div class="editor-footer">

              <span>
                <i class="fa-solid fa-keyboard"></i>
                Ctrl + Enter للتحقق
              </span>

              <span id="inputStats">
                0 حرف
              </span>

            </div>

          </div>

          <!-- VALIDATION RESULT -->
          <div id="validationResult" class="validation-result hidden">

            <div id="validationIcon" class="validation-icon">
              <i class="fa-solid fa-check"></i>
            </div>

            <div class="validation-content">

              <strong id="validationTitle">
                XML صالح
              </strong>

              <p id="validationMessage">
                بنية XML صحيحة.
              </p>

            </div>

          </div>

          <!-- DETAILS -->
          <div id="detailsBox" class="details-box hidden">

            <div class="detail-item">
              <i class="fa-solid fa-circle-info"></i>

              <div>
                <strong>الحالة</strong>
                <span id="detailStatus">—</span>
              </div>
            </div>

            <div class="detail-item">
              <i class="fa-solid fa-file-code"></i>

              <div>
                <strong>العناصر</strong>
                <span id="detailElements">0</span>
              </div>
            </div>

            <div class="detail-item">
              <i class="fa-solid fa-layer-group"></i>

              <div>
                <strong>المستوى</strong>
                <span id="detailDepth">0</span>
              </div>
            </div>

          </div>

          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>

              <div>
                <strong id="statLines">0</strong>
                <span>سطر</span>
              </div>

            </div>

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <strong id="statChars">0</strong>
                <span>حرف</span>
              </div>

            </div>

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <strong id="statElements">0</strong>
                <span>عنصر</span>
              </div>

            </div>

            <div class="stat-card">

              <div class="stat-icon">
                <i class="fa-solid fa-clock"></i>
              </div>

              <div>
                <strong id="statTime">0 ms</strong>
                <span>الوقت</span>
              </div>

            </div>

          </div>

        </div>

      </section>

      <!-- INFO -->
      <section class="info-section">

        <div class="section-heading">

          <span class="section-badge">
            <i class="fa-solid fa-circle-info"></i>
            معلومات
          </span>

          <h2>ما هي أداة XML Validator؟</h2>

          <p>
            أداة مجانية للتحقق من صحة ملفات XML واكتشاف المشاكل
            في البنية قبل استخدامها في التطبيقات والمشاريع.
          </p>

        </div>

        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-circle-check"></i>
            </div>

            <h3>تحقق دقيق</h3>

            <p>
              استخدم محلل XML المدمج في المتصفح للتحقق من البنية
              واكتشاف الأخطاء الأساسية.
            </p>

          </article>

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>خصوصية كاملة</h3>

            <p>
              تتم معالجة البيانات محلياً داخل المتصفح دون إرسال
              محتوى XML إلى خادم خارجي.
            </p>

          </article>

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-gauge-high"></i>
            </div>

            <h3>نتيجة فورية</h3>

            <p>
              احصل على نتيجة التحقق والإحصائيات خلال لحظات
              دون تثبيت أي برنامج.
            </p>

          </article>

        </div>

      </section>

      <!-- HOW TO -->
      <section class="how-section">

        <div class="section-heading">

          <span class="section-badge">
            <i class="fa-solid fa-list-ol"></i>
            طريقة الاستخدام
          </span>

          <h2>كيف تستخدم XML Validator؟</h2>

        </div>

        <div class="steps">

          <div class="step">

            <div class="step-number">1</div>

            <div>
              <h3>أدخل XML</h3>

              <p>
                الصق كود XML في محرر الأداة.
              </p>
            </div>

          </div>

          <div class="step">

            <div class="step-number">2</div>

            <div>
              <h3>ابدأ التحقق</h3>

              <p>
                اضغط على «تحقق من XML» أو استخدم Ctrl + Enter.
              </p>
            </div>

          </div>

          <div class="step">

            <div class="step-number">3</div>

            <div>
              <h3>راجع النتيجة</h3>

              <p>
                ستظهر حالة XML والإحصائيات الخاصة بالملف.
              </p>
            </div>

          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="faq-section">

        <div class="section-heading">

          <span class="section-badge">
            <i class="fa-solid fa-circle-question"></i>
            FAQ
          </span>

          <h2>الأسئلة الشائعة</h2>

        </div>

        <div class="faq-list">

          {faqs.map((faq) => (
            <details class="faq-item">

              <summary>
                <span>{faq.q}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <div class="faq-answer">
                {faq.a}
              </div>

            </details>
          ))}

        </div>

      </section>

    









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/json-to-xml/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 4c-2 1-3 3-3 6s1 5 3 6"/>
        <path d="M16 4c2 1 3 3 3 6s-1 5-3 6"/>
        <path d="M9 8h6M9 12h4M9 16h6"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Json To Xml</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/xml-formatter/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3h8l4 4v14H6z"/>
        <path d="M14 3v5h5M9 12h6M9 16h6"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Xml Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/xml-to-json/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 4c-2 1-3 3-3 6s1 5 3 6"/>
        <path d="M16 4c2 1 3 3 3 6s-1 5-3 6"/>
        <path d="M9 8h6M9 12h4M9 16h6"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Xml To Json</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/email-validator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Email Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-validator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m7 5-5 7 5 7M17 5l5 7-5 7M14 3l-4 18"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Html Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ip-validator/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Ip Validator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
  </div>
</section>

<style>
  /* =========================================
     Related Tools
     الوضع الافتراضي = فاتح
     ========================================= */

  .related-tools {
    width: min(1000px, 100%);
    margin: 40px auto 25px;
    padding: 22px;

    border-radius: 18px;

    background: #ffffff !important;
    color: #0f172a !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 8px 24px rgba(15, 23, 42, 0.06) !important;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .related-tools-header {
    margin-bottom: 17px;
  }

  .related-tools-label {
    display: inline-block;

    margin-bottom: 5px;

    color: #0284c7 !important;

    font-size: 0.78rem;
    font-weight: 800;
  }

  .related-tools h2 {
    margin: 0 0 5px;

    color: #0f172a !important;

    font-size: 1.3rem;
    line-height: 1.4;
    font-weight: 800;
  }

  .related-tools p {
    margin: 0;

    color: #64748b !important;

    font-size: 0.85rem;
  }

  /* =========================================
     Cards
     ========================================= */

  .related-tools-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;

    gap: 9px;

    min-height: 58px;

    padding: 9px 10px;

    border-radius: 12px;

    text-decoration: none !important;

    color: #0f172a !important;

    background: #f8fafc !important;

    border: 1px solid #e2e8f0 !important;

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.035) !important;

    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-2px);

    color: #0f172a !important;

    background: #f0f9ff !important;

    border-color: #38bdf8 !important;

    box-shadow:
      0 6px 14px rgba(14, 165, 233, 0.10) !important;
  }

  /* =========================================
     SVG icon
     ========================================= */

  .related-tool-icon {
    display: grid;
    place-items: center;

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    border-radius: 9px;

    color: #0284c7 !important;

    background: rgba(14, 165, 233, 0.10) !important;
  }

  .related-tool-icon svg {
    width: 18px;
    height: 18px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;

    justify-content: center;

    gap: 2px;

    min-width: 0;
    flex: 1;
  }

  .related-tool-content strong {
    display: block;

    color: #0f172a !important;

    font-size: 0.84rem;
    line-height: 1.25;
    font-weight: 750;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    color: #64748b !important;

    font-size: 0.68rem;
    line-height: 1.2;
  }

  .related-tool-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    flex: 0 0 22px;

    color: #94a3b8 !important;

    font-size: 0.85rem;

    transition:
      transform 0.18s ease,
      color 0.18s ease;
  }

  .related-tool-card:hover .related-tool-arrow {
    color: #0284c7 !important;

    transform: translateX(-2px);
  }

  /* =========================================
     الوضع الليلي الحقيقي في المشروع
     يعتمد على class وليس data-theme
     ========================================= */

  html.dark-mode .related-tools,
  body.dark-mode .related-tools,
  html.dark .related-tools,
  body.dark .related-tools {
    background: #111827 !important;
    color: #f8fafc !important;

    border-color: rgba(255, 255, 255, 0.08) !important;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.20) !important;
  }

  html.dark-mode .related-tools h2,
  body.dark-mode .related-tools h2,
  html.dark .related-tools h2,
  body.dark .related-tools h2 {
    color: #f8fafc !important;
  }

  html.dark-mode .related-tools p,
  body.dark-mode .related-tools p,
  html.dark .related-tools p,
  body.dark .related-tools p {
    color: #cbd5e1 !important;
  }

  html.dark-mode .related-tool-card,
  body.dark-mode .related-tool-card,
  html.dark .related-tool-card,
  body.dark .related-tool-card {
    color: #f8fafc !important;

    background: #1e293b !important;

    border-color: rgba(255, 255, 255, 0.08) !important;

    box-shadow: none !important;
  }

  html.dark-mode .related-tool-card:hover,
  body.dark-mode .related-tool-card:hover,
  html.dark .related-tool-card:hover,
  body.dark .related-tool-card:hover {
    color: #ffffff !important;

    background: #263449 !important;

    border-color: #38bdf8 !important;
  }

  html.dark-mode .related-tool-content strong,
  body.dark-mode .related-tool-content strong,
  html.dark .related-tool-content strong,
  body.dark .related-tool-content strong {
    color: #f8fafc !important;
  }

  html.dark-mode .related-tool-content small,
  body.dark-mode .related-tool-content small,
  html.dark .related-tool-content small,
  body.dark .related-tool-content small {
    color: #94a3b8 !important;
  }

  html.dark-mode .related-tool-icon,
  body.dark-mode .related-tool-icon,
  html.dark .related-tool-icon,
  body.dark .related-tool-icon {
    color: #38bdf8 !important;

    background: rgba(56, 189, 248, 0.12) !important;
  }

  html.dark-mode .related-tool-arrow,
  body.dark-mode .related-tool-arrow,
  html.dark .related-tool-arrow,
  body.dark .related-tool-arrow {
    color: #64748b !important;
  }

  /* =========================================
     الوضع النهاري
     نتأكد أنه يتغلب على أي CSS عام
     ========================================= */

  html:not(.dark-mode) .related-tools,
  body:not(.dark-mode) .related-tools,
  html:not(.dark) .related-tools {
    background: #ffffff !important;

    color: #0f172a !important;

    border-color: #e2e8f0 !important;

    box-shadow:
      0 8px 24px rgba(15, 23, 42, 0.06) !important;
  }

  html:not(.dark-mode) .related-tool-card,
  body:not(.dark-mode) .related-tool-card,
  html:not(.dark) .related-tool-card {
