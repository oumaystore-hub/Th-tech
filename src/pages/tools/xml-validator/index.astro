    <script is:inline>
      (() => {
        const input = document.getElementById("xmlInput");

        const validateBtn = document.getElementById("validateBtn");
        const clearBtn = document.getElementById("clearBtn");
        const copyBtn = document.getElementById("copyBtn");
        const exampleBtn = document.getElementById("exampleBtn");

        const lineNumbers = document.getElementById("lineNumbers");

        const inputStats = document.getElementById("inputStats");

        const validationResult =
          document.getElementById("validationResult");

        const validationIcon =
          document.getElementById("validationIcon");

        const validationTitle =
          document.getElementById("validationTitle");

        const validationMessage =
          document.getElementById("validationMessage");

        const detailsBox =
          document.getElementById("detailsBox");

        const detailStatus =
          document.getElementById("detailStatus");

        const detailElements =
          document.getElementById("detailElements");

        const detailDepth =
          document.getElementById("detailDepth");

        const statLines =
          document.getElementById("statLines");

        const statChars =
          document.getElementById("statChars");

        const statElements =
          document.getElementById("statElements");

        const statTime =
          document.getElementById("statTime");

        const exampleXML = `<?xml version="1.0" encoding="UTF-8"?>
<catalog>
  <book id="1">
    <title>Learn JavaScript</title>
    <author>Th.Tech</author>
    <category>Programming</category>
    <price currency="USD">29.99</price>
  </book>
  <book id="2">
    <title>Modern Web Development</title>
    <author>Th.Tech</author>
    <category>Web</category>
    <price currency="USD">39.99</price>
  </book>
</catalog>`;

        function updateLines() {
          const value = input.value || "";

          const count = value
            ? value.split(/\r?\n/).length
            : 1;

          lineNumbers.textContent = Array.from(
            { length: count },
            (_, index) => index + 1
          ).join("\n");

          inputStats.textContent =
            `${value.length.toLocaleString()} حرف`;

          statLines.textContent =
            value ? count.toLocaleString() : "0";

          statChars.textContent =
            value.length.toLocaleString();
        }

        function calculateDepth(documentXML) {
          let maxDepth = 0;

          function walk(element, depth) {
            maxDepth = Math.max(maxDepth, depth);

            Array.from(element.children).forEach((child) => {
              walk(child, depth + 1);
            });
          }

          if (documentXML.documentElement) {
            walk(documentXML.documentElement, 1);
          }

          return maxDepth;
        }

        function showValid(
          elements,
          depth,
          elapsed
        ) {
          validationResult.classList.remove(
            "hidden",
            "invalid"
          );

          validationIcon.className =
            "validation-icon valid";

          validationIcon.innerHTML =
            '<i class="fa-solid fa-check"></i>';

          validationTitle.textContent =
            "XML صالح";

          validationMessage.textContent =
            "تم التحقق من بنية XML بنجاح ولا توجد أخطاء نحوية.";

          detailsBox.classList.remove("hidden");

          detailStatus.textContent =
            "Valid";

          detailStatus.className =
            "valid-text";

          detailElements.textContent =
            elements.toLocaleString();

          detailDepth.textContent =
            depth.toLocaleString();

          statElements.textContent =
            elements.toLocaleString();

          statTime.textContent =
            `${elapsed.toFixed(1)} ms`;
        }

        function showInvalid(message, elapsed) {
          validationResult.classList.remove(
            "hidden"
          );

          validationResult.classList.add(
            "invalid"
          );

          validationIcon.className =
            "validation-icon invalid-icon";

          validationIcon.innerHTML =
            '<i class="fa-solid fa-xmark"></i>';

          validationTitle.textContent =
            "XML غير صالح";

          validationMessage.textContent =
            message ||
            "تعذر التحقق من بنية XML. تأكد من إغلاق العناصر بشكل صحيح.";

          detailsBox.classList.remove("hidden");

          detailStatus.textContent =
            "Invalid";

          detailStatus.className =
            "invalid-text";

          detailElements.textContent =
            "—";

          detailDepth.textContent =
            "—";

          statElements.textContent =
            "—";

          statTime.textContent =
            `${elapsed.toFixed(1)} ms`;
        }

        function validateXML() {
          const source = input.value.trim();

          if (!source) {
            validationResult.classList.remove(
              "hidden"
            );

            validationResult.classList.add(
              "invalid"
            );

            validationIcon.className =
              "validation-icon invalid-icon";

            validationIcon.innerHTML =
              '<i class="fa-solid fa-triangle-exclamation"></i>';

            validationTitle.textContent =
              "لا يوجد XML";

            validationMessage.textContent =
              "أدخل كود XML أولاً ثم حاول مرة أخرى.";

            detailsBox.classList.add("hidden");

            statElements.textContent = "0";
            statTime.textContent = "0 ms";

            return;
          }

          const start = performance.now();

          try {
            const parser = new DOMParser();

            const documentXML =
              parser.parseFromString(
                source,
                "application/xml"
              );

            const parserError =
              documentXML.querySelector(
                "parsererror"
              );

            if (
              parserError ||
              !documentXML.documentElement
            ) {
              throw new Error(
                "XML غير صالح"
              );
            }

            const root =
              documentXML.documentElement;

            const elements =
              documentXML.querySelectorAll("*").length;

            const depth =
              calculateDepth(documentXML);

            const elapsed =
              performance.now() - start;

            showValid(
              elements,
              depth,
              elapsed
            );

          } catch (error) {
            const elapsed =
              performance.now() - start;

            showInvalid(
              "تم اكتشاف خطأ في بناء XML. تحقق من العناصر والخصائص والأقواس والإغلاق.",
              elapsed
            );
          }
        }

        function clearAll() {
          input.value = "";

          validationResult.classList.add(
            "hidden"
          );

          validationResult.classList.remove(
            "invalid"
          );

          detailsBox.classList.add(
            "hidden"
          );

          statLines.textContent = "0";
          statChars.textContent = "0";
          statElements.textContent = "0";
          statTime.textContent = "0 ms";

          updateLines();

          input.focus();
        }

        async function copyXML() {
          const value = input.value;

          if (!value.trim()) {
            return;
          }

          try {
            await navigator.clipboard.writeText(
              value
            );

            copyBtn.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(() => {
              copyBtn.innerHTML =
                '<i class="fa-solid fa-copy"></i> نسخ';
            }, 1500);

          } catch {
            input.select();
            document.execCommand("copy");
          }
        }

        exampleBtn.addEventListener(
          "click",
          () => {
            input.value = exampleXML;
            updateLines();
            validateXML();
          }
        );

        validateBtn.addEventListener(
          "click",
          validateXML
        );

        clearBtn.addEventListener(
          "click",
          clearAll
        );

        copyBtn.addEventListener(
          "click",
          copyXML
        );

        input.addEventListener(
          "input",
          updateLines
        );

        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {
              event.preventDefault();

              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;

              input.value =
                input.value.substring(0, start) +
                "  " +
                input.value.substring(end);

              input.selectionStart =
                input.selectionEnd =
                  start + 2;

              updateLines();
            }

            if (
              event.ctrlKey &&
              event.key === "Enter"
            ) {
              event.preventDefault();
              validateXML();
            }
          }
        );

        input.addEventListener(
          "scroll",
          () => {
            lineNumbers.scrollTop =
              input.scrollTop;
          }
        );

        updateLines();
      })();
    </script>

