---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JWT Generator - إنشاء JWT أونلاين مجاناً | Th.Tech";

const description =
  "أداة JWT Generator مجانية لإنشاء JSON Web Token من Header وPayload مباشرة داخل المتصفح.";

---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>JWT Generator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-key"></i>
            <span>JWT</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>JWT Generator</h1>

            <p>
              أنشئ JSON Web Token بسهولة من Header وPayload
              مباشرة داخل المتصفح.
            </p>

            <div class="tags">
              <span>JWT</span>
              <span>JSON</span>
              <span>Base64URL</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="generator-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-key"></i>
              JWT Generator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ JWT
            </button>

            <button id="generateBtn" class="btn btn-primary">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              إنشاء JWT
            </button>

          </div>


          <!-- EDITORS -->
          <div class="editors-grid">

            <!-- HEADER -->
            <div class="editor-card">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-code"></i>
                  Header
                </div>

                <span>PART 1</span>

              </div>

              <textarea
                id="headerInput"
                spellcheck="false"
              >{
  "alg": "HS256",
  "typ": "JWT"
}</textarea>

            </div>


            <!-- PAYLOAD -->
            <div class="editor-card">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-database"></i>
                  Payload
                </div>

                <span>PART 2</span>

              </div>

              <textarea
                id="payloadInput"
                spellcheck="false"
              >{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}</textarea>

            </div>

          </div>


          <!-- SECRET -->
          <div class="secret-section">

            <div class="secret-header">

              <div>
                <i class="fa-solid fa-lock"></i>
                Secret Key
              </div>

              <span>
                للتجربة فقط
              </span>

            </div>

            <input
              id="secretInput"
              type="text"
              value="th-tech-secret"
              autocomplete="off"
              spellcheck="false"
              placeholder="أدخل Secret Key"
            />

            <div class="secret-note">
              <i class="fa-solid fa-circle-info"></i>
              يتم استخدام المفتاح محلياً داخل المتصفح. هذه الأداة
              تنشئ توقيعاً تعليمياً ولا تستبدل نظام المصادقة في الإنتاج.
            </div>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز لإنشاء JWT
              </strong>

              <p id="resultMessage">
                أدخل Header وPayload ثم اضغط على إنشاء JWT.
              </p>

            </div>

          </div>


          <!-- OUTPUT -->
          <div class="output-section">

            <div class="output-header">

              <div>
                <i class="fa-solid fa-terminal"></i>
                Generated JWT
              </div>

              <span id="outputCount">
                0 حرف
              </span>

            </div>

            <textarea
              id="jwtOutput"
              readonly
              spellcheck="false"
              placeholder="سيظهر JWT هنا..."
            ></textarea>

          </div>


          <!-- PARTS -->
          <div class="parts-grid">

            <div class="part">

              <div class="part-title">
                <span class="part-dot part-header"></span>
                Header
              </div>

              <pre id="headerOutput">—</pre>

            </div>


            <div class="part">

              <div class="part-title">
                <span class="part-dot part-payload"></span>
                Payload
              </div>

              <pre id="payloadOutput">—</pre>

            </div>


            <div class="part">

              <div class="part-title">
                <span class="part-dot part-signature"></span>
                Signature
              </div>

              <pre id="signatureOutput">—</pre>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>طول JWT</span>
                <strong id="statLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <span>Algorithm</span>
                <strong id="statAlgorithm">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <div>
                <span>الأجزاء</span>
                <strong id="statParts">0 / 3</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>JWT GENERATOR</span>

          <h2>
            ما هو JWT Generator؟
          </h2>

          <p>
            أداة تساعد المطورين على إنشاء JSON Web Token
            وفهم مكوناته الأساسية.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>Header</h3>

            <p>
              يحتوي عادةً على نوع التوكن والخوارزمية
              المستخدمة في إنشاء التوقيع.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-database"></i>
            </div>

            <h3>Payload</h3>

            <p>
              يحتوي على Claims والمعلومات التي تريد
              تضمينها داخل التوكن.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-fingerprint"></i>
            </div>

            <h3>Signature</h3>

            <p>
              يستخدم للتحقق من سلامة JWT عند استخدام
              الخوارزمية والمفتاح المناسبين.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام JWT Generator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>أدخل Header</h3>

              <p>
                حدد الخوارزمية ونوع JWT.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>أدخل Payload</h3>

              <p>
                أضف البيانات وClaims التي تحتاج إليها.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>أنشئ JWT</h3>

              <p>
                اضغط على إنشاء JWT لعرض التوكن الناتج.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          <details>
            <summary>
              <span>ما هو JWT؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              JWT أو JSON Web Token هو تنسيق شائع لنقل المعلومات
              بين الأطراف ويتكون عادةً من Header وPayload وSignature.
            </p>
          </details>


          <details>
            <summary>
              <span>هل يتم إرسال البيانات إلى الخادم؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              لا. تتم عملية إنشاء JWT داخل المتصفح باستخدام JavaScript.
            </p>
          </details>


          <details>
            <summary>
              <span>هل يمكن استخدام الأداة مع HS256؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم. هذه النسخة تدعم إنشاء توقيع HMAC باستخدام HS256
              عندما يكون Web Crypto API متاحاً في المتصفح.
            </p>
          </details>


          <details>
            <summary>
              <span>هل Secret Key مهم؟</span>
              <i class="fa-solid fa-chevron-down"></i>
            </summary>

            <p>
              نعم. في JWT الموقع باستخدام HS256 يجب حماية المفتاح السري
              وعدم وضع المفاتيح الحقيقية الخاصة بالإنتاج داخل أدوات عامة.
            </p>
          </details>

        </div>

      </div>
    </section>

  </main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const headerInput = document.getElementById("headerInput");
      const payloadInput = document.getElementById("payloadInput");
      const secretInput = document.getElementById("secretInput");

      const jwtOutput = document.getElementById("jwtOutput");

      const headerOutput = document.getElementById("headerOutput");
      const payloadOutput = document.getElementById("payloadOutput");
      const signatureOutput = document.getElementById("signatureOutput");

      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");
      const generateBtn = document.getElementById("generateBtn");

      const resultBox = document.getElementById("resultBox");
      const resultIcon = document.getElementById("resultIcon");
      const resultTitle = document.getElementById("resultTitle");
      const resultMessage = document.getElementById("resultMessage");

      const outputCount = document.getElementById("outputCount");

      const statLength = document.getElementById("statLength");
      const statAlgorithm = document.getElementById("statAlgorithm");
      const statParts = document.getElementById("statParts");
      const statStatus = document.getElementById("statStatus");


      function base64UrlEncode(text) {

        const bytes = new TextEncoder().encode(text);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }

        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      function arrayBufferToBase64Url(buffer) {

        const bytes = new Uint8Array(buffer);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }

        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      async function createSignature(data, secret) {

        if (!window.crypto || !window.crypto.subtle) {
          throw new Error("Web Crypto API غير متاحة.");
        }

        const encoder = new TextEncoder();

        const keyData = encoder.encode(secret);

        const key = await crypto.subtle.importKey(
          "raw",
          keyData,
          {
            name: "HMAC",
            hash: "SHA-256"
          },
          false,
          ["sign"]
        );

        const signature = await crypto.subtle.sign(
          "HMAC",
          key,
          encoder.encode(data)
        );

        return arrayBufferToBase64Url(signature);
      }


      function showSuccess(message) {

        resultBox.classList.remove("error");

        resultBox.classList.add("success");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم إنشاء JWT بنجاح";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "تم الإنشاء";
      }


      function showError(message) {

        resultBox.classList.remove("success");

        resultBox.classList.add("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر إنشاء JWT";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";
      }


      function showReady() {

        resultBox.classList.remove("success");
        resultBox.classList.remove("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز لإنشاء JWT";

        resultMessage.textContent =
          "أدخل Header وPayload ثم اضغط على إنشاء JWT.";

        statStatus.textContent =
          "جاهز";
      }


      function resetOutput() {

        jwtOutput.value = "";

        headerOutput.textContent = "—";
        payloadOutput.textContent = "—";
        signatureOutput.textContent = "—";

        outputCount.textContent = "0 حرف";

        statLength.textContent = "0";
        statAlgorithm.textContent = "—";
        statParts.textContent = "0 / 3";
      }


      async function generateJWT() {

        const headerText =
          headerInput.value.trim();

        const payloadText =
          payloadInput.value.trim();

        const secret =
          secretInput.value;

        if (!headerText) {

          showError("أدخل Header أولاً.");

          headerInput.focus();

          return;
        }


        if (!payloadText) {

          showError("أدخل Payload أولاً.");

          payloadInput.focus();

          return;
        }


        if (!secret) {

          showError("أدخل Secret Key أولاً.");

          secretInput.focus();

          return;
        }


        let header;
        let payload;


        try {

          header = JSON.parse(headerText);

        } catch {

          showError(
            "Header غير صالح. تأكد من صحة JSON."
          );

          headerInput.focus();

          return;
        }


        try {

          payload = JSON.parse(payloadText);

        } catch {

          showError(
            "Payload غير صالح. تأكد من صحة JSON."
          );

          payloadInput.focus();

          return;
        }


        if (
          typeof header !== "object" ||
          header === null ||
          Array.isArray(header)
        ) {

          showError(
            "Header يجب أن يكون JSON Object."
          );

          return;
        }


        if (
          typeof payload !== "object" ||
          payload === null ||
          Array.isArray(payload)
        ) {

          showError(
            "Payload يجب أن يكون JSON Object."
          );

          return;
        }


        const algorithm =
          String(header.alg || "HS256").toUpperCase();


        if (algorithm !== "HS256") {

          showError(
            "هذه النسخة تستخدم HS256 لإنشاء التوقيع."
          );

          return;
        }


        try {

          const cleanHeader =
            JSON.stringify(header);

          const cleanPayload =
            JSON.stringify(payload);


          const encodedHeader =
            base64UrlEncode(cleanHeader);

          const encodedPayload =
            base64UrlEncode(cleanPayload);


          const signingInput =
            encodedHeader + "." + encodedPayload;


          const signature =
            await createSignature(
              signingInput,
              secret
            );


          const token =
            signingInput + "." + signature;


          jwtOutput.value =
            token;


          headerOutput.textContent =
            JSON.stringify(
              header,
              null,
              2
            );


          payloadOutput.textContent =
            JSON.stringify(
              payload,
              null,
              2
            );


          signatureOutput.textContent =
            signature;


          outputCount.textContent =
            token.length.toLocaleString() + " حرف";


          statLength.textContent =
            token.length.toLocaleString();


          statAlgorithm.textContent =
            algorithm;


          statParts.textContent =
            "3 / 3";


          showSuccess(
            "تم إنشاء Header وPayload والتوقيع محلياً داخل المتصفح."
          );

        } catch (error) {

          showError(
            "حدث خطأ أثناء إنشاء التوقيع. حاول مرة أخرى."
          );

        }

      }


      function loadExample() {

        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;


        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer",
  "iat": 1720000000
}`;


        secretInput.value =
          "th-tech-secret";


        generateJWT();
      }


      function clearAll() {

        headerInput.value = "";
        payloadInput.value = "";
        secretInput.value = "";

        resetOutput();

        showReady();

        headerInput.focus();
      }


      async function copyJWT() {

        const value =
          jwtOutput.value.trim();


        if (!value) {

          showError(
            "لا يوجد JWT لنسخه. أنشئ JWT أولاً."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(value);

          const oldText =
            copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              oldText;

          }, 1500);

        } catch {

          jwtOutput.focus();

          jwtOutput.select();

          document.execCommand("copy");

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ JWT';

          }, 1500);
        }

      }


      generateBtn.addEventListener(
        "click",
        generateJWT
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyJWT
      );


      [headerInput, payloadInput, secretInput].forEach(
        (element) => {

          element.addEventListener(
            "keydown",
            (event) => {

              if (
                event.ctrlKey &&
                event.key === "Enter"
              ) {

                event.preventDefault();

                generateJWT();
              }


              if (
                event.key === "Tab" &&
                element.tagName === "TEXTAREA"
              ) {

                event.preventDefault();

                const start =
                  element.selectionStart;

                const end =
                  element.selectionEnd;


                element.value =
                  element.value.substring(0, start) +
                  "  " +
                  element.value.substring(end);


                element.selectionStart =
                  element.selectionEnd =
                    start + 2;
              }

            }
          );

        }
      );


      resetOutput();

    })();
  </script>


  <style>

    :root {

      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f8fafc;

      --text: #172033;
      --muted: #718096;

      --border: rgba(15, 23, 42, 0.09);

      --primary: #7c3aed;
      --primary-dark: #6d28d9;
      --secondary: #a855f7;

      --success: #16a34a;
      --danger: #dc2626;

      --shadow:
        0 25px 70px rgba(15, 23, 42, 0.10);
    }


    html.dark-mode {

      --bg: #08070d;
      --surface: #100d18;
      --surface-2: #161221;

      --text: #f8fafc;
      --muted: #94a3b8;

      --border:
        rgba(148, 163, 184, 0.13);

      --primary: #a78bfa;
      --primary-dark: #8b5cf6;
      --secondary: #c4b5fd;

      --shadow:
        0 30px 80px rgba(0, 0, 0, 0.45);
    }


    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      background: var(--bg);

      color: var(--text);

      font-family:
        "Cairo",
        sans-serif;
    }


    .container {

      width:
        min(
          1180px,
          calc(100% - 32px)
        );

      margin: auto;
    }


    /* HERO */

    .hero {

      padding:
        38px 0 55px;

      background:
        radial-gradient(
          circle at 10% 20%,
          rgba(124, 58, 237, 0.13),
          transparent 35%
        ),
        var(--bg);
    }


    .breadcrumb {

      display:
        flex;

      align-items:
        center;

      gap: 10px;

      flex-wrap:
        wrap;

      color:
        var(--muted);

      font-size:
        13px;

      margin-bottom:
        38px;
    }


    .breadcrumb a {

      color:
        var(--muted);

      text-decoration:
        none;
    }


    .breadcrumb i {

      font-size:
        9px;
    }


    .hero-content {

      display:
        flex;

      align-items:
        center;

      gap:
        28px;
    }


    .hero-icon {

      width:
        112px;

      height:
        112px;

      flex:
        0 0 112px;

      border-radius:
        30px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      flex-direction:
        column;

      gap:
        4px;

      background:
        rgba(124, 58, 237, 0.12);

      color:
        var(--primary);
    }


    .hero-icon i {

      font-size:
        40px;
    }


    .hero-icon span {

      font:
        700 13px
        "JetBrains Mono",
        monospace;
    }


    .badge {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        7px 13px;

      border-radius:
        999px;

      background:
        rgba(124, 58, 237, 0.10);

      color:
        var(--primary);

      font-size:
        12px;

      font-weight:
        700;
    }


    h1 {

      margin:
        12px 0 8px;

      font-size:
        clamp(32px, 5vw, 52px);

      line-height:
        1.1;
    }


    .hero-text p {

      margin:
        0;

      max-width:
        700px;

      color:
        var(--muted);

      font-size:
        16px;

      line-height:
        1.9;
    }


    .tags {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        8px;

      margin-top:
        17px;
    }


    .tags span {

      padding:
        5px 10px;

      border:
        1px solid var(--border);

      border-radius:
        8px;

      color:
        var(--muted);

      background:
        var(--surface);

      font:
        500 11px
        "JetBrains Mono",
        monospace;
    }


    /* TOOL */

    .tool-section {

      padding-bottom:
        70px;
    }


    .generator-card {

      overflow:
        hidden;

      background:
        var(--surface);

      border:
        1px solid var(--border);

      border-radius:
        22px;

      box-shadow:
        var(--shadow);
    }


    .card-topbar {

      min-height:
        55px;

      padding:
        0 20px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      border-bottom:
        1px solid var(--border);

      background:
        var(--surface-2);
    }


    .window-dots {

      display:
        flex;

      gap:
        6px;
    }


    .window-dots span {

      width:
        9px;

      height:
        9px;

      border-radius:
        50%;

      background:
        var(--border);
    }


    .tool-name {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      font:
        600 13px
        "JetBrains Mono",
        monospace;
    }


    .tool-name i {

      color:
        var(--primary);
    }


    .secure {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      color:
        var(--success);

      font-size:
        11px;

      font-weight:
        700;
    }


    /* ACTIONBAR */

    .actionbar {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        9px;

      padding:
        15px 18px;

      border-bottom:
        1px solid var(--border);
    }


    .btn {

      border:
        1px solid var(--border);

      border-radius:
        10px;

      padding:
        10px 15px;

      font-family:
        "Cairo",
        sans-serif;

      font-size:
        12px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        0.2s;
    }


    .btn:hover {

      transform:
        translateY(-1px);
    }


    .btn i {

      margin-left:
        6px;
    }


    .btn-secondary {

      color:
        var(--text);

      background:
        var(--surface-2);
    }


    .btn-primary {

      color:
        white;

      background:
        var(--primary);

      border-color:
        var(--primary);
    }


    .btn-primary:hover {

      background:
        var(--primary-dark);
    }


    /* EDITORS */

    .editors-grid {

      display:
        grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap:
        15px;

      margin:
        20px;
    }


    .editor-card {

      overflow:
        hidden;

      border:
        1px solid var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .editor-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        12px 15px;

      border-bottom:
        1px solid var(--border);

      font:
        600 12px
        "JetBrains Mono",
        monospace;
    }


    .editor-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;
    }


    .editor-header i {

      color:
        var(--primary);
    }


    .editor-header span {

      color:
        var(--muted);

      font-size:
        9px;
    }


    .editor-card textarea {

      width:
        100%;

      min-height:
        230px;

      display:
        block;

      resize:
        vertical;

      border:
        0;

      outline:
        0;

      padding:
        17px;

      background:
        transparent;

      color:
        var(--text);

      direction:
        ltr;

      text-align:
        left;

      font:
        12px/1.8
        "JetBrains Mono",
        monospace;
    }


    /* SECRET */

    .secret-section {

      margin:
        0 20px 15px;

      padding:
        17px;

      border:
        1px solid var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .secret-header {

      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      margin-bottom:
        10px;

      font:
        600 12px
        "JetBrains Mono",
        monospace;
    }


    .secret-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;
    }


    .secret-header i {

      color:
        var(--primary);
    }


    .secret-header span {

      color:
        var(--muted);

      font-size:
        10px;
    }


    #secretInput {

      width:
        100%;

      padding:
        13px 15px;

      border:
        1px solid var(--border);

      border-radius:
        10px;

      outline:
        0;

      background:
        var(--surface);

      color:
        var(--text);

      direction:
        ltr;

      text-align:
        left;

      font:
        12px
        "JetBrains Mono",
        monospace;
    }


    #secretInput:focus {

      border-color:
        var(--primary);
    }


    .secret-note {

      margin-top:
        10px;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.8;
    }


    .secret-note i {

      color:
        var(--primary);

      margin-left:
        5px;
    }


    /* RESULT */

    .result-box {

      margin:
        0 20px 15px;

      display:
        flex;

      align-items:
        center;

      gap:
        14px;

      padding:
        15px 17px;

      border:
        1px solid var(--border);

      border-radius:
        14px;

      background:
        var(--surface-2);
    }


    .result-icon {

      width:
        42px;

      height:
        42px;

      flex:
        0 0 42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      background:
        rgba(124, 58, 237, 0.10);

      color:
        var(--primary);
    }


    .result-box strong {

      display:
        block;

      font-size:
        13px;
    }


    .result-box p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.7;
    }


    .result-box.success {

      border-color:
        rgba(22, 163, 74, 0.25);
    }


    .result-box.success .result-icon {

      color:
        var(--success);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .result-box.error {

      border-color:
        rgba(220, 38, 38, 0.25);
    }


    .result-box.error .result-icon {

      color:
        var(--danger);

      background:
        rgba(220, 38, 38, 0.10);
    }


    /* OUTPUT */

    .output-section {

      margin:
        0 20px 15px;

      overflow:
        hidden;

      border:
        1px solid var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .output-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        12px 15px;

      border-bottom:
        1px solid var(--border);

      font:
        600 12px
        "JetBrains Mono",
        monospace;
    }


    .output-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;
    }


    .output-header i {

      color:
        var(--primary);
    }


    .output-header span {

      color:
        var(--muted);

      font-size:
        9px;
    }


    #jwtOutput {

      width:
        100%;

      min-height:
        125px;

      display:
        block;

      resize:
        vertical;

      padding:
        17px;

      border:
        0;

      outline:
        0;

      background:
        transparent;

      color:
        var(--primary);

      direction:
        ltr;

      text-align:
        left;

      font:
        12px/1.9
        "JetBrains Mono",
        monospace;
    }


    /* PARTS */

    .parts-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        15px;

      margin:
        0 20px 15px;
    }


    .part {

      overflow:
        hidden;

      border:
        1px solid var(--border);

      border-radius:
        15px;

      background:
        var(--surface-2);
    }


    .part-title {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        12px 15px;

      border-bottom:
        1px solid var(--border);

      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    .part-dot {

      width:
        9px;

      height:
        9px;

      border-radius:
        50%;
    }


    .part-header {

      background:
        var(--primary);
    }


    .part-payload {

      background:
        #0891b2;
    }


    .part-signature {

      background:
        #16a34a;
    }


    .part pre {

      min-height:
        130px;

      max-height:
        250px;

      overflow:
        auto;

      margin:
        0;

      padding:
        15px;

      white-space:
        pre-wrap;

      word-break:
        break-word;

      color:
        var(--text);

      direction:
        ltr;

      text-align:
        left;

      font:
        11px/1.8
        "JetBrains Mono",
        monospace;
    }


    /* STATS */

    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        12px;

      padding:
        0 20px 20px;
    }


    .stat {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      min-width:
        0;

      padding:
        14px;

      border:
        1px solid var(--border);

      border-radius:
        13px;

      background:
        var(--surface-2);
    }


    .stat-icon {

      width:
        36px;

      height:
        36px;

      flex:
        0 0 36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        9px;

      color:
        var(--primary);

      background:
        rgba(124, 58, 237, 0.10);
    }


    .stat span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        9px;
    }


    .stat strong {

      display:
        block;

      max-width:
        150px;

      overflow:
        hidden;

      margin-top:
        2px;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    /* SECTIONS */

    .info-section,
    .how-section,
    .faq-section {

      padding:
        70px 0;
    }


    .info-section {

      background:
        var(--surface-2);

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);
    }


    .section-heading {

      max-width:
        700px;

      margin:
        0 auto 35px;

      text-align:
        center;
    }


    .section-heading > span {

      color:
        var(--primary);

      font:
        700 11px
        "JetBrains Mono",
        monospace;

      letter-spacing:
        1px;
    }


    .section-heading h2 {

      margin:
        8px 0;

      font-size:
        clamp(25px, 4vw, 34px);
    }


    .section-heading p {

      margin:
        0;

      color:
        var(--muted);

      line-height:
        1.9;

      font-size:
        14px;
    }


    .info-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .info-card {

      padding:
        25px;

      border:
        1px solid var(--border);

      border-radius:
        17px;

      background:
        var(--surface);
    }


    .info-icon {

      width:
        48px;

      height:
        48px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        17px;

      border-radius:
        13px;

      color:
        var(--primary);

      background:
        rgba(124, 58, 237, 0.10);
    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size:
        16px;
    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        13px;

      line-height:
        1.9;
    }


    /* STEPS */

    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .step {

      display:
        flex;

      gap:
        15px;

      padding:
        22px;

      border:
        1px solid var(--border);

      border-radius:
        16px;

      background:
        var(--surface);
    }


    .step-number {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      color:
        white;

      background:
        var(--primary);

      font-weight:
        800;
    }


    .step h3 {

      margin:
        0 0 5px;

      font-size:
        14px;
    }


    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.8;
    }


    /* FAQ */

    .faq-list {

      max-width:
        850px;

      margin:
        auto;
    }


    details {

      margin-bottom:
        10px;

      border:
        1px solid var(--border);

      border-radius:
        13px;

      background:
        var(--surface);

      overflow:
        hidden;
    }


    summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        17px 19px;

      cursor:
        pointer;

      font-size:
        13px;

      font-weight:
        700;

      list-style:
        none;
    }


    summary::-webkit-details-marker {
      display:
        none;
    }


    summary i {

      color:
        var(--primary);

      transition:
        transform 0.2s;
    }


    details[open] summary i {

      transform:
        rotate(180deg);
    }


    details p {

      margin:
        0;

      padding:
        0 19px 18px;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 900px) {

      .editors-grid {

        grid-template-columns:
          1fr;
      }


      .parts-grid {

        grid-template-columns:
          1fr;
      }


      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }

    }


    @media (max-width: 600px) {

      .container {

        width:
          calc(100% - 22px);
      }


      .hero {

        padding:
          25px 0 40px;
      }


      .hero-content {

        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .hero-icon {

        width:
          88px;

        height:
          88px;

        flex-basis:
          88px;

        border-radius:
          23px;
      }


      .hero-icon i {

        font-size:
          31px;
      }


      .card-topbar {

        padding:
          0 13px;
      }


      .actionbar {

        padding:
          12px;
      }


      .btn {

        flex:
          1 1
          calc(50% - 8px);

        padding:
          9px 8px;
      }


      .editors-grid {

        margin:
          12px;
      }


      .editor-card textarea {

        min-height:
          190px;

        padding:
          14px;

        font-size:
          10px;
      }


      .secret-section {

        margin:
          0 12px 12px;

        padding:
          13px;
      }


      .result-box {

        margin:
          0 12px 12px;
      }


      .output-section {

        margin:
          0 12px 12px;
      }


      #jwtOutput {

        min-height:
          115px;

        padding:
          14px;

        font-size:
          10px;
      }


      .parts-grid {

        margin:
          0 12px 12px;
      }


      .part pre {

        min-height:
          115px;

        padding:
          13px;

        font-size:
          10px;
      }


      .stats-grid {

        padding:
          0 12px 12px;

        gap:
          8px;
      }


      .stat {

        padding:
          11px 9px;
      }


      .stat-icon {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;
      }


      .stat span {

        font-size:
          8px;
      }


      .stat strong {

        max-width:
          100px;

        font-size:
          9px;
      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;
      }

    }

  </style>

</body>
</html>
