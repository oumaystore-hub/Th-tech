---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JWT Generator - إنشاء JWT أونلاين مجاناً | Th.Tech";

const description =
  "أداة JWT Generator مجانية لإنشاء JSON Web Token واختبار Header وPayload وSecret مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JWT Generator؟",
    a: "هو أداة تساعد المطورين على إنشاء JSON Web Token باستخدام Header وPayload وSecret Key."
  },
  {
    q: "هل يتم إرسال Secret Key إلى الخادم؟",
    a: "لا. عملية إنشاء JWT تتم محلياً داخل المتصفح باستخدام Web Crypto API."
  },
  {
    q: "هل يمكن استخدام JWT Generator في المشاريع الحقيقية؟",
    a: "يمكن استخدام الأداة للاختبار والتطوير. في الأنظمة الحقيقية يجب حماية Secret Key وعدم وضعه في الواجهة الأمامية."
  },
  {
    q: "ما هي الخوارزمية المستخدمة؟",
    a: "هذه النسخة تستخدم HS256، وهي خوارزمية HMAC مع SHA-256."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>JWT Generator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-key"></i>
            <span>JWT</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>JWT Generator</h1>

            <p>
              أنشئ JSON Web Token بسرعة باستخدام Header وPayload
              وSecret Key مباشرة من المتصفح.
            </p>

            <div class="tags">
              <span>JWT</span>
              <span>HS256</span>
              <span>HMAC</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <section class="tool-section">
      <div class="container">

        <div class="generator-card">

          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-key"></i>
              JWT Generator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ JWT
            </button>

            <button id="generateBtn" class="btn btn-primary">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              إنشاء JWT
            </button>

          </div>


          <div class="workspace">

            <div class="editor-panel">

              <div class="editor-title">
                <div>
                  <i class="fa-solid fa-code"></i>
                  Header
                </div>

                <span>PART 1</span>
              </div>

              <div class="code-box">
                <textarea
                  id="headerInput"
                  spellcheck="false"
                >{
  "alg": "HS256",
  "typ": "JWT"
}</textarea>
              </div>

            </div>


            <div class="editor-panel">

              <div class="editor-title">
                <div>
                  <i class="fa-solid fa-database"></i>
                  Payload
                </div>

                <span>PART 2</span>
              </div>

              <div class="code-box">
                <textarea
                  id="payloadInput"
                  spellcheck="false"
                >{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}</textarea>
              </div>

            </div>


            <div class="secret-panel">

              <div class="editor-title">
                <div>
                  <i class="fa-solid fa-lock"></i>
                  Secret Key
                </div>

                <span>HS256</span>
              </div>

              <input
                id="secretInput"
                type="text"
                value="th-tech-secret-key"
                spellcheck="false"
                autocomplete="off"
              />

              <p class="secret-note">
                <i class="fa-solid fa-circle-info"></i>
                استخدم مفتاحاً قوياً وسرياً في المشاريع الحقيقية.
              </p>

            </div>


            <div class="result-box" id="resultBox">

              <div class="result-icon" id="resultIcon">
                <i class="fa-solid fa-circle-question"></i>
              </div>

              <div class="result-content">

                <strong id="resultTitle">
                  جاهز لإنشاء JWT
                </strong>

                <p id="resultMessage">
                  أدخل البيانات ثم اضغط على إنشاء JWT.
                </p>

              </div>

            </div>


            <div class="output-panel">

              <div class="output-header">

                <div>
                  <i class="fa-solid fa-token"></i>
                  Generated JWT
                </div>

                <span id="outputCount">0 حرف</span>

              </div>

              <textarea
                id="jwtOutput"
                readonly
                spellcheck="false"
                placeholder="سيظهر JWT هنا..."
              ></textarea>

            </div>


            <div class="parts-preview">

              <div class="preview-card">

                <div class="preview-title">
                  <i class="fa-solid fa-code"></i>
                  Header
                </div>

                <pre id="headerOutput">—</pre>

              </div>


              <div class="preview-card">

                <div class="preview-title">
                  <i class="fa-solid fa-database"></i>
                  Payload
                </div>

                <pre id="payloadOutput">—</pre>

              </div>


              <div class="preview-card">

                <div class="preview-title">
                  <i class="fa-solid fa-fingerprint"></i>
                  Signature
                </div>

                <pre id="signatureOutput">—</pre>

              </div>

            </div>


            <div class="stats-grid">

              <div class="stat">

                <div class="stat-icon">
                  <i class="fa-solid fa-text-width"></i>
                </div>

                <div>
                  <span>طول JWT</span>
                  <strong id="statLength">0</strong>
                </div>

              </div>


              <div class="stat">

                <div class="stat-icon">
                  <i class="fa-solid fa-layer-group"></i>
                </div>

                <div>
                  <span>الأجزاء</span>
                  <strong id="statParts">0 / 3</strong>
                </div>

              </div>


              <div class="stat">

                <div class="stat-icon">
                  <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                  <span>Algorithm</span>
                  <strong id="statAlgorithm">HS256</strong>
                </div>

              </div>


              <div class="stat">

                <div class="stat-icon">
                  <i class="fa-solid fa-bolt"></i>
                </div>

                <div>
                  <span>الحالة</span>
                  <strong id="statStatus">جاهز</strong>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>JWT GENERATOR</span>

          <h2>
            إنشاء JWT بطريقة سهلة
          </h2>

          <p>
            قم بتحديد Header وPayload وSecret Key،
            ثم أنشئ التوكن مباشرة داخل المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>Header</h3>

            <p>
              يحدد نوع التوكن والخوارزمية المستخدمة
              لإنشاء التوقيع.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-database"></i>
            </div>

            <h3>Payload</h3>

            <p>
              يحتوي على Claims والبيانات التي تريد
              تضمينها داخل JWT.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-key"></i>
            </div>

            <h3>Secret Key</h3>

            <p>
              يستخدم مع HS256 لإنشاء Signature
              الخاصة بالتوكن.
            </p>

          </article>

        </div>

      </div>
    </section>


    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام JWT Generator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل Header
              </h3>

              <p>
                حدد الخوارزمية ونوع JWT.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                أضف Payload
              </h3>

              <p>
                أدخل Claims والبيانات المطلوبة.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                أنشئ JWT
              </h3>

              <p>
                اضغط على إنشاء JWT للحصول على التوكن.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>
                <span>{faq.q}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>{faq.a}</p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>


  <Footer />


  <script is:inline>
    (() => {

      const headerInput = document.getElementById("headerInput");
      const payloadInput = document.getElementById("payloadInput");
      const secretInput = document.getElementById("secretInput");

      const jwtOutput = document.getElementById("jwtOutput");

      const headerOutput = document.getElementById("headerOutput");
      const payloadOutput = document.getElementById("payloadOutput");
      const signatureOutput = document.getElementById("signatureOutput");

      const generateBtn = document.getElementById("generateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const resultBox = document.getElementById("resultBox");
      const resultIcon = document.getElementById("resultIcon");
      const resultTitle = document.getElementById("resultTitle");
      const resultMessage = document.getElementById("resultMessage");

      const outputCount = document.getElementById("outputCount");

      const statLength = document.getElementById("statLength");
      const statParts = document.getElementById("statParts");
      const statAlgorithm = document.getElementById("statAlgorithm");
      const statStatus = document.getElementById("statStatus");


      function setReady() {

        resultBox.classList.remove("success");
        resultBox.classList.remove("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز لإنشاء JWT";

        resultMessage.textContent =
          "أدخل البيانات ثم اضغط على إنشاء JWT.";

        statStatus.textContent =
          "جاهز";
      }


      function setSuccess(message) {

        resultBox.classList.remove("error");
        resultBox.classList.add("success");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم إنشاء JWT بنجاح";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "تم الإنشاء";
      }


      function setError(message) {

        resultBox.classList.remove("success");
        resultBox.classList.add("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر إنشاء JWT";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";
      }


      function base64UrlEncode(text) {

        const bytes =
          new TextEncoder().encode(text);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }

        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      function arrayBufferToBase64Url(buffer) {

        const bytes =
          new Uint8Array(buffer);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }

        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      async function createSignature(data, secret) {

        const algorithm =
          JSON.parse('{"name":"HMAC","hash":"SHA-256"}');

        const keyData =
          new TextEncoder().encode(secret);

        const dataBytes =
          new TextEncoder().encode(data);

        const key =
          await crypto.subtle.importKey(
            "raw",
            keyData,
            algorithm,
            false,
            ["sign"]
          );

        const signature =
          await crypto.subtle.sign(
            algorithm.name,
            key,
            dataBytes
          );

        return arrayBufferToBase64Url(signature);
      }


      function readJSON(text, name) {

        const value =
          text.trim();

        if (!value) {
          throw new Error(name + " فارغ.");
        }

        let parsed;

        try {
          parsed = JSON.parse(value);
        } catch {
          throw new Error(name + " يحتوي على JSON غير صالح.");
        }

        if (
          parsed === null ||
          typeof parsed !== "object" ||
          Array.isArray(parsed)
        ) {
          throw new Error(name + " يجب أن يكون JSON Object.");
        }

        return parsed;
      }


      async function generateJWT() {

        const started =
          performance.now();

        try {

          const header =
            readJSON(
              headerInput.value,
              "Header"
            );

          const payload =
            readJSON(
              payloadInput.value,
              "Payload"
            );

          const secret =
            secretInput.value;

          if (!secret.trim()) {
            throw new Error(
              "أدخل Secret Key أولاً."
            );
          }


          const algorithm =
            header.alg;

          if (algorithm !== "HS256") {
            throw new Error(
              "هذه النسخة تدعم HS256 فقط."
            );
          }


          const headerJSON =
            JSON.stringify(header);

          const payloadJSON =
            JSON.stringify(payload);


          const encodedHeader =
            base64UrlEncode(headerJSON);

          const encodedPayload =
            base64UrlEncode(payloadJSON);


          const unsignedToken =
            encodedHeader +
            "." +
            encodedPayload;


          const signature =
            await createSignature(
              unsignedToken,
              secret
            );


          const token =
            unsignedToken +
            "." +
            signature;


          jwtOutput.value =
            token;


          headerOutput.textContent =
            JSON.stringify(
              header,
              null,
              2
            );


          payloadOutput.textContent =
            JSON.stringify(
              payload,
              null,
              2
            );


          signatureOutput.textContent =
            signature;


          const length =
            token.length;


          outputCount.textContent =
            length.toLocaleString() +
            " حرف";


          statLength.textContent =
            length.toLocaleString();


          statParts.textContent =
            "3 / 3";


          statAlgorithm.textContent =
            algorithm;


          const elapsed =
            (performance.now() - started).toFixed(1);


          setSuccess(
            "تم إنشاء JWT محلياً خلال " +
            elapsed +
            " ms."
          );

        } catch (error) {

          jwtOutput.value = "";

          headerOutput.textContent = "—";
          payloadOutput.textContent = "—";
          signatureOutput.textContent = "—";

          statLength.textContent = "0";
          statParts.textContent = "0 / 3";

          if (error && error.message) {
            setError(error.message);
          } else {
            setError("حدث خطأ أثناء إنشاء JWT.");
          }
        }
      }


      function loadExample() {

        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;

        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}`;

        secretInput.value =
          "th-tech-secret-key";

        generateJWT();
      }


      function clearAll() {

        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;

        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}`;

        secretInput.value = "";

        jwtOutput.value = "";

        headerOutput.textContent = "—";
        payloadOutput.textContent = "—";
        signatureOutput.textContent = "—";

        outputCount.textContent =
          "0 حرف";

        statLength.textContent =
          "0";

        statParts.textContent =
          "0 / 3";

        statAlgorithm.textContent =
          "HS256";

        setReady();

        secretInput.focus();
      }


      async function copyJWT() {

        const value =
          jwtOutput.value.trim();

        if (!value) {
          setError("لا يوجد JWT لنسخه.");
          return;
        }

        try {

          await navigator.clipboard.writeText(value);

          const original =
            copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = original;
          }, 1500);

        } catch {

          jwtOutput.focus();
          jwtOutput.select();

          try {
            document.execCommand("copy");
          } catch {}

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ JWT';
          }, 1500);
        }
      }


      function tabSupport(event) {

        if (event.key !== "Tab") {
          return;
        }

        event.preventDefault();

        const textarea =
          event.target;

        const start =
          textarea.selectionStart;

        const end =
          textarea.selectionEnd;

        textarea.value =
          textarea.value.substring(0, start) +
          "  " +
          textarea.value.substring(end);

        textarea.selectionStart =
          start + 2;

        textarea.selectionEnd =
          start + 2;
      }


      generateBtn.addEventListener(
        "click",
        generateJWT
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyJWT
      );


      headerInput.addEventListener(
        "keydown",
        tabSupport
      );


      payloadInput.addEventListener(
        "keydown",
        tabSupport
      );


      headerInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {
            event.preventDefault();
            generateJWT();
          }

        }
      );


      payloadInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {
            event.preventDefault();
            generateJWT();
          }

        }
      );


      secretInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Enter"
          ) {
            event.preventDefault();
            generateJWT();
          }

        }
      );


      setReady();

    })();
  </script>


  <style>

    :root {
      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f8fafc;
      --text: #172033;
      --muted: #718096;
      --border: rgba(15, 23, 42, 0.09);
      --primary: #7c3aed;
      --primary-dark: #6d28d9;
      --secondary: #a855f7;
      --success: #16a34a;
      --danger: #dc2626;
      --shadow: 0 25px 70px rgba(15, 23, 42, 0.10);
    }


    html.dark-mode {
      --bg: #08070d;
      --surface: #100d18;
      --surface-2: #161221;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.13);
      --primary: #a78bfa;
      --primary-dark: #8b5cf6;
      --secondary: #c4b5fd;
      --shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    }


    * {
      box-sizing: border-box;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
    }


    .container {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
    }


    .hero {
      padding: 38px 0 55px;
      background:
        radial-gradient(
          circle at 10% 20%,
          rgba(124, 58, 237, 0.13),
          transparent 35%
        ),
        var(--bg);
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 38px;
    }


    .breadcrumb a {
      color: var(--muted);
      text-decoration: none;
    }


    .breadcrumb i {
      font-size: 9px;
    }


    .hero-content {
      display: flex;
      align-items: center;
      gap: 28px;
    }


    .hero-icon {
      width: 112px;
      height: 112px;
      flex: 0 0 112px;
      border-radius: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 4px;
      background: rgba(124, 58, 237, 0.12);
      color: var(--primary);
      box-shadow:
        inset 0 0 0 1px
        rgba(124, 58, 237, 0.10);
    }


    .hero-icon i {
      font-size: 40px;
    }


    .hero-icon span {
      font:
        700 13px
        "JetBrains Mono",
        monospace;
    }


    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border-radius: 999px;
      background: rgba(124, 58, 237, 0.10);
      color: var(--primary);
      font-size: 12px;
      font-weight: 700;
    }


    h1 {
      margin: 12px 0 8px;
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1.1;
    }


    .hero-text p {
      margin: 0;
      max-width: 700px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }


    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 17px;
    }


    .tags span {
      padding: 5px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--muted);
      background: var(--surface);
      font:
        500 11px
        "JetBrains Mono",
        monospace;
    }


    .tool-section {
      padding-bottom: 70px;
    }


    .generator-card {
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
    }


    .card-topbar {
      min-height: 55px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
    }


    .window-dots {
      display: flex;
      gap: 6px;
    }


    .window-dots span {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--border);
    }


    .tool-name {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text);
      font:
        600 13px
        "JetBrains Mono",
        monospace;
    }


    .tool-name i {
      color: var(--primary);
    }


    .secure {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--success);
      font-size: 11px;
      font-weight: 700;
    }


    .actionbar {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      padding: 15px 18px;
      border-bottom: 1px solid var(--border);
    }


    .btn {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 15px;
      font-family: "Cairo", sans-serif;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s;
    }


    .btn:hover {
      transform: translateY(-1px);
    }


    .btn i {
      margin-left: 6px;
    }


    .btn-secondary {
      color: var(--text);
      background: var(--surface-2);
    }


    .btn-primary {
      color: white;
      background: var(--primary);
      border-color: var(--primary);
    }


    .btn-primary:hover {
      background: var(--primary-dark);
    }


    .workspace {
      padding: 20px;
    }


    .editor-panel {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--surface-2);
      margin-bottom: 15px;
    }


    .editor-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 15px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
    }


    .editor-title div {
      display: flex;
      align-items: center;
      gap: 8px;
    }


    .editor-title i {
      color: var(--primary);
    }


    .editor-title span {
      color: var(--muted);
      font:
        500 9px
        "JetBrains Mono",
        monospace;
    }


    .code-box {
      min-height: 190px;
    }


    .code-box textarea {
      width: 100%;
      min-height: 190px;
      display: block;
      resize: vertical;
      border: 0;
      outline: 0;
      padding: 17px;
      background: transparent;
      color: var(--text);
      direction: ltr;
      text-align: left;
      font:
        12px/1.8
        "JetBrains Mono",
        monospace;
    }


    .secret-panel {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--surface-2);
      margin-bottom: 15px;
    }


    #secretInput {
      width: calc(100% - 30px);
      margin: 15px;
      padding: 13px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      outline: 0;
      background: var(--surface);
      color: var(--text);
      direction: ltr;
      text-align: left;
      font:
        12px
        "JetBrains Mono",
        monospace;
    }


    #secretInput:focus {
      border-color: var(--primary);
    }


    .secret-note {
      margin: -4px 15px 15px;
      color: var(--muted);
      font-size: 10px;
    }


    .secret-note i {
      color: var(--primary);
      margin-left: 5px;
    }


    .result-box {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 15px 17px;
      margin-bottom: 15px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
    }


    .result-icon {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 11px;
      background: rgba(124, 58, 237, 0.10);
      color: var(--primary);
      font-size: 17px;
    }


    .result-box strong {
      display: block;
      font-size: 13px;
    }


    .result-box p {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }


    .result-box.success {
      border-color: rgba(22, 163, 74, 0.25);
    }


    .result-box.success .result-icon {
      color: var(--success);
      background: rgba(22, 163, 74, 0.10);
    }


    .result-box.error {
      border-color: rgba(220, 38, 38, 0.25);
    }


    .result-box.error .result-icon {
      color: var(--danger);
      background: rgba(220, 38, 38, 0.10);
    }


    .output-panel {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--surface-2);
      margin-bottom: 15px;
    }


    .output-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 15px;
      border-bottom: 1px solid var(--border);
      font-size: 12px;
      font-weight: 700;
    }


    .output-header div {
      display: flex;
      align-items: center;
      gap: 8px;
    }


    .output-header i {
      color: var(--primary);
    }


    .output-header span {
      color: var(--muted);
      font:
        500 9px
        "JetBrains Mono",
        monospace;
    }


    #jwtOutput {
      width: 100%;
      min-height: 130px;
      display: block;
      resize: vertical;
      border: 0;
      outline: 0;
      padding: 18px;
      background: transparent;
      color: var(--primary);
      direction: ltr;
      text-align: left;
      word-break: break-all;
      font:
        12px/1.9
        "JetBrains Mono",
        monospace;
    }


    .parts-preview {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 15px;
    }


    .preview-card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
    }


    .preview-title {
      padding: 11px 13px;
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      font-weight: 700;
    }


    .preview-title i {
      color: var(--primary);
      margin-left: 6px;
    }


    .preview-card pre {
      min-height: 125px;
      max-height: 250px;
      overflow: auto;
      margin: 0;
      padding: 14px;
      white-space: pre-wrap;
      word-break: break-word;
      color: var(--text);
      direction: ltr;
      text-align: left;
      font:
        10px/1.8
        "JetBrains Mono",
        monospace;
    }


    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }


    .stat {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface-2);
    }


    .stat-icon {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9px;
      color: var(--primary);
      background: rgba(124, 58, 237, 0.10);
    }


    .stat span {
      display: block;
      color: var(--muted);
      font-size: 9px;
    }


    .stat strong {
      display: block;
      max-width: 150px;
      overflow: hidden;
      margin-top: 2px;
      color: var(--text);
      text-overflow: ellipsis;
      white-space: nowrap;
      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    .info-section,
    .how-section,
    .faq-section {
      padding: 70px 0;
    }


    .info-section {
      background: var(--surface-2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }


    .section-heading {
      max-width: 700px;
      margin: 0 auto 35px;
      text-align: center;
    }


    .section-heading > span {
      color: var(--primary);
      font:
        700 11px
        "JetBrains Mono",
        monospace;
      letter-spacing: 1px;
    }


    .section-heading h2 {
      margin: 8px 0;
      font-size: clamp(25px, 4vw, 34px);
    }


    .section-heading p {
      margin: 0;
      color: var(--muted);
      line-height: 1.9;
      font-size: 14px;
    }


    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }


    .info-card {
      padding: 25px;
      border: 1px solid var(--border);
      border-radius: 17px;
      background: var(--surface);
    }


    .info-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 17px;
      border-radius: 13px;
      color: var(--primary);
      background: rgba(124, 58, 237, 0.10);
    }


    .info-card h3 {
      margin: 0 0 7px;
      font-size: 16px;
    }


    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }


    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }


    .step {
      display: flex;
      gap: 15px;
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
    }


    .step-number {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      color: white;
      background: var(--primary);
      font-weight: 800;
    }


    .step h3 {
      margin: 0 0 5px;
      font-size: 14px;
    }


    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.8;
    }


    .faq-list {
      max-width: 850px;
      margin: auto;
    }


    details {
      margin-bottom: 10px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface);
      overflow: hidden;
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 17px 19px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      list-style: none;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);
      transition: transform 0.2s;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;
      padding: 0 19px 18px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }


    @media (max-width: 850px) {

      .parts-preview {
        grid-template-columns: 1fr;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }
    }


    @media (max-width: 600px) {

      .container {
        width: min(100% - 22px, 1180px);
      }

      .hero {
        padding-top: 25px;
      }

      .hero-content {
        align-items: flex-start;
        flex-direction: column;
      }

      .hero-icon {
        width: 88px;
        height: 88px;
        flex-basis: 88px;
        border-radius: 23px;
      }

      .hero-icon i {
        font-size: 31px;
      }

      .card-topbar {
        padding: 0 13px;
      }

      .actionbar {
        padding: 12px;
      }

      .btn {
        flex: 1 1 calc(50% - 8px);
        padding: 9px 8px;
      }

      .workspace {
        padding: 12px;
      }

      .code-box textarea {
        min-height: 175px;
        padding: 14px;
        font-size: 10px;
      }

      #jwtOutput {
        min-height: 145px;
        padding: 14px;
        font-size: 10px;
      }

      .stats-grid {
        gap: 8px;
      }

      .stat {
        padding: 11px 9px;
      }

      .stat-icon {
        width: 31px;
        height: 31px;
        flex-basis: 31px;
      }

      .stat span {
        font-size: 8px;
      }

      .stat strong {
        max-width: 100px;
        font-size: 9px;
      }

      .info-section,
      .how-section,
      .faq-section {
        padding: 50px 0;
      }
    }

  </style>

</body>
</html>
