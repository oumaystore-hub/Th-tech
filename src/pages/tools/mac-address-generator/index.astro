          );
        box-shadow:
          0 15px 35px rgba(8, 166, 199, 0.24);
      }

      .tool-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        letter-spacing: -1px;
      }

      .hero-text p {
        margin: 0;
        color: var(--muted);
        max-width: 760px;
        line-height: 1.9;
        font-size: 15px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .tags span {
        padding: 6px 11px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        background: var(--surface);
        font-size: 11px;
      }

      .tool-section {
        padding: 20px 0 70px;
      }

      .tool-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .tool-topbar {
        min-height: 62px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
      }

      .window-dots {
        display: flex;
        gap: 7px;
      }

      .window-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border);
      }

      .tool-name {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
        font-size: 14px;
      }

      .tool-name i {
        color: var(--primary);
      }

      .secure {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--success);
        font-size: 12px;
        font-weight: 700;
      }

      .actionbar {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        padding: 15px 20px;
        border-bottom: 1px solid var(--border);
      }

      .action-btn {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        border-radius: 11px;
        padding: 9px 13px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: 0.2s ease;
      }

      .action-btn:hover {
        transform: translateY(-1px);
        border-color: var(--primary);
        color: var(--primary);
      }

      .action-btn.primary {
        margin-right: auto;
        color: white;
        border-color: transparent;
        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--primary-2)
          );
      }

      .action-btn.primary:hover {
        color: white;
        box-shadow: 0 8px 22px rgba(8, 166, 199, 0.22);
      }

      .editor-section {
        padding: 24px 24px 10px;
      }

      .editor-header,
      .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      .editor-header > div,
      .results-header > div {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
      }

      .editor-header i,
      .results-header i {
        color: var(--primary);
      }

      .editor-header span,
      .results-header span {
        color: var(--muted);
        font-size: 11px;
      }

      .input-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1.2fr;
        gap: 14px;
      }

      .field label {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 800;
      }

      .field label i {
        color: var(--primary);
        margin-left: 5px;
      }

      .field input,
      .field select {
        width: 100%;
        height: 48px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-2);
        color: var(--text);
        outline: none;
        padding: 0 14px;
        direction: ltr;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        transition: 0.2s ease;
      }

      .field select {
        cursor: pointer;
      }

      .field input:focus,
      .field select:focus {
        border-color: var(--primary);
        box-shadow:
          0 0 0 4px var(--primary-soft);
      }

      .field small {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-top: 7px;
      }

      .examples {
        padding: 18px 24px 22px;
      }

      .examples-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 10px;
      }

      .examples-title i {
        color: var(--primary);
      }

      .example-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .example-list button {
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--muted);
        border-radius: 9px;
        padding: 7px 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        transition: 0.2s ease;
      }

      .example-list button:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .status-box {
        margin: 0 24px 24px;
        padding: 15px 16px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        border: 1px solid var(--border);
      }

      .status-box.ready {
        background: var(--primary-soft);
      }

      .status-box.success {
        background: rgba(11, 155, 114, 0.09);
        border-color: rgba(11, 155, 114, 0.22);
      }

      .status-box.error {
        background: rgba(229, 72, 77, 0.08);
        border-color: rgba(229, 72, 77, 0.2);
      }

      .status-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--surface);
        color: var(--primary);
      }

      .success .status-icon {
        color: var(--success);
      }

      .error .status-icon {
        color: var(--danger);
      }

      .status-box strong {
        display: block;
        font-size: 12px;
        margin-bottom: 2px;
      }

      .status-box p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      .results {
        display: none;
        padding: 24px;
        border-top: 1px solid var(--border);
        background: var(--surface-2);
      }

      .mac-list {
        display: grid;
        gap: 10px;
      }

      .mac-item {
        min-height: 62px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        transition: 0.2s ease;
      }

      .mac-item:hover {
        border-color: rgba(8, 166, 199, 0.4);
        transform: translateY(-1px);
      }

      .mac-number {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
      }

      .mac-value {
        min-width: 0;
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .mac-value i {
        color: var(--primary);
        font-size: 14px;
      }

      .mac-value code {
        direction: ltr;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        overflow-wrap: anywhere;
      }

      .mini-copy {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: var(--surface-2);
        color: var(--muted);
        transition: 0.2s ease;
      }

      .mini-copy:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 18px;
      }

      .stat {
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        text-align: center;
      }

      .stat span {
        display: block;
        color: var(--muted);
        font-size: 10px;
        margin-bottom: 5px;
      }

      .stat strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
      }

      .info-section,
      .how-section,
      .faq-section {
        padding: 70px 0;
      }

      .how-section {
        background: var(--surface-2);
        border-block: 1px solid var(--border);
      }

      .section-heading {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 34px;
      }

      .section-heading > span {
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .section-heading h2 {
        margin: 7px 0 10px;
        font-size: clamp(24px, 4vw, 32px);
      }

      .section-heading p {
        color: var(--muted);
        margin: 0;
        font-size: 13px;
        line-height: 1.9;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .info-card {
        padding: 25px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
      }

      .info-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--primary-soft);
        color: var(--primary);
        margin-bottom: 15px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        display: flex;
        gap: 15px;
        padding: 22px;
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 18px;
      }

      .step-number {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--primary-2)
          );
        color: white;
        font-weight: 800;
      }

      .step h3 {
        margin: 0 0 6px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 10px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        padding: 17px 18px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        font-size: 12px;
        font-weight: 800;
        list-style: none;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: transform 0.2s ease;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        padding: 0 18px 18px;
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 11px;
      }

      @media (max-width: 900px) {
        .input-grid {
          grid-template-columns: 1fr 1fr;
        }

        .input-grid .field:last-child {
          grid-column: 1 / -1;
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .hero-content {
          align-items: flex-start;
        }

        .hero-icon {
          width: 65px;
          height: 65px;
          flex-basis: 65px;
          border-radius: 18px;
          font-size: 25px;
        }

        .tool-topbar {
          padding: 0 14px;
        }

        .secure {
          display: none;
        }

        .editor-section,
        .examples,
        .results {
          padding-inline: 15px;
        }

        .status-box {
          margin-inline: 15px;
        }

        .action-btn.primary {
          margin-right: 0;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero {
          padding-top: 25px;
        }

        .hero-content {
          gap: 14px;
        }

        .hero-icon {
          display: none;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text p {
          font-size: 13px;
        }

        .input-grid {
          grid-template-columns: 1fr;
        }

        .input-grid .field:last-child {
          grid-column: auto;
        }

        .actionbar {
          padding: 12px 15px;
        }

        .action-btn {
          flex: 1;
          justify-content: center;
        }

        .action-btn.primary {
          flex-basis: 100%;
        }

        .example-list {
          overflow-x: auto;
          flex-wrap: nowrap;
          padding-bottom: 4px;
        }

        .example-list button {
          white-space: nowrap;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .mac-value code {
          font-size: 12px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 55px 0;
        }
      }
    </style>
  </body>
</html>
