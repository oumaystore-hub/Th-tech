        margin: 0;
        background:
          radial-gradient(
            circle at 10% 0%,
            rgba(8, 166, 199, 0.08),
            transparent 28%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
      }

