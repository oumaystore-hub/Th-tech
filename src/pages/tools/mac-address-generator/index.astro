        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin-inline: auto;
      }

      .hero {
        padding: 42px 0 30px;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 28px;
        flex-wrap: wrap;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
      }

      .breadcrumb i {
        font-size: 9px;
      }

      .hero-content {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .hero-icon {
        width: 82px;
        height: 82px;
        flex: 0 0 82px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: white;
