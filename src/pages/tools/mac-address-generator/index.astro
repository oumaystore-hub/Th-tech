---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "MAC Address Generator - مولد MAC Address أونلاين مجاناً | Th.Tech";

const description =
  "مولد MAC Address مجاني لإنشاء عناوين MAC عشوائية وصحيحة مع إمكانية اختيار Unicast أو Multicast وLocally Administered أو Globally Unique.";

const faqs = [
  {
    q: "ما هي أداة MAC Address Generator؟",
    a: "هي أداة لإنشاء عناوين MAC عشوائية بتنسيق صحيح مثل 02:4A:7B:91:C3:F8، ويمكن استخدامها للاختبار والتطوير ومحاكاة إعدادات الشبكات."
  },
  {
    q: "هل عناوين MAC التي يتم إنشاؤها حقيقية؟",
    a: "الأداة تنشئ عناوين بتنسيق MAC صحيح، لكنها عشوائية وليست مرتبطة بجهاز فعلي محدد."
  },
  {
    q: "ما الفرق بين Locally Administered وGlobally Unique؟",
    a: "العنوان Locally Administered مخصص للاستخدام المحلي والاختبارات، بينما Globally Unique يستخدم عادةً معرف الشركة OUI في البايت الأول."
  },
  {
    q: "هل يتم إرسال العناوين التي أنشئها إلى الخادم؟",
    a: "لا. يتم إنشاء جميع العناوين داخل المتصفح باستخدام JavaScript ولا يتم إرسالها إلى خادم خارجي."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/mac-address-generator/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");

          if (theme === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          } else {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>MAC Address Generator</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-solid fa-network-wired"></i>
            </div>

            <div class="hero-text">
              <div class="tool-badge">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                Network Tools
              </div>

              <h1>MAC Address Generator</h1>

              <p>
                أنشئ عناوين MAC عشوائية وصحيحة بسرعة، مع خيارات للتحكم في نوع
                العنوان وتنسيقه وعدد العناوين المطلوبة.
              </p>

              <div class="tags">
                <span>MAC</span>
                <span>Networking</span>
                <span>Ethernet</span>
                <span>Random</span>
                <span>Local</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="tool-section">
        <div class="container">
          <div class="tool-card">
            <div class="tool-topbar">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="tool-name">
                <i class="fa-solid fa-network-wired"></i>
                MAC Address Generator
              </div>

              <div class="secure">
                <i class="fa-solid fa-lock"></i>
                معالجة محلية
              </div>
            </div>

            <div class="actionbar">
              <button class="action-btn" id="exampleBtn">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                مثال
              </button>

              <button class="action-btn" id="clearBtn">
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

              <button class="action-btn" id="copyBtn">
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

              <button class="action-btn primary" id="generateBtn">
                <i class="fa-solid fa-bolt"></i>
                توليد
              </button>
            </div>

            <div class="editor-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-sliders"></i>
                  إعدادات التوليد
                </div>

                <span>MAC / IEEE 802</span>
              </div>

              <div class="input-grid">
                <div class="field">
                  <label for="formatInput">
                    <i class="fa-solid fa-code"></i>
                    تنسيق MAC
                  </label>

                  <select id="formatInput">
                    <option value="colon">AA:BB:CC:DD:EE:FF</option>
                    <option value="hyphen">AA-BB-CC-DD-EE-FF</option>
                    <option value="dot">AABB.CCDD.EEFF</option>
                    <option value="plain">AABBCCDDEEFF</option>
                  </select>

                  <small>اختر الشكل المناسب للعنوان</small>
                </div>

                <div class="field">
                  <label for="countInput">
                    <i class="fa-solid fa-list-ol"></i>
                    عدد العناوين
                  </label>

                  <input
                    id="countInput"
                    type="number"
                    min="1"
                    max="100"
                    value="5"
                    inputmode="numeric"
                  />

                  <small>من 1 إلى 100 عنوان</small>
                </div>

                <div class="field">
                  <label for="addressType">
                    <i class="fa-solid fa-network-wired"></i>
                    نوع العنوان
                  </label>

                  <select id="addressType">
                    <option value="unicast-local">
                      Unicast + Locally Administered
                    </option>
                    <option value="unicast-global">
                      Unicast + Globally Unique
                    </option>
                    <option value="multicast-local">
                      Multicast + Locally Administered
                    </option>
                    <option value="random">
                      Random
                    </option>
                  </select>

                  <small>تحكم في البتات الخاصة بالعنوان</small>
                </div>
              </div>
            </div>

            <div class="examples">
              <div class="examples-title">
                <i class="fa-solid fa-bolt"></i>
                أمثلة سريعة
              </div>

              <div class="example-list">
                <button data-example="colon|5|unicast-local">
                  5 عناوين محلية
                </button>

                <button data-example="hyphen|10|unicast-local">
                  10 عناوين
                </button>

                <button data-example="dot|3|unicast-global">
                  Cisco Format
                </button>

                <button data-example="plain|8|random">
                  Plain Format
                </button>
              </div>
            </div>

            <div class="status-box ready" id="statusBox">
              <div class="status-icon">
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div>
                <strong id="statusTitle">جاهز للتوليد</strong>

                <p id="statusText">
                  اختر الإعدادات ثم اضغط على توليد.
                </p>
              </div>
            </div>

            <div class="results" id="results">
              <div class="results-header">
                <div>
                  <i class="fa-solid fa-list"></i>
                  العناوين المولدة
                </div>

                <span id="resultCount">0 عناوين</span>
              </div>

              <div class="mac-list" id="macList"></div>

              <div class="stats-grid">
                <div class="stat">
                  <span>عدد العناوين</span>
                  <strong id="statCount">0</strong>
                </div>

                <div class="stat">
                  <span>التنسيق</span>
                  <strong id="statFormat">Colon</strong>
                </div>

                <div class="stat">
                  <span>النوع</span>
                  <strong id="statType">Unicast</strong>
                </div>

                <div class="stat">
                  <span>Local Bit</span>
                  <strong id="statLocal">Local</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>لماذا MAC Address Generator؟</span>

            <h2>إنشاء عناوين MAC بسهولة</h2>

            <p>
              أداة سريعة ومجانية لإنشاء عناوين MAC مناسبة للاختبار والتطوير
              ومحاكاة الشبكات.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>توليد فوري</h3>

              <p>
                أنشئ حتى 100 عنوان MAC في لحظات وبشكل عشوائي.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-sliders"></i>
              </div>

              <h3>تحكم كامل</h3>

              <p>
                اختر نوع العنوان والتنسيق وعدد العناوين التي تريد إنشاءها.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <h3>خصوصية محلية</h3>

              <p>
                التوليد يتم بالكامل داخل المتصفح ولا يتم إرسال البيانات إلى
                الخادم.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>طريقة الاستخدام</span>

            <h2>أنشئ MAC Address في 3 خطوات</h2>
          </div>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>اختر التنسيق</h3>

                <p>
                  اختر Colon أو Hyphen أو Cisco Dot أو التنسيق بدون فواصل.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>حدد النوع والعدد</h3>

                <p>
                  حدد نوع MAC وعدد العناوين التي تريد إنشاءها.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>توليد ونسخ</h3>

                <p>
                  اضغط على توليد ثم انسخ العناوين المطلوبة مباشرة.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>الأسئلة الشائعة</span>

            <h2>MAC Address Generator FAQ</h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const formatInput = document.getElementById("formatInput");
      const countInput = document.getElementById("countInput");
      const addressType = document.getElementById("addressType");

      const generateBtn = document.getElementById("generateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const statusBox = document.getElementById("statusBox");
      const statusTitle = document.getElementById("statusTitle");
      const statusText = document.getElementById("statusText");

      const results = document.getElementById("results");
      const macList = document.getElementById("macList");
      const resultCount = document.getElementById("resultCount");

      const statCount = document.getElementById("statCount");
      const statFormat = document.getElementById("statFormat");
      const statType = document.getElementById("statType");
      const statLocal = document.getElementById("statLocal");

      let generatedAddresses = [];

      function randomByte() {
        return Math.floor(Math.random() * 256);
      }

      function createMac(type) {
        const bytes = new Uint8Array(6);

        for (let i = 0; i < 6; i++) {
          bytes[i] = randomByte();
        }

        /*
         * The first byte contains:
         * bit 0 = I/G bit
         * bit 1 = U/L bit
         */
        switch (type) {
          case "unicast-local":
            bytes[0] = (bytes[0] | 0x02) & 0xfe;
            break;

          case "unicast-global":
            bytes[0] = bytes[0] & 0xfc;
            break;

          case "multicast-local":
            bytes[0] = bytes[0] | 0x03;
            break;

          case "random":
          default:
            break;
        }

        return Array.from(bytes);
      }

      function formatMac(bytes, format) {
        const hex = bytes.map((byte) =>
          byte.toString(16).padStart(2, "0").toUpperCase()
        );

        switch (format) {
          case "hyphen":
            return hex.join("-");

          case "dot":
            return (
              hex.slice(0, 2).join("") +
              "." +
              hex.slice(2, 4).join("") +
              "." +
              hex.slice(4, 6).join("")
            );

          case "plain":
            return hex.join("");

          case "colon":
          default:
            return hex.join(":");
        }
      }

      function formatName(format) {
        switch (format) {
          case "hyphen":
            return "Hyphen";

          case "dot":
            return "Cisco";

          case "plain":
            return "Plain";

          default:
            return "Colon";
        }
      }

      function typeName(type) {
        switch (type) {
          case "unicast-local":
            return "Unicast";

          case "unicast-global":
            return "Unicast";

          case "multicast-local":
            return "Multicast";

          default:
            return "Random";
        }
      }

      function localName(type) {
        switch (type) {
          case "unicast-global":
            return "Global";

          case "random":
            return "Random";

          default:
            return "Local";
        }
      }

      function showStatus(type, title, text) {
        statusBox.className = `status-box ${type}`;
        statusTitle.textContent = title;
        statusText.textContent = text;
      }

      function showReady() {
        showStatus(
          "ready",
          "جاهز للتوليد",
          "اختر الإعدادات ثم اضغط على توليد."
        );
      }

      function showSuccess(text) {
        showStatus("success", "تم التوليد بنجاح", text);
      }

      function showError(text) {
        showStatus("error", "بيانات غير صحيحة", text);
      }

      function resetResults() {
        generatedAddresses = [];
        macList.innerHTML = "";
        results.style.display = "none";

        resultCount.textContent = "0 عناوين";
        statCount.textContent = "0";
        statFormat.textContent = "Colon";
        statType.textContent = "Unicast";
        statLocal.textContent = "Local";
      }

      function createMacItem(mac, index) {
        const item = document.createElement("div");
        item.className = "mac-item";

        item.innerHTML = `
          <div class="mac-number">${index + 1}</div>

          <div class="mac-value">
            <i class="fa-solid fa-network-wired"></i>
            <code>${mac}</code>
          </div>

          <button
            class="mini-copy"
            type="button"
            aria-label="نسخ العنوان"
          >
            <i class="fa-regular fa-copy"></i>
          </button>
        `;

        const copyButton = item.querySelector(".mini-copy");

        copyButton.addEventListener("click", () => {
          copyText(mac, copyButton);
        });

        return item;
      }

      function generate() {
        let count = Number(countInput.value);

        if (
          !Number.isInteger(count) ||
          count < 1 ||
          count > 100
        ) {
          resetResults();
          showError("عدد العناوين يجب أن يكون بين 1 و100.");
          return;
        }

        const format = formatInput.value;
        const type = addressType.value;

        generatedAddresses = [];

        const unique = new Set();

        /*
         * Avoid duplicates when generating a batch.
         */
        let attempts = 0;

        while (
          generatedAddresses.length < count &&
          attempts < count * 50
        ) {
          attempts++;

          const mac = formatMac(
            createMac(type),
            format
          );

          if (!unique.has(mac)) {
            unique.add(mac);
            generatedAddresses.push(mac);
          }
        }

        if (generatedAddresses.length !== count) {
          resetResults();
          showError("تعذر إنشاء العدد المطلوب من العناوين. حاول مرة أخرى.");
          return;
        }

        macList.innerHTML = "";

        generatedAddresses.forEach((mac, index) => {
          macList.appendChild(
            createMacItem(mac, index)
          );
        });

        resultCount.textContent =
          `${count} ${count === 1 ? "عنوان" : "عناوين"}`;

        statCount.textContent = count;
        statFormat.textContent = formatName(format);
        statType.textContent = typeName(type);
        statLocal.textContent = localName(type);

        results.style.display = "block";

        showSuccess(
          `تم إنشاء ${count} ${count === 1 ? "عنوان MAC" : "عناوين MAC"} بشكل عشوائي.`
        );
      }

      function loadExample() {
        formatInput.value = "colon";
        countInput.value = "5";
        addressType.value = "unicast-local";

        generate();
      }

      function clearAll() {
        formatInput.value = "colon";
        countInput.value = "5";
        addressType.value = "unicast-local";

        resetResults();
        showReady();

        formatInput.focus();
      }

      async function copyText(text, button) {
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const oldHTML = button.innerHTML;

          button.innerHTML =
            '<i class="fa-solid fa-check"></i>';

          setTimeout(() => {
            button.innerHTML = oldHTML;
          }, 1200);
        } catch {
          showError("تعذر نسخ العنوان إلى الحافظة.");
        }
      }

      async function copyAll() {
        if (!generatedAddresses.length) {
          showError("قم بتوليد العناوين أولاً ثم حاول نسخها.");
          return;
        }

        try {
          await navigator.clipboard.writeText(
            generatedAddresses.join("\n")
          );

          const oldHTML = copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = oldHTML;
          }, 1400);
        } catch {
          showError("تعذر نسخ العناوين إلى الحافظة.");
        }
      }

      generateBtn.addEventListener("click", generate);
      exampleBtn.addEventListener("click", loadExample);
      clearBtn.addEventListener("click", clearAll);
      copyBtn.addEventListener("click", copyAll);

      [formatInput, countInput, addressType].forEach((input) => {
        input.addEventListener("change", () => {
          if (generatedAddresses.length) {
            generate();
          }
        });
      });

      countInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          generate();
        }
      });

      document.querySelectorAll("[data-example]").forEach((button) => {
        button.addEventListener("click", () => {
          const [format, count, type] =
            button.dataset.example.split("|");

          formatInput.value = format;
          countInput.value = count;
          addressType.value = type;

          generate();
        });
      });

      resetResults();
      showReady();
    </script>

    <style>
      :root {
        --bg: #f4f9fc;
        --surface: #ffffff;
        --surface-2: #f7fbfd;
        --border: #dceaf1;
        --text: #10212b;
        --muted: #667985;
        --primary: #08a6c7;
        --primary-2: #087ea0;
        --primary-soft: rgba(8, 166, 199, 0.1);
        --success: #0b9b72;
        --danger: #e5484d;
        --shadow: 0 20px 60px rgba(15, 60, 80, 0.1);
      }

      html.dark-mode {
        --bg: #071218;
        --surface: #0c1b23;
        --surface-2: #10242e;
        --border: #1d3743;
        --text: #eaf7fb;
        --muted: #91a8b2;
        --primary: #19c5e7;
        --primary-2: #56d7ef;
        --primary-soft: rgba(25, 197, 231, 0.1);
        --success: #20c997;
        --danger: #ff6b70;
        --shadow: 0 20px 70px rgba(0, 0, 0, 0.3);
      }

