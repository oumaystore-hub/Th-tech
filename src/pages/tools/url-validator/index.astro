---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "URL Validator - التحقق من URL أونلاين مجاناً | Th.Tech";

const description =
  "أداة URL Validator مجانية للتحقق من صحة الروابط وعناوين URL وتحليل البروتوكول والنطاق والمسار والمعلمات مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة URL Validator؟",
    a: "هي أداة تساعدك على التحقق من صحة صيغة عنوان URL والتأكد من إمكانية تحليله كعنوان ويب صالح."
  },
  {
    q: "ما الذي تتحقق منه الأداة؟",
    a: "تتحقق الأداة من صيغة URL، والبروتوكول، واسم النطاق، والمسار، والمنفذ، ومعلمات البحث وغيرها من مكونات الرابط."
  },
  {
    q: "هل يتم إرسال الرابط إلى الخادم؟",
    a: "لا. تتم عملية التحقق والتحليل بالكامل داخل المتصفح."
  },
  {
    q: "هل تدعم الأداة HTTPS؟",
    a: "نعم، تدعم الأداة عناوين HTTP وHTTPS وتعرض نوع البروتوكول المستخدم."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>URL Validator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-circle-check"></i>
            <span>URL</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-shield-halved"></i>
              Developer Tools
            </div>

            <h1>URL Validator</h1>

            <p>
              تحقق من صحة عناوين URL وحلل مكوناتها بسرعة
              مباشرة من متصفحك.
            </p>

            <div class="tags">
              <span>URL Validation</span>
              <span>HTTP</span>
              <span>HTTPS</span>
              <span>Local</span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="validator-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-circle-check"></i>
              URL Validator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button id="validateBtn" class="btn btn-primary">
              <i class="fa-solid fa-circle-check"></i>
              التحقق من URL
            </button>

          </div>


          <!-- INPUT -->
          <div class="input-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-link"></i>
                عنوان URL
              </div>

              <span id="inputCount">0 حرف</span>

            </div>

            <div class="url-editor">

              <div class="url-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <textarea
                id="urlInput"
                rows="3"
                spellcheck="false"
                placeholder="https://example.com/path?query=value"
              ></textarea>

            </div>

          </div>


          <!-- RESULT -->
          <div
            class="result-box"
            id="resultBox"
          >

            <div
              class="result-icon"
              id="resultIcon"
            >
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للتحقق
              </strong>

              <p id="resultMessage">
                أدخل عنوان URL ثم اضغط على زر التحقق.
              </p>

            </div>

          </div>


          <!-- URL DETAILS -->
          <div
            class="details-panel"
            id="detailsPanel"
          >

            <div class="details-title">
              <i class="fa-solid fa-magnifying-glass"></i>
              تحليل عنوان URL
            </div>

            <div class="details-grid">

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-globe"></i>
                  البروتوكول
                </span>
                <strong id="protocolValue">—</strong>
              </div>

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-server"></i>
                  النطاق
                </span>
                <strong id="hostnameValue">—</strong>
              </div>

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-plug"></i>
                  المنفذ
                </span>
                <strong id="portValue">—</strong>
              </div>

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-folder-open"></i>
                  المسار
                </span>
                <strong id="pathnameValue">—</strong>
              </div>

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-magnifying-glass"></i>
                  Query
                </span>
                <strong id="queryValue">—</strong>
              </div>

              <div class="detail-item">
                <span>
                  <i class="fa-solid fa-hashtag"></i>
                  Fragment
                </span>
                <strong id="hashValue">—</strong>
              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-link"></i>
              </div>

              <div>
                <span>طول URL</span>
                <strong id="statLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <span>البروتوكول</span>
                <strong id="statProtocol">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-server"></i>
              </div>

              <div>
                <span>النطاق</span>
                <strong id="statDomain">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>URL VALIDATION</span>

          <h2>
            ما هو URL Validator؟
          </h2>

          <p>
            أداة للتحقق من صحة صيغة عناوين URL وتحليل
            المكونات الأساسية للرابط بطريقة سهلة وسريعة.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-circle-check"></i>
            </div>

            <h3>
              التحقق من الصيغة
            </h3>

            <p>
              تتحقق الأداة من إمكانية تحليل النص كعنوان URL
              صالح وتكشف الصيغ غير الصحيحة.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-sitemap"></i>
            </div>

            <h3>
              تحليل المكونات
            </h3>

            <p>
              اعرض البروتوكول والنطاق والمنفذ والمسار
              ومعلمات البحث وFragment.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>
              خصوصية كاملة
            </h3>

            <p>
              تتم عملية التحقق محلياً داخل المتصفح دون
              إرسال الرابط إلى أي خادم.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام URL Validator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                أدخل عنوان URL
              </h3>

              <p>
                الصق الرابط الذي تريد التحقق من صحته.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                اضغط تحقق
              </h3>

              <p>
                ستقوم الأداة بتحليل الرابط والتحقق من صيغته.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                راجع التفاصيل
              </h3>

              <p>
                شاهد البروتوكول والنطاق والمسار وبقية مكونات الرابط.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  



<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/url-decoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/url-encoder/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/url-parser/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Url Parser</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/email-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Email Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Html Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ip-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Ip Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const input =
        document.getElementById("urlInput");

      const validateBtn =
        document.getElementById("validateBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");


      const inputCount =
        document.getElementById("inputCount");


      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");


      const detailsPanel =
        document.getElementById("detailsPanel");


      const protocolValue =
        document.getElementById("protocolValue");

      const hostnameValue =
        document.getElementById("hostnameValue");

      const portValue =
        document.getElementById("portValue");

      const pathnameValue =
        document.getElementById("pathnameValue");

      const queryValue =
        document.getElementById("queryValue");

      const hashValue =
        document.getElementById("hashValue");


      const statLength =
        document.getElementById("statLength");

      const statProtocol =
        document.getElementById("statProtocol");

      const statDomain =
        document.getElementById("statDomain");

      const statStatus =
        document.getElementById("statStatus");


      function updateCount() {

        const length =
          input.value.length;

        inputCount.textContent =
          `${length.toLocaleString()} حرف`;

        statLength.textContent =
          length.toLocaleString();
      }


      function resetDetails() {

        protocolValue.textContent = "—";
        hostnameValue.textContent = "—";
        portValue.textContent = "—";
        pathnameValue.textContent = "—";
        queryValue.textContent = "—";
        hashValue.textContent = "—";

        statProtocol.textContent = "—";
        statDomain.textContent = "—";
      }


      function setSuccess(message) {

        resultBox.classList.remove("error");

        resultBox.classList.add("success");


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';


        resultTitle.textContent =
          "URL صالح";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "صالح";
      }


      function setError(message) {

        resultBox.classList.remove("success");

        resultBox.classList.add("error");


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';


        resultTitle.textContent =
          "URL غير صالح";


        resultMessage.textContent =
          message;


        statStatus.textContent =
          "غير صالح";


        detailsPanel.classList.remove("visible");

        resetDetails();
      }


      function setReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';


        resultTitle.textContent =
          "جاهز للتحقق";


        resultMessage.textContent =
          "أدخل عنوان URL ثم اضغط على زر التحقق.";


        statStatus.textContent =
          "جاهز";


        detailsPanel.classList.remove(
          "visible"
        );
      }


      function validateURL() {

        const value =
          input.value.trim();


        updateCount();


        if (!value) {

          setError(
            "أدخل عنوان URL أولاً."
          );

          return;
        }


        const start =
          performance.now();


        try {

          const url =
            new URL(value);


          if (
            url.protocol !== "http:" &&
            url.protocol !== "https:"
          ) {

            setError(
              "البروتوكول غير مدعوم. استخدم HTTP أو HTTPS."
            );

            return;
          }


          if (!url.hostname) {

            setError(
              "لم يتم العثور على اسم نطاق صالح."
            );

            return;
          }


          protocolValue.textContent =
            url.protocol.replace(":", "").toUpperCase();


          hostnameValue.textContent =
            url.hostname;


          portValue.textContent =
            url.port || "الافتراضي";


          pathnameValue.textContent =
            url.pathname || "/";


          queryValue.textContent =
            url.search || "لا توجد";


          hashValue.textContent =
            url.hash || "لا يوجد";


          statProtocol.textContent =
            url.protocol
              .replace(":", "")
              .toUpperCase();


          statDomain.textContent =
            url.hostname;


          detailsPanel.classList.add(
            "visible"
          );


          const end =
            performance.now();


          setSuccess(
            `تم التحقق من الرابط بنجاح خلال ${(end - start).toFixed(2)} ms.`
          );

        } catch (error) {

          setError(
            "صيغة عنوان URL غير صحيحة. تأكد من كتابة الرابط بشكل صحيح."
          );
        }
      }


      function loadExample() {

        input.value =
          "https://th.tech/tools/url-validator/?query=test&lang=ar#result";


        updateCount();

        validateURL();
      }


      function clearAll() {

        input.value = "";

        updateCount();

        resetDetails();

        setReady();

        input.focus();
      }


      async function copyURL() {

        const value =
          input.value.trim();


        if (!value) {

          setError(
            "لا يوجد URL لنسخه."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);

        } catch {

          input.select();

          document.execCommand("copy");

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ';

          }, 1500);
        }
      }


      input.addEventListener(
        "input",
        updateCount
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            validateURL();
          }

        }
      );


      validateBtn.addEventListener(
        "click",
        validateURL
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyURL
      );


      updateCount();

      resetDetails();

    })();
  </script>


