      flex: 0 0 40px;

      border-radius: 10px;

      color: var(--primary);

      background:
        var(--primary-soft);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 13px;

      font-weight: 800;

    }


    .rgb-icon {
      font-size: 9px;
    }


    .hsl-icon {
      font-size: 9px;
    }


    .hsv-icon {
      font-size: 9px;
    }


    .output-header strong {

      display: block;

      font-size: 13px;

    }


    .output-header small {

      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 9px;

    }


    .copy-btn {

      width: 35px;
      height: 35px;

      display: grid;

      place-items: center;

      border:
        1px solid var(--border);

      border-radius: 9px;

      color: var(--muted);

      background:
        var(--surface);

      cursor: pointer;

      transition:
        0.2s;

    }


    .copy-btn:hover {

      color: var(--primary);

      border-color:
        var(--primary);

    }


    .output-value {

      margin-top: 14px;

      padding:
        12px;

      overflow-x: auto;

      border-radius: 9px;

      color: var(--text);

      background:
        var(--surface);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 12px;

      direction: ltr;

      text-align: left;

      white-space: nowrap;

    }


    /* CSS OUTPUT */

    .css-output {

      margin-top: 15px;

      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius: 14px;

      background:
        var(--surface-2);

    }


    .css-header {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 10px;

      padding:
        11px 14px;

      border-bottom:
        1px solid var(--border);

    }


    .css-header > div {

      display: flex;

      align-items: center;

      gap: 8px;

      font-size: 12px;

      font-weight: 700;

    }


    .css-header i {

      color: var(--primary);

      font-size: 18px;

    }


    .css-header button {

      display: flex;

      align-items: center;

      gap: 6px;

      padding:
        7px 10px;

      border:
        1px solid var(--border);

      border-radius: 8px;

      color: var(--text);

      background:
        var(--surface);

      cursor: pointer;

      font-size: 10px;

    }


    .css-output code {

      display: block;

      padding: 15px;

      direction: ltr;

      text-align: left;

      color: var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 12px;

    }


    /* STATUS */

    .status-line {

      display: flex;

      align-items: center;

      gap: 8px;

      margin-top: 15px;

      color: var(--success);

      font-size: 12px;

      font-weight: 600;

    }


    /* STATS */

    .stats-grid {

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 12px;

      padding:
        0 25px 25px;

    }


    .stat {

      display: flex;

      align-items: center;

      gap: 12px;

      padding: 15px;

      border:
        1px solid var(--border);

      border-radius: 14px;

      background:
        var(--surface-2);

      min-width: 0;

    }


    .stat-icon {

      width: 42px;
      height: 42px;

      flex: 0 0 42px;

      display: grid;

      place-items: center;

      border-radius: 11px;

      color: var(--primary);

      background:
        var(--primary-soft);

    }


    .stat span {

      display: block;

      margin-bottom: 2px;

      color: var(--muted);

      font-size: 10px;

    }


    .stat strong {

      display: block;

      overflow: hidden;

      text-overflow: ellipsis;

      white-space: nowrap;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 12px;

    }


    /* SECURITY */

    .security-note {

      display: flex;

      align-items: flex-start;

      gap: 14px;

      margin:
        0 25px 25px;

      padding: 17px;

      border:
        1px solid
        rgba(22, 163, 74, 0.15);

      border-radius: 15px;

      background:
        rgba(22, 163, 74, 0.05);

    }


    .security-icon {

      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      display: grid;

      place-items: center;

      border-radius: 10px;

      color: var(--success);

      background:
        rgba(22, 163, 74, 0.1);

    }


    .security-note strong {

      display: block;

      margin-bottom: 4px;

      font-size: 13px;

    }


    .security-note p {

      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.8;

    }


    /* =========================================
       INFO
    ========================================== */

    .info-section {

      padding:
        70px 0;

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);

      background:
        var(--surface);

    }


    .section-heading {

      max-width: 760px;

      margin:
        0 auto 35px;

      text-align: center;

    }


    .section-heading > span {

      color: var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 11px;

      font-weight: 700;

      letter-spacing: 1px;

    }


    .section-heading h2 {

      margin:
        7px 0 8px;

      font-size:
        clamp(24px, 4vw, 34px);

    }


    .section-heading p {

      margin: 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.9;

    }


    .info-grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;

    }


    .info-card {

      padding: 25px;

      border:
        1px solid var(--border);

      border-radius: 18px;

      background:
        var(--surface-2);

      transition:
        transform 0.25s ease,
        border-color 0.25s ease;

    }


    .info-card:hover {

      transform:
        translateY(-5px);

      border-color:
        rgba(37, 99, 235, 0.35);

    }


    .info-icon {

      width: 50px;
      height: 50px;

      display: grid;

      place-items: center;

      margin-bottom: 15px;

      border-radius: 14px;

      color: var(--primary);

      background:
        var(--primary-soft);

      font-size: 20px;

    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size: 17px;

    }


    .info-card p {

      margin: 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;

    }


    /* =========================================
       HOW
    ========================================== */

    .how-section {

      padding:
        70px 0;

    }


    .steps {

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 15px;

    }


    .step {

      padding: 22px;

      border:
        1px solid var(--border);

      border-radius: 17px;

      background:
        var(--surface);

    }


    .step-number {

      width: 40px;
      height: 40px;

      display: grid;

      place-items: center;

      margin-bottom: 15px;

      border-radius: 12px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

      font-weight: 800;

    }


    .step h3 {

      margin:
        0 0 7px;

      font-size: 15px;

    }


    .step p {

      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.8;

    }


    /* =========================================
       FAQ
    ========================================== */

    .faq-section {

      padding:
        70px 0;

      border-top:
        1px solid var(--border);

      background:
        var(--surface);

    }


    .faq-list {

      max-width: 850px;

      margin-inline: auto;

      display: grid;

      gap: 10px;

    }


    .faq-list details {

      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius: 14px;

      background:
        var(--surface-2);

    }


    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding:
        17px 19px;

      cursor: pointer;

      list-style: none;

      font-size: 13px;

      font-weight: 700;

    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color: var(--primary);

      transition:
        transform 0.2s ease;

    }


    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);

    }


    .faq-list details p {

      margin: 0;

      padding:
        0 19px 18px;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.9;

    }


    /* =========================================
       RESPONSIVE
    ========================================== */

    @media (max-width: 900px) {

      .input-layout {

        grid-template-columns:
          1fr;

      }


      .info-grid,
      .steps {

        grid-template-columns:
          repeat(2, 1fr);

      }


      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);

      }

    }


    @media (max-width: 700px) {

      .hero {

        padding:
          30px 0 50px;

      }


      .hero-content {

        align-items: flex-start;

        flex-direction: column;

      }


      .hero-icon {

        width: 76px;
        height: 76px;

        flex-basis: 76px;

        border-radius: 21px;

        font-size: 30px;

      }


      .hero p {

        font-size: 14px;

      }


      .actionbar {

        align-items: stretch;

        flex-direction: column;

      }


      .action-group {

        width: 100%;

      }


      .action-group .btn {

        flex: 1;

      }


      .output-grid {

        grid-template-columns:
          1fr;

      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;

      }

    }


    @media (max-width: 520px) {

      .container {

        width:
          min(
            calc(100% - 20px),
            1180px
          );

      }


      .converter-body {

        padding: 16px;

      }


      .card-topbar {

        padding:
          0 15px;

      }


      .window-dots {

        display: none;

      }


      .tool-name {

        font-size: 12px;

      }


      .secure {

        font-size: 10px;

      }


      .stats-grid {

        grid-template-columns:
          1fr 1fr;

        padding:
          0 16px 16px;

      }


      .stat {

        align-items: flex-start;

        flex-direction: column;

      }


      .security-note {

        margin:
          0 16px 16px;

      }


      .main-preview {

        align-items: flex-start;

      }


      .preview-color {

        width: 65px;
        height: 65px;

        flex-basis: 65px;

      }


      .preview-info strong {

        font-size: 18px;

      }


      .color-input-row {

        gap: 7px;

      }


      .color-preview {

        width: 45px;
        height: 45px;

        flex-basis: 45px;

      }


      #colorInput {

        height: 45px;

        font-size: 12px;

      }

    }

  </style>

</body>
</html>
