---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Color Converter - محول الألوان أونلاين مجاناً | Th.Tech";

const description =
  "أداة Color Converter مجانية لتحويل الألوان بين HEX وRGB وHSL وHSV، مع معاينة اللون ونسخ القيم مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو Color Converter؟",
    a: "Color Converter هي أداة تساعد المطورين والمصممين على تحويل قيم الألوان بين أنظمة HEX وRGB وHSL وHSV بسهولة."
  },
  {
    q: "ما الفرق بين HEX وRGB؟",
    a: "HEX يمثل اللون باستخدام ستة أحرف أو أرقام hexadecimal، بينما RGB يمثل اللون من خلال قيم الأحمر والأخضر والأزرق."
  },
  {
    q: "هل يمكنني نسخ جميع قيم اللون؟",
    a: "نعم. يمكنك نسخ قيمة HEX أو RGB أو HSL أو HSV بشكل منفصل، كما يمكنك نسخ جميع القيم دفعة واحدة."
  },
  {
    q: "هل تتم معالجة الألوان داخل المتصفح؟",
    a: "نعم. جميع عمليات التحويل والحساب تتم محلياً داخل المتصفح باستخدام JavaScript ولا يتم إرسال اللون إلى خادم خارجي."
  }
];
