---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "CSS Color Generator - مولد ألوان CSS أونلاين | Th.Tech";
const description =
  "مولد ألوان CSS مجاني لإنشاء الألوان واختيارها وتحويلها إلى HEX وRGB وHSL وHSLA وCSS بسهولة.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>CSS Color Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-palette"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              CSS Tools
            </span>

            <h1>
              CSS Color <span>Generator</span>
            </h1>

            <p>
              أنشئ الألوان واخترها بسهولة واحصل على قيم HEX وRGB وHSL
              وكود CSS الجاهز للاستخدام في مشاريعك.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-palette"></i>
              <span>CSS Color Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="randomBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-shuffle"></i>
                لون عشوائي
              </button>

              <button
                id="resetBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-rotate-left"></i>
                إعادة
              </button>

            </div>

          </div>


          <!-- Color Preview -->

          <div class="color-preview">

            <div
              id="colorPreview"
              class="preview-box"
            ></div>

            <div class="preview-content">

              <span class="preview-label">
                اللون الحالي
              </span>

              <strong id="previewHex">
                #2563EB
              </strong>

            </div>

          </div>


          <!-- Controls -->

          <div class="controls-grid">

            <div class="control-card">

              <div class="control-header">

                <label for="colorPicker">
                  <i class="fas fa-eye-dropper"></i>
                  اختيار اللون
                </label>

                <span id="pickerValue">
                  #2563EB
                </span>

              </div>

              <input
                id="colorPicker"
                class="color-picker"
                type="color"
                value="#2563EB"
              />

            </div>


            <div class="control-card">

              <div class="control-header">

                <label for="alphaRange">
                  <i class="fas fa-droplet"></i>
                  الشفافية
                </label>

                <span id="alphaValue">
                  100%
                </span>

              </div>

              <input
                id="alphaRange"
                class="range"
                type="range"
                min="0"
                max="100"
                value="100"
              />

            </div>

          </div>


          <!-- Color Values -->

          <div class="values-section">

            <div class="section-title">
              <i class="fas fa-code"></i>
              قيم اللون
            </div>


            <div class="value-grid">

              <!-- HEX -->

              <div class="value-card">

                <div class="value-top">

                  <span>
                    <i class="fas fa-hashtag"></i>
                    HEX
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="hex"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="hexValue"
                  class="value-text"
                >
                  #2563EB
                </div>

              </div>


              <!-- RGB -->

              <div class="value-card">

                <div class="value-top">

                  <span>
                    <i class="fas fa-sliders"></i>
                    RGB
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="rgb"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="rgbValue"
                  class="value-text"
                >
                  rgb(37, 99, 235)
                </div>

              </div>


              <!-- RGBA -->

              <div class="value-card">

                <div class="value-top">

                  <span>
                    <i class="fas fa-circle-half-stroke"></i>
                    RGBA
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="rgba"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="rgbaValue"
                  class="value-text"
                >
                  rgba(37, 99, 235, 1)
                </div>

              </div>


              <!-- HSL -->

              <div class="value-card">

                <div class="value-top">

                  <span>
                    <i class="fas fa-chart-pie"></i>
                    HSL
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="hsl"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="hslValue"
                  class="value-text"
                >
                  hsl(217, 83%, 53%)
                </div>

              </div>


              <!-- HSLA -->

              <div class="value-card">

                <div class="value-top">

                  <span>
                    <i class="fas fa-adjust"></i>
                    HSLA
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="hsla"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="hslaValue"
                  class="value-text"
                >
                  hsla(217, 83%, 53%, 1)
                </div>

              </div>


              <!-- CSS -->

              <div class="value-card featured">

                <div class="value-top">

                  <span>
                    <i class="fab fa-css3-alt"></i>
                    CSS
                  </span>

                  <button
                    type="button"
                    class="copy-value"
                    data-copy="css"
                    title="نسخ"
                  >
                    <i class="fas fa-copy"></i>
                  </button>

                </div>

                <div
                  id="cssValue"
                  class="value-text"
                >
                  color: #2563EB;
                </div>

              </div>

            </div>

          </div>


          <!-- Color Sliders -->

          <div class="sliders-section">

            <div class="section-title">
              <i class="fas fa-sliders"></i>
              ضبط اللون
            </div>


            <div class="slider-item">

              <div class="slider-label">

                <span>
                  <i class="fas fa-fire"></i>
                  الأحمر Red
                </span>

                <strong id="redValue">37</strong>

              </div>

              <input
                id="redRange"
                class="channel-range red-range"
                type="range"
                min="0"
                max="255"
                value="37"
              />

            </div>


            <div class="slider-item">

              <div class="slider-label">

                <span>
                  <i class="fas fa-leaf"></i>
                  الأخضر Green
                </span>

                <strong id="greenValue">99</strong>

              </div>

              <input
                id="greenRange"
                class="channel-range green-range"
                type="range"
                min="0"
                max="255"
                value="99"
              />

            </div>


            <div class="slider-item">

              <div class="slider-label">

                <span>
                  <i class="fas fa-droplet"></i>
                  الأزرق Blue
                </span>

                <strong id="blueValue">235</strong>

              </div>

              <input
                id="blueRange"
                class="channel-range blue-range"
                type="range"
                min="0"
                max="255"
                value="235"
              />

            </div>

          </div>


          <!-- Status -->

          <div
            id="status"
            class="status hidden"
          >

            <i
              id="statusIcon"
              class="fas fa-check-circle"
            ></i>

            <span id="statusText"></span>

          </div>


          <!-- Main Action -->

          <div class="main-actions">

            <button
              id="copyCssBtn"
              class="main-btn"
              type="button"
            >
              <i class="fas fa-copy"></i>
              نسخ كود CSS
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>إنشاء سريع</h3>

              <p>
                اختر اللون وعدّل قيم RGB والشفافية وشاهد النتيجة فوراً.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>

              <h3>قيم متعددة</h3>

              <p>
                احصل على HEX وRGB وRGBA وHSL وHSLA وكود CSS جاهز.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>يعمل محلياً</h3>

              <p>
                جميع عمليات إنشاء اللون تتم داخل المتصفح بدون إرسال بيانات.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>CSS Color Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-eye-dropper"></i>
              </div>

              <h3>اختر اللون</h3>

              <p>
                استخدم أداة اختيار اللون للوصول إلى اللون المطلوب.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-sliders"></i>
              </div>

              <h3>اضبط القيم</h3>

              <p>
                عدّل الأحمر والأخضر والأزرق والشفافية حسب حاجتك.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>انسخ الكود</h3>

              <p>
                انسخ قيمة اللون أو كود CSS واستخدمه مباشرة في مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>CSS Color Generator</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو CSS Color Generator؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                أداة تساعد المطورين والمصممين على إنشاء الألوان
                والحصول على قيمها بصيغ CSS المختلفة مثل HEX وRGB وHSL.
              </p>

            </details>


            <details>

              <summary>
                ما الفرق بين HEX وRGB؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                HEX يمثل اللون باستخدام قيمة سداسية عشرية،
                بينما RGB يستخدم ثلاث قيم تمثل الأحمر والأخضر والأزرق.
              </p>

            </details>


            <details>

              <summary>
                ما هي صيغة RGBA؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                RGBA هي صيغة RGB مضافاً إليها معامل Alpha للتحكم
                في شفافية اللون.
              </p>

            </details>


            <details>

              <summary>
                هل يمكن استخدام الألوان مباشرة في CSS؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                نعم. يمكنك نسخ كود CSS الناتج ولصقه مباشرة
                داخل ملفات CSS أو داخل عناصر HTML.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* ================= HERO ================= */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);
      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 720px;
      margin: 0;

      color: var(--muted);
      font-size: .92rem;
    }


    /* ================= TOOL ================= */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);
      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(37, 99, 235, .35);
      color: var(--primary);
      transform: translateY(-2px);
    }


    /* ================= PREVIEW ================= */

    .color-preview {
      display: grid;
      grid-template-columns: 1fr 220px;

      min-height: 180px;

      margin: 20px;

      overflow: hidden;

      border-radius: 18px;

      border: 1px solid var(--border);
      background: var(--card2);
    }


    .preview-box {
      min-height: 180px;
      background: #2563eb;
      transition: background .2s ease;
    }


    .preview-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      padding: 25px;

      background: var(--card);
    }


    .preview-label {
      color: var(--muted);
      font-size: .72rem;
      margin-bottom: 7px;
    }


    .preview-content strong {
      direction: ltr;

      color: var(--text);

      font-family: Consolas, monospace;

      font-size: 1.25rem;
      font-weight: 800;
    }


    /* ================= CONTROLS ================= */

    .controls-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 18px;

      padding: 0 20px 20px;
    }


    .control-card {
      padding: 20px;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .control-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 15px;

      font-size: .78rem;
      font-weight: 700;
    }


    .control-header label {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .control-header label i {
      color: var(--primary);
    }


    .control-header span {
      direction: ltr;
      color: var(--primary);

      font-family: Consolas, monospace;
      font-weight: 800;
    }


    .color-picker {
      width: 100%;
      height: 55px;

      padding: 5px;

      border: 1px solid var(--border);

      border-radius: 12px;

      background: var(--card);

      cursor: pointer;
    }


    .range,
    .channel-range {
      width: 100%;
      height: 7px;

      appearance: none;

      border-radius: 20px;

      background: #dbe4ef;

      outline: none;

      cursor: pointer;
    }


    html.dark-mode .range,
    html.dark-mode .channel-range {
      background: #26354c;
    }


    .range::-webkit-slider-thumb,
    .channel-range::-webkit-slider-thumb {
      appearance: none;

      width: 20px;
      height: 20px;

      border-radius: 50%;

      background: var(--primary);

      border: 3px solid var(--card);

      box-shadow: 0 2px 7px rgba(0, 0, 0, .18);

      cursor: pointer;
    }


    .range::-moz-range-thumb,
    .channel-range::-moz-range-thumb {
      width: 20px;
      height: 20px;

      border-radius: 50%;

      background: var(--primary);

      border: 3px solid var(--card);

      cursor: pointer;
    }


    /* ================= VALUES ================= */

    .values-section,
    .sliders-section {
      padding: 20px;

      border-top: 1px solid var(--border);
    }


    .section-title {
      display: flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 15px;

      font-size: .85rem;
      font-weight: 800;
    }


    .section-title i {
      color: var(--primary);
    }


    .value-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 12px;
    }


    .value-card {
      min-width: 0;

      padding: 15px;

      border-radius: 14px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .value-card.featured {
      border-color: rgba(37, 99, 235, .25);

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, .07),
          var(--card2)
        );
    }


    .value-top {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 9px;

      color: var(--muted);

      font-size: .7rem;
      font-weight: 700;
    }


    .value-top span {
      display: flex;
      align-items: center;
      gap: 6px;
    }


    .value-top span i {
      color: var(--primary);
    }


    .copy-value {
      width: 30px;
      height: 30px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 8px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--muted);

      cursor: pointer;

      transition: .2s ease;
    }


    .copy-value:hover {
      color: var(--primary);
      border-color: rgba(37, 99, 235, .3);
    }


    .value-text {
      overflow: hidden;

      direction: ltr;
      text-align: left;

      color: var(--text);

      font-family: Consolas, "Courier New", monospace;

      font-size: .76rem;
      font-weight: 700;

      white-space: nowrap;
      text-overflow: ellipsis;
    }


    /* ================= SLIDERS ================= */

    .slider-item {
      padding: 14px 16px;

      margin-bottom: 11px;

      border-radius: 13px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .slider-item:last-child {
      margin-bottom: 0;
    }


    .slider-label {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 12px;

      color: var(--muted);

      font-size: .75rem;
      font-weight: 700;
    }


    .slider-label span {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .slider-label span i {
      color: var(--primary);
    }


    .slider-label strong {
      min-width: 35px;

      direction: ltr;
      text-align: center;

      color: var(--text);

      font-family: Consolas, monospace;
    }


    /* ================= STATUS ================= */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);

      border-color: rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* ================= MAIN BUTTON ================= */

    .main-actions {
      display: flex;
      justify-content: center;

      padding: 0 20px 20px;
    }


    .main-btn {
      min-width: 240px;
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 10px;

      border: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #3b82f6,
          #2563eb
        );

      color: white;

      font-family: inherit;

      font-size: .9rem;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(37, 99, 235, .22);

      transition: .25s ease;
    }


    .main-btn:hover {
      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(37, 99, 235, .30);
    }


    /* ================= INFO ================= */

    .info-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color: rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background: rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;
    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size: clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* ================= STEPS ================= */

    .steps {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background: rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .color-preview {
        grid-template-columns: 1fr;

        min-height: auto;
      }


      .preview-box {
        min-height: 180px;
      }


      .preview-content {
        min-height: 100px;
      }


      .controls-grid {
        grid-template-columns: 1fr;
      }


      .value-grid {
        grid-template-columns: 1fr 1fr;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.7rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .color-preview {
        margin: 12px;
      }


      .controls-grid {
        padding: 0 12px 12px;

        gap: 12px;
      }


      .control-card {
        padding: 16px;
      }


      .values-section,
      .sliders-section {
        padding: 15px 12px;
      }


      .value-grid {
        grid-template-columns: 1fr;
      }


      .main-btn {
        width: 100%;

        min-width: 0;
      }


      .main-actions {
        padding: 0 12px 12px;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme = event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {
            applyTheme(theme === 'dark');
          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      /* ================= ELEMENTS ================= */

      const colorPicker =
        document.getElementById('colorPicker');

      const alphaRange =
        document.getElementById('alphaRange');

      const redRange =
        document.getElementById('redRange');

      const greenRange =
        document.getElementById('greenRange');

      const blueRange =
        document.getElementById('blueRange');

      const colorPreview =
        document.getElementById('colorPreview');

      const previewHex =
        document.getElementById('previewHex');

      const pickerValue =
        document.getElementById('pickerValue');

      const alphaValue =
        document.getElementById('alphaValue');

      const redValue =
        document.getElementById('redValue');

      const greenValue =
        document.getElementById('greenValue');

      const blueValue =
        document.getElementById('blueValue');

      const hexValue =
        document.getElementById('hexValue');

      const rgbValue =
        document.getElementById('rgbValue');

      const rgbaValue =
        document.getElementById('rgbaValue');

      const hslValue =
        document.getElementById('hslValue');

      const hslaValue =
        document.getElementById('hslaValue');

      const cssValue =
        document.getElementById('cssValue');

      const randomBtn =
        document.getElementById('randomBtn');

      const resetBtn =
        document.getElementById('resetBtn');

      const copyCssBtn =
        document.getElementById('copyCssBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');


      /* ================= COLOR ================= */

      const hexToRgb = (hex) => {

        const clean =
          hex.replace('#', '');

        const full =
          clean.length === 3
            ? clean
                .split('')
                .map((char) => char + char)
                .join('')
            : clean;

        return {
          r: parseInt(
            full.substring(0, 2),
            16
          ),

          g: parseInt(
            full.substring(2, 4),
            16
          ),

          b: parseInt(
            full.substring(4, 6),
            16
          )
        };

      };


      const rgbToHex = (
        r,
        g,
        b
      ) => {

        return (
          '#' +
          [r, g, b]
            .map((value) =>
              Number(value)
                .toString(16)
                .padStart(2, '0')
                .toUpperCase()
            )
            .join('')
        );

      };


      const rgbToHsl = (
        r,
        g,
        b
      ) => {

        r /= 255;
        g /= 255;
        b /= 255;

        const max =
          Math.max(r, g, b);

        const min =
          Math.min(r, g, b);

        let h = 0;
        let s = 0;

        const l =
          (max + min) / 2;

        const d =
          max - min;

        if (d !== 0) {

          s =
            l > 0.5
              ? d /
                (2 - max - min)
              : d /
                (max + min);

          switch (max) {

            case r:

              h =
                (g - b) /
                  d +
                (g < b ? 6 : 0);

              break;

            case g:

              h =
                (b - r) /
                  d +
                2;

              break;

            case b:

              h =
                (r - g) /
                  d +
                4;

              break;

          }

          h /= 6;

        }


        return {
          h: Math.round(h * 360),

          s: Math.round(s * 100),

          l: Math.round(l * 100)
        };

      };


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      /* ================= UPDATE ================= */

      const updateColor = (
        hex
      ) => {

        const rgb =
          hexToRgb(hex);

        const alpha =
          Number(alphaRange.value) / 100;

        const hsl =
          rgbToHsl(
            rgb.r,
            rgb.g,
            rgb.b
          );


        const rgbText =
          `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;

        const rgbaText =
          `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')})`;

        const hslText =
          `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;

        const hslaText =
          `hsla(${hsl.h}, ${hsl.s}%, ${hsl.l}%, ${alpha.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')})`;

        const cssText =
          alpha < 1
            ? `background-color: ${rgbaText};`
            : `background-color: ${hex};`;


        colorPreview.style.background =
          rgbaText;

        previewHex.textContent =
          hex;

        pickerValue.textContent =
          hex;

        alphaValue.textContent =
          `${alphaRange.value}%`;

        redValue.textContent =
          rgb.r;

        greenValue.textContent =
          rgb.g;

        blueValue.textContent =
          rgb.b;

        hexValue.textContent =
          hex;

        rgbValue.textContent =
          rgbText;

        rgbaValue.textContent =
          rgbaText;

        hslValue.textContent =
          hslText;

        hslaValue.textContent =
          hslaText;

        cssValue.textContent =
          cssText;

      };


      const updateFromRgb =
        () => {

          const r =
            Number(redRange.value);

          const g =
            Number(greenRange.value);

          const b =
            Number(blueRange.value);

          const hex =
            rgbToHex(r, g, b);

          colorPicker.value =
            hex;

          updateColor(hex);

        };


      const syncRgbFromPicker =
        () => {

          const rgb =
            hexToRgb(
              colorPicker.value
            );

          redRange.value =
            rgb.r;

          greenRange.value =
            rgb.g;

          blueRange.value =
            rgb.b;

          updateColor(
            colorPicker.value.toUpperCase()
          );

        };


      /* ================= RANDOM ================= */

      const randomColor = () => {

        const r =
          Math.floor(
            Math.random() * 256
          );

        const g =
          Math.floor(
            Math.random() * 256
          );

        const b =
          Math.floor(
            Math.random() * 256
          );

        redRange.value = r;
        greenRange.value = g;
        blueRange.value = b;

        alphaRange.value = 100;

        updateFromRgb();

        showStatus(
          'تم إنشاء لون عشوائي بنجاح.'
        );

      };


      /* ================= RESET ================= */

      const resetColor = () => {

        const hex =
          '#2563EB';

        colorPicker.value =
          hex;

        alphaRange.value =
          100;

        const rgb =
          hexToRgb(hex);

        redRange.value =
          rgb.r;

        greenRange.value =
          rgb.g;

        blueRange.value =
          rgb.b;

        updateColor(hex);

        showStatus(
          'تمت إعادة اللون الافتراضي.'
        );

      };


      /* ================= COPY ================= */

      const copyText = async (
        text,
        button
      ) => {

        if (!text) {
          return;
        }


        try {

          await navigator.clipboard.writeText(
            text
          );

        } catch {

          const temp =
            document.createElement(
              'textarea'
            );

          temp.value = text;

          temp.style.position =
            'fixed';

          temp.style.opacity =
            '0';

          document.body.appendChild(
            temp
          );

          temp.select();

          document.execCommand(
            'copy'
          );

          temp.remove();

        }


        const original =
          button.innerHTML;

        button.innerHTML =
          '<i class="fas fa-check"></i>';

        showStatus(
          'تم نسخ قيمة اللون بنجاح.'
        );

        setTimeout(() => {

          button.innerHTML =
            original;

        }, 1500);

      };


      /* ================= EVENTS ================= */

      colorPicker.addEventListener(
        'input',
        syncRgbFromPicker
      );


      alphaRange.addEventListener(
        'input',
        () => {

          updateColor(
            colorPicker.value.toUpperCase()
          );

        }
      );


      redRange.addEventListener(
        'input',
        updateFromRgb
      );


      greenRange.addEventListener(
        'input',
        updateFromRgb
      );


      blueRange.addEventListener(
        'input',
        updateFromRgb
      );


      randomBtn.addEventListener(
        'click',
        randomColor
      );


      resetBtn.addEventListener(
        'click',
        resetColor
      );


      copyCssBtn.addEventListener(
        'click',
        () => {

          copyText(
            cssValue.textContent,
            copyCssBtn
          );

        }
      );


      document
        .querySelectorAll('.copy-value')
        .forEach((button) => {

          button.addEventListener(
            'click',
            () => {

              const type =
                button.dataset.copy;

              const values = {
                hex: hexValue.textContent,
                rgb: rgbValue.textContent,
                rgba: rgbaValue.textContent,
                hsl: hslValue.textContent,
                hsla: hslaValue.textContent,
                css: cssValue.textContent
              };

              copyText(
                values[type],
                button
              );

            }
          );

        });


      /* ================= INITIAL ================= */

      syncRgbFromPicker();

    })();
  </script>

</body>
</html>
