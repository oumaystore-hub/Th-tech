---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "YAML Formatter - تنسيق YAML أونلاين مجاناً | Th.Tech";
const description =
  "أداة YAML Formatter مجانية لتنسيق وترتيب YAML والتحقق من بنيته ونسخه مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة YAML Formatter؟",
    a: "YAML Formatter هي أداة مجانية تساعدك على تنسيق وترتيب ملفات YAML بطريقة واضحة وسهلة القراءة مباشرة من المتصفح."
  },
  {
    q: "هل يتم إرسال YAML إلى الخادم؟",
    a: "لا. تتم عملية التنسيق داخل المتصفح، لذلك لا تحتاج إلى إرسال بيانات YAML إلى خادم خارجي."
  },
  {
    q: "هل يمكنني استخدام الأداة مع ملفات YAML كبيرة؟",
    a: "نعم، ويمكن استخدامها مع ملفات YAML كبيرة نسبياً، لكن الأداء يعتمد على حجم البيانات وإمكانيات المتصفح."
  },
  {
    q: "هل تقوم الأداة بالتحقق من صحة YAML؟",
    a: "نعم، تحتوي الأداة على فحص أساسي للبنية والمسافات والاقتباسات والقيم الشائعة، لكنها ليست بديلاً عن محلل YAML متخصص لكل لهجات YAML."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#7c3aed" />

  <link rel="icon" href={`${base}/favicon.svg`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>

          <span>YAML Formatter</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">

            <div class="icon-glow"></div>

            <i class="fa-solid fa-file-code"></i>

            <span class="mini-icon">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </span>

          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>
              YAML Formatter
              <span>منسق YAML</span>
            </h1>

            <p>
              نسّق ملفات YAML ورتبها وحسّن قابليتها للقراءة
              مع فحص أساسي للبنية مباشرة من المتصفح.
            </p>

            <div class="hero-features">

              <span>
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                تنسيق سريع
              </span>

              <span>
                <i class="fa-solid fa-bolt"></i>
                فوري
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                يعمل محلياً
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- TOOL -->
    <section class="tool-section">

      <div class="container">

        <div class="formatter-card">

          <!-- TOPBAR -->
          <div class="card-topbar">

            <div class="topbar-title">

              <div class="yaml-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>

              <div>
                <strong>YAML Formatter</strong>
                <small>تنسيق وترتيب YAML</small>
              </div>

            </div>

            <div class="status">

              <span
                id="statusDot"
                class="status-dot"
              ></span>

              <span id="statusText">
                جاهز
              </span>

            </div>

          </div>


          <!-- ACTIONBAR -->
          <div class="actionbar">

            <div class="action-group">

              <button
                id="exampleBtn"
                class="btn btn-example"
              >
                <i class="fa-solid fa-flask"></i>
                مثال
              </button>

              <button
                id="clearBtn"
                class="btn btn-clear"
              >
                <i class="fa-solid fa-eraser"></i>
                مسح
              </button>

            </div>

            <div class="action-group">

              <button
                id="copyBtn"
                class="btn btn-copy"
              >
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

              <button
                id="formatBtn"
                class="btn btn-format"
              >
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                تنسيق YAML
              </button>

            </div>

          </div>


          <!-- WORKSPACE -->
          <div class="workspace">

            <!-- INPUT -->
            <div class="editor-panel">

              <div class="panel-header">

                <div class="panel-title">

                  <span class="panel-dot"></span>

                  <div>
                    <strong>YAML Input</strong>
                    <small>أدخل YAML</small>
                  </div>

                </div>

                <span class="language-badge">
                  YAML
                </span>

              </div>


              <div class="editor">

                <div
                  id="lineNumbers"
                  class="line-numbers"
                >1</div>

                <textarea
                  id="yamlInput"
                  spellcheck="false"
                  autocomplete="off"
                  placeholder="name: Th.Tech&#10;version: 1.0.0&#10;tools:&#10;  - JSON Formatter&#10;  - YAML Formatter"
                ></textarea>

              </div>


              <div class="editor-footer">

                <span>
                  <i class="fa-solid fa-code"></i>
                  YAML
                </span>

                <span id="inputStats">
                  0 سطر · 0 حرف
                </span>

              </div>

            </div>


            <!-- OUTPUT -->
            <div class="editor-panel output-panel">

              <div class="panel-header">

                <div class="panel-title">

                  <span class="panel-dot output-dot"></span>

                  <div>
                    <strong>Formatted YAML</strong>
                    <small>النتيجة المنسقة</small>
                  </div>

                </div>

                <span
                  id="outputBadge"
                  class="language-badge"
                >
                  READY
                </span>

              </div>


              <div class="editor">

                <div
                  id="outputLines"
                  class="line-numbers"
                >1</div>

                <textarea
                  id="yamlOutput"
                  spellcheck="false"
                  readonly
                  placeholder="ستظهر YAML المنسقة هنا..."
                ></textarea>

              </div>


              <div class="editor-footer">

                <span>
                  <i class="fa-solid fa-check-double"></i>
                  Output
                </span>

                <span id="outputStats">
                  0 سطر · 0 حرف
                </span>

              </div>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-bar">

            <div
              id="resultBox"
              class="result-box neutral"
            >

              <div
                id="resultIcon"
                class="result-icon"
              >
                <i class="fa-solid fa-circle-info"></i>
              </div>

              <div>

                <strong id="resultTitle">
                  جاهز للتنسيق
                </strong>

                <p id="resultMessage">
                  أدخل YAML ثم اضغط على «تنسيق YAML».
                </p>

              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats">

            <div class="stat">

              <div class="stat-icon purple">
                <i class="fa-solid fa-align-left"></i>
              </div>

              <div>
                <strong id="statLines">0</strong>
                <span>الأسطر</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon blue">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <strong id="statChars">0</strong>
                <span>الأحرف</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon orange">
                <i class="fa-solid fa-list"></i>
              </div>

              <div>
                <strong id="statKeys">0</strong>
                <span>المفاتيح</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon green">
                <i class="fa-solid fa-shield-check"></i>
              </div>

              <div>
                <strong id="statStatus">—</strong>
                <span>الحالة</span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- INFO -->
    <section class="info-section">

      <div class="container">

        <div class="section-heading">

          <span>YAML FORMATTER</span>

          <h2>
            YAML أوضح وأسهل للقراءة
          </h2>

          <p>
            نظّم ملفات YAML الخاصة بك بسرعة دون الحاجة إلى تثبيت برنامج.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon purple-icon">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>

            <h3>
              تنسيق تلقائي
            </h3>

            <p>
              إعادة تنظيم المسافات والمسافات البادئة
              لجعل YAML أكثر وضوحاً.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon blue-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>
              مناسب للمطورين
            </h3>

            <p>
              محرر بسيط ومريح للعمل مع ملفات الإعدادات
              وملفات YAML البرمجية.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon green-icon">
              <i class="fa-solid fa-lock"></i>
            </div>

            <h3>
              خصوصية البيانات
            </h3>

            <p>
              تتم المعالجة داخل المتصفح ولا يتم رفع محتوى
              YAML إلى خادم خارجي.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="how-section">

      <div class="container">

        <div class="section-heading">

          <span>طريقة الاستخدام</span>

          <h2>
            كيف تستخدم YAML Formatter؟
          </h2>

          <p>
            ثلاث خطوات بسيطة للحصول على YAML منسقة.
          </p>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-paste"></i>
            </div>

            <h3>
              أدخل YAML
            </h3>

            <p>
              الصق أو اكتب محتوى YAML داخل محرر الإدخال.
            </p>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>

            <h3>
              نسّق
            </h3>

            <p>
              اضغط على زر تنسيق YAML لمعالجة المحتوى.
            </p>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div class="step-icon">
              <i class="fa-solid fa-copy"></i>
            </div>

            <h3>
              انسخ النتيجة
            </h3>

            <p>
              انسخ YAML المنسقة واستخدمها في مشروعك.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

          <p>
            كل ما تحتاج معرفته عن YAML Formatter.
          </p>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details class="faq-item">

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>

    </section>

  



<!-- TH-RELATED-TOOLS-START -->
<section
