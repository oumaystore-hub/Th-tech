  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

  <Footer />

</body>
</html>


<script is:inline>
  (() => {

    const input =
      document.getElementById("yamlInput");

    const output =
      document.getElementById("yamlOutput");

    const formatBtn =
      document.getElementById("formatBtn");

    const clearBtn =
      document.getElementById("clearBtn");

    const exampleBtn =
      document.getElementById("exampleBtn");

    const copyBtn =
      document.getElementById("copyBtn");

    const lineNumbers =
      document.getElementById("lineNumbers");

    const outputLines =
      document.getElementById("outputLines");

    const inputStats =
      document.getElementById("inputStats");

    const outputStats =
      document.getElementById("outputStats");

    const statusText =
      document.getElementById("statusText");

    const statusDot =
      document.getElementById("statusDot");

    const outputBadge =
      document.getElementById("outputBadge");

    const resultBox =
      document.getElementById("resultBox");

    const resultIcon =
      document.getElementById("resultIcon");

    const resultTitle =
      document.getElementById("resultTitle");

    const resultMessage =
      document.getElementById("resultMessage");

    const statLines =
      document.getElementById("statLines");

    const statChars =
      document.getElementById("statChars");

    const statKeys =
      document.getElementById("statKeys");

    const statStatus =
      document.getElementById("statStatus");


    function updateLineNumbers(
      textarea,
      numbers
    ) {

      const count =
        Math.max(
          1,
          textarea.value.split("\n").length
        );

      numbers.textContent =
        Array.from(
          { length: count },
          (_, index) => index + 1
        ).join("\n");

      return count;
    }


    function updateStats() {

      const value =
        input.value;

      const lines =
        updateLineNumbers(
          input,
          lineNumbers
        );

      inputStats.textContent =
        `${lines} سطر · ${value.length} حرف`;

      statLines.textContent =
        value.trim()
          ? lines
          : 0;

      statChars.textContent =
        value.length;

    }


    function updateOutputStats() {

      const value =
        output.value;

      const lines =
        updateLineNumbers(
          output,
          outputLines
        );

      outputStats.textContent =
        `${value.trim() ? lines : 0} سطر · ${value.length} حرف`;

    }


    function setStatus(
      text,
      type
    ) {

      statusText.textContent =
        text;

      statusDot.className =
        "status-dot";

      if (type) {
        statusDot.classList.add(type);
      }

    }


    function setResult(
      type,
      title,
      message
    ) {

      resultBox.className =
        `result-box ${type}`;

      if (type === "success") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-check"></i>`;

      } else if (type === "error") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-xmark"></i>`;

      } else if (type === "warning") {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-triangle-exclamation"></i>`;

      } else {

        resultIcon.innerHTML =
          `<i class="fa-solid fa-circle-info"></i>`;
      }

      resultTitle.textContent =
        title;

      resultMessage.textContent =
        message;

    }


    function stripComments(
      line
    ) {

      let quote = null;

      for (
        let i = 0;
        i < line.length;
        i++
      ) {

        const char =
          line[i];

        if (
          quote &&
          char === quote
        ) {

          if (
            line[i - 1] !== "\\"
          ) {
            quote = null;
          }

          continue;
        }

        if (
          !quote &&
          (
            char === "'" ||
            char === '"'
          )
        ) {

          quote = char;
          continue;
        }

        if (
          !quote &&
          char === "#"
        ) {

          if (
            i === 0 ||
            /\s/.test(line[i - 1])
          ) {

            return line
              .slice(0, i)
              .trimEnd();
          }

        }

      }

      return line;
    }


    function countIndent(
      line
    ) {

      let count = 0;

      for (
        let i = 0;
        i < line.length;
        i++
      ) {

        if (line[i] === " ") {
          count++;
        } else {
          break;
        }

      }

      return count;
    }


    function formatYAML(
      source
    ) {

      const rawLines =
        source.replace(
          /\r\n/g,
          "\n"
        ).split("\n");


      const cleaned =
        [];

      let previousIndent = 0;

      let pendingBlank = false;


      for (
        let index = 0;
        index < rawLines.length;
        index++
      ) {

        let line =
          rawLines[index]
            .replace(/\t/g, "  ");


        line =
          stripComments(line);


        if (
          !line.trim()
        ) {

          pendingBlank = true;
          continue;
        }


        let indent =
          countIndent(line);

        let content =
          line.trim();


        if (
          content.startsWith("-")
        ) {

          content =
            content.replace(
              /^-\s*/,
              "- "
            );

        }


        if (
          content.includes(":")
        ) {

          const colon =
            content.indexOf(":");

          const key =
            content
              .slice(0, colon)
              .trim();

          const value =
            content
              .slice(colon + 1)
              .trim();

          if (
            key &&
            !key.startsWith("-")
          ) {

            content =
              `${key}: ${value}`;

          }

        }


        if (
          pendingBlank &&
          cleaned.length > 0 &&
          indent > previousIndent
        ) {

          cleaned.push("");

        }

        pendingBlank = false;


        cleaned.push(
          " ".repeat(indent) +
          content
        );

        previousIndent =
          indent;

      }


      return cleaned.join("\n").trim();

    }


    function validateStructure(
      source
    ) {

      const issues = [];

      const lines =
        source
          .replace(/\r\n/g, "\n")
          .split("\n");


      let previousIndent = 0;

      const stack = [];


      lines.forEach(
        (originalLine, index) => {

          const line =
            originalLine.replace(
              /\t/g,
              "  "
            );

          const trimmed =
            line.trim();

          if (!trimmed) {
            return;
          }


          if (
            trimmed.startsWith("---") ||
            trimmed.startsWith("...")
          ) {
            return;
          }


          const indent =
            countIndent(line);


          if (
            indent % 2 !== 0
          ) {

            issues.push(
              `السطر ${index + 1}: المسافة البادئة يفضل أن تكون بمضاعفات 2.`
            );

          }


          if (
            indent > previousIndent + 2
          ) {

            issues.push(
              `السطر ${index + 1}: زيادة كبيرة في المسافة البادئة.`
            );

          }


          if (
            trimmed.startsWith("-") &&
            trimmed.length === 1
          ) {

            issues.push(
              `السطر ${index + 1}: عنصر القائمة فارغ.`
            );

          }


          if (
            !trimmed.startsWith("-") &&
            !trimmed.includes(":") &&
            !trimmed.startsWith("#")
          ) {

            const isScalar =
              /^["'].*["']$/.test(
                trimmed
              ) ||
              /^(true|false|null|~|-?\d+(\.\d+)?)$/i.test(
                trimmed
              );

            if (!isScalar) {

              issues.push(
                `السطر ${index + 1}: قد تكون البنية غير مكتملة.`
              );

            }

          }


          previousIndent =
            indent;

        }
      );


      return issues;

    }


    function countKeys(
      source
    ) {

      let count = 0;

      const lines =
        source.split("\n");

      lines.forEach(
        (line) => {

          const trimmed =
            line.trim();

          if (
            !trimmed ||
            trimmed.startsWith("#") ||
            trimmed.startsWith("-")
          ) {
            return;
          }

          if (
            /^[^:#][^:]*:\s*(.*)$/.test(
              trimmed
            )
          ) {
            count++;
          }

        }
      );

      return count;

    }


    function format() {

      const source =
        input.value;


      if (!source.trim()) {

        output.value = "";

        updateOutputStats();

        setStatus(
          "لا يوجد محتوى",
          "warning"
        );

        outputBadge.textContent =
          "EMPTY";

        statStatus.textContent =
          "فارغ";

        setResult(
          "warning",
          "المحرر فارغ",
          "أدخل محتوى YAML أولاً ثم اضغط على زر التنسيق."
        );

        return;

      }


      setStatus(
        "جارٍ التنسيق...",
        "processing"
      );


      setTimeout(() => {

        const issues =
          validateStructure(source);

        const formatted =
          formatYAML(source);


        output.value =
          formatted;


        updateOutputStats();


        const keys =
          countKeys(formatted);

        statKeys.textContent =
          keys;


        if (issues.length === 0) {

          setStatus(
            "تم التنسيق",
            "success"
          );

          outputBadge.textContent =
            "VALID";

          outputBadge.className =
            "language-badge valid";

          statStatus.textContent =
            "صالح";

          setResult(
            "success",
            "تم تنسيق YAML بنجاح",
            "تم ترتيب المحتوى وتحسين المسافات البادئة بنجاح."
          );

        } else {

          setStatus(
            `${issues.length} تنبيه`,
            "warning"
          );

          outputBadge.textContent =
            "CHECK";

          outputBadge.className =
            "language-badge warning";

          statStatus.textContent =
            "تنبيه";

          setResult(
            "warning",
            "تم التنسيق مع بعض التنبيهات",
            issues.slice(0, 2).join(" ")
          );

        }

      }, 80);

    }


    function loadExample() {

      input.value =
`name: Th.Tech
version: "1.0.0"
description: "Developer tools platform"
settings:
  theme: dark
  language: ar
  editor:
    fontSize: 14
    tabSize: 2
tools:
  - name: JSON Formatter
    slug: json-formatter
    category: JSON
  - name: YAML Formatter
    slug: yaml-formatter
    category: YAML
database:
  host: localhost
  port: 3306
  enabled: true`;


      updateStats();

      format();

      input.focus();

    }


    function clearAll() {

      input.value = "";
      output.value = "";

      updateStats();
      updateOutputStats();

      statKeys.textContent =
        "0";

      statStatus.textContent =
        "—";

      outputBadge.textContent =
        "READY";

      outputBadge.className =
        "language-badge";

      setStatus(
        "جاهز",
        ""
      );

      setResult(
        "neutral",
        "جاهز للتنسيق",
        "أدخل YAML ثم اضغط على «تنسيق YAML»."
      );

    }


    async function copyOutput() {

      if (!output.value.trim()) {

        setStatus(
          "لا توجد نتيجة للنسخ",
          "warning"
        );

        return;

      }


      try {

        await navigator.clipboard.writeText(
          output.value
        );


        const old =
          copyBtn.innerHTML;


        copyBtn.innerHTML =
          `<i class="fa-solid fa-check"></i> تم النسخ`;


        setStatus(
          "تم النسخ",
          "success"
        );


        setTimeout(() => {

          copyBtn.innerHTML =
            old;

          setStatus(
            "تم التنسيق",
            "success"
          );

        }, 1500);


      } catch {

        output.select();

        document.execCommand(
          "copy"
        );

        setStatus(
          "تم النسخ",
          "success"
        );

      }

    }


    input.addEventListener(
      "input",
      updateStats
    );


    input.addEventListener(
      "scroll",
      () => {

        lineNumbers.scrollTop =
          input.scrollTop;

      }
    );


    output.addEventListener(
      "scroll",
      () => {

        outputLines.scrollTop =
          output.scrollTop;

      }
    );


    input.addEventListener(
      "keydown",
      (event) => {

        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {

          event.preventDefault();

          format();

        }


        if (
          event.key === "Tab"
        ) {

          event.preventDefault();

          const start =
            input.selectionStart;

          const end =
            input.selectionEnd;


          input.value =
            input.value.substring(
              0,
              start
            ) +
            "  " +
            input.value.substring(
              end
            );


          input.selectionStart =
            input.selectionEnd =
              start + 2;


          updateStats();

        }

      }
    );


    formatBtn.addEventListener(
      "click",
      format
    );


    clearBtn.addEventListener(
      "click",
      clearAll
    );


    exampleBtn.addEventListener(
      "click",
      loadExample
    );


    copyBtn.addEventListener(
      "click",
      copyOutput
    );


    updateStats();
    updateOutputStats();

  })();
</script>


