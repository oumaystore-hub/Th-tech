        42px;

      display:
        flex;

      align-items:
        center;

      color:
        var(--text);

      font-size:
        11px;

      line-height:
        1.7;

      word-break:
        break-word;

    }


    .result-value.mono {

      color:
        var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      direction:
        ltr;

      text-align:
        left;

      word-break:
        break-all;

    }



    /* STATS */

    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        12px;

      padding:
        0 22px 24px;

    }


    .stat {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      padding:
        15px;

      border:
        1px solid
        var(--border);

      border-radius:
        14px;

      background:
        var(--surface-2);

    }


    .stat-icon {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        var(--primary-soft);

      color:
        var(--primary);

    }


    .stat span {

      display:
        block;

      margin-bottom:
        2px;

      color:
        var(--muted);

      font-size:
        9px;

    }


    .stat strong {

      display:
        block;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        10px;

    }



    /* NOTE */

    .security-note {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        13px;

      margin:
        0 22px 22px;

      padding:
        17px;

      border:
        1px solid
        rgba(37,99,235,.12);

      border-radius:
        15px;

      background:
        var(--primary-soft);

    }


    .security-icon {

      width:
        40px;

      height:
        40px;

      flex:
        0 0 40px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        var(--primary-soft);

      color:
        var(--primary);

    }


    .security-note strong {

      display:
        block;

      margin-bottom:
        4px;

      font-size:
        12px;

    }


    .security-note p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.9;

    }



    /* SECTIONS */

    .info-section,
    .how-section,
    .faq-section {

      padding:
        72px 0;

    }


    .info-section,
    .faq-section {

      background:
        var(--surface-2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);

    }


    .section-heading {

      max-width:
        720px;

      margin:
        0 auto 36px;

      text-align:
        center;

    }


    .section-heading > span {

      display:
        block;

      margin-bottom:
        8px;

      color:
        var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        10px;

      font-weight:
        700;

      letter-spacing:
        1px;

    }


    .section-heading h2 {

      margin:
        0 0 10px;

      font-size:
        clamp(
          25px,
          4vw,
          34px
        );

      font-weight:
        800;

    }


    .section-heading p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        13px;

      line-height:
        1.9;

    }



    /* INFO CARDS */

    .info-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;

    }


    .info-card {

      padding:
        27px;

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      border-radius:
        19px;

      transition:
        .25s ease;

    }


    .info-card:hover {

      transform:
        translateY(-5px);

      border-color:
        rgba(37,99,235,.35);

      box-shadow:
        0 18px 45px
        rgba(15,23,42,.07);

    }


    .info-icon {

      width:
        50px;

      height:
        50px;

      display:
        grid;

      place-items:
        center;

      margin-bottom:
        18px;

      border-radius:
        14px;

      background:
        var(--primary-soft);

      color:
        var(--primary);

      font-size:
        18px;

    }


    .info-card h3 {

      margin:
        0 0 8px;

      font-size:
        16px;

    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;

    }



    /* STEPS */

    .steps {

      max-width:
        820px;

      margin:
        0 auto;

      display:
        grid;

      gap:
        14px;

    }


    .step {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        17px;

      padding:
        20px;

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      border-radius:
        16px;

      transition:
        .2s ease;

    }


    .step:hover {

      transform:
        translateX(-3px);

      border-color:
        rgba(37,99,235,.3);

    }


    .step-number {

      width:
        42px;

      height:
        42px;

      flex:
        0 0 42px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        12px;

      color:
        #fff;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );

      font-family:
        "JetBrains Mono",
        monospace;

      font-weight:
        700;

    }


    .step h3 {

      margin:
        0 0 4px;

      font-size:
        14px;

    }


    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.8;

    }



    /* FAQ */

    .faq-list {

      max-width:
        820px;

      margin:
        0 auto;

      display:
        grid;

      gap:
        10px;

    }


    details {

      overflow:
        hidden;

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

    }


    summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding:
        18px 20px;

      cursor:
        pointer;

      list-style:
        none;

      font-size:
        13px;

      font-weight:
        700;

    }


    summary::-webkit-details-marker {
      display:
        none;
    }


    summary i {

      color:
        var(--primary);

      font-size:
        10px;

      transition:
        .2s ease;

    }


    details[open]
    summary i {

      transform:
        rotate(180deg);

    }


    details p {

      margin:
        0;

      padding:
        0 20px 20px;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;

    }



    /* TABLET */

    @media (max-width: 900px) {

      .input-grid {

        grid-template-columns:
          repeat(2, 1fr);

      }


      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);

      }


      .info-grid {

        grid-template-columns:
          1fr;

      }

    }



    /* MOBILE */

    @media (max-width: 650px) {

      .container {

        width:
          calc(100% - 22px);

      }


      .hero {

        padding:
          32px 0 48px;

      }


      .hero-content {

        flex-direction:
          column;

        align-items:
          flex-start;

        gap:
          20px;

      }


      .hero-icon {

        width:
          88px;

        height:
          88px;

        flex-basis:
          88px;

        border-radius:
          23px;

      }


      .hero-icon-inner {

        width:
          43px;

        height:
          43px;

        border-radius:
          13px;

      }


      .hero-icon i {
        font-size:
          21px;
      }


      .hero h1 {
        font-size:
          29px;
      }


      .hero-text p {
        font-size:
          13px;
      }


      .tool-section {

        padding:
          40px 0;

      }


      .card-topbar {

        grid-template-columns:
          auto 1fr auto;

        padding:
          0 13px;

      }


      .tool-name {
        font-size:
          9px;
      }


      .secure {

        padding:
          5px 7px;

        font-size:
          8px;

      }


      .current-time {

        margin:
          15px 15px 0;

      }


      .current-content strong {
        font-size:
          12px;
      }


      .current-copy {

        padding:
          0 9px;

      }


      .actionbar {

        flex-direction:
          column;

        align-items:
          stretch;

        padding:
          15px;

      }


      .action-group {

        width:
          100%;

      }


      .main-actions,
      .utility-actions {

        display:
          grid;

        grid-template-columns:
          1fr 1fr;

      }


      .btn {

        width:
          100%;

        min-width:
          0;

        padding:
          0 7px;

        font-size:
          9px;

      }


      .editor-section {

        padding:
          20px 15px;

      }


      .input-grid {

        grid-template-columns:
          1fr;

      }


      .result-box {

        margin:
          18px 15px;

      }


      .output-section {

        padding:
          0 15px 20px;

      }


      .result-grid {

        grid-template-columns:
          1fr;

      }


      .stats-grid {

        grid-template-columns:
          1fr 1fr;

        padding:
          0 15px 20px;

      }


      .security-note {

        margin:
          0 15px 15px;

      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;

      }

    }



    /* SMALL */

    @media (max-width: 420px) {

      .main-actions,
      .utility-actions {

        grid-template-columns:
          1fr;

      }


      .current-time {

        align-items:
          flex-start;

      }


      .current-copy {

        margin-top:
          3px;

      }


      .hero h1 {

        font-size:
          26px;

      }

    }

  </style>

</body>
</html>
