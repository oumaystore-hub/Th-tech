  <!-- =========================================
       JAVASCRIPT
  ========================================== -->

  <script is:inline>
    (() => {

      const dateInput =
        document.getElementById("dateInput");

      const timeInput =
        document.getElementById("timeInput");

      const timestampInput =
        document.getElementById("timestampInput");

      const unitSelect =
        document.getElementById("unitSelect");

      const dateToTimestampBtn =
        document.getElementById("dateToTimestampBtn");

      const timestampToDateBtn =
        document.getElementById("timestampToDateBtn");

      const nowBtn =
        document.getElementById("nowBtn");

      const currentBtn =
        document.getElementById("currentBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const currentTimestamp =
        document.getElementById("currentTimestamp");

      const timestampOutput =
        document.getElementById("timestampOutput");

      const dateOutput =
        document.getElementById("dateOutput");

      const isoOutput =
        document.getElementById("isoOutput");

      const localOutput =
        document.getElementById("localOutput");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const statTimestamp =
        document.getElementById("statTimestamp");

      const statDate =
        document.getElementById("statDate");

      const statStatus =
        document.getElementById("statStatus");

      const inputMode =
        document.getElementById("inputMode");


      let lastTimestamp = "";

      let currentMode = "date";


      function pad(number) {
        return String(number).padStart(2, "0");
      }


      function updateCurrentTimestamp() {

        const now =
          Date.now();

        const timestamp =
          Math.floor(now / 1000);

        currentTimestamp.textContent =
          timestamp.toLocaleString("en-US");

      }


      function setResult(
        type,
        title,
        message
      ) {

        resultBox.classList.remove(
          "success",
          "error"
        );


        if (type === "success") {

          resultBox.classList.add(
            "success"
          );

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-check"></i>';

        } else if (type === "error") {

          resultBox.classList.add(
            "error"
          );

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-exclamation"></i>';

        } else {

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-question"></i>';

        }


        resultTitle.textContent =
          title;

        resultMessage.textContent =
          message;
      }


      function formatUTC(date) {

        return (
          `${date.getUTCFullYear()}-` +
          `${pad(date.getUTCMonth() + 1)}-` +
          `${pad(date.getUTCDate())} ` +
          `${pad(date.getUTCHours())}:` +
          `${pad(date.getUTCMinutes())}:` +
          `${pad(date.getUTCSeconds())} UTC`
        );

      }


      function formatLocal(date) {

        return date.toLocaleString(
          "ar-MA",
          {
            dateStyle: "medium",
            timeStyle: "medium"
          }
        );

      }


      function updateOutputs(date, timestamp) {

        const iso =
          date.toISOString();

        const utc =
          formatUTC(date);

        const local =
          formatLocal(date);


        timestampOutput.textContent =
          String(timestamp);

        dateOutput.textContent =
          utc;

        isoOutput.textContent =
          iso;

        localOutput.textContent =
          local;


        statTimestamp.textContent =
          String(timestamp);

        statDate.textContent =
          `${date.getUTCFullYear()}-${pad(
            date.getUTCMonth() + 1
          )}-${pad(
            date.getUTCDate()
          )}`;

        statStatus.textContent =
          "تم";


        lastTimestamp =
          String(timestamp);

      }


      function dateToTimestamp() {

        const dateValue =
          dateInput.value;

        const timeValue =
          timeInput.value || "00:00:00";


        if (!dateValue) {

          setResult(
            "error",
            "التاريخ غير موجود",
            "اختر تاريخاً أولاً ثم حاول مرة أخرى."
          );

          return;

        }


        const date =
          new Date(
            `${dateValue}T${timeValue}`
          );


        if (Number.isNaN(date.getTime())) {

          setResult(
            "error",
            "تاريخ غير صالح",
            "تحقق من التاريخ والوقت المدخلين."
          );

          return;

        }


        const milliseconds =
          date.getTime();

        const timestamp =
          unitSelect.value === "milliseconds"
            ? milliseconds
            : Math.floor(
                milliseconds / 1000
              );


        updateOutputs(
          date,
          timestamp
        );


        timestampInput.value =
          String(timestamp);


        currentMode =
          "date";

        inputMode.textContent =
          "Date & Time";


        setResult(
          "success",
          "تم التحويل بنجاح",
          "تم تحويل التاريخ والوقت إلى Unix Timestamp."
        );

      }


      function timestampToDate() {

        const raw =
          timestampInput.value.trim();


        if (!raw) {

          setResult(
            "error",
            "Timestamp غير موجود",
            "أدخل Unix Timestamp أولاً."
          );

          timestampInput.focus();

          return;

        }


        if (!/^-?\d+$/.test(raw)) {

          setResult(
            "error",
            "قيمة غير صالحة",
            "استخدم أرقام Unix Timestamp فقط."
          );

          return;

        }


        const value =
          Number(raw);


        if (!Number.isFinite(value)) {

          setResult(
            "error",
            "قيمة غير صالحة",
            "تعذر معالجة قيمة Timestamp."
          );

          return;

        }


        const milliseconds =
          unitSelect.value === "milliseconds"
            ? value
            : value * 1000;


        const date =
          new Date(milliseconds);


        if (
          Number.isNaN(
            date.getTime()
          )
        ) {

          setResult(
            "error",
            "تاريخ غير صالح",
            "قيمة Timestamp خارج النطاق المدعوم."
          );

          return;

        }


        updateOutputs(
          date,
          value
        );


        const year =
          date.getFullYear();

        const month =
          pad(date.getMonth() + 1);

        const day =
          pad(date.getDate());

        const hours =
          pad(date.getHours());

        const minutes =
          pad(date.getMinutes());

        const seconds =
          pad(date.getSeconds());


        dateInput.value =
          `${year}-${month}-${day}`;

        timeInput.value =
          `${hours}:${minutes}:${seconds}`;


        currentMode =
          "timestamp";

        inputMode.textContent =
          "Unix Timestamp";


        setResult(
          "success",
          "تم التحويل بنجاح",
          "تم تحويل Unix Timestamp إلى التاريخ والوقت."
        );

      }


      function setNow() {

        const now =
          new Date();


        const year =
          now.getFullYear();

        const month =
          pad(now.getMonth() + 1);

        const day =
          pad(now.getDate());

        const hours =
          pad(now.getHours());

        const minutes =
          pad(now.getMinutes());

        const seconds =
          pad(now.getSeconds());


        dateInput.value =
          `${year}-${month}-${day}`;

        timeInput.value =
          `${hours}:${minutes}:${seconds}`;


        timestampInput.value =
          String(
            Math.floor(
              now.getTime() / 1000
            )
          );


        dateToTimestamp();


        setResult(
          "success",
          "تم اختيار الوقت الحالي",
          "تم تحميل التاريخ والوقت الحاليين."
        );

      }


      async function copyText(
        value,
        successMessage
      ) {

        if (
          !value ||
          value === "—"
        ) {

          setResult(
            "error",
            "لا توجد نتيجة",
            "قم بإجراء التحويل أولاً."
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            String(value)
          );


          setResult(
            "success",
            "تم النسخ",
            successMessage
          );

        } catch {

          const textarea =
            document.createElement(
              "textarea"
            );


          textarea.value =
            String(value);

          textarea.style.position =
            "fixed";

          textarea.style.opacity =
            "0";

          document.body.appendChild(
            textarea
          );

          textarea.select();


          try {

            document.execCommand(
              "copy"
            );


            setResult(
              "success",
              "تم النسخ",
              successMessage
            );

          } catch {

            setResult(
              "error",
              "تعذر النسخ",
              "تعذر نسخ النتيجة تلقائياً."
            );

          }


          textarea.remove();

        }

      }


      function clearAll() {

        dateInput.value =
          "";

        timeInput.value =
          "";

        timestampInput.value =
          "";


        timestampOutput.textContent =
          "—";

        dateOutput.textContent =
          "—";

        isoOutput.textContent =
          "—";

        localOutput.textContent =
          "—";


        statTimestamp.textContent =
          "—";

        statDate.textContent =
          "—";

        statStatus.textContent =
          "جاهز";


        lastTimestamp =
          "";


        setResult(
          "default",
          "جاهز للتحويل",
          "اختر العملية التي تريد تنفيذها ثم اضغط على الزر المناسب."
        );

      }


      function syncInputMode() {

        if (
          currentMode === "timestamp"
        ) {

          inputMode.textContent =
            "Unix Timestamp";

        } else {

          inputMode.textContent =
            "Date & Time";

        }

      }


      dateToTimestampBtn.addEventListener(
        "click",
        dateToTimestamp
      );


      timestampToDateBtn.addEventListener(
        "click",
        timestampToDate
      );


      nowBtn.addEventListener(
        "click",
        setNow
      );


      currentBtn.addEventListener(
        "click",
        () => {

          copyText(
            currentTimestamp.textContent,
            "تم نسخ Unix Timestamp الحالي."
          );

        }
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      document
        .getElementById("copyTimestampBtn")
        .addEventListener(
          "click",
          () => {

            copyText(
              timestampOutput.textContent,
              "تم نسخ Unix Timestamp."
            );

          }
        );


      document
        .getElementById("copyDateBtn")
        .addEventListener(
          "click",
          () => {

            copyText(
              dateOutput.textContent,
              "تم نسخ تاريخ UTC."
            );

          }
        );


      document
        .getElementById("copyIsoBtn")
        .addEventListener(
          "click",
          () => {

            copyText(
              isoOutput.textContent,
              "تم نسخ تاريخ ISO 8601."
            );

          }
        );


      document
        .getElementById("copyLocalBtn")
        .addEventListener(
          "click",
          () => {

            copyText(
              localOutput.textContent,
              "تم نسخ التاريخ المحلي."
            );

          }
        );


      timestampInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Enter"
          ) {

            event.preventDefault();

            timestampToDate();

          }

        }
      );


      unitSelect.addEventListener(
        "change",
        () => {

          if (
            currentMode === "timestamp" &&
            timestampInput.value.trim()
          ) {

            timestampToDate();

          }

        }
      );


      dateInput.addEventListener(
        "change",
        syncInputMode
      );


      timeInput.addEventListener(
        "change",
        syncInputMode
      );


      updateCurrentTimestamp();

      setInterval(
        updateCurrentTimestamp,
        1000
      );

      syncInputMode();

    })();
  </script>



  <!-- =========================================
       THEME SYNC
  ========================================== -->

  <script is:inline>
    (() => {

      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");


          if (saved === "dark") {

            document.documentElement.classList.add(
              "dark-mode"
            );

          } else {

            document.documentElement.classList.remove(
              "dark-mode"
            );

          }

        } catch {}

      }


      syncTheme();


      window.addEventListener(
        "themeChange",
        syncTheme
      );


      document.addEventListener(
        "click",
        (event) => {

          const button =
            event.target.closest(
              "#theme-btn"
            );


          if (button) {

            setTimeout(
              syncTheme,
              0
            );

          }

        }
      );

    })();
  </script>



