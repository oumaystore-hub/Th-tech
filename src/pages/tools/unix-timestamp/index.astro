---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title =
  "Unix Timestamp Converter - تحويل Unix Timestamp أونلاين مجاناً | Th.Tech";

const description =
  "أداة Unix Timestamp مجانية لتحويل الوقت والتاريخ إلى Unix Timestamp والعكس، مع دعم الثواني والميلي ثانية والعمل مباشرة داخل المتصفح.";

const faqs = [
  {
    q: "ما هو Unix Timestamp؟",
    a: "Unix Timestamp هو رقم يمثل عدد الثواني المنقضية منذ 1 يناير 1970 عند الساعة 00:00:00 UTC، ويستخدم على نطاق واسع في البرمجة وقواعد البيانات وواجهات API."
  },
  {
    q: "ما الفرق بين Unix Timestamp بالثواني والميلي ثانية؟",
    a: "Timestamp بالثواني يستخدم رقماً مكوناً عادةً من 10 أرقام، بينما Timestamp بالميلي ثانية يستخدم عادةً 13 رقماً ويمثل الوقت بدقة أعلى."
  },
  {
    q: "هل يتم إرسال التاريخ أو الوقت إلى الخادم؟",
    a: "لا. جميع عمليات التحويل والحساب تتم مباشرة داخل المتصفح باستخدام JavaScript."
  },
  {
    q: "ما هو الوقت الحالي بصيغة Unix Timestamp؟",
    a: "يمكنك استخدام زر الوقت الحالي في الأداة للحصول على Unix Timestamp الحالي مباشرة من ساعة جهازك."
  }
];
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/unix-timestamp/`}
  />

  <meta
    name="theme-color"
    content="#08070d"
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }
      } catch {}
    })();
  </script>

</head>

