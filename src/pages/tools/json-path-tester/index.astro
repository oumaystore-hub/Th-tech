---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JSON Path Tester - اختبار JSONPath أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لاختبار JSONPath واستخراج البيانات من JSON بسرعة مباشرة داخل المتصفح.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>JSON Path Tester</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-route"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              JSON Tools
            </span>

            <h1>
              JSON <span>Path Tester</span>
            </h1>

            <p>
              اختبر مسارات JSONPath واستخرج البيانات من ملفات JSON
              بسرعة وسهولة مباشرة من المتصفح.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-route"></i>
              <span>JSON Path Tester</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="exampleBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-lightbulb"></i>
                مثال
              </button>

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- JSON PATH -->

          <div class="path-area">

            <div class="path-label">
              <i class="fas fa-location-arrow"></i>
              <span>مسار JSONPath</span>
            </div>

            <div class="path-input-wrapper">

              <span class="path-prefix">$</span>

              <input
                id="pathInput"
                type="text"
                dir="ltr"
                spellcheck="false"
                autocomplete="off"
                placeholder="مثال: $.users[*].name"
                value="$.users[*].name"
              />

              <button
                id="testBtn"
                class="test-btn"
                type="button"
              >
                <i class="fas fa-play"></i>
                اختبار
              </button>

            </div>

            <div class="path-hints">

              <button type="button" data-path="$.users[*].name">
                $.users[*].name
              </button>

              <button type="button" data-path="$.users[0]">
                $.users[0]
              </button>

              <button type="button" data-path="$..email">
                $..email
              </button>

              <button type="button" data-path="$.users[*]">
                $.users[*]
              </button>

            </div>

          </div>


          <!-- EDITORS -->

          <div class="editors">

            <!-- JSON -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  JSON
                </div>

                <span id="inputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="input"
                  spellcheck="false"
                  dir="ltr"
                  placeholder='ألصق JSON هنا...

مثال:
{
  "users": [
    {
      "id": 1,
      "name": "Ahmed",
      "email": "ahmed@example.com"
    },
    {
      "id": 2,
      "name": "Sara",
      "email": "sara@example.com"
    }
  ]
}'
                ></textarea>

              </div>

            </div>


            <!-- RESULT -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-bullseye"></i>
                  النتيجة
                </div>

                <span id="resultCount">0 نتيجة</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="output"
                  readonly
                  spellcheck="false"
                  dir="ltr"
                  placeholder="ستظهر نتائج JSONPath هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- MAIN ACTION -->

          <div class="main-actions">

            <button
              id="mainTestBtn"
              class="test-main-btn"
              type="button"
            >
              <i class="fas fa-route"></i>
              اختبار JSONPath
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- STATUS -->

          <div id="status" class="status hidden">

            <i id="statusIcon" class="fas fa-check-circle"></i>

            <span id="statusText"></span>

          </div>


          <!-- STATISTICS -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-database"></i>
              </div>

              <div>
                <span class="stat-value" id="jsonSize">0 B</span>
                <span class="stat-label">حجم JSON</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-list"></i>
              </div>

              <div>
                <span class="stat-value" id="matches">0</span>
                <span class="stat-label">عدد النتائج</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">
                <i class="fas fa-check"></i>
              </div>

              <div>
                <span class="stat-value" id="pathStatus">جاهز</span>
                <span class="stat-label">حالة المسار</span>
              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>
              <h3>نتائج فورية</h3>

              <p>
                اختبر مسارات JSONPath واستخرج النتائج مباشرة داخل المتصفح.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>
              <h3>خصوصية كاملة</h3>

              <p>
                تتم معالجة JSON محلياً دون الحاجة إلى إرسال البيانات إلى خادم.
              </p>
            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-filter"></i>
            </div>

            <div>
              <h3>استخراج دقيق</h3>

              <p>
                استخدم المسارات للوصول إلى العناصر والقيم داخل JSON بسهولة.
              </p>
            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>JSON Path Tester؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">01</span>

              <div class="step-icon">
                <i class="fas fa-paste"></i>
              </div>

              <h3>أدخل JSON</h3>

              <p>
                ألصق كود JSON الذي تريد البحث بداخله.
              </p>

            </div>


            <div class="step">

              <span class="step-number">02</span>

              <div class="step-icon">
                <i class="fas fa-route"></i>
              </div>

              <h3>اكتب المسار</h3>

              <p>
                أدخل مسار JSONPath مثل $.users[*].name.
              </p>

            </div>


            <div class="step">

              <span class="step-number">03</span>

              <div class="step-icon">
                <i class="fas fa-magnifying-glass"></i>
              </div>

              <h3>اختبر النتيجة</h3>

              <p>
                اضغط اختبار لاستخراج العناصر المطابقة للمسار.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= SYNTAX ================= -->

        <div class="syntax-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-code"></i>
              JSONPath
            </span>

            <h2>
              أمثلة على
              <span>المسارات</span>
            </h2>

          </div>


          <div class="syntax-grid">

            <div class="syntax-card">
              <code>$</code>
              <span>الجذر الرئيسي لـ JSON</span>
            </div>

            <div class="syntax-card">
              <code>$.users</code>
              <span>الوصول إلى users</span>
            </div>

            <div class="syntax-card">
              <code>$.users[0]</code>
              <span>العنصر الأول</span>
            </div>

            <div class="syntax-card">
              <code>$.users[*]</code>
              <span>جميع العناصر</span>
            </div>

            <div class="syntax-card">
              <code>$.users[*].name</code>
              <span>أسماء جميع المستخدمين</span>
            </div>

            <div class="syntax-card">
              <code>$..email</code>
              <span>البحث المتكرر عن email</span>
            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>JSONPath</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هو JSONPath؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                JSONPath هي صيغة تستخدم للوصول إلى عناصر وقيم محددة داخل
                مستندات JSON بطريقة مشابهة لفكرة XPath في XML.
              </p>

            </details>


            <details>

              <summary>
                ماذا يعني الرمز $؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                الرمز $ يمثل الجذر الرئيسي لمستند JSON.
              </p>

            </details>


            <details>

              <summary>
                ماذا يعني [*]؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                يستخدم [*] لاختيار جميع عناصر المصفوفة.
              </p>

            </details>


            <details>

              <summary>
                هل يتم إرسال البيانات إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. تتم عملية تحليل JSON واختبار المسار مباشرة داخل المتصفح.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input,
    textarea {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* HERO */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);
      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 720px;
      margin: 0;

      color: var(--muted);
      font-size: .92rem;
    }


    /* TOOL */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);
      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);
      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;
      border: 1px solid var(--border);

      background: var(--card);
      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(37, 99, 235, .35);
      color: var(--primary);
      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* PATH */

    .path-area {
      padding: 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card);
    }


    .path-label {
      display: flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 10px;

      color: var(--muted);

      font-size: .78rem;
      font-weight: 700;
    }


    .path-label i {
      color: var(--primary);
    }


    .path-input-wrapper {
      display: flex;
      align-items: stretch;

      min-height: 52px;

      overflow: hidden;

      border: 1px solid var(--border);
      border-radius: 13px;

      background: var(--card2);

      transition: .2s ease;
    }


    .path-input-wrapper:focus-within {
      border-color: rgba(37, 99, 235, .45);

      box-shadow:
        0 0 0 3px rgba(37, 99, 235, .08);
    }


    .path-prefix {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 48px;

      color: var(--primary);

      background: rgba(37, 99, 235, .08);

      font-family: Consolas, monospace;
      font-weight: 800;
    }


    #pathInput {
      flex: 1;

      min-width: 0;

      padding: 10px 15px;

      outline: none;
      border: 0;

      background: transparent;
      color: var(--text);

      font-family: Consolas, "Courier New", monospace;
      font-size: .9rem;
    }


    .test-btn {
      min-width: 105px;

      margin: 6px;

      border: 0;
      border-radius: 9px;

      background: var(--primary);
      color: #fff;

      font-size: .75rem;
      font-weight: 800;

      cursor: pointer;

      transition: .2s ease;
    }


    .test-btn:hover {
      background: var(--primary-hover);
    }


    .path-hints {
      display: flex;
      gap: 7px;

      margin-top: 10px;

      flex-wrap: wrap;
    }


    .path-hints button {
      padding: 5px 9px;

      border: 1px solid var(--border);
      border-radius: 7px;

      background: var(--card2);
      color: var(--muted);

      font-family: Consolas, monospace;
      font-size: .67rem;

      cursor: pointer;

      transition: .2s ease;
    }


    .path-hints button:hover {
      color: var(--primary);
      border-color: rgba(37, 99, 235, .3);
    }


    /* EDITORS */

    .editors {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 18px;

      padding: 20px;
    }


    .editor-panel {
      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px 15px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .75rem;
      font-weight: 700;
    }


    .panel-header > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .panel-header i {
      color: var(--primary);
    }


    .editor-wrapper {
      height: 350px;
    }


    textarea {
      width: 100%;
      height: 100%;

      display: block;

      resize: none;
      outline: none;
      border: 0;

      padding: 18px;

      background: transparent;
      color: var(--text);

      direction: ltr;
      text-align: left;

      font-family: Consolas, "Courier New", monospace;
      font-size: .84rem;
      line-height: 1.8;
    }


    textarea::placeholder {
      color: var(--muted);
      opacity: .65;
    }


    #output {
      color: var(--primary);
    }


    /* MAIN ACTION */

    .main-actions {
      display: flex;
      justify-content: center;

      padding: 0 20px 20px;
    }


    .test-main-btn {
      min-width: 245px;
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 10px;

      border: 0;
      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #3b82f6,
          #2563eb
        );

      color: #fff;

      font-family: inherit;

      font-size: .9rem;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(37, 99, 235, .22);

      transition: .25s ease;
    }


    .test-main-btn:hover {
      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(37, 99, 235, .30);
    }


    /* STATUS */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border: 1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);

      border-color:
        rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* STATISTICS */

    .statistics {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      background: var(--border);

      border-top: 1px solid var(--border);
    }


    .stat {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 12px;

      padding: 22px 15px;

      background: var(--card);
    }


    .stat-icon {
      width: 43px;
      height: 43px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background: rgba(37, 99, 235, .09);

      color: var(--primary);
    }


    .stat-icon.success {
      color: var(--green);

      background:
        rgba(34, 197, 94, .09);
    }


    .stat-value {
      display: block;

      color: var(--text);

      font-size: 1rem;
      font-weight: 800;

      direction: ltr;
      text-align: right;
    }


    .stat-label {
      display: block;

      color: var(--muted);

      font-size: .68rem;
    }


    /* INFO */

    .info-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;
      line-height: 1.8;
    }


    /* SECTIONS */

    .how-section,
    .syntax-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* STEPS */

    .steps {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* SYNTAX */

    .syntax-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 15px;
    }


    .syntax-card {
      display: flex;
      flex-direction: column;

      gap: 7px;

      padding: 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .2s ease;
    }


    .syntax-card:hover {
      transform: translateY(-3px);

      border-color:
        rgba(37, 99, 235, .3);
    }


    .syntax-card code {
      direction: ltr;
      text-align: left;

      color: var(--primary);

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .85rem;
      font-weight: 800;
    }


    .syntax-card span {
      color: var(--muted);

      font-size: .72rem;
    }


    /* FAQ */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* MOBILE */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .editors {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps,
      .syntax-grid {
        grid-template-columns: 1fr;
      }


      .statistics {
        grid-template-columns: 1fr;
      }


      .stat {
        justify-content: flex-start;

        padding-right: 25px;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;
        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;
        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .path-area {
        padding: 12px;
      }


      .path-input-wrapper {
        min-height: 48px;
      }


      .path-prefix {
        width: 40px;
      }


      #pathInput {
        padding: 8px 10px;
        font-size: .76rem;
      }


      .test-btn {
        min-width: 82px;

        font-size: .68rem;
      }


      .path-hints {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 3px;
      }


      .path-hints button {
        flex-shrink: 0;
      }


      .editors {
        padding: 12px;
        gap: 12px;
      }


      .editor-wrapper {
        height: 280px;
      }


      textarea {
        padding: 14px;

        font-size: .76rem;
      }


      .test-main-btn {
        width: 100%;
        min-width: 0;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .syntax-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

        try {
          localStorage.setItem(
            'theme',
            isDark ? 'dark' : 'light'
          );
        } catch {}

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add(
            'dark-mode'
          );
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event?.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      const themeObserver =
        new MutationObserver(() => {

          const isDark =
            document.documentElement.classList.contains(
              'dark-mode'
            );

          try {

            localStorage.setItem(
              'theme',
              isDark ? 'dark' : 'light'
            );

          } catch {}

        });


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['class']
        }
      );


      /* ================= ELEMENTS ================= */

      const input =
        document.getElementById('input');

      const output =
        document.getElementById('output');

      const pathInput =
        document.getElementById('pathInput');

      const testBtn =
        document.getElementById('testBtn');

      const mainTestBtn =
        document.getElementById('mainTestBtn');

      const exampleBtn =
        document.getElementById('exampleBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');

      const inputSize =
        document.getElementById('inputSize');

      const resultCount =
        document.getElementById('resultCount');

      const jsonSize =
        document.getElementById('jsonSize');

      const matches =
        document.getElementById('matches');

      const pathStatus =
        document.getElementById('pathStatus');


      /* ================= SIZE ================= */

      const getBytes = (text) => {

        return new Blob([text]).size;

      };


      const formatBytes = (bytes) => {

        if (!bytes) {
          return '0 B';
        }

        if (bytes < 1024) {
          return `${bytes} B`;
        }

        if (bytes < 1024 * 1024) {
          return `${(bytes / 1024).toFixed(2)} KB`;
        }

        return `${(
          bytes /
          (1024 * 1024)
        ).toFixed(2)} MB`;

      };


      const updateSize = () => {

        const bytes =
          getBytes(input.value);

        inputSize.textContent =
          formatBytes(bytes);

        jsonSize.textContent =
          formatBytes(bytes);

      };


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove(
          'hidden'
        );

        status.classList.toggle(
          'error',
          isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add(
          'hidden'
        );

      };


      /* ================= JSON PATH TOKENIZER ================= */

      const tokenizePath = (path) => {

        path = path.trim();

        if (!path) {
          throw new Error(
            'أدخل مسار JSONPath.'
          );
        }


        if (
          path !== '$' &&
          !path.startsWith('$')
        ) {
          throw new Error(
            'يجب أن يبدأ مسار JSONPath بالرمز $.'
          );
        }


        const tokens = [];

        let i = 1;

        while (i < path.length) {

          /* Recursive descent */

          if (
            path[i] === '.' &&
            path[i + 1] === '.'
          ) {

            i += 2;

            if (path[i] === '*') {

              tokens.push({
                type: 'recursive',
                key: '*'
              });

              i++;

              continue;
            }


            let start = i;

            while (
              i < path.length &&
              /[A-Za-z0-9_$-]/.test(
                path[i]
              )
            ) {
              i++;
            }


            const key =
              path.slice(start, i);

            if (!key) {
              throw new Error(
                'مسار recursive غير صالح.'
              );
            }


            tokens.push({
              type: 'recursive',
              key
            });

            continue;

          }


          /* Dot notation */

          if (path[i] === '.') {

            i++;

            if (path[i] === '*') {

              tokens.push({
                type: 'wildcard'
              });

              i++;

              continue;

            }


            let start = i;

            while (
              i < path.length &&
              /[A-Za-z0-9_$-]/.test(
                path[i]
              )
            ) {
              i++;
            }


            const key =
              path.slice(start, i);

            if (!key) {
              throw new Error(
                'اسم الخاصية غير صالح.'
              );
            }


            tokens.push({
              type: 'property',
              key
            });

            continue;

          }


          /* Brackets */

          if (path[i] === '[') {

            const end =
              path.indexOf(
                ']',
                i
              );

            if (end === -1) {
              throw new Error(
                'قوس ] مفقود في المسار.'
              );
            }


            const content =
              path.slice(
                i + 1,
                end
              ).trim();


            if (content === '*') {

              tokens.push({
                type: 'wildcard'
              });

            } else if (
              /^-?\d+$/.test(content)
            ) {

              tokens.push({
                type: 'index',
                index: Number(content)
              });

            } else {

              const quoted =
                content.match(
                  /^(['"])(.*?)\1$/
                );

              if (quoted) {

                tokens.push({
                  type: 'property',
                  key: quoted[2]
                });

              } else {

                throw new Error(
                  `الصيغة ${content} غير مدعومة داخل [].`
                );

              }

            }


            i =
              end + 1;

            continue;

          }


          throw new Error(
            `رمز غير متوقع في المسار عند الموضع ${i + 1}.`
          );

        }


        return tokens;

      };


      /* ================= RECURSIVE SEARCH ================= */

      const recursiveFind = (
        value,
        key
      ) => {

        const results = [];


        const visit = (node) => {

          if (
            node !== null &&
            typeof node === 'object'
          ) {

            if (
              key === '*' &&
              Array.isArray(node)
            ) {

              for (
                const item of node
              ) {
                results.push(item);
              }

            }


            if (
              !Array.isArray(node) &&
              key !== '*'
            ) {

              if (
                Object.prototype.hasOwnProperty.call(
                  node,
                  key
                )
              ) {
                results.push(
                  node[key]
                );
              }

            }


            if (Array.isArray(node)) {

              for (
                const item of node
              ) {
                visit(item);
              }

            } else {

              for (
                const child of Object.values(node)
              ) {
                visit(child);
              }

            }

          }

        };


        visit(value);

        return results;

      };


      /* ================= APPLY TOKENS ================= */

      const applyToken = (
        nodes,
        token
      ) => {

        const next = [];


        for (
          const node of nodes
        ) {

          if (
            token.type === 'property'
          ) {

            if (
              node !== null &&
              typeof node === 'object' &&
              Object.prototype.hasOwnProperty.call(
                node,
                token.key
              )
            ) {

              next.push(
                node[token.key]
              );

            }

          }


          else if (
            token.type === 'index'
          ) {

            if (
              Array.isArray(node)
            ) {

              let index =
                token.index;

              if (index < 0) {
                index =
                  node.length + index;
              }

              if (
                index >= 0 &&
                index < node.length
              ) {
                next.push(
                  node[index]
                );
              }

            }

          }


          else if (
            token.type === 'wildcard'
          ) {

            if (
              Array.isArray(node)
            ) {

              next.push(
                ...node
              );

            } else if (
              node !== null &&
              typeof node === 'object'
            ) {

              next.push(
                ...Object.values(node)
              );

            }

          }


          else if (
            token.type === 'recursive'
          ) {

            next.push(
              ...recursiveFind(
                node,
                token.key
              )
            );

          }

        }


        return next;

      };


      /* ================= JSON PATH ================= */

      const queryJSONPath = (
        data,
        path
      ) => {

        const tokens =
          tokenizePath(path);

        let nodes = [data];


        for (
          const token of tokens
        ) {

          nodes =
            applyToken(
              nodes,
              token
            );

        }


        return nodes;

      };


      /* ================= TEST ================= */

      const testJSONPath = () => {

        hideStatus();

        const jsonText =
          input.value.trim();

        const path =
          pathInput.value.trim();


        if (!jsonText) {

          output.value = '';

          matches.textContent = '0';
          resultCount.textContent =
            '0 نتيجة';

          pathStatus.textContent =
            'جاهز';

          showStatus(
            'أدخل JSON أولاً.',
            true
          );

          return;

        }


        if (!path) {

          showStatus(
            'أدخل مسار JSONPath أولاً.',
            true
          );

          return;

        }


        let data;


        try {

          data =
            JSON.parse(jsonText);

        } catch {

          output.value = '';

          matches.textContent = '0';

          resultCount.textContent =
            '0 نتيجة';

          pathStatus.textContent =
            'خطأ';

          showStatus(
            'JSON غير صالح. تحقق من بنية JSON.',
            true
          );

          return;

        }


        try {

          const results =
            queryJSONPath(
              data,
              path
            );


          output.value =
            JSON.stringify(
              results.length === 1
                ? results[0]
                : results,
              null,
              2
            );


          const count =
            results.length;


          matches.textContent =
            String(count);

          resultCount.textContent =
            `${count} نتيجة`;

          pathStatus.textContent =
            'صالح';


          if (count === 0) {

            showStatus(
              'المسار صالح ولكن لم يتم العثور على نتائج.',
              false
            );

          } else {

            showStatus(
              `تم العثور على ${count} نتيجة بنجاح.`
            );

          }

          updateSize();

        } catch (error) {

          output.value = '';

          matches.textContent =
            '0';

          resultCount.textContent =
            '0 نتيجة';

          pathStatus.textContent =
            'خطأ';


          showStatus(
            error?.message ||
              'مسار JSONPath غير صالح.',
            true
          );

        }

      };


      /* ================= EXAMPLE ================= */

      const loadExample = () => {

        input.value =
`{
  "users": [
    {
      "id": 1,
      "name": "Ahmed",
      "email": "ahmed@example.com",
      "role": "developer"
    },
    {
      "id": 2,
      "name": "Sara",
      "email": "sara@example.com",
      "role": "designer"
    },
    {
      "id": 3,
      "name": "Youssef",
      "email": "youssef@example.com",
      "role": "developer"
    }
  ],
  "company": {
    "name": "Th.Tech",
    "country": "Morocco"
  }
}`;


        pathInput.value =
          '$.users[*].name';


        updateSize();

        testJSONPath();

      };


      /* ================= COPY ================= */

      const copyResult = async () => {

        const value =
          output.value.trim();


        if (!value) {

          showStatus(
            'لا توجد نتيجة لنسخها.',
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );


          showStatus(
            'تم نسخ النتيجة بنجاح.'
          );


          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          output.select();

          document.execCommand(
            'copy'
          );

          showStatus(
            'تم نسخ النتيجة.'
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        input.value = '';

        output.value = '';

        pathInput.value = '$';


        matches.textContent =
          '0';

        resultCount.textContent =
          '0 نتيجة';

        pathStatus.textContent =
          'جاهز';


        hideStatus();

        updateSize();

        input.focus();

      };


      /* ================= PATH HINTS ================= */

      document
        .querySelectorAll(
          '[data-path]'
        )
        .forEach((button) => {

          button.addEventListener(
            'click',
            () => {

              pathInput.value =
                button.dataset.path;

              testJSONPath();

            }
          );

        });


      /* ================= EVENTS ================= */

      testBtn.addEventListener(
        'click',
        testJSONPath
      );


      mainTestBtn.addEventListener(
        'click',
        testJSONPath
      );


      exampleBtn.addEventListener(
        'click',
        loadExample
      );


      copyBtn.addEventListener(
        'click',
        copyResult
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      input.addEventListener(
        'input',
        updateSize
      );


      pathInput.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key === 'Enter'
          ) {

            event.preventDefault();

            testJSONPath();

          }

        }
      );


      input.addEventListener(
        'keydown',
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === 'Enter'
          ) {

            event.preventDefault();

            testJSONPath();

          }

        }
      );


      /* ================= INITIAL ================= */

      updateSize();

    })();
