      .editor-wrapper {
        display: flex;

        height: 410px;

        direction: ltr;

        overflow: hidden;
      }


      .line-numbers {
        width: 48px;

        flex: 0 0 48px;

        padding:
          17px 10px;

        text-align: right;

        color: #64748b;

        background: #08101d;

        border-right:
          1px solid
          rgba(255,255,255,0.06);

        font:
          13px/1.75
          monospace;

        overflow: hidden;

        user-select: none;

        white-space: pre;
      }


      #codeInput {
        width: 100%;

        height: 100%;

        resize: none;

        border: 0;

        outline: 0;

        padding: 17px;

        background: #0b1220;

        color: #e2e8f0;

        font:
          13px/1.75
          "Cairo",
          monospace;

        direction: ltr;

        text-align: left;

        tab-size: 2;
      }


      #codeInput::placeholder {
        color: #64748b;
      }


      .editor-footer {
        min-height: 40px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        padding:
          0 14px;

        border-top:
          1px solid
          rgba(255,255,255,0.08);

        color: #64748b;

        font-size: 10px;
      }


      .editor-footer span {
        display: flex;

        align-items: center;

        gap: 5px;
      }


      /* =========================================
         CONSOLE
      ========================================= */

      .console {
        height: 410px;

        padding: 12px;

        overflow: auto;

        direction: ltr;

        text-align: left;
      }


      .console-empty {
        min-height: 100%;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        gap: 10px;

        color: #64748b;

        text-align: center;

        direction: rtl;
      }


      .console-empty i {
        font-size: 30px;

        opacity: 0.45;
      }


      .console-empty p {
        margin: 0;

        font-size: 12px;
      }


      .console-row {
        display: grid;

        grid-template-columns: 24px minmax(0, 1fr);

        gap: 7px;

        padding: 8px 6px;

        border-bottom:
          1px solid
          rgba(255,255,255,0.05);

        font:
          12px/1.65
          monospace;

        direction: ltr;
      }


      .console-row pre {
        margin: 0;

        white-space: pre-wrap;

        word-break: break-word;
      }


      .console-type {
        padding-top: 2px;
      }


      .console-log {
        color: #e2e8f0;
      }


      .console-info {
        color: #67e8f9;
      }


      .console-warn {
        color: #fbbf24;
      }


      .console-error {
        color: #f87171;
      }


      .console-result {
        color: #86efac;
      }


      .clear-output {
        border: 0;

        background: transparent;

        color: #64748b;

        cursor: pointer;

        font:
          11px
          "Cairo",
          sans-serif;

        display: flex;

        align-items: center;

        gap: 5px;
      }


      .clear-output:hover {
        color: #f87171;
      }


      .output-footer {
        min-height: 40px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        padding:
          0 14px;

        border-top:
          1px solid
          rgba(255,255,255,0.08);

        color: #64748b;

        font-size: 10px;
      }


      .status {
        display: flex;

        align-items: center;

        gap: 7px;
      }


      .status-circle {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #64748b;
      }


      .status-success {
        color: #4ade80;
      }


      .status-success .status-circle {
        background: #22c55e;
      }


      .status-error {
        color: #f87171;
      }


      .status-error .status-circle {
        background: #ef4444;
      }


      .status-warning {
        color: #fbbf24;
      }


      .status-warning .status-circle {
        background: #f59e0b;
      }


      .status-running {
        color: #60a5fa;
      }


      .status-running .status-circle {
        background: #3b82f6;

        animation:
          pulse 1s infinite;
      }


      @keyframes pulse {

        0%,
        100% {
          opacity: 1;
        }

        50% {
          opacity: 0.35;
        }

      }


      /* =========================================
         STATS
      ========================================= */

      .stats-grid {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 12px;

        padding:
          0 18px
          18px;
      }


      .stat-card {
        display: flex;

        align-items: center;

        gap: 11px;

        padding: 13px;

        border:
          1px solid
          var(--border);

        background: var(--card2);

        border-radius: 14px;
      }


      .stat-icon {
        width: 38px;
        height: 38px;

        flex: 0 0 38px;

        display: grid;

        place-items: center;

        border-radius: 11px;
      }


      .stat-icon.blue {
        background:
          rgba(37,99,235,.1);

        color: var(--primary);
      }


      .stat-icon.cyan {
        background:
          rgba(8,145,178,.1);

        color: var(--cyan);
      }


      .stat-icon.red {
        background:
          rgba(220,38,38,.1);

        color: var(--red);
      }


      .stat-icon.green {
        background:
          rgba(22,163,74,.1);

        color: var(--green);
      }


      .stat-card strong {
        display: block;

        font-size: 12px;
      }


      .stat-card span {
        display: block;

        margin-top: 2px;

        color: var(--muted);

        font-size: 10px;
      }


      /* =========================================
         INFO
      ========================================= */

      .info-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 14px;

        margin-top: 18px;
      }


      .info-card {
        padding: 22px;

        border:
          1px solid
          var(--border);

        background: var(--card);

        border-radius: 18px;
      }


      .info-icon {
        width: 42px;
        height: 42px;

        display: grid;

        place-items: center;

        border-radius: 12px;

        margin-bottom: 13px;
      }


      .info-icon.blue {
        background:
          rgba(37,99,235,.1);

        color: var(--primary);
      }


      .info-icon.cyan {
        background:
          rgba(8,145,178,.1);

        color: var(--cyan);
      }


      .info-icon.purple {
        background:
          rgba(124,58,237,.1);

        color: var(--purple);
      }


      .info-card h3 {
        margin:
          0 0 8px;

        font-size: 15px;
      }


      .info-card p {
        margin: 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.9;
      }


      /* =========================================
         CONTENT
      ========================================= */

      .content-section {
        margin-top: 46px;
      }


      .section-heading {
        text-align: center;

        margin-bottom: 22px;
      }


      .section-heading span {
        display: inline-block;

        margin-bottom: 5px;

        color: var(--primary);

        font-size: 12px;

        font-weight: 700;
      }


      .section-heading h2 {
        margin: 0;

        font-size:
          clamp(21px, 4vw, 28px);
      }


      .steps-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 14px;
      }


      .step-card {
        display: flex;

        align-items: flex-start;

        gap: 13px;

        padding: 20px;

        background: var(--card);

        border:
          1px solid
          var(--border);

        border-radius: 17px;
      }


      .step-number {
        width: 38px;
        height: 38px;

        flex: 0 0 38px;

        display: grid;

        place-items: center;

        border-radius: 11px;

        background:
          rgba(37,99,235,.1);

        color: var(--primary);

        font-weight: 800;
      }


      .step-card h3 {
        margin:
          0 0 5px;

        font-size: 14px;
      }


      .step-card p {
        margin: 0;

        color: var(--muted);

        font-size: 11px;

        line-height: 1.8;
      }


      /* =========================================
         FAQ
      ========================================= */

      .faq-list {
        max-width: 850px;

        margin: 0 auto;
      }


      .faq-list details {
        background: var(--card);

        border:
          1px solid
          var(--border);

        border-radius: 14px;

        margin-bottom: 9px;

        overflow: hidden;
      }


      .faq-list summary {
        list-style: none;

        cursor: pointer;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;

        padding: 17px 18px;

        font-size: 13px;

        font-weight: 700;
      }


      .faq-list summary::-webkit-details-marker {
        display: none;
      }


      .faq-list summary i {
        color: var(--muted);

        transition:
          transform 0.2s ease;
      }


      .faq-list details[open] summary i {
        transform:
          rotate(180deg);
      }


      .faq-answer {
        padding:
          0 18px
          18px;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.9;
      }


      /* =========================================
         RESPONSIVE
      ========================================= */

      @media (max-width: 900px) {

        .tool-top {
          align-items: flex-start;

          flex-direction: column;
        }


        .tool-actions {
          width: 100%;
        }


        .tool-actions .btn {
          flex: 1;
        }


        .workspace {
          grid-template-columns: 1fr;
        }


        .info-grid,
        .steps-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

      }


      @media (max-width: 800px) {

        .stats-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

      }


      @media (max-width: 600px) {

        .container {
          width:
            calc(100% - 20px);
        }


        .hero {
          padding-top: 25px;
        }


        .hero-icon {
          width: 58px;
          height: 58px;

          font-size: 27px;
        }


        .hero p {
          font-size: 13px;
        }


        .tool-card {
          border-radius: 17px;
        }


        .tool-top {
          padding: 15px;
        }


        .tool-title-icon {
          width: 42px;
          height: 42px;

          flex-basis: 42px;

          font-size: 19px;
        }


        .tool-title h2 {
          font-size: 15px;
        }


        .tool-title p {
          font-size: 10px;
        }


        .tool-actions {
          display: grid;

          grid-template-columns:
            repeat(3, 1fr);
        }


        .tool-actions .btn {
          padding:
            9px 7px;

          font-size: 11px;
        }


        .workspace {
          padding: 10px;

          gap: 10px;
        }


        .editor-wrapper,
        .console {
          height: 340px;
        }


        .stats-grid {
          padding:
            0 10px
            10px;

          gap: 8px;
        }


        .stat-card {
          padding: 10px;

          gap: 8px;
        }


        .stat-icon {
          width: 34px;
          height: 34px;

          flex-basis: 34px;
        }


        .stat-card strong {
          font-size: 11px;
        }


        .info-grid,
        .steps-grid {
          grid-template-columns: 1fr;
        }


        .info-card {
          padding: 18px;
        }


        .content-section {
          margin-top: 35px;
        }


        .section-heading h2 {
          font-size: 21px;
        }


        .breadcrumb {
          font-size: 11px;
        }

      }

    </style>

  </body>
</html>
