    <!-- JAVASCRIPT -->
    <script is:inline>
      (() => {

        const codeInput = document.getElementById('codeInput');
        const output = document.getElementById('output');

        const runBtn = document.getElementById('runBtn');
        const clearBtn = document.getElementById('clearBtn');
        const exampleBtn = document.getElementById('exampleBtn');
        const clearOutputBtn = document.getElementById('clearOutputBtn');

        const lineNumbers = document.getElementById('lineNumbers');
        const lineCount = document.getElementById('lineCount');
        const charCount = document.getElementById('charCount');

        const status = document.getElementById('status');
        const executionTime = document.getElementById('executionTime');

        let activeWorker = null;
        let executionTimer = null;
        let startedAt = 0;


        /* =========================================
           EXAMPLE
        ========================================= */

        const exampleCode = `const name = "Th.Tech";

console.log("مرحباً بك في " + name);

const numbers = [10, 20, 30, 40, 50];

const total = numbers.reduce(
  (sum, number) => sum + number,
  0
);

console.log("المجموع:", total);

const doubled = numbers.map(number => number * 2);

console.log("الأرقام بعد الضرب:", doubled);

total;`;


        /* =========================================
           UPDATE EDITOR STATS
        ========================================= */

        function updateStats() {

          const code = codeInput.value;

          const lines = code.length
            ? code.split('\n').length
            : 1;

          lineCount.textContent =
            `${lines} ${lines === 1 ? 'سطر' : 'أسطر'}`;

          charCount.textContent =
            `${code.length} حرف`;

          const numbers = [];

          for (let i = 1; i <= lines; i++) {
            numbers.push(i);
          }

          lineNumbers.textContent =
            numbers.join('\n');
        }


        /* =========================================
           STATUS
        ========================================= */

        function setStatus(type, text) {

          status.className = `status status-${type}`;

          status.innerHTML = `
            <span class="status-circle"></span>
            ${text}
          `;
        }


        /* =========================================
           ESCAPE HTML
        ========================================= */

        function escapeHtml(value) {

          return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }


        /* =========================================
           FORMAT VALUE
        ========================================= */

        function formatValue(value) {

          if (value === undefined) {
            return 'undefined';
          }

          if (value === null) {
            return 'null';
          }

          if (typeof value === 'string') {
            return value;
          }

          if (typeof value === 'function') {
            return value.toString();
          }

          if (typeof value === 'object') {

            try {

              return JSON.stringify(
                value,
                null,
                2
              );

            } catch {

              return String(value);

            }

          }

          return String(value);
        }


        /* =========================================
           ADD OUTPUT
        ========================================= */

        function addOutput(type, values) {

          const empty =
            output.querySelector('.console-empty');

          if (empty) {
            empty.remove();
          }

          const row =
            document.createElement('div');

          row.className =
            `console-row console-${type}`;

          const iconMap = {
            log: 'fa-circle-info',
            info: 'fa-circle-info',
            warn: 'fa-triangle-exclamation',
            error: 'fa-circle-xmark',
            result: 'fa-arrow-right'
          };

          const icon =
            iconMap[type] || 'fa-circle-info';

          const content =
            values
              .map(value => escapeHtml(value))
              .join(' ');

          row.innerHTML = `
            <div class="console-type">
              <i class="fa-solid ${icon}"></i>
            </div>

            <pre>${content}</pre>
          `;

          output.appendChild(row);

          output.scrollTop =
            output.scrollHeight;
        }


        /* =========================================
           RESET OUTPUT
        ========================================= */

        function resetOutput() {

          output.innerHTML = `
            <div class="console-empty">
              <i class="fa-solid fa-play"></i>
              <p>اضغط على "تشغيل" لعرض النتائج</p>
            </div>
          `;

          executionTime.textContent = '0 ms';

        }


        /* =========================================
           STOP WORKER
        ========================================= */

        function stopWorker() {

          if (activeWorker) {

            try {
              activeWorker.terminate();
            } catch {}

            activeWorker = null;
          }

          if (executionTimer) {

            clearTimeout(executionTimer);

            executionTimer = null;
          }

        }


        /* =========================================
           FINISH EXECUTION
        ========================================= */

        function finishExecution(error = false) {

          if (executionTimer) {

            clearTimeout(executionTimer);

            executionTimer = null;
          }

          const elapsed =
            Math.max(
              0,
              performance.now() - startedAt
            );

          executionTime.textContent =
            `${elapsed.toFixed(1)} ms`;

          if (error) {
            setStatus('error', 'حدث خطأ أثناء التنفيذ');
          } else {
            setStatus('success', 'تم التنفيذ بنجاح');
          }

          runBtn.disabled = false;

          runBtn.innerHTML = `
            <i class="fa-solid fa-play"></i>
            تشغيل
          `;

          activeWorker = null;
        }


        /* =========================================
           RUN CODE
        ========================================= */

        function runCode() {

          const code =
            codeInput.value.trim();

          if (!code) {

            resetOutput();

            addOutput(
              'warn',
              ['اكتب كود JavaScript أولاً.']
            );

            setStatus(
              'warning',
              'لا يوجد كود للتشغيل'
            );

            return;
          }


          /* Stop previous execution */

          stopWorker();


          /* Reset */

          resetOutput();

          setStatus(
            'running',
            'جاري تنفيذ الكود...'
          );


          runBtn.disabled = false;

          runBtn.innerHTML = `
            <i class="fa-solid fa-stop"></i>
            إيقاف
          `;


          startedAt =
            performance.now();


          /*
           * Web Worker source.
           *
           * String.raw is intentionally used here so
           * escape sequences such as \n remain valid
           * inside the generated worker script.
           */

          const workerSource = String.raw`

            self.onmessage = async function(event) {

              const code = event.data.code;


              function normalize(value) {

                if (value === undefined) {
                  return 'undefined';
                }

                if (value === null) {
                  return 'null';
                }

                if (typeof value === 'string') {
                  return value;
                }

                if (typeof value === 'function') {
                  return value.toString();
                }

                if (typeof value === 'object') {

                  try {

                    return JSON.stringify(
                      value,
                      null,
                      2
                    );

                  } catch {

                    return String(value);

                  }

                }

                return String(value);
              }


              function send(type, values) {

                self.postMessage({
                  type,
                  values
                });

              }


              console.log = function() {

                send(
                  'log',
                  Array.from(arguments).map(normalize)
                );

              };


              console.info = function() {

                send(
                  'info',
                  Array.from(arguments).map(normalize)
                );

              };


              console.warn = function() {

                send(
                  'warn',
                  Array.from(arguments).map(normalize)
                );

              };


              console.error = function() {

                send(
                  'error',
                  Array.from(arguments).map(normalize)
                );

              };


              try {

                /*
                 * The important part:
                 *
                 * \n is a real JavaScript escape sequence
                 * inside the generated Function source.
                 */

                const fn =
                  new Function(
                    '"use strict";\n' + code
                  );


                const result =
                  await fn();


                if (typeof result !== 'undefined') {

                  send(
                    'result',
                    [normalize(result)]
                  );

                }


                self.postMessage({
                  type: 'done',
                  error: false
                });


              } catch (error) {

                send(
                  'error',
                  [
                    error && error.stack
                      ? error.stack
                      : String(error)
                  ]
                );


                self.postMessage({
                  type: 'done',
                  error: true
                });

              }

            };

          `;


          let workerUrl = null;


          try {

            const blob =
              new Blob(
                [workerSource],
                {
                  type: 'application/javascript'
                }
              );


            workerUrl =
              URL.createObjectURL(blob);


            activeWorker =
              new Worker(workerUrl);


            activeWorker.onmessage =
              function(event) {

                const data =
                  event.data;


                if (
                  data.type === 'log' ||
                  data.type === 'info' ||
                  data.type === 'warn' ||
                  data.type === 'error' ||
                  data.type === 'result'
                ) {

                  addOutput(
                    data.type,
                    data.values || []
                  );

                }


                if (data.type === 'done') {

                  const hasError =
                    Boolean(data.error);

                  finishExecution(
                    hasError
                  );

                  if (activeWorker) {

                    try {
                      activeWorker.terminate();
                    } catch {}

                  }

                  activeWorker = null;

                  if (workerUrl) {

                    URL.revokeObjectURL(
                      workerUrl
                    );

                    workerUrl = null;
                  }

                }

              };


            activeWorker.onerror =
              function(event) {

                addOutput(
                  'error',
                  [
                    event.message ||
                    'حدث خطأ أثناء تنفيذ JavaScript.'
                  ]
                );

                finishExecution(true);

                if (activeWorker) {

                  try {
                    activeWorker.terminate();
                  } catch {}

                }

                activeWorker = null;

                if (workerUrl) {

                  URL.revokeObjectURL(
                    workerUrl
                  );

                  workerUrl = null;
                }

              };


            /*
             * Maximum execution time:
             * 5 seconds.
             */

            executionTimer =
              setTimeout(
                function() {

                  if (!activeWorker) {
                    return;
                  }


                  activeWorker.terminate();

                  activeWorker = null;


                  if (workerUrl) {

                    URL.revokeObjectURL(
                      workerUrl
                    );

                    workerUrl = null;
                  }


                  addOutput(
                    'error',
                    [
                      'تم إيقاف التنفيذ لأن الكود تجاوز الحد الأقصى للوقت (5 ثوانٍ).'
                    ]
                  );


                  executionTime.textContent =
                    'Timeout';


                  setStatus(
                    'error',
                    'تم إيقاف التنفيذ'
                  );


                  runBtn.disabled = false;

                  runBtn.innerHTML = `
                    <i class="fa-solid fa-play"></i>
                    تشغيل
                  `;

                  executionTimer = null;

                },
                5000
              );


            activeWorker.postMessage({
              code
            });


          } catch (error) {

            addOutput(
              'error',
              [
                error && error.message
                  ? error.message
                  : String(error)
              ]
            );

            finishExecution(true);

          }

        }


        /* =========================================
           RUN / STOP BUTTON
        ========================================= */

        runBtn.addEventListener(
          'click',
          function() {

            if (activeWorker) {

              stopWorker();

              setStatus(
                'warning',
                'تم إيقاف التنفيذ'
              );

              executionTime.textContent =
                `${(
                  performance.now() - startedAt
                ).toFixed(1)} ms`;


              runBtn.disabled = false;

              runBtn.innerHTML = `
                <i class="fa-solid fa-play"></i>
                تشغيل
              `;

              return;
            }


            runCode();

          }
        );


        /* =========================================
           EXAMPLE
        ========================================= */

        exampleBtn.addEventListener(
          'click',
          function() {

            stopWorker();

            codeInput.value =
              exampleCode;

            updateStats();

            resetOutput();

            setStatus(
              'idle',
              'تم تحميل المثال'
            );

            codeInput.focus();

          }
        );


        /* =========================================
           CLEAR CODE
        ========================================= */

        clearBtn.addEventListener(
          'click',
          function() {

            stopWorker();

            codeInput.value = '';

            updateStats();

            resetOutput();

            setStatus(
              'idle',
              'تم مسح الكود'
            );

            runBtn.disabled = false;

            runBtn.innerHTML = `
              <i class="fa-solid fa-play"></i>
              تشغيل
            `;

            codeInput.focus();

          }
        );


        /* =========================================
           CLEAR OUTPUT
        ========================================= */

        clearOutputBtn.addEventListener(
          'click',
          function() {

            resetOutput();

            setStatus(
              'idle',
              'جاهز للتشغيل'
            );

          }
        );


        /* =========================================
           INPUT
        ========================================= */

        codeInput.addEventListener(
          'input',
          updateStats
        );


        /* =========================================
           SCROLL LINE NUMBERS
        ========================================= */

        codeInput.addEventListener(
          'scroll',
          function() {

            lineNumbers.scrollTop =
              codeInput.scrollTop;

          }
        );


        /* =========================================
           TAB SUPPORT
        ========================================= */

        codeInput.addEventListener(
          'keydown',
          function(event) {

            if (event.key === 'Tab') {

              event.preventDefault();

              const start =
                codeInput.selectionStart;

              const end =
                codeInput.selectionEnd;

              codeInput.value =
                codeInput.value.substring(
                  0,
                  start
                ) +
                '  ' +
                codeInput.value.substring(
                  end
                );

              codeInput.selectionStart =
                codeInput.selectionEnd =
                  start + 2;

              updateStats();

            }


            /* Ctrl + Enter / Cmd + Enter */

            if (
              event.key === 'Enter' &&
              (event.ctrlKey || event.metaKey)
            ) {

              event.preventDefault();

              if (!activeWorker) {
                runCode();
              }

            }

          }
        );


        /* =========================================
           INITIAL STATE
        ========================================= */

        updateStats();

      })();
    </script>


