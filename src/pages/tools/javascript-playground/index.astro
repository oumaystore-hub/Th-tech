---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Playground - تشغيل JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "JavaScript Playground مجانية لتجربة وتشغيل أكواد JavaScript مباشرة من المتصفح مع عرض النتائج والأخطاء.";

const faqs = [
  {
    q: "ما هو JavaScript Playground؟",
    a: "أداة تفاعلية تسمح لك بكتابة وتشغيل JavaScript مباشرة من المتصفح ومشاهدة النتائج فوراً."
  },
  {
    q: "هل أحتاج إلى تثبيت JavaScript؟",
    a: "لا. يتم تشغيل JavaScript بواسطة المتصفح مباشرة، ولا تحتاج إلى تثبيت أي برنامج إضافي."
  },
  {
    q: "هل يمكن استخدام console.log؟",
    a: "نعم. يمكنك استخدام console.log وconsole.warn وconsole.error وconsole.info وستظهر المخرجات داخل قسم النتائج."
  },
  {
    q: "هل الكود الخاص بي يُرسل إلى الخادم؟",
    a: "لا. يتم تنفيذ الكود داخل المتصفح باستخدام Web Worker، ولا يتم إرسال الكود إلى خادم خارجي."
  },
  {
    q: "هل يمكن إيقاف كود لا نهائي؟",
    a: "نعم. يتم تشغيل الكود داخل Web Worker ويمكن إيقافه تلقائياً عند تجاوز وقت التنفيذ المحدد."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');

          if (saved === 'dark') {
            document.documentElement.classList.add('dark-mode');
          } else {
            document.documentElement.classList.remove('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page">
<!-- TH-BREADCRUMBS-START -->
<nav class="tool-breadcrumbs" aria-label="مسار التنقل">
