      margin:
        0 auto 17px;

      border-radius:
        16px;

      color:
        var(--primary);

      background:
        rgba(37,99,235,.09);

      font-size:
        1.2rem;
    }


    .step h3 {
      margin:
        0 0 7px;

      font-size:
        1rem;
    }


    .step p {
      margin: 0;

      color:
        var(--muted);

      font-size:
        .76rem;

      line-height:
        1.8;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width:
        900px;

      margin:
        auto;

      display:
        grid;

      gap:
        12px;
    }


    details {
      padding:
        0 20px;

      border-radius:
        15px;

      background:
        var(--card);

      border:
        1px solid
        var(--border);
    }


    summary {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding:
        19px 0;

      cursor:
        pointer;

      list-style:
        none;

      font-size:
        .86rem;

      font-weight:
        700;
    }


    summary::-webkit-details-marker {
      display:
        none;
    }


    summary i {
      color:
        var(--primary);

      font-size:
        .7rem;

      transition:
        transform .2s ease;
    }


    details[open] summary i {
      transform:
        rotate(180deg);
    }


    details p {
      margin: 0;

      padding:
        0 0 19px;

      color:
        var(--muted);

      font-size:
        .76rem;

      line-height:
        1.9;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 900px) {

      .palette-grid {
        grid-template-columns:
          repeat(3, 1fr);
      }

      .info-grid,
      .steps {
        grid-template-columns:
          1fr;
      }

    }


    @media (max-width: 800px) {

      .tool-hero {
        padding:
          40px 0 50px;
      }


      .hero-content {
        align-items:
          flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius:
          18px;

        font-size:
          1.6rem;
      }


      .outputs-grid {
        grid-template-columns:
          1fr;
      }


      .controls-grid {
        grid-template-columns:
          1fr;
      }


      .palette-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left:
          14px;

        padding-right:
          14px;
      }


      .tool-hero {
        padding:
          30px 0 40px;
      }


      .breadcrumb {
        font-size:
          .68rem;
      }


      .hero-content {
        gap:
          14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius:
          15px;

        font-size:
          1.35rem;
      }


      .hero-content h1 {
        font-size:
          1.75rem;
      }


      .hero-content p {
        font-size:
          .75rem;

        line-height:
          1.8;
      }


      .tool-section {
        padding:
          45px 0 65px;
      }


      .tool-card {
        border-radius:
          18px;
      }


      .toolbar {
        align-items:
          flex-start;

        flex-direction:
          column;

        padding:
          14px;
      }


      .toolbar-actions {
        width:
          100%;
      }


      .tool-btn {
        flex:
          1;
      }


      .generator {
        padding:
          12px;
      }


      .controls-panel,
      .palette-section {
        padding:
          16px;
      }


      .palette-grid {
        grid-template-columns:
          1fr 1fr;

        gap:
          9px;
      }


      .color-card {
        min-height:
          175px;

        border-radius:
          14px;

        padding:
          12px;
      }


      .color-hex {
        font-size:
          .72rem;
      }


      .color-rgb {
        font-size:
          .52rem;
      }


      .color-copy {
        width:
          30px;

        height:
          30px;

        right:
          8px;

        bottom:
          8px;
      }


      .generate-btn {
        width:
          100%;

        min-width:
          0;
      }


      .how-section,
      .faq-section {
        margin-top:
          70px;
      }


      .section-heading {
        margin-bottom:
          30px;
      }


      .section-heading h2 {
        font-size:
          1.7rem;
      }


      code {
        font-size:
          .65rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration:
          .01ms !important;

        transition-duration:
          .01ms !important;
      }


      html {
        scroll-behavior:
          auto;
      }

    }

  </style>

