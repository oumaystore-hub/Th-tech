---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Color Palette Generator - إنشاء لوحة ألوان أونلاين مجاناً | Th.Tech";

const description =
  "أداة مجانية لإنشاء لوحات ألوان متناسقة لمشاريع المواقع والتطبيقات مع أكواد HEX وRGB وCSS جاهزة للنسخ.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link
    rel="canonical"
    href="https://oumaystore-hub.github.io/Th-tech/tools/color-palette/"
  />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- تطبيق الوضع قبل ظهور الصفحة -->

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">

      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">

          <a href={base + "/"}>
            الرئيسية
          </a>

          <i class="fas fa-chevron-left"></i>

          <a href={base + "/tools/"}>
            الأدوات
          </a>

          <i class="fas fa-chevron-left"></i>

          <span>
            Color Palette
          </span>

        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-palette"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-palette"></i>
              Design Tools
            </span>

            <h1>
              Color <span>Palette</span>
            </h1>

            <p>
              أنشئ لوحة ألوان متناسقة لموقعك أو تطبيقك
              واحصل على أكواد HEX وRGB وCSS جاهزة للنسخ.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">

              <i class="fas fa-palette"></i>

              <span>
                Color Palette Generator
              </span>

            </div>

            <div class="toolbar-actions">

              <button
                id="randomBtn"
                class="tool-btn secondary"
                type="button"
              >
