    <script is:inline>
      (() => {
        const colorInput = document.getElementById("colorInput");
        const colorPicker = document.getElementById("colorPicker");
        const generateBtn = document.getElementById("generateBtn");
        const randomBtn = document.getElementById("randomBtn");
        const resetBtn = document.getElementById("resetBtn");
        const copyCssBtn = document.getElementById("copyCssBtn");
        const copyCssBtn2 = document.getElementById("copyCssBtn2");
        const paletteGrid = document.getElementById("paletteGrid");
        const detailsGrid = document.getElementById("detailsGrid");
        const cssOutput = document.getElementById("cssOutput");
        const statusTitle = document.getElementById("statusTitle");
        const statusText = document.getElementById("statusText");
        const colorCount = document.getElementById("colorCount");
        const statColors = document.getElementById("statColors");
        const statusBox = document.getElementById("statusBox");

        const schemeButtons = document.querySelectorAll(".scheme-btn");

        let currentScheme = "professional";
        let currentColors = [];

        function normalizeHex(value) {
          let clean = String(value || "").trim().replace("#", "");

          if (clean.length === 3) {
            clean =
              clean.charAt(0) +
              clean.charAt(0) +
              clean.charAt(1) +
              clean.charAt(1) +
              clean.charAt(2) +
              clean.charAt(2);
          }

          if (!/^[0-9a-fA-F]{6}$/.test(clean)) {
            return null;
          }

          return "#" + clean.toUpperCase();
        }

        function hexToRgb(hex) {
          const value = normalizeHex(hex);

          if (!value) {
            return null;
          }

          const number = parseInt(value.slice(1), 16);

          return {
            r: (number >> 16) & 255,
            g: (number >> 8) & 255,
            b: number & 255
          };
        }

        function rgbToHex(r, g, b) {
          const values = [r, g, b];

          return "#" + values.map(function(value) {
            const item = Math.max(0, Math.min(255, Math.round(value)));
            return item.toString(16).padStart(2, "0");
          }).join("").toUpperCase();
        }

        function rgbToHsl(r, g, b) {
          r /= 255;
          g /= 255;
          b /= 255;

          const max = Math.max(r, g, b);
          const min = Math.min(r, g, b);

          let h = 0;
          let s = 0;
          const l = (max + min) / 2;

          if (max !== min) {
            const d = max - min;

            s = l > 0.5
              ? d / (2 - max - min)
              : d / (max + min);

            switch (max) {
              case r:
                h = (g - b) / d + (g < b ? 6 : 0);
                break;

              case g:
                h = (b - r) / d + 2;
                break;

              case b:
                h = (r - g) / d + 4;
                break;
            }

            h /= 6;
          }

          return {
            h: Math.round(h * 360),
            s: Math.round(s * 100),
            l: Math.round(l * 100)
          };
        }

        function hslToRgb(h, s, l) {
          h = ((h % 360) + 360) % 360;
          s = Math.max(0, Math.min(100, s)) / 100;
          l = Math.max(0, Math.min(100, l)) / 100;

          const c = (1 - Math.abs(2 * l - 1)) * s;
          const x = c * (1 - Math.abs((h / 60) % 2 - 1));
          const m = l - c / 2;

          let r = 0;
          let g = 0;
          let b = 0;

          if (h < 60) {
            r = c;
            g = x;
          } else if (h < 120) {
            r = x;
            g = c;
          } else if (h < 180) {
            g = c;
            b = x;
          } else if (h < 240) {
            g = x;
            b = c;
          } else if (h < 300) {
            r = x;
            b = c;
          } else {
            r = c;
            b = x;
          }

          return {
            r: Math.round((r + m) * 255),
            g: Math.round((g + m) * 255),
            b: Math.round((b + m) * 255)
          };
        }

        function getColorData(hex) {
          const rgb = hexToRgb(hex);

          if (!rgb) {
            return null;
          }

          const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);

          return {
            hex: normalizeHex(hex),
            rgb: rgb,
            hsl: hsl
          };
        }

        function shiftHue(hex, amount, saturation, lightness) {
          const data = getColorData(hex);

          if (!data) {
            return hex;
          }

          const h = data.hsl.h + amount;
          const s = saturation === null ? data.hsl.s : saturation;
          const l = lightness === null ? data.hsl.l : lightness;

          const rgb = hslToRgb(h, s, l);

          return rgbToHex(rgb.r, rgb.g, rgb.b);
        }

        function lighten(hex, amount) {
          const data = getColorData(hex);

          if (!data) {
            return hex;
          }

          const l = Math.min(96, data.hsl.l + amount);

          const rgb = hslToRgb(
            data.hsl.h,
            data.hsl.s,
            l
          );

          return rgbToHex(rgb.r, rgb.g, rgb.b);
        }

        function darken(hex, amount) {
          const data = getColorData(hex);

          if (!data) {
            return hex;
          }

          const l = Math.max(8, data.hsl.l - amount);

          const rgb = hslToRgb(
            data.hsl.h,
            data.hsl.s,
            l
          );

          return rgbToHex(rgb.r, rgb.g, rgb.b);
        }

        function generateProfessional(base) {
          return [
            darken(base, 30),
            darken(base, 12),
            normalizeHex(base),
            lighten(base, 15),
            lighten(base, 32)
          ];
        }

        function generateAnalogous(base) {
          return [
            shiftHue(base, -45, null, null),
            shiftHue(base, -22, null, null),
            normalizeHex(base),
            shiftHue(base, 22, null, null),
            shiftHue(base, 45, null, null)
          ];
        }

        function generateComplementary(base) {
          return [
            darken(base, 20),
            normalizeHex(base),
            lighten(base, 20),
            shiftHue(base, 180, null, null),
            lighten(shiftHue(base, 180, null, null), 18)
          ];
        }

        function generateTriadic(base) {
          return [
            darken(base, 18),
            normalizeHex(base),
            lighten(base, 18),
            shiftHue(base, 120, null, null),
            shiftHue(base, 240, null, null)
          ];
        }

        function generateColors(base) {
          if (currentScheme === "analogous") {
            return generateAnalogous(base);
          }

          if (currentScheme === "complementary") {
            return generateComplementary(base);
          }

          if (currentScheme === "triadic") {
            return generateTriadic(base);
          }

          return generateProfessional(base);
        }

        function updateStatus(title, text, error) {
          statusTitle.textContent = title;
          statusText.textContent = text;

          if (error) {
            statusBox.classList.add("error");
          } else {
            statusBox.classList.remove("error");
          }
        }

        async function copyText(text, successMessage) {
          try {
            await navigator.clipboard.writeText(text);
            updateStatus(
              "تم النسخ بنجاح",
              successMessage,
              false
            );
          } catch {
            const area = document.createElement("textarea");
            area.value = text;
            area.style.position = "fixed";
            area.style.opacity = "0";

            document.body.appendChild(area);
            area.select();

            try {
              document.execCommand("copy");
            } catch {}

            area.remove();

            updateStatus(
              "تم النسخ",
              successMessage,
              false
            );
          }
        }

        function renderPalette() {
          paletteGrid.innerHTML = "";

          currentColors.forEach(function(hex, index) {
            const card = document.createElement("button");

            card.type = "button";
            card.className = "palette-color";
            card.style.background = hex;
            card.setAttribute("aria-label", "نسخ اللون " + hex);

            const overlay = document.createElement("span");
            overlay.className = "palette-overlay";

            const number = document.createElement("strong");
            number.textContent = String(index + 1).padStart(2, "0");

            const copy = document.createElement("span");
            copy.className = "palette-copy";
            copy.innerHTML = '<i class="fa-regular fa-copy"></i>';

            const value = document.createElement("span");
            value.className = "palette-value";
            value.textContent = hex;

            overlay.appendChild(number);
            overlay.appendChild(copy);

            card.appendChild(overlay);
            card.appendChild(value);

            card.addEventListener("click", function() {
              copyText(
                hex,
                "تم نسخ " + hex + " إلى الحافظة."
              );
            });

            paletteGrid.appendChild(card);
          });

          colorCount.textContent = currentColors.length;
          statColors.textContent = currentColors.length;
        }

        function renderDetails() {
          detailsGrid.innerHTML = "";

          currentColors.forEach(function(hex, index) {
            const data = getColorData(hex);

            if (!data) {
              return;
            }

            const card = document.createElement("div");
            card.className = "detail-card";

            const top = document.createElement("div");
            top.className = "detail-top";

            const colorPreview = document.createElement("span");
            colorPreview.className = "detail-preview";
            colorPreview.style.background = hex;

            const title = document.createElement("div");
            title.className = "detail-name";
            title.innerHTML =
              "<strong>Color " +
              String(index + 1).padStart(2, "0") +
              "</strong>" +
              "<span>" +
              hex +
              "</span>";

            top.appendChild(colorPreview);
            top.appendChild(title);

            const values = document.createElement("div");
            values.className = "detail-values";

            const hexRow = document.createElement("button");
            hexRow.type = "button";
            hexRow.className = "value-row";
            hexRow.innerHTML =
              '<span><i class="fa-solid fa-hashtag"></i> HEX</span>' +
              "<strong>" +
              data.hex +
              "</strong>";

            const rgbText =
              "rgb(" +
              data.rgb.r +
              ", " +
              data.rgb.g +
              ", " +
              data.rgb.b +
              ")";

            const rgbRow = document.createElement("button");
            rgbRow.type = "button";
            rgbRow.className = "value-row";
            rgbRow.innerHTML =
              '<span><i class="fa-solid fa-circle"></i> RGB</span>' +
              "<strong>" +
              rgbText +
              "</strong>";

            const hslText =
              "hsl(" +
              data.hsl.h +
              ", " +
              data.hsl.s +
              "%, " +
              data.hsl.l +
              "%)";

            const hslRow = document.createElement("button");
            hslRow.type = "button";
            hslRow.className = "value-row";
            hslRow.innerHTML =
              '<span><i class="fa-solid fa-sliders"></i> HSL</span>' +
              "<strong>" +
              hslText +
              "</strong>";

            hexRow.addEventListener("click", function() {
              copyText(
                data.hex,
                "تم نسخ قيمة HEX."
              );
            });

            rgbRow.addEventListener("click", function() {
              copyText(
                rgbText,
                "تم نسخ قيمة RGB."
              );
            });

            hslRow.addEventListener("click", function() {
              copyText(
                hslText,
                "تم نسخ قيمة HSL."
              );
            });

            values.appendChild(hexRow);
            values.appendChild(rgbRow);
            values.appendChild(hslRow);

            card.appendChild(top);
            card.appendChild(values);

            detailsGrid.appendChild(card);
          });
        }

        function generateCss() {
          let css = ":root {\n";

          currentColors.forEach(function(hex, index) {
            css +=
              "  --color-" +
              (index + 1) +
              ": " +
              hex +
              ";\n";
          });

          css += "}";

          cssOutput.textContent = css;

          return css;
        }

        function generate() {
          const normalized = normalizeHex(colorInput.value);

          if (!normalized) {
            updateStatus(
              "قيمة غير صحيحة",
              "أدخل لون HEX صالحاً مثل 2563EB.",
              true
            );
            colorInput.focus();
            return;
          }

          colorInput.value = normalized.slice(1);
          colorPicker.value = normalized;

          currentColors = generateColors(normalized);

          renderPalette();
          renderDetails();
          generateCss();

          updateStatus(
            "تم إنشاء اللوحة",
            "اضغط على أي لون أو قيمة لنسخها مباشرة.",
            false
          );
        }

        function randomColor() {
          const value = Math.floor(
            Math.random() * 16777215
          ).toString(16).padStart(6, "0").toUpperCase();

          colorInput.value = value;
          colorPicker.value = "#" + value;

          generate();
        }

        function reset() {
          currentScheme = "professional";

          schemeButtons.forEach(function(button) {
            button.classList.remove("active");

            if (button.dataset.scheme === "professional") {
              button.classList.add("active");
            }
          });

          colorInput.value = "2563EB";
          colorPicker.value = "#2563EB";

          generate();

          updateStatus(
            "تمت إعادة الضبط",
            "تمت استعادة اللون الافتراضي.",
            false
          );
        }

        schemeButtons.forEach(function(button) {
          button.addEventListener("click", function() {
            schemeButtons.forEach(function(item) {
              item.classList.remove("active");
            });

            button.classList.add("active");
            currentScheme = button.dataset.scheme;

            generate();
          });
        });

        colorPicker.addEventListener("input", function() {
          const value = colorPicker.value;

          colorInput.value = value.slice(1).toUpperCase();

          generate();
        });

        colorInput.addEventListener("input", function() {
          const normalized = normalizeHex(colorInput.value);

          if (normalized) {
            colorPicker.value = normalized;
          }
        });

        colorInput.addEventListener("keydown", function(event) {
          if (event.key === "Enter") {
            event.preventDefault();
            generate();
          }
        });

        generateBtn.addEventListener("click", generate);

        randomBtn.addEventListener("click", randomColor);

        resetBtn.addEventListener("click", reset);

        copyCssBtn.addEventListener("click", function() {
          copyText(
            generateCss(),
            "تم نسخ متغيرات CSS إلى الحافظة."
          );
        });

        copyCssBtn2.addEventListener("click", function() {
          copyText(
            generateCss(),
            "تم نسخ كود CSS إلى الحافظة."
          );
        });

        function syncTheme() {
          try {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function(event) {
          const target = event.target.closest("#theme-btn");

          if (target) {
            setTimeout(syncTheme, 0);
          }
        });

        generate();
      })();
    </script>

    <style>
      :root {
        --bg: #f5f8fc;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #e5eaf1;
        --text: #172033;
        --muted: #697586;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --cyan: #06b6d4;
        --success: #10b981;
        --danger: #ef4444;
        --shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
        --radius: 22px;
      }

      html.dark-mode {
        --bg: #08111f;
        --surface: #0d1828;
        --surface-2: #111e30;
        --border: #203047;
        --text: #edf4ff;
        --muted: #94a3b8;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
      }

      button,
      input {
        font-family: inherit;
      }

      button {
        cursor: pointer;
      }

      .page {
        min-height: 100vh;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 54px 0 76px;
        background:
          radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.13), transparent 30%),
          radial-gradient(circle at 15% 80%, rgba(6, 182, 212, 0.1), transparent 30%);
        border-bottom: 1px solid var(--border);
      }

      .hero-glow {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
      }

      .hero-glow-one {
        top: -150px;
        right: 10%;
        background: rgba(37, 99, 235, 0.1);
      }

      .hero-glow-two {
        bottom: -170px;
        left: 10%;
        background: rgba(6, 182, 212, 0.08);
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 34px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: 0.6;
      }

      .hero-content {
        position: relative;
        display: flex;
        align-items: center;
        gap: 26px;
        z-index: 1;
      }

      .hero-icon {
        width: 88px;
        height: 88px;
        flex: 0 0 88px;
        border-radius: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 36px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.25);
      }

      .hero-text {
        min-width: 0;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border: 1px solid rgba(37, 99, 235, 0.16);
        border-radius: 999px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.07);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
      }

      .hero h1 {
        margin: 0 0 10px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero p {
        max-width: 760px;
        margin: 0;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.9;
      }

      .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
      }

      .hero-tags span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 10px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
      }

      .hero-tags i {
        color: var(--primary);
      }

      /* TOOL */

      .tool-section {
        padding: 42px 0 80px;
      }

      .tool-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .tool-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 25px 28px;
        border-bottom: 1px solid var(--border);
      }

      .tool-title {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .tool-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.1);
        font-size: 20px;
      }

      .tool-title h2 {
        margin: 0 0 3px;
        font-size: 18px;
        font-weight: 800;
      }

      .tool-title p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
      }

      .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--success);
        font-size: 11px;
        font-weight: 700;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.08);
      }

      .live-indicator span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        animation: pulse 1.7s infinite;
      }

      @keyframes pulse {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
        }

        50% {
          opacity: 0.45;
          transform: scale(0.8);
        }
      }

      .control-panel {
        display: grid;
        grid-template-columns: minmax(260px, 0.8fr) 1.5fr;
        gap: 28px;
        padding: 28px;
        background: var(--surface-2);
        border-bottom: 1px solid var(--border);
      }

      .control-group label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 11px;
        font-size: 12px;
        font-weight: 800;
      }

      .control-group label i {
        color: var(--primary);
      }

      .color-input-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      #colorPicker {
        width: 58px;
        height: 52px;
        padding: 4px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        cursor: pointer;
      }

      .hex-input-box {
        flex: 1;
        display: flex;
        align-items: center;
        height: 52px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
        direction: ltr;
        transition: border 0.2s, box-shadow 0.2s;
      }

      .hex-input-box:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
      }

      .hex-input-box span {
        padding-left: 15px;
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
      }

      .hex-input-box input {
        width: 100%;
        height: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 0 14px 0 5px;
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
      }

      .scheme-buttons {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
      }

      .scheme-btn {
        min-height: 52px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
        color: var(--muted);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 10px;
        font-weight: 700;
        transition: all 0.2s;
      }

      .scheme-btn i {
        font-size: 15px;
      }

      .scheme-btn:hover {
        border-color: rgba(37, 99, 235, 0.4);
        color: var(--primary);
        transform: translateY(-2px);
      }

      .scheme-btn.active {
        color: var(--primary);
        border-color: rgba(37, 99, 235, 0.4);
        background: rgba(37, 99, 235, 0.08);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.08);
      }

      .action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 28px;
        border-bottom: 1px solid var(--border);
      }

      .action-main,
      .action-tools {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .btn {
        height: 46px;
        border: 0;
        border-radius: 13px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        font-size: 12px;
        font-weight: 800;
        transition: all 0.2s;
      }

      .btn-primary {
        color: white;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.28);
      }

      .btn-secondary {
        color: var(--text);
        border: 1px solid var(--border);
        background: var(--surface-2);
      }

      .btn-secondary:hover,
      .icon-action:hover {
        color: var(--primary);
        border-color: rgba(37, 99, 235, 0.35);
        transform: translateY(-2px);
      }

      .icon-action {
        height: 44px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--border);
        border-radius: 12px;
        color: var(--muted);
        background: var(--surface);
        font-size: 11px;
        font-weight: 700;
        transition: all 0.2s;
      }

      .status-box {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 28px 0;
        padding: 13px 15px;
        border-radius: 13px;
        background: rgba(16, 185, 129, 0.07);
        border: 1px solid rgba(16, 185, 129, 0.13);
      }

      .status-box.error {
        background: rgba(239, 68, 68, 0.07);
        border-color: rgba(239, 68, 68, 0.15);
      }

      .status-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--success);
        background: rgba(16, 185, 129, 0.1);
      }

      .status-box.error .status-icon {
        color: var(--danger);
        background: rgba(239, 68, 68, 0.1);
      }

      .status-box strong,
      .status-box span {
        display: block;
      }

      .status-box strong {
        font-size: 11px;
        margin-bottom: 2px;
      }

      .status-box span {
        color: var(--muted);
        font-size: 10px;
      }

      /* PALETTE */

      .palette-area,
      .details-area,
      .css-section {
        padding: 30px 28px;
      }

      .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
      }

      .section-kicker {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.6px;
        margin-bottom: 4px;
      }

      .section-heading h3,
      .section-heading h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
      }

      .palette-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 11px;
      }

      .palette-count i {
        color: var(--primary);
      }

      .palette-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        min-height: 270px;
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid var(--border);
      }

      .palette-color {
        position: relative;
        min-height: 270px;
        border: 0;
        padding: 0;
        color: white;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        transition: flex 0.3s, filter 0.2s;
      }

      .palette-color:hover {
        filter: brightness(1.08);
        z-index: 2;
      }

      .palette-overlay {
        position: absolute;
        inset: 0;
        padding: 15px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
      }

      .palette-overlay strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
      }

      .palette-copy {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.17);
        backdrop-filter: blur(6px);
      }

      .palette-value {
        position: relative;
        z-index: 2;
        margin-bottom: 18px;
        padding: 7px 10px;
        border-radius: 9px;
        background: rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(8px);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 600;
      }

      /* DETAILS */

      .details-area {
        border-top: 1px solid var(--border);
      }

      .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .detail-card {
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .detail-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
      }

      .detail-preview {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
      }

      .detail-name strong,
      .detail-name span {
        display: block;
      }

      .detail-name strong {
        font-size: 11px;
      }

      .detail-name span {
        margin-top: 2px;
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
      }

      .detail-values {
        display: grid;
        gap: 6px;
      }

      .value-row {
        width: 100%;
        min-height: 36px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: var(--surface);
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 10px;
        transition: all 0.2s;
      }

      .value-row:hover {
        border-color: rgba(37, 99, 235, 0.35);
        color: var(--primary);
      }

      .value-row span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 9px;
      }

      .value-row strong {
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        direction: ltr;
      }

      /* CSS */

      .css-section {
        border-top: 1px solid var(--border);
        background: var(--surface-2);
      }

      .css-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 17px;
      }

      .copy-code-btn {
        height: 38px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
        transition: all 0.2s;
      }

      .copy-code-btn:hover {
        color: var(--primary);
        border-color: rgba(37, 99, 235, 0.35);
      }

      .code-box {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: #0b1220;
      }

      .code-top {
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 14px;
        color: #94a3b8;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        direction: ltr;
      }

      .window-dots {
        display: flex;
        gap: 5px;
      }

      .window-dots span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #475569;
      }

      .code-box pre {
        min-height: 150px;
        margin: 0;
        padding: 18px;
        overflow-x: auto;
        color: #dbeafe;
        direction: ltr;
        text-align: left;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        line-height: 1.8;
        white-space: pre-wrap;
      }

      /* STATS */

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 18px;
      }

      .stat-card {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
        box-shadow: 0 7px 25px rgba(15, 23, 42, 0.04);
      }

      .stat-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
      }

      .stat-icon.blue {
        color: #2563eb;
        background: rgba(37, 99, 235, 0.1);
      }

      .stat-icon.purple {
        color: #8b5cf6;
        background: rgba(139, 92, 246, 0.1);
      }

      .stat-icon.green {
        color: #10b981;
        background: rgba(16, 185, 129, 0.1);
      }

      .stat-icon.orange {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.1);
      }

      .stat-card strong,
      .stat-card span {
        display: block;
      }

      .stat-card strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
      }

      .stat-card span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 9px;
      }

      /* PRIVACY */

      .privacy-card {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 18px;
        padding: 18px;
        border: 1px solid rgba(16, 185, 129, 0.16);
        border-radius: 17px;
        background: rgba(16, 185, 129, 0.05);
      }

      .privacy-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--success);
        background: rgba(16, 185, 129, 0.1);
        border-radius: 13px;
        font-size: 18px;
      }

      .privacy-content {
        flex: 1;
      }

      .privacy-content h3 {
        margin: 0 0 3px;
        font-size: 12px;
      }

      .privacy-content p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.8;
      }

      .privacy-check {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--success);
        font-size: 10px;
        font-weight: 700;
      }

      /* INFO */

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 18px;
      }

      .info-card {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
      }

      .info-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        border-radius: 12px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 13px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 2;
      }

      /* HOW */

      .how-section,
      .faq-section {
        margin-top: 68px;
      }

      .centered {
        display: block;
        text-align: center;
        margin-bottom: 28px;
      }

      .centered .section-kicker {
        justify-content: center;
      }

      .centered h2 {
        font-size: 24px;
        margin-bottom: 6px;
      }

      .centered p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      .steps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .step-card {
        position: relative;
        padding: 26px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        overflow: hidden;
      }

      .step-number {
        position: absolute;
        top: 14px;
        left: 17px;
        color: var(--border);
        font-family: "JetBrains Mono", monospace;
        font-size: 22px;
        font-weight: 700;
      }

      .step-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
        margin-bottom: 17px;
      }

      .step-card h3 {
        margin: 0 0 7px;
        font-size: 13px;
      }

      .step-card p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.9;
      }

      /* FAQ */

      .faq-list {
        display: grid;
        gap: 9px;
      }

      .faq-list details {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
      }

      .faq-list summary {
        min-height: 55px;
        padding: 0 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        cursor: pointer;
        list-style: none;
        font-size: 11px;
        font-weight: 700;
      }

      .faq-list summary::-webkit-details-marker {
        display: none;
      }

      .faq-list summary i {
        color: var(--muted);
        font-size: 10px;
        transition: transform 0.2s;
      }

      .faq-list details[open] summary i {
        transform: rotate(180deg);
      }

      .faq-list details p {
        margin: 0;
        padding: 0 17px 17px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .control-panel {
          grid-template-columns: 1fr;
        }

        .scheme-buttons {
          grid-template-columns: repeat(4, 1fr);
        }

        .palette-grid {
          grid-template-columns: repeat(5, 1fr);
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .hero {
          padding: 35px 0 55px;
        }

        .hero-content {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero-icon {
          width: 70px;
          height: 70px;
          flex-basis: 70px;
          border-radius: 20px;
          font-size: 28px;
        }

        .hero p {
          font-size: 13px;
        }

        .tool-header,
        .action-bar,
        .css-header {
          align-items: flex-start;
          flex-direction: column;
        }

        .action-bar {
          gap: 12px;
        }

        .action-main,
        .action-tools {
          width: 100%;
        }

        .action-main .btn {
          flex: 1;
        }

        .action-tools .icon-action {
          flex: 1;
          justify-content: center;
        }

        .scheme-buttons {
          grid-template-columns: repeat(2, 1fr);
        }

        .palette-grid {
          grid-template-columns: 1fr;
        }

        .palette-color {
          min-height: 130px;
        }

        .details-grid {
          grid-template-columns: 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .privacy-card {
          align-items: flex-start;
          flex-wrap: wrap;
        }

        .privacy-content {
          min-width: calc(100% - 60px);
        }

        .privacy-check {
          margin-right: 60px;
        }

        .steps-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 480px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .tool-header,
        .control-panel,
        .action-bar,
        .palette-area,
        .details-area,
        .css-section {
          padding-left: 16px;
          padding-right: 16px;
        }

        .status-box {
          margin-left: 16px;
          margin-right: 16px;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .palette-color {
          min-height: 115px;
        }

        .privacy-check {
          margin-right: 0;
        }
      }
    </style>
  </body>
</html>
