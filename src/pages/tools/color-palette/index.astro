            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-wand-magic-sparkles"></i>
            </div>

            <div>

              <h3>
                ألوان متناسقة
              </h3>

              <p>
                أنشئ مجموعات ألوان متناسقة باستخدام
                قواعد الألوان المعروفة في التصميم.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-copy"></i>
            </div>

            <div>

              <h3>
                نسخ سريع
              </h3>

              <p>
                انسخ أكواد HEX أو CSS مباشرة
                واستخدمها في مشروعك.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>
                معالجة محلية
              </h3>

              <p>
                تعمل الأداة مباشرة داخل المتصفح
                ولا تحتاج إلى إرسال بيانات إلى خادم خارجي.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-info"></i>

              طريقة الاستخدام

            </span>

            <h2>

              كيف تستخدم

              <span>
                Color Palette؟
              </span>

            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-eye-dropper"></i>
              </div>

              <h3>
                اختر اللون
              </h3>

              <p>
                حدد اللون الأساسي الذي تريد بناء
                لوحة الألوان حوله.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-sliders"></i>
              </div>

              <h3>
                اختر النمط
              </h3>

              <p>
                اختر Analogous أو Complementary
                أو Triadic وغيرها.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>
                انسخ الألوان
              </h3>

              <p>
                انسخ أكواد HEX أو CSS
                واستخدمها مباشرة في مشروعك.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-question"></i>

              الأسئلة الشائعة

            </span>

            <h2>

              أسئلة حول

              <span>
                Color Palette
              </span>

            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>

                ما هي Color Palette؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                لوحة الألوان هي مجموعة من الألوان
                يتم اختيارها معاً لإنشاء تصميم بصري
                متناسق للمواقع والتطبيقات والمشاريع.
              </p>

            </details>


            <details>

              <summary>

                ما الفرق بين Analogous وComplementary؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                الألوان Analogous تكون متقاربة على
                عجلة الألوان، بينما Complementary
                تعتمد على ألوان متقابلة لإظهار التباين.
              </p>

            </details>


            <details>

              <summary>

                هل يمكن استخدام الأكواد في CSS؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                نعم. توفر الأداة كود CSS جاهزاً
                باستخدام متغيرات CSS مثل
                --color-1 و--color-2 وغيرها.
              </p>

            </details>


            <details>

              <summary>

                هل يتم إرسال الألوان إلى الخادم؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                لا. جميع عمليات إنشاء وتحويل الألوان
                تتم محلياً داخل المتصفح باستخدام JavaScript.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* ================= THEME ================= */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

      };


      try {

        const savedTheme =
          localStorage.getItem('theme');

        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }

      } catch {}


      window.addEventListener(
        'themeChange',
        (event) => {

          const theme =
            event && event.detail;

          if (
            theme === 'dark' ||
            theme === 'light'
          ) {

            applyTheme(
              theme === 'dark'
            );

          }

        }
      );


      document.addEventListener(
        'click',
        (event) => {

          const target =
            event.target;

          if (
            target &&
            target.closest &&
            target.closest('#theme-btn')
          ) {

            setTimeout(
              () => {

                try {

                  const theme =
                    localStorage.getItem('theme');

                  applyTheme(
                    theme === 'dark'
                  );

                } catch {}

              },
              0
            );

          }

        }
      );


      /* ================= ELEMENTS ================= */

      const baseColor =
        document.getElementById('baseColor');

      const hexInput =
        document.getElementById('hexInput');

      const paletteType =
        document.getElementById('paletteType');

      const generateBtn =
        document.getElementById('generateBtn');

      const randomBtn =
        document.getElementById('randomBtn');

      const clearBtn =
        document.getElementById('clearBtn');

      const copyBtn =
        document.getElementById('copyBtn');

      const copyHexBtn =
        document.getElementById('copyHexBtn');

      const copyCssBtn =
        document.getElementById('copyCssBtn');

      const paletteGrid =
        document.getElementById('paletteGrid');

      const hexOutput =
        document.getElementById('hexOutput');

      const cssOutput =
        document.getElementById('cssOutput');

      const status =
        document.getElementById('status');

      const statusIcon =
        document.getElementById('statusIcon');

      const statusText =
        document.getElementById('statusText');


      let colors = [];


      /* ================= STATUS ================= */

      const showStatus = (
        message,
        isError
      ) => {

        status.classList.remove('hidden');

        status.classList.toggle(
          'error',
          !!isError
        );

        statusIcon.className =
          isError
            ? 'fas fa-circle-exclamation'
            : 'fas fa-check-circle';

        statusText.textContent =
          message;

      };


      const hideStatus = () => {

        status.classList.add('hidden');

      };


      /* ================= COLOR HELPERS ================= */

      const normalizeHex = (value) => {

        let hex =
          String(value || '').trim();

        if (
          hex.charAt(0) !== '#'
        ) {

          hex =
            '#' + hex;

        }

        if (
          /^#[0-9a-fA-F]{3}$/.test(hex)
        ) {

          hex =
            '#' +
            hex.charAt(1) +
            hex.charAt(1) +
            hex.charAt(2) +
            hex.charAt(2) +
            hex.charAt(3) +
            hex.charAt(3);

        }

        if (
          !/^#[0-9a-fA-F]{6}$/.test(hex)
        ) {

          return null;

        }

        return hex.toUpperCase();

      };


      const hexToRgb = (hex) => {

        const value =
          normalizeHex(hex);

        if (!value) {
          return null;
        }

        return {
          r: parseInt(
            value.substring(1, 3),
            16
          ),

          g: parseInt(
            value.substring(3, 5),
            16
          ),

          b: parseInt(
            value.substring(5, 7),
            16
          )
        };

      };


      const rgbToHex = (
        r,
        g,
        b
      ) => {

        const toHex = (value) => {

          return Math.max(
            0,
            Math.min(
              255,
              Math.round(value)
            )
          )
            .toString(16)
            .padStart(2, '0');

        };

        return (
          '#' +
          toHex(r) +
          toHex(g) +
          toHex(b)
        ).toUpperCase();

      };


      const rgbToHsl = (
        r,
        g,
        b
      ) => {

        r /= 255;
        g /= 255;
        b /= 255;

        const max =
          Math.max(r, g, b);

        const min =
          Math.min(r, g, b);

        let h = 0;
        let s = 0;

        const l =
          (max + min) / 2;

        const d =
          max - min;

        if (d !== 0) {

          s =
            l > 0.5
              ? d / (2 - max - min)
              : d / (max + min);

          switch (max) {

            case r:

              h =
                (g - b) / d +
                (g < b ? 6 : 0);

              break;

            case g:

              h =
                (b - r) / d + 2;

              break;

            default:

              h =
                (r - g) / d + 4;

              break;

          }

          h *= 60;

        }

        return {
          h,
          s: s * 100,
          l: l * 100
        };

      };


      const hslToRgb = (
        h,
        s,
        l
      ) => {

        s /= 100;
        l /= 100;

        const c =
          (1 - Math.abs(2 * l - 1)) * s;

        const x =
          c *
          (1 -
            Math.abs(
              ((h / 60) % 2) - 1
            )
          );

        const m =
          l - c / 2;

        let r = 0;
        let g = 0;
        let b = 0;

        if (h < 60) {
          r = c;
          g = x;
        } else if (h < 120) {
          r = x;
          g = c;
        } else if (h < 180) {
          g = c;
          b = x;
        } else if (h < 240) {
          g = x;
          b = c;
        } else if (h < 300) {
          r = x;
          b = c;
        } else {
          r = c;
          b = x;
        }

        return rgbToHex(
          (r + m) * 255,
          (g + m) * 255,
          (b + m) * 255
        );

      };


      const rotateColor = (
        hex,
        degrees
      ) => {

        const rgb =
          hexToRgb(hex);

        if (!rgb) {
          return '#2563EB';
        }

        const hsl =
          rgbToHsl(
            rgb.r,
            rgb.g,
            rgb.b
          );

        let hue =
          (hsl.h + degrees) % 360;

        if (hue < 0) {
          hue += 360;
        }

        return hslToRgb(
          hue,
          hsl.s,
          hsl.l
        );

      };


      const adjustLightness = (
        hex,
        amount
      ) => {

        const rgb =
          hexToRgb(hex);

        if (!rgb) {
          return '#2563EB';
        }

        const hsl =
          rgbToHsl(
            rgb.r,
            rgb.g,
            rgb.b
          );

        const lightness =
          Math.max(
            8,
            Math.min(
              92,
              hsl.l + amount
            )
          );

        return hslToRgb(
          hsl.h,
          hsl.s,
          lightness
        );

      };


      /* ================= RANDOM ================= */

      const randomHex = () => {

        const value =
          Math.floor(
            Math.random() * 16777215
          );

        return (
          '#' +
          value
            .toString(16)
            .padStart(6, '0')
        ).toUpperCase();

      };


      /* ================= PALETTE ================= */

      const createPalette = (
        base,
        type
      ) => {

        const result = [];

        if (type === 'complementary') {

          result.push(base);
          result.push(
            rotateColor(base, 180)
          );
          result.push(
            adjustLightness(base, 22)
          );
          result.push(
            adjustLightness(
              rotateColor(base, 180),
              22
            )
          );
          result.push(
            adjustLightness(base, -22)
          );

        } else if (type === 'analogous') {

          result.push(
            rotateColor(base, -30)
          );

          result.push(
            rotateColor(base, -15)
          );

          result.push(base);

          result.push(
            rotateColor(base, 15)
          );

          result.push(
            rotateColor(base, 30)
          );

        } else if (type === 'triadic') {

          result.push(base);

          result.push(
            rotateColor(base, 120)
          );

          result.push(
            rotateColor(base, 240)
          );

          result.push(
            adjustLightness(base, 20)
          );

          result.push(
            adjustLightness(
              rotateColor(base, 120),
              20
            )
          );

        } else if (type === 'split') {

          result.push(base);

          result.push(
            rotateColor(base, 150)
          );

          result.push(
            rotateColor(base, 210)
          );

          result.push(
            adjustLightness(base, 20)
          );

          result.push(
            adjustLightness(
              rotateColor(base, 180),
              -15
            )
          );

        } else if (type === 'monochromatic') {

          result.push(
            adjustLightness(base, -35)
          );

          result.push(
            adjustLightness(base, -18)
          );

          result.push(base);

          result.push(
            adjustLightness(base, 18)
          );

          result.push(
            adjustLightness(base, 35)
          );

        } else {

          for (let i = 0; i < 5; i++) {
            result.push(
              randomHex()
            );
          }

        }

        return result;

      };


      /* ================= TEXT ================= */

      const getContrastColor = (hex) => {

        const rgb =
          hexToRgb(hex);

        if (!rgb) {
          return '#FFFFFF';
        }

        const brightness =
          (
            rgb.r * 299 +
            rgb.g * 587 +
            rgb.b * 114
          ) / 1000;

        return brightness > 155
          ? '#0F172A'
          : '#FFFFFF';

      };


      const createRgbString = (hex) => {

        const rgb =
          hexToRgb(hex);

        if (!rgb) {
          return 'rgb(0, 0, 0)';
        }

        return (
          'rgb(' +
          rgb.r +
          ', ' +
          rgb.g +
          ', ' +
          rgb.b +
          ')'
        );

      };


      /* ================= RENDER ================= */

      const renderPalette = () => {

        paletteGrid.innerHTML = '';

        colors.forEach(
          (color, index) => {

            const card =
              document.createElement('div');

            card.className =
              'color-card';

            card.setAttribute(
              'data-color',
              color
            );

            card.style.background =
              color;

            card.style.color =
              getContrastColor(color);

            const number =
              String(index + 1)
                .padStart(2, '0');

            card.innerHTML =
              '<div class="color-number">' +
              number +
              '</div>' +

              '<div class="color-center">' +

              '<div class="color-hex">' +
              color +
              '</div>' +

              '<div class="color-rgb">' +
              createRgbString(color) +
              '</div>' +

              '</div>' +

              '<button ' +
              'class="color-copy" ' +
              'type="button" ' +
              'title="نسخ اللون">' +

              '<i class="fas fa-copy"></i>' +

              '</button>';

            paletteGrid.appendChild(card);

          }
        );

        document
          .querySelectorAll('.color-copy')
          .forEach(
            (button) => {

              button.addEventListener(
                'click',
                (event) => {

                  event.stopPropagation();

                  const card =
                    button.closest(
                      '.color-card'
                    );

                  const color =
                    card &&
                    card.getAttribute(
                      'data-color'
                    );

                  if (color) {

                    copyText(color)
                      .then(
                        (success) => {

                          if (success) {

                            showStatus(
                              'تم نسخ ' +
                              color +
                              ' بنجاح.'
                            );

                          } else {

                            showStatus(
                              'تعذر نسخ اللون.',
                              true
                            );

                          }

                        }
                      );

                  }

                }
              );

            }
          );

      };


      /* ================= OUTPUTS ================= */

      const updateOutputs = () => {

        hexOutput.textContent =
          colors.join(' · ');

        let css =
          ':root {\n';

        colors.forEach(
          (color, index) => {

            css +=
              '  --color-' +
              (index + 1) +
              ': ' +
              color +
              ';\n';

          }
        );

        css +=
          '}';

        cssOutput.textContent =
          css;

      };


      /* ================= GENERATE ================= */

      const generatePalette = () => {

        hideStatus();

        const value =
          normalizeHex(
            hexInput.value
          );

        if (!value) {

          showStatus(
            'أدخل لون HEX صحيحاً مثل #2563EB.',
            true
          );

          hexInput.focus();

          return;

        }

        const type =
          paletteType.value;

        colors =
          createPalette(
            value,
            type
          );

        baseColor.value =
          value;

        hexInput.value =
          value;

        renderPalette();

        updateOutputs();

        showStatus(
          'تم إنشاء لوحة ألوان جديدة بنجاح.'
        );

      };


      /* ================= COPY ================= */

      const copyText = async (
        text
      ) => {

        try {

          await navigator.clipboard.writeText(
            text
          );

          return true;

        } catch {

          try {

            const textarea =
              document.createElement(
                'textarea'
              );

            textarea.value =
              text;

            textarea.style.position =
              'fixed';

            textarea.style.opacity =
              '0';

            document.body.appendChild(
              textarea
            );

            textarea.focus();

            textarea.select();

            const success =
              document.execCommand(
                'copy'
              );

            textarea.remove();

            return success;

          } catch {

            return false;

          }

        }

      };


      const copyAllColors = async () => {

        if (!colors.length) {

          showStatus(
            'أنشئ لوحة ألوان أولاً.',
            true
          );

          return;

        }

        const success =
          await copyText(
            colors.join('\n')
          );

        if (success) {

          showStatus(
            'تم نسخ جميع الألوان بنجاح.'
          );

          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          setTimeout(
            () => {

              copyBtn.innerHTML =
                '<i class="fas fa-copy"></i> نسخ الألوان';

            },
            1800
          );

        } else {

          showStatus(
            'تعذر نسخ الألوان.',
            true
          );

        }

      };


      const copyHex = async () => {

        if (!colors.length) {

          showStatus(
            'أنشئ لوحة ألوان أولاً.',
            true
          );

          return;

        }

        const success =
          await copyText(
            colors.join(' · ')
          );

        if (success) {

          showStatus(
            'تم نسخ أكواد HEX.'
          );

        } else {

          showStatus(
            'تعذر نسخ أكواد HEX.',
            true
          );

        }

      };


      const copyCss = async () => {

        const text =
          cssOutput.textContent || '';

        if (!text) {

          showStatus(
            'لا يوجد كود CSS لنسخه.',
            true
          );

          return;

        }

        const success =
          await copyText(text);

        if (success) {

          showStatus(
            'تم نسخ كود CSS بنجاح.'
          );

          copyCssBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';

          setTimeout(
            () => {

              copyCssBtn.innerHTML =
                '<i class="fas fa-copy"></i> نسخ';

            },
            1800
          );

        } else {

          showStatus(
            'تعذر نسخ كود CSS.',
            true
          );

        }

      };


      /* ================= CLEAR ================= */

      const clearAll = () => {

        colors = [];

        paletteGrid.innerHTML =
          '';

        hexOutput.textContent =
          '';

        cssOutput.textContent =
          '';

        hexInput.value =
          '#2563EB';

        baseColor.value =
          '#2563eb';

        paletteType.value =
          'analogous';

        hideStatus();

      };


      /* ================= COLOR INPUT ================= */

      baseColor.addEventListener(
        'input',
        () => {

          hexInput.value =
            baseColor.value.toUpperCase();

        }
      );


      baseColor.addEventListener(
        'change',
        () => {

          generatePalette();

        }
      );


      hexInput.addEventListener(
        'input',
        () => {

          const value =
            normalizeHex(
              hexInput.value
            );

          if (value) {

            baseColor.value =
              value;

          }

        }
      );


      hexInput.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key === 'Enter'
          ) {

            generatePalette();

          }

        }
      );


      paletteType.addEventListener(
        'change',
        () => {

          generatePalette();

        }
      );


      /* ================= EVENTS ================= */

      generateBtn.addEventListener(
        'click',
        generatePalette
      );


      randomBtn.addEventListener(
        'click',
        () => {

          const color =
            randomHex();

          baseColor.value =
            color;

          hexInput.value =
            color;

          paletteType.value =
            'random';

          generatePalette();

        }
      );


      clearBtn.addEventListener(
        'click',
        clearAll
      );


      copyBtn.addEventListener(
        'click',
        copyAllColors
      );


      copyHexBtn.addEventListener(
        'click',
        copyHex
      );


      copyCssBtn.addEventListener(
        'click',
        copyCss
      );


      paletteGrid.addEventListener(
        'click',
        (event) => {

          const card =
            event.target.closest(
              '.color-card'
            );

          if (!card) {
            return;
          }

          if (
            event.target.closest(
              '.color-copy'
            )
          ) {
            return;
          }

          const color =
            card.getAttribute(
              'data-color'
            );

          if (color) {

            copyText(color)
              .then(
                (success) => {

                  if (success) {

                    showStatus(
                      'تم نسخ اللون ' +
                      color +
                      '.'
                    );

                  }

                }
              );

          }

        }
      );


      /* ================= INITIAL ================= */

      generatePalette();

    })();
  </script>


