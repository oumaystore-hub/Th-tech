---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Color Palette Generator - إنشاء لوحة ألوان أونلاين مجاناً | Th.Tech";

const description =
  "أداة Color Palette مجانية لإنشاء لوحات ألوان متناسقة مباشرة داخل المتصفح، مع أكواد HEX وRGB وإمكانية نسخ كل لون أو اللوحة كاملة.";

const faqs = [
  {
    q: "ما هي Color Palette؟",
    a: "لوحة الألوان هي مجموعة من الألوان المتناسقة التي يمكن استخدامها في تصميم المواقع والتطبيقات والواجهات والمشاريع الرقمية."
  },
  {
    q: "كم لوناً يمكن إنشاءه؟",
    a: "يمكن للأداة إنشاء لوحة مكونة من خمسة ألوان، مع إمكانية إعادة توليد لوحة جديدة في أي وقت."
  },
  {
    q: "هل يمكن نسخ أكواد الألوان؟",
    a: "نعم. يمكنك نسخ كود HEX لأي لون بشكل منفصل، أو نسخ جميع ألوان اللوحة دفعة واحدة."
  },
  {
    q: "هل يتم إرسال الألوان إلى الخادم؟",
    a: "لا. يتم إنشاء الألوان ومعالجتها بالكامل داخل المتصفح باستخدام JavaScript ولا يتم إرسال البيانات إلى خادم خارجي."
  }
];
---

<html lang="ar" dir="rtl">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/color-palette/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>

</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
