                لوحة عشوائية
              </button>

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ الألوان
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Generator -->

          <div class="generator">

            <!-- Controls -->

            <div class="controls-panel">

              <div class="panel-title">

                <i class="fas fa-sliders"></i>

                إعدادات اللوحة

              </div>

              <div class="controls-grid">

