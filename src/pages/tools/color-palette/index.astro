  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const generateBtn =
        document.getElementById("generateBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyAllBtn =
        document.getElementById("copyAllBtn");

      const copyCssBtn =
        document.getElementById("copyCssBtn");

      const copyHexBtn =
        document.getElementById("copyHexBtn");

      const paletteGrid =
        document.getElementById("paletteGrid");

      const hexOutput =
        document.getElementById("hexOutput");

      const cssOutput =
        document.getElementById("cssOutput");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const statStatus =
        document.getElementById("statStatus");


      let colors = [
        "#2563EB",
        "#06B6D4",
        "#14B8A6",
        "#8B5CF6",
        "#F59E0B"
      ];


      function randomColor() {

        const value =
          Math.floor(
            Math.random() * 16777216
          );

        return (
          "#" +
          value
            .toString(16)
            .padStart(6, "0")
            .toUpperCase()
        );

      }


      function hexToRgb(hex) {

        const clean =
          hex.replace("#", "");

        const value =
          parseInt(clean, 16);

        return {
          r: (value >> 16) & 255,
          g: (value >> 8) & 255,
          b: value & 255
        };

      }


      function createRgbString(hex) {

        const rgb =
          hexToRgb(hex);

        return (
          "rgb(" +
          rgb.r +
          ", " +
          rgb.g +
          ", " +
          rgb.b +
          ")"
        );

      }


      function renderPalette() {

        if (!paletteGrid) {
          return;
        }

        paletteGrid.innerHTML = "";


        colors.forEach(
          function(color, index) {

            const card =
              document.createElement("div");

            card.className =
              "color-card";


            card.innerHTML =
              '<div ' +
                'class="color-preview" ' +
                'data-color="' + color + '" ' +
                'style="background:' + color + '">' +

                '<button ' +
                  'class="color-copy-icon" ' +
                  'data-copy="' + color + '" ' +
                  'aria-label="نسخ اللون" ' +
                  'type="button">' +

                  '<i class="fa-regular fa-copy"></i>' +

                '</button>' +

                '<span class="color-number">' +
                  String(index + 1).padStart(2, "0") +
                '</span>' +

              '</div>' +

              '<div class="color-info">' +

                '<strong class="hex-value">' +
                  color +
                '</strong>' +

                '<span class="rgb-value">' +
                  createRgbString(color) +
                '</span>' +

                '<button ' +
                  'class="copy-color-btn" ' +
                  'data-copy="' + color + '" ' +
                  'type="button">' +

                  '<i class="fa-regular fa-copy"></i>' +
                  ' نسخ HEX' +

                '</button>' +

              '</div>';


            paletteGrid.appendChild(card);

          }
        );


        updateOutputs();

      }


      function updateOutputs() {

        if (hexOutput) {

          hexOutput.textContent =
            colors.join(" · ");

        }


        if (cssOutput) {

          cssOutput.textContent =
            ":root {\n" +
            "  --color-1: " + colors[0] + ";\n" +
            "  --color-2: " + colors[1] + ";\n" +
            "  --color-3: " + colors[2] + ";\n" +
            "  --color-4: " + colors[3] + ";\n" +
            "  --color-5: " + colors[4] + ";\n" +
            "}";

        }


        if (statStatus) {

          statStatus.textContent =
            "جاهز";

        }

      }


      function generatePalette() {

        const generated = [];


        for (let i = 0; i < 5; i++) {

          let color =
            randomColor();

          let attempts = 0;


          while (
            generated.includes(color) &&
            attempts < 10
          ) {

            color =
              randomColor();

            attempts++;

          }


          generated.push(color);

        }


        colors =
          generated;


        renderPalette();


        if (resultBox) {

          resultBox.classList.remove(
            "error"
          );

          resultBox.classList.add(
            "success"
          );

        }


        if (resultIcon) {

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-check"></i>';

        }


        if (resultTitle) {

          resultTitle.textContent =
            "تم إنشاء لوحة جديدة";

        }


        if (resultMessage) {

          resultMessage.textContent =
            "تم إنشاء خمسة ألوان جديدة بنجاح.";

        }


        if (statStatus) {

          statStatus.textContent =
            "تم الإنشاء";

        }

      }


      function clearPalette() {

        colors = [
          "#FFFFFF",
          "#E5E7EB",
          "#9CA3AF",
          "#4B5563",
          "#111827"
        ];


        renderPalette();


        if (resultBox) {

          resultBox.classList.remove(
            "success",
            "error"
          );

        }


        if (resultIcon) {

          resultIcon.innerHTML =
            '<i class="fa-solid fa-palette"></i>';

        }


        if (resultTitle) {

          resultTitle.textContent =
            "تم مسح اللوحة";

        }


        if (resultMessage) {

          resultMessage.textContent =
            "يمكنك إنشاء لوحة جديدة في أي وقت.";

        }


        if (statStatus) {

          statStatus.textContent =
            "جاهز";

        }

      }


      function fallbackCopy(
        text,
        callback
      ) {

        const textarea =
          document.createElement("textarea");


        textarea.value =
          text;

        textarea.style.position =
          "fixed";

        textarea.style.opacity =
          "0";


        document.body.appendChild(
          textarea
        );


        textarea.focus();

        textarea.select();


        try {

          document.execCommand(
            "copy"
          );

          if (callback) {
            callback();
          }

        } catch (error) {

          console.error(
            "Copy failed:",
            error
          );

        }


        textarea.remove();

      }


      function copyText(
        text,
        button
      ) {

        if (!text) {
          return;
        }


        const original =
          button
            ? button.innerHTML
            : "";


        function done() {

          if (!button) {
            return;
          }


          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(
            function() {

              button.innerHTML =
                original;

            },
            1400
          );

        }


        if (
          navigator.clipboard &&
          window.isSecureContext
        ) {

          navigator.clipboard
            .writeText(text)
            .then(done)
            .catch(
              function() {

                fallbackCopy(
                  text,
                  done
                );

              }
            );

        } else {

          fallbackCopy(
            text,
            done
          );

        }

      }


      function copyAll() {

        copyText(
          colors.join("\n"),
          copyAllBtn
        );

      }


      function copyCss() {

        copyText(
          cssOutput
            ? cssOutput.textContent
            : "",
          copyCssBtn
        );

      }


      function copyHex() {

        copyText(
          colors.join(", "),
          copyHexBtn
        );

      }


      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");


          if (saved === "dark") {

            document.documentElement
              .classList.add(
                "dark-mode"
              );

          } else {

            document.documentElement
              .classList.remove(
                "dark-mode"
              );

          }

        } catch {}

      }


      if (generateBtn) {

        generateBtn.addEventListener(
          "click",
          generatePalette
        );

      }


      if (clearBtn) {

        clearBtn.addEventListener(
          "click",
          clearPalette
        );

      }


      if (copyAllBtn) {

        copyAllBtn.addEventListener(
          "click",
          copyAll
        );

      }


      if (copyCssBtn) {

        copyCssBtn.addEventListener(
          "click",
          copyCss
        );

      }


      if (copyHexBtn) {

        copyHexBtn.addEventListener(
          "click",
          copyHex
        );

      }


      if (paletteGrid) {

        paletteGrid.addEventListener(
          "click",
          function(event) {

            const target =
              event.target;


            if (
              !target ||
              !target.closest
            ) {

              return;

            }


            const button =
              target.closest(
                "[data-copy]"
              );


            if (!button) {
              return;
            }


            const color =
              button.getAttribute(
                "data-copy"
              );


            copyText(
              color,
              button
            );

          }
        );

      }


      syncTheme();


      window.addEventListener(
        "themeChange",
        syncTheme
      );


      document.addEventListener(
        "click",
        function(event) {

          const target =
            event.target;


          if (
            !target ||
            !target.closest
          ) {

            return;

          }


          const button =
            target.closest(
              "#theme-btn"
            );


          if (button) {

            setTimeout(
              syncTheme,
              0
            );

          }

        }
      );


      renderPalette();

    })();
  </script>


