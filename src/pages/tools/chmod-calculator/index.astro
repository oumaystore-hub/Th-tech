---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/chmod-calculator/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>CHMOD Calculator | حاسبة صلاحيات Linux</title>

  <meta
    name="description"
    content="حاسبة CHMOD مجانية لتحويل صلاحيات Linux بين Numeric و Symbolic. احسب 755 و644 و777 وأنشئ أمر chmod بسهولة."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="chmod-page">

    <!-- Hero -->
    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-lock"></i>
        Linux Developer Tool
      </div>

      <h1>
        CHMOD
        <span>Calculator</span>
      </h1>

      <p>
        احسب صلاحيات الملفات والمجلدات في Linux بسهولة،
        وحوّل بين الصيغة الرقمية والصيغة الرمزية مع إنشاء أمر chmod مباشرة.
      </p>

      <div class="hero-points">

        <span>
          <i class="fa-solid fa-circle-check"></i>
          Numeric ↔ Symbolic
        </span>

        <span>
          <i class="fa-solid fa-terminal"></i>
          أمر chmod جاهز
        </span>

        <span>
          <i class="fa-solid fa-shield-halved"></i>
          يعمل محليًا
        </span>

        <span>
          <i class="fa-solid fa-mobile-screen-button"></i>
          متجاوب
        </span>

      </div>

    </section>


    <!-- Main Tool -->
    <section class="tool-card">

      <div class="tool-top">

        <div class="tool-title">

          <div class="tool-icon">
            <i class="fa-solid fa-key"></i>
          </div>

          <div>
            <h2>حاسبة CHMOD</h2>
            <p>
              حدد صلاحيات User و Group و Others أو أدخل القيمة الرقمية.
            </p>
          </div>

        </div>

        <div class="status">
          <span class="status-dot"></span>
          يعمل محليًا
        </div>

      </div>


      <!-- Numeric input -->
      <div class="numeric-section">

        <label for="numericInput">
          <i class="fa-solid fa-hashtag"></i>
          القيمة الرقمية
        </label>

        <div class="numeric-row">

          <div class="numeric-input-wrap">

            <i class="fa-solid fa-terminal"></i>

            <input
              id="numericInput"
              type="text"
              value="755"
              maxlength="4"
              inputmode="numeric"
              autocomplete="off"
              spellcheck="false"
              dir="ltr"
              placeholder="755"
            />

          </div>

          <button id="applyBtn" class="primary-btn" type="button">
            <i class="fa-solid fa-calculator"></i>
            حساب
          </button>

        </div>

        <div class="input-hint">
          <i class="fa-solid fa-circle-info"></i>
          أدخل قيمة من 000 إلى 777 مثل 755 أو 644.
        </div>

      </div>


      <!-- Permission matrix -->
      <div class="permissions-section">

        <div class="section-heading">

          <div>
            <span class="section-label">
              <i class="fa-solid fa-sliders"></i>
              الصلاحيات
            </span>

            <p>
              اختر الصلاحيات لكل مستوى.
            </p>
          </div>

          <div id="symbolicValue" class="symbolic-badge">
            rwxr-xr-x
          </div>

        </div>


        <div class="permission-grid">

          <!-- User -->
          <div class="permission-card" data-role="user">

            <div class="permission-header">

              <div class="role-icon">
                <i class="fa-solid fa-user"></i>
              </div>

              <div>
                <h3>User</h3>
                <span>المالك</span>
              </div>

              <strong class="role-value" id="userValue">7</strong>

            </div>

            <div class="checks">

              <label class="permission-check">
                <input type="checkbox" data-role="user" data-perm="r" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Read</b>
                  <code>r = 4</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="user" data-perm="w" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Write</b>
                  <code>w = 2</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="user" data-perm="x" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Execute</b>
                  <code>x = 1</code>
                </span>
              </label>

            </div>

          </div>


          <!-- Group -->
          <div class="permission-card" data-role="group">

            <div class="permission-header">

              <div class="role-icon">
                <i class="fa-solid fa-users"></i>
              </div>

              <div>
                <h3>Group</h3>
                <span>المجموعة</span>
              </div>

              <strong class="role-value" id="groupValue">5</strong>

            </div>

            <div class="checks">

              <label class="permission-check">
                <input type="checkbox" data-role="group" data-perm="r" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Read</b>
                  <code>r = 4</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="group" data-perm="w" />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Write</b>
                  <code>w = 2</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="group" data-perm="x" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Execute</b>
                  <code>x = 1</code>
                </span>
              </label>

            </div>

          </div>


          <!-- Others -->
          <div class="permission-card" data-role="others">

            <div class="permission-header">

              <div class="role-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <h3>Others</h3>
                <span>الآخرون</span>
              </div>

              <strong class="role-value" id="othersValue">5</strong>

            </div>

            <div class="checks">

              <label class="permission-check">
                <input type="checkbox" data-role="others" data-perm="r" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Read</b>
                  <code>r = 4</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="others" data-perm="w" />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Write</b>
                  <code>w = 2</code>
                </span>
              </label>

              <label class="permission-check">
                <input type="checkbox" data-role="others" data-perm="x" checked />
                <span class="custom-check">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span>
                  <b>Execute</b>
                  <code>x = 1</code>
                </span>
              </label>

            </div>

          </div>

        </div>

      </div>


      <!-- Result -->
      <div class="result-section">

        <div class="result-main">

          <div class="result-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div class="result-content">

            <span>القيمة المحسوبة</span>

            <div class="result-number" id="resultNumber">
              755
            </div>

            <code id="resultSymbolic">
              rwxr-xr-x
            </code>

          </div>

        </div>

        <button id="copyResult" class="copy-btn" type="button">
          <i class="fa-regular fa-copy"></i>
          نسخ
        </button>

      </div>


      <!-- Command -->
      <div class="command-section">

        <div class="command-heading">

          <div>
            <span class="section-label">
              <i class="fa-solid fa-terminal"></i>
              أمر Linux
            </span>

            <p>
              الأمر الجاهز لتطبيق الصلاحيات.
            </p>
          </div>

          <button id="copyCommand" class="small-copy" type="button">
            <i class="fa-regular fa-copy"></i>
            نسخ الأمر
          </button>

        </div>

        <div class="command-box">

          <span class="command-prompt">$</span>

          <code id="chmodCommand">
            chmod 755 filename
          </code>

        </div>

      </div>


      <!-- Presets -->
      <div class="presets-section">

        <div class="section-label">
          <i class="fa-solid fa-bolt"></i>
          قيم شائعة
        </div>

        <div class="presets">

          <button data-value="755">
            <strong>755</strong>
            <span>rwxr-xr-x</span>
          </button>

          <button data-value="644">
            <strong>644</strong>
            <span>rw-r--r--</span>
          </button>

          <button data-value="700">
            <strong>700</strong>
            <span>rwx------</span>
          </button>

          <button data-value="600">
            <strong>600</strong>
            <span>rw-------</span>
          </button>

          <button data-value="775">
            <strong>775</strong>
            <span>rwxrwxr-x</span>
          </button>

          <button data-value="777">
            <strong>777</strong>
            <span>rwxrwxrwx</span>
          </button>

        </div>

      </div>

    </section>


    <!-- Permission explanation -->
    <section class="content-card">

      <div class="content-heading">

        <span class="heading-icon">
          <i class="fa-solid fa-book-open"></i>
        </span>

        <div>
          <h2>كيف تعمل صلاحيات CHMOD؟</h2>

          <p>
            كل رقم يمثل مجموعة من الصلاحيات.
          </p>
        </div>

      </div>


      <div class="number-guide">

        <div class="guide-item">

          <div class="guide-number">4</div>

          <div>
            <strong>Read</strong>
            <span>قراءة الملف</span>
          </div>

          <code>r--</code>

        </div>


        <div class="guide-item">

          <div class="guide-number">2</div>

          <div>
            <strong>Write</strong>
            <span>تعديل الملف</span>
          </div>

          <code>-w-</code>

        </div>


        <div class="guide-item">

          <div class="guide-number">1</div>

          <div>
            <strong>Execute</strong>
            <span>تنفيذ الملف</span>
          </div>

          <code>--x</code>

        </div>


        <div class="guide-item">

          <div class="guide-number">0</div>

          <div>
            <strong>None</strong>
            <span>بدون صلاحيات</span>
          </div>

          <code>---</code>

        </div>

      </div>


      <div class="formula-box">

        <div class="formula-title">
          <i class="fa-solid fa-calculator"></i>
          طريقة الحساب
        </div>

        <p>
          قيمة كل مجموعة = Read (4) + Write (2) + Execute (1)
        </p>

        <div class="formula-example">

          <span>
            <b>7</b>
            = 4 + 2 + 1
            <small>rwx</small>
          </span>

          <span>
            <b>6</b>
            = 4 + 2
            <small>rw-</small>
          </span>

          <span>
            <b>5</b>
            = 4 + 1
            <small>r-x</small>
          </span>

          <span>
            <b>4</b>
            = 4
            <small>r--</small>
          </span>

        </div>

      </div>

    </section>


    <!-- Info cards -->
    <section class="info-grid">

      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-user"></i>
        </div>

        <h3>User</h3>

        <p>
          يمثل مالك الملف أو المجلد.
          الرقم الأول في قيمة CHMOD يحدد صلاحياته.
        </p>

      </article>


      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-users"></i>
        </div>

        <h3>Group</h3>

        <p>
          يمثل المستخدمين الموجودين في مجموعة الملف.
          الرقم الثاني يحدد صلاحيات المجموعة.
        </p>

      </article>


      <article class="info-card">

        <div class="info-icon">
          <i class="fa-solid fa-globe"></i>
        </div>

        <h3>Others</h3>

        <p>
          يمثل جميع المستخدمين الآخرين الذين ليسوا المالك أو أعضاء المجموعة.
        </p>

      </article>

    </section>


    <!-- Usage -->
    <section class="content-card usage-card">

      <div class="content-heading">

        <span class="heading-icon">
          <i class="fa-solid fa-list-ol"></i>
        </span>

        <div>
          <h2>طريقة الاستخدام</h2>
          <p>ثلاث خطوات بسيطة.</p>
        </div>

      </div>


      <div class="steps">

        <div class="step">

          <span>01</span>

          <div>
            <h3>أدخل القيمة</h3>
            <p>
              أدخل قيمة مثل <code>755</code> أو اختر إحدى القيم الشائعة.
            </p>
          </div>

        </div>


        <div class="step">

          <span>02</span>

          <div>
            <h3>راجع الصلاحيات</h3>
            <p>
              ستظهر صلاحيات User و Group و Others بشكل منفصل.
            </p>
          </div>

        </div>


        <div class="step">

          <span>03</span>

          <div>
            <h3>انسخ الأمر</h3>
            <p>
              استخدم أمر <code>chmod</code> الناتج مباشرة في الطرفية.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- Tip -->
    <section class="tip-card">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>

        <strong>نصيحة للمطورين</strong>

        <p>
          القيمة <code>644</code> شائعة للملفات العادية،
          بينما <code>755</code> تستخدم كثيرًا للملفات التنفيذية والمجلدات.
          اختر الصلاحيات التي تتوافق مع احتياجات الأمان الفعلية لملفك.
        </p>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="faq-title">
        <i class="fa-solid fa-circle-question"></i>
        الأسئلة الشائعة
      </div>


      <details>
        <summary>
          ما معنى CHMOD؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          CHMOD هو أمر في أنظمة Unix وLinux يستخدم لتغيير صلاحيات الوصول
          إلى الملفات والمجلدات.
        </p>

      </details>


      <details>
        <summary>
          ماذا يعني 755؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          755 تعني أن المالك يمتلك Read وWrite وExecute،
          بينما المجموعة والآخرون يمتلكون Read وExecute فقط.
          والصيغة الرمزية هي
          <code>rwxr-xr-x</code>.
        </p>

      </details>


      <details>
        <summary>
          ماذا يعني 644؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          644 تعني أن المالك يستطيع القراءة والكتابة،
          بينما المجموعة والآخرون يستطيعون القراءة فقط.
          والصيغة الرمزية هي
          <code>rw-r--r--</code>.
        </p>

      </details>


      <details>
        <summary>
          هل يتم إرسال البيانات إلى خادم؟
          <i class="fa-solid fa-chevron-down"></i>
        </summary>

        <p>
          لا. جميع الحسابات تتم داخل المتصفح باستخدام JavaScript،
          ولا تحتاج الأداة إلى خادم أو API.
        </p>

      </details>

    </section>

  



<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/chmod-converter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Chmod Converter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/cidr-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Cidr Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv4-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Ipv4 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/ipv6-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Ipv6 Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/subnet-calculator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Subnet Calculator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

  <Footer />


  <script>
    (() => {
      const numericInput = document.getElementById('numericInput');
      const applyBtn = document.getElementById('applyBtn');

      const resultNumber = document.getElementById('resultNumber');
      const resultSymbolic = document.getElementById('resultSymbolic');
      const symbolicValue = document.getElementById('symbolicValue');

      const chmodCommand = document.getElementById('chmodCommand');

      const userValue = document.getElementById('userValue');
      const groupValue = document.getElementById('groupValue');
      const othersValue = document.getElementById('othersValue');

      const copyResult = document.getElementById('copyResult');
      const copyCommand = document.getElementById('copyCommand');

      const permissionInputs =
        Array.from(document.querySelectorAll('.permission-check input'));

      const presets =
        Array.from(document.querySelectorAll('.presets button'));


      const weights = {
        r: 4,
        w: 2,
        x: 1
      };


      function normalizeNumber(value) {
        let clean = String(value || '')
          .replace(/\D/g, '')
          .slice(0, 4);

        if (!clean) return '000';

        if (clean.length === 4 && clean[0] === '0') {
          clean = clean.slice(1);
        }

        clean = clean.padStart(3, '0');

        const digits = clean.split('').map(Number);

        if (digits.some(n => n > 7)) {
          return null;
        }

        return clean;
      }


      function digitToPermissions(digit) {
        const value = Number(digit);

        return {
          r: (value & 4) !== 0,
          w: (value & 2) !== 0,
          x: (value & 1) !== 0
        };
      }


      function permissionsToDigit(role) {
        let value = 0;

        permissionInputs
          .filter(input => input.dataset.role === role)
          .forEach(input => {
            if (input.checked) {
              value += weights[input.dataset.perm];
            }
          });

        return value;
      }


      function permissionsToSymbolic() {
        const roles = ['user', 'group', 'others'];

        return roles.map(role => {

          const r = permissionsToDigit(role);

          const permissions = digitToPermissions(r);

          return (
            (permissions.r ? 'r' : '-') +
            (permissions.w ? 'w' : '-') +
            (permissions.x ? 'x' : '-')
          );

        }).join('');
      }


      function setRole(role, digit) {
        const permissions = digitToPermissions(digit);

        permissionInputs
          .filter(input => input.dataset.role === role)
          .forEach(input => {
            input.checked = permissions[input.dataset.perm];
          });
      }


      function setFromNumber(number) {
        const clean = normalizeNumber(number);

        if (!clean) {
          numericInput.classList.add('input-error');
          return false;
        }

        numericInput.classList.remove('input-error');

        numericInput.value = clean;

        setRole('user', clean[0]);
        setRole('group', clean[1]);
        setRole('others', clean[2]);

        updateResult();

        return true;
      }


      function updateResult() {

        const user = permissionsToDigit('user');
        const group = permissionsToDigit('group');
        const others = permissionsToDigit('others');

        const numeric = `${user}${group}${others}`;

        const symbolic = permissionsToSymbolic();

        userValue.textContent = user;
        groupValue.textContent = group;
        othersValue.textContent = others;

        numericInput.value = numeric;

        resultNumber.textContent = numeric;
        resultSymbolic.textContent = symbolic;
        symbolicValue.textContent = symbolic;

        chmodCommand.textContent = `chmod ${numeric} filename`;
      }


      function updateFromPermissions() {

        const numeric = [
          permissionsToDigit('user'),
          permissionsToDigit('group'),
          permissionsToDigit('others')
        ].join('');

        numericInput.value = numeric;

        updateResult();
      }


      function flashButton(button, text) {

        const original = button.innerHTML;

        button.innerHTML =
          `<i class="fa-solid fa-check"></i> ${text}`;

        button.classList.add('copied');

        setTimeout(() => {
          button.innerHTML = original;
          button.classList.remove('copied');
        }, 1400);
      }


      async function copyText(text, button, label) {

        try {

          await navigator.clipboard.writeText(text);

          flashButton(button, label);

        } catch {

          const textarea = document.createElement('textarea');

          textarea.value = text;

          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';

          document.body.appendChild(textarea);

          textarea.select();

          document.execCommand('copy');

          textarea.remove();

          flashButton(button, label);
        }
      }


      applyBtn.addEventListener('click', () => {
        setFromNumber(numericInput.value);
      });


      numericInput.addEventListener('input', () => {

        numericInput.value =
          numericInput.value.replace(/\D/g, '').slice(0, 3);

      });


      numericInput.addEventListener('keydown', event => {

        if (event.key === 'Enter') {
          setFromNumber(numericInput.value);
        }

      });


      permissionInputs.forEach(input => {

        input.addEventListener('change', () => {
          updateFromPermissions();
        });

      });


      presets.forEach(button => {

        button.addEventListener('click', () => {

          const value = button.dataset.value;

          setFromNumber(value);

          presets.forEach(item => item.classList.remove('active'));

          button.classList.add('active');

        });

      });


      copyResult.addEventListener('click', () => {

        copyText(
          `${resultNumber.textContent} ${resultSymbolic.textContent}`,
          copyResult,
          'تم النسخ'
        );

      });


      copyCommand.addEventListener('click', () => {

        copyText(
          chmodCommand.textContent,
          copyCommand,
          'تم النسخ'
        );

      });


      setFromNumber('755');


      /*
       * Theme synchronization
       */

      function syncTheme() {

        const html = document.documentElement;

        const body = document.body;

        const stored =
          localStorage.getItem('theme');

        const isLight =
          stored === 'light' ||
          html.dataset.theme === 'light' ||
          html.classList.contains('light-mode') ||
          body.classList.contains('light-mode');

        body.classList.toggle('chmod-light', isLight);
        body.classList.toggle('chmod-dark', !isLight);

      }


      syncTheme();

      window.addEventListener('storage', syncTheme);

      const themeObserver = new MutationObserver(syncTheme);

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme']
      });

      themeObserver.observe(document.body, {
        attributes: true,
        attributeFilter: ['class']
      });

    })();
  </script>


