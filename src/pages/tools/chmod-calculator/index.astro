    }


    .content-heading h2 {
      margin: 0 0 4px;
      font-size: 20px;
    }


    .content-heading p {
      margin: 0;
      color: var(--chmod-muted);
      font-size: 12px;
    }


    .number-guide {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }


    .guide-item {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 14px;
      border: 1px solid var(--chmod-border);
      border-radius: 14px;
      background: var(--chmod-surface-2);
    }


    .guide-number {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 11px;
      background: var(--chmod-primary-soft);
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 800;
    }


    .guide-item strong {
      display: block;
      font-size: 12px;
    }


    .guide-item span {
      display: block;
      color: var(--chmod-muted);
      font-size: 9px;
      margin-top: 2px;
    }


    .guide-item code {
      direction: ltr;
      margin-right: auto;
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
    }


    .formula-box {
      margin-top: 18px;
      padding: 20px;
      border: 1px solid var(--chmod-border);
      border-radius: 16px;
      background: var(--chmod-surface-2);
    }


    .formula-title {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--chmod-primary);
      font-size: 13px;
      font-weight: 800;
    }


    .formula-box p {
      margin: 10px 0 15px;
      color: var(--chmod-muted);
      font-size: 12px;
    }


    .formula-example {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }


    .formula-example span {
      direction: ltr;
      text-align: center;
      padding: 11px;
      border-radius: 10px;
      background: var(--chmod-surface);
      color: var(--chmod-soft);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
    }


    .formula-example b {
      color: var(--chmod-primary);
      font-size: 16px;
    }


    .formula-example small {
      display: block;
      color: var(--chmod-muted);
      margin-top: 4px;
    }


    .info-grid {
      max-width: 1100px;
      margin: 0 auto 25px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }


    .info-card {
      padding: 23px;
      border: 1px solid var(--chmod-border);
      border-radius: 20px;
      background: var(--chmod-surface);
      box-shadow: var(--chmod-shadow);
    }


    .info-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      color: var(--chmod-primary);
      background: var(--chmod-primary-soft);
      margin-bottom: 14px;
    }


    .info-card h3 {
      margin: 0 0 8px;
      font-size: 16px;
    }


    .info-card p {
      margin: 0;
      color: var(--chmod-muted);
      font-size: 12px;
      line-height: 1.9;
    }


    .info-card code,
    .tip-card code,
    .step code {
      direction: ltr;
      font-family: 'JetBrains Mono', monospace;
      color: var(--chmod-primary);
    }


    .steps {
      display: grid;
      gap: 12px;
    }


    .step {
      display: flex;
      align-items: flex-start;
      gap: 15px;
      padding: 16px;
      border: 1px solid var(--chmod-border);
      border-radius: 14px;
      background: var(--chmod-surface-2);
    }


    .step > span {
      direction: ltr;
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      border-radius: 11px;
      background: var(--chmod-primary-soft);
      color: var(--chmod-primary);
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 11px;
    }


    .step h3 {
      margin: 0 0 3px;
      font-size: 13px;
    }


    .step p {
      margin: 0;
      color: var(--chmod-muted);
      font-size: 11px;
      line-height: 1.8;
    }


    .tip-card {
      max-width: 1100px;
      margin: 0 auto 25px;
      display: flex;
      align-items: flex-start;
      gap: 15px;
      padding: 20px;
      border: 1px solid rgba(56, 189, 248, .2);
      border-radius: 18px;
      background: var(--chmod-primary-soft);
    }


    .tip-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 13px;
      background: var(--chmod-primary);
      color: white;
    }


    .tip-card strong {
      display: block;
      font-size: 13px;
      margin-bottom: 4px;
    }


    .tip-card p {
      margin: 0;
      color: var(--chmod-muted);
      font-size: 11px;
      line-height: 1.9;
    }


    .faq-section {
      max-width: 1100px;
      margin: 0 auto;
    }


    .faq-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 13px;
      font-size: 18px;
      font-weight: 800;
    }


    .faq-title i {
      color: var(--chmod-primary);
    }


    .faq-section details {
      margin-bottom: 9px;
      border: 1px solid var(--chmod-border);
      border-radius: 14px;
      background: var(--chmod-surface);
      overflow: hidden;
    }


    .faq-section summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 16px 18px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
    }


    .faq-section summary::-webkit-details-marker {
      display: none;
    }


    .faq-section summary i {
      color: var(--chmod-muted);
      transition: transform .2s ease;
    }


    .faq-section details[open] summary i {
      transform: rotate(180deg);
    }


    .faq-section details p {
      margin: 0;
      padding: 0 18px 17px;
      color: var(--chmod-muted);
      font-size: 11px;
      line-height: 2;
    }


    @media (max-width: 850px) {

      .permission-grid {
        grid-template-columns: 1fr;
      }

      .presets {
        grid-template-columns: repeat(3, 1fr);
      }

      .number-guide {
        grid-template-columns: repeat(2, 1fr);
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .chmod-page {
        padding: 32px 12px 60px;
      }

      .hero h1 {
        font-size: 34px;
      }

      .hero > p {
        font-size: 13px;
      }

      .hero-points {
        gap: 7px;
      }

      .hero-points span {
        font-size: 10px;
      }

      .tool-card,
      .content-card {
        padding: 18px;
        border-radius: 18px;
      }

      .tool-top {
        align-items: flex-start;
        flex-direction: column;
      }

      .status {
        align-self: flex-start;
      }

      .numeric-row {
        flex-direction: column;
      }

      .primary-btn {
        width: 100%;
      }

      .section-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .result-section {
        align-items: stretch;
        flex-direction: column;
      }

      .copy-btn {
        justify-content: center;
      }

      .command-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .small-copy {
        width: 100%;
        justify-content: center;
      }

      .presets {
        grid-template-columns: repeat(2, 1fr);
      }

      .number-guide {
        grid-template-columns: 1fr;
      }

      .formula-example {
        grid-template-columns: repeat(2, 1fr);
      }

    }


    @media (max-width: 380px) {

      .tool-title {
        align-items: flex-start;
      }

      .tool-title h2 {
        font-size: 17px;
      }

      .tool-title p {
        font-size: 10px;
      }

      .permission-card {
        padding: 14px;
      }

      .presets {
        grid-template-columns: 1fr 1fr;
      }

      .result-number {
        font-size: 25px;
      }

    }

  </style>

</body>
</html>
