---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SHA-512 Generator - إنشاء SHA-512 Hash أونلاين مجاناً | Th.Tech";

const description =
  "أداة SHA-512 Generator مجانية لإنشاء SHA-512 Hash من أي نص مباشرة داخل المتصفح، مع إمكانية النسخ والمسح واستخدام أمثلة جاهزة.";

const faqs = [
  {
    q: "ما هو SHA-512؟",
    a: "SHA-512 هي خوارزمية Hash تشفيرية من عائلة SHA-2 تنتج قيمة بطول 512 بت، وتظهر عادةً كسلسلة hexadecimal مكونة من 128 حرفاً."
  },
  {
    q: "هل SHA-512 تشفير؟",
    a: "لا. SHA-512 هي دالة Hash أحادية الاتجاه وليست خوارزمية تشفير. يتم استخدامها لإنشاء بصمة رقمية للبيانات."
  },
  {
    q: "هل يتم إرسال النص إلى الخادم؟",
    a: "لا. يتم إنشاء SHA-512 بالكامل داخل المتصفح باستخدام Web Crypto API، ولا يتم إرسال النص إلى خادم خارجي."
  },
  {
    q: "هل SHA-512 مناسبة لتخزين كلمات المرور؟",
    a: "لا ينصح باستخدام SHA-512 وحدها لتخزين كلمات المرور. كلمات المرور تحتاج إلى خوارزميات مخصصة مثل Argon2id أو bcrypt أو scrypt مع Salt."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/sha512-generator/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>SHA-512 Generator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-fingerprint"></i>
            <span>SHA-512</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>SHA-512 Generator</h1>

            <p>
              أنشئ SHA-512 Hash من أي نص بسرعة وسهولة مباشرة من المتصفح.
            </p>

            <div class="tags">
              <span>SHA-512</span>
              <span>Hash</span>
              <span>512-bit</span>
              <span>Local</span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="generator-card">

          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-fingerprint"></i>
              SHA-512 Generator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ Hash
            </button>

            <button id="generateBtn" class="btn btn-primary">
              <i class="fa-solid fa-fingerprint"></i>
              إنشاء SHA-512
            </button>

          </div>


          <div class="editor-section">

            <div class="editor-header">
              <div>
                <i class="fa-solid fa-pen"></i>
                Input
              </div>

              <span id="inputCount">0 حرف</span>
            </div>

            <textarea
              id="textInput"
              spellcheck="false"
              placeholder="اكتب النص الذي تريد إنشاء SHA-512 Hash له..."
            ></textarea>

          </div>


          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز لإنشاء Hash
              </strong>

              <p id="resultMessage">
                أدخل نصاً ثم اضغط على إنشاء SHA-512.
              </p>

            </div>

          </div>


          <div class="output-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-hashtag"></i>
                SHA-512 Hash
              </div>

              <span>128 HEX</span>

            </div>

            <div class="hash-output" id="hashOutput">
              —
            </div>

            <button id="outputCopyBtn" class="copy-output">
              <i class="fa-regular fa-copy"></i>
              نسخ Hash
            </button>

          </div>


          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>الأحرف</span>
                <strong id="statChars">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-database"></i>
              </div>

              <div>
                <span>Bytes</span>
                <strong id="statBytes">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-fingerprint"></i>
              </div>

              <div>
                <span>Hash Length</span>
                <strong id="statHashLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>


          <div class="security-note">

            <div class="security-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>

              <strong>ملاحظة أمنية</strong>

              <p>
                SHA-512 خوارزمية Hash تشفيرية قوية ومناسبة لإنشاء بصمات
                للبيانات والتحقق من سلامتها. لا تستخدم SHA-512 وحدها
                لتخزين كلمات المرور؛ استخدم خوارزميات مخصصة مثل Argon2id
                أو bcrypt أو scrypt.
              </p>

            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>SHA-512 GENERATOR</span>

          <h2>
            ما هو SHA-512 Generator؟
          </h2>

          <p>
            أداة تساعد المطورين على إنشاء SHA-512 Hash من النصوص
            مباشرة داخل المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-fingerprint"></i>
            </div>

            <h3>Hash بطول 512-bit</h3>

            <p>
              ينتج SHA-512 قيمة Hash بطول 512 بت تظهر عادةً على شكل
              128 حرفاً بنظام hexadecimal.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-laptop-code"></i>
            </div>

            <h3>يعمل محلياً</h3>

            <p>
              تتم عملية إنشاء Hash داخل المتصفح باستخدام Web Crypto API
              ولا يحتاج النص إلى الإرسال للخادم.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>سريع وسهل</h3>

            <p>
              أدخل النص واضغط على إنشاء SHA-512 للحصول على النتيجة
              مباشرة.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام SHA-512 Generator
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>أدخل النص</h3>

              <p>
                اكتب أو الصق النص الذي تريد تحويله إلى SHA-512 Hash.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>أنشئ Hash</h3>

              <p>
                اضغط على زر إنشاء SHA-512 لمعالجة النص مباشرة داخل
                المتصفح.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>انسخ النتيجة</h3>

              <p>
                انسخ SHA-512 Hash الناتج واستخدمه في مشروعك.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>
                <span>{faq.q}</span>

                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>{faq.a}</p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>

  <Footer />


  <script is:inline>
    (() => {
      const input = document.getElementById("textInput");
      const generateBtn = document.getElementById("generateBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");
      const outputCopyBtn = document.getElementById("outputCopyBtn");

      const hashOutput = document.getElementById("hashOutput");

      const inputCount = document.getElementById("inputCount");

      const resultBox = document.getElementById("resultBox");
      const resultIcon = document.getElementById("resultIcon");
      const resultTitle = document.getElementById("resultTitle");
      const resultMessage = document.getElementById("resultMessage");

      const statChars = document.getElementById("statChars");
      const statBytes = document.getElementById("statBytes");
      const statHashLength = document.getElementById("statHashLength");
      const statStatus = document.getElementById("statStatus");


      function updateStats() {
        const text = input.value;

        const chars = Array.from(text).length;

        const bytes =
          new TextEncoder().encode(text).length;

        inputCount.textContent =
          `${chars} حرف`;

        statChars.textContent =
          chars.toLocaleString("ar");

        statBytes.textContent =
          bytes.toLocaleString("ar");
      }


      function setResult(type, title, message) {

        resultBox.classList.remove(
          "success",
          "error"
        );

        if (type === "success") {
          resultBox.classList.add("success");

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-check"></i>';
        }

        else if (type === "error") {
          resultBox.classList.add("error");

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-exclamation"></i>';
        }

        else {
          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-question"></i>';
        }

        resultTitle.textContent = title;
        resultMessage.textContent = message;
      }


      async function generateHash(text) {

        const data =
          new TextEncoder().encode(text);

        const hashBuffer =
          await crypto.subtle.digest(
            "SHA-512",
            data
          );

        const hashArray =
          Array.from(
            new Uint8Array(hashBuffer)
          );

        return hashArray
          .map(
            byte =>
              byte
                .toString(16)
                .padStart(2, "0")
          )
          .join("");
      }


      async function generate() {

        const text = input.value;

        if (!text) {

          hashOutput.textContent = "—";

          statHashLength.textContent = "0";

          statStatus.textContent = "فارغ";

          setResult(
            "error",
            "لا يوجد نص",
            "أدخل نصاً أولاً ثم حاول مرة أخرى."
          );

          return;
        }


        try {

          generateBtn.disabled = true;

          generateBtn.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإنشاء...';

          statStatus.textContent =
            "جاري المعالجة";


          const hash =
            await generateHash(text);


          hashOutput.textContent =
            hash;

          statHashLength.textContent =
            hash.length.toLocaleString("ar");

          statStatus.textContent =
            "تم الإنشاء";


          setResult(
            "success",
            "تم إنشاء SHA-512 بنجاح",
            "تم إنشاء Hash محلياً داخل المتصفح ويمكنك نسخه الآن."
          );

        }

        catch (error) {

          console.error(error);

          hashOutput.textContent = "—";

          statHashLength.textContent = "0";

          statStatus.textContent = "خطأ";

          setResult(
            "error",
            "حدث خطأ",
            "تعذر إنشاء SHA-512 في هذا المتصفح."
          );

        }

        finally {

          generateBtn.disabled = false;

          generateBtn.innerHTML =
            '<i class="fa-solid fa-fingerprint"></i> إنشاء SHA-512';

        }
      }


      async function copyHash() {

        const hash =
          hashOutput.textContent.trim();

        if (
          !hash ||
          hash === "—"
        ) {

          setResult(
            "error",
            "لا توجد نتيجة",
            "أنشئ SHA-512 أولاً ثم حاول نسخ النتيجة."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(hash);

          setResult(
            "success",
            "تم النسخ",
            "تم نسخ SHA-512 Hash إلى الحافظة."
          );

        }

        catch {

          const textarea =
            document.createElement("textarea");

          textarea.value = hash;

          textarea.style.position = "fixed";
          textarea.style.opacity = "0";

          document.body.appendChild(textarea);

          textarea.select();

          document.execCommand("copy");

          textarea.remove();

          setResult(
            "success",
            "تم النسخ",
            "تم نسخ SHA-512 Hash إلى الحافظة."
          );
        }
      }


      function clearAll() {

        input.value = "";

        hashOutput.textContent = "—";

        statHashLength.textContent = "0";

        statStatus.textContent = "جاهز";

        updateStats();

        setResult(
          "default",
          "جاهز لإنشاء Hash",
          "أدخل نصاً ثم اضغط على إنشاء SHA-512."
        );

        input.focus();
      }


      function loadExample() {

        input.value =
          "Hello, World!";

        updateStats();

        generate();
      }


      input.addEventListener(
        "input",
        updateStats
      );


      generateBtn.addEventListener(
        "click",
        generate
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyHash
      );


      outputCopyBtn.addEventListener(
        "click",
        copyHash
      );


      input.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {
            generate();
          }

        }
      );


      updateStats();

    })();
  </script>


  <style>
    :root {
      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f1f5f9;
      --border: #e2e8f0;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #7c3aed;
      --primary-2: #9333ea;
      --primary-soft: rgba(124, 58, 237, 0.10);
      --success: #16a34a;
      --success-soft: rgba(22, 163, 74, 0.10);
      --danger: #dc2626;
      --danger-soft: rgba(220, 38, 38, 0.10);
      --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    }


    html.dark-mode {
      --bg: #08070d;
      --surface: #100d18;
      --surface-2: #171321;
      --border: #2a2337;
      --text: #f8fafc;
      --muted: #a1a1aa;
      --primary: #a855f7;
      --primary-2: #c084fc;
      --primary-soft: rgba(168, 85, 247, 0.13);
      --success: #22c55e;
      --success-soft: rgba(34, 197, 94, 0.12);
      --danger: #ef4444;
      --danger-soft: rgba(239, 68, 68, 0.12);
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    }


    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      transition:
        background 0.25s ease,
        color 0.25s ease;
    }


    button,
    textarea {
      font-family: inherit;
    }


    .container {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }


    /* HERO */

    .hero {
      padding: 42px 0 58px;
      background:
        radial-gradient(
          circle at 10% 20%,
          rgba(124, 58, 237, 0.12),
          transparent 30%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(168, 85, 247, 0.10),
          transparent 30%
        );
      border-bottom: 1px solid var(--border);
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 38px;
      color: var(--muted);
      font-size: 14px;
    }


    .breadcrumb a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 700;
    }


    .breadcrumb i {
      font-size: 10px;
      opacity: 0.6;
    }


    .hero-content {
      display: flex;
      align-items: center;
      gap: 28px;
    }


    .hero-icon {
      width: 120px;
      height: 120px;
      flex: 0 0 120px;
      border-radius: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #fff;
      background:
        linear-gradient(
          145deg,
          #7c3aed,
          #a855f7
        );
      box-shadow:
        0 18px 40px rgba(124, 58, 237, 0.28);
    }


    .hero-icon i {
      font-size: 38px;
    }


    .hero-icon span {
      font-family: "JetBrains Mono", monospace;
      font-size: 12px;
      font-weight: 700;
    }


    .hero-text {
      min-width: 0;
    }


    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-radius: 999px;
      color: var(--primary);
      background: var(--primary-soft);
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 12px;
    }


    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(30px, 5vw, 48px);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -1px;
    }


    .hero-text p {
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }


    .tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tags span {
      padding: 5px 11px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
    }


    /* TOOL */

    .tool-section {
      padding: 58px 0;
    }


    .generator-card {
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }


    .card-topbar {
      min-height: 58px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 15px;
      padding: 0 20px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
    }


    .window-dots {
      display: flex;
      gap: 7px;
      direction: ltr;
    }


    .window-dots span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--border);
    }


    .tool-name {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      font-family: "JetBrains Mono", monospace;
      font-size: 13px;
      font-weight: 600;
    }


    .tool-name i {
      color: var(--primary);
    }


    .secure {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--success);
      font-size: 12px;
      font-weight: 700;
    }


    .actionbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 20px;
      border-bottom: 1px solid var(--border);
    }


    .btn {
      border: 0;
      border-radius: 11px;
      padding: 11px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease,
        box-shadow 0.2s ease;
    }


    .btn:hover {
      transform: translateY(-1px);
    }


    .btn:disabled {
      cursor: not-allowed;
      opacity: 0.65;
      transform: none;
    }


    .btn-primary {
      margin-inline-start: auto;
      color: #fff;
      background: linear-gradient(
        135deg,
        var(--primary),
        var(--primary-2)
      );
      box-shadow:
        0 8px 20px rgba(124, 58, 237, 0.22);
    }


    .btn-secondary {
      color: var(--text);
      background: var(--surface-2);
      border: 1px solid var(--border);
    }


    .editor-section,
    .output-section {
      padding: 22px 20px;
    }


    .editor-section {
      border-bottom: 1px solid var(--border);
    }


    .editor-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }


    .editor-header div {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text);
    }


    .editor-header i {
      color: var(--primary);
    }


    textarea {
      width: 100%;
      min-height: 210px;
      resize: vertical;
      display: block;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 14px;
      outline: none;
      background: var(--surface-2);
      color: var(--text);
      font-family: "JetBrains Mono", monospace;
      font-size: 14px;
      line-height: 1.8;
      direction: auto;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }


    textarea:focus {
      border-color: var(--primary);
      box-shadow:
        0 0 0 3px var(--primary-soft);
    }


    textarea::placeholder {
      color: var(--muted);
      opacity: 0.7;
    }


    .result-box {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 0 20px;
      padding: 15px 17px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
    }


    .result-box.success {
      border-color: rgba(22, 163, 74, 0.25);
      background: var(--success-soft);
    }


    .result-box.error {
      border-color: rgba(220, 38, 38, 0.25);
      background: var(--danger-soft);
    }


    .result-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      background: var(--primary-soft);
      color: var(--primary);
    }


    .result-box.success .result-icon {
      color: var(--success);
      background: var(--success-soft);
    }


    .result-box.error .result-icon {
      color: var(--danger);
      background: var(--danger-soft);
    }


    .result-content {
      min-width: 0;
    }


    .result-content strong {
      display: block;
      margin-bottom: 3px;
      font-size: 13px;
    }


    .result-content p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }


    .output-section {
      position: relative;
    }


    .hash-output {
      min-height: 82px;
      display: flex;
      align-items: center;
      padding: 18px 155px 18px 18px;
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.8;
      direction: ltr;
      text-align: left;
      word-break: break-all;
    }


    .copy-output {
      position: absolute;
      left: 36px;
      bottom: 38px;
      padding: 9px 13px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
    }


    .copy-output:hover {
      color: var(--primary);
      border-color: var(--primary);
    }


    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 0 20px 22px;
    }


    .stat {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface-2);
    }


    .stat-icon {
      width: 37px;
      height: 37px;
      flex: 0 0 37px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--primary-soft);
      color: var(--primary);
    }


    .stat span {
      display: block;
      margin-bottom: 2px;
      color: var(--muted);
      font-size: 10px;
    }


    .stat strong {
      display: block;
      font-family: "JetBrains Mono", monospace;
      font-size: 14px;
    }


    .security-note {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      margin: 0 20px 20px;
      padding: 15px;
      border-radius: 14px;
      background: var(--primary-soft);
    }


    .security-icon {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: rgba(124, 58, 237, 0.13);
      color: var(--primary);
    }


    .security-note strong {
      display: block;
      margin-bottom: 3px;
      font-size: 13px;
    }


    .security-note p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.8;
    }


    /* INFO */

    .info-section,
    .how-section,
    .faq-section {
      padding: 70px 0;
    }


    .info-section {
      background: var(--surface-2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }


    .section-heading {
      max-width: 700px;
      margin: 0 auto 35px;
      text-align: center;
    }


    .section-heading > span {
      display: block;
      margin-bottom: 8px;
      color: var(--primary);
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
    }


    .section-heading h2 {
      margin: 0 0 10px;
      font-size: clamp(25px, 4vw, 34px);
      font-weight: 800;
    }


    .section-heading p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.9;
    }


    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }


    .info-card {
      padding: 25px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
    }


    .info-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border-radius: 13px;
      background: var(--primary-soft);
      color: var(--primary);
      font-size: 19px;
    }


    .info-card h3 {
      margin: 0 0 8px;
      font-size: 17px;
    }


    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }


    /* STEPS */

    .steps {
      max-width: 820px;
      margin: 0 auto;
      display: grid;
      gap: 14px;
    }


    .step {
      display: flex;
      align-items: flex-start;
      gap: 17px;
      padding: 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
    }


    .step-number {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: linear-gradient(
        135deg,
        var(--primary),
        var(--primary-2)
      );
      color: #fff;
      font-family: "JetBrains Mono", monospace;
      font-weight: 700;
    }


    .step h3 {
      margin: 0 0 4px;
      font-size: 15px;
    }


    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
    }


    /* FAQ */

    .faq-section {
      background: var(--surface-2);
      border-top: 1px solid var(--border);
    }


    .faq-list {
      max-width: 820px;
      margin: 0 auto;
      display: grid;
      gap: 10px;
    }


    details {
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 18px 20px;
      cursor: pointer;
      list-style: none;
      font-size: 14px;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);
      font-size: 12px;
      transition: transform 0.2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;
      padding: 0 20px 20px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 800px) {

      .hero {
        padding: 30px 0 45px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .hero-icon {
        width: 90px;
        height: 90px;
        flex-basis: 90px;
        border-radius: 23px;
      }


      .hero-icon i {
        font-size: 28px;
      }


      .hero-icon span {
        font-size: 9px;
      }


      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }


      .info-grid {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .container {
        width: min(100% - 22px, 1120px);
      }


      .hero-content {
        flex-direction: column;
      }


      .hero-icon {
        width: 82px;
        height: 82px;
        flex-basis: 82px;
      }


      .hero h1 {
        font-size: 30px;
      }


      .hero-text p {
        font-size: 14px;
      }


      .card-topbar {
        grid-template-columns: auto 1fr auto;
        padding: 0 13px;
      }


      .tool-name {
        font-size: 11px;
      }


      .secure {
        font-size: 10px;
      }


      .actionbar {
        padding: 14px;
      }


      .btn {
        flex: 1;
        min-width: calc(50% - 5px);
        padding: 10px 8px;
        font-size: 11px;
      }


      .btn-primary {
        margin-inline-start: 0;
        min-width: 100%;
      }


      .editor-section,
      .output-section {
        padding: 18px 14px;
      }


      .result-box {
        margin: 0 14px;
      }


      .hash-output {
        padding: 17px;
        min-height: 105px;
        font-size: 11px;
      }


      .copy-output {
        position: static;
        width: 100%;
        margin-top: 10px;
        padding: 11px;
      }


      .stats-grid {
        grid-template-columns: 1fr 1fr;
        padding: 0 14px 18px;
      }


      .security-note {
        margin: 0 14px 14px;
      }


      .info-section,
      .how-section,
      .faq-section {
        padding: 50px 0;
      }


      .section-heading {
        margin-bottom: 25px;
      }


      .step {
        padding: 16px;
      }

    }


    @media (max-width: 380px) {

      .stats-grid {
        grid-template-columns: 1fr;
      }


      .btn {
        min-width: 100%;
      }

    }
  </style>


  <script is:inline>
    (() => {
      function syncTheme() {
        try {
          const saved =
            localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add(
              "dark-mode"
            );
          } else {
            document.documentElement.classList.remove(
              "dark-mode"
            );
          }
        } catch {}
      }

      syncTheme();

      window.addEventListener(
        "themeChange",
        syncTheme
      );

      document.addEventListener(
        "click",
        (event) => {

          const button =
            event.target.closest("#theme-btn");

          if (button) {
            setTimeout(
              syncTheme,
              0
            );
          }

        }
      );
    })();
  </script>

</body>
</html>
