      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />

    <script>
      (() => {
        const uaInput = document.getElementById('uaInput');

        const parseBtn = document.getElementById('parseBtn');
        const pasteBtn = document.getElementById('pasteBtn');
        const currentBtn = document.getElementById('currentBtn');
        const sampleBtn = document.getElementById('sampleBtn');
        const clearBtn = document.getElementById('clearBtn');

        const browserName = document.getElementById('browserName');
        const osName = document.getElementById('osName');
        const deviceName = document.getElementById('deviceName');

        const browserValue = document.getElementById('browserValue');
        const browserVersion = document.getElementById('browserVersion');
        const osValue = document.getElementById('osValue');
        const osVersion = document.getElementById('osVersion');
        const deviceType = document.getElementById('deviceType');
        const platformValue = document.getElementById('platformValue');

        const engineValue = document.getElementById('engineValue');
        const engineVersion = document.getElementById('engineVersion');

        const rawOutput = document.getElementById('rawOutput');
        const copyBtn = document.getElementById('copyBtn');

        const message = document.getElementById('message');

        function getThemeState() {
          const html = document.documentElement;
          const stored = localStorage.getItem('theme');

          if (stored === 'light') return 'light';
          if (stored === 'dark') return 'dark';

          if (html.dataset.theme === 'light') return 'light';
          if (html.dataset.theme === 'dark') return 'dark';

          if (html.classList.contains('light')) return 'light';
          if (html.classList.contains('dark')) return 'dark';

          return 'dark';
        }

        function syncTheme() {
          const theme = getThemeState();
          const light = theme === 'light';

          document.body.classList.toggle('ua-light', light);
          document.body.classList.toggle('ua-dark', !light);
        }

        syncTheme();

        const themeObserver = new MutationObserver(() => syncTheme());

        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme']
        });

        function showMessage(text, type = 'success') {
          message.textContent = text;
          message.className = `message ${type}`;

          clearTimeout(showMessage.timer);

          showMessage.timer = setTimeout(() => {
            message.textContent = '';
            message.className = 'message';
          }, 2500);
        }

        function setText(element, value) {
          element.textContent = value || 'غير معروف';
        }

        function getVersion(match) {
          return match && match[1] ? match[1].replace(/_/g, '.') : '';
        }

        function detectBrowser(ua) {
          let name = 'غير معروف';
          let version = '';

          let match;

          if ((match = ua.match(/EdgA?\/([\d.]+)/i))) {
            name = 'Microsoft Edge';
            version = match[1];
          } else if ((match = ua.match(/OPR\/([\d.]+)/i))) {
            name = 'Opera';
            version = match[1];
          } else if ((match = ua.match(/Opera\/([\d.]+)/i))) {
            name = 'Opera';
            version = match[1];
          } else if ((match = ua.match(/SamsungBrowser\/([\d.]+)/i))) {
            name = 'Samsung Internet';
            version = match[1];
          } else if ((match = ua.match(/Firefox\/([\d.]+)/i))) {
            name = 'Firefox';
            version = match[1];
          } else if ((match = ua.match(/FxiOS\/([\d.]+)/i))) {
            name = 'Firefox iOS';
            version = match[1];
          } else if ((match = ua.match(/CriOS\/([\d.]+)/i))) {
            name = 'Chrome iOS';
            version = match[1];
          } else if ((match = ua.match(/Chrome\/([\d.]+)/i))) {
            name = 'Google Chrome';
            version = match[1];
          } else if ((match = ua.match(/Chromium\/([\d.]+)/i))) {
            name = 'Chromium';
            version = match[1];
          } else if ((match = ua.match(/Version\/([\d.]+).*Safari\//i))) {
            name = 'Safari';
            version = match[1];
          } else if ((match = ua.match(/MSIE\s([\d.]+)/i))) {
            name = 'Internet Explorer';
            version = match[1];
          } else if (/Trident\/.*rv:([\d.]+)/i.test(ua)) {
            name = 'Internet Explorer';
            version = ua.match(/rv:([\d.]+)/i)?.[1] || '';
          }

          return {
            name,
            version
          };
        }

        function detectOS(ua) {
          let name = 'غير معروف';
          let version = '';

          let match;

          if (/Windows Phone/i.test(ua)) {
            name = 'Windows Phone';

            match =
              ua.match(/Windows Phone(?: OS)?[ /]([\d.]+)/i);

            version = match ? match[1] : '';
          } else if (/Windows NT 10\.0/i.test(ua)) {
            name = 'Windows';
            version = '10 / 11';
          } else if (/Windows NT 6\.4/i.test(ua)) {
            name = 'Windows';
            version = '10 / 11';
          } else if (/Windows NT 6\.3/i.test(ua)) {
            name = 'Windows';
            version = '8.1';
          } else if (/Windows NT 6\.2/i.test(ua)) {
            name = 'Windows';
            version = '8';
          } else if (/Windows NT 6\.1/i.test(ua)) {
            name = 'Windows';
            version = '7';
          } else if (/Windows NT 6\.0/i.test(ua)) {
            name = 'Windows';
            version = 'Vista';
          } else if (/Windows NT 5\.1|Windows XP/i.test(ua)) {
            name = 'Windows';
            version = 'XP';
          } else if (/Android/i.test(ua)) {
            name = 'Android';

            match = ua.match(/Android[ /-]?([\d._]+)/i);
            version = getVersion(match);
          } else if (
            /iPhone|iPad|iPod/i.test(ua) &&
            /OS [\d_]+/i.test(ua)
          ) {
            name = 'iOS';

            match = ua.match(/OS ([\d_]+)/i);
            version = getVersion(match);
          } else if (/Mac OS X/i.test(ua)) {
            name = 'macOS';

            match = ua.match(/Mac OS X[ /]?([\d_\.]+)/i);
            version = getVersion(match);
          } else if (/CrOS/i.test(ua)) {
            name = 'ChromeOS';

            match = ua.match(/CrOS [^;]+ ([\d.]+)/i);
            version = match ? match[1] : '';
          } else if (/Linux/i.test(ua)) {
            name = 'Linux';
          } else if (/Ubuntu/i.test(ua)) {
            name = 'Ubuntu';
          }

          return {
            name,
            version
          };
        }

        function detectDevice(ua, os) {
          if (/iPad/i.test(ua)) {
            return {
              type: 'جهاز لوحي',
              name: 'iPad'
            };
          }

          if (/iPhone/i.test(ua)) {
            return {
              type: 'هاتف',
              name: 'iPhone'
            };
          }

          if (/iPod/i.test(ua)) {
            return {
              type: 'هاتف',
              name: 'iPod'
            };
          }

          if (/Android/i.test(ua)) {
            if (/Mobile/i.test(ua)) {
              return {
                type: 'هاتف',
                name: 'Android Phone'
              };
            }

            return {
              type: 'جهاز لوحي',
              name: 'Android Tablet'
            };
          }

          if (/Windows Phone/i.test(ua)) {
            return {
              type: 'هاتف',
              name: 'Windows Phone'
            };
          }

          if (/Smart-TV|SmartTV|HbbTV|Tizen.*TV/i.test(ua)) {
            return {
              type: 'تلفاز ذكي',
              name: 'Smart TV'
            };
          }

          if (/bot|crawler|spider|slurp|bingpreview/i.test(ua)) {
            return {
              type: 'روبوت',
              name: 'Bot / Crawler'
            };
          }

          if (
            os.name === 'Windows' ||
            os.name === 'macOS' ||
            os.name === 'Linux' ||
            os.name === 'Ubuntu' ||
            os.name === 'ChromeOS'
          ) {
            return {
              type: 'حاسوب',
              name: 'Desktop / Laptop'
            };
          }

          return {
            type: 'غير معروف',
            name: 'غير معروف'
          };
        }

        function detectPlatform(ua, os, device) {
          if (/x86_64|Win64|WOW64|amd64/i.test(ua)) {
            return 'Windows 64-bit / x64';
          }

          if (/aarch64|arm64/i.test(ua)) {
            return 'ARM64';
          }

          if (/iPhone|iPad|iPod/i.test(ua)) {
            return 'Apple Mobile';
          }

          if (/Android/i.test(ua)) {
            return 'Android';
          }

          if (/Macintosh|Mac OS X/i.test(ua)) {
            return 'Apple Mac';
          }

          if (/CrOS/i.test(ua)) {
            return 'ChromeOS';
          }

          if (/Linux/i.test(ua)) {
            return 'Linux';
          }

          if (/Windows/i.test(ua)) {
            return 'Windows';
          }

          return device.name !== 'غير معروف'
            ? device.name
            : 'غير معروف';
        }

        function detectEngine(ua) {
          let name = 'غير معروف';
          let version = '';

          let match;

          if ((match = ua.match(/AppleWebKit\/([\d.]+)/i))) {
            name = 'WebKit';
            version = match[1];
          }

          if ((match = ua.match(/Gecko\/([\d.]+)/i))) {
            name = 'Gecko';
            version = match[1];
          }

          if ((match = ua.match(/Trident\/([\d.]+)/i))) {
            name = 'Trident';
            version = match[1];
          }

          if (/Chrome|Chromium|Edg|OPR/i.test(ua)) {
            if ((match = ua.match(/AppleWebKit\/([\d.]+)/i))) {
              name = 'Blink';
              version = match[1];
            }
          }

          return {
            name,
            version
          };
        }

        function parseUserAgent() {
          const ua = uaInput.value.trim();

          if (!ua) {
            showMessage('أدخل User-Agent أولاً.', 'error');
            return;
          }

          if (ua.length > 10000) {
            showMessage('User-Agent كبير جدًا.', 'error');
            return;
          }

          const browser = detectBrowser(ua);
          const os = detectOS(ua);
          const device = detectDevice(ua, os);
          const platform = detectPlatform(
            ua,
            os,
            device
          );
          const engine = detectEngine(ua);

          setText(browserName, browser.name);
          setText(browserValue, browser.name);

          setText(
            browserVersion,
            browser.version || 'غير معروف'
          );

          setText(osName, os.name);
          setText(osValue, os.name);

          setText(
            osVersion,
            os.version || 'غير معروف'
          );

          setText(deviceName, device.name);
          setText(deviceType, device.type);

          setText(platformValue, platform);

          setText(engineValue, engine.name);
          setText(
            engineVersion,
            engine.version || 'غير معروف'
          );

          rawOutput.textContent = ua;

          showMessage('تم تحليل User-Agent بنجاح.', 'success');
        }

        async function pasteUserAgent() {
          try {
            const text = await navigator.clipboard.readText();

            if (!text) {
              showMessage('الحافظة فارغة.', 'error');
              return;
            }

            uaInput.value = text;
            parseUserAgent();
          } catch {
            showMessage(
              'تعذر الوصول إلى الحافظة. الصق النص يدويًا.',
              'error'
            );
          }
        }

        function loadCurrentUserAgent() {
          uaInput.value = navigator.userAgent;
          parseUserAgent();
        }

        function loadSample() {
          uaInput.value =
            'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';

          parseUserAgent();
        }

        function clearAll() {
          uaInput.value = '';

          browserName.textContent = '—';
          osName.textContent = '—';
          deviceName.textContent = '—';

          browserValue.textContent = '—';
          browserVersion.textContent = '—';
          osValue.textContent = '—';
          osVersion.textContent = '—';
          deviceType.textContent = '—';
          platformValue.textContent = '—';

          engineValue.textContent = '—';
          engineVersion.textContent = '—';

          rawOutput.textContent = 'لا توجد بيانات';

          showMessage('تم مسح البيانات.', 'success');
        }

        async function copyUserAgent() {
          const text = rawOutput.textContent;

          if (!text || text === 'لا توجد بيانات') {
            showMessage('لا توجد بيانات لنسخها.', 'error');
            return;
          }

          try {
            await navigator.clipboard.writeText(text);

            showMessage(
              'تم نسخ User-Agent بنجاح.',
              'success'
            );
          } catch {
            const area = document.createElement('textarea');

            area.value = text;
            area.style.position = 'fixed';
            area.style.opacity = '0';

            document.body.appendChild(area);

            area.focus();
            area.select();

            try {
              document.execCommand('copy');

              showMessage(
                'تم نسخ User-Agent بنجاح.',
                'success'
              );
            } catch {
              showMessage(
                'تعذر نسخ User-Agent.',
                'error'
              );
            }

            area.remove();
          }
        }

        parseBtn.addEventListener(
          'click',
          parseUserAgent
        );

        pasteBtn.addEventListener(
          'click',
          pasteUserAgent
        );

        currentBtn.addEventListener(
          'click',
          loadCurrentUserAgent
        );

        sampleBtn.addEventListener(
          'click',
          loadSample
        );

        clearBtn.addEventListener(
          'click',
          clearAll
        );

        copyBtn.addEventListener(
          'click',
          copyUserAgent
        );

        uaInput.addEventListener('keydown', event => {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === 'Enter'
          ) {
            event.preventDefault();
            parseUserAgent();
          }
        });

        uaInput.addEventListener('input', () => {
          if (uaInput.value.trim().length > 20) {
            clearTimeout(uaInput.parseTimer);

            uaInput.parseTimer = setTimeout(() => {
              parseUserAgent();
            }, 500);
          }
        });

        loadCurrentUserAgent();
      })();
    </script>

