---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/user-agent-parser/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>User Agent Parser | محلل User Agent | Th.Tech</title>

    <meta
      name="description"
      content="أداة مجانية لتحليل User Agent واستخراج المتصفح ونظام التشغيل والجهاز والمنصة ونوع الجهاز من User-Agent."
    />

    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body class="ua-dark">
    <Header />

    <main class="ua-page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-icon">
          <i class="fa-solid fa-fingerprint"></i>
        </div>

        <span class="badge">
          <i class="fa-solid fa-code"></i>
          أداة المطورين 110
        </span>

        <h1>User Agent Parser</h1>

        <p>
          حلّل User-Agent بسرعة واكتشف المتصفح ونظام التشغيل والجهاز
          والمنصة ونوع الجهاز دون الحاجة إلى مكتبات خارجية.
        </p>
      </section>

      <!-- TOOL -->
      <section class="tool-card">

        <div class="section-title">
          <div class="title-icon">
            <i class="fa-solid fa-fingerprint"></i>
          </div>

          <div>
            <h2>تحليل User Agent</h2>
            <p>أدخل User-Agent الذي تريد تحليله</p>
          </div>
        </div>

        <div class="input-box">
          <textarea
            id="uaInput"
            maxlength="10000"
            spellcheck="false"
            placeholder="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36"
          ></textarea>

          <div class="input-actions">
            <button id="parseBtn" class="primary-btn">
              <i class="fa-solid fa-magnifying-glass"></i>
              تحليل
            </button>

            <button id="pasteBtn" class="secondary-btn">
              <i class="fa-regular fa-clipboard"></i>
              لصق
            </button>

            <button id="currentBtn" class="secondary-btn">
              <i class="fa-solid fa-desktop"></i>
              جهازي
            </button>

            <button id="sampleBtn" class="secondary-btn">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="danger-btn">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>
          </div>
        </div>

        <!-- SUMMARY -->
        <div class="summary-grid">

          <div class="summary-card">
            <div class="summary-icon browser-icon">
              <i class="fa-solid fa-globe"></i>
            </div>

            <div>
              <span>المتصفح</span>
              <strong id="browserName">—</strong>
            </div>
          </div>

          <div class="summary-card">
            <div class="summary-icon os-icon">
              <i class="fa-solid fa-laptop"></i>
            </div>

            <div>
              <span>نظام التشغيل</span>
              <strong id="osName">—</strong>
            </div>
          </div>

          <div class="summary-card">
            <div class="summary-icon device-icon">
              <i class="fa-solid fa-mobile-screen"></i>
            </div>

            <div>
              <span>الجهاز</span>
              <strong id="deviceName">—</strong>
            </div>
          </div>

        </div>

        <!-- DETAILS -->
        <div class="details-grid">

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-window-maximize"></i>
              المتصفح
            </div>

            <div class="detail-value" id="browserValue">—</div>
          </div>

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-code-branch"></i>
              إصدار المتصفح
            </div>

            <div class="detail-value" id="browserVersion">—</div>
          </div>

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-desktop"></i>
              نظام التشغيل
            </div>

            <div class="detail-value" id="osValue">—</div>
          </div>

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-hashtag"></i>
              إصدار النظام
            </div>

            <div class="detail-value" id="osVersion">—</div>
          </div>

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-mobile-screen-button"></i>
              نوع الجهاز
            </div>

            <div class="detail-value" id="deviceType">—</div>
          </div>

          <div class="detail-card">
            <div class="detail-title">
              <i class="fa-solid fa-layer-group"></i>
              المنصة
            </div>

            <div class="detail-value" id="platformValue">—</div>
          </div>

        </div>

        <!-- ENGINE -->
        <div class="engine-card">

          <div class="engine-header">
            <span>
              <i class="fa-solid fa-gears"></i>
              محرك العرض
            </span>

            <span id="engineValue" class="engine-badge">—</span>
          </div>

          <div class="engine-row">
            <span>محرك التخطيط</span>
            <strong id="engineVersion">—</strong>
          </div>

        </div>

        <!-- RAW -->
        <div class="raw-card">

          <div class="raw-header">
            <span>
              <i class="fa-solid fa-terminal"></i>
              User-Agent الأصلي
            </span>

            <button id="copyBtn" class="copy-btn">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>
          </div>

          <pre id="rawOutput">لا توجد بيانات</pre>

        </div>

        <div id="message" class="message"></div>

      </section>

      <!-- FEATURES -->
      <section class="features-section">

        <div class="section-heading">
          <span>المميزات</span>
          <h2>تحليل سريع ومباشر</h2>
        </div>

        <div class="features-grid">

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-globe"></i>
            </div>

            <h3>اكتشاف المتصفح</h3>

            <p>
              التعرف على Chrome و Firefox و Edge و Safari و Opera
              وغيرها من المتصفحات الشائعة.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-laptop"></i>
            </div>

            <h3>نظام التشغيل</h3>

            <p>
              اكتشاف Windows و macOS و Linux و Android و iOS
              وغيرها من الأنظمة.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-mobile-screen"></i>
            </div>

            <h3>نوع الجهاز</h3>

            <p>
              تحديد ما إذا كان User-Agent مرتبطًا بهاتف أو جهاز لوحي
              أو حاسوب أو جهاز آخر.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>معالجة محلية</h3>

            <p>
              يتم تحليل النص داخل المتصفح مباشرة دون إرسال User-Agent
              إلى خادم خارجي.
            </p>
          </article>

        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">

        <div class="info-card">

          <div class="info-icon">
            <i class="fa-solid fa-circle-info"></i>
          </div>

          <div>
            <h2>ما هو User-Agent؟</h2>

            <p>
              User-Agent هو نص يرسله المتصفح عادةً إلى الخادم للتعريف
              بالمتصفح ونظام التشغيل وبعض معلومات المنصة.
            </p>

            <div class="code-example">
              <code>
                Mozilla/5.0 (Windows NT 10.0; Win64; x64)
              </code>
            </div>
          </div>

        </div>

        <div class="info-card">

          <div class="info-icon">
            <i class="fa-solid fa-lightbulb"></i>
          </div>

          <div>
            <h2>لماذا يستخدمه المطورون؟</h2>

            <p>
              يمكن استخدام User-Agent لفهم نوع العميل الذي يطلب صفحة
              أو خدمة، مثل تحديد المتصفح ونظام التشغيل والمنصة.
            </p>

            <p>
              ومع ذلك، لا ينبغي اعتباره وسيلة موثوقة وحدها لتحديد هوية
              المستخدم أو الجهاز بشكل دقيق.
            </p>
          </div>

        </div>

      </section>

      <!-- HOW TO -->
      <section class="how-section">

        <div class="section-heading">
          <span>طريقة الاستخدام</span>
          <h2>كيف تستخدم الأداة؟</h2>
        </div>

        <div class="steps">

          <div class="step">
            <span>1</span>

            <div>
              <h3>أدخل User-Agent</h3>

              <p>
                الصق User-Agent في مربع الإدخال.
              </p>
            </div>
          </div>

          <div class="step">
            <span>2</span>

            <div>
              <h3>ابدأ التحليل</h3>

              <p>
                اضغط على تحليل لاستخراج المعلومات.
              </p>
            </div>
          </div>

          <div class="step">
            <span>3</span>

            <div>
              <h3>راجع النتائج</h3>

              <p>
                ستظهر معلومات المتصفح والنظام والجهاز والمنصة.
              </p>
            </div>
          </div>

          <div class="step">
            <span>4</span>

            <div>
              <h3>انسخ النص</h3>

              <p>
                يمكنك نسخ User-Agent الأصلي بضغطة واحدة.
              </p>
            </div>
          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="faq-section">

        <div class="section-heading">
          <span>FAQ</span>
          <h2>الأسئلة الشائعة</h2>
        </div>

        <details>
          <summary>
            هل تعمل الأداة بدون مكتبات خارجية؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. التحليل يتم بواسطة JavaScript داخل المتصفح
            باستخدام قواعد تحليل User-Agent مدمجة في الأداة.
          </p>
        </details>

        <details>
          <summary>
            هل يمكن تحليل User-Agent الخاص بجهازي؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. اضغط على زر "جهازي" لإدخال User-Agent الحالي
            للمتصفح ثم اضغط على تحليل.
          </p>
        </details>

        <details>
          <summary>
            هل يمكن الاعتماد على User-Agent لمعرفة الجهاز بدقة؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            ليس دائمًا. User-Agent يوفر معلومات محدودة، وقد تقوم
            المتصفحات الحديثة بتقليل بعض المعلومات أو تغييرها.
          </p>
        </details>

        <details>
          <summary>
            هل يتم إرسال User-Agent إلى الخادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            لا. عملية التحليل في هذه الأداة تتم محليًا داخل المتصفح.
          </p>
        </details>

      </section>

    



