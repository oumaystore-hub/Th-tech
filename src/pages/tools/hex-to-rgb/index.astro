---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "HEX to RGB Converter - تحويل HEX إلى RGB أونلاين | Th.Tech";

const description =
  "أداة HEX to RGB مجانية لتحويل ألوان HEX إلى RGB مباشرة من المتصفح، مع عرض قيم RGB وCSS ونسخ النتائج بسهولة.";

const faqs = [
  {
    q: "ما هو HEX في الألوان؟",
    a: "HEX هو نظام لتمثيل الألوان باستخدام ستة أحرف أو أرقام hexadecimal، مثل #3B82F6، حيث تمثل كل قيمتين قناة من قنوات اللون RGB."
  },
  {
    q: "ما هو RGB؟",
    a: "RGB هو نظام ألوان يعتمد على ثلاث قنوات: الأحمر Red والأخضر Green والأزرق Blue، وتتراوح قيمة كل قناة عادةً من 0 إلى 255."
  },
  {
    q: "هل يتم إرسال اللون إلى الخادم؟",
    a: "لا. تتم عملية تحويل HEX إلى RGB بالكامل داخل المتصفح باستخدام JavaScript، ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام RGB مباشرة في CSS؟",
    a: "نعم. يمكنك استخدام القيمة الناتجة بصيغة rgb(R, G, B) مباشرة داخل ملفات CSS."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="HEX to RGB, HEX RGB, تحويل HEX إلى RGB, RGB Converter, Color Converter, أدوات ألوان"
    />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/hex-to-rgb/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>
              <i class="fa-solid fa-house"></i>
              الرئيسية
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <a href={`${base}/tools/`}>
              الأدوات
            </a>

            <i class="fa-solid fa-chevron-left separator"></i>

            <span>HEX to RGB</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <div class="color-preview" id="heroColor"></div>
              <i class="fa-solid fa-palette"></i>
            </div>

            <div class="hero-text">
              <div class="badge">
                <i class="fa-solid fa-code"></i>
                Developer Tools
              </div>

              <h1>HEX to RGB Converter</h1>

              <p>
                حوّل ألوان HEX إلى RGB بسرعة ودقة مباشرة من المتصفح.
              </p>

              <div class="tags">
                <span>HEX</span>
                <span>RGB</span>
                <span>CSS</span>
                <span>Local</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="converter-card">

            <!-- TOP BAR -->
            <div class="card-topbar">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="tool-name">
                <i class="fa-solid fa-palette"></i>
                HEX to RGB
              </div>

              <div class="secure">
                <i class="fa-solid fa-shield-halved"></i>
                Local
              </div>
            </div>

            <!-- ACTION BAR -->
            <div class="actionbar">
              <div class="action-group">
                <button id="exampleBtn" class="btn btn-secondary">
                  <i class="fa-solid fa-flask"></i>
                  مثال
                </button>

                <button id="clearBtn" class="btn btn-secondary">
                  <i class="fa-solid fa-eraser"></i>
                  مسح
                </button>
              </div>

              <div class="action-group">
                <button id="copyRgbBtn" class="btn btn-secondary">
                  <i class="fa-regular fa-copy"></i>
                  نسخ RGB
                </button>

                <button id="convertBtn" class="btn btn-primary">
                  <i class="fa-solid fa-arrow-right-arrow-left"></i>
                  تحويل إلى RGB
                </button>
              </div>
            </div>

            <!-- INPUT -->
            <div class="input-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-hashtag"></i>
                  HEX Color
                </div>

                <span id="inputStatus">6 HEX</span>
              </div>

              <div class="hex-input-row">
                <div class="hex-prefix">#</div>

                <input
                  id="hexInput"
                  type="text"
                  maxlength="7"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="3B82F6"
                  value="3B82F6"
                />

                <input
                  id="colorPicker"
                  type="color"
                  value="#3B82F6"
                  aria-label="اختيار اللون"
                />

                <button
                  id="pickerBtn"
                  class="picker-btn"
                  type="button"
                  title="اختيار لون"
                >
                  <i class="fa-solid fa-eye-dropper"></i>
                </button>
              </div>

              <div class="input-help">
                <span>
                  <i class="fa-solid fa-circle-info"></i>
                  أدخل 6 أحرف HEX أو 3 أحرف مختصرة
                </span>

                <span id="charCount">6 / 6</span>
              </div>
            </div>

            <!-- COLOR PREVIEW -->
            <div class="preview-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-fill-drip"></i>
                  Color Preview
                </div>

                <span id="previewHex">#3B82F6</span>
              </div>

              <div class="preview-box">
                <div
                  class="large-color"
                  id="largeColor"
                  style="background:#3B82F6;"
                ></div>

                <div class="preview-info">
                  <strong id="previewName">
                    Blue
                  </strong>

                  <span id="previewDescription">
                    معاينة اللون المحدد
                  </span>
                </div>
              </div>
            </div>

            <!-- RESULT -->
            <div class="result-box" id="resultBox">
              <div class="result-icon" id="resultIcon">
                <i class="fa-solid fa-circle-check"></i>
              </div>

              <div class="result-content">
                <strong id="resultTitle">
                  تم التحويل بنجاح
                </strong>

                <p id="resultMessage">
                  تم تحويل قيمة HEX إلى RGB بنجاح.
                </p>
              </div>
            </div>

            <!-- RGB RESULT -->
            <div class="rgb-result-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-sliders"></i>
                  RGB
                </div>

                <span>0 - 255</span>
              </div>

              <div class="rgb-output">
                <div class="rgb-value">
                  <span class="channel-label red-label">R</span>
                  <strong id="redValue">59</strong>
                </div>

                <div class="rgb-value">
                  <span class="channel-label green-label">G</span>
                  <strong id="greenValue">130</strong>
                </div>

                <div class="rgb-value">
                  <span class="channel-label blue-label">B</span>
                  <strong id="blueValue">246</strong>
                </div>
              </div>
            </div>

            <!-- CSS OUTPUT -->
            <div class="output-section">
              <div class="editor-header">
                <div>
                  <i class="fa-brands fa-css3-alt"></i>
                  CSS Output
                </div>

                <span>RGB</span>
              </div>

              <div class="code-output" id="cssOutput">
                rgb(59, 130, 246)
              </div>

              <button id="copyCssBtn" class="copy-output">
                <i class="fa-regular fa-copy"></i>
                نسخ CSS
              </button>
            </div>

            <!-- RAW OUTPUT -->
            <div class="raw-section">
              <div class="editor-header">
                <div>
                  <i class="fa-solid fa-code"></i>
                  Raw RGB
                </div>

                <span>R,G,B</span>
              </div>

              <div class="raw-output" id="rawOutput">
                59, 130, 246
              </div>

              <button id="copyRawBtn" class="copy-output">
                <i class="fa-regular fa-copy"></i>
                نسخ القيم
              </button>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-hashtag"></i>
                </div>

                <div>
                  <span>HEX</span>
                  <strong id="statHex">#3B82F6</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Red</span>
                  <strong id="statRed">59</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Green</span>
                  <strong id="statGreen">130</strong>
                </div>
              </div>

              <div class="stat">
                <div class="stat-icon">
                  <i class="fa-solid fa-circle"></i>
                </div>

                <div>
                  <span>Blue</span>
                  <strong id="statBlue">246</strong>
                </div>
              </div>
            </div>

            <!-- SECURITY NOTE -->
            <div class="security-note">
              <div class="security-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>
                <strong>خصوصية وأمان</strong>

                <p>
                  تتم عملية تحويل HEX إلى RGB بالكامل داخل متصفحك.
                  لا يتم إرسال اللون أو أي بيانات إلى خادم خارجي.
                </p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <span>HEX TO RGB</span>

            <h2>
              ما هي أداة HEX to RGB؟
            </h2>

            <p>
              أداة مجانية لتحويل قيم الألوان من نظام HEX إلى RGB
              واستخدامها بسهولة في مشاريع الويب والتصميم.
            </p>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-palette"></i>
              </div>

              <h3>
                تحويل دقيق
              </h3>

              <p>
                حوّل أي قيمة HEX صحيحة إلى قيم RGB الثلاثة
                بدون الحاجة إلى أدوات خارجية.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>
                جاهز لـ CSS
              </h3>

              <p>
                احصل مباشرة على صيغة rgb() الجاهزة للاستخدام
                داخل ملفات CSS.
              </p>
            </article>

            <article class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>
                سريع ومحلي
              </h3>

              <p>
                تتم عملية التحويل فورياً داخل المتصفح دون إرسال
                البيانات إلى أي خادم.
              </p>
            </article>

          </div>
        </div>
      </section>

      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">
          <div class="section-heading">
            <span>HOW IT WORKS</span>

            <h2>
              كيفية استخدام HEX to RGB Converter
            </h2>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">
                1
              </div>

              <div>
                <h3>
                  أدخل HEX
                </h3>

                <p>
                  اكتب قيمة اللون بصيغة HEX مثل
                  #3B82F6 أو استخدم أداة اختيار اللون.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">
                2
              </div>

              <div>
                <h3>
                  حوّل اللون
                </h3>

                <p>
                  اضغط على زر تحويل إلى RGB للحصول على القيم
                  الخاصة بالأحمر والأخضر والأزرق.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">
                3
              </div>

              <div>
                <h3>
                  انسخ النتيجة
                </h3>

                <p>
                  انسخ قيمة RGB أو صيغة CSS واستخدمها مباشرة
                  في مشروعك.
                </p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">
          <div class="section-heading">
            <span>FAQ</span>

            <h2>
              الأسئلة الشائعة
            </h2>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.q}</span>

                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <!-- JAVASCRIPT -->
    <script is:inline>
      (() => {
        const hexInput = document.getElementById("hexInput");
        const colorPicker = document.getElementById("colorPicker");
        const pickerBtn = document.getElementById("pickerBtn");

        const exampleBtn = document.getElementById("exampleBtn");
        const clearBtn = document.getElementById("clearBtn");
        const convertBtn = document.getElementById("convertBtn");

        const copyRgbBtn = document.getElementById("copyRgbBtn");
        const copyCssBtn = document.getElementById("copyCssBtn");
        const copyRawBtn = document.getElementById("copyRawBtn");

        const heroColor = document.getElementById("heroColor");
        const largeColor = document.getElementById("largeColor");

        const previewHex = document.getElementById("previewHex");
        const previewName = document.getElementById("previewName");

        const redValue = document.getElementById("redValue");
        const greenValue = document.getElementById("greenValue");
        const blueValue = document.getElementById("blueValue");

        const cssOutput = document.getElementById("cssOutput");
        const rawOutput = document.getElementById("rawOutput");

        const statHex = document.getElementById("statHex");
        const statRed = document.getElementById("statRed");
        const statGreen = document.getElementById("statGreen");
        const statBlue = document.getElementById("statBlue");

        const inputStatus = document.getElementById("inputStatus");
        const charCount = document.getElementById("charCount");

        const resultBox = document.getElementById("resultBox");
        const resultIcon = document.getElementById("resultIcon");
        const resultTitle = document.getElementById("resultTitle");
        const resultMessage = document.getElementById("resultMessage");

        if (!hexInput) return;

        function normalizeHex(value) {
          let hex = String(value || "").trim();

          if (hex.startsWith("#")) {
            hex = hex.slice(1);
          }

          hex = hex.replace(/[^0-9a-fA-F]/g, "");

          if (hex.length === 3) {
            hex = hex
              .split("")
              .map(char => char + char)
              .join("");
          }

          if (hex.length !== 6) {
            return null;
          }

          if (!/^[0-9a-fA-F]{6}$/.test(hex)) {
            return null;
          }

          return "#" + hex.toUpperCase();
        }

        function hexToRgb(hex) {
          const normalized = normalizeHex(hex);

          if (!normalized) {
            return null;
          }

          const clean = normalized.slice(1);

          return {
            r: parseInt(clean.slice(0, 2), 16),
            g: parseInt(clean.slice(2, 4), 16),
            b: parseInt(clean.slice(4, 6), 16)
          };
        }

        function getColorName(r, g, b) {
          if (r > 220 && g > 220 && b > 220) {
            return "Light / White";
          }

          if (r < 40 && g < 40 && b < 40) {
            return "Black / Dark";
          }

          if (r > 200 && g < 100 && b < 100) {
            return "Red";
          }

          if (r < 100 && g > 170 && b < 130) {
            return "Green";
          }

          if (r < 100 && g < 160 && b > 180) {
            return "Blue";
          }

          if (r > 180 && g > 140 && b < 100) {
            return "Orange / Yellow";
          }

          if (r > 180 && g < 130 && b > 150) {
            return "Pink / Magenta";
          }

          if (r < 130 && g > 140 && b > 150) {
            return "Cyan";
          }

          if (r > 120 && g > 120 && b > 120) {
            return "Gray";
          }

          return "Custom Color";
        }

        function setStatus(type, title, message) {
          resultBox.classList.remove(
            "success",
            "error",
            "warning"
          );

          if (type) {
            resultBox.classList.add(type);
          }

          if (type === "error") {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-circle-xmark"></i>';
          } else if (type === "warning") {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-triangle-exclamation"></i>';
          } else {
            resultIcon.innerHTML =
              '<i class="fa-solid fa-circle-check"></i>';
          }

          resultTitle.textContent = title;
          resultMessage.textContent = message;
        }

        function updateCounters() {
          const value = hexInput.value.replace("#", "");

          charCount.textContent = `${value.length} / 6`;

          if (value.length === 6) {
            inputStatus.textContent = "6 HEX";
          } else if (value.length === 3) {
            inputStatus.textContent = "3 HEX";
          } else {
            inputStatus.textContent = `${value.length} / 6`;
          }
        }

        function updateColor(hex) {
          heroColor.style.backgroundColor = hex;
          largeColor.style.backgroundColor = hex;

          previewHex.textContent = hex;

          colorPicker.value = hex;

          const rgb = hexToRgb(hex);

          if (!rgb) return;

          const name = getColorName(
            rgb.r,
            rgb.g,
            rgb.b
          );

          previewName.textContent = name;
        }

        function convert() {
          const value = hexInput.value.trim();

          const rgb = hexToRgb(value);

          if (!rgb) {
            setStatus(
              "error",
              "قيمة HEX غير صحيحة",
              "أدخل لوناً بصيغة HEX صحيحة مثل #3B82F6."
            );

            return;
          }

          const normalized = normalizeHex(value);

          const rgbString =
            `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;

          const rawString =
            `${rgb.r}, ${rgb.g}, ${rgb.b}`;

          redValue.textContent = rgb.r;
          greenValue.textContent = rgb.g;
          blueValue.textContent = rgb.b;

          cssOutput.textContent = rgbString;
          rawOutput.textContent = rawString;

          statHex.textContent = normalized;
          statRed.textContent = rgb.r;
          statGreen.textContent = rgb.g;
          statBlue.textContent = rgb.b;

          updateColor(normalized);
          updateCounters();

          setStatus(
            "success",
            "تم التحويل بنجاح",
            `${normalized} = ${rgbString}`
          );
        }

        async function copyText(text, button) {
          if (!text) return;

          const original = button.innerHTML;

          try {
            await navigator.clipboard.writeText(text);

            button.innerHTML =
              '<i class="fa-solid fa-check"></i> تم النسخ';

            setTimeout(() => {
              button.innerHTML = original;
            }, 1500);
          } catch {
            const textarea =
              document.createElement("textarea");

            textarea.value = text;

            textarea.style.position = "fixed";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);

            textarea.select();

            try {
              document.execCommand("copy");

              button.innerHTML =
                '<i class="fa-solid fa-check"></i> تم النسخ';

              setTimeout(() => {
                button.innerHTML = original;
              }, 1500);
            } catch {
              button.innerHTML =
                '<i class="fa-solid fa-xmark"></i> فشل النسخ';

              setTimeout(() => {
                button.innerHTML = original;
              }, 1500);
            }

            textarea.remove();
          }
        }

        function clearAll() {
          hexInput.value = "";

          redValue.textContent = "0";
          greenValue.textContent = "0";
          blueValue.textContent = "0";

          cssOutput.textContent = "—";
          rawOutput.textContent = "—";

          statHex.textContent = "—";
          statRed.textContent = "0";
          statGreen.textContent = "0";
          statBlue.textContent = "0";

          previewHex.textContent = "—";
          previewName.textContent = "لا يوجد لون";

          heroColor.style.backgroundColor =
            "transparent";

          largeColor.style.backgroundColor =
            "transparent";

          updateCounters();

          setStatus(
            "",
            "جاهز للتحويل",
            "أدخل قيمة HEX ثم اضغط على تحويل إلى RGB."
          );

          hexInput.focus();
        }

        function setExample() {
          hexInput.value = "3B82F6";

          updateCounters();
          convert();
        }

        function syncPicker() {
          const value = normalizeHex(
            hexInput.value
          );

          if (!value) return;

          colorPicker.value = value;
        }

        hexInput.addEventListener("input", () => {
          hexInput.value =
            hexInput.value
              .replace(/[^0-9a-fA-F#]/g, "")
              .slice(0, 7);

          updateCounters();

          const normalized =
            normalizeHex(hexInput.value);

          if (normalized) {
            updateColor(normalized);
          }
        });

        hexInput.addEventListener("keydown", event => {
          if (
            event.key === "Enter"
          ) {
            event.preventDefault();
            convert();
          }
        });

        colorPicker.addEventListener("input", () => {
          hexInput.value =
            colorPicker.value
              .replace("#", "")
              .toUpperCase();

          updateCounters();
          convert();
        });

        pickerBtn.addEventListener("click", () => {
          colorPicker.click();
        });

        convertBtn.addEventListener(
          "click",
          convert
        );

        exampleBtn.addEventListener(
          "click",
          setExample
        );

        clearBtn.addEventListener(
          "click",
          clearAll
        );

        copyRgbBtn.addEventListener(
          "click",
          () => {
            const rgb =
              cssOutput.textContent;

            if (
              !rgb ||
              rgb === "—"
            ) {
              return;
            }

            copyText(
              rgb,
              copyRgbBtn
            );
          }
        );

        copyCssBtn.addEventListener(
          "click",
          () => {
            const css =
              cssOutput.textContent;

            if (
              !css ||
              css === "—"
            ) {
              return;
            }

            copyText(
              css,
              copyCssBtn
            );
          }
        );

        copyRawBtn.addEventListener(
          "click",
          () => {
            const raw =
              rawOutput.textContent;

            if (
              !raw ||
              raw === "—"
            ) {
              return;
            }

            copyText(
              raw,
              copyRawBtn
            );
          }
        );

        window.addEventListener(
          "themeChange",
          () => {
            syncTheme();
          }
        );

        document.addEventListener(
          "click",
          event => {
            const button =
              event.target.closest(
                "#theme-btn"
              );

            if (button) {
              setTimeout(
                syncTheme,
                0
              );
            }
          }
        );

        function syncTheme() {
          try {
            const saved =
              localStorage.getItem(
                "theme"
              );

            if (
              saved === "dark"
            ) {
              document.documentElement.classList.add(
                "dark-mode"
              );
            } else {
              document.documentElement.classList.remove(
                "dark-mode"
              );
            }
          } catch {}
        }

        syncTheme();

        updateCounters();
        syncPicker();
        convert();
      })();
    </script>

