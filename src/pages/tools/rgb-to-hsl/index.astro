              </div>

            </div>


            <div class="channel-card">

              <div class="channel-icon">
                <i class="fa-solid fa-circle-half-stroke"></i>
              </div>

              <div class="channel-content">

                <span>
                  Saturation
                </span>

                <strong id="saturationValue">
                  0%
                </strong>

              </div>

            </div>


            <div class="channel-card">

              <div class="channel-icon">
                <i class="fa-solid fa-sun"></i>
              </div>

