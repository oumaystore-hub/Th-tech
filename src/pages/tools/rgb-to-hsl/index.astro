            </div>

            <div
              id="cssOutput"
              class="code-output"
            >
              color: hsl(0, 0%, 0%);
            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-r"></i>
              </div>

              <div>
                <span>Red</span>
                <strong id="statRed">52</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-g"></i>
              </div>

              <div>
                <span>Green</span>
                <strong id="statGreen">152</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-b"></i>
              </div>

              <div>
                <span>Blue</span>
                <strong id="statBlue">219</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>


          <!-- SECURITY -->
          <div class="security-note">

            <div class="security-icon">

              <i class="fa-solid fa-shield-halved"></i>

            </div>

            <div>

              <strong>
                خصوصية كاملة
              </strong>

              <p>
                تتم جميع عمليات تحويل الألوان داخل المتصفح مباشرة،
                ولا يتم إرسال قيم RGB إلى أي خادم خارجي.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- INFO -->
    <section class="info-section">

      <div class="container">

        <div class="section-heading">

          <span>
            RGB TO HSL
          </span>

          <h2>
            ما هو تحويل RGB إلى HSL؟
          </h2>

          <p>
            أداة تساعد المطورين والمصممين على تحويل الألوان
            من نظام RGB إلى نظام HSL بسهولة وسرعة.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-palette"></i>
            </div>

            <h3>
              Hue
            </h3>

            <p>
              يمثل درجة اللون على عجلة الألوان،
              وتتراوح قيمته بين 0 و360 درجة.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-circle-half-stroke"></i>
            </div>

            <h3>
              Saturation
            </h3>

            <p>
              يحدد مستوى تشبع اللون وقوته،
              ويتم التعبير عنه كنسبة مئوية.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-sun"></i>
            </div>

            <h3>
              Lightness
            </h3>

            <p>
              يحدد درجة إضاءة اللون من الأسود
              إلى الأبيض كنسبة مئوية.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="how-section">

      <div class="container">

        <div class="section-heading">

          <span>
            HOW IT WORKS
          </span>

          <h2>
            كيفية استخدام RGB to HSL
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>

              <h3>
                أدخل قيم RGB
              </h3>

              <p>
                أدخل قيم الأحمر والأخضر والأزرق،
                بحيث تكون كل قيمة بين 0 و255.
              </p>

            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>

              <h3>
                ابدأ التحويل
              </h3>

              <p>
                اضغط على زر تحويل إلى HSL للحصول
                على القيم الجديدة فوراً.
              </p>

            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>

              <h3>
                انسخ النتيجة
              </h3>

              <p>
                انسخ HSL أو كود CSS واستخدمه
                مباشرة في مشروعك.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="container">

        <div class="section-heading">

          <span>
            FAQ
          </span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (

            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>

          ))}

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <script is:inline>
    (() => {

      const redInput =
        document.getElementById("redInput");

      const greenInput =
        document.getElementById("greenInput");

      const blueInput =
        document.getElementById("blueInput");

      const colorPreview =
        document.getElementById("colorPreview");

      const convertBtn =
        document.getElementById("convertBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyHslBtn =
        document.getElementById("copyHslBtn");

      const copyRgbBtn =
        document.getElementById("copyRgbBtn");

      const copyCssBtn =
        document.getElementById("copyCssBtn");

      const hslOutput =
        document.getElementById("hslOutput");

      const rgbOutput =
        document.getElementById("rgbOutput");

      const cssOutput =
        document.getElementById("cssOutput");

      const hueValue =
        document.getElementById("hueValue");

      const saturationValue =
        document.getElementById("saturationValue");

      const lightnessValue =
        document.getElementById("lightnessValue");

      const statRed =
        document.getElementById("statRed");

      const statGreen =
        document.getElementById("statGreen");

      const statBlue =
        document.getElementById("statBlue");

      const statStatus =
        document.getElementById("statStatus");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const rgbStatus =
        document.getElementById("rgbStatus");


      function getRgbValues() {

        const r = Number(redInput.value);
        const g = Number(greenInput.value);
        const b = Number(blueInput.value);

        return { r, g, b };

      }


      function isValidChannel(value) {

        return (
          Number.isFinite(value) &&
          value >= 0 &&
          value <= 255
        );

      }


      function rgbToHsl(r, g, b) {

        r /= 255;
        g /= 255;
        b /= 255;

        const max =
          Math.max(r, g, b);

        const min =
          Math.min(r, g, b);

        let h = 0;
        let s = 0;

        const l =
          (max + min) / 2;


        if (max !== min) {

          const d =
            max - min;

          s =
            l > 0.5
              ? d / (2 - max - min)
              : d / (max + min);


          switch (max) {

            case r:

              h =
                (g - b) / d +
                (g < b ? 6 : 0);

              break;


            case g:

              h =
                (b - r) / d +
                2;

              break;


            case b:

              h =
                (r - g) / d +
                4;

              break;

          }

          h /= 6;

        }


        return {
          h: Math.round(h * 360),
          s: Math.round(s * 100),
          l: Math.round(l * 100)
        };

      }


      function rgbToHex(r, g, b) {

        return "#" + [r, g, b]
          .map(value =>
            value
              .toString(16)
              .padStart(2, "0")
          )
          .join("")
          .toUpperCase();

      }


      function showError(message) {

        resultBox.classList.remove("success");

        resultBox.classList.add("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-exclamation"></i>';

        resultTitle.textContent =
          "قيم RGB غير صحيحة";

        resultMessage.textContent =
          message;

        rgbStatus.textContent =
          "Invalid";

        statStatus.textContent =
          "خطأ";

      }


      function showSuccess(r, g, b, hsl) {

        resultBox.classList.remove("error");

        resultBox.classList.add("success");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم التحويل بنجاح";

        resultMessage.textContent =
          "تم تحويل RGB إلى HSL بنجاح.";

        rgbStatus.textContent =
          "Valid";


        const hslString =
          `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;

        const rgbString =
          `rgb(${r}, ${g}, ${b})`;


        hslOutput.textContent =
          hslString;

        rgbOutput.textContent =
          rgbString;

        cssOutput.textContent =
          `color: ${hslString};`;


        hueValue.textContent =
          `${hsl.h}°`;

        saturationValue.textContent =
          `${hsl.s}%`;

        lightnessValue.textContent =
          `${hsl.l}%`;


        statRed.textContent =
          r;

        statGreen.textContent =
          g;

        statBlue.textContent =
          b;

        statStatus.textContent =
          "تم";


        colorPreview.style.background =
          `rgb(${r}, ${g}, ${b})`;

      }


      function convert() {

        const { r, g, b } =
          getRgbValues();


        if (
          !isValidChannel(r) ||
          !isValidChannel(g) ||
          !isValidChannel(b)
        ) {

          showError(
            "يجب أن تكون كل قيمة RGB بين 0 و255."
          );

          return;

        }


        const hsl =
          rgbToHsl(r, g, b);


        showSuccess(
          r,
          g,
          b,
          hsl
        );

      }


      function updatePreview() {

        const { r, g, b } =
          getRgbValues();


        if (
          isValidChannel(r) &&
          isValidChannel(g) &&
          isValidChannel(b)
        ) {

          colorPreview.style.background =
            `rgb(${r}, ${g}, ${b})`;

        }

      }


      function copyText(text, button) {

        if (!text) return;


        const original =
          button.innerHTML;


        const done = () => {

          button.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {

            button.innerHTML =
              original;

          }, 1400);

        };


        if (
          navigator.clipboard &&
          window.isSecureContext
        ) {

          navigator.clipboard
            .writeText(text)
            .then(done)
            .catch(() =>
              fallbackCopy(text, done)
            );

        } else {

          fallbackCopy(text, done);

        }

      }


      function fallbackCopy(text, callback) {

        const textarea =
          document.createElement("textarea");

        textarea.value =
          text;

        textarea.style.position =
          "fixed";

        textarea.style.opacity =
          "0";

        document.body.appendChild(
          textarea
        );

        textarea.focus();

        textarea.select();


        try {

          document.execCommand("copy");

          callback();

        } catch {}


        textarea.remove();

      }


      function setExample() {

        redInput.value =
          "52";

        greenInput.value =
          "152";

        blueInput.value =
          "219";

        updatePreview();

        convert();

      }


      function clearAll() {

        redInput.value =
          "";

        greenInput.value =
          "";

        blueInput.value =
          "";


        colorPreview.style.background =
          "transparent";


        hslOutput.textContent =
          "hsl(0, 0%, 0%)";

        rgbOutput.textContent =
          "rgb(0, 0, 0)";

        cssOutput.textContent =
          "color: hsl(0, 0%, 0%);";


        hueValue.textContent =
          "0°";

        saturationValue.textContent =
          "0%";

        lightnessValue.textContent =
          "0%";


        statRed.textContent =
          "0";

        statGreen.textContent =
          "0";

        statBlue.textContent =
          "0";

        statStatus.textContent =
          "جاهز";


        rgbStatus.textContent =
          "RGB";


        resultBox.classList.remove(
          "success",
          "error"
        );


        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز للتحويل";

        resultMessage.textContent =
          "أدخل قيم RGB ثم اضغط على تحويل إلى HSL.";

      }


      [
        redInput,
        greenInput,
        blueInput
      ].forEach(input => {

        input.addEventListener(
          "input",
          updatePreview
        );

      });


      convertBtn.addEventListener(
        "click",
        convert
      );


      exampleBtn.addEventListener(
        "click",
        setExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyHslBtn.addEventListener(
        "click",
        () => {

          copyText(
            hslOutput.textContent,
            copyHslBtn
          );

        }
      );


      copyRgbBtn.addEventListener(
        "click",
        () => {

          copyText(
            rgbOutput.textContent,
            copyRgbBtn
          );

        }
      );


      copyCssBtn.addEventListener(
        "click",
        () => {

          copyText(
            cssOutput.textContent,
            copyCssBtn
          );

        }
      );


      [
        redInput,
        greenInput,
        blueInput
      ].forEach(input => {

        input.addEventListener(
          "keydown",
          event => {

            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {

              convert();

            }

          }
        );

      });


      // Theme synchronization
      function syncTheme() {

        try {

          const saved =
            localStorage.getItem("theme");

          if (saved === "dark") {

            document.documentElement
              .classList.add("dark-mode");

          } else {

            document.documentElement
              .classList.remove("dark-mode");

          }

        } catch {}

      }


      syncTheme();


      window.addEventListener(
        "themeChange",
        syncTheme
      );


      document.addEventListener(
        "click",
        event => {

          const button =
            event.target.closest(
              "#theme-btn"
            );

          if (button) {

            setTimeout(
              syncTheme,
              0
            );

          }

        }
      );


      // Initial preview
      updatePreview();

    })();
  </script>


