---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "RGB to HSL - تحويل RGB إلى HSL أونلاين مجاناً | Th.Tech";

const description =
  "أداة RGB to HSL مجانية لتحويل ألوان RGB إلى HSL مباشرة داخل المتصفح، مع عرض Hue وSaturation وLightness وكود CSS.";

const faqs = [
  {
    q: "ما هو نظام HSL؟",
    a: "HSL هو نظام لتمثيل الألوان يعتمد على Hue وSaturation وLightness، أي درجة اللون والتشبع والإضاءة."
  },
  {
    q: "كيف أحول RGB إلى HSL؟",
    a: "أدخل قيم R وG وB بين 0 و255 ثم اضغط على زر تحويل إلى HSL للحصول على النتيجة مباشرة."
  },
  {
    q: "ما هي القيم الصحيحة لـ RGB؟",
    a: "كل قناة من قنوات RGB وهي الأحمر والأخضر والأزرق تتراوح بين 0 و255."
  },
  {
    q: "هل يتم إرسال بيانات اللون إلى الخادم؟",
    a: "لا. تتم عملية التحويل بالكامل داخل المتصفح باستخدام JavaScript ولا يتم إرسال بيانات اللون إلى خادم خارجي."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/rgb-to-hsl/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">

          <a href={`${base}/`}>
            <i class="fa-solid fa-house"></i>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fa-solid fa-chevron-left separator"></i>

          <span>RGB to HSL</span>

        </div>

        <div class="hero-content">

          <div class="hero-icon">

            <div class="icon-glow"></div>

            <i class="fa-solid fa-palette"></i>

            <span>HSL</span>

          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

