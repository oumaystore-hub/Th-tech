      font-size: 15px;

    }


    .step p {

      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.8;

    }


    /* =========================
       FAQ
    ========================== */

    .faq-section {

      padding:
        70px 0;

      background: var(--surface);

      border-top:
