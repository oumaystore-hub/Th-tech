---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Timezone Converter - تحويل المناطق الزمنية أونلاين | Th.Tech";

const description =
  "أداة Timezone Converter مجانية لتحويل التاريخ والوقت بين المناطق الزمنية المختلفة، مع عرض الوقت المحلي وUTC والفرق الزمني.";

const faqs = [
  {
    q: "ما هي أداة Timezone Converter؟",
    a: "هي أداة تساعدك على تحويل التاريخ والوقت من منطقة زمنية إلى منطقة أخرى مع مراعاة فرق التوقيت."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. تتم جميع عمليات التحويل داخل المتصفح باستخدام JavaScript ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "ما الفرق بين UTC والمنطقة الزمنية المحلية؟",
    a: "UTC هو التوقيت العالمي المنسق، بينما التوقيت المحلي يعتمد على المنطقة الزمنية التي تختارها وقد يتغير حسب التوقيت الصيفي."
  },
  {
    q: "هل الأداة مناسبة للمطورين؟",
    a: "نعم. يمكن استخدامها عند تطوير APIs والتطبيقات العالمية وجدولة المهام والتعامل مع المستخدمين الموجودين في مناطق زمنية مختلفة."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href={`https://oumaystore-hub.github.io${base}/tools/timezone-converter/`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          function syncTheme() {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          }

          syncTheme();

          window.addEventListener("themeChange", syncTheme);

          document.addEventListener("click", (event) => {
            const button = event.target.closest("#theme-btn");

            if (button) {
              setTimeout(syncTheme, 0);
            }
          });
        } catch {}
      })();
    </script>

    <style>
      :root {
        --bg: #f4f7fb;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #e2e8f0;

        --text: #172033;
        --muted: #6b7280;

        --primary: #2563eb;
        --primary-2: #06b6d4;
        --primary-soft: rgba(37, 99, 235, 0.1);

        --success: #16a34a;
        --success-soft: rgba(22, 163, 74, 0.1);

        --warning: #d97706;
        --warning-soft: rgba(217, 119, 6, 0.1);

        --shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
      }

      html.dark-mode {
        --bg: #070b12;
        --surface: #101722;
        --surface-2: #151d29;
        --border: #263244;

        --text: #edf3fb;
        --muted: #8e9aac;

        --primary: #60a5fa;
        --primary-2: #22d3ee;
        --primary-soft: rgba(96, 165, 250, 0.12);

        --success: #22c55e;
        --success-soft: rgba(34, 197, 94, 0.1);

        --warning: #f59e0b;
        --warning-soft: rgba(245, 158, 11, 0.1);

        --shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 80% 0%,
            var(--primary-soft),
            transparent 28%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      button,
      input,
      select {
        font: inherit;
      }

      .container {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 52px 0 46px;
        border-bottom: 1px solid var(--border);
      }

      .hero::before {
        content: "";
        position: absolute;
        width: 330px;
        height: 330px;
        left: -160px;
        top: -180px;
        border-radius: 50%;
        background: var(--primary-soft);
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 32px;
        color: var(--muted);
        font-size: 12px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: 0.2s;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
      }

      .hero-content {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .hero-icon {
        width: 112px;
        height: 112px;
        flex: 0 0 112px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        border-radius: 32px;
        color: #fff;
        background:
          linear-gradient(
            145deg,
            var(--primary),
            var(--primary-2)
          );
        box-shadow:
          0 20px 40px rgba(37, 99, 235, 0.25),
          inset 0 1px 0 rgba(255, 255, 255, 0.25);
      }

      .hero-icon i {
        font-size: 37px;
      }

      .hero-icon span {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        opacity: 0.9;
      }

      .hero-text {
        min-width: 0;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      h1 {
        margin: 0 0 9px;
        font-size: clamp(30px, 5vw, 45px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
      }

      .hero-text > p {
        margin: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 17px;
      }

      .tags span {
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      /* TOOL */

      .tool-section {
        padding: 45px 0 25px;
      }

      .converter-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .tool-top {
        min-height: 65px;
        padding: 0 23px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: var(--surface-2);
        border-bottom: 1px solid var(--border);
      }

      .tool-name {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 14px;
        font-weight: 700;
      }

      .tool-name i {
        color: var(--primary);
      }

      .local-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--success);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      .workspace {
        padding: 25px;
      }

      .time-input {
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        background: var(--surface-2);
      }

      .field-head {
        min-height: 48px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        font-weight: 700;
      }

      .field-head div {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .field-head i {
        color: var(--primary);
      }

      .field-head span {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
      }

      .input-body {
        padding: 18px;
      }

      .datetime-input {
        width: 100%;
        height: 58px;
        padding: 0 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        outline: none;
        background: var(--surface);
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
        direction: ltr;
        text-align: left;
      }

      .datetime-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
      }

      .zones {
        display: grid;
        grid-template-columns: 1fr 60px 1fr;
        align-items: end;
        gap: 15px;
        margin-top: 18px;
      }

      .zone-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
      }

      .zone-field select {
        width: 100%;
        height: 47px;
        padding: 0 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        outline: none;
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
      }

      .zone-field select:focus {
        border-color: var(--primary);
      }

      .zone-arrow {
        height: 47px;
        display: grid;
        place-items: center;
        color: var(--primary);
        font-size: 19px;
      }

      .zone-arrow i {
        transition: 0.25s;
      }

      .zone-arrow:hover i {
        transform: translateX(-5px);
      }

      /* RESULTS */

      .result-area {
        margin-top: 20px;
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 12px;
      }

      .result-card {
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--surface-2);
      }

      .result-card.main {
        border-color: rgba(37, 99, 235, 0.3);
        background: var(--primary-soft);
      }

      .result-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: var(--muted);
        font-size: 10px;
      }

      .result-label div {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .result-label i {
        color: var(--primary);
      }

      .copy-btn {
        border: 0;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font-size: 10px;
      }

      .copy-btn:hover {
        color: var(--primary);
      }

      .result-value {
        direction: ltr;
        text-align: left;
        word-break: break-word;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        line-height: 1.8;
      }

      .main .result-value {
        color: var(--primary);
        font-size: 17px;
        font-weight: 600;
      }

      .result-zone {
        margin-top: 5px;
        color: var(--muted);
        font-size: 10px;
      }

      /* ACTIONS */

      .actions {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }

      .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .btn {
        min-height: 43px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 11px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        transition: 0.2s;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        border: 0;
        color: #fff;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--primary-2)
        );
        box-shadow: 0 8px 22px rgba(37, 99, 235, 0.2);
      }

      .btn-secondary {
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--text);
      }

      /* STATUS */

      .status {
        margin-top: 17px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 12px;
        background: var(--success-soft);
        color: var(--success);
        font-size: 11px;
      }

      /* STATS */

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 11px;
        margin-top: 17px;
      }

      .stat {
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .stat-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--muted);
        font-size: 9px;
        margin-bottom: 7px;
      }

      .stat-label i {
        color: var(--primary);
      }

      .stat strong {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        word-break: break-word;
      }

      /* INFO */

      .info-section,
      .how-section,
      .faq-section {
        padding: 55px 0;
      }

      .section-heading {
        max-width: 700px;
        margin: 0 auto 30px;
        text-align: center;
      }

      .section-heading > span {
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 7px 0;
        font-size: clamp(24px, 4vw, 32px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .info-card {
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
        transition: 0.2s;
      }

      .info-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
      }

      .info-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: var(--primary-soft);
        color: var(--primary);
        margin-bottom: 16px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 15px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* STEPS */

      .steps {
        max-width: 900px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        padding: 23px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
      }

      .step-number {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        color: white;
        background: var(--primary);
        font-weight: 800;
        margin-bottom: 17px;
      }

      .step h3 {
        margin: 0 0 7px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 9px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        list-style: none;
        cursor: pointer;
        padding: 17px 19px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        font-size: 12px;
        font-weight: 700;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: 0.2s;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        margin: 0;
        padding: 0 19px 17px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.9;
      }

      @media (max-width: 850px) {
        .result-area {
          grid-template-columns: 1fr 1fr;
        }

        .result-card.main {
          grid-column: 1 / -1;
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .container {
          width: min(100% - 22px, 1120px);
        }

        .hero {
          padding: 35px 0;
        }

        .hero-content {
          align-items: flex-start;
          flex-direction: column;
          gap: 20px;
        }

        .hero-icon {
          width: 80px;
          height: 80px;
          flex-basis: 80px;
          border-radius: 24px;
        }

        .hero-icon i {
          font-size: 27px;
        }

        h1 {
          font-size: 30px;
        }

        .hero-text > p {
          font-size: 13px;
        }

        .workspace {
          padding: 14px;
        }

        .tool-top {
          padding: 0 14px;
        }

        .zones {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .zone-arrow {
          height: 25px;
          transform: rotate(90deg);
        }

        .result-area {
          grid-template-columns: 1fr;
        }

        .result-card.main {
          grid-column: auto;
        }

        .actions {
          flex-direction: column;
          align-items: stretch;
        }

        .action-group {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
        }

        .btn {
          width: 100%;
          padding: 0 8px;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 40px 0;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container">
          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Timezone Converter</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-solid fa-earth-americas"></i>
              <span>TIMEZONE</span>
            </div>

            <div class="hero-text">
              <div class="badge">
                <i class="fa-solid fa-globe"></i>
                Developer Tools
              </div>

              <h1>Timezone Converter</h1>

              <p>
                حوّل التاريخ والوقت بين المناطق الزمنية المختلفة
                واعرف الوقت المقابل بدقة وسرعة.
              </p>

              <div class="tags">
                <span>UTC</span>
                <span>Local Time</span>
                <span>Timezone</span>
                <span>ISO 8601</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="converter-card">
            <div class="tool-top">
              <div class="tool-name">
                <i class="fa-solid fa-earth-americas"></i>
                Timezone Converter
              </div>

              <div class="local-badge">
                <i class="fa-solid fa-shield-halved"></i>
                LOCAL
              </div>
            </div>

            <div class="workspace">
              <div class="time-input">
                <div class="field-head">
                  <div>
                    <i class="fa-regular fa-calendar-days"></i>
                    التاريخ والوقت
                  </div>

                  <span>DATETIME</span>
                </div>

                <div class="input-body">
                  <input
                    id="dateInput"
                    class="datetime-input"
                    type="datetime-local"
                  />
                </div>
              </div>

              <div class="zones">
                <div class="zone-field">
                  <label for="fromZone">
                    المنطقة الزمنية الأصلية
                  </label>

                  <select id="fromZone">
                    <option value="UTC">UTC</option>
                    <option value="Africa/Casablanca">
                      Africa/Casablanca — المغرب
                    </option>
                    <option value="Europe/London">
                      Europe/London — لندن
                    </option>
                    <option value="Europe/Paris">
                      Europe/Paris — باريس
                    </option>
                    <option value="Europe/Berlin">
                      Europe/Berlin — برلين
                    </option>
                    <option value="America/New_York">
                      America/New_York — نيويورك
                    </option>
                    <option value="America/Los_Angeles">
                      America/Los_Angeles — لوس أنجلوس
                    </option>
                    <option value="Asia/Dubai">
                      Asia/Dubai — دبي
                    </option>
                    <option value="Asia/Riyadh">
                      Asia/Riyadh — الرياض
                    </option>
                    <option value="Asia/Tokyo">
                      Asia/Tokyo — طوكيو
                    </option>
                    <option value="Asia/Shanghai">
                      Asia/Shanghai — شنغهاي
                    </option>
