---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Timezone Converter - محول المناطق الزمنية أونلاين | Th.Tech";

const description =
  "أداة Timezone Converter مجانية لتحويل الوقت والتاريخ بين جميع المناطق الزمنية في العالم مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو Timezone Converter؟",
    a: "هو أداة تساعدك على تحويل التاريخ والوقت من منطقة زمنية إلى منطقة زمنية أخرى بسهولة، مع دعم المناطق الزمنية العالمية."
  },
  {
    q: "هل الأداة تدعم جميع المناطق الزمنية؟",
    a: "نعم. تستخدم الأداة قاعدة المناطق الزمنية المتوفرة في المتصفح عبر Intl.supportedValuesOf، وتعرض المناطق الزمنية المعروفة مثل Africa وAmerica وAsia وEurope وAustralia وPacific وUTC وغيرها."
  },
  {
    q: "هل يتم إرسال الوقت أو البيانات إلى الخادم؟",
    a: "لا. عملية التحويل تتم بالكامل داخل المتصفح باستخدام JavaScript وواجهة Intl، ولا تحتاج إلى إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "هل يمكنني استخدام الأداة لتحويل وقت اجتماع دولي؟",
    a: "نعم. اختر وقت الاجتماع والمنطقة الزمنية الأصلية ثم اختر المنطقة الزمنية التي تريد التحويل إليها للحصول على الوقت المقابل."
  }
];
