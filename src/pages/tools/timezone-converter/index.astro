    }


    .faq-list {

      max-width: 850px;

      margin-inline: auto;

      display: grid;

      gap: 10px;

    }


    .faq-list details {

      border:
        1px solid var(--border);

      border-radius: 14px;

      background: var(--surface-2);

      overflow: hidden;

    }


    .faq-list summary {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding:
        17px 19px;

      cursor: pointer;

      list-style: none;

      font-size: 13px;

      font-weight: 700;

    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {

      color: var(--primary);

      transition:
        transform 0.2s ease;

    }


    .faq-list details[open]
    summary i {

      transform:
        rotate(180deg);

    }


    .faq-list details p {

      margin: 0;

      padding:
        0 19px 18px;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.9;

    }


    /* =========================
       RESPONSIVE
    ========================== */

    @media (max-width: 900px) {

      .info-grid,
      .steps {

        grid-template-columns:
          repeat(2, 1fr);

      }

      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);

      }

    }


    @media (max-width: 700px) {

      .hero {

        padding:
          30px 0 50px;

      }


      .hero-content {

        align-items: flex-start;

        flex-direction: column;

      }


      .hero-icon {

        width: 76px;
        height: 76px;

        flex-basis: 76px;

        border-radius: 21px;

        font-size: 30px;

      }


      .hero p {

        font-size: 14px;

      }


      .actionbar {

        align-items: stretch;

        flex-direction: column;

      }


      .action-group {

        width: 100%;

      }


      .action-group .btn {

        flex: 1;

      }


      .timezone-grid {

        grid-template-columns:
          1fr;

        align-items: stretch;

      }


      .swap-wrapper {

        display: flex;

        justify-content: center;

        padding: 0;

      }


      #swapBtn {

        transform: rotate(90deg);

      }


      #swapBtn:hover {

        transform:
          rotate(270deg);

      }


      .technical-grid {

        grid-template-columns:
          1fr;

      }


      .result-box {

        align-items: flex-start;

      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;

      }

    }


    @media (max-width: 520px) {

      .container {

        width:
          min(
            100% - 20px,
            1180px
          );

      }


      .converter-body {

        padding: 16px;

      }


      .stats-grid {

        grid-template-columns:
          1fr 1fr;

        padding:
          0 16px 16px;

      }


      .stat {

        flex-direction: column;

        align-items: flex-start;

      }


      .security-note {

        margin:
          0 16px 16px;

      }


      .card-topbar {

        padding:
          0 15px;

      }


      .window-dots {

        display: none;

      }


      .tool-name {

        font-size: 12px;

      }


      .secure {

        font-size: 10px;

      }


      .result-box {

        padding: 16px;

      }


      .result-icon {

        width: 45px;
        height: 45px;

        flex-basis: 45px;

        border-radius: 12px;

        font-size: 18px;

      }


      .result-content strong {

        font-size: 16px;

      }

    }

  </style>

