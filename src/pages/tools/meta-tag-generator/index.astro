---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Meta Tag Generator - إنشاء Meta Tags أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لإنشاء Meta Tags لمواقع الويب وتحسين ظهور الصفحات في محركات البحث ومشاركة الروابط.";

const canonical = `${base}/tools/meta-tag-generator/`;
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/png" href={`${base}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>Meta Tag Generator</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-tags"></i>
          </div>

          <div>
            <span class="kicker">
              <i class="fas fa-code"></i>
              HTML Tools
            </span>

            <h1>
              Meta Tag <span>Generator</span>
            </h1>

            <p>
              أنشئ Meta Tags احترافية لصفحات موقعك لتحسين محركات البحث
              ومشاركة الروابط على الشبكات الاجتماعية.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- TOOLBAR -->
          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-tags"></i>
              <span>Meta Tag Generator</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- FORM -->
          <div class="generator-grid">

            <div class="form-panel">

              <div class="panel-title">
                <i class="fas fa-pen"></i>
                معلومات الصفحة
              </div>


              <div class="field">

                <label for="siteTitle">
                  عنوان الصفحة
                </label>

                <input
                  id="siteTitle"
                  type="text"
                  maxlength="160"
                  placeholder="مثال: Th.Tech - أدوات تقنية مجانية"
                />

                <small>
                  يفضل أن يكون العنوان واضحاً ومختصراً.
                </small>

              </div>


              <div class="field">

                <label for="siteDescription">
                  وصف الصفحة
                </label>

                <textarea
                  id="siteDescription"
                  maxlength="320"
                  placeholder="اكتب وصفاً مختصراً ومفيداً للصفحة..."
                ></textarea>

                <small>
                  وصف مختصر يوضح محتوى الصفحة.
                </small>

              </div>


              <div class="field">

                <label for="siteUrl">
                  رابط الصفحة
                </label>

                <input
                  id="siteUrl"
                  type="url"
                  placeholder="https://example.com/"
                />

              </div>


              <div class="field">

                <label for="siteAuthor">
                  اسم المؤلف
                </label>

                <input
                  id="siteAuthor"
                  type="text"
                  placeholder="Th.Tech"
                />

              </div>


              <div class="field">

                <label for="robots">
                  Robots
                </label>

                <select id="robots">

                  <option value="index, follow">
                    index, follow
                  </option>

                  <option value="index, nofollow">
                    index, nofollow
                  </option>

                  <option value="noindex, follow">
                    noindex, follow
                  </option>

                  <option value="noindex, nofollow">
                    noindex, nofollow
                  </option>

                </select>

              </div>


              <div class="field">

                <label for="themeColor">
                  لون المتصفح
                </label>

                <div class="color-row">

                  <input
                    id="themeColor"
                    type="color"
                    value="#2563eb"
                  />

                  <span id="colorValue">
                    #2563eb
                  </span>

                </div>

              </div>

            </div>


            <!-- OUTPUT -->

            <div class="output-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-code"></i>
                  Meta Tags
                </div>

                <span id="tagCount">
                  0 tags
                </span>

              </div>


              <div class="editor-wrapper">

                <textarea
                  id="output"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر Meta Tags هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- MAIN ACTION -->

          <div class="main-actions">

            <button
              id="generateBtn"
              class="generate-btn"
              type="button"
            >
              <i class="fas fa-wand-magic-sparkles"></i>
              إنشاء Meta Tags
              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- STATUS -->

          <div id="status" class="status hidden">

            <i id="statusIcon" class="fas fa-check-circle"></i>

            <span id="statusText"></span>

          </div>


          <!-- PREVIEW -->

          <div class="preview-section">

            <div class="preview-title">
              <i class="fas fa-eye"></i>
              معاينة نتائج البحث
            </div>

            <div class="search-preview">

              <div
                id="previewTitle"
                class="preview-result-title"
              >
                عنوان الصفحة سيظهر هنا
              </div>

              <div
                id="previewUrl"
                class="preview-result-url"
              >
                https://example.com/
              </div>

              <div
                id="previewDescription"
                class="preview-result-description"
              >
                وصف الصفحة سيظهر هنا...
              </div>

            </div>

          </div>

        </div>


        <!-- INFO -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-search"></i>
            </div>

            <div>

              <h3>
                تحسين SEO
              </h3>

              <p>
                أنشئ عناصر Meta الأساسية التي تساعد محركات البحث
                على فهم محتوى الصفحة.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-share-nodes"></i>
            </div>

            <div>

              <h3>
                مشاركة أفضل
              </h3>

              <p>
                أضف معلومات Open Graph وTwitter Cards
                لتحسين ظهور روابط موقعك عند مشاركتها.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>
                يعمل داخل المتصفح
              </h3>

              <p>
                تتم عملية إنشاء الأكواد محلياً داخل المتصفح
                دون الحاجة إلى إرسال بياناتك إلى خادم خارجي.
              </p>

            </div>

          </div>

        </div>


        <!-- HOW TO -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-info"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>Meta Tag Generator؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">
                <i class="fas fa-pen"></i>
              </div>

              <h3>
                أدخل المعلومات
              </h3>

              <p>
                أضف عنوان الصفحة والوصف والرابط
                وباقي المعلومات الأساسية.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">
                <i class="fas fa-wand-magic-sparkles"></i>
              </div>

              <h3>
                أنشئ الأكواد
              </h3>

              <p>
                اضغط على زر إنشاء Meta Tags
                لتوليد الأكواد تلقائياً.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">
                <i class="fas fa-copy"></i>
              </div>

              <h3>
                انسخ النتيجة
              </h3>

              <p>
                انسخ الأكواد وضعها داخل وسم
                head في صفحة HTML.
              </p>

            </div>

          </div>

        </div>


        <!-- FAQ -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">
              <i class="fas fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>Meta Tags</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>
                ما هي Meta Tags؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                هي عناصر HTML توضع داخل قسم head في الصفحة
                لتقديم معلومات لمحركات البحث والمتصفحات
                وخدمات مشاركة الروابط.
              </p>

            </details>


            <details>

              <summary>
                أين أضع الأكواد الناتجة؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                ضع الأكواد داخل قسم head في صفحة HTML الخاصة بك.
              </p>

            </details>


            <details>

              <summary>
                هل Meta Tags مهمة لمحركات البحث؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                بعض Meta Tags تساعد محركات البحث على فهم الصفحة،
                بينما تساعد عناصر أخرى في التحكم في طريقة ظهور
                الرابط عند مشاركته.
              </p>

            </details>


            <details>

              <summary>
                هل يتم إرسال بياناتي إلى الخادم؟
                <i class="fas fa-chevron-down"></i>
              </summary>

              <p>
                لا. يتم إنشاء الكود باستخدام JavaScript
                مباشرة داخل المتصفح.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;
      --border: rgba(15, 23, 42, .09);
      --shadow: 0 20px 60px rgba(15, 23, 42, .08);
    }


    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, .12);
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
      transition:
        background-color .25s ease,
        color .25s ease;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }


    button {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 0 20px;
    }


    /* HERO */

    .tool-hero {
      position: relative;
      overflow: hidden;
      padding: 55px 0 65px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(37, 99, 235, .10),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: .78rem;
    }


    .breadcrumb a {
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: .55rem;
      opacity: .6;
    }


    .hero-content {
      position: relative;
      display: flex;
      align-items: center;
      gap: 22px;
    }


    .tool-icon {
      width: 78px;
      height: 78px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      color: var(--primary);
      background: rgba(37, 99, 235, .10);
      border: 1px solid rgba(37, 99, 235, .15);

      font-size: 2rem;

      box-shadow:
        0 15px 35px rgba(37, 99, 235, .10);
    }


    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: .76rem;
      font-weight: 800;
    }


    .hero-content h1 {
      margin: 0 0 8px;

      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.25;
    }


    .hero-content h1 span {
      color: var(--primary);
    }


    .hero-content p {
      max-width: 720px;

      margin: 0;

      color: var(--muted);
      font-size: .92rem;
    }


    /* TOOL */

    .tool-section {
      padding: 65px 0 90px;
    }


    .tool-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);

      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }


    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .toolbar-title {
      display: flex;
      align-items: center;

      gap: 9px;

      font-size: .9rem;
      font-weight: 800;
    }


    .toolbar-title i {
      color: var(--primary);
    }


    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }


    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding: 7px 13px;

      border-radius: 10px;

      border: 1px solid var(--border);

      background: var(--card);

      color: var(--text);

      font-size: .76rem;
      font-weight: 700;

      cursor: pointer;

      transition: .2s ease;
    }


    .tool-btn:hover {
      border-color: rgba(37, 99, 235, .35);
      color: var(--primary);

      transform: translateY(-2px);
    }


    .tool-btn.danger:hover {
      color: var(--red);
      border-color: rgba(220, 38, 38, .25);
    }


    /* GENERATOR */

    .generator-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 20px;

      padding: 20px;
    }


    .form-panel,
    .output-panel {
      overflow: hidden;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .panel-title,
    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      padding: 13px 16px;

      border-bottom: 1px solid var(--border);

      color: var(--muted);

      font-size: .76rem;
      font-weight: 800;
    }


    .panel-title {
      justify-content: flex-start;
    }


    .panel-title i,
    .panel-header i {
      color: var(--primary);
    }


    .field {
      padding: 13px 16px 0;
    }


    .field:last-child {
      padding-bottom: 16px;
    }


    .field label {
      display: block;

      margin-bottom: 7px;

      color: var(--text);

      font-size: .75rem;
      font-weight: 700;
    }


    .field input,
    .field textarea,
    .field select {
      width: 100%;

      border: 1px solid var(--border);

      border-radius: 10px;

      outline: none;

      background: var(--card);

      color: var(--text);

      padding: 10px 12px;

      font-size: .78rem;

      transition: .2s ease;
    }


    .field input,
    .field select {
      height: 43px;
    }


    .field textarea {
      height: 85px;

      resize: vertical;

      line-height: 1.7;
    }


    .field input:focus,
    .field textarea:focus,
    .field select:focus {
      border-color: rgba(37, 99, 235, .45);

      box-shadow:
        0 0 0 3px rgba(37, 99, 235, .08);
    }


    .field small {
      display: block;

      margin-top: 5px;

      color: var(--muted);

      font-size: .64rem;
    }


    .color-row {
      display: flex;
      align-items: center;

      gap: 10px;
    }


    .color-row input {
      width: 48px;
      height: 40px;

      padding: 3px;

      cursor: pointer;
    }


    #colorValue {
      direction: ltr;

      color: var(--muted);

      font-family: monospace;

      font-size: .75rem;
    }


    .editor-wrapper {
      height: 450px;
    }


    #output {
      width: 100%;
      height: 100%;

      display: block;

      resize: none;

      outline: none;
      border: 0;

      padding: 18px;

      background: transparent;

      color: var(--primary);

      direction: ltr;
      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .78rem;

      line-height: 1.8;
    }


    #output::placeholder {
      color: var(--muted);
      opacity: .65;
    }


    /* ACTION */

    .main-actions {
      display: flex;
      justify-content: center;

      padding: 0 20px 20px;
    }


    .generate-btn {
      min-width: 245px;
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 10px;

      border: 0;
      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #3b82f6,
          #2563eb
        );

      color: white;

      font-family: inherit;

      font-size: .9rem;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px rgba(37, 99, 235, .22);

      transition: .25s ease;
    }


    .generate-btn:hover {
      transform: translateY(-3px);

      box-shadow:
        0 17px 35px rgba(37, 99, 235, .30);
    }


    /* STATUS */

    .status {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin: 0 20px 20px;

      padding: 11px 15px;

      border-radius: 11px;

      background: rgba(34, 197, 94, .08);

      border:
        1px solid rgba(34, 197, 94, .15);

      color: var(--green);

      font-size: .78rem;
      font-weight: 700;
    }


    .status.error {
      background: rgba(220, 38, 38, .08);

      border-color:
        rgba(220, 38, 38, .15);

      color: var(--red);
    }


    .hidden {
      display: none;
    }


    /* PREVIEW */

    .preview-section {
      margin: 0 20px 20px;

      padding: 20px;

      border-radius: 16px;

      border: 1px solid var(--border);

      background: var(--card2);
    }


    .preview-title {
      display: flex;
      align-items: center;

      gap: 8px;

      margin-bottom: 15px;

      color: var(--text);

      font-size: .8rem;
      font-weight: 800;
    }


    .preview-title i {
      color: var(--primary);
    }


    .search-preview {
      max-width: 760px;

      padding: 18px;

      border-radius: 12px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .preview-result-title {
      color: #1a0dab;

      font-size: 1.08rem;
      font-weight: 600;

      line-height: 1.5;
    }


    .preview-result-url {
      margin-top: 4px;

      color: #188038;

      direction: ltr;
      text-align: left;

      font-size: .75rem;
    }


    .preview-result-description {
      margin-top: 5px;

      color: var(--muted);

      font-size: .75rem;

      line-height: 1.8;
    }


    /* INFO */

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;
    }


    .info-card {
      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(37, 99, 235, .25);
    }


    .info-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);
    }


    .info-card h3 {
      margin: 0 0 5px;

      font-size: .9rem;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: .74rem;

      line-height: 1.8;
    }


    /* SECTIONS */

    .how-section,
    .faq-section {
      margin-top: 100px;
    }


    .section-heading {
      text-align: center;

      margin-bottom: 40px;
    }


    .section-heading h2 {
      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    /* STEPS */

    .steps {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }


    .step {
      position: relative;

      overflow: hidden;

      padding: 30px 25px;

      text-align: center;

      border-radius: 20px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    .step-number {
      position: absolute;

      top: 10px;
      left: 15px;

      color: var(--primary);

      opacity: .08;

      font-size: 3rem;
      font-weight: 800;
    }


    .step-icon {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 17px;

      border-radius: 16px;

      color: var(--primary);

      background:
        rgba(37, 99, 235, .09);

      font-size: 1.2rem;
    }


    .step h3 {
      margin: 0 0 7px;

      font-size: 1rem;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.8;
    }


    /* FAQ */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 12px;
    }


    details {
      padding: 0 20px;

      border-radius: 15px;

      background: var(--card);

      border: 1px solid var(--border);
    }


    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 19px 0;

      cursor: pointer;

      list-style: none;

      font-size: .86rem;
      font-weight: 700;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {
      color: var(--primary);

      font-size: .7rem;

      transition: transform .2s ease;
    }


    details[open] summary i {
      transform: rotate(180deg);
    }


    details p {
      margin: 0;

      padding: 0 0 19px;

      color: var(--muted);

      font-size: .76rem;

      line-height: 1.9;
    }


    /* MOBILE */

    @media (max-width: 800px) {

      .tool-hero {
        padding: 40px 0 50px;
      }


      .hero-content {
        align-items: flex-start;
      }


      .tool-icon {
        width: 65px;
        height: 65px;

        border-radius: 18px;

        font-size: 1.6rem;
      }


      .generator-grid {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }


      .editor-wrapper {
        height: 350px;
      }

    }


    @media (max-width: 600px) {

      .container {
        padding-left: 14px;
        padding-right: 14px;
      }


      .tool-hero {
        padding: 30px 0 40px;
      }


      .breadcrumb {
        font-size: .68rem;
      }


      .hero-content {
        gap: 14px;
      }


      .tool-icon {
        width: 55px;
        height: 55px;

        border-radius: 15px;

        font-size: 1.35rem;
      }


      .hero-content h1 {
        font-size: 1.75rem;
      }


      .hero-content p {
        font-size: .75rem;

        line-height: 1.8;
      }


      .tool-section {
        padding: 45px 0 65px;
      }


      .tool-card {
        border-radius: 18px;
      }


      .toolbar {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .toolbar-actions {
        width: 100%;
      }


      .tool-btn {
        flex: 1;
      }


      .generator-grid {
        padding: 12px;

        gap: 12px;
      }


      .editor-wrapper {
        height: 300px;
      }


      .main-actions {
        padding: 0 12px 12px;
      }


      .generate-btn {
        width: 100%;

        min-width: 0;
      }


      .preview-section {
        margin: 0 12px 12px;

        padding: 15px;
      }


      .info-card {
        padding: 18px;
      }


      .how-section,
      .faq-section {
        margin-top: 70px;
      }


      .section-heading {
        margin-bottom: 30px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;

        transition-duration: .01ms !important;
      }


      html {
        scroll-behavior: auto;
      }

    }

  </style>


  <!-- ================= JAVASCRIPT ================= -->

  <script is:inline>
    (() => {

      /* THEME */

      const applyTheme = (isDark) => {

        if (isDark) {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }

        try {
          localStorage.setItem(
            "theme",
            isDark ? "dark" : "light"
          );
        } catch {}

      };


      window.addEventListener(
        "themeChange",
        (event) => {

          const theme = event?.detail;

          if (
            theme === "dark" ||
            theme === "light"
          ) {
            applyTheme(theme === "dark");
          }

        }
      );


      /* ELEMENTS */

      const siteTitle =
        document.getElementById("siteTitle");

      const siteDescription =
        document.getElementById("siteDescription");

      const siteUrl =
        document.getElementById("siteUrl");

      const siteAuthor =
        document.getElementById("siteAuthor");

      const robots =
        document.getElementById("robots");

      const themeColor =
        document.getElementById("themeColor");

      const colorValue =
        document.getElementById("colorValue");

      const output =
        document.getElementById("output");

      const generateBtn =
        document.getElementById("generateBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const status =
        document.getElementById("status");

      const statusIcon =
        document.getElementById("statusIcon");

      const statusText =
        document.getElementById("statusText");

      const tagCount =
        document.getElementById("tagCount");

      const previewTitle =
        document.getElementById("previewTitle");

      const previewUrl =
        document.getElementById("previewUrl");

      const previewDescription =
        document.getElementById("previewDescription");


      /* STATUS */

      const showStatus = (
        message,
        isError = false
      ) => {

        status.classList.remove("hidden");

        status.classList.toggle(
          "error",
          isError
        );

        statusIcon.className =
          isError
            ? "fas fa-circle-exclamation"
            : "fas fa-check-circle";

        statusText.textContent = message;

      };


      const hideStatus = () => {

        status.classList.add("hidden");

      };


      /* ESCAPE HTML */

      const escapeHTML = (value) => {

        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");

      };


      /* GENERATE */

      const generateTags = () => {

        hideStatus();

        const title =
          siteTitle.value.trim();

        const description =
          siteDescription.value.trim();

        const url =
          siteUrl.value.trim();

        const author =
          siteAuthor.value.trim();

        const robotValue =
          robots.value;

        const color =
          themeColor.value;


        if (!title) {

          showStatus(
            "أدخل عنوان الصفحة أولاً.",
            true
          );

          siteTitle.focus();

          return;

        }


        if (!description) {

          showStatus(
            "أدخل وصف الصفحة أولاً.",
            true
          );

          siteDescription.focus();

          return;

        }


        const safeTitle =
          escapeHTML(title);

        const safeDescription =
          escapeHTML(description);

        const safeUrl =
          escapeHTML(url);

        const safeAuthor =
          escapeHTML(author);

        let tags = [];


        tags.push(
          `<title>${safeTitle}</title>`
        );


        tags.push(
          `<meta name="description" content="${safeDescription}" />`
        );


        if (safeUrl) {

          tags.push(
            `<link rel="canonical" href="${safeUrl}" />`
          );

        }


        if (safeAuthor) {

          tags.push(
            `<meta name="author" content="${safeAuthor}" />`
          );

        }


        tags.push(
          `<meta name="robots" content="${escapeHTML(robotValue)}" />`
        );


        tags.push(
          `<meta name="theme-color" content="${escapeHTML(color)}" />`
        );


        /* OPEN GRAPH */

        if (safeUrl) {

          tags.push(
            `<meta property="og:url" content="${safeUrl}" />`
          );

        }


        tags.push(
          `<meta property="og:type" content="website" />`
        );


        tags.push(
          `<meta property="og:title" content="${safeTitle}" />`
        );


        tags.push(
          `<meta property="og:description" content="${safeDescription}" />`
        );


        /* TWITTER */

        tags.push(
          `<meta name="twitter:card" content="summary_large_image" />`
        );


        tags.push(
          `<meta name="twitter:title" content="${safeTitle}" />`
        );


        tags.push(
          `<meta name="twitter:description" content="${safeDescription}" />`
        );


        output.value =
          tags.join("\n");


        tagCount.textContent =
          `${tags.length} tags`;


        updatePreview();

        showStatus(
          "تم إنشاء Meta Tags بنجاح."
        );

      };


      /* PREVIEW */

      const updatePreview = () => {

        const title =
          siteTitle.value.trim();

        const description =
          siteDescription.value.trim();

        const url =
          siteUrl.value.trim();


        previewTitle.textContent =
          title ||
          "عنوان الصفحة سيظهر هنا";


        previewUrl.textContent =
          url ||
          "https://example.com/";


        previewDescription.textContent =
          description ||
          "وصف الصفحة سيظهر هنا...";

      };


      /* COPY */

      const copyOutput = async () => {

        const value =
          output.value.trim();


        if (!value) {

          showStatus(
            "أنشئ Meta Tags أولاً.",
            true
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            value
          );

          showStatus(
            "تم نسخ Meta Tags بنجاح."
          );


          copyBtn.innerHTML =
            '<i class="fas fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fas fa-copy"></i> نسخ';

          }, 1800);

        } catch {

          output.select();

          document.execCommand("copy");

          showStatus(
            "تم نسخ الأكواد."
          );

        }

      };


      /* CLEAR */

      const clearAll = () => {

        siteTitle.value = "";
        siteDescription.value = "";
        siteUrl.value = "";
        siteAuthor.value = "";

        robots.value =
          "index, follow";

        themeColor.value =
          "#2563eb";

        colorValue.textContent =
          "#2563eb";

        output.value = "";

        tagCount.textContent =
          "0 tags";

        updatePreview();

        hideStatus();

        siteTitle.focus();

      };


      /* COLOR */

      themeColor.addEventListener(
        "input",
        () => {

          colorValue.textContent =
            themeColor.value;

        }
      );


      /* LIVE PREVIEW */

      siteTitle.addEventListener(
        "input",
        updatePreview
      );


      siteDescription.addEventListener(
        "input",
        updatePreview
      );


      siteUrl.addEventListener(
        "input",
        updatePreview
      );


      /* EVENTS */

      generateBtn.addEventListener(
        "click",
        generateTags
      );


      copyBtn.addEventListener(
        "click",
        copyOutput
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      /* CTRL + ENTER */

      siteDescription.addEventListener(
        "keydown",
        (event) => {

          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            generateTags();

          }

        }
      );


      updatePreview();

    })();
  </script>

</body>
</html>
