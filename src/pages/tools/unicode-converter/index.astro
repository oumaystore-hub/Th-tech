---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/unicode-converter/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Unicode Converter | محول Unicode | Th.Tech</title>

  <meta
    name="description"
    content="محول Unicode احترافي لتحويل النصوص إلى Unicode والعكس، مع دعم U+ و JavaScript و HTML Entity."
  />

  <link rel="canonical" href={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="unicode-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-badge">
        <i class="fa-solid fa-language"></i>
        أداة Unicode
      </div>

      <h1>
        محول <span>Unicode</span> احترافي
      </h1>

      <p>
        حوّل النصوص إلى رموز Unicode والعكس بسهولة، مع دعم
        U+ و JavaScript و HTML Entity.
      </p>

      <div class="hero-points">

        <span>
          <i class="fa-solid fa-bolt"></i>
          تحويل فوري
        </span>

        <span>
          <i class="fa-solid fa-globe"></i>
          يدعم العربية
        </span>

        <span>
          <i class="fa-solid fa-mobile-screen"></i>
          يعمل على الهاتف
        </span>

      </div>

    </section>


    <!-- MAIN TOOL -->
    <section class="tool">

      <div class="tool-top">

        <div>

          <div class="mini-label">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Unicode Converter
          </div>

          <h2>حوّل النص وUnicode بسهولة</h2>

          <p>
            اختر اتجاه التحويل وأدخل البيانات ثم اضغط على تحويل.
          </p>

        </div>

        <div class="status" id="status">
          <span></span>
          جاهز
        </div>

      </div>


      <!-- MODE -->
      <div class="type-area">

        <div class="type-title">
          اتجاه التحويل
        </div>

        <div class="types">

          <button
            class="type active"
            type="button"
            data-mode="text"
            id="textMode"
          >
            <i class="fa-solid fa-font"></i>
            <span>النص → Unicode</span>
          </button>

          <button
            class="type"
            type="button"
            data-mode="unicode"
            id="unicodeMode"
          >
            <i class="fa-solid fa-code"></i>
            <span>Unicode → النص</span>
          </button>

        </div>

      </div>


      <!-- WORK AREA -->
      <div class="work">

        <!-- INPUT -->
        <div class="editor">

          <div class="block-head">

            <div class="block-icon">
              <i class="fa-solid fa-pen"></i>
            </div>

            <div>

              <h3 id="inputTitle">
                النص
              </h3>

              <p id="inputHint">
                اكتب النص الذي تريد تحويله إلى Unicode
              </p>

            </div>

          </div>


          <div class="fields">

            <label for="mainInput">
              المحتوى
              <b>*</b>
            </label>

            <textarea
              id="mainInput"
              placeholder="اكتب النص هنا..."
              spellcheck="false"
              autocomplete="off"
            ></textarea>

            <div class="field-meta">

              <span id="charCount">
                0 حرف
              </span>

              <span>
                يدعم العربية واللغات المختلفة
              </span>

            </div>

          </div>


          <!-- FORMAT -->
          <div class="settings">

            <div class="settings-head">
              <i class="fa-solid fa-sliders"></i>
              صيغة Unicode
            </div>

            <div class="settings-grid">

              <div>

                <label for="formatSelect">
                  الصيغة
                </label>

                <select id="formatSelect">

                  <option value="uplus" selected>
                    U+0041
                  </option>

                  <option value="javascript">
                    \u0041
                  </option>

                  <option value="html-decimal">
                    &#65;
                  </option>

                  <option value="html-hex">
                    &#x41;
                  </option>

                </select>

              </div>

              <div>

                <label for="separatorSelect">
                  الفاصل
                </label>

                <select id="separatorSelect">

                  <option value="space" selected>
                    مسافة
                  </option>

                  <option value="comma">
                    فاصلة
                  </option>

                  <option value="newline">
                    سطر جديد
                  </option>

                </select>

              </div>

              <div>

                <label for="caseSelect">
                  حالة Hex
                </label>

                <select id="caseSelect">

                  <option value="upper" selected>
                    أحرف كبيرة
                  </option>

                  <option value="lower">
                    أحرف صغيرة
                  </option>

                </select>

              </div>

            </div>

          </div>


          <!-- ACTIONS -->
          <div class="main-actions">

            <button
              class="reset-btn"
              type="button"
              id="resetBtn"
            >
              <i class="fa-solid fa-rotate-left"></i>
              إعادة ضبط
            </button>

            <button
              class="generate-btn"
              type="button"
              id="convertBtn"
            >
              <i class="fa-solid fa-bolt"></i>
              تحويل Unicode
            </button>

          </div>


          <div
            id="message"
            class="message"
          ></div>

        </div>


        <!-- OUTPUT -->
        <div class="preview">

          <div class="block-head preview-head">

            <div class="block-icon">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <div>

              <h3>
                النتيجة
              </h3>

              <p id="previewState">
                في انتظار البيانات
              </p>

            </div>

          </div>


          <div class="result-container">

            <div
              class="result-empty"
              id="resultEmpty"
            >

              <div class="empty-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <strong>
                ستظهر النتيجة هنا
              </strong>

              <span>
                أدخل البيانات ثم اضغط تحويل
              </span>

            </div>

            <pre
              id="result"
              class="result"
            ></pre>

          </div>


          <div class="result-meta">

            <span>
              <i class="fa-solid fa-circle-check"></i>
              جاهز
            </span>

            <span id="resultInfo">
              Unicode
            </span>

          </div>


          <div class="export-title">
            أدوات النتيجة
          </div>


          <div class="export-grid">

            <button
              class="export"
              id="copyBtn"
              type="button"
              disabled
            >
              <i class="fa-solid fa-copy"></i>

              <span>
                <strong>نسخ</strong>
                <small>النتيجة</small>
              </span>
            </button>


            <button
              class="export"
              id="copyCodesBtn"
              type="button"
              disabled
            >
              <i class="fa-solid fa-code"></i>

              <span>
                <strong>نسخ الأكواد</strong>
                <small>Unicode</small>
              </span>
            </button>


            <button
              class="export"
              id="clearBtn"
              type="button"
            >
              <i class="fa-solid fa-trash"></i>

              <span>
                <strong>مسح</strong>
                <small>النتيجة</small>
              </span>
            </button>

          </div>


          <!-- CHARACTER DETAILS -->

          <div class="details-title">
            تفاصيل الأحرف
          </div>

          <div
            id="characterDetails"
            class="character-details"
          >
            <div class="details-empty">
              ستظهر تفاصيل الأحرف هنا
            </div>
          </div>

        </div>

      </div>

    </section>


    <!-- FEATURES -->
    <section class="features">

      <div class="feature">

        <div>
          <i class="fa-solid fa-language"></i>
        </div>

        <section>

          <strong>
            دعم Unicode
          </strong>

          <span>
            يدعم الأحرف والرموز المختلفة
          </span>

        </section>

      </div>


      <div class="feature">

        <div>
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <section>

          <strong>
            خصوصية كاملة
          </strong>

          <span>
            تتم المعالجة داخل المتصفح
          </span>

        </section>

      </div>


      <div class="feature">

        <div>
          <i class="fa-solid fa-copy"></i>
        </div>

        <section>

          <strong>
            نسخ سريع
          </strong>

          <span>
            انسخ النتيجة بضغطة واحدة
          </span>

        </section>

      </div>

    </section>


    <!-- INFO -->
    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-circle-info"></i>
      </div>

      <div>

        <h2>
          ما هو Unicode؟
        </h2>

        <p>
          Unicode هو معيار عالمي لترميز الأحرف والرموز،
          ويسمح بتمثيل لغات مختلفة مثل العربية والإنجليزية
          والفرنسية وغيرها داخل الأنظمة الرقمية.
        </p>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="info">

      <div class="info-icon">
        <i class="fa-solid fa-list-check"></i>
      </div>

      <div class="info-body">

        <h2>
          طريقة الاستخدام
        </h2>

        <div class="steps">

          <div class="step">

            <span>1</span>

            <div>

              <strong>
                اختر الاتجاه
              </strong>

              <p>
                النص إلى Unicode أو Unicode إلى النص.
              </p>

            </div>

          </div>


          <div class="step">

            <span>2</span>

            <div>

              <strong>
                أدخل البيانات
              </strong>

              <p>
                اكتب النص أو رموز Unicode.
              </p>

            </div>

          </div>


          <div class="step">

            <span>3</span>

            <div>

              <strong>
                اختر الصيغة
              </strong>

              <p>
                U+ أو JavaScript أو HTML Entity.
              </p>

            </div>

          </div>


          <div class="step">

            <span>4</span>

            <div>

              <strong>
                انسخ النتيجة
              </strong>

              <p>
                انسخ النتيجة أو أكواد Unicode.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- TIP -->
    <section class="tip">

      <div class="tip-icon">
        <i class="fa-solid fa-lightbulb"></i>
      </div>

      <div>

        <strong>
          نصيحة
        </strong>

        <p>
          يمكنك استخدام صيغة U+0041 عند التعامل مع Unicode
          بشكل مباشر، بينما تعد صيغ JavaScript وHTML مفيدة
          للمطورين داخل الأكواد وصفحات الويب.
        </p>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq">

      <div class="faq-title">

        <span>
          دليل الأداة
        </span>

        <h2>
          الأسئلة الشائعة
        </h2>

      </div>


      <details>

        <summary>

          ما الفرق بين Unicode وASCII؟

          <i class="fa-solid fa-plus"></i>

        </summary>

        <p>
          ASCII يدعم مجموعة محدودة من الأحرف الأساسية،
          بينما Unicode يدعم عددًا ضخمًا من الأحرف والرموز
          واللغات المختلفة.
        </p>

      </details>


      <details>

        <summary>

          ما معنى U+0041؟

          <i class="fa-solid fa-plus"></i>

        </summary>

        <p>
          U+0041 هو التمثيل الست عشري لنقطة Unicode الخاصة
          بالحرف A.
        </p>

      </details>


      <details>

        <summary>

          هل الأداة تدعم اللغة العربية؟

          <i class="fa-solid fa-plus"></i>

        </summary>

        <p>
          نعم. يمكن تحويل الأحرف العربية واللغات الأخرى
          إلى قيم Unicode.
        </p>

      </details>


      <details>

        <summary>

          هل يتم إرسال النص إلى الخادم؟

          <i class="fa-solid fa-plus"></i>

        </summary>

        <p>
          لا. تتم عمليات التحويل داخل متصفحك مباشرة.
        </p>

      </details>

    </section>

  









<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/barcode-generator/`}
        >
          <span class="related-tool-icon">
            
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="4" y="4" width="6" height="6"/>
        <rect x="14" y="4" width="6" height="6"/>
        <rect x="4" y="14" width="6" height="6"/>
        <path d="M14 14h3v3h-3zM20 14v6M14 20h3"/>
      </svg>
          </span>

          <span class="related-tool-content">
            <strong>Barcode Generator</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-decoder/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Base64 Decoder</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/base64-encoder/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Base64 Encoder</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-diff/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Code Diff</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-formatter/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Code Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>

          <span class="related-tool-arrow" aria-hidden="true">
            ←
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-minifier/`}
        >
          <span class="related-tool-icon">
            
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14v16H5z"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>
          </span>

          <span class="related-tool-content">
            <strong>Code Minifier</strong>
