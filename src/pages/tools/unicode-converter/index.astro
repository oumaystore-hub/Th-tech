      --page-bg-soft: #eaf4fa;

      --surface: #ffffff;
      --surface-2: #f7fbfe;
      --surface-3: #edf6fb;

      --field: #f5f9fc;

      --text: #13263a;
      --text-soft: #40576d;
      --muted: #687f94;
      --muted-2: #8799a9;

      --line: rgba(12,126,183,.13);
      --line-strong: rgba(12,126,183,.27);

      --blue: #069fdf;
      --blue-dark: #087bbd;

      --success: #079f75;
      --danger: #df4e65;

      --shadow:
        0 18px 50px rgba(33,91,125,.10);

    }


    :global(html.dark-mode),
    :global(body.unicode-dark) {

      --page-bg: #071321;
      --page-bg-soft: #0a192a;

      --surface: #0d1d2e;
      --surface-2: #102337;
      --surface-3: #12283d;

      --field: #081624;

      --text: #f5f9fd;
      --text-soft: #c0cfdd;
      --muted: #8ca0b4;
      --muted-2: #6d8297;

      --line: rgba(92,194,246,.15);
      --line-strong: rgba(92,194,246,.30);

      --blue: #28b8f2;
      --blue-dark: #0b8dce;

      --success: #2ad5a1;
      --danger: #ff6178;

      --shadow:
        0 20px 60px rgba(0,0,0,.20);

    }


    :global(body) {

      margin: 0;

      background:
        radial-gradient(
          circle at 85% 0%,
          rgba(40,184,242,.08),
          transparent 32%
        ),
        var(--page-bg);

      color:
        var(--text);

      font-family:
        "Cairo",
        sans-serif;

      transition:
        background .25s ease,
        color .25s ease;

    }


    .unicode-page {

      width:
        min(1120px,calc(100% - 32px));

      margin:
        0 auto;

      padding:
        38px 0 80px;

    }


    /* HERO */

    .hero {

      text-align:
        center;

      padding:
        12px 10px 38px;

    }


    .hero-badge {

      width:
        fit-content;

      margin:
        0 auto 16px;

      padding:
        7px 14px;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--blue);

      background:
        rgba(40,184,242,.09);

      border:
        1px solid var(--line-strong);

      border-radius:
        999px;

      font-size:
        12px;

      font-weight:
        700;

    }


    .hero h1 {

      margin:
        0;

      font-size:
        clamp(29px,5vw,46px);

      line-height:
        1.35;

      font-weight:
        800;

    }


    .hero h1 span {
      color:
        var(--blue);
    }


    .hero > p {

      max-width:
        680px;

      margin:
        13px auto 20px;

      color:
        var(--muted);

      font-size:
        14px;

      line-height:
        2;

    }


    .hero-points {

      display:
        flex;

      justify-content:
        center;

      align-items:
        center;

      flex-wrap:
        wrap;

      gap:
        9px;

    }


    .hero-points span {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        7px 12px;

      color:
        var(--text-soft);

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        10px;

      font-size:
        10px;

    }


    .hero-points i {
      color:
        var(--blue);
    }


    /* TOOL */

    .tool {

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        24px;

      box-shadow:
        var(--shadow);

      overflow:
        hidden;

      transition:
        background .25s ease,
        border-color .25s ease;

    }


    .tool-top {

      padding:
        26px 28px;

      display:
        flex;

      justify-content:
        space-between;

      align-items:
        flex-start;

      gap:
        20px;

      border-bottom:
        1px solid var(--line);

    }


    .mini-label {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      color:
        var(--blue);

      font-size:
        11px;

      font-weight:
        800;

    }


    .tool-top h2 {

      margin:
        6px 0 3px;

      font-size:
        21px;

      font-weight:
        800;

    }


    .tool-top p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        11px;

    }


    .status {

      flex-shrink:
        0;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        8px 12px;

      border:
        1px solid rgba(42,213,161,.20);

      border-radius:
        999px;

      color:
        var(--success);

      background:
        rgba(42,213,161,.07);

      font-size:
        10px;

      font-weight:
        700;

    }


    .status span {

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        currentColor;

      box-shadow:
        0 0 10px currentColor;

    }


    .status.working {

      color:
        var(--blue);

      border-color:
        var(--line-strong);

      background:
        rgba(40,184,242,.07);

    }


    /* MODE */

    .type-area {

      padding:
        22px 28px;

      border-bottom:
        1px solid var(--line);

    }


    .type-title {

      margin-bottom:
        12px;

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        800;

    }


    .types {

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        10px;

    }


    .type {

      min-height:
        64px;

      padding:
        8px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      border:
        1px solid var(--line);

      border-radius:
        13px;

      background:
        var(--surface-2);

      color:
        var(--muted);

      font-family:
        inherit;

      font-size:
        11px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        .2s ease;

    }


    .type i {

      color:
        var(--blue);

      font-size:
        15px;

    }


    .type:hover {

      border-color:
        var(--line-strong);

      transform:
        translateY(-1px);

    }


    .type.active {

      color:
        var(--text);

      background:
        linear-gradient(
          135deg,
          rgba(40,184,242,.15),
          rgba(40,184,242,.05)
        );

      border-color:
        rgba(40,184,242,.45);

    }


    /* WORK */

    .work {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

    }


    .editor,
    .preview {

      padding:
        28px;

    }


    .editor {

      border-left:
        1px solid var(--line);

    }


    .preview {

      background:
        var(--surface-2);

    }


    .block-head {

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

      margin-bottom:
        24px;

    }


    .block-icon {

      width:
        43px;

      height:
        43px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid var(--line);

      border-radius:
        12px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

    }


    .block-head h3 {

      margin:
        0 0 3px;

      font-size:
        15px;

      font-weight:
        800;

    }


    .block-head p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.8;

    }


    .fields {

      display:
        flex;

      flex-direction:
        column;

      gap:
        9px;

    }


    .fields label {

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        700;

    }


    .fields label b {

      color:
        var(--danger);

    }


    input,
    textarea,
    select {

      width:
        100%;

      border:
        1px solid var(--line);

      border-radius:
        11px;

      background:
        var(--field);

      color:
        var(--text);

      font-family:
        "Cairo",
        sans-serif;

      outline:
        none;

      transition:
        .2s ease;

    }


    input,
    select {

      height:
        46px;

      padding:
        0 13px;

      font-size:
        11px;

    }


    textarea {

      min-height:
        205px;

      padding:
        13px;

      resize:
        vertical;

      font-size:
        13px;

      line-height:
        2;

    }


    textarea.code-input {

      direction:
        ltr;

      text-align:
        left;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        12px;

    }


    input:focus,
    textarea:focus,
    select:focus {

      border-color:
        var(--blue);

      box-shadow:
        0 0 0 3px rgba(40,184,242,.08);

    }


    input::placeholder,
    textarea::placeholder {

      color:
        var(--muted-2);

    }


    .field-meta {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      color:
        var(--muted-2);

      font-size:
        9px;

    }


    /* SETTINGS */

    .settings {

      margin-top:
        24px;

      padding-top:
        22px;

      border-top:
        1px solid var(--line);

    }


    .settings-head {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      margin-bottom:
        13px;

      font-size:
        11px;

      font-weight:
        800;

    }


    .settings-head i {
      color:
        var(--blue);
    }


    .settings-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        9px;

    }


    .settings-grid label {

      display:
        block;

      margin-bottom:
        7px;

      color:
        var(--muted);

      font-size:
        9px;

    }


    .settings-grid select {

      height:
        43px;

    }


    /* ACTIONS */

    .main-actions {

      display:
        grid;

      grid-template-columns:
        1fr 1.6fr;

      gap:
        10px;

      margin-top:
        24px;

    }


    .main-actions button {

      min-height:
        48px;

      border-radius:
        11px;

      font-family:
        inherit;

      font-size:
        11px;

      font-weight:
        800;

      cursor:
        pointer;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      transition:
        .2s ease;

    }


    .reset-btn {

      color:
        var(--text);

      background:
        var(--surface-3);

      border:
        1px solid var(--line);

    }


    .generate-btn {

      color:
        #fff;

      background:
        linear-gradient(
          135deg,
          var(--blue),
          var(--blue-dark)
        );

      border:
        0;

    }


    .main-actions button:hover {

      transform:
        translateY(-1px);

    }


    .message {

      min-height:
        19px;

      margin-top:
        10px;

      text-align:
        center;

      font-size:
        10px;

    }


    .message.success {
      color:
        var(--success);
    }


    .message.error {
      color:
        var(--danger);
    }


    /* RESULT */

    .result-container {

      min-height:
        300px;

      padding:
        18px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px dashed var(--line-strong);

      border-radius:
        18px;

      background:
        var(--page-bg);

      overflow:
        hidden;

    }


    .result-empty {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      gap:
        8px;

      text-align:
        center;

    }


    .empty-icon {

      width:
        70px;

      height:
        70px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid var(--line);

      border-radius:
        18px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

      font-size:
        27px;

      margin-bottom:
        5px;

    }


    .result-empty strong {

      color:
        var(--text);

      font-size:
        12px;

    }


    .result-empty span {

      color:
        var(--muted);

      font-size:
        9px;

    }


    .result {

      display:
        none;

      width:
        100%;

      max-height:
        265px;

      margin:
        0;

      padding:
        14px;

      overflow:
        auto;

      white-space:
        pre-wrap;

      word-break:
        break-word;

      direction:
        ltr;

      text-align:
        left;

      color:
        var(--text);

      background:
        var(--field);

      border:
        1px solid var(--line);

      border-radius:
        12px;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        12px;

      line-height:
        1.8;

    }


    .result.visible {
      display:
        block;
    }


    .result-meta {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        12px;

      color:
        var(--muted);

      font-size:
        9px;

    }


    .result-meta i {
      color:
        var(--success);

      margin-left:
        4px;

    }


    .export-title {

      margin:
        22px 0 10px;

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        800;

    }


    .export-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        9px;

    }


    .export {

      min-height:
        60px;

      padding:
        8px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      border:
        1px solid var(--line);

      border-radius:
        12px;

      background:
        var(--surface);

      color:
        var(--text);

      font-family:
        inherit;

      cursor:
        pointer;

      transition:
        .2s ease;

    }


    .export i {
      color:
        var(--blue);

      font-size:
        15px;

    }


    .export span {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-start;

    }


    .export strong {
      font-size:
        10px;
    }


    .export small {

      color:
        var(--muted);

      font-size:
        8px;

    }


    .export:hover:not(:disabled) {

      border-color:
        var(--line-strong);

      transform:
        translateY(-1px);

    }


    .export:disabled {

      opacity:
        .35;

      cursor:
        not-allowed;

    }


    /* DETAILS */

    .details-title {

      margin:
        22px 0 10px;

      color:
        var(--text-soft);

      font-size:
        11px;

      font-weight:
        800;

    }


    .character-details {

      max-height:
        190px;

      overflow:
        auto;

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        7px;

    }


    .details-empty {

      grid-column:
        1 / -1;

      padding:
        20px;

      text-align:
        center;

      color:
        var(--muted);

      font-size:
        9px;

      border:
        1px solid var(--line);

      border-radius:
        11px;

    }


    .character {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      min-width:
        0;

      padding:
        8px;

      border:
        1px solid var(--line);

      border-radius:
        10px;

      background:
        var(--surface);

    }


    .character-symbol {

      width:
        32px;

      height:
        32px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        8px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

      font-size:
        15px;

    }


    .character-info {

      min-width:
        0;

      display:
        flex;

      flex-direction:
        column;

      direction:
        ltr;

      text-align:
        left;

    }


    .character-info strong {

      font-family:
        "JetBrains Mono",
        monospace;

      font-size:
        9px;

      color:
        var(--text);

    }


    .character-info span {

      color:
        var(--muted);

      font-size:
        8px;

    }


    .details-more {

      grid-column:
        1 / -1;

      padding:
        9px;

      text-align:
        center;

      color:
        var(--muted);

      font-size:
        8px;

    }


    /* FEATURES */

    .features {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        12px;

      margin-top:
        16px;

    }


    .feature {

      padding:
        17px;

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        15px;

      box-shadow:
        var(--shadow);

    }


    .feature > div {

      width:
        42px;

      height:
        42px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        rgba(40,184,242,.08);

      color:
        var(--blue);

    }


    .feature strong,
    .feature span {

      display:
        block;

    }


    .feature strong {
      font-size:
        11px;
    }


    .feature span {

      margin-top:
        3px;

      color:
        var(--muted);

      font-size:
        8px;

    }


    /* INFO */

    .info {

      margin-top:
        16px;

      padding:
        21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        14px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        17px;

      box-shadow:
        var(--shadow);

    }


    .info-icon,
    .tip-icon {

      width:
        44px;

      height:
        44px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        12px;

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      color:
        var(--blue);

    }


    .info h2 {

      margin:
        0 0 7px;

      font-size:
        14px;

    }


    .info p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        2;

    }


    .info-body {
      width:
        100%;
    }


    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        14px;

      margin-top:
        17px;

    }


    .step {

      display:
        flex;

      gap:
        10px;

    }


    .step > span {

      width:
        29px;

      height:
        29px;

      flex-shrink:
        0;

      display:
        grid;

      place-items:
        center;

      border-radius:
        8px;

      color:
        var(--blue);

      background:
        rgba(40,184,242,.08);

      border:
        1px solid var(--line);

      font-size:
        10px;

      font-weight:
        800;

    }


    .step strong {
      font-size:
        10px;
    }


    .step p {

      margin-top:
        3px;

      font-size:
        8px;

    }


    /* TIP */

    .tip {

      margin-top:
        16px;

      padding:
        18px 21px;

      display:
        flex;

      align-items:
        flex-start;

      gap:
        13px;

      border:
        1px solid var(--line);

      border-radius:
        17px;

      background:
        linear-gradient(
          135deg,
          rgba(40,184,242,.07),
          var(--surface)
        );

    }


    .tip strong {

      display:
        block;

      margin:
        1px 0 4px;

      font-size:
        12px;

    }


    .tip p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        9px;

      line-height:
        1.9;

    }


    /* FAQ */

    .faq {

      margin-top:
        48px;

    }


    .faq-title {

      text-align:
        center;

      margin-bottom:
        18px;

    }


    .faq-title span {

      color:
        var(--blue);

      font-size:
        10px;

      font-weight:
        800;

    }


    .faq-title h2 {

      margin:
        5px 0 0;

      font-size:
        22px;

      font-weight:
        800;

    }


    details {

      margin-bottom:
        9px;

      background:
        var(--surface);

      border:
        1px solid var(--line);

      border-radius:
        13px;

      overflow:
        hidden;

    }


    summary {

      min-height:
        54px;

      padding:
        12px 16px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      list-style:
        none;

      cursor:
        pointer;

      color:
        var(--text);

      font-size:
        10px;

      font-weight:
        700;

    }


    summary::-webkit-details-marker {
