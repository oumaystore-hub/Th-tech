  <script is:inline>
    (() => {

      function init() {

        const input =
          document.getElementById('mainInput');

        const result =
          document.getElementById('result');

        const resultEmpty =
          document.getElementById('resultEmpty');

        const textMode =
          document.getElementById('textMode');

        const unicodeMode =
          document.getElementById('unicodeMode');

        const convertBtn =
          document.getElementById('convertBtn');

        const resetBtn =
          document.getElementById('resetBtn');

        const copyBtn =
          document.getElementById('copyBtn');

        const copyCodesBtn =
          document.getElementById('copyCodesBtn');

        const clearBtn =
          document.getElementById('clearBtn');

        const formatSelect =
          document.getElementById('formatSelect');

        const separatorSelect =
          document.getElementById('separatorSelect');

        const caseSelect =
          document.getElementById('caseSelect');

        const inputTitle =
          document.getElementById('inputTitle');

        const inputHint =
          document.getElementById('inputHint');

        const charCount =
          document.getElementById('charCount');

        const status =
          document.getElementById('status');

        const message =
          document.getElementById('message');

        const previewState =
          document.getElementById('previewState');

        const resultInfo =
          document.getElementById('resultInfo');

        const characterDetails =
          document.getElementById('characterDetails');


        let mode = 'text';

        let lastResult = '';

        let lastCodes = [];


        /* =====================================================
           STATUS
           ===================================================== */

        function setStatus(
          text,
          working = false
        ) {

          status.innerHTML =
            '<span></span>' + text;

          status.classList.toggle(
            'working',
            working
          );

        }


        function setMessage(
          text,
          type = ''
        ) {

          message.textContent =
            text;

          message.className =
            'message';

          if (type) {
            message.classList.add(type);
          }

        }


        /* =====================================================
           COUNTER
           ===================================================== */

        function updateCounter() {

          const length =
            input.value.length;

          charCount.textContent =
            `${length} حرف`;

        }


        /* =====================================================
           MODE
           ===================================================== */

        function updateMode() {

          const text =
            mode === 'text';


          textMode.classList.toggle(
            'active',
            text
          );

          unicodeMode.classList.toggle(
            'active',
            !text
          );


          if (text) {

            inputTitle.textContent =
              'النص';

            inputHint.textContent =
              'اكتب النص الذي تريد تحويله إلى Unicode';

            input.placeholder =
              'مثال: مرحبًا بالعالم';

            input.classList.remove(
              'code-input'
            );

            convertBtn.innerHTML =
              '<i class="fa-solid fa-bolt"></i> تحويل Unicode';

          } else {

            inputTitle.textContent =
              'رموز Unicode';

            inputHint.textContent =
              'أدخل رموز Unicode مثل U+0041 أو \\u0041 أو &#65;';

            input.placeholder =
              'مثال: U+0048 U+0065 U+006C U+006C U+006F';

            input.classList.add(
              'code-input'
            );

            convertBtn.innerHTML =
              '<i class="fa-solid fa-bolt"></i> تحويل إلى نص';

          }


          updateCounter();

        }


        textMode.addEventListener(
          'click',
          () => {

            if (mode === 'text') {
              return;
            }

            mode = 'text';

            input.value = '';

            clearResult();

            setMessage('');

            updateMode();

            input.focus();

          }
        );


        unicodeMode.addEventListener(
          'click',
          () => {

            if (mode === 'unicode') {
              return;
            }

            mode = 'unicode';

            input.value = '';

            clearResult();

            setMessage('');

            updateMode();

            input.focus();

          }
        );


        /* =====================================================
           UNICODE CODE POINTS
           ===================================================== */

        function getCodePoints(text) {

          const codes = [];

          for (const char of text) {

            codes.push(
              char.codePointAt(0)
            );

          }

          return codes;

        }


        function hexValue(
          number
        ) {

          let value =
            number.toString(16);

          if (
            caseSelect.value === 'upper'
          ) {

            value =
              value.toUpperCase();

          }

          return value;

        }


        /* =====================================================
           SEPARATOR
           ===================================================== */

        function getSeparator() {

          if (
            separatorSelect.value ===
            'comma'
          ) {

            return ', ';

          }

          if (
            separatorSelect.value ===
            'newline'
          ) {

            return '\n';

          }

          return ' ';

        }


        /* =====================================================
           TEXT → UNICODE
           ===================================================== */

        function textToUnicode(
          text
        ) {

          const codes =
            getCodePoints(text);

          const format =
            formatSelect.value;

          const separator =
            getSeparator();

          const output =
            codes.map(
              code => {

                const hex =
                  hexValue(code);


                if (
                  format ===
                  'uplus'
                ) {

                  return (
                    'U+' +
                    hex.padStart(
                      4,
                      '0'
                    )
                  );

                }


                if (
                  format ===
                  'javascript'
                ) {

                  if (code <= 0xFFFF) {

                    return (
                      '\\u' +
                      hex.padStart(
                        4,
                        '0'
                      )
                    );

                  }

                  return (
                    '\\u{' +
                    hex +
                    '}'
                  );

                }


                if (
                  format ===
                  'html-decimal'
                ) {

                  return (
                    '&#' +
                    code +
                    ';'
                  );

                }


                if (
                  format ===
                  'html-hex'
                ) {

                  return (
                    '&#x' +
                    hex +
                    ';'
                  );

                }


                return '';

              }
            );


          return {
            text:
              output.join(
                separator
              ),

            codes

          };

        }


        /* =====================================================
           PARSE UNICODE
           ===================================================== */

        function parseUnicode(
          value
        ) {

          let text =
            value.trim();


          if (!text) {
            return [];
          }


          /*
           * U+0041
           */

          text =
            text.replace(
              /U\+([0-9a-fA-F]{1,6})/g,
              ' $1 '
            );


          /*
           * \u0041
           */

          text =
            text.replace(
              /\\u([0-9a-fA-F]{4})/gi,
              ' $1 '
            );


          /*
           * \u{1F600}
           */

          text =
            text.replace(
              /\\u\{([0-9a-fA-F]{1,6})\}/gi,
              ' $1 '
            );


          /*
           * HTML decimal
           * &#65;
           */

          text =
            text.replace(
              /&#(\d+);?/g,
              ' DEC:$1 '
            );


          /*
           * HTML hexadecimal
           * &#x41;
           */

          text =
            text.replace(
              /&#x([0-9a-fA-F]+);?/gi,
              ' HEX:$1 '
            );


          const tokens =
            text
              .replace(
                /[,;]+/g,
                ' '
              )
              .split(
                /\s+/
              )
              .filter(Boolean);


          const codes = [];


          for (
            let i = 0;
            i < tokens.length;
            i++
          ) {

            let token =
              tokens[i];


            let number;


            if (
              token.startsWith(
                'DEC:'
              )
            ) {

              number =
                Number(
                  token.slice(4)
                );

            } else if (
              token.startsWith(
                'HEX:'
              )
            ) {

              number =
                parseInt(
                  token.slice(4),
                  16
                );

            } else if (
              /^[0-9a-fA-F]+$/.test(
                token
              )
            ) {

              /*
               * Raw hexadecimal.
               */

              number =
                parseInt(
                  token,
                  16
                );

            } else {

              throw new Error(
                `القيمة "${token}" غير صالحة.`
              );

            }


            if (
              !Number.isInteger(
                number
              ) ||
              number < 0 ||
              number > 0x10FFFF
            ) {

              throw new Error(
                `قيمة Unicode خارج النطاق: ${token}`
              );

            }


            /*
             * Surrogate range is invalid
             * as an individual Unicode code point.
             */

            if (
              number >= 0xD800 &&
              number <= 0xDFFF
            ) {

              throw new Error(
                `قيمة Unicode غير صالحة: ${token}`
              );

            }


            codes.push(
              number
            );

          }


          return codes;

        }


        /* =====================================================
           UNICODE → TEXT
           ===================================================== */

        function unicodeToText(
          value
        ) {

          const codes =
            parseUnicode(
              value
            );


          let output =
            '';


          for (
            let i = 0;
            i < codes.length;
            i++
          ) {

            output +=
              String.fromCodePoint(
                codes[i]
              );

          }


          return {
            text:
              output,

            codes

          };

        }


        /* =====================================================
           CHARACTER DETAILS
           ===================================================== */

        function renderDetails(
          codes
        ) {

          if (!codes.length) {

            characterDetails.innerHTML =
              '<div class="details-empty">ستظهر تفاصيل الأحرف هنا</div>';

            return;

          }


          const fragment =
            document.createDocumentFragment();


          const limit =
            Math.min(
              codes.length,
              100
            );


          for (
            let i = 0;
            i < limit;
            i++
          ) {

            const code =
              codes[i];

            const item =
              document.createElement(
                'div'
              );

            item.className =
              'character';


            const char =
              String.fromCodePoint(
                code
              );


            const display =
              code === 32
                ? '␠'
                : char;


            item.innerHTML = `
              <div class="character-symbol">${escapeHTML(display)}</div>
              <div class="character-info">
                <strong>U+${hexValue(code).padStart(4, '0')}</strong>
                <span>Decimal: ${code}</span>
              </div>
            `;


            fragment.appendChild(
              item
            );

          }


          characterDetails.innerHTML =
            '';

          characterDetails.appendChild(
            fragment
          );


          if (
            codes.length > 100
          ) {

            const more =
              document.createElement(
                'div'
              );

            more.className =
              'details-more';

            more.textContent =
              `تم عرض أول 100 حرف من أصل ${codes.length} حرف.`;

            characterDetails.appendChild(
              more
            );

          }

        }


        function escapeHTML(
          value
        ) {

          return value
            .replace(
              /&/g,
              '&amp;'
            )
            .replace(
              /</g,
              '&lt;'
            )
            .replace(
              />/g,
              '&gt;'
            )
            .replace(
              /"/g,
              '&quot;'
            )
            .replace(
              /'/g,
              '&#039;'
            );

        }


        /* =====================================================
           DISPLAY RESULT
           ===================================================== */

        function displayResult(
          value,
          codes
        ) {

          lastResult =
            value;

          lastCodes =
            codes.slice();


          result.textContent =
            value;

          resultEmpty.style.display =
            'none';

          result.classList.add(
            'visible'
          );


          copyBtn.disabled =
            !value;

          copyCodesBtn.disabled =
            !codes.length;


          previewState.textContent =
            'تم إنشاء النتيجة';

          resultInfo.textContent =
            `${codes.length} قيمة Unicode`;


          renderDetails(
            codes
          );

        }


        /* =====================================================
           CLEAR
           ===================================================== */

        function clearResult() {

          lastResult =
            '';

          lastCodes =
            [];


          result.textContent =
            '';

          result.classList.remove(
            'visible'
          );


          resultEmpty.style.display =
            'flex';


          copyBtn.disabled =
            true;

          copyCodesBtn.disabled =
            true;


          previewState.textContent =
            'في انتظار البيانات';

          resultInfo.textContent =
            'Unicode';


          renderDetails(
            []
          );

        }


        clearBtn.addEventListener(
          'click',
          () => {

            input.value =
              '';

            clearResult();

            updateCounter();

            setMessage('');

            setStatus(
              'جاهز',
              false
            );

            input.focus();

          }
        );


        /* =====================================================
           CONVERT
           ===================================================== */

        function convert() {

          const value =
            input.value.trim();


          if (!value) {

            clearResult();

            setStatus(
              'جاهز',
              false
            );

            setMessage(
              'يرجى إدخال البيانات أولًا.',
              'error'
            );

            return;

          }


          setStatus(
            'جارٍ التحويل...',
            true
          );


          try {

            let converted;


            if (
              mode === 'text'
            ) {

              converted =
                textToUnicode(
                  input.value
                );

            } else {

              converted =
                unicodeToText(
                  input.value
                );

            }


            if (
              !converted.codes.length
            ) {

              throw new Error(
                'لم يتم العثور على رموز Unicode صالحة.'
              );

            }


            displayResult(
              converted.text,
              converted.codes
            );


            setStatus(
              'جاهز',
              false
            );


            setMessage(
              'تم التحويل بنجاح.',
              'success'
            );


          } catch (error) {

            clearResult();

            setStatus(
              'خطأ',
              false
            );


            setMessage(
              error.message ||
              'حدث خطأ أثناء التحويل.',
              'error'
            );

          }

        }


        convertBtn.addEventListener(
          'click',
          convert
        );


        /* =====================================================
           KEYBOARD
           ===================================================== */

        input.addEventListener(
          'keydown',
          event => {

            if (
              (event.ctrlKey ||
               event.metaKey) &&
              event.key === 'Enter'
            ) {

              event.preventDefault();

              convert();

            }

          }
        );


        input.addEventListener(
          'input',
          updateCounter
        );


        /* =====================================================
           OPTIONS
           ===================================================== */

        formatSelect.addEventListener(
          'change',
          () => {

            if (
              mode === 'text' &&
              input.value
            ) {

              convert();

            }

          }
        );


        separatorSelect.addEventListener(
          'change',
          () => {

            if (
              mode === 'text' &&
              input.value
            ) {

              convert();

            }

          }
        );


        caseSelect.addEventListener(
          'change',
          () => {

            if (
              input.value
            ) {

              convert();

            }

          }
        );


        /* =====================================================
           COPY RESULT
           ===================================================== */

        copyBtn.addEventListener(
          'click',
          async () => {

            if (!lastResult) {
              return;
            }


            try {

              await navigator.clipboard.writeText(
                lastResult
              );


              setMessage(
                'تم نسخ النتيجة.',
                'success'
              );


            } catch (error) {

              fallbackCopy(
                lastResult
              );

            }

          }
        );


        /* =====================================================
           COPY CODES
           ===================================================== */

        copyCodesBtn.addEventListener(
          'click',
          async () => {

            if (!lastCodes.length) {
              return;
            }


            const codes =
              lastCodes
                .map(
                  code =>
                    'U+' +
                    code
                      .toString(16)
                      .toUpperCase()
                      .padStart(
                        4,
                        '0'
                      )
                )
                .join(' ');


            try {

              await navigator.clipboard.writeText(
                codes
              );


              setMessage(
                'تم نسخ أكواد Unicode.',
                'success'
              );


            } catch (error) {

              fallbackCopy(
                codes
              );

            }

          }
        );


        /* =====================================================
           FALLBACK COPY
           ===================================================== */

        function fallbackCopy(
          value
        ) {

          const area =
            document.createElement(
              'textarea'
            );


          area.value =
            value;


          area.style.position =
            'fixed';

          area.style.left =
            '-9999px';

          area.style.top =
            '0';


          document.body.appendChild(
            area
          );


          area.focus();

          area.select();


          try {

            document.execCommand(
              'copy'
            );


            setMessage(
              'تم النسخ بنجاح.',
              'success'
            );

          } catch (error) {

            setMessage(
              'تعذر النسخ تلقائيًا.',
              'error'
            );

          }


          area.remove();

        }


        /* =====================================================
           RESET
           ===================================================== */

        resetBtn.addEventListener(
          'click',
          () => {

            input.value =
              '';

            mode =
              'text';


            formatSelect.value =
              'uplus';

            separatorSelect.value =
              'space';

            caseSelect.value =
              'upper';


            clearResult();

            updateMode();

            updateCounter();


            setMessage(
              'تمت إعادة ضبط الأداة.',
              'success'
            );


            setStatus(
              'جاهز',
              false
            );


            input.focus();

          }
        );


        /* =====================================================
           THEME
           ===================================================== */

        function getThemeState() {

          const html =
            document.documentElement;

          const stored =
            localStorage.getItem(
              'theme'
            );


          if (
            stored === 'light'
          ) {

            return 'light';

          }


          if (
            stored === 'dark'
          ) {

            return 'dark';

          }


          if (
            html.dataset.theme ===
            'light'
          ) {

            return 'light';

          }


          if (
            html.dataset.theme ===
            'dark'
          ) {

            return 'dark';

          }


          if (
            html.classList.contains(
              'light'
            )
          ) {

            return 'light';

          }


          if (
            html.classList.contains(
              'dark'
            )
          ) {

            return 'dark';

          }


          return 'dark';

        }


        function syncTheme() {

          const theme =
            getThemeState();

          const light =
            theme === 'light';


          document.body.classList.toggle(
            'unicode-light',
            light
          );


          document.body.classList.toggle(
            'unicode-dark',
            !light
          );

        }


        syncTheme();


        window.addEventListener(
          'storage',
          event => {

            if (
              event.key ===
              'theme'
            ) {

              syncTheme();

            }

          }
        );


        const themeObserver =
          new MutationObserver(
            () => {

              syncTheme();

            }
          );


        themeObserver.observe(
          document.documentElement,
          {
            attributes: true,
            attributeFilter: [
              'class',
              'data-theme'
            ]
          }
        );


        /* =====================================================
           INITIAL
           ===================================================== */

        updateMode();

        updateCounter();

        clearResult();

        setStatus(
          'جاهز',
          false
        );

      }


      if (
        document.readyState ===
        'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          init,
          {
            once: true
          }
        );

      } else {

        init();

      }

    })();
  </script>


