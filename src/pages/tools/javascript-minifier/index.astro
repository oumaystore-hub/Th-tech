---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Minifier - تصغير JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "أداة JavaScript Minifier مجانية لتصغير وضغط كود JavaScript وإزالة التعليقات والمسافات غير الضرورية وتقليل حجم الملفات مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JavaScript Minifier؟",
    a: "أداة تقوم بتصغير كود JavaScript عن طريق إزالة التعليقات والمسافات والأسطر غير الضرورية مع الحفاظ على الكود قابلاً للتنفيذ."
  },
  {
    q: "هل يتم رفع الكود إلى الخادم؟",
    a: "لا. تتم عملية التصغير مباشرة داخل المتصفح، لذلك لا يحتاج الكود إلى مغادرة جهازك."
  },
  {
    q: "هل يمكنني معرفة مقدار التوفير في الحجم؟",
    a: "نعم، تعرض الأداة حجم الكود قبل التصغير وبعده ونسبة تقليل الحجم."
  },
  {
    q: "هل يمكن تنزيل الكود المصغر؟",
    a: "نعم، يمكنك تنزيل النتيجة مباشرة كملف JavaScript بصيغة JS."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>

    <Header />

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <a href={`${base}/tools/`}>الأدوات</a>
            <span>/</span>
            <span>JavaScript Minifier</span>
          </div>

          <div class="tool-icon">
            <i class="fa-brands fa-js"></i>
          </div>

          <div class="eyebrow">
            <i class="fa-solid fa-compress"></i>
            JavaScript
          </div>

          <h1>
            JavaScript <span>Minifier</span>
          </h1>

          <p>
            صغّر كود JavaScript واحذف العناصر غير الضرورية لتقليل حجم الملف
            وتحسين سرعة تحميله.
          </p>

        </div>
      </section>


      <!-- MINIFIER -->
      <section class="minifier-section">
        <div class="container">

          <div class="minifier-card">

            <!-- HEADER -->
            <div class="topbar">

              <div class="tool-name">

                <div class="mini-icon">
                  <i class="fa-brands fa-js"></i>
                </div>

                <div>
                  <strong>JavaScript Minifier</strong>
                  <small>تصغير وضغط كود JavaScript</small>
                </div>

              </div>

              <div class="local-badge">
                <span></span>
                يعمل محلياً
              </div>

            </div>


            <!-- ACTIONS -->
            <div class="actions">

              <button id="minifyBtn" class="btn btn-primary">
                <i class="fa-solid fa-compress"></i>
                تصغير
              </button>

              <button id="copyBtn" class="btn">
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

              <button id="downloadBtn" class="btn">
                <i class="fa-solid fa-download"></i>
                تنزيل
              </button>

              <button id="clearBtn" class="btn btn-clear">
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

            </div>


            <!-- WORKSPACE -->
            <div class="workspace">

              <!-- ORIGINAL -->
              <div class="editor-box">

                <div class="editor-header">

                  <div class="editor-title">
                    <span class="indicator input-indicator"></span>
                    <strong>الكود الأصلي</strong>
                  </div>

                  <div class="editor-info">
                    <span id="inputLines">0 سطر</span>
                    <span>•</span>
                    <span id="inputBytes">0 B</span>
                  </div>

                </div>

                <div class="editor-body">

                  <div
                    class="line-numbers"
                    id="inputNumbers"
                  >1</div>

                  <textarea
                    id="inputCode"
                    spellcheck="false"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder={`// JavaScript example

function greet(name) {
  const message = "Hello " + name;
  console.log(message);
}

greet("Ahmed");`}
                  ></textarea>

                </div>

              </div>


              <!-- MINIFIED -->
              <div class="editor-box output-box">

                <div class="editor-header">

                  <div class="editor-title">
                    <span class="indicator output-indicator"></span>
                    <strong>الكود المصغر</strong>
                  </div>

                  <div class="editor-info">
                    <span id="outputLines">0 سطر</span>
                    <span>•</span>
                    <span id="outputBytes">0 B</span>
                  </div>

                </div>

                <div class="editor-body">

                  <div
                    class="line-numbers output-numbers"
                    id="outputNumbers"
                  >1</div>

                  <textarea
                    id="outputCode"
                    spellcheck="false"
                    readonly
                    placeholder="سيظهر الكود المصغر هنا..."
                  ></textarea>

                </div>

              </div>

            </div>


            <!-- STATUS -->
            <div id="status" class="status hidden">
              <i></i>
              <span></span>
            </div>


            <!-- SAVING -->
            <div class="saving-box">

              <div class="saving-icon">
                <i class="fa-solid fa-chart-line"></i>
              </div>

              <div class="saving-content">

                <div class="saving-title">
                  <strong>حجم الملف</strong>
                  <span id="savingPercent">—</span>
                </div>

                <div class="progress">
                  <span id="progressBar"></span>
                </div>

                <div class="saving-stats">

                  <span>
                    الأصلي:
                    <strong id="originalSize">0 B</strong>
                  </span>

                  <span>
                    المصغر:
                    <strong id="minifiedSize">0 B</strong>
                  </span>

                  <span>
                    التوفير:
                    <strong id="savedSize">0 B</strong>
                  </span>

                </div>

              </div>

            </div>


            <!-- BOTTOM -->
            <div class="bottom-bar">

              <div class="privacy">
                <i class="fa-solid fa-shield-halved"></i>
                تتم معالجة الكود داخل المتصفح
              </div>

              <div class="characters">

                <span>
                  <strong id="charCount">0</strong>
                  حرف
                </span>

                <span>
                  <strong id="outputCharCount">0</strong>
                  بعد التصغير
                </span>

              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FEATURES -->
      <section class="features-section">
        <div class="container">

          <div class="section-title">
            <span>المميزات</span>

            <h2>
              JavaScript Minifier سريع وعملي
            </h2>

            <p>
              قلّل حجم كود JavaScript بسهولة مباشرة من المتصفح.
            </p>
          </div>


          <div class="features-grid">

            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-compress"></i>
              </div>

              <div>
                <h3>تصغير الكود</h3>
                <p>
                  إزالة المسافات والتعليقات غير الضرورية.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-gauge-high"></i>
              </div>

              <div>
                <h3>حجم أقل</h3>
                <p>
                  تقليل حجم كود JavaScript قبل استخدامه.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <div>
                <h3>خصوصية</h3>
                <p>
                  تتم المعالجة محلياً داخل المتصفح.
                </p>
              </div>

            </div>


            <div class="feature">

              <div class="feature-icon">
                <i class="fa-solid fa-download"></i>
              </div>

              <div>
                <h3>تنزيل مباشر</h3>
                <p>
                  احفظ الكود المصغر كملف JavaScript.
                </p>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-title">

            <span>طريقة الاستخدام</span>

            <h2>
              كيف تستخدم JavaScript Minifier؟
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <b>01</b>

              <div>
                <h3>أدخل الكود</h3>

                <p>
                  الصق كود JavaScript في المحرر الأول.
                </p>
              </div>

            </div>


            <div class="step">

              <b>02</b>

              <div>
                <h3>اضغط تصغير</h3>

                <p>
                  اضغط على زر تصغير لمعالجة الكود.
                </p>
              </div>

            </div>


            <div class="step">

              <b>03</b>

              <div>
                <h3>راجع الحجم</h3>

                <p>
                  شاهد الحجم قبل التصغير وبعده ونسبة التوفير.
                </p>
              </div>

            </div>


            <div class="step">

              <b>04</b>

              <div>
                <h3>انسخ أو نزّل</h3>

                <p>
                  انسخ الكود المصغر أو احفظه كملف JS.
                </p>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-title">

            <span>FAQ</span>

            <h2>
              الأسئلة الشائعة
            </h2>

          </div>


          <div class="faq-list">

            {
              faqs.map((faq) => (
                <details class="faq-item">

                  <summary>
                    <span>{faq.q}</span>

                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <p>
                    {faq.a}
                  </p>

                </details>
              ))
            }

          </div>

        </div>
      </section>

    

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-playground/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Playground</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-validator/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Validator</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/json-minifier/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Json Minifier</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/csv-to-json/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Csv To Json</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/json-diff/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Json Diff</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />


    <style>

      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }


      :global(:root) {
        --bg: #f8fafc;
        --section: #f1f5f9;
        --card: #ffffff;
        --editor: #f8fafc;

        --text: #0f172a;
        --muted: #64748b;

        --border: rgba(15, 23, 42, .09);

        --primary: #2563eb;
        --primary-hover: #1d4ed8;

        --cyan: #0891b2;
        --green: #16a34a;
        --red: #dc2626;

        --shadow:
          0 18px 55px rgba(15, 23, 42, .08);
      }


      :global(html.dark-mode) {

        --bg: #07101f;
        --section: #0b1426;
        --card: #111d32;
        --editor: #0d1729;

        --text: #f8fafc;
        --muted: #94a3b8;

        --border:
          rgba(148, 163, 184, .12);

        --primary: #3b82f6;
        --primary-hover: #2563eb;

        --cyan: #06b6d4;
        --green: #22c55e;
        --red: #ef4444;

        --shadow:
          0 20px 65px rgba(0, 0, 0, .3);
      }


      .container {
        width: min(
          1120px,
          calc(100% - 28px)
        );

        margin-inline: auto;
      }


      /* HERO */

      .hero {
        padding: 38px 0 30px;
        text-align: center;
      }

      .breadcrumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;

        gap: 8px;

        margin-bottom: 22px;

        color: var(--muted);
        font-size: 11px;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
      }


      .tool-icon {
        width: 58px;
        height: 58px;

        margin: 0 auto 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 16px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);

        font-size: 28px;
      }


      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        color: var(--cyan);

        font-size: 11px;
        font-weight: 700;
      }


      .hero h1 {
        margin: 5px 0 7px;

        font-size:
          clamp(30px, 5vw, 46px);

        line-height: 1.25;

        font-weight: 800;

        letter-spacing: -.8px;
      }

      .hero h1 span {
        color: var(--primary);
      }


      .hero p {
        max-width: 680px;

        margin: auto;

        color: var(--muted);

        font-size: 13px;
        line-height: 1.9;
      }


      /* TOOL */

      .minifier-section {
        padding: 5px 0 65px;
      }


      .minifier-card {

        overflow: hidden;

        background: var(--card);

        border:
          1px solid var(--border);

        border-radius: 20px;

        box-shadow: var(--shadow);
      }


      /* TOPBAR */

      .topbar {

        min-height: 65px;

        padding: 12px 17px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        border-bottom:
          1px solid var(--border);
      }


      .tool-name {

        display: flex;
        align-items: center;

        gap: 10px;
      }


      .mini-icon {

        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background:
          rgba(37, 99, 235, .09);

        color: var(--primary);

        font-size: 19px;
      }


      .tool-name strong {
        display: block;
        font-size: 13px;
      }

      .tool-name small {
        display: block;

        margin-top: 1px;

        color: var(--muted);

        font-size: 9px;
      }


      .local-badge {

        display: flex;
        align-items: center;

        gap: 6px;

        color: var(--green);

        font-size: 10px;
        font-weight: 700;
      }


      .local-badge span {

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--green);

        box-shadow:
          0 0 0 4px
          rgba(22, 163, 74, .1);
      }


      /* ACTIONS */

      .actions {

        padding: 10px 13px;

        display: flex;
        align-items: center;

        gap: 7px;

        border-bottom:
          1px solid var(--border);

        background: var(--section);
      }


      .btn {

        height: 36px;

        padding: 0 13px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        border:
          1px solid var(--border);

        border-radius: 9px;

        background: var(--card);

        color: var(--text);

        font-family: inherit;

        font-size: 11px;
        font-weight: 700;

        cursor: pointer;

        transition: .2s ease;
      }


      .btn:hover {

        border-color: var(--primary);

        color: var(--primary);

        transform:
          translateY(-1px);
      }


      .btn-primary {

        padding-inline: 17px;

        background: var(--primary);

        border-color: var(--primary);

        color: white;

        box-shadow:
          0 5px 15px
          rgba(37, 99, 235, .18);
      }


      .btn-primary:hover {

        background:
          var(--primary-hover);

        color: white;
      }


      .btn-clear {
        color: var(--red);
      }


      /* WORKSPACE */

      .workspace {

        display: grid;

        grid-template-columns:
          1fr 1fr;

        gap: 1px;

        background:
          var(--border);
      }


      .editor-box {

        min-width: 0;

        background: var(--card);
      }


      .editor-header {

        height: 45px;

        padding: 0 14px;

