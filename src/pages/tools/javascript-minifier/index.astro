    <script is:inline>
      (() => {

        const input =
          document.getElementById("inputCode");

        const output =
          document.getElementById("outputCode");

        const minifyBtn =
          document.getElementById("minifyBtn");

        const copyBtn =
          document.getElementById("copyBtn");

        const downloadBtn =
          document.getElementById("downloadBtn");

        const clearBtn =
          document.getElementById("clearBtn");

        const status =
          document.getElementById("status");

        const inputLines =
          document.getElementById("inputLines");

        const outputLines =
          document.getElementById("outputLines");

        const inputBytes =
          document.getElementById("inputBytes");

        const outputBytes =
          document.getElementById("outputBytes");

        const charCount =
          document.getElementById("charCount");

        const outputCharCount =
          document.getElementById("outputCharCount");

        const inputNumbers =
          document.getElementById("inputNumbers");

        const outputNumbers =
          document.getElementById("outputNumbers");

        const originalSize =
          document.getElementById("originalSize");

        const minifiedSize =
          document.getElementById("minifiedSize");

        const savedSize =
          document.getElementById("savedSize");

        const savingPercent =
          document.getElementById("savingPercent");

        const progressBar =
          document.getElementById("progressBar");


        function getLines(text) {

          if (!text) return 0;

          return text
            .split(/\r\n|\r|\n/)
            .length;
        }


        function getBytes(text) {
          return new Blob([text]).size;
        }


        function formatBytes(bytes) {

          if (!bytes) return "0 B";

          const units = [
            "B",
            "KB",
            "MB",
            "GB"
          ];

          const index = Math.min(
            Math.floor(
              Math.log(bytes) /
              Math.log(1024)
            ),
            units.length - 1
          );

          const value =
            bytes /
            Math.pow(1024, index);

          return (
            value.toFixed(
              index === 0 ? 0 : 1
            ) +
            " " +
            units[index]
          );
        }


        function updateNumbers(
          element,
          count
        ) {

          const safeCount =
            Math.max(1, count);

          let html = "";

          for (
            let i = 1;
            i <= safeCount;
            i++
          ) {
            html += i + "<br>";
          }

          element.innerHTML = html;
        }


        function updateStats() {

          const original =
            input.value;

          const minified =
            output.value;

          const inLines =
            getLines(original);

          const outLines =
            getLines(minified);

          inputLines.textContent =
            `${inLines} ${inLines === 1 ? "سطر" : "أسطر"}`;

          outputLines.textContent =
            `${outLines} ${outLines === 1 ? "سطر" : "أسطر"}`;

          inputBytes.textContent =
            formatBytes(
              getBytes(original)
            );

          outputBytes.textContent =
            formatBytes(
              getBytes(minified)
            );

          charCount.textContent =
            original.length.toLocaleString();

          outputCharCount.textContent =
            minified.length.toLocaleString();

          originalSize.textContent =
            formatBytes(
              getBytes(original)
            );

          minifiedSize.textContent =
            formatBytes(
              getBytes(minified)
            );

          updateNumbers(
            inputNumbers,
            inLines
          );

          updateNumbers(
            outputNumbers,
            outLines
          );

          updateSaving();
        }


        function updateSaving() {

          const original =
            getBytes(input.value);

          const minified =
            getBytes(output.value);

          if (!original || !minified) {

            savedSize.textContent =
              "0 B";

            savingPercent.textContent =
              "—";

            progressBar.style.width =
              "0%";

            return;
          }


          const saved =
            Math.max(
              0,
              original - minified
            );

          const percentage =
            Math.max(
              0,
              Math.min(
                100,
                (saved / original) * 100
              )
            );


          savedSize.textContent =
            formatBytes(saved);

          savingPercent.textContent =
            `${percentage.toFixed(1)}%`;

          progressBar.style.width =
            `${percentage}%`;
        }


        function showStatus(
          message,
          error = false
        ) {

          status.classList.remove(
            "hidden",
            "error"
          );

          status.classList.toggle(
            "error",
            error
          );

          const icon =
            status.querySelector("i");

          const text =
            status.querySelector("span");

          icon.className = error
            ? "fa-solid fa-circle-exclamation"
            : "fa-solid fa-circle-check";

          text.textContent =
            message;

          clearTimeout(
            window.__thMinifierStatus
          );

          window.__thMinifierStatus =
            setTimeout(() => {

              status.classList.add(
                "hidden"
              );

            }, 3000);
        }


        function isIdentifierChar(char) {

          return !!char &&
            /[A-Za-z0-9_$]/.test(char);
        }


        function shouldKeepSpace(
          previous,
          current
        ) {

          if (!previous || !current) {
            return false;
          }

          if (
            isIdentifierChar(previous) &&
            isIdentifierChar(current)
          ) {
            return true;
          }

          if (
            (previous === "+" &&
              current === "+") ||
            (previous === "-" &&
              current === "-")
          ) {
            return true;
          }

          if (
            (previous === "/" &&
              current === "/")
          ) {
            return true;
          }

          return false;
        }


        function minifyJavaScript(source) {

          let result = "";

          let quote = null;

          let template = false;

          let lineComment = false;

          let blockComment = false;

          let escaped = false;

          let pendingSpace = false;

          let previousSignificant = "";

          let regexPossible = true;


          const pushChar = (char) => {

            if (pendingSpace) {

              if (
                shouldKeepSpace(
                  previousSignificant,
                  char
                )
              ) {
                result += " ";
              }

              pendingSpace = false;
            }

            result += char;

            if (!/\s/.test(char)) {
              previousSignificant = char;
            }
          };


          for (
            let i = 0;
            i < source.length;
            i++
          ) {

            const ch = source[i];

            const next =
              source[i + 1];


            /* LINE COMMENT */

            if (lineComment) {

              if (
                ch === "\n" ||
                ch === "\r"
              ) {
                lineComment = false;
                pendingSpace = true;
              }

              continue;
            }


            /* BLOCK COMMENT */

            if (blockComment) {

              if (
                ch === "*" &&
                next === "/"
              ) {

                blockComment = false;

                i++;

                pendingSpace = true;
              }

              continue;
            }


            /* STRING */

            if (quote) {

              pushChar(ch);

              if (escaped) {
                escaped = false;
              } else if (
                ch === "\\"
              ) {
                escaped = true;
              } else if (
                ch === quote
              ) {
                quote = null;
              }

              continue;
            }


            /* TEMPLATE */

            if (template) {

              pushChar(ch);

              if (escaped) {

                escaped = false;

              } else if (
                ch === "\\"
              ) {

                escaped = true;

              } else if (
                ch === "`"
              ) {

                template = false;
              }

              continue;
            }


            /* COMMENTS */

            if (
              ch === "/" &&
              next === "/"
            ) {

              lineComment = true;

              i++;

              continue;
            }


            if (
              ch === "/" &&
              next === "*"
            ) {

              blockComment = true;

              i++;

              continue;
            }


            /* QUOTES */

            if (
              ch === "'" ||
              ch === '"'
            ) {

              quote = ch;

              pushChar(ch);

              continue;
            }


            if (ch === "`") {

              template = true;

              pushChar(ch);

              continue;
            }


            /* WHITESPACE */

            if (/\s/.test(ch)) {

              pendingSpace = true;

              continue;
            }


            /*
             * Remove unnecessary spaces
             * around common punctuation.
             */

            if (
              ch === "," ||
              ch === ";" ||
              ch === ")" ||
              ch === "]"
            ) {

              pendingSpace = false;

              pushChar(ch);

              continue;
            }


            if (
              ch === "(" ||
              ch === "["
            ) {

              pendingSpace = false;

              pushChar(ch);

              continue;
            }


            if (
              ch === "{" ||
              ch === "}"
            ) {

              pendingSpace = false;

              pushChar(ch);

              continue;
            }


            /*
             * Basic handling of slash.
             *
             * Preserve regular expressions
             * rather than treating them as comments.
             */

            if (
              ch === "/" &&
              regexPossible &&
              next !== "/" &&
              next !== "*"
            ) {

              pushChar(ch);

              let regexEscaped = false;

              i++;

              while (
                i < source.length
              ) {

                const rc =
                  source[i];

                pushChar(rc);

                if (regexEscaped) {

                  regexEscaped = false;

                } else if (
                  rc === "\\"
                ) {

                  regexEscaped = true;

                } else if (
                  rc === "/"
                ) {

                  break;
                }

                i++;
              }

              while (
                i + 1 < source.length &&
                /[a-z]/i.test(
                  source[i + 1]
                )
              ) {

                i++;

                pushChar(
                  source[i]
                );
              }

              regexPossible = false;

              continue;
            }


            pushChar(ch);


            /*
             * Rough context detection for
             * the next regular expression.
             */

            if (
              ch === "=" ||
              ch === ":" ||
              ch === "," ||
              ch === "(" ||
              ch === "[" ||
              ch === "{" ||
              ch === "!" ||
              ch === "?" ||
              ch === ";"
            ) {

              regexPossible = true;

            } else if (
              /[A-Za-z0-9_$)\]]/.test(ch)
            ) {

              regexPossible = false;
            }

          }


          return result
            .trim()
            .replace(/\s+$/g, "");
        }


        function minifyCode() {

          const source =
            input.value.trim();

          if (!source) {

            output.value = "";

            updateStats();

            showStatus(
              "أدخل كود JavaScript أولاً.",
              true
            );

            input.focus();

            return;
          }


          try {

            const result =
              minifyJavaScript(source);

            output.value =
              result;

            updateStats();

            showStatus(
              "تم تصغير JavaScript بنجاح."
            );

          } catch {

            showStatus(
              "تعذر تصغير الكود.",
              true
            );
          }
        }


        /* MINIFY */

        minifyBtn.addEventListener(
          "click",
          minifyCode
        );


        /* COPY */

        copyBtn.addEventListener(
          "click",
          async () => {

            if (!output.value) {

              showStatus(
                "قم بتصغير الكود أولاً.",
                true
              );

              return;
            }


            try {

              await navigator.clipboard.writeText(
                output.value
              );

              showStatus(
                "تم نسخ الكود المصغر."
              );

            } catch {

              output.focus();

              output.select();

              document.execCommand(
                "copy"
              );

              showStatus(
                "تم نسخ الكود المصغر."
              );
            }
          }
        );


        /* DOWNLOAD */

        downloadBtn.addEventListener(
          "click",
          () => {

            if (!output.value) {

              showStatus(
                "قم بتصغير الكود أولاً.",
                true
              );

              return;
            }


            const blob =
              new Blob(
                [output.value],
                {
                  type:
                    "text/javascript;charset=utf-8"
                }
              );


            const url =
              URL.createObjectURL(blob);

            const link =
              document.createElement("a");

            link.href = url;

            link.download =
              "minified-javascript.js";

            document.body.appendChild(link);

            link.click();

            link.remove();

            URL.revokeObjectURL(url);

            showStatus(
              "تم تنزيل ملف JavaScript المصغر."
            );
          }
        );


        /* CLEAR */

        clearBtn.addEventListener(
          "click",
          () => {

            input.value = "";

            output.value = "";

            updateStats();

            status.classList.add(
              "hidden"
            );

            input.focus();
          }
        );


        /* INPUT */

        input.addEventListener(
          "input",
          updateStats
        );


        /* TAB */

        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();

              const start =
                input.selectionStart;

              const end =
                input.selectionEnd;

              input.value =
                input.value.substring(
                  0,
                  start
                ) +
                "  " +
                input.value.substring(
                  end
                );

              input.selectionStart =
                input.selectionEnd =
                  start + 2;

              updateStats();
            }


            if (
              (event.ctrlKey ||
                event.metaKey) &&
              event.key === "Enter"
            ) {

              event.preventDefault();

              minifyCode();
            }

          }
        );


        /* SCROLL */

        input.addEventListener(
          "scroll",
          () => {

            inputNumbers.scrollTop =
              input.scrollTop;
          }
        );


        output.addEventListener(
          "scroll",
          () => {

            outputNumbers.scrollTop =
              output.scrollTop;
          }
        );


        updateStats();

      })();
    </script>

  </body>
</html>
