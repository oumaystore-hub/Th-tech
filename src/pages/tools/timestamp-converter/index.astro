---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Timestamp Converter - تحويل Unix Timestamp أونلاين | Th.Tech";

const description =
  "أداة Timestamp Converter مجانية لتحويل Unix Timestamp إلى تاريخ ووقت والعكس، مباشرة داخل المتصفح.";

const faqs = [
  {
    q: "ما هو Unix Timestamp؟",
    a: "Unix Timestamp هو عدد الثواني المنقضية منذ 1 يناير 1970 عند منتصف الليل بتوقيت UTC، ويستخدم على نطاق واسع في البرمجة والأنظمة."
  },
  {
    q: "ما الفرق بين Timestamp بالثواني والميلي ثانية؟",
    a: "Unix Timestamp التقليدي يستخدم الثواني، بينما JavaScript يستخدم غالباً الميلي ثانية. لذلك يكون Timestamp بالميلي ثانية أكبر بألف مرة تقريباً."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا. تتم جميع عمليات التحويل داخل المتصفح باستخدام JavaScript ولا يتم إرسال البيانات إلى خادم خارجي."
  },
  {
    q: "ما هو توقيت Unix Timestamp؟",
    a: "Unix Timestamp يعتمد على UTC ولا يتأثر بالمنطقة الزمنية. عند تحويله إلى تاريخ ووقت يمكن عرضه بالتوقيت المحلي لجهازك."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/timestamp-converter/`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        } else {
          document.documentElement.classList.remove("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>Timestamp Converter</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-clock"></i>
            <span>TIME</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>Timestamp Converter</h1>

            <p>
              حوّل Unix Timestamp إلى تاريخ ووقت والعكس بسرعة وسهولة.
            </p>

            <div class="tags">
              <span>UNIX</span>
              <span>Timestamp</span>
              <span>UTC</span>
              <span>Local</span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="converter-card">

          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-clock"></i>
              Timestamp Converter
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <div class="actionbar">

            <button id="nowBtn" class="btn btn-secondary">
              <i class="fa-solid fa-bolt"></i>
              الآن
            </button>

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="convertBtn" class="btn btn-primary">
              <i class="fa-solid fa-arrows-rotate"></i>
              تحويل
            </button>

          </div>


          <div class="converter-grid">

            <!-- TIMESTAMP -->
            <div class="panel">

              <div class="panel-header">
                <div>
                  <i class="fa-solid fa-hashtag"></i>
                  Unix Timestamp
                </div>

                <span>Seconds</span>
              </div>

              <div class="input-wrap">

                <input
                  id="timestampInput"
                  type="text"
                  inputmode="numeric"
                  placeholder="مثال: 1725446400"
                  autocomplete="off"
                />

                <button
                  id="copyTimestampBtn"
                  class="mini-copy"
                  type="button"
                  title="نسخ"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>

              <p class="field-help">
                أدخل Timestamp بالثواني منذ 1 يناير 1970.
              </p>

            </div>


            <div class="swap-icon">
              <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </div>


            <!-- DATE -->
            <div class="panel">

              <div class="panel-header">
                <div>
                  <i class="fa-regular fa-calendar"></i>
                  Date & Time
                </div>

                <span>Local</span>
              </div>

              <input
                id="dateInput"
                type="datetime-local"
                step="1"
              />

              <p class="field-help">
                أدخل التاريخ والوقت بالتوقيت المحلي لجهازك.
              </p>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للتحويل
              </strong>

              <p id="resultMessage">
                أدخل Timestamp أو تاريخاً ثم اضغط على تحويل.
              </p>

            </div>

          </div>


          <!-- OUTPUT -->
          <div class="output-section">

            <div class="editor-header">

              <div>
                <i class="fa-solid fa-clock"></i>
                تفاصيل الوقت
              </div>

              <span id="timezoneLabel">LOCAL</span>

            </div>


            <div class="details-grid">

              <div class="detail-card">

                <span>
                  <i class="fa-solid fa-hashtag"></i>
                  Unix Seconds
                </span>

                <strong
                  id="outputSeconds"
                  dir="ltr"
                >
                  —
                </strong>

                <button
                  class="copy-detail"
                  data-copy="outputSeconds"
                  type="button"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>


              <div class="detail-card">

                <span>
                  <i class="fa-solid fa-bolt"></i>
                  Milliseconds
                </span>

                <strong
                  id="outputMilliseconds"
                  dir="ltr"
                >
                  —
                </strong>

                <button
                  class="copy-detail"
                  data-copy="outputMilliseconds"
                  type="button"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>


              <div class="detail-card wide">

                <span>
                  <i class="fa-regular fa-calendar"></i>
                  Local Date
                </span>

                <strong
                  id="outputLocal"
                  dir="ltr"
                >
                  —
                </strong>

                <button
                  class="copy-detail"
                  data-copy="outputLocal"
                  type="button"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>


              <div class="detail-card wide">

                <span>
                  <i class="fa-solid fa-globe"></i>
                  UTC Date
                </span>

                <strong
                  id="outputUtc"
                  dir="ltr"
                >
                  —
                </strong>

                <button
                  class="copy-detail"
                  data-copy="outputUtc"
                  type="button"
                >
                  <i class="fa-regular fa-copy"></i>
                </button>

              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-clock"></i>
              </div>

              <div>
                <span>Timestamp</span>
                <strong id="statTimestamp">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-calendar-days"></i>
              </div>

              <div>
                <span>السنة</span>
                <strong id="statYear">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <span>Timezone</span>
                <strong id="statTimezone">—</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>


          <!-- NOTE -->
          <div class="security-note">

            <div class="security-icon">
              <i class="fa-solid fa-circle-info"></i>
            </div>

            <div>

              <strong>معلومة مهمة</strong>

              <p>
                Unix Timestamp يعتمد على UTC ولا يتأثر بالمنطقة الزمنية.
                عند تحويله إلى تاريخ يتم عرض النتيجة بالتوقيت المحلي
                لجهازك، مع توفير نسخة UTC أيضاً.
              </p>

            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>TIMESTAMP CONVERTER</span>

          <h2>
            ما هو Timestamp Converter؟
          </h2>

          <p>
            أداة تساعد المطورين على تحويل Unix Timestamp بين الثواني
            والتاريخ والوقت بسهولة مباشرة داخل المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-clock"></i>
            </div>

            <h3>Unix Timestamp</h3>

            <p>
              يمثل عدد الثواني المنقضية منذ بداية Unix Epoch في
              1 يناير 1970 بتوقيت UTC.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-arrows-rotate"></i>
            </div>

            <h3>تحويل في الاتجاهين</h3>

            <p>
              يمكنك تحويل Timestamp إلى تاريخ ووقت أو تحويل التاريخ
              والوقت إلى Unix Timestamp.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-laptop-code"></i>
            </div>

            <h3>يعمل محلياً</h3>

            <p>
              جميع العمليات تتم داخل المتصفح باستخدام JavaScript
              دون إرسال البيانات إلى خادم خارجي.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية استخدام Timestamp Converter
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>أدخل القيمة</h3>

              <p>
                أدخل Unix Timestamp بالثواني أو اختر تاريخاً ووقتاً
                من حقل التاريخ.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>اضغط تحويل</h3>

              <p>
                اضغط على زر تحويل لمعالجة القيمة مباشرة داخل المتصفح.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>استخدم النتيجة</h3>

              <p>
                احصل على Timestamp بالثواني والميلي ثانية والتاريخ
                المحلي وتاريخ UTC.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>
                <span>{faq.q}</span>

                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>{faq.a}</p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>

  <Footer />


  <script is:inline>
    (() => {

      const timestampInput =
        document.getElementById("timestampInput");

      const dateInput =
        document.getElementById("dateInput");

      const convertBtn =
        document.getElementById("convertBtn");

      const nowBtn =
        document.getElementById("nowBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyTimestampBtn =
        document.getElementById("copyTimestampBtn");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const outputSeconds =
        document.getElementById("outputSeconds");

      const outputMilliseconds =
        document.getElementById("outputMilliseconds");

      const outputLocal =
        document.getElementById("outputLocal");

      const outputUtc =
        document.getElementById("outputUtc");

      const timezoneLabel =
        document.getElementById("timezoneLabel");

      const statTimestamp =
        document.getElementById("statTimestamp");

      const statYear =
        document.getElementById("statYear");

      const statTimezone =
        document.getElementById("statTimezone");

      const statStatus =
        document.getElementById("statStatus");


      const timezone =
        Intl.DateTimeFormat().resolvedOptions().timeZone;


      statTimezone.textContent =
        timezone || "Local";

      timezoneLabel.textContent =
        timezone || "LOCAL";


      function setResult(type, title, message) {

        resultBox.classList.remove(
          "success",
          "error"
        );

        if (type === "success") {

          resultBox.classList.add("success");

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-check"></i>';

        } else if (type === "error") {

          resultBox.classList.add("error");

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-exclamation"></i>';

        } else {

          resultIcon.innerHTML =
            '<i class="fa-solid fa-circle-question"></i>';
        }

        resultTitle.textContent = title;
        resultMessage.textContent = message;
      }


      function formatLocal(date) {

        return new Intl.DateTimeFormat(
          "en-GB",
          {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false
          }
        ).format(date);
      }


      function formatUTC(date) {

        const year =
          date.getUTCFullYear();

        const month =
          String(date.getUTCMonth() + 1)
            .padStart(2, "0");

        const day =
          String(date.getUTCDate())
            .padStart(2, "0");

        const hours =
          String(date.getUTCHours())
            .padStart(2, "0");

        const minutes =
          String(date.getUTCMinutes())
            .padStart(2, "0");

        const seconds =
          String(date.getUTCSeconds())
            .padStart(2, "0");

        return `${year}-${month}-${day} ${hours}:${minutes}:${seconds} UTC`;
      }


      function formatDateInput(date) {

        const year =
          date.getFullYear();

        const month =
          String(date.getMonth() + 1)
            .padStart(2, "0");

        const day =
          String(date.getDate())
            .padStart(2, "0");

        const hours =
          String(date.getHours())
            .padStart(2, "0");

        const minutes =
          String(date.getMinutes())
            .padStart(2, "0");

        const seconds =
          String(date.getSeconds())
            .padStart(2, "0");

        return `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;
      }


      function showResult(date, timestamp) {

        const milliseconds =
          date.getTime();

        outputSeconds.textContent =
          String(timestamp);

        outputMilliseconds.textContent =
          String(milliseconds);

        outputLocal.textContent =
          formatLocal(date);

        outputUtc.textContent =
          formatUTC(date);

        statTimestamp.textContent =
          String(timestamp);

        statYear.textContent =
          String(date.getFullYear());

        statStatus.textContent =
          "تم";

        setResult(
          "success",
          "تم التحويل بنجاح",
          "تم تحويل Timestamp والتاريخ والوقت مباشرة داخل المتصفح."
        );
      }


      function convertFromTimestamp() {

        const value =
          timestampInput.value.trim();

        if (!value) {

          setResult(
            "error",
            "لا يوجد Timestamp",
            "أدخل Unix Timestamp أولاً."
          );

          return;
        }


        if (!/^-?\d+(?:\.\d+)?$/.test(value)) {

          setResult(
            "error",
            "قيمة غير صالحة",
            "أدخل Timestamp رقمياً بالثواني."
          );

          return;
        }


        const seconds =
          Number(value);

        const milliseconds =
          seconds * 1000;


        if (!Number.isFinite(milliseconds)) {

          setResult(
            "error",
            "قيمة كبيرة جداً",
            "القيمة المدخلة تتجاوز النطاق المدعوم."
          );

          return;
        }


        const date =
          new Date(milliseconds);


        if (Number.isNaN(date.getTime())) {

          setResult(
            "error",
            "Timestamp غير صالح",
            "تعذر تحويل القيمة إلى تاريخ."
          );

          return;
        }


        dateInput.value =
          formatDateInput(date);

        showResult(
          date,
          Math.floor(seconds)
        );
      }


      function convertFromDate() {

        const value =
          dateInput.value;

        if (!value) {

          setResult(
            "error",
            "لا يوجد تاريخ",
            "اختر تاريخاً ووقتاً أولاً."
          );

          return;
        }


        const date =
          new Date(value);


        if (Number.isNaN(date.getTime())) {

          setResult(
            "error",
            "تاريخ غير صالح",
            "تعذر قراءة التاريخ والوقت."
          );

          return;
        }


        const milliseconds =
          date.getTime();

        const timestamp =
          Math.floor(milliseconds / 1000);


        timestampInput.value =
          String(timestamp);

        showResult(
          date,
          timestamp
        );
      }


      function convert() {

        const timestamp =
          timestampInput.value.trim();

        const date =
          dateInput.value;


        if (timestamp) {

          convertFromTimestamp();

        } else if (date) {

          convertFromDate();

        } else {

          setResult(
            "error",
            "لا توجد قيمة",
            "أدخل Timestamp أو اختر تاريخاً ووقتاً."
          );

        }
      }


      function setNow() {

        const now =
          new Date();

        const timestamp =
          Math.floor(
            now.getTime() / 1000
          );


        timestampInput.value =
          String(timestamp);

        dateInput.value =
          formatDateInput(now);

        showResult(
          now,
          timestamp
        );
      }


      function setExample() {

        const date =
          new Date("2024-01-01T00:00:00");

        const timestamp =
          Math.floor(
            date.getTime() / 1000
          );


        timestampInput.value =
          String(timestamp);

        dateInput.value =
          formatDateInput(date);

        showResult(
          date,
          timestamp
        );
      }


      function clearAll() {

        timestampInput.value = "";
        dateInput.value = "";

        outputSeconds.textContent = "—";
        outputMilliseconds.textContent = "—";
        outputLocal.textContent = "—";
        outputUtc.textContent = "—";

        statTimestamp.textContent = "0";
        statYear.textContent = "—";
        statStatus.textContent = "جاهز";

        setResult(
          "default",
          "جاهز للتحويل",
          "أدخل Timestamp أو تاريخاً ثم اضغط على تحويل."
        );

        timestampInput.focus();
      }


      async function copyText(text) {

        if (
          !text ||
          text === "—"
        ) {
          return false;
        }


        try {

          await navigator.clipboard.writeText(text);

          return true;

        } catch {

          const textarea =
            document.createElement("textarea");

          textarea.value = text;

          textarea.style.position = "fixed";
          textarea.style.opacity = "0";

          document.body.appendChild(textarea);

          textarea.select();

          const success =
            document.execCommand("copy");

          textarea.remove();

          return success;
        }
      }


      async function copyTimestamp() {

        const value =
          timestampInput.value.trim();

        if (!value) {

          setResult(
            "error",
            "لا توجد قيمة",
            "أدخل Timestamp أولاً ثم حاول النسخ."
          );

          return;
        }


        const copied =
          await copyText(value);


        if (copied) {

          setResult(
            "success",
            "تم النسخ",
            "تم نسخ Unix Timestamp إلى الحافظة."
          );

        }

      }


      convertBtn.addEventListener(
        "click",
        convert
      );


      nowBtn.addEventListener(
        "click",
        setNow
      );


      exampleBtn.addEventListener(
        "click",
        setExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyTimestampBtn.addEventListener(
        "click",
        copyTimestamp
      );


      timestampInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Enter") {
            convertFromTimestamp();
          }

        }
      );


      dateInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Enter") {
            convertFromDate();
          }

        }
      );


      document
        .querySelectorAll(".copy-detail")
        .forEach((button) => {

          button.addEventListener(
            "click",
            async () => {

              const id =
                button.dataset.copy;

              const element =
                document.getElementById(id);

              const text =
                element?.textContent.trim();

              const copied =
                await copyText(text);


              if (copied) {

                setResult(
                  "success",
                  "تم النسخ",
                  "تم نسخ القيمة إلى الحافظة."
                );

              }

            }
          );

        });


