---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "HTML Entity Encoder - ترميز HTML Entities أونلاين مجاناً | Th.Tech";
const description =
  "أداة مجانية لترميز HTML Entities وتحويل الرموز الخاصة مثل < و > و & و علامات الاقتباس إلى كيانات HTML آمنة.";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- ================= HERO ================= -->

    <section class="tool-hero">
      <div class="hero-bg"></div>

      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fas fa-chevron-left"></i>

          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fas fa-chevron-left"></i>

          <span>HTML Entity Encoder</span>
        </div>

        <div class="hero-content">

          <div class="tool-icon">
            <i class="fas fa-code"></i>
          </div>

          <div>

            <span class="kicker">
              <i class="fas fa-code"></i>
              HTML Tools
            </span>

            <h1>
              HTML Entity <span>Encoder</span>
            </h1>

            <p>
              حوّل الرموز الخاصة في HTML إلى HTML Entities
              لتجنب مشاكل تفسيرها داخل صفحات الويب.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= TOOL ================= -->

    <section class="tool-section">

      <div class="container">

        <div class="tool-card">

          <!-- Toolbar -->

          <div class="toolbar">

            <div class="toolbar-title">
              <i class="fas fa-code"></i>
              <span>HTML Entity Encoder</span>
            </div>

            <div class="toolbar-actions">

              <button
                id="decodeBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-unlock"></i>
                فك الترميز
              </button>

              <button
                id="copyBtn"
                class="tool-btn secondary"
                type="button"
              >
                <i class="fas fa-copy"></i>
                نسخ
              </button>

              <button
                id="clearBtn"
                class="tool-btn danger"
                type="button"
              >
                <i class="fas fa-trash"></i>
                مسح
              </button>

            </div>

          </div>


          <!-- Editors -->

          <div class="editors">

            <!-- Input -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-file-code"></i>
                  النص الأصلي
                </div>

                <span id="inputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="input"
                  spellcheck="false"
                  placeholder="اكتب أو ألصق HTML هنا...

مثال:

<div class="box">
  <h1>Hello & Welcome</h1>
  <p>5 > 3</p>
</div>"
                ></textarea>

              </div>

            </div>


            <!-- Output -->

            <div class="editor-panel">

              <div class="panel-header">

                <div>
                  <i class="fas fa-code"></i>
                  HTML Entities
                </div>

                <span id="outputSize">0 B</span>

              </div>

              <div class="editor-wrapper">

                <textarea
                  id="output"
                  readonly
                  spellcheck="false"
                  placeholder="ستظهر HTML Entities هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- Main Action -->

          <div class="main-actions">

            <button
              id="encodeBtn"
              class="encode-btn"
              type="button"
            >
              <i class="fas fa-code"></i>

              ترميز HTML Entities

              <i class="fas fa-arrow-left"></i>
            </button>

          </div>


          <!-- Status -->

          <div id="status" class="status hidden">

            <i
              id="statusIcon"
              class="fas fa-check-circle"
            ></i>

            <span id="statusText"></span>

          </div>


          <!-- Statistics -->

          <div class="statistics">

            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-file-code"></i>
              </div>

              <div>
                <span
                  class="stat-value"
                  id="originalSize"
                >
                  0 B
                </span>

                <span class="stat-label">
                  الحجم الأصلي
                </span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fas fa-code"></i>
              </div>

              <div>

                <span
                  class="stat-value"
                  id="encodedSize"
                >
                  0 B
                </span>

                <span class="stat-label">
                  بعد الترميز
                </span>

              </div>

            </div>


            <div class="stat">

              <div class="stat-icon success">
                <i class="fas fa-font"></i>
              </div>

              <div>

                <span
                  class="stat-value"
                  id="charCount"
                >
                  0
                </span>

                <span class="stat-label">
                  عدد الأحرف
                </span>

              </div>

            </div>

          </div>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-grid">

          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <div>

              <h3>
                سريع وفوري
              </h3>

              <p>
                تتم عملية الترميز مباشرة داخل المتصفح
                بدون الحاجة إلى رفع النص إلى خادم خارجي.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div>

              <h3>
                خصوصية أفضل
              </h3>

              <p>
                النص الذي تدخله يبقى داخل جهازك ولا يتم
                إرساله إلى خدمة خارجية.
              </p>

            </div>

          </div>


          <div class="info-card">

            <div class="info-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>

              <h3>
                HTML آمن
              </h3>

              <p>
                تحويل الرموز الخاصة يساعد على منع تفسيرها
                كعناصر HTML عند عرضها كنص.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= HOW ================= -->

        <div class="how-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-info"></i>

              طريقة الاستخدام

            </span>

            <h2>
              كيف تستخدم
              <span>HTML Entity Encoder؟</span>
            </h2>

          </div>


          <div class="steps">

            <div class="step">

              <span class="step-number">
                01
              </span>

              <div class="step-icon">

                <i class="fas fa-paste"></i>

              </div>

              <h3>
                أدخل النص
              </h3>

              <p>
                ألصق HTML أو النص الذي يحتوي على
                رموز خاصة في مربع الإدخال.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                02
              </span>

              <div class="step-icon">

                <i class="fas fa-code"></i>

              </div>

              <h3>
                اضغط ترميز
              </h3>

              <p>
                اضغط على زر ترميز HTML Entities
                لتحويل الرموز الخاصة.
              </p>

            </div>


            <div class="step">

              <span class="step-number">
                03
              </span>

              <div class="step-icon">

                <i class="fas fa-copy"></i>

              </div>

              <h3>
                انسخ النتيجة
              </h3>

              <p>
                انسخ النص المشفر واستخدمه في
                مشروعك أو صفحة HTML.
              </p>

            </div>

          </div>

        </div>


        <!-- ================= FAQ ================= -->

        <div class="faq-section">

          <div class="section-heading">

            <span class="kicker">

              <i class="fas fa-circle-question"></i>

              الأسئلة الشائعة

            </span>

            <h2>
              أسئلة حول
              <span>HTML Entity Encoder</span>
            </h2>

          </div>


          <div class="faq-list">

            <details>

              <summary>

                ما هي HTML Entities؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                HTML Entities هي تمثيلات نصية خاصة للرموز
                التي لها معنى داخل HTML، مثل &lt; و &gt; و &amp;.
              </p>

            </details>


            <details>

              <summary>

                لماذا نستخدم HTML Entity Encoder؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                يستخدم لتحويل الرموز الخاصة إلى صيغة يمكن
                عرضها كنص دون أن يفسرها المتصفح كعناصر HTML.
              </p>

            </details>


            <details>

              <summary>

                هل يتم إرسال البيانات إلى الخادم؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                لا. تتم عملية الترميز وفك الترميز بالكامل
                باستخدام JavaScript داخل المتصفح.
              </p>

            </details>


            <details>

              <summary>

                ما الرموز التي يتم ترميزها؟

                <i class="fas fa-chevron-down"></i>

              </summary>

              <p>
                يتم التعامل بشكل أساسي مع الرموز الخاصة
                مثل &amp; و &lt; و &gt; و علامات الاقتباس
                وغيرها من الرموز التي تحتاج إلى تمثيل آمن.
              </p>

            </details>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- ================= CSS ================= -->

  <style>

    :root {

      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;

      --text: #0f172a;
      --muted: #64748b;

      --primary: #ca8a04;
      --primary-hover: #a16207;

      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;

      --border: rgba(15, 23, 42, .09);

      --shadow:
        0 20px 60px rgba(15, 23, 42, .08);

    }


    html.dark-mode {

      --bg: #07101f;
      --bg2: #0b1426;

      --card: #111d32;
      --card2: #0d1729;

      --text: #f8fafc;
      --muted: #94a3b8;

      --primary: #eab308;
      --primary-hover: #facc15;

      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;

      --border:
        rgba(148, 163, 184, .12);

      --shadow:
        0 20px 60px rgba(0, 0, 0, .28);

    }


    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      margin: 0;

      background:
        var(--bg);

      color:
        var(--text);

      font-family:
        "Cairo",
        sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color .25s ease,
        color .25s ease;

    }


    a {

      color: inherit;

      text-decoration: none;

    }


    button,
    textarea {

      font-family: inherit;

    }


    button {

      -webkit-tap-highlight-color:
        transparent;

    }


    .container {

      width: 100%;

      max-width: 1200px;

      margin: auto;

      padding:
        0 20px;

    }


    /* ================= HERO ================= */

    .tool-hero {

      position: relative;

      overflow: hidden;

      padding:
        55px 0 65px;

      background:
        var(--bg2);

      border-bottom:
        1px solid var(--border);

    }


    .hero-bg {

      position: absolute;

      inset: 0;

      pointer-events: none;

      background:

        radial-gradient(
          circle at 20% 30%,
          rgba(202, 138, 4, .12),
          transparent 35%
        ),

        radial-gradient(
          circle at 80% 70%,
          rgba(6, 182, 212, .08),
          transparent 35%
        );

    }


    .breadcrumb {

      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 9px;

      margin-bottom: 28px;

      color:
        var(--muted);

      font-size: .78rem;

    }


    .breadcrumb a {

      transition:
        color .2s ease;

    }


    .breadcrumb a:hover {

      color:
        var(--primary);

    }


    .breadcrumb i {

      font-size: .55rem;

      opacity: .6;

    }


    .hero-content {

      position: relative;

      display: flex;

      align-items: center;

      gap: 22px;

    }


    .tool-icon {

      width: 78px;

      height: 78px;

      flex-shrink: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 22px;

      color:
        var(--primary);

      background:
        rgba(202, 138, 4, .10);

      border:
        1px solid rgba(202, 138, 4, .16);

      font-size: 2rem;

      box-shadow:
        0 15px 35px
        rgba(202, 138, 4, .10);

    }


    .kicker {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-bottom: 8px;

      color:
        var(--primary);

      font-size: .76rem;

      font-weight: 800;

    }


    .hero-content h1 {

      margin:
        0 0 8px;

      font-size:
        clamp(2rem, 5vw, 3.2rem);

      line-height: 1.25;

    }


    .hero-content h1 span {

      color:
        var(--primary);

    }


    .hero-content p {

      max-width: 700px;

      margin: 0;

      color:
        var(--muted);

      font-size: .92rem;

    }


    /* ================= TOOL ================= */

    .tool-section {

      padding:
        65px 0 90px;

    }


    .tool-card {

      overflow: hidden;

      border-radius: 24px;

      background:
        var(--card);

      border:
        1px solid var(--border);

      box-shadow:
        var(--shadow);

    }


    .toolbar {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding:
        17px 20px;

      border-bottom:
        1px solid var(--border);

      background:
        var(--card2);

    }


    .toolbar-title {

      display: flex;

      align-items: center;

      gap: 9px;

      font-size: .9rem;

      font-weight: 800;

    }


    .toolbar-title i {

      color:
        var(--primary);

    }


    .toolbar-actions {

      display: flex;

      gap: 8px;

      flex-wrap: wrap;

    }


    .tool-btn {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 7px;

      min-height: 38px;

      padding:
        7px 13px;

      border-radius: 10px;

      border:
        1px solid var(--border);

      background:
        var(--card);

      color:
        var(--text);

      font-size: .76rem;

      font-weight: 700;

      cursor: pointer;

      transition:
        .2s ease;

    }


    .tool-btn:hover {

      border-color:
        rgba(202, 138, 4, .35);

      color:
        var(--primary);

      transform:
        translateY(-2px);

    }


    .tool-btn.danger:hover {

      color:
        var(--red);

      border-color:
        rgba(220, 38, 38, .25);

    }


    /* ================= EDITORS ================= */

    .editors {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 18px;

      padding: 20px;

    }


    .editor-panel {

      overflow: hidden;

      border-radius: 16px;

      border:
        1px solid var(--border);

      background:
        var(--card2);

    }


    .panel-header {

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding:
        12px 15px;

      border-bottom:
        1px solid var(--border);

      color:
        var(--muted);

      font-size: .75rem;

      font-weight: 700;

    }


    .panel-header > div {

      display: flex;

      align-items: center;

      gap: 7px;

    }


    .panel-header i {

      color:
        var(--primary);

    }


    .editor-wrapper {

      height: 350px;

    }


    textarea {

      width: 100%;

      height: 100%;

      display: block;

      resize: none;

      outline: none;

      border: 0;

      padding: 18px;

      background:
        transparent;

      color:
        var(--text);

      direction: ltr;

      text-align: left;

      font-family:
        Consolas,
        "Courier New",
        monospace;

      font-size: .84rem;

      line-height: 1.8;

    }


    textarea::placeholder {

      color:
        var(--muted);

      opacity: .65;

    }


    #output {

      color:
        var(--primary);

    }


    /* ================= ACTION ================= */

    .main-actions {

      display: flex;

      justify-content: center;

      padding:
        0 20px 20px;

    }


    .encode-btn {

      min-width: 250px;

      min-height: 52px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      border: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #eab308,
          #ca8a04
        );

      color: white;

      font-family:
        inherit;

      font-size: .9rem;

      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 12px 30px
        rgba(202, 138, 4, .22);

      transition:
        .25s ease;

    }


    .encode-btn:hover {

      transform:
        translateY(-3px);

      box-shadow:
        0 17px 35px
        rgba(202, 138, 4, .30);

    }


    /* ================= STATUS ================= */

    .status {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      margin:
        0 20px 20px;

      padding:
        11px 15px;

      border-radius: 11px;

      background:
        rgba(34, 197, 94, .08);

      border:
        1px solid
        rgba(34, 197, 94, .15);

      color:
        var(--green);

      font-size: .78rem;

      font-weight: 700;

    }


    .status.error {

      background:
        rgba(220, 38, 38, .08);

      border-color:
        rgba(220, 38, 38, .15);

      color:
        var(--red);

    }


    .hidden {

      display: none;

    }


    /* ================= STATISTICS ================= */

    .statistics {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 1px;

      background:
        var(--border);

      border-top:
        1px solid var(--border);

    }


    .stat {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 12px;

      padding:
        22px 15px;

      background:
        var(--card);

    }


    .stat-icon {

      width: 43px;

      height: 43px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 12px;

      background:
        rgba(202, 138, 4, .09);

      color:
        var(--primary);

    }


    .stat-icon.success {

      color:
        var(--green);

      background:
        rgba(34, 197, 94, .09);

    }


    .stat-value {

      display: block;

      color:
        var(--text);

      font-size: 1rem;

      font-weight: 800;

      direction: ltr;

      text-align: right;

    }


    .stat-label {

      display: block;

      color:
        var(--muted);

      font-size: .68rem;

    }


    /* ================= INFO ================= */

    .info-grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 17px;

      margin-top: 25px;

    }


    .info-card {

      display: flex;

      gap: 14px;

      padding: 22px;

      border-radius: 17px;

      background:
        var(--card);

      border:
        1px solid var(--border);

      transition:
        .25s ease;

    }


    .info-card:hover {

      transform:
        translateY(-4px);

      border-color:
        rgba(202, 138, 4, .25);

    }


    .info-icon {

      width: 44px;

      height: 44px;

      flex-shrink: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 12px;

      color:
        var(--primary);

      background:
        rgba(202, 138, 4, .09);

    }


    .info-card h3 {

      margin:
        0 0 5px;

      font-size: .9rem;

    }


    .info-card p {

      margin: 0;

      color:
        var(--muted);

      font-size: .74rem;

      line-height: 1.8;

    }


    /* ================= SECTIONS ================= */

    .how-section,
    .faq-section {

      margin-top:
        100px;

    }


    .section-heading {

      text-align: center;

      margin-bottom:
        40px;

    }


    .section-heading h2 {

      margin: 0;

      font-size:
        clamp(1.7rem, 4vw, 2.4rem);

    }


    .section-heading h2 span {

      color:
        var(--primary);

    }


    /* ================= STEPS ================= */

    .steps {

      display: grid;

      grid-template-columns:
        repeat(3, 1
