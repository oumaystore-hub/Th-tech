        height: 42px;
        display: grid;
        place-items: center;
        margin: 0 auto 9px;
        border-radius: 12px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .stat-card strong,
      .stat-card span {
        display: block;
      }

      .stat-card strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
      }

      .stat-card span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 11px;
      }

      /* PRIVACY */

      .privacy-card {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 18px;
        padding: 20px;
        border: 1px solid rgba(22, 163, 74, 0.16);
        border-radius: 18px;
        background: rgba(22, 163, 74, 0.045);
      }

      .privacy-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        color: var(--green);
        background: rgba(22, 163, 74, 0.1);
        font-size: 20px;
      }

      .privacy-card h3 {
        margin: 0;
        font-size: 14px;
      }

      .privacy-card p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 12px;
      }

      .privacy-check {
        margin-right: auto;
        color: var(--green);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
      }

      /* SECTIONS */

      .info-section,
      .how-section,
      .faq-section {
        margin-top: 75px;
      }

      .section-heading {
        margin-bottom: 25px;
      }

      .section-heading h2 {
        margin: 4px 0 0;
        font-size: 25px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .info-card {
        padding: 23px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
      }

      .info-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        margin-bottom: 14px;
        border-radius: 13px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-size: 15px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .step {
        display: flex;
        gap: 15px;
        padding: 21px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
      }

      .step-number {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        color: white;
        background: linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 700;
      }

      .step h3 {
        margin: 0;
        font-size: 14px;
      }

      .step p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        display: grid;
        gap: 10px;
      }

      .faq-item {
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
      }

      .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 20px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--muted);
        font-size: 11px;
        transition: transform 0.2s ease;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
      }

      .faq-item p {
        margin: 0;
        padding: 0 20px 18px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 850px) {
        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .hero {
          padding: 30px 0 50px;
        }

        .hero-content {
          align-items: flex-start;
        }

        .hero-icon {
          flex-basis: 70px;
          width: 70px;
          height: 70px;
          border-radius: 21px;
          font-size: 28px;
        }

        .tool-section {
          padding-top: 35px;
        }

        .tool-card {
          padding: 20px;
        }

        .tool-header {
          flex-direction: column;
        }

        .color-grid,
        .wcag-grid,
        .values-grid {
          grid-template-columns: 1fr;
        }

        .result-panel {
          align-items: flex-start;
          flex-direction: column;
        }

        .result-status {
          width: 100%;
          flex-direction: row;
          justify-content: center;
        }

        .privacy-card {
          align-items: flex-start;
          flex-wrap: wrap;
        }

        .privacy-check {
