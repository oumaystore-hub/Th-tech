---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Contrast Checker - فحص تباين الألوان | Th.Tech";
const description =
  "أداة مجانية لفحص تباين الألوان وحساب نسبة التباين وفق معايير WCAG، مع معرفة مستوى AA و AAA.";

const canonical = "https://oumaystore-hub.github.io" + base + "/tools/contrast-checker/";

const faqs = [
  {
    q: "ما هو Contrast Checker؟",
    a: "أداة تساعدك على قياس نسبة التباين بين لون النص ولون الخلفية لمعرفة مدى وضوح النص وسهولة قراءته."
  },
  {
    q: "ما هي معايير WCAG؟",
    a: "WCAG هي إرشادات عالمية لإتاحة محتوى الويب، وتحدد مستويات مختلفة لتباين الألوان مثل AA و AAA."
  },
  {
    q: "ما هي نسبة التباين المطلوبة؟",
    a: "للنص العادي يوصى بنسبة 4.5:1 على الأقل لمستوى AA، بينما يحتاج مستوى AAA إلى 7:1. أما النص الكبير فيحتاج عادة إلى 3:1 لمستوى AA."
  },
  {
    q: "هل يتم إرسال الألوان إلى الخادم؟",
    a: "لا. جميع عمليات حساب التباين تتم مباشرة داخل المتصفح."
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-orb hero-orb-one"></div>
        <div class="hero-orb hero-orb-two"></div>

        <div class="container hero-inner">
          <div class="breadcrumb">
            <a href={base + "/"}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={base + "/tools/"}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>Contrast Checker</span>
          </div>

          <div class="hero-content">
            <div class="hero-icon">
              <i class="fa-solid fa-circle-half-stroke"></i>
            </div>

            <div class="hero-text">
              <div class="hero-badge">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                أداة الوصول Accessibility
              </div>

              <h1>Contrast Checker</h1>

              <p>
                افحص تباين الألوان وتأكد من سهولة قراءة النص وفق معايير WCAG
              </p>

              <div class="hero-tags">
                <span>WCAG</span>
                <span>AA</span>
                <span>AAA</span>
                <span>Accessibility</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">
          <div class="tool-card">

            <div class="tool-header">
              <div>
                <span class="section-label">
                  <i class="fa-solid fa-sliders"></i>
                  فحص التباين
                </span>

                <h2>اختبر ألوان النص والخلفية</h2>

                <p>
                  اختر لون النص ولون الخلفية للحصول على نسبة التباين ونتيجة
                  توافق WCAG بشكل فوري.
                </p>
              </div>

              <div class="live-badge">
                <span></span>
                فحص مباشر
              </div>
            </div>

            <!-- COLOR CONTROLS -->
            <div class="color-grid">

              <!-- FOREGROUND -->
              <div class="color-box">
                <div class="color-box-head">
                  <div class="color-title">
                    <div class="small-icon foreground-icon">
                      <i class="fa-solid fa-font"></i>
                    </div>

                    <div>
                      <strong>لون النص</strong>
                      <small>Foreground</small>
                    </div>
                  </div>

                  <input
                    id="foregroundPicker"
                    class="color-picker"
                    type="color"
                    value="#111827"
                    aria-label="لون النص"
                  />
                </div>

                <div class="hex-input-wrap">
                  <span>#</span>
                  <input
                    id="foreground"
                    type="text"
                    value="111827"
                    maxlength="6"
                    spellcheck="false"
                    autocomplete="off"
                  />
                </div>
              </div>

              <!-- BACKGROUND -->
              <div class="color-box">
                <div class="color-box-head">
                  <div class="color-title">
                    <div class="small-icon background-icon">
                      <i class="fa-solid fa-fill-drip"></i>
                    </div>

                    <div>
                      <strong>لون الخلفية</strong>
                      <small>Background</small>
                    </div>
                  </div>

                  <input
                    id="backgroundPicker"
                    class="color-picker"
                    type="color"
                    value="#ffffff"
                    aria-label="لون الخلفية"
                  />
                </div>

                <div class="hex-input-wrap">
                  <span>#</span>
                  <input
                    id="background"
                    type="text"
                    value="ffffff"
                    maxlength="6"
                    spellcheck="false"
                    autocomplete="off"
                  />
                </div>
              </div>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
              <button id="swapBtn" class="btn btn-secondary" type="button">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                تبديل الألوان
              </button>

              <button id="resetBtn" class="btn btn-ghost" type="button">
                <i class="fa-solid fa-rotate-right"></i>
                إعادة الضبط
              </button>

              <button id="checkBtn" class="btn btn-primary" type="button">
                <i class="fa-solid fa-check-circle"></i>
                فحص التباين
              </button>
            </div>

            <!-- PREVIEW -->
            <div class="preview-section">
              <div class="preview-head">
                <div>
                  <span class="section-label">
                    <i class="fa-solid fa-eye"></i>
                    المعاينة
                  </span>
                  <h3>معاينة النص</h3>
                </div>

                <span id="previewRatio" class="mini-ratio">21:1</span>
              </div>

              <div id="previewBox" class="preview-box">
                <div class="preview-content">
                  <div class="preview-large">
                    Th.Tech
                  </div>

                  <div class="preview-title">
                    نص كبير وواضح
                  </div>

                  <div class="preview-normal">
                    هذا مثال على النص العادي لمعرفة مدى وضوحه فوق الخلفية المختارة.
                  </div>

                  <div class="preview-small">
                    Small text — Accessibility preview
                  </div>
                </div>
              </div>
            </div>

            <!-- RESULT -->
            <div class="result-panel">
              <div class="result-main">
                <span class="result-label">نسبة التباين</span>

                <div class="ratio-row">
                  <strong id="ratio">21.00</strong>
                  <span>:1</span>
                </div>

                <p id="resultMessage">
                  تباين ممتاز ومناسب لمستويات الوصول العالية.
                </p>
              </div>

              <div class="result-status" id="resultStatus">
                <i class="fa-solid fa-circle-check"></i>
                <strong id="statusText">ممتاز</strong>
              </div>
            </div>

            <!-- WCAG -->
            <div class="wcag-grid">

              <div class="wcag-card" id="normalAA">
                <div class="wcag-icon">
                  <i class="fa-solid fa-check"></i>
                </div>

                <div>
                  <strong>النص العادي — AA</strong>
                  <span>يتطلب 4.5:1</span>
                </div>

                <b>PASS</b>
              </div>

              <div class="wcag-card" id="normalAAA">
                <div class="wcag-icon">
                  <i class="fa-solid fa-check"></i>
                </div>

                <div>
                  <strong>النص العادي — AAA</strong>
                  <span>يتطلب 7:1</span>
                </div>

                <b>PASS</b>
              </div>

              <div class="wcag-card" id="largeAA">
                <div class="wcag-icon">
                  <i class="fa-solid fa-check"></i>
                </div>

                <div>
                  <strong>النص الكبير — AA</strong>
                  <span>يتطلب 3:1</span>
                </div>

                <b>PASS</b>
              </div>

              <div class="wcag-card" id="largeAAA">
                <div class="wcag-icon">
                  <i class="fa-solid fa-check"></i>
                </div>

                <div>
                  <strong>النص الكبير — AAA</strong>
                  <span>يتطلب 4.5:1</span>
                </div>

                <b>PASS</b>
              </div>

            </div>

            <!-- COLOR VALUES -->
            <div class="values-grid">

              <div class="value-card">
                <span>لون النص</span>

                <div class="value-line">
                  <i id="foregroundDot" class="value-dot"></i>
                  <code id="foregroundValue">#111827</code>

                  <button
                    class="copy-btn"
                    data-copy="foregroundValue"
                    type="button"
                    aria-label="نسخ لون النص"
                  >
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>
              </div>

              <div class="value-card">
                <span>لون الخلفية</span>

                <div class="value-line">
                  <i id="backgroundDot" class="value-dot"></i>
                  <code id="backgroundValue">#FFFFFF</code>

                  <button
                    class="copy-btn"
                    data-copy="backgroundValue"
                    type="button"
                    aria-label="نسخ لون الخلفية"
                  >
                    <i class="fa-regular fa-copy"></i>
                  </button>
                </div>
              </div>

            </div>

          </div>

          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-chart-simple"></i>
              </div>
              <strong id="ratioStat">21.00:1</strong>
              <span>نسبة التباين</span>
            </div>

            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-universal-access"></i>
              </div>
              <strong id="passCount">4 / 4</strong>
              <span>اختبارات ناجحة</span>
            </div>

            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-palette"></i>
              </div>
              <strong>2</strong>
              <span>ألوان مختبرة</span>
            </div>

            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>
              <strong>Live</strong>
              <span>نتيجة فورية</span>
            </div>

          </div>

          <!-- SECURITY / PRIVACY -->
          <div class="privacy-card">
            <div class="privacy-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
              <h3>خصوصيتك محفوظة</h3>
              <p>
                لا يتم إرسال الألوان أو أي بيانات إلى الخادم. جميع الحسابات
                تتم محليًا داخل متصفحك.
              </p>
            </div>

            <div class="privacy-check">
              <i class="fa-solid fa-lock"></i>
              محلي 100%
            </div>
          </div>

          <!-- INFO -->
          <section class="info-section">

            <div class="section-heading">
              <span class="section-label">
                <i class="fa-solid fa-circle-info"></i>
                معلومات مهمة
              </span>

              <h2>فهم تباين الألوان</h2>
            </div>

            <div class="info-grid">

              <article class="info-card">
                <div class="info-icon">
                  <i class="fa-solid fa-percent"></i>
                </div>

                <h3>نسبة التباين</h3>

                <p>
                  تتراوح نسبة التباين من 1:1 إلى 21:1. كلما ارتفعت النسبة،
                  أصبح الفرق بين اللونين أكبر وازدادت سهولة القراءة.
                </p>
              </article>

              <article class="info-card">
                <div class="info-icon">
                  <i class="fa-solid fa-universal-access"></i>
                </div>

                <h3>WCAG AA</h3>

                <p>
                  يتطلب النص العادي نسبة تباين لا تقل عن 4.5:1، بينما يحتاج
                  النص الكبير إلى 3:1.
                </p>
              </article>

              <article class="info-card">
                <div class="info-icon">
                  <i class="fa-solid fa-award"></i>
                </div>

                <h3>WCAG AAA</h3>

                <p>
                  المستوى الأعلى من الوصول يتطلب 7:1 للنص العادي و4.5:1
                  للنص الكبير.
                </p>
              </article>

            </div>
          </section>

          <!-- HOW TO -->
          <section class="how-section">

            <div class="section-heading">
              <span class="section-label">
                <i class="fa-solid fa-list-check"></i>
                طريقة الاستخدام
              </span>

              <h2>افحص التباين في 3 خطوات</h2>
            </div>

            <div class="steps">

              <div class="step">
                <div class="step-number">01</div>

                <div>
                  <h3>اختر لون النص</h3>
                  <p>
                    أدخل قيمة HEX أو اختر اللون من منتقي الألوان.
                  </p>
                </div>
              </div>

              <div class="step">
                <div class="step-number">02</div>

                <div>
                  <h3>اختر لون الخلفية</h3>
                  <p>
                    حدد اللون الذي سيظهر خلف النص.
                  </p>
                </div>
              </div>

              <div class="step">
                <div class="step-number">03</div>

                <div>
                  <h3>راجع النتيجة</h3>
                  <p>
                    شاهد نسبة التباين ونتائج AA وAAA مباشرة.
                  </p>
                </div>
              </div>

            </div>
          </section>

          <!-- FAQ -->
          <section class="faq-section">

            <div class="section-heading">
              <span class="section-label">
                <i class="fa-solid fa-circle-question"></i>
                الأسئلة الشائعة
              </span>

              <h2>أسئلة حول Contrast Checker</h2>
            </div>

            <div class="faq-list">
              {faqs.map((item, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary>
                    <span>{item.q}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <p>{item.a}</p>
                </details>
              ))}
            </div>

          </section>

        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const foreground = document.getElementById("foreground");
        const background = document.getElementById("background");

        const foregroundPicker =
          document.getElementById("foregroundPicker");

        const backgroundPicker =
          document.getElementById("backgroundPicker");

        const previewBox =
          document.getElementById("previewBox");

        const ratioElement =
          document.getElementById("ratio");

        const previewRatio =
          document.getElementById("previewRatio");

        const ratioStat =
          document.getElementById("ratioStat");

        const resultMessage =
          document.getElementById("resultMessage");

        const resultStatus =
          document.getElementById("resultStatus");

        const statusText =
          document.getElementById("statusText");

        const foregroundValue =
          document.getElementById("foregroundValue");

        const backgroundValue =
          document.getElementById("backgroundValue");

        const foregroundDot =
          document.getElementById("foregroundDot");

        const backgroundDot =
          document.getElementById("backgroundDot");

        const passCount =
          document.getElementById("passCount");

        const checkBtn =
          document.getElementById("checkBtn");

        const swapBtn =
          document.getElementById("swapBtn");

        const resetBtn =
          document.getElementById("resetBtn");

        const defaults = {
          foreground: "#111827",
          background: "#ffffff"
        };

        function normalizeHex(value) {
          let clean = String(value || "")
            .trim()
            .replace("#", "")
            .replace(/[^0-9a-fA-F]/g, "");

          if (clean.length === 3) {
            clean =
              clean[0] + clean[0] +
              clean[1] + clean[1] +
              clean[2] + clean[2];
          }

          if (clean.length !== 6) {
            return null;
          }

          return "#" + clean.toUpperCase();
        }

        function hexToRgb(hex) {
          const normalized = normalizeHex(hex);

          if (!normalized) {
            return null;
          }

          return {
            r: parseInt(normalized.substring(1, 3), 16),
            g: parseInt(normalized.substring(3, 5), 16),
            b: parseInt(normalized.substring(5, 7), 16)
          };
        }

        function relativeLuminance(rgb) {
          const values = [
            rgb.r / 255,
            rgb.g / 255,
            rgb.b / 255
          ];

          const converted = values.map(function (value) {
            if (value <= 0.03928) {
              return value / 12.92;
            }

            return Math.pow(
              (value + 0.055) / 1.055,
              2.4
            );
          });

          return (
            0.2126 * converted[0] +
            0.7152 * converted[1] +
            0.0722 * converted[2]
          );
        }

        function getContrastRatio(first, second) {
          const rgb1 = hexToRgb(first);
          const rgb2 = hexToRgb(second);

          if (!rgb1 || !rgb2) {
            return 1;
          }

          const l1 = relativeLuminance(rgb1);
          const l2 = relativeLuminance(rgb2);

          const light = Math.max(l1, l2);
          const dark = Math.min(l1, l2);

          return (light + 0.05) / (dark + 0.05);
        }

        function setCardResult(id, passed) {
          const card = document.getElementById(id);

          if (!card) {
            return;
          }

          const icon = card.querySelector(".wcag-icon");
          const result = card.querySelector("b");

          if (passed) {
            card.classList.add("passed");
            card.classList.remove("failed");

            if (icon) {
              icon.innerHTML =
                '<i class="fa-solid fa-check"></i>';
            }

            if (result) {
              result.textContent = "PASS";
            }
          } else {
            card.classList.add("failed");
            card.classList.remove("passed");

            if (icon) {
              icon.innerHTML =
                '<i class="fa-solid fa-xmark"></i>';
            }

            if (result) {
              result.textContent = "FAIL";
            }
          }
        }

        function update() {
          const fg = normalizeHex(foreground.value);
          const bg = normalizeHex(background.value);

          if (!fg || !bg) {
            ratioElement.textContent = "--";
            previewRatio.textContent = "--";
            ratioStat.textContent = "--";

            resultMessage.textContent =
              "أدخل قيم HEX صحيحة مكونة من 3 أو 6 أحرف.";

            statusText.textContent = "قيمة غير صالحة";

            return;
          }

          foreground.value = fg.substring(1);
          background.value = bg.substring(1);

          foregroundPicker.value = fg;
          backgroundPicker.value = bg;

          const ratio = getContrastRatio(fg, bg);
          const rounded = ratio.toFixed(2);

          const normalAA = ratio >= 4.5;
          const normalAAA = ratio >= 7;
          const largeAA = ratio >= 3;
          const largeAAA = ratio >= 4.5;

          const passed =
            Number(normalAA) +
            Number(normalAAA) +
            Number(largeAA) +
            Number(largeAAA);

          ratioElement.textContent = rounded;
          previewRatio.textContent = rounded + ":1";
          ratioStat.textContent = rounded + ":1";

          foregroundValue.textContent = fg;
          backgroundValue.textContent = bg;

          foregroundDot.style.background = fg;
          backgroundDot.style.background = bg;

          previewBox.style.background = bg;
          previewBox.style.color = fg;

          setCardResult("normalAA", normalAA);
          setCardResult("normalAAA", normalAAA);
          setCardResult("largeAA", largeAA);
          setCardResult("largeAAA", largeAAA);

          passCount.textContent = passed + " / 4";

          if (ratio >= 7) {
            statusText.textContent = "ممتاز";
            resultMessage.textContent =
              "تباين ممتاز ومتوافق مع مستويات WCAG AA وAAA للنصوص.";

            resultStatus.className = "result-status excellent";
          } else if (ratio >= 4.5) {
            statusText.textContent = "جيد جدًا";
            resultMessage.textContent =
              "تباين جيد جدًا ومناسب للنصوص العادية وفق مستوى AA.";

            resultStatus.className = "result-status good";
          } else if (ratio >= 3) {
            statusText.textContent = "متوسط";
            resultMessage.textContent =
              "التباين مناسب للنصوص الكبيرة، لكنه غير كافٍ للنص العادي وفق AA.";

            resultStatus.className = "result-status medium";
          } else {
            statusText.textContent = "ضعيف";
            resultMessage.textContent =
              "التباين منخفض وقد يجعل النص صعب القراءة. اختر ألوانًا أكثر تباينًا.";

            resultStatus.className = "result-status poor";
          }
        }

        function updateForeground(value) {
          const normalized = normalizeHex(value);

          if (normalized) {
            foreground.value = normalized.substring(1);
            foregroundPicker.value = normalized;
            update();
          }
        }

        function updateBackground(value) {
          const normalized = normalizeHex(value);

          if (normalized) {
            background.value = normalized.substring(1);
            backgroundPicker.value = normalized;
            update();
          }
        }

        foregroundPicker.addEventListener("input", function () {
          updateForeground(this.value);
        });

        backgroundPicker.addEventListener("input", function () {
          updateBackground(this.value);
        });

        foreground.addEventListener("input", function () {
          updateForeground(this.value);
        });

        background.addEventListener("input", function () {
          updateBackground(this.value);
        });

        foreground.addEventListener("keydown", function (event) {
          if (event.key === "Enter") {
            update();
          }
        });

        background.addEventListener("keydown", function (event) {
          if (event.key === "Enter") {
            update();
          }
        });

        checkBtn.addEventListener("click", function () {
          update();

          checkBtn.classList.add("clicked");

          setTimeout(function () {
            checkBtn.classList.remove("clicked");
          }, 250);
        });

        swapBtn.addEventListener("click", function () {
          const oldForeground = foreground.value;
          const oldBackground = background.value;

          foreground.value = oldBackground;
          background.value = oldForeground;

          update();
        });

        resetBtn.addEventListener("click", function () {
          foreground.value = defaults.foreground.substring(1);
          background.value = defaults.background.substring(1);

          foregroundPicker.value = defaults.foreground;
          backgroundPicker.value = defaults.background;

          update();
        });

        const copyButtons =
          document.querySelectorAll("[data-copy]");

        copyButtons.forEach(function (button) {
          button.addEventListener("click", async function () {
            const id = button.getAttribute("data-copy");
            const element = document.getElementById(id);

            if (!element) {
              return;
            }

            const text = element.textContent || "";

            try {
              await navigator.clipboard.writeText(text);

              const original =
                button.innerHTML;

              button.innerHTML =
                '<i class="fa-solid fa-check"></i>';

              button.classList.add("copied");

              setTimeout(function () {
                button.innerHTML = original;
                button.classList.remove("copied");
              }, 1200);
            } catch {
              const textarea =
                document.createElement("textarea");

              textarea.value = text;
              document.body.appendChild(textarea);
              textarea.select();

              try {
                document.execCommand("copy");
              } catch {}

              textarea.remove();
            }
          });
        });

        function syncTheme() {
          try {
            const saved =
              localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function (event) {
          const target = event.target;

          if (
            target &&
            (
              target.id === "theme-btn" ||
              target.closest &&
              target.closest("#theme-btn")
            )
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        update();
      })();
    </script>

    <style>
      :root {
        --bg: #f5f8fc;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --text: #111827;
        --muted: #64748b;
        --border: #e2e8f0;
        --primary: #2563eb;
        --primary-2: #0ea5e9;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #f59e0b;
        --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
        --radius: 24px;
      }

      html.dark-mode {
        --bg: #08111f;
        --surface: #0f1b2d;
        --surface-2: #132238;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --border: #24344a;
        --primary: #60a5fa;
        --primary-2: #38bdf8;
        --green: #4ade80;
        --red: #f87171;
        --orange: #fbbf24;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Cairo", sans-serif;
        line-height: 1.8;
      }

      button,
      input {
        font-family: inherit;
      }

      .container {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 42px 0 70px;
        background:
          linear-gradient(
            135deg,
            rgba(37, 99, 235, 0.08),
            rgba(14, 165, 233, 0.04)
          );
        border-bottom: 1px solid var(--border);
      }

      .hero-orb {
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        filter: blur(10px);
        pointer-events: none;
      }

      .hero-orb-one {
        top: -160px;
        right: -80px;
        background: rgba(37, 99, 235, 0.12);
      }

      .hero-orb-two {
        bottom: -200px;
        left: -100px;
        background: rgba(14, 165, 233, 0.1);
      }

      .hero-inner {
        position: relative;
        z-index: 2;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 35px;
        color: var(--muted);
        font-size: 13px;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: 0.6;
      }

      .hero-content {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .hero-icon {
        flex: 0 0 92px;
        width: 92px;
        height: 92px;
        display: grid;
        place-items: center;
        border-radius: 28px;
        color: white;
        font-size: 40px;
        background: linear-gradient(
          135deg,
          #2563eb,
          #06b6d4
        );
        box-shadow:
          0 18px 40px rgba(37, 99, 235, 0.25);
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 999px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
      }

      .hero-text h1 {
        margin: 0;
        font-size: clamp(30px, 5vw, 48px);
        line-height: 1.2;
        letter-spacing: -1px;
      }

      .hero-text p {
        margin: 10px 0 15px;
        color: var(--muted);
        font-size: 16px;
      }

      .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .hero-tags span {
        padding: 4px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--muted);
        background: var(--surface);
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
      }

      /* TOOL */

      .tool-section {
        padding: 55px 0 80px;
      }

      .tool-card {
        padding: 30px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .tool-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
      }

      .section-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .tool-header h2 {
        margin: 5px 0 3px;
        font-size: 24px;
      }

      .tool-header p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border: 1px solid rgba(22, 163, 74, 0.2);
        border-radius: 999px;
        color: var(--green);
        background: rgba(22, 163, 74, 0.07);
        white-space: nowrap;
        font-size: 12px;
        font-weight: 700;
      }

      .live-badge span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.1);
      }

      /* COLORS */

      .color-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }

      .color-box {
        padding: 20px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 20px;
      }

      .color-box-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
      }

      .color-title {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .small-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        font-size: 18px;
      }

      .foreground-icon {
        color: var(--primary);
        background: rgba(37, 99, 235, 0.1);
      }

      .background-icon {
        color: #0891b2;
        background: rgba(8, 145, 178, 0.1);
      }

      .color-title strong,
      .color-title small {
        display: block;
      }

      .color-title strong {
        font-size: 14px;
      }

      .color-title small {
        color: var(--muted);
        font-size: 11px;
        font-family: "JetBrains Mono", monospace;
      }

      .color-picker {
        width: 48px;
        height: 48px;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
        cursor: pointer;
      }

      .hex-input-wrap {
        display: flex;
        align-items: center;
        height: 52px;
        padding: 0 14px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
        direction: ltr;
      }

      .hex-input-wrap span {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-weight: 700;
      }

      .hex-input-wrap input {
        width: 100%;
        border: 0;
        outline: 0;
        color: var(--text);
        background: transparent;
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
        font-weight: 600;
      }

      /* BUTTONS */

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 20px 0 30px;
      }

      .btn {
        min-height: 46px;
        padding: 0 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        color: white;
        background: linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
      }

      .btn-secondary {
        color: var(--primary);
        background: rgba(37, 99, 235, 0.08);
        border-color: rgba(37, 99, 235, 0.15);
      }

      .btn-ghost {
        color: var(--muted);
        background: var(--surface-2);
        border-color: var(--border);
      }

      .btn.clicked {
        transform: scale(0.97);
      }

      /* PREVIEW */

      .preview-section {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface-2);
      }

      .preview-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 16px;
      }

      .preview-head h3 {
        margin: 3px 0 0;
        font-size: 17px;
      }

      .mini-ratio {
        padding: 6px 10px;
        border-radius: 8px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.08);
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        font-weight: 700;
      }

      .preview-box {
        min-height: 230px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px;
        border-radius: 17px;
        transition:
          background 0.2s ease,
          color 0.2s ease;
      }

      .preview-content {
        width: min(650px, 100%);
        text-align: center;
      }

      .preview-large {
        font-size: 34px;
        font-weight: 800;
      }

      .preview-title {
        margin-top: 5px;
        font-size: 24px;
        font-weight: 700;
      }

      .preview-normal {
        margin-top: 10px;
        font-size: 16px;
        font-weight: 500;
      }

      .preview-small {
        margin-top: 8px;
        font-size: 12px;
      }

      /* RESULT */

      .result-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 20px;
        padding: 24px;
        border-radius: 20px;
        background:
          linear-gradient(
            135deg,
            rgba(37, 99, 235, 0.08),
            rgba(14, 165, 233, 0.05)
          );
        border: 1px solid rgba(37, 99, 235, 0.14);
      }

      .result-label {
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
      }

      .ratio-row {
        direction: ltr;
        display: flex;
        align-items: baseline;
        gap: 4px;
      }

      .ratio-row strong {
        font-family: "JetBrains Mono", monospace;
        font-size: 48px;
        line-height: 1.2;
      }

      .ratio-row span {
        color: var(--muted);
        font-family: "JetBrains Mono", monospace;
        font-size: 18px;
        font-weight: 700;
      }

      .result-main p {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .result-status {
        min-width: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        padding: 13px;
        border-radius: 15px;
        color: var(--green);
        background: rgba(22, 163, 74, 0.08);
      }

      .result-status i {
        font-size: 22px;
      }

      .result-status strong {
        font-size: 13px;
      }

      .result-status.good {
        color: var(--green);
        background: rgba(22, 163, 74, 0.08);
      }

      .result-status.medium {
        color: var(--orange);
        background: rgba(245, 158, 11, 0.1);
      }

      .result-status.poor {
        color: var(--red);
        background: rgba(220, 38, 38, 0.08);
      }

      /* WCAG */

      .wcag-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 18px;
      }

      .wcag-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
      }

      .wcag-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        color: var(--green);
        background: rgba(22, 163, 74, 0.1);
      }

      .wcag-card.failed .wcag-icon {
        color: var(--red);
        background: rgba(220, 38, 38, 0.1);
      }

      .wcag-card > div:nth-child(2) {
        flex: 1;
      }

      .wcag-card strong,
      .wcag-card span {
        display: block;
      }

      .wcag-card strong {
        font-size: 12px;
      }

      .wcag-card span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 10px;
      }

      .wcag-card b {
        color: var(--green);
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
      }

      .wcag-card.failed b {
        color: var(--red);
      }

      /* VALUES */

      .values-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 18px;
      }

      .value-card {
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface-2);
      }

      .value-card > span {
        display: block;
        margin-bottom: 7px;
        color: var(--muted);
        font-size: 11px;
      }

      .value-line {
        display: flex;
        align-items: center;
        gap: 10px;
        direction: ltr;
      }

      .value-dot {
        width: 22px;
        height: 22px;
        border: 2px solid var(--border);
        border-radius: 7px;
      }

      .value-line code {
        flex: 1;
        color: var(--text);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        font-weight: 600;
      }

      .copy-btn {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--muted);
        background: var(--surface);
        cursor: pointer;
      }

      .copy-btn:hover,
      .copy-btn.copied {
