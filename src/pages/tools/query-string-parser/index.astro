    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />

    <script>
      (() => {
        const queryInput = document.getElementById('queryInput');
        const parseBtn = document.getElementById('parseBtn');
        const pasteBtn = document.getElementById('pasteBtn');
        const sampleBtn = document.getElementById('sampleBtn');
        const clearBtn = document.getElementById('clearBtn');

        const addBtn = document.getElementById('addBtn');
        const emptyAddBtn = document.getElementById('emptyAddBtn');
        const sortBtn = document.getElementById('sortBtn');

        const paramsList = document.getElementById('paramsList');
        const emptyParams = document.getElementById('emptyParams');

        const paramCount = document.getElementById('paramCount');
        const uniqueCount = document.getElementById('uniqueCount');
        const charCount = document.getElementById('charCount');

        const generatedQuery = document.getElementById('generatedQuery');
        const jsonOutput = document.getElementById('jsonOutput');

        const copyQueryBtn = document.getElementById('copyQueryBtn');
        const copyJsonBtn = document.getElementById('copyJsonBtn');

        const message = document.getElementById('message');

        let rows = [];
        let nextId = 1;
        let parseTimer = null;

        function getThemeState() {
          const html = document.documentElement;
          const stored = localStorage.getItem('theme');

          if (stored === 'light') return 'light';
          if (stored === 'dark') return 'dark';

          if (html.dataset.theme === 'light') return 'light';
          if (html.dataset.theme === 'dark') return 'dark';

          if (html.classList.contains('light')) return 'light';
          if (html.classList.contains('dark')) return 'dark';

          return 'dark';
        }

        function syncTheme() {
          const theme = getThemeState();
          const light = theme === 'light';

          document.body.classList.toggle('query-light', light);
          document.body.classList.toggle('query-dark', !light);
        }

        syncTheme();

        const themeObserver = new MutationObserver(() => syncTheme());

        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme']
        });

        function showMessage(text, type = 'success') {
          message.textContent = text;
          message.className = `message ${type}`;

          clearTimeout(showMessage.timer);

          showMessage.timer = setTimeout(() => {
            message.textContent = '';
            message.className = 'message';
          }, 2500);
        }

        function extractQuery(value) {
          let input = String(value || '').trim();

          if (!input) return '';

          const hashIndex = input.indexOf('#');

          if (hashIndex !== -1) {
            input = input.slice(0, hashIndex);
          }

          const questionIndex = input.indexOf('?');

          if (questionIndex !== -1) {
            return input.slice(questionIndex + 1);
          }

          return input.replace(/^\?/, '');
        }

        function parseQuery() {
          const raw = extractQuery(queryInput.value);

          if (!raw) {
            rows = [];
            renderRows();
            updateOutputs();
            showMessage('أدخل Query String أولاً.', 'error');
            return;
          }

          if (raw.length > 20000) {
            showMessage('حجم Query String كبير جدًا.', 'error');
            return;
          }

          try {
            const params = new URLSearchParams(raw);

            rows = [];

            params.forEach((value, key) => {
              rows.push({
                id: nextId++,
                key,
                value
              });
            });

            renderRows();
            updateOutputs();

            showMessage(
              `تم تحليل ${rows.length} معامل بنجاح.`,
              'success'
            );
          } catch (error) {
            showMessage('تعذر تحليل Query String.', 'error');
          }
        }

        function addRow(key = '', value = '') {
          rows.push({
            id: nextId++,
            key,
            value
          });

          renderRows();
          updateOutputs();

          const lastRow = paramsList.lastElementChild;

          if (lastRow) {
            const input = lastRow.querySelector('.key-input');

            if (input) {
              input.focus();
            }
          }
        }

        function deleteRow(id) {
          rows = rows.filter(row => row.id !== id);

          renderRows();
          updateOutputs();

          showMessage('تم حذف المعامل.', 'success');
        }

        function renderRows() {
          paramsList.innerHTML = '';

          if (!rows.length) {
            paramsList.style.display = 'none';
            emptyParams.style.display = 'flex';
            return;
          }

          paramsList.style.display = 'flex';
          emptyParams.style.display = 'none';

          rows.forEach((row, index) => {
            const rowElement = document.createElement('div');
            rowElement.className = 'param-row';

            const number = document.createElement('div');
            number.className = 'row-number';
            number.textContent = String(index + 1);

            const keyBox = document.createElement('div');
            keyBox.className = 'field-box';

            const keyLabel = document.createElement('label');
            keyLabel.textContent = 'المفتاح';

            const keyInput = document.createElement('input');
            keyInput.type = 'text';
            keyInput.className = 'code-input key-input';
            keyInput.value = row.key;
            keyInput.placeholder = 'name';
            keyInput.spellcheck = false;

            keyInput.addEventListener('input', () => {
              row.key = keyInput.value;
              updateOutputs();
            });

            keyBox.appendChild(keyLabel);
            keyBox.appendChild(keyInput);

            const valueBox = document.createElement('div');
            valueBox.className = 'field-box';

            const valueLabel = document.createElement('label');
            valueLabel.textContent = 'القيمة';

            const valueInput = document.createElement('input');
            valueInput.type = 'text';
            valueInput.className = 'code-input value-input';
            valueInput.value = row.value;
            valueInput.placeholder = 'John';
            valueInput.spellcheck = false;

            valueInput.addEventListener('input', () => {
              row.value = valueInput.value;
              updateOutputs();
            });

            valueBox.appendChild(valueLabel);
            valueBox.appendChild(valueInput);

            const deleteButton = document.createElement('button');
            deleteButton.className = 'delete-btn';
            deleteButton.type = 'button';
            deleteButton.title = 'حذف المعامل';
            deleteButton.innerHTML = '<i class="fa-solid fa-xmark"></i>';

            deleteButton.addEventListener('click', () => {
              deleteRow(row.id);
            });

            rowElement.appendChild(number);
            rowElement.appendChild(keyBox);
            rowElement.appendChild(valueBox);
            rowElement.appendChild(deleteButton);

            paramsList.appendChild(rowElement);
          });
        }

        function buildQuery() {
          const params = new URLSearchParams();

          rows.forEach(row => {
            params.append(row.key, row.value);
          });

          const result = params.toString();

          return result ? `?${result}` : '';
        }

        function buildJSON() {
          if (!rows.length) {
            return '';
          }

          const object = Object.create(null);

          rows.forEach(row => {
            const key = row.key;
            const value = row.value;

            if (Object.prototype.hasOwnProperty.call(object, key)) {
              if (Array.isArray(object[key])) {
                object[key].push(value);
              } else {
                object[key] = [object[key], value];
              }
            } else {
              object[key] = value;
            }
          });

          return JSON.stringify(object, null, 2);
        }

        function updateOutputs() {
          const query = buildQuery();
          const json = buildJSON();

          paramCount.textContent = String(rows.length);

          uniqueCount.textContent = String(
            new Set(rows.map(row => row.key)).size
          );

          charCount.textContent = String(
            rows.reduce(
              (total, row) => total + row.key.length + row.value.length,
              0
            )
          );

          generatedQuery.textContent = query || 'لا توجد بيانات';
          jsonOutput.textContent = json || 'لا توجد بيانات';
        }

        function sortRows() {
          rows.sort((a, b) => {
            return a.key.localeCompare(b.key, undefined, {
              numeric: true,
              sensitivity: 'base'
            });
          });

          renderRows();
          updateOutputs();

          showMessage('تم ترتيب المفاتيح.', 'success');
        }

        async function copyText(text, successText) {
          if (!text) {
            showMessage('لا توجد بيانات لنسخها.', 'error');
            return;
          }

          try {
            await navigator.clipboard.writeText(text);
            showMessage(successText, 'success');
          } catch (error) {
            const area = document.createElement('textarea');

            area.value = text;
            area.style.position = 'fixed';
            area.style.opacity = '0';

            document.body.appendChild(area);

            area.focus();
            area.select();

            try {
              document.execCommand('copy');
              showMessage(successText, 'success');
            } catch {
              showMessage('تعذر نسخ البيانات.', 'error');
            }

            area.remove();
          }
        }

        async function pasteQuery() {
          try {
            const text = await navigator.clipboard.readText();

            if (!text) {
              showMessage('الحافظة فارغة.', 'error');
              return;
            }

            queryInput.value = text;
            parseQuery();
          } catch (error) {
            showMessage(
              'تعذر الوصول إلى الحافظة. الصق النص يدويًا.',
              'error'
            );
          }
        }

        function loadSample() {
          queryInput.value =
            '?name=John&age=25&city=Rabat&language=العربية&tag=javascript&tag=astro';

          parseQuery();
        }

        function clearAll() {
          queryInput.value = '';
          rows = [];

          renderRows();
          updateOutputs();

          showMessage('تم مسح جميع البيانات.', 'success');
        }

        parseBtn.addEventListener('click', parseQuery);

        pasteBtn.addEventListener('click', pasteQuery);

        sampleBtn.addEventListener('click', loadSample);

        clearBtn.addEventListener('click', clearAll);

        addBtn.addEventListener('click', () => addRow());

        emptyAddBtn.addEventListener('click', () => addRow());

        sortBtn.addEventListener('click', sortRows);

        copyQueryBtn.addEventListener('click', () => {
          copyText(
            buildQuery(),
            'تم نسخ Query String بنجاح.'
          );
        });

        copyJsonBtn.addEventListener('click', () => {
          copyText(
            buildJSON(),
            'تم نسخ JSON بنجاح.'
          );
        });

        queryInput.addEventListener('input', () => {
          clearTimeout(parseTimer);

          const value = queryInput.value.trim();

          if (!value) {
            rows = [];
            renderRows();
            updateOutputs();
            return;
          }

          const raw = extractQuery(value);

          if (
            raw.includes('=') ||
            raw.includes('&')
          ) {
            parseTimer = setTimeout(() => {
              try {
                const params = new URLSearchParams(raw);

                rows = [];

                params.forEach((value, key) => {
                  rows.push({
                    id: nextId++,
                    key,
                    value
                  });
                });

                renderRows();
                updateOutputs();
              } catch {
                // يتم التعامل مع الإدخال النهائي عبر زر التحليل.
              }
            }, 450);
          }
        });

        queryInput.addEventListener('keydown', event => {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === 'Enter'
          ) {
            event.preventDefault();
            parseQuery();
          }
        });

        renderRows();
        updateOutputs();
      })();
    </script>

