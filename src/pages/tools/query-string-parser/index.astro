---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://oumaystore-hub.github.io${base}/tools/query-string-parser/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Query String Parser | محلل Query String | Th.Tech</title>

    <meta
      name="description"
      content="أداة احترافية لتحليل Query String واستخراج المعاملات والقيم، تعديلها، حذفها، إنشاء Query String جديد وتحويل البيانات إلى JSON."
    />

    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body class="query-dark">
    <Header />

    <main class="query-page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-icon">
          <i class="fa-solid fa-link"></i>
        </div>

        <span class="badge">
          <i class="fa-solid fa-code"></i>
          أداة المطورين 109
        </span>

        <h1>Query String Parser</h1>

        <p>
          حلّل معاملات URL بسهولة، عدّل القيم وأضف أو احذف المعاملات
          ثم أنشئ Query String جديدًا أو حوّل البيانات إلى JSON.
        </p>
      </section>

      <!-- TOOL -->
      <section class="tool-card">

        <!-- INPUT -->
        <div class="section-title">
          <div class="title-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <div>
            <h2>تحليل Query String</h2>
            <p>أدخل Query String أو رابط URL كامل</p>
          </div>
        </div>

        <div class="input-box">
          <textarea
            id="queryInput"
            maxlength="20000"
            spellcheck="false"
            placeholder="?name=John&age=25&city=Rabat"
          ></textarea>

          <div class="input-actions">
            <button id="parseBtn" class="primary-btn">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              تحليل
            </button>

            <button id="pasteBtn" class="secondary-btn">
              <i class="fa-regular fa-clipboard"></i>
              لصق
            </button>

            <button id="sampleBtn" class="secondary-btn">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="danger-btn">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>
          </div>
        </div>

        <!-- STATS -->
        <div class="stats-grid">

          <div class="stat-card">
            <div class="stat-icon">
              <i class="fa-solid fa-list"></i>
            </div>
            <div>
              <span>المعاملات</span>
              <strong id="paramCount">0</strong>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon">
              <i class="fa-solid fa-layer-group"></i>
            </div>
            <div>
              <span>المفاتيح الفريدة</span>
              <strong id="uniqueCount">0</strong>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon">
              <i class="fa-solid fa-text-width"></i>
            </div>
            <div>
              <span>الأحرف</span>
              <strong id="charCount">0</strong>
            </div>
          </div>

        </div>

        <!-- PARAMETERS -->
        <div class="editor-header">
          <div class="section-title small">
            <div class="title-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>

            <div>
              <h2>المعاملات</h2>
              <p>عدّل المفاتيح والقيم كما تريد</p>
            </div>
          </div>

          <div class="editor-actions">
            <button id="sortBtn" class="secondary-btn">
              <i class="fa-solid fa-arrow-down-a-z"></i>
              ترتيب المفاتيح
            </button>

            <button id="addBtn" class="primary-btn">
              <i class="fa-solid fa-plus"></i>
              إضافة معامل
            </button>
          </div>
        </div>

        <div id="paramsList" class="params-list"></div>

        <div id="emptyParams" class="empty-state">
          <div class="empty-icon">
            <i class="fa-solid fa-table-list"></i>
          </div>

          <h3>لا توجد معاملات</h3>

          <p>
            أدخل Query String ثم اضغط على تحليل،
            أو أضف معاملًا جديدًا يدويًا.
          </p>

          <button id="emptyAddBtn" class="primary-btn">
            <i class="fa-solid fa-plus"></i>
            إضافة معامل
          </button>
        </div>

        <!-- OUTPUTS -->
        <div class="outputs-grid">

          <!-- QUERY OUTPUT -->
          <div class="output-card">

            <div class="output-header">
              <div>
                <span class="output-label">
                  <i class="fa-solid fa-link"></i>
                  Query String الناتج
                </span>
              </div>

              <button id="copyQueryBtn" class="copy-btn">
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>
            </div>

            <pre id="generatedQuery">لا توجد بيانات</pre>
          </div>

          <!-- JSON OUTPUT -->
          <div class="output-card">

            <div class="output-header">
              <div>
                <span class="output-label">
                  <i class="fa-solid fa-brackets-curly"></i>
                  JSON
                </span>
              </div>

              <button id="copyJsonBtn" class="copy-btn">
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>
            </div>

            <pre id="jsonOutput">لا توجد بيانات</pre>
          </div>

        </div>

        <div id="message" class="message"></div>

      </section>

      <!-- FEATURES -->
      <section class="features-section">

        <div class="section-heading">
          <span>المميزات</span>
          <h2>أداة متكاملة للتعامل مع Query String</h2>
        </div>

        <div class="features-grid">

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-magnifying-glass-chart"></i>
            </div>
            <h3>تحليل تلقائي</h3>
            <p>
              استخراج المفاتيح والقيم من Query String أو من رابط URL كامل.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <h3>تعديل مباشر</h3>
            <p>
              عدّل أي مفتاح أو قيمة، وأضف أو احذف المعاملات بسهولة.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-language"></i>
            </div>
            <h3>دعم Unicode</h3>
            <p>
              التعامل مع العربية والمسافات والرموز والإيموجي بشكل صحيح.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-code"></i>
            </div>
            <h3>تحويل إلى JSON</h3>
            <p>
              تحويل المعاملات مباشرة إلى JSON جاهز للاستخدام في البرمجة.
            </p>
          </article>

        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">

        <div class="info-card">
          <div class="info-icon">
            <i class="fa-solid fa-circle-info"></i>
          </div>

          <div>
            <h2>ما هو Query String؟</h2>

            <p>
              Query String هو الجزء الموجود في عنوان URL بعد علامة
              <code>?</code>، ويُستخدم عادةً لتمرير بيانات إلى صفحات الويب
              أو التطبيقات.
            </p>

            <div class="code-example">
              <code>
                ?name=John&amp;age=25&amp;city=Rabat
              </code>
            </div>

            <p>
              في المثال السابق توجد ثلاثة معاملات:
              <strong>name</strong> و<strong>age</strong> و<strong>city</strong>.
            </p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <i class="fa-solid fa-lightbulb"></i>
          </div>

          <div>
            <h2>نصيحة</h2>

            <p>
              يمكن للأداة التعامل مع المفاتيح المتكررة، مثل:
            </p>

            <div class="code-example">
              <code>
                ?tag=javascript&amp;tag=astro&amp;tag=web
              </code>
            </div>

            <p>
              وسيتم الحفاظ على جميع القيم عند إنشاء Query String أو تحويله
              إلى JSON.
            </p>
          </div>
        </div>

      </section>

      <!-- HOW TO -->
      <section class="how-section">

        <div class="section-heading">
          <span>طريقة الاستخدام</span>
          <h2>كيف تستخدم الأداة؟</h2>
        </div>

        <div class="steps">

          <div class="step">
            <span>1</span>
            <div>
              <h3>أدخل البيانات</h3>
              <p>
                الصق Query String أو رابط URL كامل في مربع الإدخال.
              </p>
            </div>
          </div>

          <div class="step">
            <span>2</span>
            <div>
              <h3>حلّل البيانات</h3>
              <p>
                اضغط على زر تحليل لاستخراج جميع المعاملات.
              </p>
            </div>
          </div>

          <div class="step">
            <span>3</span>
            <div>
              <h3>عدّل المعاملات</h3>
              <p>
                غيّر المفاتيح والقيم أو أضف واحذف أي معامل.
              </p>
            </div>
          </div>

          <div class="step">
            <span>4</span>
            <div>
              <h3>انسخ النتيجة</h3>
              <p>
                انسخ Query String الناتج أو نسخة JSON بضغطة واحدة.
              </p>
            </div>
          </div>

        </div>

      </section>

      <!-- FAQ -->
      <section class="faq-section">

        <div class="section-heading">
          <span>FAQ</span>
          <h2>الأسئلة الشائعة</h2>
        </div>

        <details>
          <summary>
            هل يمكن إدخال رابط URL كامل؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. يمكنك إدخال رابط كامل مثل
            https://example.com/page?name=John&amp;age=25
            وستستخرج الأداة الجزء الخاص بـ Query String تلقائيًا.
          </p>
        </details>

        <details>
          <summary>
            هل يتم فك ترميز القيم تلقائيًا؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. تعتمد الأداة على URLSearchParams لفك ترميز القيم،
            بما في ذلك المسافات والعربية والرموز الخاصة.
          </p>
        </details>

        <details>
          <summary>
            هل تدعم الأداة المفاتيح المتكررة؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. يمكن أن يحتوي Query String على أكثر من قيمة للمفتاح نفسه،
            ويتم الحفاظ على جميع هذه القيم.
          </p>
        </details>

        <details>
          <summary>
            هل يتم إرسال البيانات إلى خادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            لا. تتم معالجة البيانات داخل المتصفح مباشرة، ولا تحتاج الأداة
            إلى خادم خارجي لمعالجة Query String.
          </p>
        </details>

      </section>

    



<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
