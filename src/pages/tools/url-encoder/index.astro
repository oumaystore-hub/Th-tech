</main>

  <Footer />

  <script is:inline>
    (() => {
      const input = document.getElementById("inputText");
      const output = document.getElementById("outputText");

      const encodeBtn = document.getElementById("encodeBtn");
      const exampleBtn = document.getElementById("exampleBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      const inputCount = document.getElementById("inputCount");
      const outputCount = document.getElementById("outputCount");

      const inputLines = document.getElementById("inputLines");
      const outputLines = document.getElementById("outputLines");

      const resultBox = document.getElementById("resultBox");
      const resultIcon = document.getElementById("resultIcon");
      const resultTitle = document.getElementById("resultTitle");
      const resultMessage = document.getElementById("resultMessage");

      const statInput = document.getElementById("statInput");
      const statOutput = document.getElementById("statOutput");
      const statIncrease = document.getElementById("statIncrease");
      const statStatus = document.getElementById("statStatus");

      function updateEditor(textarea, counter, lines) {
        const value = textarea.value;
        const count = value.length;

        counter.textContent = `${count.toLocaleString()} حرف`;

        const lineCount = Math.max(1, value.split("\n").length);

        lines.textContent = Array.from(
          { length: lineCount },
          (_, index) => index + 1
        ).join("\n");
      }

      function updateStats(encoded = "") {
        const originalLength = input.value.length;
        const encodedLength = encoded.length;

        statInput.textContent = originalLength.toLocaleString();
        statOutput.textContent = encodedLength.toLocaleString();

        if (originalLength > 0) {
          const increase =
            ((encodedLength - originalLength) / originalLength) * 100;

          statIncrease.textContent =
            `${increase >= 0 ? "+" : ""}${increase.toFixed(1)}%`;
        } else {
          statIncrease.textContent = "0%";
        }
      }

      function setSuccess(message) {
        resultBox.classList.remove("error");
        resultBox.classList.add("success");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent = "تم الترميز بنجاح";
        resultMessage.textContent = message;

        statStatus.textContent = "تم";
      }

      function setError(message) {
        resultBox.classList.remove("success");
        resultBox.classList.add("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-exclamation"></i>';

        resultTitle.textContent = "حدث خطأ";
        resultMessage.textContent = message;

        statStatus.textContent = "خطأ";
      }

      function encodeURL() {
        const value = input.value;

        if (!value.trim()) {
          output.value = "";
          updateEditor(output, outputCount, outputLines);
          updateStats("");

          setError("أدخل نصاً أو رابطاً أولاً.");

          return;
        }

        try {
          const start = performance.now();

          const encoded = encodeURIComponent(value);

          const end = performance.now();

          output.value = encoded;

          updateEditor(output, outputCount, outputLines);
          updateStats(encoded);

          setSuccess(
            `تم ترميز ${value.length.toLocaleString()} حرف بنجاح خلال ${(end - start).toFixed(2)} ms.`
          );
        } catch (error) {
          setError("تعذر ترميز النص.");
        }
      }

      function clearAll() {
        input.value = "";
        output.value = "";

        updateEditor(input, inputCount, inputLines);
        updateEditor(output, outputCount, outputLines);
        updateStats("");

        resultBox.classList.remove("success", "error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-link"></i>';

        resultTitle.textContent = "جاهز للترميز";
        resultMessage.textContent =
          "أدخل النص ثم اضغط على زر ترميز URL.";

        statStatus.textContent = "جاهز";

        input.focus();
      }

      function loadExample() {
        input.value =
          "https://th.tech/search?q=أدوات تقنية مجانية&lang=ar";

        updateEditor(input, inputCount, inputLines);

        encodeURL();
      }

      async function copyResult() {
        if (!output.value) {
          setError("لا توجد نتيجة لنسخها.");

          return;
        }

        try {
          await navigator.clipboard.writeText(output.value);

          const original = copyBtn.innerHTML;

          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';

          setTimeout(() => {
            copyBtn.innerHTML = original;
          }, 1500);
        } catch {
          output.select();
          document.execCommand("copy");

          setSuccess("تم نسخ النتيجة إلى الحافظة.");
        }
      }

      input.addEventListener("input", () => {
        updateEditor(input, inputCount, inputLines);

        if (!input.value) {
          output.value = "";

          updateEditor(output, outputCount, outputLines);
          updateStats("");
        }
      });

      input.addEventListener("scroll", () => {
        inputLines.scrollTop = input.scrollTop;
      });

      output.addEventListener("scroll", () => {
        outputLines.scrollTop = output.scrollTop;
      });

      encodeBtn.addEventListener("click", encodeURL);
      exampleBtn.addEventListener("click", loadExample);
      clearBtn.addEventListener("click", clearAll);
      copyBtn.addEventListener("click", copyResult);

      input.addEventListener("keydown", (event) => {
        if (event.key === "Tab") {
          event.preventDefault();

          const start = input.selectionStart;
          const end = input.selectionEnd;

          input.value =
            input.value.substring(0, start) +
            "  " +
            input.value.substring(end);

          input.selectionStart = input.selectionEnd = start + 2;

          updateEditor(input, inputCount, inputLines);
        }

        if (
          event.ctrlKey &&
          event.key === "Enter"
        ) {
          event.preventDefault();

          encodeURL();
        }
      });

      updateEditor(input, inputCount, inputLines);
      updateEditor(output, outputCount, outputLines);
    })();
  </script>

  <style>
    :root {
      --bg: #f7fafc;
