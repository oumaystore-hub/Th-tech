    }

    h1 {
      margin: 12px 0 8px;
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1.1;
    }

    .hero-text p {
      margin: 0;
      max-width: 700px;

      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }

    .tags {
