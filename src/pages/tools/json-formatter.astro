---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "JSON Formatter - تنسيق وتجميل JSON أونلاين | Th.Tech";

const description =
  "أداة JSON Formatter مجانية لتنسيق وتجميل JSON والتحقق من صحة الأكواد وضغط JSON بسهولة. تعمل مباشرة في المتصفح بدون رفع البيانات.";

const canonical =
  "https://th-tech.github.io/Th-tech/tools/json-formatter/";

const base = import.meta.env.BASE_URL;
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow, max-image-preview:large"
  />

  <link rel="canonical" href={canonical} />

  <link
    rel="icon"
    type="image/png"
    href={`${base}logo1.png`}
  />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Th.Tech" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "JSON Formatter",
    "url": canonical,
    "description": description,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

</head>


<body>

<Header />


<main>

<section class="tool-hero">

  <div class="container">

    <a
      class="back"
      href={`${base}tools/`}
    >
      <i class="fa-solid fa-arrow-right"></i>
      جميع الأدوات
    </a>

    <span class="badge">
      <i class="fa-solid fa-code"></i>
      Developer Tool
    </span>

    <h1>
      JSON Formatter
    </h1>

    <p>
      نسّق وجمّل JSON بسهولة، تحقق من صحة الكود،
      واضغط البيانات مباشرة داخل المتصفح.
    </p>

  </div>

</section>


<section class="formatter-section">

<div class="container">

<div class="tool-panel">

  <div class="toolbar">

    <div class="toolbar-title">
      <i class="fa-solid fa-file-code"></i>
      JSON Input
    </div>

    <div class="buttons">

      <button id="sampleBtn">
        مثال
      </button>

      <button id="formatBtn" class="primary">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        Format
      </button>

      <button id="minifyBtn">
        Minify
      </button>

      <button id="clearBtn">
        مسح
      </button>

    </div>

  </div>


  <textarea
    id="jsonInput"
    spellcheck="false"
    placeholder='ضع JSON هنا...'
    aria-label="JSON input"
  ></textarea>


  <div id="status" class="status">
    جاهز
  </div>

</div>


<div class="result-panel">

  <div class="result-title">

    <span>
      <i class="fa-solid fa-check"></i>
      النتيجة
    </span>

    <button id="copyBtn">
      <i class="fa-regular fa-copy"></i>
      نسخ
    </button>

  </div>

  <pre id="output">ستظهر النتيجة هنا...</pre>

</div>

</div>

</section>


<section class="content-section">

<div class="container content">

<h2>
  ما هو JSON Formatter؟
</h2>

<p>
  JSON Formatter هي أداة مجانية تساعد المطورين على
  تنسيق ملفات JSON وتحويل البيانات غير المنظمة إلى
  بنية واضحة وسهلة القراءة.
</p>

<p>
  يمكنك استخدام الأداة لتجميل JSON أو ضغطه قبل استخدامه
  في API أو تطبيقات الويب والبرامج المختلفة.
</p>


<h2>
  كيف تستخدم JSON Formatter؟
</h2>

<ol>
  <li>ضع كود JSON في مربع الإدخال.</li>
  <li>اضغط على Format لتنسيق الكود.</li>
  <li>استخدم Minify للحصول على JSON مضغوط.</li>
  <li>اضغط نسخ لاستخدام النتيجة في مشروعك.</li>
</ol>


<h2>
  هل بيانات JSON آمنة؟
</h2>

<p>
  تعمل عملية التنسيق داخل متصفحك باستخدام JavaScript،
  ولا تحتاج الأداة إلى إرسال JSON إلى خادم لمعالجته.
  لذلك لا تحتاج إلى رفع ملفاتك إلى الموقع.
</p>


<h2>
  لماذا تستخدم JSON Formatter؟
</h2>

<ul>
  <li>مجانية بالكامل.</li>
  <li>لا تحتاج إلى تسجيل حساب.</li>
  <li>تعمل على الهاتف والكمبيوتر.</li>
  <li>تنسيق JSON بسرعة.</li>
  <li>ضغط JSON باستخدام Minify.</li>
  <li>التحقق من صحة JSON.</li>
</ul>

</div>

</section>

</main>


<Footer />


<script>

const input = document.getElementById('jsonInput');
const output = document.getElementById('output');
const status = document.getElementById('status');

const sample = {
  name: "Th.Tech",
  website: "https://th-tech.github.io/Th-tech/",
  tools: [
    "JSON Formatter",
    "JSON Validator"
  ],
  free: true
};


function formatJSON() {

  const value = input.value.trim();

  if (!value) {

    status.textContent = "أدخل JSON أولاً";
    status.className = "status error";

    return;
  }

  try {

    const parsed = JSON.parse(value);

    output.textContent =
      JSON.stringify(parsed, null, 2);

    status.textContent =
      "✓ JSON صالح وتم تنسيقه بنجاح";

    status.className = "status success";

  } catch (error) {

    output.textContent = "";

    status.textContent =
      "✕ JSON غير صالح: " + error.message;

    status.className = "status error";
  }
}


function minifyJSON() {

  const value = input.value.trim();

  if (!value) {

    status.textContent = "أدخل JSON أولاً";
    status.className = "status error";

    return;
  }

  try {

    const parsed = JSON.parse(value);

    output.textContent =
      JSON.stringify(parsed);

    status.textContent =
      "✓ تم ضغط JSON بنجاح";

    status.className = "status success";

  } catch (error) {

    output.textContent = "";

    status.textContent =
      "✕ JSON غير صالح: " + error.message;

    status.className = "status error";
  }
}


document
  .getElementById('formatBtn')
  .addEventListener('click', formatJSON);


document
  .getElementById('minifyBtn')
  .addEventListener('click', minifyJSON);


document
  .getElementById('clearBtn')
  .addEventListener('click', () => {

    input.value = "";
    output.textContent = "ستظهر النتيجة هنا...";
    status.textContent = "جاهز";
    status.className = "status";

  });


document
  .getElementById('sampleBtn')
  .addEventListener('click', () => {

    input.value =
      JSON.stringify(sample, null, 2);

    formatJSON();

  });


document
  .getElementById('copyBtn')
  .addEventListener('click', async () => {

    const text = output.textContent;

    if (!text || text === "ستظهر النتيجة هنا...") {
      return;
    }

    try {

      await navigator.clipboard.writeText(text);

      status.textContent =
        "✓ تم نسخ النتيجة";

      status.className = "status success";

    } catch {

      status.textContent =
        "تعذر النسخ تلقائياً";

      status.className = "status error";
    }

  });

</script>

</body>

</html>


<style>

:root {
  --bg: #f8fafc;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --primary: #2563eb;
  --border: #e2e8f0;
}

html.dark-mode {
  --bg: #080f1d;
  --card: #111c2e;
  --text: #f8fafc;
  --muted: #94a3b8;
  --primary: #60a5fa;
  --border: #26364d;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'Cairo', sans-serif;
}

.container {
  width: min(1050px, calc(100% - 30px));
  margin: auto;
}


/* HERO */

.tool-hero {
  text-align: center;
  padding: 45px 0 30px;
}

.back {
  display: inline-flex;
  gap: 8px;
  color: var(--primary);
  text-decoration: none;
  font-size: .85rem;
  margin-bottom: 20px;
}

.badge {
  display: block;
  width: fit-content;
  margin: auto;
  color: var(--primary);
  font-size: .75rem;
  font-weight: 700;
}

.tool-hero h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  margin: 10px 0;
}

.tool-hero p {
  color: var(--muted);
  max-width: 650px;
  margin: auto;
}


/* TOOL */

.formatter-section {
  padding: 20px 0 55px;
}

.tool-panel,
.result-panel {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  margin-bottom: 20px;
}

.toolbar,
.result-title {
  min-height: 62px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 12px 18px;
  border-bottom: 1px solid var(--border);
}

.toolbar-title,
.result-title span {
  font-weight: 700;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

button {
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text);
  border-radius: 9px;
  padding: 8px 13px;
  font-family: inherit;
  cursor: pointer;
}

button.primary {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

textarea {
  width: 100%;
  min-height: 360px;
  border: 0;
  outline: none;
  resize: vertical;
  padding: 20px;
  background: var(--card);
  color: var(--text);
  font-family: monospace;
  font-size: 14px;
  direction: ltr;
  text-align: left;
}

.status {
  padding: 10px 18px;
  color: var(--muted);
  font-size: .82rem;
  border-top: 1px solid var(--border);
}

.status.success {
  color: #059669;
}

.status.error {
  color: #dc2626;
}

#output {
  min-height: 200px;
  margin: 0;
  padding: 20px;
  overflow: auto;
  direction: ltr;
  text-align: left;
  font-family: monospace;
  font-size: 14px;
  white-space: pre-wrap;
}


/* CONTENT */

.content-section {
  padding: 50px 0 80px;
}

.content {
  max-width: 850px;
}

.content h2 {
  font-size: 1.45rem;
  margin: 35px 0 12px;
}

.content h2:first-child {
  margin-top: 0;
}

.content p,
.content li {
  color: var(--muted);
  line-height: 1.9;
}

.content ol,
.content ul {
  padding-right: 25px;
}


/* MOBILE */

@media (max-width: 650px) {

  .toolbar,
  .result-title {
    align-items: flex-start;
    flex-direction: column;
  }

  .buttons {
    width: 100%;
  }

  button {
    flex: 1;
  }

  textarea {
    min-height: 300px;
  }

}

</style>
