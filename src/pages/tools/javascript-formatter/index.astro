---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Formatter - تنسيق JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "أداة JavaScript Formatter مجانية لتنسيق وترتيب كود JavaScript وتحسين قراءته مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JavaScript Formatter؟",
    a: "أداة مجانية تساعدك على ترتيب وتنسيق كود JavaScript وجعله أسهل في القراءة والمراجعة."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا، تتم معالجة الكود مباشرة داخل المتصفح."
  },
  {
    q: "هل يمكنني نسخ الكود بعد تنسيقه؟",
    a: "نعم، يمكنك نسخ الكود المنسق بضغطة واحدة أو تنزيله كملف JavaScript."
  },
  {
    q: "هل تعمل الأداة على الهاتف؟",
    a: "نعم، الواجهة متجاوبة وتعمل على الهاتف والكمبيوتر والأجهزة اللوحية."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme');

          if (theme === 'dark') {
            document.documentElement.classList.add('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>

    <Header />

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <a href={`${base}/tools/`}>الأدوات</a>
            <span>/</span>
            <span>JavaScript Formatter</span>
          </div>

          <div class="tool-icon">
            <i class="fa-brands fa-js"></i>
          </div>

          <div class="eyebrow">
            <i class="fa-solid fa-code"></i>
            JavaScript
          </div>

          <h1>
            JavaScript <span>Formatter</span>
          </h1>

          <p>
            نسّق كود JavaScript ورتّبه تلقائياً واجعله أكثر وضوحاً
            وسهولة في القراءة.
          </p>

        </div>
      </section>


      <!-- FORMATTER -->
      <section class="formatter-section">
        <div class="container">

          <div class="formatter-card">

            <!-- TOP BAR -->
            <div class="topbar">

              <div class="tool-name">
                <div class="mini-icon">
                  <i class="fa-brands fa-js"></i>
                </div>

                <div>
                  <strong>JavaScript Formatter</strong>
                  <small>تنسيق كود JavaScript</small>
                </div>
              </div>

              <div class="local-badge">
                <span></span>
                يعمل محلياً
              </div>

            </div>


            <!-- ACTIONS -->
            <div class="actions">

              <button id="formatBtn" class="btn btn-primary">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                تنسيق
              </button>

              <button id="copyBtn" class="btn">
                <i class="fa-regular fa-copy"></i>
                نسخ
              </button>

              <button id="downloadBtn" class="btn">
                <i class="fa-solid fa-download"></i>
                تنزيل
              </button>

              <button id="clearBtn" class="btn btn-clear">
                <i class="fa-solid fa-rotate-left"></i>
                مسح
              </button>

            </div>


            <!-- WORKSPACE -->
            <div class="workspace">

              <!-- INPUT -->
              <div class="editor-box">

                <div class="editor-header">

                  <div class="editor-title">
                    <span class="indicator input-indicator"></span>
                    <strong>الكود الأصلي</strong>
                  </div>

                  <div class="editor-info">
                    <span id="inputLines">0 سطر</span>
                    <span>•</span>
                    <span id="inputBytes">0 B</span>
                  </div>

                </div>

                <div class="editor-body">

                  <div class="line-numbers" id="inputNumbers">1</div>

                  <textarea
                    id="inputCode"
                    spellcheck="false"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder={`function hello(name){
console.log("Hello " + name);
}

const user={name:"Ahmed",age:25};`}
                  ></textarea>

                </div>

              </div>


              <!-- OUTPUT -->
              <div class="editor-box output-box">

                <div class="editor-header">

                  <div class="editor-title">
                    <span class="indicator output-indicator"></span>
                    <strong>الكود المنسق</strong>
                  </div>

                  <div class="editor-info">
                    <span id="outputLines">0 سطر</span>
                    <span>•</span>
                    <span id="outputBytes">0 B</span>
                  </div>

                </div>

                <div class="editor-body">

                  <div class="line-numbers output-numbers" id="outputNumbers">
                    1
                  </div>

                  <textarea
                    id="outputCode"
                    spellcheck="false"
                    readonly
                    placeholder="سيظهر الكود المنسق هنا..."
                  ></textarea>

                </div>

              </div>

            </div>


            <!-- STATUS -->
            <div id="status" class="status hidden">
              <i></i>
              <span></span>
            </div>


            <!-- BOTTOM INFO -->
            <div class="bottom-bar">

              <div class="privacy">
                <i class="fa-solid fa-shield-halved"></i>

                <span>
                  تتم معالجة الكود داخل المتصفح
                </span>
              </div>

              <div class="characters">
                <span>
                  <strong id="charCount">0</strong>
                  حرف
                </span>

                <span>
                  <strong id="outputCharCount">0</strong>
                  بعد التنسيق
                </span>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FEATURES -->
      <section class="features-section">
        <div class="container">

          <div class="section-title">
            <span>المميزات</span>
            <h2>JavaScript Formatter سريع وبسيط</h2>
            <p>
              كل ما تحتاجه لترتيب كود JavaScript بدون تعقيد.
            </p>
          </div>


          <div class="features-grid">

            <div class="feature">
              <div class="feature-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <h3>سريع</h3>
                <p>
                  تنسيق الكود مباشرة من المتصفح.
                </p>
              </div>
            </div>


            <div class="feature">
              <div class="feature-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <div>
                <h3>خصوصية</h3>
                <p>
                  لا تحتاج إلى رفع الكود إلى خادم.
                </p>
              </div>
            </div>


            <div class="feature">
              <div class="feature-icon">
                <i class="fa-regular fa-copy"></i>
              </div>

              <div>
                <h3>نسخ سريع</h3>
                <p>
                  انسخ النتيجة بضغطة واحدة.
                </p>
              </div>
            </div>


            <div class="feature">
              <div class="feature-icon">
                <i class="fa-solid fa-mobile-screen"></i>
              </div>

              <div>
                <h3>متجاوبة</h3>
                <p>
                  تعمل على الهاتف والكمبيوتر.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>


      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-title">
            <span>طريقة الاستخدام</span>
            <h2>كيف تستخدم الأداة؟</h2>
          </div>


          <div class="steps">

            <div class="step">
              <b>01</b>
              <div>
                <h3>أدخل الكود</h3>
                <p>
                  الصق كود JavaScript في المحرر الأول.
                </p>
              </div>
            </div>

            <div class="step">
              <b>02</b>
              <div>
                <h3>اضغط تنسيق</h3>
                <p>
                  اضغط على زر تنسيق لترتيب الكود.
                </p>
              </div>
            </div>

            <div class="step">
              <b>03</b>
              <div>
                <h3>راجع النتيجة</h3>
                <p>
                  ستظهر النسخة المنسقة في المحرر الثاني.
                </p>
              </div>
            </div>

            <div class="step">
              <b>04</b>
              <div>
                <h3>انسخ أو نزّل</h3>
                <p>
                  انسخ الكود أو نزّله كملف JS.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>


      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-title">
            <span>FAQ</span>
            <h2>الأسئلة الشائعة</h2>
          </div>


          <div class="faq-list">

            {
              faqs.map((faq) => (
                <details class="faq-item">
                  <summary>
                    <span>{faq.q}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <p>{faq.a}</p>
                </details>
              ))
            }

          </div>

        </div>
      </section>

    

<!-- TH-RELATED-TOOLS-START -->
<section
  class="related-tools"
  aria-labelledby="related-tools-title"
>
  <div class="related-tools-header">
    <div>
      <span class="related-tools-label">
        استكشف المزيد
      </span>

      <h2 id="related-tools-title">
        أدوات ذات صلة
      </h2>

      <p>
        أدوات أخرى قد تساعدك في إكمال مهمتك.
      </p>
    </div>
  </div>

  <div class="related-tools-grid">
    
        <a
          class="related-tool-card"
          href={`${base}/tools/json-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Json Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/code-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Code Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/css-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Css Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/date-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Date Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/html-formatter/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Html Formatter</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
        <a
          class="related-tool-card"
          href={`${base}/tools/javascript-minifier/`}
        >
          <span class="related-tool-icon">⚡</span>

          <span class="related-tool-content">
            <strong>Javascript Minifier</strong>
            <small>أداة مرتبطة</small>
          </span>
        </a>
  </div>
</section>

<style>
  .related-tools {
    width: min(1100px, 100%);
    margin: 50px auto 30px;
    padding: 28px;
    border-radius: 20px;
    background: var(--card-bg, #111827);
    border: 1px solid var(
      --border-color,
      rgba(255, 255, 255, 0.08)
    );
  }

  .related-tools-header {
    margin-bottom: 22px;
  }

  .related-tools-label {
    display: inline-block;
    margin-bottom: 7px;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .related-tools h2 {
    margin: 0 0 8px;
    font-size: 1.55rem;
  }

  .related-tools p {
    margin: 0;
    opacity: 0.72;
    font-size: 0.95rem;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-tool-card:hover {
    transform: translateY(-3px);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .related-tool-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    font-size: 1.1rem;
  }

  .related-tool-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .related-tool-content strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-tool-content small {
    opacity: 0.55;
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .related-tools {
      padding: 20px;
      margin-top: 35px;
    }

    .related-tools-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-tools-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .related-tools {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  [data-theme="light"] .related-tool-card {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .related-tool-card:hover {
    background: #f0f9ff;
  }
</style>
<!-- TH-RELATED-TOOLS-END -->

</main>

    <Footer />


    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      :global(:root) {
        --bg: #f8fafc;
        --section: #f1f5f9;
        --card: #ffffff;
        --editor: #f8fafc;
        --text: #0f172a;
        --muted: #64748b;
        --border: rgba(15, 23, 42, .09);
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --cyan: #0891b2;
        --green: #16a34a;
        --red: #dc2626;
        --shadow: 0 18px 55px rgba(15, 23, 42, .08);
      }

      :global(html.dark-mode) {
        --bg: #07101f;
        --section: #0b1426;
        --card: #111d32;
        --editor: #0d1729;
        --text: #f8fafc;
        --muted: #94a3b8;
        --border: rgba(148, 163, 184, .12);
        --primary: #3b82f6;
        --primary-hover: #2563eb;
        --cyan: #06b6d4;
        --green: #22c55e;
        --red: #ef4444;
        --shadow: 0 20px 65px rgba(0, 0, 0, .3);
      }

      .container {
        width: min(1120px, calc(100% - 28px));
        margin-inline: auto;
      }


      /* HERO */

      .hero {
        padding: 38px 0 30px;
        text-align: center;
      }

      .breadcrumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
        color: var(--muted);
        font-size: 11px;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
      }

      .tool-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: rgba(37, 99, 235, .09);
        color: var(--primary);
        font-size: 28px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--cyan);
        font-size: 11px;
        font-weight: 700;
      }

      .hero h1 {
        margin: 5px 0 7px;
        font-size: clamp(30px, 5vw, 46px);
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -.8px;
      }

      .hero h1 span {
        color: var(--primary);
      }

      .hero p {
        max-width: 650px;
        margin: auto;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
      }


      /* FORMATTER */

      .formatter-section {
        padding: 5px 0 65px;
      }

      .formatter-card {
        overflow: hidden;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: var(--shadow);
      }


      /* TOP */

      .topbar {
        min-height: 65px;
        padding: 12px 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid var(--border);
      }

      .tool-name {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .mini-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: rgba(37, 99, 235, .09);
        color: var(--primary);
        font-size: 19px;
      }

      .tool-name strong {
        display: block;
        font-size: 13px;
      }

      .tool-name small {
        display: block;
        margin-top: 1px;
        color: var(--muted);
        font-size: 9px;
      }

      .local-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--green);
        font-size: 10px;
        font-weight: 700;
      }

      .local-badge span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 4px rgba(22, 163, 74, .1);
      }


      /* ACTIONS */

      .actions {
        padding: 10px 13px;
        display: flex;
        align-items: center;
        gap: 7px;
        border-bottom: 1px solid var(--border);
        background: var(--section);
      }

      .btn {
        height: 36px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: var(--card);
        color: var(--text);
        font-family: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
      }

      .btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-1px);
      }

      .btn-primary {
        padding-inline: 17px;
        background: var(--primary);
        border-color: var(--primary);
        color: white;
        box-shadow: 0 5px 15px rgba(37, 99, 235, .18);
      }

      .btn-primary:hover {
        background: var(--primary-hover);
        color: white;
      }

      .btn-clear {
        color: var(--red);
      }


      /* WORKSPACE */

      .workspace {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--border);
      }

      .editor-box {
        min-width: 0;
        background: var(--card);
      }

      .editor-header {
        height: 45px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 1px solid var(--border);
      }

      .editor-title {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .editor-title strong {
        font-size: 11px;
      }

      .indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
      }

      .input-indicator {
        background: var(--cyan);
        box-shadow: 0 0 0 4px rgba(8, 145, 178, .1);
      }

      .output-indicator {
        background: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .1);
      }

      .editor-info {
        display: flex;
        gap: 5px;
        color: var(--muted);
        font-size: 9px;
      }

      .editor-body {
        display: flex;
        height: 390px;
        overflow: hidden;
        background: var(--editor);
      }

      .output-box .editor-body {
        background: var(--card);
      }

      .line-numbers {
        width: 43px;
        flex-shrink: 0;
        padding: 17px 8px;
        overflow: hidden;
        color: var(--muted);
        opacity: .5;
        border-left: 1px solid var(--border);
        font: 12px/1.8 Consolas, Monaco, monospace;
        text-align: center;
        user-select: none;
      }

      textarea {
        width: calc(100% - 43px);
        height: 100%;
        padding: 17px 14px;
        border: 0;
        outline: none;
        resize: none;
        background: transparent;
        color: var(--text);
        font: 12px/1.8 Consolas, Monaco, "Courier New", monospace;
        direction: ltr;
        text-align: left;
        tab-size: 2;
        white-space: pre;
        overflow: auto;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: .55;
      }


      /* STATUS */

      .status {
        margin: 12px 13px 0;
        padding: 9px 12px;
        display: flex;
        align-items: center;
        gap: 7px;
        border-radius: 9px;
        background: rgba(22, 163, 74, .08);
        color: var(--green);
        font-size: 10px;
        font-weight: 700;
      }

      .status.error {
        color: var(--red);
        background: rgba(220, 38, 38, .08);
      }

      .status.hidden {
        display: none;
      }


      /* BOTTOM */

      .bottom-bar {
        min-height: 51px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-top: 1px solid var(--border);
      }

      .privacy {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        font-size: 9px;
      }

      .privacy i {
        color: var(--green);
      }

      .characters {
        display: flex;
        align-items: center;
        gap: 16px;
        color: var(--muted);
        font-size: 9px;
      }

      .characters strong {
        color: var(--text);
        font-size: 11px;
      }


      /* SECTIONS */

      .features-section {
        padding: 65px 0;
        background: var(--section);
      }

      .how-section,
      .faq-section {
        padding: 65px 0;
      }

      .section-title {
        margin-bottom: 30px;
        text-align: center;
      }

      .section-title > span {
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
      }

      .section-title h2 {
        margin: 5px 0 6px;
        font-size: clamp(23px, 4vw, 31px);
        font-weight: 800;
      }

      .section-title p {
        margin: auto;
        color: var(--muted);
        font-size: 12px;
      }


      /* FEATURES */

      .features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
      }

      .feature {
        padding: 19px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        transition: .2s ease;
      }

      .feature:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow);
      }

      .feature-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(37, 99, 235, .09);
        color: var(--primary);
      }

      .feature h3 {
        margin: 0 0 3px;
        font-size: 13px;
      }

      .feature p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.7;
      }


      /* STEPS */

      .steps {
        max-width: 820px;
        margin: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .step {
        padding: 18px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--card);
      }

      .step > b {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(37, 99, 235, .09);
        color: var(--primary);
        font-size: 9px;
      }

      .step h3 {
        margin: 0 0 3px;
        font-size: 13px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.7;
      }


      /* FAQ */

      .faq-list {
        max-width: 820px;
        margin: auto;
        display: grid;
        gap: 8px;
      }

      .faq-item {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--card);
      }

      .faq-item summary {
        padding: 15px 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        cursor: pointer;
        list-style: none;
        font-size: 12px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--primary);
        font-size: 9px;
        transition: .2s;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
      }

      .faq-item p {
        margin: 0;
        padding: 0 17px 16px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }


      /* TABLET */

      @media (max-width: 900px) {

        .features-grid {
          grid-template-columns: repeat(2, 1fr);
        }

      }


      /* MOBILE */

      @media (max-width: 700px) {

        .workspace {
          grid-template-columns: 1fr;
        }

        .editor-body {
          height: 300px;
        }

        .steps {
          grid-template-columns: 1fr;
        }

        .local-badge {
          display: none;
        }

      }


      @media (max-width: 520px) {

        .container {
          width: calc(100% - 18px);
        }

        .hero {
          padding: 28px 0 24px;
        }

        .hero h1 {
          font-size: 31px;
        }

        .hero p {
          font-size: 11px;
        }

        .formatter-card {
          border-radius: 16px;
        }

        .topbar {
          padding: 11px;
        }

        .mini-icon {
          width: 34px;
          height: 34px;
        }

        .tool-name strong {
          font-size: 11px;
        }

        .actions {
          display: grid;
          grid-template-columns: 1.3fr 1fr 1fr 1fr;
          gap: 5px;
          padding: 8px;
        }

        .btn {
          padding: 0 5px;
          height: 34px;
          font-size: 9px;
          gap: 4px;
        }

        .editor-header {
          padding: 0 10px;
        }

        .editor-title strong {
          font-size: 10px;
        }

        .editor-info {
          font-size: 8px;
        }

        .editor-body {
          height: 270px;
        }

        .line-numbers {
          width: 34px;
          padding-inline: 4px;
          font-size: 10px;
        }

        textarea {
          width: calc(100% - 34px);
          padding: 14px 10px;
          font-size: 11px;
        }

        .bottom-bar {
          padding: 9px 11px;
        }

        .privacy {
          font-size: 8px;
        }

        .characters {
          gap: 9px;
          font-size: 8px;
        }

        .features-grid {
          grid-template-columns: 1fr 1fr;
          gap: 8px;
        }

        .feature {
          padding: 13px;
          gap: 8px;
          flex-direction: column;
        }

        .feature-icon {
          width: 34px;
          height: 34px;
        }

      }


      @media (max-width: 360px) {

        .features-grid {
          grid-template-columns: 1fr;
        }

        .actions .btn {
          font-size: 0;
        }

        .actions .btn i {
          font-size: 12px;
        }

      }
    </style>


    <script is:inline>
      (() => {

        const input = document.getElementById("inputCode");
        const output = document.getElementById("outputCode");

        const formatBtn = document.getElementById("formatBtn");
        const copyBtn = document.getElementById("copyBtn");
        const downloadBtn = document.getElementById("downloadBtn");
        const clearBtn = document.getElementById("clearBtn");

        const status = document.getElementById("status");

        const inputLines = document.getElementById("inputLines");
        const outputLines = document.getElementById("outputLines");

        const inputBytes = document.getElementById("inputBytes");
        const outputBytes = document.getElementById("outputBytes");

        const charCount = document.getElementById("charCount");
        const outputCharCount =
          document.getElementById("outputCharCount");

        const inputNumbers =
          document.getElementById("inputNumbers");

        const outputNumbers =
          document.getElementById("outputNumbers");


        function getLines(text) {
          if (!text) return 0;
          return text.split(/\r\n|\r|\n/).length;
        }


        function getBytes(text) {
          return new Blob([text]).size;
        }


        function formatBytes(bytes) {

          if (bytes === 0) return "0 B";

          const units = ["B", "KB", "MB", "GB"];

          const index = Math.floor(
            Math.log(bytes) / Math.log(1024)
          );

          return (
            (bytes / Math.pow(1024, index))
              .toFixed(index === 0 ? 0 : 1)
            + " " +
            units[index]
          );
        }


        function updateNumbers(element, count) {

          let html = "";

          const safeCount = Math.max(1, count);

          for (let i = 1; i <= safeCount; i++) {
            html += i + "<br>";
          }

          element.innerHTML = html;
        }


        function updateStats() {

          const original = input.value;
          const formatted = output.value;

          const inLines = getLines(original);
          const outLines = getLines(formatted);

          inputLines.textContent =
            `${inLines} ${inLines === 1 ? "سطر" : "أسطر"}`;

          outputLines.textContent =
            `${outLines} ${outLines === 1 ? "سطر" : "أسطر"}`;

          inputBytes.textContent =
            formatBytes(getBytes(original));

          outputBytes.textContent =
            formatBytes(getBytes(formatted));

          charCount.textContent =
            original.length.toLocaleString();

          outputCharCount.textContent =
            formatted.length.toLocaleString();

          updateNumbers(inputNumbers, inLines);
          updateNumbers(outputNumbers, outLines);
        }


        function showStatus(message, error = false) {

          status.classList.remove("hidden", "error");

          status.classList.toggle("error", error);

          const icon = status.querySelector("i");
          const text = status.querySelector("span");

          icon.className = error
            ? "fa-solid fa-circle-exclamation"
            : "fa-solid fa-circle-check";

          text.textContent = message;

          clearTimeout(window.__thFormatterStatus);

          window.__thFormatterStatus =
            setTimeout(() => {
              status.classList.add("hidden");
            }, 3000);
        }


        function formatJavaScript(source) {

          const code = source
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .trim();

          if (!code) return "";

          let result = "";
          let buffer = "";

          let indent = 0;

          let quote = null;
          let template = false;

          let lineComment = false;
          let blockComment = false;

          let parenDepth = 0;
          let bracketDepth = 0;

          let previous = "";


          const indentText = () =>
            "  ".repeat(Math.max(0, indent));


          const flush = () => {

            const value = buffer.trim();

            if (!value) {
              buffer = "";
              return;
            }

            result += indentText() + value;

            buffer = "";
          };


          const newLine = () => {

            result = result.replace(/[ \t]+$/g, "");

            if (!result.endsWith("\n")) {
              result += "\n";
            }
          };


          const isEscaped = (text, index) => {

            let slashes = 0;

            for (
              let i = index - 1;
              i >= 0 && text[i] === "\\";
              i--
            ) {
              slashes++;
            }

            return slashes % 2 === 1;
          };


          for (let i = 0; i < code.length; i++) {

            const ch = code[i];
            const next = code[i + 1];


            /* Line comment */

            if (lineComment) {

              buffer += ch;

              if (ch === "\n") {
                flush();
                newLine();
                lineComment = false;
              }

              continue;
            }


            /* Block comment */

            if (blockComment) {

              buffer += ch;

              if (ch === "*" && next === "/") {

                buffer += "/";
                i++;

                flush();
                newLine();

                blockComment = false;
              }

              continue;
            }


            /* String */

            if (quote) {

              buffer += ch;

              if (
                ch === quote &&
                !isEscaped(code, i)
              ) {
                quote = null;
              }

              continue;
            }


            /* Template */

            if (template) {

              buffer += ch;

              if (
                ch === "`" &&
                !isEscaped(code, i)
              ) {
                template = false;
              }

              continue;
            }


            /* Comments */

            if (ch === "/" && next === "/") {

              if (buffer.trim()) {
                flush();
                newLine();
              }

              buffer = "//";
              i++;

              lineComment = true;

              continue;
            }


            if (ch === "/" && next === "*") {

              if (buffer.trim()) {
                flush();
                newLine();
              }

              buffer = "/*";
              i++;

              blockComment = true;

              continue;
            }


            /* Quotes */

            if (
              ch === "'" ||
              ch === '"'
            ) {
              quote = ch;
              buffer += ch;
              continue;
            }


            if (ch === "`") {
              template = true;
              buffer += ch;
              continue;
            }


            /* Parentheses */

            if (ch === "(") {

              parenDepth++;
              buffer += ch;

              continue;
            }


            if (ch === ")") {

              parenDepth =
                Math.max(0, parenDepth - 1);

              buffer =
                buffer.trimEnd() + ")";

              continue;
            }


            /* Brackets */

            if (ch === "[") {

              bracketDepth++;
              buffer += ch;

              continue;
            }


            if (ch === "]") {

              bracketDepth =
                Math.max(0, bracketDepth - 1);

              buffer =
                buffer.trimEnd() + "]";

              continue;
            }


            /* Opening brace */

            if (ch === "{") {

              buffer = buffer.trimEnd();

              if (buffer) {
                buffer += " ";
                flush();
              } else {
                result += indentText();
              }

              result += "{";
              newLine();

              indent++;

              continue;
            }


            /* Closing brace */

            if (ch === "}") {

              if (buffer.trim()) {
                flush();
                newLine();
              }

              indent =
                Math.max(0, indent - 1);

              result += indentText();
              result += "}";

              if (
                next !== ";" &&
                next !== "," &&
                next !== ")" &&
                next !== "]" &&
                next !== "."
              ) {
                newLine();
              }

              continue;
            }


            /* Semicolon */

            if (
              ch === ";" &&
              parenDepth === 0 &&
              bracketDepth === 0
            ) {

              buffer = buffer.trimEnd() + ";";

              flush();
              newLine();

              continue;
            }


            /* Comma */

            if (
              ch === "," &&
              parenDepth === 0 &&
              bracketDepth === 0
            ) {

              buffer = buffer.trimEnd() + ",";

              flush();
              newLine();

              continue;
            }


            /* New line */

            if (ch === "\n") {

              if (buffer.trim()) {
                flush();
                newLine();
              }

              continue;
            }


            /* Spaces */

            if (/\s/.test(ch)) {

              if (
                buffer &&
                !/\s$/.test(buffer)
              ) {
                buffer += " ";
              }

              continue;
            }


            buffer += ch;
            previous = ch;
          }


          if (buffer.trim()) {
            flush();
          }


          let formatted = result
            .replace(/[ \t]+\n/g, "\n")
            .replace(/\n{3,}/g, "\n\n")
            .trim();


          /*
           * Basic spacing cleanup.
           */

          formatted = formatted
            .replace(/[ \t]+,/g, ",")
            .replace(/,\s*/g, ", ")
            .replace(
              /\b(if|for|while|switch|catch)\s*\(/g,
              "$1 ("
            )
            .replace(
              /\b(function)\s+([A-Za-z_$][\w$]*)\s*\(/g,
              "$1 $2("
            );


          return formatted;
        }


        function formatCode() {

          const source = input.value.trim();

          if (!source) {

            output.value = "";

            updateStats();

            showStatus(
              "أدخل كود JavaScript أولاً.",
              true
            );

            input.focus();

            return;
          }


          try {

            const formatted =
              formatJavaScript(source);

            output.value = formatted;

            updateStats();

            showStatus(
              "تم تنسيق JavaScript بنجاح."
            );

          } catch {

            showStatus(
              "تعذر تنسيق الكود.",
              true
            );
          }
        }


        /* FORMAT */

        formatBtn.addEventListener(
          "click",
          formatCode
        );


        /* COPY */

        copyBtn.addEventListener(
          "click",
          async () => {

            if (!output.value) {

              showStatus(
                "قم بتنسيق الكود أولاً.",
                true
              );

              return;
            }


            try {

              await navigator.clipboard.writeText(
                output.value
              );

              showStatus(
                "تم نسخ الكود المنسق."
              );

            } catch {

              output.focus();
              output.select();

              document.execCommand("copy");

              showStatus(
                "تم نسخ الكود المنسق."
              );
            }
          }
        );


        /* DOWNLOAD */

        downloadBtn.addEventListener(
          "click",
          () => {

            if (!output.value) {

              showStatus(
                "قم بتنسيق الكود أولاً.",
                true
              );

              return;
            }


            const blob = new Blob(
              [output.value],
              {
                type:
                  "text/javascript;charset=utf-8"
              }
            );


            const url =
              URL.createObjectURL(blob);

            const link =
              document.createElement("a");

            link.href = url;
            link.download =
              "formatted-javascript.js";

            document.body.appendChild(link);

            link.click();

            link.remove();

            URL.revokeObjectURL(url);

            showStatus(
              "تم تنزيل ملف JavaScript."
            );
          }
        );


        /* CLEAR */

        clearBtn.addEventListener(
          "click",
          () => {

            input.value = "";
            output.value = "";

            updateStats();

            status.classList.add("hidden");

            input.focus();
          }
        );


        /* INPUT */

        input.addEventListener(
          "input",
          updateStats
        );


        /* TAB */

        input.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();

              const start = input.selectionStart;
              const end = input.selectionEnd;

              input.value =
                input.value.substring(0, start) +
                "  " +
                input.value.substring(end);

              input.selectionStart =
                input.selectionEnd =
                  start + 2;

              updateStats();
            }


            if (
              (event.ctrlKey || event.metaKey) &&
              event.key === "Enter"
            ) {

              event.preventDefault();

              formatCode();
            }
          }
        );


        /* SYNC SCROLL */

        input.addEventListener(
          "scroll",
          () => {
            inputNumbers.scrollTop =
              input.scrollTop;
          }
        );


        output.addEventListener(
          "scroll",
          () => {
            outputNumbers.scrollTop =
              output.scrollTop;
          }
        );


        updateStats();

      })();
    </script>

  </body>
</html>
