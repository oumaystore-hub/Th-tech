---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Formatter - تنسيق JavaScript أونلاين مجاناً | Th.Tech";
const description =
  "أداة JavaScript Formatter مجانية لتنسيق وترتيب كود JavaScript وتحسين قابليته للقراءة مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JavaScript Formatter؟",
    a: "أداة تقوم بترتيب وتنسيق كود JavaScript غير المنظم ليصبح أكثر وضوحاً وسهولة في القراءة."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم معالجة الكود مباشرة داخل متصفحك، ولا تحتاج إلى رفعه إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام الأداة على الهاتف؟",
    a: "نعم، تم تصميم الأداة لتعمل بشكل متجاوب على الهاتف والكمبيوتر والأجهزة اللوحية."
  },
  {
    q: "هل يمكن نسخ الكود المنسق؟",
    a: "نعم، يمكنك نسخ النتيجة مباشرة باستخدام زر النسخ."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");

          if (saved === "dark") {
            document.documentElement.classList.add("dark-mode");
          } else {
            document.documentElement.classList.remove("dark-mode");
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-angle-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-angle-left"></i>
            <span>JavaScript Formatter</span>
          </div>

          <div class="hero-badge">
            <i class="fa-brands fa-js"></i>
            JavaScript Tool
          </div>

          <h1>
            JavaScript
            <span>Formatter</span>
          </h1>

          <p>
            نسّق كود JavaScript ورتّبه تلقائياً ليصبح أكثر وضوحاً
            وسهولة في القراءة خلال ثوانٍ.
          </p>

        </div>
      </section>


      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">

          <div class="tool">

            <!-- TOOL HEADER -->
            <div class="tool-header">

              <div class="tool-heading">

                <div class="tool-logo">
                  <i class="fa-brands fa-js"></i>
                </div>

                <div>
                  <h2>JavaScript Formatter</h2>
                  <p>تنسيق وترتيب كود JavaScript</p>
                </div>

              </div>

              <div class="tool-status">
                <span></span>
                يعمل محلياً
              </div>

            </div>


            <!-- ACTION BAR -->
            <div class="action-bar">

              <div class="action-left">

                <button id="formatBtn" class="action primary">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  <span>تنسيق الكود</span>
                </button>

                <button id="copyBtn" class="action">
                  <i class="fa-regular fa-copy"></i>
                  <span>نسخ</span>
                </button>

                <button id="downloadBtn" class="action">
                  <i class="fa-solid fa-download"></i>
                  <span>تنزيل</span>
                </button>

                <button id="clearBtn" class="action danger">
                  <i class="fa-solid fa-trash-can"></i>
                  <span>مسح</span>
                </button>

              </div>

              <div class="shortcut">
                <kbd>Ctrl</kbd>
                <span>+</span>
                <kbd>Enter</kbd>
                <span>للتنسيق</span>
              </div>

            </div>


            <!-- EDITORS -->
            <div class="editors">

              <!-- INPUT -->
              <div class="editor">

                <div class="editor-top">

                  <div class="editor-title">
                    <span class="dot input-dot"></span>

                    <strong>الكود الأصلي</strong>

                    <span class="language">
                      JavaScript
                    </span>
                  </div>

                  <div class="editor-meta">
                    <span id="inputLines">0 سطر</span>
                    <span>•</span>
                    <span id="inputSize">0 B</span>
                  </div>

                </div>

                <textarea
                  id="inputCode"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  placeholder={`// الصق كود JavaScript هنا

function hello(name){
console.log("Hello " + name);
}

const user={name:"Ahmed",age:25};`}
                ></textarea>

              </div>


              <!-- OUTPUT -->
              <div class="editor output-editor">

                <div class="editor-top">

                  <div class="editor-title">
                    <span class="dot output-dot"></span>

                    <strong>الكود المنسق</strong>

                    <span class="language">
                      Formatted
                    </span>
                  </div>

                  <div class="editor-meta">
                    <span id="outputLines">0 سطر</span>
                    <span>•</span>
                    <span id="outputSize">0 B</span>
                  </div>

                </div>

                <textarea
                  id="outputCode"
                  spellcheck="false"
                  readonly
                  placeholder="سيظهر الكود المنسق هنا..."
                ></textarea>

              </div>

            </div>


            <!-- STATUS -->
            <div id="status" class="status hidden">
              <i class="fa-solid fa-circle-check"></i>
              <span></span>
            </div>


            <!-- TOOL FOOTER -->
            <div class="tool-footer">

              <div class="privacy">
                <i class="fa-solid fa-shield-halved"></i>

                <div>
                  <strong>معالجة آمنة ومحلية</strong>
                  <span>الكود لا يغادر متصفحك</span>
                </div>
              </div>

              <div class="stats-mini">

                <div>
                  <strong id="characters">0</strong>
                  <span>حرف</span>
                </div>

                <div>
                  <strong id="formattedCharacters">0</strong>
                  <span>بعد التنسيق</span>
                </div>

              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FEATURES -->
      <section class="features-section">
        <div class="container">

          <div class="section-head">
            <span>مميزات الأداة</span>
            <h2>كل ما تحتاجه لتنسيق JavaScript</h2>
            <p>
              أداة بسيطة وسريعة تساعدك على جعل كود JavaScript
              أكثر تنظيماً ووضوحاً.
            </p>
          </div>


          <div class="features">

            <article class="feature-card">

              <div class="feature-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>سريعة</h3>

              <p>
                تتم عملية التنسيق مباشرة داخل المتصفح بدون انتظار.
              </p>

            </article>


            <article class="feature-card">

              <div class="feature-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3>خصوصية</h3>

              <p>
                لا يتم إرسال الكود إلى خادم خارجي أثناء المعالجة.
              </p>

            </article>


            <article class="feature-card">

              <div class="feature-icon">
                <i class="fa-solid fa-copy"></i>
              </div>

              <h3>نسخ سريع</h3>

              <p>
                انسخ الكود المنسق مباشرة بضغطة واحدة.
              </p>

            </article>


            <article class="feature-card">

              <div class="feature-icon">
                <i class="fa-solid fa-mobile-screen-button"></i>
              </div>

              <h3>متجاوبة</h3>

              <p>
                تعمل بشكل ممتاز على الهاتف والكمبيوتر.
              </p>

            </article>

          </div>

        </div>
      </section>


      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-head">
            <span>طريقة الاستخدام</span>
            <h2>كيف تستخدم الأداة؟</h2>
          </div>


          <div class="steps">

            <div class="step">

              <div class="step-number">01</div>

              <div>
                <h3>الصق الكود</h3>
                <p>
                  ضع كود JavaScript الذي تريد تنسيقه في المحرر الأول.
                </p>
              </div>

            </div>


            <div class="step">

              <div class="step-number">02</div>

              <div>
                <h3>اضغط تنسيق الكود</h3>
                <p>
                  اضغط على زر تنسيق الكود لمعالجة JavaScript.
                </p>
              </div>

            </div>


            <div class="step">

              <div class="step-number">03</div>

              <div>
                <h3>راجع النتيجة</h3>
                <p>
                  ستظهر النسخة المنسقة في المحرر الثاني.
                </p>
              </div>

            </div>


            <div class="step">

              <div class="step-number">04</div>

              <div>
                <h3>انسخ أو نزّل</h3>
                <p>
                  انسخ الكود أو نزّله كملف JavaScript.
                </p>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-head">
            <span>الأسئلة الشائعة</span>
            <h2>أسئلة حول JavaScript Formatter</h2>
          </div>


          <div class="faq">

            {
              faqs.map((item) => (
                <details>
                  <summary>
                    <span>{item.q}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <p>{item.a}</p>
                </details>
              ))
            }

          </div>

        </div>
      </section>

    </main>

    <Footer />


    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      :global(:root) {
        --bg: #f8fafc;
        --bg-soft: #f1f5f9;
        --card: #ffffff;
        --card-soft: #f8fafc;

        --text: #0f172a;
        --muted: #64748b;

        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --cyan: #0891b2;

        --green: #16a34a;
        --red: #dc2626;

        --border: rgba(15, 23, 42, 0.09);

        --shadow:
          0 20px 60px rgba(15, 23, 42, 0.08);
      }

      :global(html.dark-mode) {
        --bg: #07101f;
        --bg-soft: #0b1426;
        --card: #111d32;
        --card-soft: #0d1729;

        --text: #f8fafc;
        --muted: #94a3b8;

        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --cyan: #06b6d4;

        --green: #22c55e;
        --red: #ef4444;

        --border: rgba(148, 163, 184, 0.12);

        --shadow:
          0 25px 70px rgba(0, 0, 0, 0.3);
      }

      .container {
        width: min(1160px, calc(100% - 32px));
        margin-inline: auto;
      }


      /* HERO */

      .hero {
        padding: 42px 0 34px;
        text-align: center;
      }

      .breadcrumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 24px;
        color: var(--muted);
        font-size: 12px;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: .6;
      }

      .hero-badge {
        width: fit-content;
        margin: auto;
        padding: 7px 13px;
        border: 1px solid rgba(37, 99, 235, .15);
        border-radius: 30px;
        background: rgba(37, 99, 235, .07);
        color: var(--primary);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .hero h1 {
        margin: 14px 0 8px;
        font-size: clamp(34px, 6vw, 52px);
        line-height: 1.2;
        letter-spacing: -1.2px;
        font-weight: 800;
      }

      .hero h1 span {
        color: var(--primary);
      }

      .hero p {
        max-width: 680px;
        margin: auto;
        color: var(--muted);
        line-height: 1.9;
        font-size: 15px;
      }


      /* TOOL */

      .tool-section {
        padding: 5px 0 70px;
      }

      .tool {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 22px;
        background: var(--card);
        box-shadow: var(--shadow);
      }


      /* HEADER */

      .tool-header {
        padding: 17px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid var(--border);
      }

      .tool-heading {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .tool-logo {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37, 99, 235, .1);
        color: var(--primary);
        font-size: 22px;
      }

      .tool-heading h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
      }

      .tool-heading p {
        margin: 2px 0 0;
        color: var(--muted);
        font-size: 11px;
      }

      .tool-status {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--green);
        font-size: 11px;
        font-weight: 700;
      }

      .tool-status span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 4px rgba(22, 163, 74, .1);
      }


      /* ACTION BAR */

      .action-bar {
        min-height: 62px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--border);
        background: var(--card-soft);
      }

      .action-left {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
      }

      .action {
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--text);
        border-radius: 9px;
        padding: 9px 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
      }

      .action:hover {
        transform: translateY(-1px);
        border-color: var(--primary);
        color: var(--primary);
      }

      .action.primary {
        color: #fff;
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 5px 15px rgba(37, 99, 235, .2);
      }

      .action.primary:hover {
        color: #fff;
        background: var(--primary-dark);
      }

      .action.danger {
        color: var(--red);
      }

      .shortcut {
        display: flex;
        align-items: center;
        gap: 4px;
        color: var(--muted);
        font-size: 10px;
      }

      kbd {
        padding: 3px 6px;
        border: 1px solid var(--border);
        border-bottom-width: 2px;
        border-radius: 5px;
        background: var(--card);
        font-family: inherit;
        font-size: 9px;
      }


      /* EDITORS */

      .editors {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--border);
      }

      .editor {
        min-width: 0;
        background: var(--card);
      }

      .editor-top {
        height: 48px;
        padding: 0 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 1px solid var(--border);
      }

      .editor-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }

      .editor-title strong {
        font-size: 12px;
        white-space: nowrap;
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
      }

      .input-dot {
        background: var(--cyan);
        box-shadow: 0 0 0 4px rgba(8, 145, 178, .1);
      }

      .output-dot {
        background: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .1);
      }

      .language {
        padding: 3px 7px;
        border-radius: 5px;
        background: var(--bg-soft);
        color: var(--muted);
        font-size: 9px;
        font-weight: 600;
      }

      .editor-meta {
        display: flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 10px;
        white-space: nowrap;
      }

      textarea {
        display: block;
        width: 100%;
        height: 390px;
        padding: 19px;
        resize: vertical;
        border: 0;
        outline: none;
        background: var(--card-soft);
        color: var(--text);
        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          Menlo,
          monospace;
        font-size: 13px;
        line-height: 1.8;
        direction: ltr;
        text-align: left;
        tab-size: 2;
      }

      .output-editor textarea {
        background: var(--card);
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: .55;
      }


      /* STATUS */

      .status {
        margin: 14px 15px 0;
        padding: 10px 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 9px;
        background: rgba(22, 163, 74, .08);
        color: var(--green);
        font-size: 11px;
        font-weight: 700;
      }

      .status.error {
        background: rgba(220, 38, 38, .08);
        color: var(--red);
      }

      .status.hidden {
        display: none;
      }


      /* TOOL FOOTER */

      .tool-footer {
        padding: 14px 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-top: 1px solid var(--border);
      }

      .privacy {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .privacy > i {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(22, 163, 74, .08);
        color: var(--green);
        font-size: 13px;
      }

      .privacy div {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .privacy strong {
        font-size: 10px;
      }

      .privacy span {
        color: var(--muted);
        font-size: 9px;
      }

      .stats-mini {
        display: flex;
        align-items: center;
        gap: 22px;
      }

      .stats-mini div {
        display: flex;
        align-items: baseline;
        gap: 5px;
      }

      .stats-mini strong {
        font-size: 13px;
      }

      .stats-mini span {
        color: var(--muted);
        font-size: 9px;
      }


      /* SECTIONS */

      .features-section {
        padding: 70px 0;
        background: var(--bg-soft);
      }

      .how-section,
      .faq-section {
        padding: 70px 0;
      }

      .section-head {
        text-align: center;
        margin-bottom: 34px;
      }

      .section-head > span {
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      .section-head h2 {
        margin: 5px 0 7px;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 800;
      }

      .section-head p {
        max-width: 620px;
        margin: auto;
        color: var(--muted);
        line-height: 1.9;
        font-size: 13px;
      }


      /* FEATURES */

      .features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
      }

      .feature-card {
        padding: 23px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--card);
        transition: .2s ease;
      }

      .feature-card:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, .25);
        box-shadow: var(--shadow);
      }

      .feature-icon {
        width: 42px;
        height: 42px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: rgba(37, 99, 235, .09);
        color: var(--primary);
      }

      .feature-card h3 {
        margin: 0 0 6px;
        font-size: 16px;
      }

      .feature-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
      }


      /* STEPS */

      .steps {
        max-width: 800px;
        margin: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
      }

      .step {
        padding: 19px;
        display: flex;
        align-items: flex-start;
        gap: 13px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--card);
      }

      .step-number {
        flex: 0 0 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(37, 99, 235, .1);
        color: var(--primary);
        font-size: 10px;
        font-weight: 800;
      }

      .step h3 {
        margin: 0 0 4px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }


      /* FAQ */

      .faq {
        max-width: 800px;
        margin: auto;
        display: grid;
        gap: 9px;
      }

      .faq details {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--card);
        overflow: hidden;
      }

      .faq summary {
        padding: 16px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq summary::-webkit-details-marker {
        display: none;
      }

      .faq summary i {
        color: var(--primary);
        font-size: 11px;
        transition: .2s;
      }

      .faq details[open] summary i {
        transform: rotate(180deg);
      }

      .faq p {
        margin: 0;
        padding: 0 18px 17px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }


      /* RESPONSIVE */

      @media (max-width: 900px) {

        .features {
          grid-template-columns: repeat(2, 1fr);
        }

      }


      @media (max-width: 800px) {

        .editors {
          grid-template-columns: 1fr;
        }

        .editor textarea {
          height: 300px;
        }

        .steps {
          grid-template-columns: 1fr;
        }

        .shortcut {
          display: none;
        }

      }


      @media (max-width: 600px) {

        .container {
          width: calc(100% - 20px);
        }

        .hero {
          padding: 30px 0 25px;
        }

        .hero h1 {
          font-size: 34px;
        }

        .hero p {
          font-size: 13px;
        }

        .tool {
          border-radius: 17px;
        }

        .tool-header {
          padding: 14px;
        }

        .tool-logo {
          width: 38px;
          height: 38px;
          font-size: 18px;
        }

        .tool-heading h2 {
          font-size: 13px;
        }

        .tool-heading p {
          font-size: 9px;
        }

        .tool-status {
          font-size: 9px;
        }

        .action-bar {
          padding: 9px;
        }

        .action-left {
          width: 100%;
          display: grid;
          grid-template-columns: 1.4fr 1fr 1fr 1fr;
        }

        .action {
          padding: 9px 5px;
          font-size: 10px;
          gap: 4px;
        }

        .action i {
          font-size: 10px;
        }

        .editor-top {
          padding: 0 11px;
        }

        .editor-meta {
          font-size: 8px;
        }

        .language {
          display: none;
        }

        textarea {
          padding: 14px;
          height: 280px !important;
          font-size: 12px;
        }

        .tool-footer {
          align-items: flex-start;
          flex-direction: column;
        }

        .stats-mini {
          width: 100%;
          justify-content: flex-end;
        }

        .features {
          grid-template-columns: 1fr 1fr;
          gap: 9px;
        }

        .feature-card {
          padding: 16px;
        }

        .feature-icon {
          width: 36px;
          height: 36px;
          margin-bottom: 10px;
        }

        .feature-card h3 {
          font-size: 13px;
        }

        .feature-card p {
          font-size: 10px;
        }

        .features-section,
        .how-section,
        .faq-section {
          padding: 48px 0;
        }

      }


      @media (max-width: 400px) {

        .action span {
          display: none;
        }

        .action {
          padding: 10px;
        }

        .action-left {
          grid-template-columns: repeat(4, 1fr);
        }

        .features {
          grid-template-columns: 1fr;
        }

      }
    </style>


    <script is:inline>
      (() => {

        const input = document.getElementById("inputCode");
        const output = document.getElementById("outputCode");

        const formatBtn = document.getElementById("formatBtn");
        const copyBtn = document.getElementById("copyBtn");
        const downloadBtn = document.getElementById("downloadBtn");
        const clearBtn = document.getElementById("clearBtn");

        const status = document.getElementById("status");

        const inputLines = document.getElementById("inputLines");
        const outputLines = document.getElementById("outputLines");

        const inputSize = document.getElementById("inputSize");
        const outputSize = document.getElementById("outputSize");

        const characters = document.getElementById("characters");
        const formattedCharacters =
          document.getElementById("formattedCharacters");


        function bytes(text) {
          return new Blob([text]).size;
        }


        function formatBytes(size) {

          if (!size) return "0 B";

          const units = ["B", "KB", "MB", "GB"];
          const index = Math.floor(
            Math.log(size) / Math.log(1024)
          );

          return (
            (size / Math.pow(1024, index))
              .toFixed(index === 0 ? 0 : 1)
            + " " +
            units[index]
          );
        }


        function lines(text) {
          if (!text) return 0;
          return text.split(/\r\n|\r|\n/).length;
        }


        function updateStats() {

          const original = input.value;
          const formatted = output.value;

          const originalLines = lines(original);
          const formattedLines = lines(formatted);

          inputLines.textContent =
            `${originalLines} ${originalLines === 1 ? "سطر" : "أسطر"}`;

          outputLines.textContent =
            `${formattedLines} ${formattedLines === 1 ? "سطر" : "أسطر"}`;

          inputSize.textContent =
            formatBytes(bytes(original));

          outputSize.textContent =
            formatBytes(bytes(formatted));

          characters.textContent =
            original.length.toLocaleString();

          formattedCharacters.textContent =
            formatted.length.toLocaleString();
        }


        function showStatus(message, error = false) {

          status.classList.remove("hidden", "error");

          if (error) {
            status.classList.add("error");
            status.querySelector("i").className =
              "fa-solid fa-circle-exclamation";
          } else {
            status.querySelector("i").className =
              "fa-solid fa-circle-check";
          }

          status.querySelector("span").textContent = message;

          clearTimeout(window.__thStatus);

          window.__thStatus = setTimeout(() => {
            status.classList.add("hidden");
          }, 3500);
        }


        function formatJavaScript(code) {

          let result = "";
          let indent = 0;

          let inString = null;
          let inTemplate = false;
          let lineComment = false;
          let blockComment = false;

          let parens = 0;
          let brackets = 0;

          let buffer = "";


          const addIndent = () => {
            result += "  ".repeat(Math.max(0, indent));
          };


          const flush = () => {

            const value = buffer.trim();

            if (value) {
              addIndent();
              result += value;
            }

            buffer = "";
          };


          const newline = () => {

            result = result.replace(/[ \t]+$/g, "");

            if (!result.endsWith("\n")) {
              result += "\n";
            }
          };


          const escaped = (str, index) => {

            let count = 0;

            for (
              let i = index - 1;
              i >= 0 && str[i] === "\\";
              i--
            ) {
              count++;
            }

            return count % 2 === 1;
          };


          for (let i = 0; i < code.length; i++) {

            const ch = code[i];
            const next = code[i + 1];


            if (lineComment) {

              buffer += ch;

              if (ch === "\n") {
                flush();
                newline();
                lineComment = false;
              }

              continue;
            }


            if (blockComment) {

              buffer += ch;

              if (ch === "*" && next === "/") {
                buffer += "/";
                i++;

                flush();
                newline();

                blockComment = false;
              }

              continue;
            }


            if (inString) {

              buffer += ch;

              if (
                ch === inString &&
                !escaped(code, i)
              ) {
                inString = null;
              }

              continue;
            }


            if (inTemplate) {

              buffer += ch;

              if (
                ch === "`" &&
                !escaped(code, i)
              ) {
                inTemplate = false;
              }

              continue;
            }


            if (ch === "/" && next === "/") {

              if (buffer.trim()) {
                flush();
              }

              buffer = "//";
              i++;

              lineComment = true;

              continue;
            }


            if (ch === "/" && next === "*") {

              if (buffer.trim()) {
                flush();
              }

              buffer = "/*";
              i++;

              blockComment = true;

              continue;
            }


            if (ch === "'" || ch === '"') {

              inString = ch;
              buffer += ch;

              continue;
            }


            if (ch === "`") {

              inTemplate = true;
              buffer += ch;

              continue;
            }


            if (ch === "(") {
              parens++;
              buffer += ch;
              continue;
            }


            if (ch === ")") {
              parens = Math.max(0, parens - 1);
              buffer = buffer.trimEnd() + ")";
              continue;
            }


            if (ch === "[") {
              brackets++;
              buffer += ch;
              continue;
            }


            if (ch === "]") {
              brackets = Math.max(0, brackets - 1);
              buffer = buffer.trimEnd() + "]";
              continue;
            }


            if (ch === "{") {

              buffer = buffer.trimEnd();

              if (buffer) {
                buffer += " ";
                flush();
              } else {
                addIndent();
              }

              result += "{";
              newline();

              indent++;

              continue;
            }


            if (ch === "}") {

              if (buffer.trim()) {
                flush();
                newline();
              }

              indent = Math.max(0, indent - 1);

              addIndent();
              result += "}";

              if (
                next !== ";" &&
                next !== "," &&
                next !== ")" &&
                next !== "]" &&
                next !== "."
              ) {
                newline();
              }

              continue;
            }


            if (
              ch === ";" &&
              parens === 0 &&
              brackets === 0
            ) {

              buffer = buffer.trimEnd() + ";";

              flush();
              newline();

              continue;
            }


            if (ch === "\n") {

              if (buffer.trim()) {
                flush();
                newline();
              }

              continue;
            }


            buffer += ch;
          }


          if (buffer.trim()) {
            flush();
          }


          let formatted = result
            .replace(/[ \t]+\n/g, "\n")
            .replace(/\n{3,}/g, "\n\n")
            .trim();


          formatted = formatted
            .replace(/[ \t]+,/g, ",")
            .replace(/,\s*/g, ", ")
            .replace(
              /\b(if|for|while|switch|catch)\s*\(/g,
              "$1 ("
            );


          return formatted;
        }


        function formatCode() {

          const code = input.value.trim();

          if (!code) {

            output.value = "";

            updateStats();

            showStatus(
              "أدخل كود JavaScript أولاً.",
              true
            );

            input.focus();

            return;
          }


          try {

            output.value = formatJavaScript(code);

            updateStats();

            showStatus(
              "تم تنسيق كود JavaScript بنجاح."
            );

          } catch {

            showStatus(
              "تعذر تنسيق الكود. تحقق من المحتوى.",
              true
            );
          }
        }


        formatBtn.addEventListener(
          "click",
          formatCode
        );


        copyBtn.addEventListener(
          "click",
          async () => {

            if (!output.value) {

              showStatus(
                "لا يوجد كود منسق لنسخه.",
                true
              );

              return;
            }


            try {

              await navigator.clipboard.writeText(
                output.value
              );

              showStatus(
                "تم نسخ الكود المنسق."
              );

            } catch {

              output.select();

              document.execCommand("copy");

              showStatus(
                "تم نسخ الكود المنسق."
              );
            }
          }
        );


        downloadBtn.addEventListener(
          "click",
          () => {

            if (!output.value) {

              showStatus(
                "قم بتنسيق الكود أولاً.",
                true
              );

              return;
            }


            const blob = new Blob(
              [output.value],
              { type: "text/javascript;charset=utf-8" }
            );

            const url = URL.createObjectURL(blob);

            const link =
              document.createElement("a");

            link.href = url;
            link.download =
              "formatted-script.js";

            document.body.appendChild(link);

            link.click();

            link.remove();

            URL.revokeObjectURL(url);

            showStatus(
              "تم تنزيل ملف JavaScript."
            );
          }
        );


        clearBtn.addEventListener(
          "click",
          () => {

            input.value = "";
            output.value = "";

            updateStats();

            status.classList.add("hidden");

            input.focus();
          }
        );


        input.addEventListener(
          "input",
          updateStats
        );


        document.addEventListener(
          "keydown",
          (event) => {

            if (
              (event.ctrlKey || event.metaKey) &&
              event.key === "Enter"
            ) {

              event.preventDefault();

              formatCode();
            }
          }
        );


        updateStats();

      })();
    </script>

  </body>
</html>
