---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Formatter - تنسيق JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "أداة JavaScript Formatter مجانية لتنسيق وترتيب كود JavaScript وتحسين قراءته مباشرة من المتصفح بدون رفع الملفات.";

const faqs = [
  {
    q: "ما هي أداة JavaScript Formatter؟",
    a: "أداة تساعدك على تنسيق وترتيب كود JavaScript وجعله أكثر وضوحاً وسهولة في القراءة."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. تتم عملية التنسيق مباشرة داخل المتصفح، لذلك لا تحتاج إلى رفع الكود إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام الأداة على الهاتف؟",
    a: "نعم، الأداة مصممة للعمل على الهاتف والكمبيوتر والأجهزة اللوحية."
  },
  {
    q: "هل الأداة تصلح للملفات الكبيرة؟",
    a: "يمكن استخدامها مع معظم ملفات JavaScript، لكن الملفات الكبيرة جداً قد تحتاج إلى وقت معالجة أطول حسب أداء الجهاز."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');

          if (saved === 'dark') {
            document.documentElement.classList.add('dark-mode');
          } else {
            document.documentElement.classList.remove('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="page">

      <!-- Hero -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <span>/</span>
            <a href={`${base}/tools/`}>الأدوات</a>
            <span>/</span>
            <span>JavaScript Formatter</span>
          </div>

          <div class="hero-icon">
            <i class="fa-brands fa-js"></i>
          </div>

          <div class="kicker">
            <i class="fa-solid fa-code"></i>
            أداة JavaScript
          </div>

          <h1>
            JavaScript
            <span>Formatter</span>
          </h1>

          <p>
            نسّق كود JavaScript ورتّبه تلقائياً واجعله أكثر وضوحاً
            وسهولة في القراءة مباشرة من المتصفح.
          </p>

        </div>
      </section>


      <!-- Tool -->
      <section class="tool-section">
        <div class="container">

          <div class="tool-card">

            <!-- Toolbar -->
            <div class="toolbar">

              <div class="toolbar-title">
                <i class="fa-brands fa-js"></i>
                JavaScript Formatter
              </div>

              <div class="toolbar-actions">

                <button id="formatBtn" class="btn primary">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  تنسيق الكود
                </button>

                <button id="copyBtn" class="btn">
                  <i class="fa-regular fa-copy"></i>
                  نسخ
                </button>

                <button id="clearBtn" class="btn danger">
                  <i class="fa-solid fa-trash"></i>
                  مسح
                </button>

              </div>

            </div>


            <!-- Editor -->
            <div class="editor-grid">

              <!-- Input -->
              <div class="editor-panel">

                <div class="panel-header">
                  <div>
                    <i class="fa-solid fa-code"></i>
                    كود JavaScript
                  </div>

                  <span id="inputLines">0 سطر</span>
                </div>

                <textarea
                  id="inputCode"
                  spellcheck="false"
                  placeholder={`أدخل كود JavaScript هنا...

مثال:
function hello(name){console.log("Hello "+name);}

أو:
const user={name:"Ahmed",age:25};
console.log(user);`}
                ></textarea>

              </div>


              <!-- Output -->
              <div class="editor-panel">

                <div class="panel-header">
                  <div>
                    <i class="fa-solid fa-align-left"></i>
                    الكود المنسق
                  </div>

                  <span id="outputLines">0 سطر</span>
                </div>

                <textarea
                  id="outputCode"
                  spellcheck="false"
                  readonly
                  placeholder="سيظهر الكود المنسق هنا..."
                ></textarea>

              </div>

            </div>


            <!-- Status -->
            <div id="status" class="status hidden">
              <i class="fa-solid fa-circle-check"></i>
              <span>تم تنسيق الكود بنجاح.</span>
            </div>


            <!-- Stats -->
            <div class="stats">

              <div class="stat">
                <span>حجم الإدخال</span>
                <strong id="inputSize">0 B</strong>
              </div>

              <div class="stat">
                <span>حجم الناتج</span>
                <strong id="outputSize">0 B</strong>
              </div>

              <div class="stat">
                <span>أسطر الإدخال</span>
                <strong id="inputCount">0</strong>
              </div>

              <div class="stat">
                <span>أسطر الناتج</span>
                <strong id="outputCount">0</strong>
              </div>

            </div>

          </div>

        </div>
      </section>


      <!-- Information -->
      <section class="info-section">
        <div class="container">

          <div class="section-heading">
            <span>JavaScript Formatter</span>
            <h2>تنسيق JavaScript بسهولة</h2>
            <p>
              قم بتحويل الكود غير المرتب إلى كود منظم وسهل القراءة
              خلال ثوانٍ.
            </p>
          </div>


          <div class="info-grid">

            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>سريع</h3>

              <p>
                تتم عملية التنسيق مباشرة داخل المتصفح بدون الحاجة
                إلى انتظار خادم خارجي.
              </p>
            </div>


            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3>خصوصية أفضل</h3>

              <p>
                لا تحتاج إلى رفع كود JavaScript الخاص بك إلى أي خدمة
                خارجية.
              </p>
            </div>


            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-mobile-screen"></i>
              </div>

              <h3>متوافق مع الهاتف</h3>

              <p>
                يمكنك تنسيق الكود من الهاتف أو الكمبيوتر بسهولة.
              </p>
            </div>


            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>JavaScript</h3>

              <p>
                مخصص لتنسيق أكواد JavaScript وتحسين ترتيبها وقراءتها.
              </p>
            </div>

          </div>

        </div>
      </section>


      <!-- How to -->
      <section class="how-section">
        <div class="container">

          <div class="section-heading">
            <span>طريقة الاستخدام</span>
            <h2>كيف تستخدم JavaScript Formatter؟</h2>
          </div>


          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>أدخل الكود</h3>
                <p>
                  الصق كود JavaScript غير المنسق في مربع الإدخال.
                </p>
              </div>
            </div>


            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>اضغط على تنسيق الكود</h3>
                <p>
                  اضغط على زر "تنسيق الكود" لمعالجة JavaScript.
                </p>
              </div>
            </div>


            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>راجع النتيجة</h3>
                <p>
                  سيظهر الكود المنظم في مربع النتيجة.
                </p>
              </div>
            </div>


            <div class="step">
              <div class="step-number">4</div>

              <div>
                <h3>انسخ الكود</h3>
                <p>
                  استخدم زر النسخ للحصول على الكود المنسق.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>


      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-heading">
            <span>الأسئلة الشائعة</span>
            <h2>أسئلة حول JavaScript Formatter</h2>
          </div>


          <div class="faq-list">

            {
              faqs.map((faq) => (
                <details class="faq-item">
                  <summary>
                    <span>{faq.q}</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </summary>

                  <p>{faq.a}</p>
                </details>
              ))
            }

          </div>

        </div>
      </section>

    </main>

    <Footer />


    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      :global(:root) {
        --bg: #f8fafc;
        --bg2: #f1f5f9;
        --card: #ffffff;
        --card2: #f8fafc;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --cyan: #0891b2;
        --green: #16a34a;
        --red: #dc2626;
        --border: rgba(15, 23, 42, 0.09);
        --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
      }

      :global(html.dark-mode) {
        --bg: #07101f;
        --bg2: #0b1426;
        --card: #111d32;
        --card2: #0d1729;
        --text: #f8fafc;
        --muted: #94a3b8;
        --primary: #3b82f6;
        --primary-hover: #2563eb;
        --cyan: #06b6d4;
        --green: #22c55e;
        --red: #ef4444;
        --border: rgba(148, 163, 184, 0.12);
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: auto;
      }

      .page {
        min-height: 100vh;
      }

      /* Hero */

      .hero {
        padding: 50px 0 35px;
        text-align: center;
      }

      .breadcrumb {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 25px;
        color: var(--muted);
        font-size: 13px;
      }

      .breadcrumb a {
        color: var(--primary);
        text-decoration: none;
      }

      .hero-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: rgba(37, 99, 235, 0.1);
        color: var(--primary);
        font-size: 34px;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--cyan);
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
      }

      h1 {
        margin: 0;
        font-size: clamp(32px, 5vw, 54px);
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -1px;
      }

      h1 span {
        color: var(--primary);
      }

      .hero p {
        max-width: 720px;
        margin: 15px auto 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 16px;
      }

      /* Tool */

      .tool-section {
        padding: 15px 0 55px;
      }

      .tool-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .toolbar {
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
      }

      .toolbar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
      }

      .toolbar-title i {
        color: var(--primary);
        font-size: 21px;
      }

      .toolbar-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .btn {
        border: 1px solid var(--border);
        background: var(--card2);
        color: var(--text);
        padding: 10px 15px;
        border-radius: 11px;
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
        border-color: var(--primary);
      }

      .btn.primary {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
      }

      .btn.primary:hover {
        background: var(--primary-hover);
      }

      .btn.danger {
        color: var(--red);
      }

      .editor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--border);
      }

      .editor-panel {
        background: var(--card);
        min-width: 0;
      }

      .panel-header {
        height: 50px;
        padding: 0 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .panel-header > div {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text);
      }

      .panel-header i {
        color: var(--primary);
      }

      textarea {
        display: block;
        width: 100%;
        min-height: 430px;
        padding: 20px;
        resize: vertical;
        border: 0;
        outline: 0;
        background: var(--card2);
        color: var(--text);
        font-family: Consolas, Monaco, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.8;
        direction: ltr;
        text-align: left;
      }

      textarea::placeholder {
        color: var(--muted);
        opacity: 0.7;
      }

      #outputCode {
        background: var(--card);
      }

      .status {
        margin: 16px 20px 0;
        padding: 12px 15px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 9px;
        background: rgba(22, 163, 74, 0.1);
        color: var(--green);
        font-size: 14px;
        font-weight: 700;
      }

      .status.error {
        background: rgba(220, 38, 38, 0.1);
        color: var(--red);
      }

      .status.hidden {
        display: none;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--border);
        margin-top: 18px;
      }

      .stat {
        padding: 17px;
        text-align: center;
        border-left: 1px solid var(--border);
      }

      .stat:last-child {
        border-left: 0;
      }

      .stat span {
        display: block;
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 5px;
      }

      .stat strong {
        font-size: 16px;
      }

      /* Sections */

      .info-section,
      .how-section,
      .faq-section {
        padding: 65px 0;
      }

      .info-section {
        background: var(--bg2);
      }

      .section-heading {
        text-align: center;
        margin-bottom: 35px;
      }

      .section-heading > span {
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
      }

      .section-heading h2 {
        margin: 6px 0;
        font-size: clamp(25px, 4vw, 34px);
      }

      .section-heading p {
        color: var(--muted);
        margin: 8px auto 0;
        max-width: 650px;
        line-height: 1.8;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      .info-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 24px;
      }

      .info-icon {
        width: 45px;
        height: 45px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37, 99, 235, 0.1);
        color: var(--primary);
        margin-bottom: 15px;
      }

      .info-card h3 {
        margin: 0 0 7px;
        font-size: 18px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
        font-size: 14px;
      }

      /* Steps */

      .steps {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 14px;
      }

      .step {
        display: flex;
        gap: 18px;
        align-items: flex-start;
        padding: 20px;
        border: 1px solid var(--border);
        background: var(--card);
        border-radius: 17px;
      }

      .step-number {
        flex: 0 0 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
      }

      .step h3 {
        margin: 0 0 5px;
        font-size: 17px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
        font-size: 14px;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 10px;
      }

      .faq-item {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 15px;
        overflow: hidden;
      }

      .faq-item summary {
        cursor: pointer;
        list-style: none;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        transition: transform 0.2s ease;
        color: var(--primary);
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
      }

      .faq-item p {
        margin: 0;
        padding: 0 20px 20px;
        color: var(--muted);
        line-height: 1.9;
        font-size: 14px;
      }

      @media (max-width: 900px) {
        .info-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 800px) {
        .editor-grid {
          grid-template-columns: 1fr;
        }

        textarea {
          min-height: 320px;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .stat:nth-child(2) {
          border-left: 0;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero {
          padding-top: 30px;
        }

        .toolbar {
          align-items: stretch;
        }

        .toolbar-actions {
          width: 100%;
        }

        .btn {
          flex: 1;
          min-width: 0;
          padding: 10px 8px;
          font-size: 12px;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 45px 0;
        }

        .step {
          padding: 16px;
        }

        .step-number {
          flex-basis: 36px;
          height: 36px;
        }

        textarea {
          min-height: 280px;
          font-size: 13px;
        }
      }
    </style>


    <script is:inline>
      (() => {
        const input = document.getElementById("inputCode");
        const output = document.getElementById("outputCode");

        const formatBtn = document.getElementById("formatBtn");
        const copyBtn = document.getElementById("copyBtn");
        const clearBtn = document.getElementById("clearBtn");

        const status = document.getElementById("status");

        const inputSize = document.getElementById("inputSize");
        const outputSize = document.getElementById("outputSize");

        const inputCount = document.getElementById("inputCount");
        const outputCount = document.getElementById("outputCount");

        const inputLines = document.getElementById("inputLines");
        const outputLines = document.getElementById("outputLines");


        function formatBytes(bytes) {
          if (bytes === 0) return "0 B";

          const units = ["B", "KB", "MB", "GB"];
          const i = Math.floor(Math.log(bytes) / Math.log(1024));

          return `${(bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 2)} ${units[i]}`;
        }


        function countLines(text) {
          if (!text) return 0;
          return text.split(/\r\n|\r|\n/).length;
        }


        function updateStats() {
          const inputText = input.value;
          const outputText = output.value;

          const inputBytes =
            new Blob([inputText]).size;

          const outputBytes =
            new Blob([outputText]).size;

          const inLines = countLines(inputText);
          const outLines = countLines(outputText);

          inputSize.textContent = formatBytes(inputBytes);
          outputSize.textContent = formatBytes(outputBytes);

          inputCount.textContent = inLines;
          outputCount.textContent = outLines;

          inputLines.textContent =
            `${inLines} ${inLines === 1 ? "سطر" : "أسطر"}`;

          outputLines.textContent =
            `${outLines} ${outLines === 1 ? "سطر" : "أسطر"}`;
        }


        function showStatus(message, error = false) {
          status.classList.remove("hidden", "error");

          if (error) {
            status.classList.add("error");
            status.innerHTML =
              `<i class="fa-solid fa-circle-exclamation"></i><span>${message}</span>`;
          } else {
            status.innerHTML =
              `<i class="fa-solid fa-circle-check"></i><span>${message}</span>`;
          }

          clearTimeout(window.__statusTimer);

          window.__statusTimer = setTimeout(() => {
            status.classList.add("hidden");
          }, 3500);
        }


        /*
         * Lightweight JavaScript formatter.
         * It handles indentation, braces, semicolons,
         * comments and common JavaScript structures.
         */

        function formatJavaScript(code) {
          let text = code
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .trim();

          if (!text) return "";

          let result = "";
          let indent = 0;

          let inString = null;
          let inTemplate = false;
          let inLineComment = false;
          let inBlockComment = false;

          let current = "";
          let parenDepth = 0;
          let bracketDepth = 0;


          function addIndent() {
            result += "  ".repeat(Math.max(0, indent));
          }


          function flush(trim = true) {
            const value = trim
              ? current.trim()
              : current;

            if (value) {
              addIndent();
              result += value;
            }

            current = "";
          }


          function newline() {
            result = result.replace(/[ \t]+$/g, "");

            if (!result.endsWith("\n")) {
              result += "\n";
            }
          }


          function isEscaped(str, index) {
            let slashCount = 0;

            for (let i = index - 1; i >= 0 && str[i] === "\\"; i--) {
              slashCount++;
            }

            return slashCount % 2 === 1;
          }


          for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            const next = text[i + 1];


            /* Line comment */

            if (inLineComment) {
              current += ch;

              if (ch === "\n") {
                flush();
                newline();
                inLineComment = false;
              }

              continue;
            }


            /* Block comment */

            if (inBlockComment) {
              current += ch;

              if (ch === "*" && next === "/") {
                current += "/";
                i++;
                inBlockComment = false;
                flush();
                newline();
              }

              continue;
            }


            /* Strings */

            if (inString) {
              current += ch;

              if (
                ch === inString &&
                !isEscaped(text, i)
              ) {
                inString = null;
              }

              continue;
            }


            /* Template literal */

            if (inTemplate) {
              current += ch;

              if (
                ch === "`" &&
                !isEscaped(text, i)
              ) {
                inTemplate = false;
              }

              continue;
            }


            /* Start line comment */

            if (ch === "/" && next === "/") {
              if (current.trim()) {
                flush();
              }

              current = "//";
              i++;
              inLineComment = true;
              continue;
            }


            /* Start block comment */

            if (ch === "/" && next === "*") {
              if (current.trim()) {
                flush();
              }

              current = "/*";
              i++;
              inBlockComment = true;
              continue;
            }


            /* Start strings */

            if (ch === "'" || ch === '"') {
              inString = ch;
              current += ch;
              continue;
            }


            if (ch === "`") {
              inTemplate = true;
              current += ch;
              continue;
            }


            /* Parentheses */

            if (ch === "(") {
              parenDepth++;
              current += ch;
              continue;
            }

            if (ch === ")") {
              parenDepth = Math.max(0, parenDepth - 1);
              current = current.replace(/\s+$/g, "") + ")";
              continue;
            }


            /* Brackets */

            if (ch === "[") {
              bracketDepth++;
              current += ch;
              continue;
            }

            if (ch === "]") {
              bracketDepth = Math.max(0, bracketDepth - 1);
              current = current.replace(/\s+$/g, "") + "]";
              continue;
            }


            /* Opening brace */

            if (ch === "{") {
              current = current.replace(/\s+$/g, "");

              if (current.trim()) {
                current += " {";
                flush();
              } else {
                addIndent();
                result += "{";
              }

              newline();

              indent++;

              continue;
            }


            /* Closing brace */

            if (ch === "}") {
              if (current.trim()) {
                flush();
                newline();
              }

              indent = Math.max(0, indent - 1);

              addIndent();
              result += "}";

              if (
                next !== ";" &&
                next !== "," &&
                next !== ")" &&
                next !== "]" &&
                next !== "."
              ) {
                newline();
              }

              continue;
            }


            /* Semicolon */

            if (
              ch === ";" &&
              parenDepth === 0 &&
              bracketDepth === 0
            ) {
              current = current.replace(/\s+$/g, "");
              current += ";";

              flush();
              newline();

              continue;
            }


            /* New line */

            if (ch === "\n") {
              if (current.trim()) {
                flush();
                newline();
              }

              continue;
            }


            current += ch;
          }


          if (current.trim()) {
            flush();
          }


          let formatted = result
            .replace(/[ \t]+\n/g, "\n")
            .replace(/\n{3,}/g, "\n\n")
            .trim();


          /*
           * Basic spacing improvements.
           */

          formatted = formatted
            .replace(/,\s*/g, ", ")
            .replace(/\b(if|for|while|switch|catch)\s*\(/g, "$1 (")
            .replace(/\b(function)\s+([A-Za-z_$][\w$]*)\s*\(/g, "$1 $2(");


          return formatted;
        }


        formatBtn.addEventListener("click", () => {
          const code = input.value.trim();

          if (!code) {
            output.value = "";
            updateStats();

            showStatus("أدخل كود JavaScript أولاً.", true);
            return;
          }

          try {
            const formatted = formatJavaScript(code);

            output.value = formatted;

            updateStats();

            showStatus("تم تنسيق كود JavaScript بنجاح.");
          } catch (error) {
            showStatus(
              "حدث خطأ أثناء تنسيق الكود.",
              true
            );
          }
        });


        copyBtn.addEventListener("click", async () => {
          const code = output.value;

          if (!code) {
            showStatus("لا يوجد كود لنسخه.", true);
            return;
          }

          try {
            await navigator.clipboard.writeText(code);

            showStatus("تم نسخ الكود المنسق.");
          } catch {
            output.select();
            document.execCommand("copy");

            showStatus("تم نسخ الكود المنسق.");
          }
        });


        clearBtn.addEventListener("click", () => {
          input.value = "";
          output.value = "";

          updateStats();

          status.classList.add("hidden");

          input.focus();
        });


        input.addEventListener("input", updateStats);

        updateStats();
      })();
    </script>

  </body>
</html>
