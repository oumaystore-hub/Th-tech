<script>

const input =
  document.getElementById("input");

const output =
  document.getElementById("output");

const status =
  document.getElementById("status");

const inputStats =
  document.getElementById("inputStats");

const outputStats =
  document.getElementById("outputStats");


const example = {
  name: "Th.Tech",
  website: "Developer Tools",
  language: "Arabic",
  free: true,
  tools: [
    "JSON Formatter",
    "JSON Validator",
    "HTML Formatter"
  ],
  features: {
    fast: true,
    private: true,
    responsive: true
  }
};


function updateStats() {

  inputStats.textContent =
    `${input.value.length} chars`;

  outputStats.textContent =
    `${output.value.length} chars`;

}


function showStatus(message, type = "info") {

  const icons = {
    info: "fa-circle-info",
    success: "fa-circle-check",
    error: "fa-circle-xmark"
  };

  status.className =
    `status ${type}`;

  status.innerHTML =
    `<i class="fas ${icons[type]}"></i> ${message}`;

}


function parseJSON() {

  try {

    return JSON.parse(input.value);

  } catch (error) {

    throw error;

  }

}


function formatJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    const data = parseJSON();

    output.value =
      JSON.stringify(data, null, 2);

    showStatus(
      "تم تنسيق JSON بنجاح.",
      "success"
    );

    updateStats();

  } catch (error) {

    output.value = "";

    showStatus(
      getJSONError(error),
      "error"
    );

    updateStats();

  }

}


function minifyJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    const data = parseJSON();

    output.value =
      JSON.stringify(data);

    showStatus(
      "تم تصغير JSON بنجاح.",
      "success"
    );

    updateStats();

  } catch (error) {

    showStatus(
      getJSONError(error),
      "error"
    );

  }

}


function validateJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    JSON.parse(input.value);

    showStatus(
      "JSON صالح ولا توجد أخطاء في البنية.",
      "success"
    );

  } catch (error) {

    showStatus(
      getJSONError(error),
      "error"
    );

  }

}


function getJSONError(error) {

  const message =
    error?.message || "JSON غير صالح.";

  const match =
    message.match(/position (\d+)/i);

  if (match) {

    const position =
      Number(match[1]);

    const before =
      input.value.slice(0, position);

    const line =
      before.split("\n").length;

    const column =
      position -
      before.lastIndexOf("\n");

    return `JSON غير صالح — السطر ${line}، العمود ${column}.`;

  }

  return `JSON غير صالح: ${message}`;

}


async function copyOutput() {

  const text =
    output.value;

  if (!text) {

    showStatus(
      "لا توجد نتيجة لنسخها.",
      "error"
    );

    return;

  }

  try {

    await navigator.clipboard.writeText(text);

    showStatus(
      "تم نسخ JSON إلى الحافظة.",
      "success"
    );

  } catch {

    output.select();

    document.execCommand("copy");

    showStatus(
      "تم نسخ JSON.",
      "success"
    );

  }

}


function loadExample() {

  input.value =
    JSON.stringify(example, null, 2);

  output.value = "";

  updateStats();

  showStatus(
    "تم تحميل المثال.",
    "info"
  );

}


function clearAll() {

  input.value = "";

  output.value = "";

  updateStats();

  showStatus(
    "تم مسح المحتوى.",
    "info"
  );

}


document
  .getElementById("formatBtn")
  .addEventListener("click", formatJSON);


document
  .getElementById("minifyBtn")
  .addEventListener("click", minifyJSON);


document
  .getElementById("validateBtn")
  .addEventListener("click", validateJSON);


document
  .getElementById("copyBtn")
  .addEventListener("click", copyOutput);


document
  .getElementById("exampleBtn")
  .addEventListener("click", loadExample);


document
  .getElementById("clearBtn")
  .addEventListener("click", clearAll);


input.addEventListener(
  "input",
  updateStats
);


input.addEventListener(
  "keydown",
  (event) => {

    if (
      event.ctrlKey &&
      event.key === "Enter"
    ) {

      event.preventDefault();

      formatJSON();

    }

  }
);


updateStats();

</script>

</body>
</html>


