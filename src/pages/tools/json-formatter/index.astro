---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JSON Formatter - تنسيق JSON أونلاين مجاناً | Th.Tech";

const description =
  "أداة JSON Formatter مجانية لتنسيق وتجميل JSON والتحقق من صحته وتصغيره ونسخه مباشرة من المتصفح.";
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={`https://oumaystore-hub.github.io${base}/tools/json-formatter/`}
  />

  <link
    rel="icon"
    type="image/png"
    href={`${base}/logo1.png`}
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

</head>

<body>

  <Header />

  <main class="page">

    <!-- HEADER -->

    <section class="tool-hero">

      <div class="breadcrumb">

        <a href={`${base}/`}>
          الرئيسية
        </a>

        <i class="fas fa-chevron-left"></i>

        <a href={`${base}/tools/`}>
          أدوات المطورين
        </a>

        <i class="fas fa-chevron-left"></i>

        <span>JSON Formatter</span>

      </div>


      <div class="tool-title">

        <div class="tool-icon">
          <i class="fas fa-code"></i>
        </div>

        <div>

          <span class="eyebrow">
            DEVELOPER TOOL
          </span>

          <h1>
            JSON Formatter
          </h1>

          <p>
            نسّق JSON، تحقّق من صحته، صغّره وانسخه بسهولة.
          </p>

        </div>

      </div>

    </section>


    <!-- TOOL -->

    <section class="workspace">

      <div class="toolbar">

        <div class="toolbar-group">

          <button id="formatBtn" class="primary">
            <i class="fas fa-wand-magic-sparkles"></i>
            تنسيق
          </button>

          <button id="minifyBtn">
            <i class="fas fa-compress"></i>
            Minify
          </button>

          <button id="validateBtn">
            <i class="fas fa-circle-check"></i>
            تحقق
          </button>

        </div>


        <div class="toolbar-group">

          <button id="exampleBtn">
            <i class="fas fa-flask"></i>
            مثال
          </button>

          <button id="copyBtn">
            <i class="fas fa-copy"></i>
            نسخ
          </button>

          <button id="clearBtn">
            <i class="fas fa-trash"></i>
            مسح
          </button>

        </div>

      </div>


      <div
        id="status"
        class="status"
        aria-live="polite"
      >
        <i class="fas fa-circle-info"></i>
        أدخل JSON ثم اضغط «تنسيق».
      </div>


      <div class="editor-grid">

        <!-- INPUT -->

        <div class="editor-card">

          <div class="editor-header">

            <span>
              <i class="fas fa-pen"></i>
              JSON INPUT
            </span>

            <span id="inputStats">
              0 chars
            </span>

          </div>

          <textarea
            id="input"
            spellcheck="false"
            placeholder={`{
  "name": "Th.Tech",
  "type": "Developer Tools"
}`}
          ></textarea>

        </div>


        <!-- OUTPUT -->

        <div class="editor-card">

          <div class="editor-header">

            <span>
              <i class="fas fa-code"></i>
              FORMATTED JSON
            </span>

            <span id="outputStats">
              0 chars
            </span>

          </div>

          <textarea
            id="output"
            readonly
            spellcheck="false"
            placeholder="ستظهر النتيجة هنا..."
          ></textarea>

        </div>

      </div>

    </section>


    <!-- INFO -->

    <section class="info">

      <h2>
        JSON Formatter أونلاين
      </h2>

      <p>
        JSON Formatter من Th.Tech هي أداة مجانية تساعد المطورين
        على قراءة ملفات JSON وترتيبها بسرعة. يمكنك تنسيق البيانات
        المضغوطة، التحقق من صحة JSON، أو استخدام Minify لتقليل حجمها.
      </p>

      <div class="info-grid">

        <div>
          <i class="fas fa-bolt"></i>
          <strong>سريعة</strong>
          <span>معالجة مباشرة داخل المتصفح.</span>
        </div>

        <div>
          <i class="fas fa-lock"></i>
          <strong>خصوصية</strong>
          <span>لا تحتاج إلى رفع ملفك إلى خادم.</span>
        </div>

        <div>
          <i class="fas fa-mobile-screen"></i>
          <strong>متجاوبة</strong>
          <span>تعمل على الهاتف والكمبيوتر.</span>
        </div>

      </div>

    </section>

  </main>

  <Footer />


<script>

const input =
  document.getElementById("input");

const output =
  document.getElementById("output");

const status =
  document.getElementById("status");

const inputStats =
  document.getElementById("inputStats");

const outputStats =
  document.getElementById("outputStats");


const example = {
  name: "Th.Tech",
  website: "Developer Tools",
  language: "Arabic",
  free: true,
  tools: [
    "JSON Formatter",
    "JSON Validator",
    "HTML Formatter"
  ],
  features: {
    fast: true,
    private: true,
    responsive: true
  }
};


function updateStats() {

  inputStats.textContent =
    `${input.value.length} chars`;

  outputStats.textContent =
    `${output.value.length} chars`;

}


function showStatus(message, type = "info") {

  const icons = {
    info: "fa-circle-info",
    success: "fa-circle-check",
    error: "fa-circle-xmark"
  };

  status.className =
    `status ${type}`;

  status.innerHTML =
    `<i class="fas ${icons[type]}"></i> ${message}`;

}


function parseJSON() {

  try {

    return JSON.parse(input.value);

  } catch (error) {

    throw error;

  }

}


function formatJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    const data = parseJSON();

    output.value =
      JSON.stringify(data, null, 2);

    showStatus(
      "تم تنسيق JSON بنجاح.",
      "success"
    );

    updateStats();

  } catch (error) {

    output.value = "";

    showStatus(
      getJSONError(error),
      "error"
    );

    updateStats();

  }

}


function minifyJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    const data = parseJSON();

    output.value =
      JSON.stringify(data);

    showStatus(
      "تم تصغير JSON بنجاح.",
      "success"
    );

    updateStats();

  } catch (error) {

    showStatus(
      getJSONError(error),
      "error"
    );

  }

}


function validateJSON() {

  if (!input.value.trim()) {

    showStatus(
      "يرجى إدخال JSON أولاً.",
      "error"
    );

    return;

  }

  try {

    JSON.parse(input.value);

    showStatus(
      "JSON صالح ولا توجد أخطاء في البنية.",
      "success"
    );

  } catch (error) {

    showStatus(
      getJSONError(error),
      "error"
    );

  }

}


function getJSONError(error) {

  const message =
    error?.message || "JSON غير صالح.";

  const match =
    message.match(/position (\d+)/i);

  if (match) {

    const position =
      Number(match[1]);

    const before =
      input.value.slice(0, position);

    const line =
      before.split("\n").length;

    const column =
      position -
      before.lastIndexOf("\n");

    return `JSON غير صالح — السطر ${line}، العمود ${column}.`;

  }

  return `JSON غير صالح: ${message}`;

}


async function copyOutput() {

  const text =
    output.value;

  if (!text) {

    showStatus(
      "لا توجد نتيجة لنسخها.",
      "error"
    );

    return;

  }

  try {

    await navigator.clipboard.writeText(text);

    showStatus(
      "تم نسخ JSON إلى الحافظة.",
      "success"
    );

  } catch {

    output.select();

    document.execCommand("copy");

    showStatus(
      "تم نسخ JSON.",
      "success"
    );

  }

}


function loadExample() {

  input.value =
    JSON.stringify(example, null, 2);

  output.value = "";

  updateStats();

  showStatus(
    "تم تحميل المثال.",
    "info"
  );

}


function clearAll() {

  input.value = "";

  output.value = "";

  updateStats();

  showStatus(
    "تم مسح المحتوى.",
    "info"
  );

}


document
  .getElementById("formatBtn")
  .addEventListener("click", formatJSON);


document
  .getElementById("minifyBtn")
  .addEventListener("click", minifyJSON);


document
  .getElementById("validateBtn")
  .addEventListener("click", validateJSON);


document
  .getElementById("copyBtn")
  .addEventListener("click", copyOutput);


document
  .getElementById("exampleBtn")
  .addEventListener("click", loadExample);


document
  .getElementById("clearBtn")
  .addEventListener("click", clearAll);


input.addEventListener(
  "input",
  updateStats
);


input.addEventListener(
  "keydown",
  (event) => {

    if (
      event.ctrlKey &&
      event.key === "Enter"
    ) {

      event.preventDefault();

      formatJSON();

    }

  }
);


updateStats();

</script>

</body>
</html>


<style>

:root {

  --bg: #f6f8fb;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --soft: #f1f5f9;
  --primary: #2563eb;

}


* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


body {

  background: var(--bg);
  color: var(--text);

  font-family:
    "Cairo",
    sans-serif;

  line-height: 1.7;

}


.page {

  width:
    min(
      1180px,
      calc(100% - 32px)
    );

  margin: auto;

  padding:
    35px 0 70px;

}


/* BREADCRUMB */

.breadcrumb {

  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 30px;

  color: var(--muted);

  font-size: 11px;

}

.breadcrumb a {

  color: var(--primary);

  text-decoration: none;

}

.breadcrumb i {

  font-size: 8px;

}


/* TITLE */

.tool-title {

  display: flex;
  align-items: center;
  gap: 17px;

  margin-bottom: 30px;

}

.tool-icon {

  width: 65px;
  height: 65px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 17px;

  background:
    rgba(37, 99, 235, .10);

  color: var(--primary);

  font-size: 27px;

  flex: none;

}

.eyebrow {

  display: block;

  color: var(--primary);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.2px;

}

.tool-title h1 {

  font-size: 30px;

  font-weight: 800;

  line-height: 1.3;

}

.tool-title p {

  color: var(--muted);

  font-size: 13px;

  margin-top: 3px;

}


/* WORKSPACE */

.workspace {

  background: var(--card);

  border:
    1px solid var(--border);

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 20px 60px
    rgba(15, 23, 42, .07);

}


/* TOOLBAR */

.toolbar {

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 12px;

  border-bottom:
    1px solid var(--border);

  background: var(--soft);

}

.toolbar-group {

  display: flex;

  gap: 7px;

  flex-wrap: wrap;

}

.toolbar button {

  height: 37px;

  display: flex;
  align-items: center;

  gap: 7px;

  padding:
    0 13px;

  border:
    1px solid var(--border);

  border-radius: 8px;

  background: var(--card);

  color: var(--text);

  font-family: inherit;

  font-size: 11px;

  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;

}

.toolbar button:hover {

  border-color:
    var(--primary);

  color:
    var(--primary);

}

.toolbar button.primary {

  background:
    var(--primary);

  border-color:
    var(--primary);

  color: white;

}


/* STATUS */

.status {

  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 43px;

  padding:
    8px 15px;

  border-bottom:
    1px solid var(--border);

  color: var(--muted);

  font-size: 11px;

}

.status.success {

  color: #15803d;

  background:
    rgba(34, 197, 94, .06);

}

.status.error {

  color: #dc2626;

  background:
    rgba(239, 68, 68, .06);

}


/* EDITORS */

.editor-grid {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  min-height: 480px;

}

.editor-card {

  display: flex;

  flex-direction: column;

  min-width: 0;

}

.editor-card + .editor-card {

  border-right:
    1px solid var(--border);

}


.editor-header {

  height: 43px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding:
    0 13px;

  background: var(--soft);

  border-bottom:
    1px solid var(--border);

  color: var(--muted);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .7px;

}

.editor-header span:first-child {

  display: flex;

  align-items: center;

  gap: 7px;

}

.editor-header i {

  color: var(--primary);

}


.editor-header span:last-child {

  font-family:
    "Fira Code",
    monospace;

  font-size: 9px;

}


textarea {

  flex: 1;

  width: 100%;

  min-height: 437px;

  resize: none;

  border: 0;

  outline: 0;

  padding: 18px;

  background: var(--card);

  color: var(--text);

  direction: ltr;

  text-align: left;

  font:
    13px / 1.8
    "Fira Code",
    monospace;

  tab-size: 2;

}

textarea::placeholder {

  color: #94a3b8;

}

textarea:focus {

  background:
    #fbfdff;

}


/* INFO */

.info {

  margin-top: 50px;

  text-align: center;

}

.info h2 {

  font-size: 25px;

  font-weight: 800;

}

.info > p {

  max-width: 750px;

  margin:
    10px auto;

  color: var(--muted);

  font-size: 13px;

}

.info-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;

  margin-top: 25px;

}

.info-grid div {

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 3px;

  padding: 20px;

  border:
    1px solid var(--border);

  border-radius: 13px;

  background: var(--card);

}

.info-grid i {

  color: var(--primary);

  font-size: 20px;

  margin-bottom: 5px;

}

.info-grid strong {

  font-size: 13px;

}

.info-grid span {

  color: var(--muted);

  font-size: 10px;

}


/* MOBILE */

@media (max-width: 800px) {

  .editor-grid {

    grid-template-columns: 1fr;

  }

  .editor-card + .editor-card {

    border-right: 0;

    border-top:
      1px solid var(--border);

  }

  .toolbar {

    flex-direction: column;

    align-items: stretch;

  }

  .toolbar-group {

    justify-content: center;

  }

}


@media (max-width: 600px) {

  .page {

    width:
      calc(100% - 16px);

    padding-top: 22px;

  }

  .tool-title h1 {

    font-size: 24px;

  }

  .tool-icon {

    width: 54px;
    height: 54px;

    font-size: 22px;

  }

  .breadcrumb {

    overflow-x: auto;

    white-space: nowrap;

  }

  .toolbar button {

    flex: 1;

    justify-content: center;

  }

  .info-grid {

    grid-template-columns: 1fr;

  }

}

</style>
