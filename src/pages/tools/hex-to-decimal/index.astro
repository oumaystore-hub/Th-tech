    <script is:inline>
      (() => {
        const input = document.getElementById("hexInput");
        const output = document.getElementById("decimalOutput");

        const hexStats = document.getElementById("hexStats");
        const hexChars = document.getElementById("hexChars");
        const decimalDigits = document.getElementById("decimalDigits");

        const statHex = document.getElementById("statHex");
        const statDecimal = document.getElementById("statDecimal");
        const statBytes = document.getElementById("statBytes");
        const statValid = document.getElementById("statValid");

        const status = document.getElementById("status");

        const sampleBtn = document.getElementById("sampleBtn");
        const convertBtn = document.getElementById("convertBtn");
        const copyBtn = document.getElementById("copyBtn");
        const clearBtn = document.getElementById("clearBtn");

        if (!input || !output) return;

        function showStatus(message, type = "info") {
          let icon = "fa-circle-info";

          if (type === "success") {
            icon = "fa-circle-check";
          }

          if (type === "error") {
            icon = "fa-triangle-exclamation";
          }

          status.innerHTML =
            '<i class="fa-solid ' +
            icon +
            '"></i> ' +
            message;

          status.className = "status " + type;
        }

        function cleanHex(value) {
          return value
            .replace(/\s+/gu, "")
            .replace(/^0x/iu, "");
        }

        function isValidHex(value) {
          if (!value) return false;

          return /^[0-9a-f]+$/iu.test(value);
        }

        function updateStats() {
          const raw = input.value || "";
          const hex = cleanHex(raw);

          const digits = hex.length;
          const chars = raw.length;

          hexStats.textContent =
            digits.toLocaleString("en-US") + " digits";

          hexChars.textContent =
            chars.toLocaleString("ar") + " حرف";

          statHex.textContent =
            digits.toLocaleString("en-US");

          const valid = !hex
            ? 0
            : isValidHex(hex)
              ? 100
              : 0;

          statValid.textContent = valid + "%";

          if (output.value) {
            const decimalLength = output.value.length;

            decimalDigits.textContent =
              decimalLength.toLocaleString("ar") + " رقم";

            statDecimal.textContent =
              decimalLength.toLocaleString("en-US");
          } else {
            decimalDigits.textContent = "0 رقم";
            statDecimal.textContent = "0";
          }

          if (digits > 0) {
            statBytes.textContent =
              Math.ceil(digits / 2).toLocaleString("en-US");
          } else {
            statBytes.textContent = "0";
          }
        }

        function convert() {
          const hex = cleanHex(input.value);

          if (!hex) {
            output.value = "";

            updateStats();

            showStatus(
              "أدخل قيمة Hexadecimal أولاً.",
              "error"
            );

            return;
          }

          if (!isValidHex(hex)) {
            output.value = "";

            updateStats();

            showStatus(
              "القيمة غير صحيحة. استخدم فقط الأرقام 0-9 والحروف A-F.",
              "error"
            );

            return;
          }

          try {
            const decimal = BigInt("0x" + hex);

            output.value = decimal.toString(10);

            updateStats();

            showStatus(
              "تم تحويل Hexadecimal إلى Decimal بنجاح.",
              "success"
            );
          } catch {
            output.value = "";

            updateStats();

            showStatus(
              "تعذر تحويل القيمة المدخلة.",
              "error"
            );
          }
        }

        sampleBtn.addEventListener("click", function() {
          input.value = "1A3F";

          convert();

          input.focus();
        });

        convertBtn.addEventListener("click", convert);

        clearBtn.addEventListener("click", function() {
          input.value = "";
          output.value = "";

          updateStats();

          showStatus(
            "تم مسح القيمة والنتيجة.",
            "info"
          );

          input.focus();
        });

        copyBtn.addEventListener("click", async function() {
          const value = output.value;

          if (!value) {
            showStatus(
              "لا توجد نتيجة لنسخها. قم بالتحويل أولاً.",
              "error"
            );

            return;
          }

          try {
            await navigator.clipboard.writeText(value);

            showStatus(
              "تم نسخ النتيجة بنجاح.",
              "success"
            );
          } catch {
            output.select();
            document.execCommand("copy");

            showStatus(
              "تم نسخ النتيجة بنجاح.",
              "success"
            );
          }
        });

        input.addEventListener("input", function() {
          updateStats();

          if (!input.value.trim()) {
            output.value = "";

            showStatus(
              "أدخل قيمة Hexadecimal للبدء.",
              "info"
            );

            updateStats();
          }
        });

        input.addEventListener("keydown", function(event) {
          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {
            convert();
          }
        });

        function syncTheme() {
          try {
            const saved = localStorage.getItem("theme");

            if (saved === "dark") {
              document.documentElement.classList.add("dark-mode");
            } else {
              document.documentElement.classList.remove("dark-mode");
            }
          } catch {}
        }

        syncTheme();

        window.addEventListener("themeChange", syncTheme);

        document.addEventListener("click", function(event) {
          const target = event.target;

          if (
            target &&
            (
              target.id === "theme-btn" ||
              target.closest("#theme-btn")
            )
          ) {
            setTimeout(syncTheme, 0);
          }
        });

        updateStats();
      })();
    </script>

