        border-bottom: 1px solid var(--border);
      }

      .example-row:last-child {
        border-bottom: 0;
      }

      .example-row span,
      .example-row code {
        padding: 13px 17px;
      }

      .example-row span {
        font-size: 12px;
        font-weight: 800;
      }

      .example-row.header {
        background: rgba(37, 99, 235, 0.08);
      }

      .example-row code {
        color: var(--primary);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        border-left: 1px solid var(--border);
      }

      .example-row:not(.header) code:last-child {
        color: var(--text);
      }

      .faq-list {
        display: grid;
        gap: 10px;
      }

      details {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--surface);
        overflow: hidden;
      }

      summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 18px;
        cursor: pointer;
        list-style: none;
        font-weight: 700;
        font-size: 13px;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary i {
        color: var(--primary);
        transition: 0.2s;
      }

      details[open] summary i {
        transform: rotate(180deg);
      }

      details p {
        margin: 0;
        padding: 0 18px 18px;
        color: var(--muted);
        line-height: 1.9;
        font-size: 12px;
      }

      @media (max-width: 950px) {
        .editor-grid {
          grid-template-columns: 1fr;
        }

        .conversion-arrow {
          flex-direction: row;
          min-height: 55px;
        }

        .conversion-arrow span {
          writing-mode: horizontal-tb;
          transform: none;
        }

        .conversion-arrow div {
          width: 45px;
          height: 45px;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 800px) {
        .info-grid,
        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .page {
          padding: 20px 12px 55px;
        }

        .hero {
          align-items: flex-start;
        }

        .hero-icon {
          width: 62px;
          height: 62px;
          flex-basis: 62px;
          border-radius: 18px;
          font-size: 25px;
        }

        .hero h1 {
          font-size: 30px;
        }

        .tool-card {
          padding: 17px;
          border-radius: 19px;
        }

        .tool-header {
          flex-direction: column;
        }

        .settings-bar {
          justify-content: space-between;
          gap: 8px;
        }

        .setting-item > i {
          width: 32px;
          height: 32px;
        }

        .setting-item strong {
          font-size: 10px;
        }

        .setting-arrow {
          width: 30px;
          height: 30px;
        }

        textarea {
          min-height: 300px;
          font-size: 13px;
        }

        .actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .actions .primary-btn {
          grid-column: span 2;
          order: -1;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .privacy-card {
          align-items: flex-start;
        }

        .section-title.centered {
          justify-content: flex-start;
        }
      }

      @media (max-width: 390px) {
        .actions {
          grid-template-columns: 1fr;
        }

        .actions .primary-btn {
          grid-column: auto;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .setting-item span {
          display: none;
        }
      }
    </style>
  </body>
</html>
