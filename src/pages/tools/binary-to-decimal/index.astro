      :global(body.dark-mode) .faq-list details {
        background: #0b1726;
        border-color: #1c3046;
      }

      .faq-list summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 0;
        cursor: pointer;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-list summary::-webkit-details-marker {
        display: none;
      }

      .faq-list summary i {
        color: #0284c7;
        font-size: 11px;
        transition: 0.2s;
      }

      .faq-list details[open] summary i {
        transform: rotate(180deg);
      }

      .faq-list p {
        margin: 0;
        padding: 0 0 17px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.9;
      }

      @media (max-width: 900px) {
        .editor-grid {
          grid-template-columns: 1fr;
        }

        .conversion-arrow {
          transform: rotate(-90deg);
          height: 45px;
        }

        .stats-grid,
        .info-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1180px);
        }

        .hero {
          padding: 35px 0 55px;
        }

        .tool-section {
          padding-top: 30px;
        }

        .tool-card {
          padding: 14px;
          border-radius: 18px;
        }

        .tool-header {
          align-items: flex-start;
          flex-direction: column;
        }

        .settings-bar {
          gap: 12px;
        }

        textarea {
          min-height: 240px;
        }

        .stats-grid,
        .info-grid {
          grid-template-columns: 1fr 1fr;
        }

        .action {
          flex: 1 1 100%;
        }

        .privacy-card {
          align-items: flex-start;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 50px 0;
        }
      }
    </style>

    <script is:inline>
      const binaryInput = document.getElementById('binaryInput');
      const decimalOutput = document.getElementById('decimalOutput');

      const convertBtn = document.getElementById('convert-btn');
      const mainConvert = document.getElementById('main-convert');

      const exampleBtn = document.getElementById('example-btn');
      const exampleBtnTop = document.getElementById('example-btn-top');

      const resetBtn = document.getElementById('reset-btn');
      const clearInput = document.getElementById('clear-input');
      const copyBtn = document.getElementById('copy-btn');
      const downloadBtn = document.getElementById('download-btn');

      const binaryStats = document.getElementById('binaryStats');
      const decimalStats = document.getElementById('decimalStats');

      const statBits = document.getElementById('stat-bits');
      const statBytes = document.getElementById('stat-bytes');
      const statDecimal = document.getElementById('stat-decimal');
      const statValid = document.getElementById('stat-valid');

      const message = document.getElementById('message');

      function showMessage(text, type = '') {
        message.textContent = text;
        message.className = `message ${type}`;

        if (text) {
          setTimeout(() => {
            if (message.textContent === text) {
              message.textContent = '';
              message.className = 'message';
            }
          }, 3000);
        }
      }

      function updateStats(bits, decimalValue, valid = 0) {
        const bitCount = bits ? bits.length : 0;
        const byteCount = bitCount > 0 ? Math.ceil(bitCount / 8) : 0;
        const decimalLength = decimalValue ? decimalValue.length : 0;

        binaryStats.textContent = `${bitCount.toLocaleString()} bits`;
        decimalStats.textContent = `${decimalLength.toLocaleString()} digits`;

        statBits.textContent = bitCount.toLocaleString();
        statBytes.textContent = byteCount.toLocaleString();
        statDecimal.textContent = decimalValue || '0';
        statValid.textContent = `${valid}%`;
      }

      function convertBinaryToDecimal() {
        const raw = binaryInput.value.trim();

        if (!raw) {
          decimalOutput.value = '';
          updateStats('', '', 0);
          showMessage('');
          return;
        }

        /*
         * يسمح بالمسافات بين مجموعات Binary،
         * مثل:
         * 11111111
         * 1111 1111
         */
        const binary = raw.replace(/\s+/g, '');

        if (!/^[01]+$/.test(binary)) {
          decimalOutput.value = '';
          updateStats(binary, '', 0);

          showMessage(
            'الإدخال غير صالح. استخدم الرقمين 0 و1 فقط.',
            'error'
          );

          return;
        }

        try {
          const decimal = BigInt(`0b${binary}`);
          const result = decimal.toString(10);

          decimalOutput.value = result;

          updateStats(binary, result, 100);

          showMessage(
            'تم تحويل Binary إلى Decimal بنجاح.',
            'success'
          );
        } catch {
          decimalOutput.value = '';
          updateStats(binary, '', 0);

          showMessage(
            'تعذر تحويل الرقم الثنائي. تحقق من القيمة المدخلة.',
            'error'
          );
        }
      }

      async function copyOutput() {
        if (!decimalOutput.value) {
          showMessage('لا توجد نتيجة لنسخها.', 'error');
          return;
        }

        try {
          await navigator.clipboard.writeText(decimalOutput.value);
          showMessage('تم نسخ الرقم العشري إلى الحافظة.', 'success');
        } catch {
          decimalOutput.select();
          document.execCommand('copy');
          showMessage('تم نسخ الرقم العشري.', 'success');
        }
      }

      function downloadDecimal() {
        if (!decimalOutput.value) {
          showMessage('لا توجد نتيجة لتنزيلها.', 'error');
          return;
        }

        const blob = new Blob([decimalOutput.value], {
          type: 'text/plain;charset=utf-8'
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = 'binary-to-decimal.txt';

        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);

        showMessage('تم تنزيل الملف بنجاح.', 'success');
      }

      function loadExample() {
        binaryInput.value = '11111111';
        convertBinaryToDecimal();
        binaryInput.focus();
      }

      function resetTool() {
        binaryInput.value = '';
        decimalOutput.value = '';

        updateStats('', '', 0);
        showMessage('');

        binaryInput.focus();
      }

      convertBtn.addEventListener('click', convertBinaryToDecimal);
      mainConvert.addEventListener('click', convertBinaryToDecimal);

      exampleBtn.addEventListener('click', loadExample);
      exampleBtnTop.addEventListener('click', loadExample);

      resetBtn.addEventListener('click', resetTool);
      clearInput.addEventListener('click', resetTool);

      copyBtn.addEventListener('click', copyOutput);
      downloadBtn.addEventListener('click', downloadDecimal);

      binaryInput.addEventListener('input', () => {
        const binary = binaryInput.value.trim().replace(/\s+/g, '');

        binaryStats.textContent = `${binary.length.toLocaleString()} bits`;

        if (!binaryInput.value.trim()) {
          decimalOutput.value = '';
          updateStats('', '', 0);
          return;
        }

        convertBinaryToDecimal();
      });

      binaryInput.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
          event.preventDefault();
          convertBinaryToDecimal();
        }
      });

      function syncTheme() {
        const isDark =
          document.documentElement.classList.contains('dark-mode') ||
          document.body.classList.contains('dark-mode');

        document.body.classList.toggle('dark-mode', isDark);
      }

      syncTheme();

      window.addEventListener('storage', syncTheme);

      const observer = new MutationObserver(syncTheme);

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });

      observer.observe(document.body, {
        attributes: true,
        attributeFilter: ['class']
      });
    </script>
  </body>
</html>
