---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = "مسارات التعلم - Th.Tech";
export const description = "مسارات تعلم منظمة من المبتدئ إلى المتقدم في البرمجة، الشبكات، الذكاء الاصطناعي، وأكثر";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="learning-paths-page">
    <div class="hero-section">
      <h1>🎯 مسارات التعلم</h1>
      <p>اختر مسارك التقني وابدأ رحلتك من الصفر حتى الاحتراف</p>
    </div>

    <!-- ✅ مسار أمان Windows -->
    <section class="path-card" id="windows-security">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🔐</span>
        <div>
          <h2>أمان Windows المتقدم</h2>
          <p>من التشفير إلى الاستجابة للحوادث (5000+ كلمة)</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="windows-security" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الحماية والتشفير</h3>
          <ul>
            <li id="task-part1">✅ الجزء 1: حماية العتاد وتشفير البيانات</li>
            <li id="task-part2">✅ الجزء 2: الدفاع الاستباقي (Defender)</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part1" class="path-link">ابدأ القراءة ←</a>
        </div>
        <div class="level intermediate" data-path="windows-security" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>تأمين الهوية والتدقيق</h3>
          <ul>
            <li id="task-part3">✅ الجزء 3: تأمين الهوية والصلاحيات</li>
            <li id="task-part4">✅ الجزء 4: التدقيق والبحث عن التهديدات</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part3" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="windows-security" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>الاستجابة و Zero Trust</h3>
          <ul>
            <li id="task-part5">✅ الجزء 5: خطة الاستجابة للحوادث</li>
            <li id="task-part6">✅ الجزء 6: تأمين PowerShell</li>
            <li id="task-part7">✅ الجزء 7: Zero Trust والسحابة</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part5" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار Android -->
    <section class="path-card" id="android-path">
      <div class="path-header" style="background: linear-gradient(135deg, #3ddc84, #00c853)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>تطوير وأمن Android</h2>
          <p>من الأساسيات إلى معمارية النظام والأداء</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="android" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات Android</h3>
          <ul>
            <li id="task-android-basic">✅ مقدمة في نظام Android</li>
            <li id="task-android-components">✅ المكونات الأساسية (Activity, Service)</li>
          </ul>
          <a href="/Th-tech/android/#part1" class="path-link">ابدأ القراءة ←</a>
        </div>
        <div class="level intermediate" data-path="android" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التطوير المتقدم</h3>
          <ul>
            <li id="task-android-kotlin">✅ Kotlin و Coroutines</li>
            <li id="task-android-compose">✅ Jetpack Compose والواجهات</li>
          </ul>
          <a href="/Th-tech/android/advanced/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="android" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>معمارية النظام والأداء</h3>
          <ul>
            <li id="task-android-zygote">✅ Zygote و ART و Binder</li>
            <li id="task-android-perfetto">✅ تحليل الأداء مع Perfetto</li>
            <li id="task-android-security">✅ الأمان الداخلي (SELinux)</li>
          </ul>
          <a href="/Th-tech/android/architecture-performance/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الشبكات -->
    <section class="path-card" id="networks">
      <div class="path-header" style="background: linear-gradient(135deg, #10b981, #059669)">
        <span class="path-icon">🌐</span>
        <div>
          <h2>الشبكات والاتصالات</h2>
          <p>من أساسيات الشبكات إلى تحليل الأداء والبروتوكولات المتقدمة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="networks" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li id="task-networks-basic">✅ OSI Model و TCP/IP</li>
            <li id="task-networks-ip">✅ IP Addressing و Subnetting</li>
          </ul>
          <a href="/Th-tech/networks/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="networks" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الشبكات المتقدمة</h3>
          <ul>
            <li id="task-networks-ospf">✅ OSPF و BGP للتوجيه</li>
            <li id="task-networks-vlan">✅ VLANs و Firewalls</li>
          </ul>
          <a href="/Th-tech/networks/advanced-network-guide/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="networks" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>تحليل الأداء والبروتوكولات</h3>
          <ul>
            <li id="task-networks-wireshark">✅ تحليل الحزم بـ Wireshark</li>
            <li id="task-networks-telemetry">✅ Streaming Telemetry و QoS</li>
            <li id="task-networks-ha">✅ التوافرية العالية (HA)</li>
          </ul>
          <a href="/Th-tech/networks/performance-protocols/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الذكاء الاصطناعي -->
    <section class="path-card" id="ai-ml">
      <div class="path-header" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>الذكاء الاصطناعي</h2>
          <p>من المفاهيم الأساسية إلى التعلم العميق والنماذج اللغوية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="ai-ml" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>المفاهيم الأساسية</h3>
          <ul>
            <li id="task-ai-basic">✅ Python للمبتدئين</li>
            <li id="task-ai-ml-basics">✅ مبادئ ML والإحصاء</li>
          </ul>
          <a href="/Th-tech/ai/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="ai-ml" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التعلم الآلي</h3>
          <ul>
            <li id="task-ai-sklearn">✅ Scikit-learn والتطبيق</li>
            <li id="task-ai-supervised">✅ التعلم تحت الإشراف</li>
          </ul>
          <a href="/Th-tech/ai/advanced-ai-guide/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="ai-ml" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>التعلم العميق و LLMs</h3>
          <ul>
            <li id="task-ai-deep">✅ الشبكات العصبية و Transformers</li>
            <li id="task-ai-llms">✅ النماذج اللغوية الكبيرة</li>
            <li id="task-ai-rag">✅ RAG و Fine-tuning</li>
          </ul>
          <a href="/Th-tech/ai/ml-deep-learning/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الأمن السيبراني -->
    <section class="path-card" id="cybersec">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🛡️</span>
        <div>
          <h2>الأمن السيبراني</h2>
          <p>من أساسيات الأمان إلى اختبار الاختراق والاستجابة للحوادث</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="cybersec" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الأمان</h3>
          <ul>
            <li id="task-cyber-cia">✅ CIA Triad ونماذج التهديد</li>
            <li id="task-cyber-crypto">✅ التشفير الأساسي والمصادقة</li>
          </ul>
          <a href="/Th-tech/security/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="cybersec" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأمن الدفاعي</h3>
          <ul>
            <li id="task-cyber-siem">✅ SIEM و كشف التهديدات</li>
            <li id="task-cyber-incident">✅ Incident Response الأساسي</li>
          </ul>
          <a href="/Th-tech/security/advanced/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="cybersec" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>اختبار الاختراق والاستجابة</h3>
          <ul>
            <li id="task-cyber-pentest">✅ منهجيات PTES و OWASP</li>
            <li id="task-cyber-forensics">✅ التحليل الجنائي الرقمي</li>
            <li id="task-cyber-purple">✅ Purple Teaming و SOAR</li>
          </ul>
          <a href="/Th-tech/security/pentest-incident-response/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار البرمجة والتطوير -->
    <section class="path-card" id="programming">
      <div class="path-header" style="background: linear-gradient(135deg, #0284c7, #00d4ff)">
        <span class="path-icon">💻</span>
        <div>
          <h2>البرمجة والتطوير</h2>
          <p>من أساسيات البرمجة إلى هندسة البرمجيات والـ DevOps</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="programming" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات البرمجة</h3>
          <ul>
            <li id="task-prog-basics">✅ لغات البرمجة والمفاهيم الأساسية</li>
            <li id="task-prog-oop">✅ OOP و SOLID Principles</li>
          </ul>
          <a href="/Th-tech/programming/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="programming" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-prog-patterns">✅ أنماط التصميم والهندسة النظيفة</li>
            <li id="task-prog-performance">✅ تحسين الأداء والأمان</li>
          </ul>
          <a href="/Th-tech/programming/advanced-programming-guide/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="programming" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>هندسة البرمجيات والـ DevOps</h3>
          <ul>
            <li id="task-prog-arch">✅ Clean Architecture و Microservices</li>
            <li id="task-prog-containers">✅ Docker و Kubernetes</li>
            <li id="task-prog-cicd">✅ CI/CD و GitOps</li>
          </ul>
          <a href="/Th-tech/programming/architecture-devops/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار تقنية 5G -->
    <section class="path-card" id="5g-tech">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon">📡</span>
        <div>
          <h2>تقنية 5G المتقدمة</h2>
          <p>من Network Slicing إلى التطبيقات الصناعية والمدن الذكية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="5g-tech" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات تقنية 5G</h3>
          <ul>
            <li id="task-5g-basics">✅ eMBB و URLLC و mMTC</li>
            <li id="task-5g-architecture">✅ معمارية 5GC و SBA</li>
          </ul>
          <a href="/Th-tech/5g-technology/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="5g-tech" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التقنيات المتقدمة</h3>
          <ul>
            <li id="task-5g-mimo">✅ Massive MIMO و Beamforming</li>
            <li id="task-5g-openran">✅ Open RAN و RIC</li>
          </ul>
          <a href="/Th-tech/5g-technology/advanced/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="5g-tech" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>Network Slicing والتطبيقات</h3>
          <ul>
            <li id="task-5g-slicing">✅ Network Slicing والعزل الأمني</li>
            <li id="task-5g-industrial">✅ الشبكات الخاصة والصناعة 4.0</li>
            <li id="task-5g-v2x">✅ V2X و Telesurgery</li>
          </ul>
          <a href="/Th-tech/5g-technology/network-slicing-applications/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار تطوير التطبيقات المحمولة -->
    <section class="path-card" id="mobile-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon">📱</span>
        <div>
          <h2>تطوير التطبيقات المحمولة</h2>
          <p>من الأساسيات إلى Cross-Platform والهندسة المتقدمة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="mobile-dev" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات Mobile Dev</h3>
          <ul>
            <li id="task-mobile-basics">✅ Native vs Cross-Platform</li>
            <li id="task-mobile-lifecycle">✅ Lifecycle و State Management</li>
          </ul>
          <a href="/Th-tech/mobile/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="mobile-dev" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-mobile-architecture">✅ Clean Architecture و MVVM/MVI</li>
            <li id="task-mobile-cicd">✅ CI/CD والنشر الآلي</li>
          </ul>
          <a href="/Th-tech/mobile/advanced-mobile-guide/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="mobile-dev" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>Cross-Platform Development</h3>
          <ul>
            <li id="task-mobile-flutter">✅ Flutter و State Management</li>
            <li id="task-mobile-rn">✅ React Native و Native Modules</li>
            <li id="task-mobile-kmp">✅ Kotlin Multiplatform</li>
          </ul>
          <a href="/Th-tech/mobile/cross-platform-development/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار نظام iOS (جديد) -->
    <section class="path-card" id="ios-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon"></span>
        <div>
          <h2>نظام iOS المتقدم</h2>
          <p>من SwiftUI إلى الاحتراف والنشر على App Store</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="ios-dev" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات iOS</h3>
          <ul>
            <li id="task-ios-basics">✅ ما هو iOS و Swift</li>
            <li id="task-ios-xcode">✅ Xcode وبيئة التطوير</li>
          </ul>
          <a href="/Th-tech/ios/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="ios-dev" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-ios-swiftui">✅ SwiftUI و State Management</li>
            <li id="task-ios-combine">✅ Combine و Core Data</li>
          </ul>
          <a href="/Th-tech/ios/advanced/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="ios-dev" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>SwiftUI و UIKit المتقدم</h3>
          <ul>
            <li id="task-ios-swiftui-adv">✅ SwiftUI المتقدم و Animations</li>
            <li id="task-ios-uikit">✅ UIKit Interoperability</li>
            <li id="task-ios-publish">✅ النشر على App Store</li>
          </ul>
          <a href="/Th-tech/ios/swiftui-advanced/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار DevOps (موجود مسبقاً) -->
    <section class="path-card" id="devops-path">
      <div class="path-header" style="background: linear-gradient(135deg, #06b6d4, #0891b2)">
        <span class="path-icon">🔄</span>
        <div>
          <h2>DevOps و Cloud</h2>
          <p>من Linux إلى البنية التحتية السحابية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>Linux و Bash</li>
            <li>Git</li>
            <li>مفاهيم CI/CD</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأتمتة</h3>
          <ul>
            <li>Docker</li>
            <li>Kubernetes</li>
            <li>Terraform</li>
            <li>AWS Basics</li>
          </ul>
          <a href="/Th-tech/cloud/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>البنية المتقدمة</h3>
          <ul>
            <li>Service Mesh</li>
            <li>GitOps</li>
            <li>Serverless</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ قسم الإنجازات والشارات -->
    <section class="achievements-section" id="achievementsSection">
      <h2>🏆 إنجازاتك</h2>
      <p class="section-sub">أكمل المقالات في كل مسار لفتح الشارة الذهبية!</p>
      
      <div class="badges-grid">
        <div class="badge-card" id="badge-windows">
          <div class="badge-icon">🪟</div>
          <h3>خبير Windows</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        
        <div class="badge-card" id="badge-android">
          <div class="badge-icon">🤖</div>
          <h3>مطور Android</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        
        <div class="badge-card" id="badge-networks">
