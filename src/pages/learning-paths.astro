---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = "مسارات التعلم - Th.Tech";
export const description = "مسارات تعلم منظمة من المبتدئ إلى المتقدم في البرمجة، الشبكات، الذكاء الاصطناعي، وأكثر";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="learning-paths-page">
    <div class="hero-section">
      <h1>🎯 مسارات التعلم</h1>
      <p>اختر مسارك التقني وابدأ رحلتك من الصفر حتى الاحتراف</p>
    </div>

    <!-- مسار تطوير الويب -->
    <section class="path-card" id="web-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8)">
        <span class="path-icon">💻</span>
        <div>
          <h2>تطوير الويب</h2>
          <p>من HTML الأساسي إلى تطبيقات الويب الحديثة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>HTML5 - هيكلية الصفحات</li>
            <li>CSS3 - التصميم والتنسيق</li>
            <li>JavaScript - أساسيات البرمجة</li>
            <li>Responsive Design</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الإطار العمل</h3>
          <ul>
            <li>React / Vue / Angular</li>
            <li>Node.js و Express</li>
            <li>قواعد البيانات SQL</li>
            <li>APIs و RESTful</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>الاحتراف</h3>
          <ul>
            <li>Microservices</li>
            <li>Docker و Kubernetes</li>
            <li>CI/CD Pipelines</li>
            <li>Full-Stack</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار الشبكات -->
    <section class="path-card" id="networks">
      <div class="path-header" style="background: linear-gradient(135deg, #10b981, #059669)">
        <span class="path-icon">🌐</span>
        <div>
          <h2>الشبكات والاتصالات</h2>
          <p>من أساسيات الشبكات إلى 5G والشبكات السحابية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>OSI Model</li>
            <li>IP Addressing</li>
            <li>Switching و Routing</li>
            <li>Wi-Fi Basics</li>
          </ul>
          <a href="/Th-tech/networks/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الشبكات المتقدمة</h3>
          <ul>
            <li>OSPF و BGP</li>
            <li>VLANs</li>
            <li>Firewalls</li>
            <li>SD-WAN</li>
          </ul>
          <a href="/Th-tech/networks/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>الشبكات الحديثة</h3>
          <ul>
            <li>5G Architecture</li>
            <li>Network Slicing</li>
            <li>Open RAN</li>
            <li>Virtualization</li>
          </ul>
          <a href="/Th-tech/5g-technology/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار الذكاء الاصطناعي -->
    <section class="path-card" id="ai-ml">
      <div class="path-header" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>الذكاء الاصطناعي</h2>
          <p>من المفاهيم الأساسية إلى التعلم العميق</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>المفاهيم</h3>
          <ul>
            <li>Python للمبتدئين</li>
            <li>مبادئ ML</li>
            <li>الإحصاء والاحتمالات</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التعلم الآلي</h3>
          <ul>
            <li>Scikit-learn</li>
            <li>Supervised Learning</li>
            <li>Model Evaluation</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>التعلم العميق</h3>
          <ul>
            <li>TensorFlow / PyTorch</li>
            <li>Computer Vision</li>
            <li>NLP و LLMs</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار الأمن السيبراني -->
    <section class="path-card" id="cybersec">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🛡️</span>
        <div>
          <h2>الأمن السيبراني</h2>
          <p>من أساسيات الأمان إلى اختبار الاختراق</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الأمان</h3>
          <ul>
            <li>CIA Triad</li>
            <li>أنواع الهجمات</li>
            <li>التشفير الأساسي</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأمن الدفاعي</h3>
          <ul>
            <li>SIEM</li>
            <li>Incident Response</li>
            <li>Vulnerability Mgmt</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>الهجوم والاختبار</h3>
          <ul>
            <li>Penetration Testing</li>
            <li>Reverse Engineering</li>
            <li>Red Teaming</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار DevOps -->
    <section class="path-card" id="devops-path">
      <div class="path-header" style="background: linear-gradient(135deg, #06b6d4, #0891b2)">
        <span class="path-icon">🔄</span>
        <div>
          <h2>DevOps و Cloud</h2>
          <p>من Linux إلى البنية التحتية السحابية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>Linux و Bash</li>
            <li>Git</li>
            <li>مفاهيم CI/CD</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأتمتة</h3>
          <ul>
            <li>Docker</li>
            <li>Kubernetes</li>
            <li>Terraform</li>
            <li>AWS Basics</li>
          </ul>
          <a href="/Th-tech/cloud/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>البنية المتقدمة</h3>
          <ul>
            <li>Service Mesh</li>
            <li>GitOps</li>
            <li>Serverless</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ قسم الإنجازات والشارات الجديد -->
    <section class="achievements-section" id="achievementsSection">
      <h2>🏆 إنجازاتك</h2>
      <p class="section-sub">أكمل المقالات في كل مسار لفتح الشارة الذهبية!</p>
      
      <div class="badges-grid">
        <!-- شارة Windows -->
        <div class="badge-card" id="badge-windows">
          <div class="badge-icon">🪟</div>
          <h3>خبير Windows</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل </span>
        </div>

        <!-- شارة الشبكات -->
        <div class="badge-card" id="badge-networks">
          <div class="badge-icon">🌐</div>
          <h3>مهندس شبكات</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>

        <!-- شارة البرمجة -->
        <div class="badge-card" id="badge-coding">
          <div class="badge-icon">💻</div>
          <h3>المبرمج المحترف</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>

        <!-- شارة الأمن -->
        <div class="badge-card" id="badge-security">
          <div class="badge-icon">🛡️</div>
          <h3>حارس الأمن</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
      </div>
    </section>

    <!-- نصائح -->
    <div class="tips-section">
      <h2>💡 نصائح للنجاح</h2>
      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-icon">📅</span>
          <h3>الاستمرارية</h3>
          <p>خصص 30 دقيقة يومياً للتعلم</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">🛠️</span>
          <h3>التطبيق</h3>
          <p>طبّق ما تتعلمه فوراً</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">👥</span>
          <h3>المجتمع</h3>
          <p>شارك واطرح الأسئلة</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">📝</span>
          <h3>التوثيق</h3>
          <p>دوّن ملاحظاتك</p>
        </div>
      </div>
    </div>

    <div class="back-section">
      <a href="/Th-tech/" class="back-btn">🏠 العودة للرئيسية</a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
  }
  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
  }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; line-height: 1.6; }
  .learning-paths-page { max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; }
  .hero-section { text-align: center; margin-bottom: 4rem; padding: 3rem 2rem; background: linear-gradient(135deg, var(--primary), #0ea5e9); border-radius: 20px; color: white; box-shadow: 0 10px 40px rgba(2, 132, 199, 0.3); }
  .hero-section h1 { font-size: 2.5rem; margin-bottom: 1rem; }
  .hero-section p { font-size: 1.2rem; opacity: 0.9; }
  
  /* Path Cards */
  .path-card { background: var(--card); border-radius: 16px; margin-bottom: 3rem; overflow: hidden; border: 2px solid var(--border); box-shadow: 0 4px 20px var(--shadow); transition: transform 0.3s ease; }
  .path-card:hover { transform: translateY(-5px); }
  .path-header { padding: 2rem; color: white; display: flex; align-items: center; gap: 1.5rem; }
  .path-icon { font-size: 3rem; }
  .path-header h2 { font-size: 1.8rem; margin: 0 0 0.5rem; }
  .path-content { padding: 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .level { padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); background: var(--bg); transition: all 0.3s; }
  .level:hover { border-color: var(--primary); transform: translateY(-3px); }
  .level-badge { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; color: white; margin-bottom: 1rem; }
  .beginner .level-badge { background: linear-gradient(135deg, #22c55e, #16a34a); }
  .intermediate .level-badge { background: linear-gradient(135deg, #f59e0b, #d97706); }
  .advanced .level-badge { background: linear-gradient(135deg, #ef4444, #dc2626); }
  .level h3 { margin: 0 0 1rem; color: var(--text); font-size: 1.2rem; }
  .level ul { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .level li { padding: 0.5rem 0; color: var(--text-sec); font-size: 0.95rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.5rem; }
  .level li:before { content: "✓"; color: var(--primary); font-weight: bold; }
  .path-link { display: inline-block; padding: 0.6rem 1.5rem; background: var(--primary); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s; }
  .path-link:hover { background: #0ea5e9; transform: translateX(-5px); }
  
  /* Tips */
  .tips-section { margin-top: 4rem; text-align: center; }
  .tips-section h2 { font-size: 2rem; color: var(--primary); margin-bottom: 2rem; }
  .tips-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .tip-card { background: var(--card); padding: 2rem; border-radius: 12px; border: 1px solid var(--border); transition: all 0.3s; }
  .tip-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px var(--shadow); }
  .tip-icon { font-size: 2.5rem; display: block; margin-bottom: 1rem; }
  .tip-card h3 { color: var(--text); margin: 0 0 0.5rem; }
  .tip-card p { color: var(--text-sec); margin: 0; }

  .back-section { text-align: center; margin-top: 4rem; padding-top: 2rem; border-top: 2px solid var(--border); }
  .back-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 1rem 2rem; background: linear-gradient(135deg, var(--primary), #0ea5e9); color: white; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 1.1rem; transition: all 0.3s; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3); }
  .back-btn:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5); }

  /* ✅ تنسيقات الشارات والإنجازات */
  .achievements-section {
    margin: 4rem 0;
    text-align: center;
    padding: 2rem;
    background: var(--card);
    border-radius: 16px;
    border: 1px solid var(--border);
  }
  .section-sub { color: var(--text-sec); margin-bottom: 2rem; }
  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .badge-card {
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--bg);
    border: 2px solid var(--border);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }
  .badge-card.locked { filter: grayscale(1); opacity: 0.7; }
  .badge-card.unlocked {
    border-color: #f59e0b;
    background: linear-gradient(145deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.05));
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
    transform: scale(1.03);
  }
  .badge-icon { font-size: 3rem; margin-bottom: 0.5rem; display: block; }
  .badge-card.unlocked .badge-icon { animation: bounce 1s infinite alternate; }
  .badge-card h3 { font-size: 1rem; margin: 0.5rem 0; color: var(--text); }
  .progress-bar { height: 8px; background: var(--border); border-radius: 4px; margin: 1rem 0; overflow: hidden; }
  .progress-fill { height: 100%; background: #f59e0b; width: 0%; transition: width 0.6s ease; }
  .badge-status { font-size: 0.85rem; font-weight: bold; color: var(--text-sec); }
  .badge-card.unlocked .badge-status { color: #f59e0b; }
  @keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-8px); } }

  @media (max-width: 1024px) { .path-content, .tips-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .learning-paths-page { padding: 2rem 1rem; }
    .hero-section h1 { font-size: 1.8rem; }
    .path-header { flex-direction: column; text-align: center; }
    .badges-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ✅ منطق الشارات والتقدم
    // تعديل الروابط هنا لتناسب مقالاتك الفعلية
    const paths = {
      'windows': ['/Th-tech/windows/'], // المسار: مفتاح الـ ID, القيمة: رابط المقال
      'networks': ['/Th-tech/networks/', '/Th-tech/5g-technology/'],
      'coding': ['/Th-tech/programming/', '/Th-tech/devops/'],
      'security': ['/Th-tech/security/']
    };

    const readArticles = JSON.parse(localStorage.getItem('read_articles') || '[]');

    Object.keys(paths).forEach(pathId => {
      const badgeEl = document.getElementById(`badge-${pathId}`);
      if (!badgeEl) return;

      const articlesInPath = paths[pathId];
      const readCount = articlesInPath.filter(url => readArticles.includes(url)).length;
      const total = articlesInPath.length;
      const percentage = (readCount / total) * 100;

      const fill = badgeEl.querySelector('.progress-fill');
      fill.style.width = `${percentage}%`;

      if (readCount === total) {
        badgeEl.classList.remove('locked');
        badgeEl.classList.add('unlocked');
        badgeEl.querySelector('.badge-status').textContent = '✨ مكتمل!';
      } else {
        badgeEl.classList.add('locked');
        badgeEl.querySelector('.badge-status').textContent = `(${readCount}/${total})`;
      }
    });
  });
</script>
