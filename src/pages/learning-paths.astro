---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = "مسارات التعلم - Th.Tech";
export const description = "مسارات تعلم منظمة من المبتدئ إلى المتقدم في البرمجة، الشبكات، الذكاء الاصطناعي، وأكثر";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="learning-paths-page">
    <div class="hero-section">
      <h1>🎯 مسارات التعلم</h1>
      <p>اختر مسارك التقني وابدأ رحلتك من الصفر حتى الاحتراف</p>
    </div>

    <!-- ✅ مسار أمان Windows -->
    <section class="path-card" id="windows-security">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🔐</span>
        <div>
          <h2>أمان Windows المتقدم</h2>
          <p>من التشفير إلى الاستجابة للحوادث (5000+ كلمة)</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="windows-security" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الحماية والتشفير</h3>
          <ul>
            <li id="task-part1">✅ الجزء 1: حماية العتاد وتشفير البيانات</li>
            <li id="task-part2">✅ الجزء 2: الدفاع الاستباقي (Defender)</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part1" class="path-link">ابدأ القراءة ←</a>
        </div>
        <div class="level intermediate" data-path="windows-security" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>تأمين الهوية والتدقيق</h3>
          <ul>
            <li id="task-part3">✅ الجزء 3: تأمين الهوية والصلاحيات</li>
            <li id="task-part4">✅ الجزء 4: التدقيق والبحث عن التهديدات</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part3" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="windows-security" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>الاستجابة و Zero Trust</h3>
          <ul>
            <li id="task-part5">✅ الجزء 5: خطة الاستجابة للحوادث</li>
            <li id="task-part6">✅ الجزء 6: تأمين PowerShell</li>
            <li id="task-part7">✅ الجزء 7: Zero Trust والسحابة</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part5" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار Android -->
    <section class="path-card" id="android-path">
      <div class="path-header" style="background: linear-gradient(135deg, #3ddc84, #00c853)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>تطوير وأمن Android</h2>
          <p>من الأساسيات إلى معمارية النظام والأداء</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="android" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات Android</h3>
          <ul>
            <li id="task-android-basic">✅ مقدمة في نظام Android</li>
            <li id="task-android-components">✅ المكونات الأساسية (Activity, Service)</li>
          </ul>
          <a href="/Th-tech/android/#part1" class="path-link">ابدأ القراءة ←</a>
        </div>
        <div class="level intermediate" data-path="android" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التطوير المتقدم</h3>
          <ul>
            <li id="task-android-kotlin">✅ Kotlin و Coroutines</li>
            <li id="task-android-compose">✅ Jetpack Compose والواجهات</li>
          </ul>
          <a href="/Th-tech/android/advanced/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="android" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>معمارية النظام والأداء</h3>
          <ul>
            <li id="task-android-zygote">✅ Zygote و ART و Binder</li>
            <li id="task-android-perfetto">✅ تحليل الأداء مع Perfetto</li>
            <li id="task-android-security">✅ الأمان الداخلي (SELinux)</li>
          </ul>
          <a href="/Th-tech/android/architecture-performance/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الشبكات (محدث مع رابط المقال الجديد) -->
    <section class="path-card" id="networks">
      <div class="path-header" style="background: linear-gradient(135deg, #10b981, #059669)">
        <span class="path-icon">🌐</span>
        <div>
          <h2>الشبكات والاتصالات</h2>
          <p>من أساسيات الشبكات إلى تحليل الأداء والبروتوكولات المتقدمة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="networks" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li id="task-networks-basic">✅ OSI Model و TCP/IP</li>
            <li id="task-networks-ip">✅ IP Addressing و Subnetting</li>
          </ul>
          <a href="/Th-tech/networks/#part1" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate" data-path="networks" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الشبكات المتقدمة</h3>
          <ul>
            <li id="task-networks-ospf">✅ OSPF و BGP للتوجيه</li>
            <li id="task-networks-vlan">✅ VLANs و Firewalls</li>
          </ul>
          <a href="/Th-tech/networks/advanced-network-guide/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced" data-path="networks" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>تحليل الأداء والبروتوكولات</h3>
          <ul>
            <li id="task-networks-wireshark">✅ تحليل الحزم بـ Wireshark</li>
            <li id="task-networks-telemetry">✅ Streaming Telemetry و QoS</li>
            <li id="task-networks-ha">✅ التوافرية العالية (HA)</li>
          </ul>
          <a href="/Th-tech/networks/performance-protocols/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار تطوير الويب -->
    <section class="path-card" id="web-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8)">
        <span class="path-icon">💻</span>
        <div>
          <h2>تطوير الويب</h2>
          <p>من HTML الأساسي إلى تطبيقات الويب الحديثة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>HTML5 - هيكلية الصفحات</li>
            <li>CSS3 - التصميم والتنسيق</li>
            <li>JavaScript - أساسيات البرمجة</li>
            <li>Responsive Design</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الإطار العمل</h3>
          <ul>
            <li>React / Vue / Angular</li>
            <li>Node.js و Express</li>
            <li>قواعد البيانات SQL</li>
            <li>APIs و RESTful</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>الاحتراف</h3>
          <ul>
            <li>Microservices</li>
            <li>Docker و Kubernetes</li>
            <li>CI/CD Pipelines</li>
            <li>Full-Stack</li>
          </ul>
          <a href="/Th-tech/programming/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار الذكاء الاصطناعي -->
    <section class="path-card" id="ai-ml">
      <div class="path-header" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>الذكاء الاصطناعي</h2>
          <p>من المفاهيم الأساسية إلى التعلم العميق</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>المفاهيم</h3>
          <ul>
            <li>Python للمبتدئين</li>
            <li>مبادئ ML</li>
            <li>الإحصاء والاحتمالات</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التعلم الآلي</h3>
          <ul>
            <li>Scikit-learn</li>
            <li>Supervised Learning</li>
            <li>Model Evaluation</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>التعلم العميق</h3>
          <ul>
            <li>TensorFlow / PyTorch</li>
            <li>Computer Vision</li>
            <li>NLP و LLMs</li>
          </ul>
          <a href="/Th-tech/ai/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار الأمن السيبراني -->
    <section class="path-card" id="cybersec">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🛡️</span>
        <div>
          <h2>الأمن السيبراني</h2>
          <p>من أساسيات الأمان إلى اختبار الاختراق</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الأمان</h3>
          <ul>
            <li>CIA Triad</li>
            <li>أنواع الهجمات</li>
            <li>التشفير الأساسي</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأمن الدفاعي</h3>
          <ul>
            <li>SIEM</li>
            <li>Incident Response</li>
            <li>Vulnerability Mgmt</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>الهجوم والاختبار</h3>
          <ul>
            <li>Penetration Testing</li>
            <li>Reverse Engineering</li>
            <li>Red Teaming</li>
          </ul>
          <a href="/Th-tech/security/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- مسار DevOps -->
    <section class="path-card" id="devops-path">
      <div class="path-header" style="background: linear-gradient(135deg, #06b6d4, #0891b2)">
        <span class="path-icon">🔄</span>
        <div>
          <h2>DevOps و Cloud</h2>
          <p>من Linux إلى البنية التحتية السحابية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li>Linux و Bash</li>
            <li>Git</li>
            <li>مفاهيم CI/CD</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">ابدأ المسار ←</a>
        </div>
        <div class="level intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأتمتة</h3>
          <ul>
            <li>Docker</li>
            <li>Kubernetes</li>
            <li>Terraform</li>
            <li>AWS Basics</li>
          </ul>
          <a href="/Th-tech/cloud/" class="path-link">تابع المسار ←</a>
        </div>
        <div class="level advanced">
          <span class="level-badge">متقدم</span>
          <h3>البنية المتقدمة</h3>
          <ul>
            <li>Service Mesh</li>
            <li>GitOps</li>
            <li>Serverless</li>
          </ul>
          <a href="/Th-tech/devops/" class="path-link">أتقن المسار ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ قسم الإنجازات والشارات -->
    <section class="achievements-section" id="achievementsSection">
      <h2>🏆 إنجازاتك</h2>
      <p class="section-sub">أكمل المقالات في كل مسار لفتح الشارة الذهبية!</p>
      
      <div class="badges-grid">
        <div class="badge-card" id="badge-windows">
          <div class="badge-icon">🪟</div>
          <h3>خبير Windows</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        
        <div class="badge-card" id="badge-android">
          <div class="badge-icon">🤖</div>
          <h3>مطور Android</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        
        <div class="badge-card" id="badge-networks">
          <div class="badge-icon">🌐</div>
          <h3>مهندس شبكات</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        
        <div class="badge-card" id="badge-coding">
          <div class="badge-icon">💻</div>
          <h3>المبرمج المحترف</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
        <div class="badge-card" id="badge-security">
          <div class="badge-icon">🛡️</div>
          <h3>حارس الأمن</h3>
          <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
          <span class="badge-status">مقفل 🔒</span>
        </div>
      </div>
    </section>

    <!-- نصائح -->
    <div class="tips-section">
      <h2>💡 نصائح للنجاح</h2>
      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-icon">📅</span>
          <h3>الاستمرارية</h3>
          <p>خصص 30 دقيقة يومياً للتعلم</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">🛠️</span>
          <h3>التطبيق</h3>
          <p>طبّق ما تتعلمه فوراً</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">👥</span>
          <h3>المجتمع</h3>
          <p>شارك واطرح الأسئلة</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">📝</span>
          <h3>التوثيق</h3>
          <p>دوّن ملاحظاتك</p>
        </div>
      </div>
    </div>

    <div class="back-section">
      <a href="/Th-tech/" class="back-btn">🏠 العودة للرئيسية</a>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
  }
  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
  }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; line-height: 1.6; }
  .learning-paths-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  
  .hero-section { text-align: center; margin-bottom: 2rem; padding: 2rem 1rem; background: linear-gradient(135deg, var(--primary), #0ea5e9); border-radius: 16px; color: white; box-shadow: 0 8px 30px rgba(2, 132, 199, 0.3); }
  .hero-section h1 { font-size: 1.8rem; margin-bottom: 0.5rem; }
  .hero-section p { font-size: 1rem; opacity: 0.9; }
  
  /* ✅ Path Cards - Compact Design */
  .path-card { background: var(--card); border-radius: 12px; margin-bottom: 1.2rem; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 2px 12px var(--shadow); transition: transform 0.3s ease; }
  .path-card:hover { transform: translateY(-3px); }
  .path-header { padding: 1rem 1.2rem; color: white; display: flex; align-items: center; gap: 0.8rem; }
  .path-icon { font-size: 2rem; flex-shrink: 0; }
  .path-header h2 { font-size: 1.2rem; margin: 0 0 0.2rem; font-weight: 700; }
  .path-header p { margin: 0; opacity: 0.9; font-size: 0.85rem; }
  .path-content { padding: 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  
  /* ✅ تنسيق المستويات مع دعم حالة الإكمال */
  .level { padding: 0.8rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); transition: all 0.3s; }
  .level:hover { border-color: var(--primary); transform: translateY(-2px); }
  .level.completed { border-color: #22c55e; background: rgba(34, 197, 94, 0.05); }
  
  .level-badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 12px; font-size: 0.7rem; font-weight: 700; color: white; margin-bottom: 0.4rem; }
  .beginner .level-badge { background: linear-gradient(135deg, #22c55e, #16a34a); }
  .intermediate .level-badge { background: linear-gradient(135deg, #f59e0b, #d97706); }
  .advanced .level-badge { background: linear-gradient(135deg, #ef4444, #dc2626); }
  
  .level h3 { margin: 0 0 0.5rem; color: var(--text); font-size: 0.95rem; }
  .level ul { list-style: none; padding: 0; margin: 0 0 0.6rem; }
  .level li { padding: 0.25rem 0; color: var(--text-sec); font-size: 0.8rem; border-bottom: 1px solid rgba(128,128,128,0.1); display: flex; align-items: center; gap: 0.3rem; }
  .level li:last-child { border-bottom: none; }
  .level li:before { content: "✓"; color: var(--primary); font-weight: bold; font-size: 0.75rem; }
  
  /* ✅ تأثير اكتمال المهمة */
  .level li.done { color: var(--primary); font-weight: bold; text-decoration: line-through; opacity: 0.7; }
  .level li.done::before { content: "✅"; font-size: 0.7rem; }

  .path-link { display: inline-block; padding: 0.35rem 0.9rem; background: var(--primary); color: white; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 0.8rem; transition: all 0.3s; margin-top: 0.3rem; }
  .path-link:hover { background: #0ea5e9; transform: translateX(-3px); }
  
  /* Tips */
  .tips-section { margin-top: 2rem; text-align: center; }
  .tips-section h2 { font-size: 1.5rem; color: var(--primary); margin-bottom: 1.5rem; }
  .tips-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .tip-card { background: var(--card); padding: 1.2rem; border-radius: 10px; border: 1px solid var(--border); transition: all 0.3s; }
  .tip-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px var(--shadow); }
  .tip-icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }
  .tip-card h3 { color: var(--text); margin: 0 0 0.3rem; font-size: 1rem; }
  .tip-card p { color: var(--text-sec); margin: 0; font-size: 0.85rem; }
  
  .back-section { text-align: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .back-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.5rem; background: linear-gradient(135deg, var(--primary), #0ea5e9); color: white; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 0.95rem; transition: all 0.3s; }
  .back-btn:hover { transform: translateY(-2px); }
  
  /* ✅ Achievements/Badges */
  .achievements-section { margin: 2rem 0; text-align: center; padding: 1.5rem; background: var(--card); border-radius: 12px; border: 1px solid var(--border); }
  .section-sub { color: var(--text-sec); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .badges-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; }
  .badge-card { padding: 1rem; border-radius: 10px; background: var(--bg); border: 2px solid var(--border); transition: all 0.4s ease; }
  .badge-card.locked { filter: grayscale(1); opacity: 0.7; }
  .badge-card.unlocked { border-color: #f59e0b; background: linear-gradient(145deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.05)); box-shadow: 0 0 15px rgba(245, 158, 11, 0.2); transform: scale(1.02); }
  .badge-icon { font-size: 2.2rem; margin-bottom: 0.3rem; display: block; }
  .badge-card.unlocked .badge-icon { animation: bounce 1s infinite alternate; }
  .badge-card h3 { font-size: 0.9rem; margin: 0.3rem 0; color: var(--text); }
  .progress-bar { height: 6px; background: var(--border); border-radius: 3px; margin: 0.8rem 0; overflow: hidden; }
  .progress-fill { height: 100%; background: #f59e0b; width: 0%; transition: width 0.6s ease; }
  .badge-status { font-size: 0.75rem; font-weight: bold; color: var(--text-sec); }
  .badge-card.unlocked .badge-status { color: #f59e0b; }
  @keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-6px); } }
  
  @media (max-width: 1024px) { .path-content, .tips-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .learning-paths-page { padding: 1rem; }
    .hero-section h1 { font-size: 1.4rem; }
    .hero-section p { font-size: 0.9rem; }
    .path-header { flex-direction: column; text-align: center; padding: 0.8rem; }
    .path-icon { font-size: 1.8rem; }
    .path-header h2 { font-size: 1rem; }
    .path-content { padding: 0.8rem; gap: 0.5rem; }
    .level { padding: 0.6rem; }
    .level li { font-size: 0.75rem; }
    .badges-grid { grid-template-columns: repeat(2, 1fr); }
    .tips-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // ✅ منطق الشارات والتقدم مع التحديث الفوري
  const paths = {
    'windows': [
      '/Th-tech/windows/', 
      '/Th-tech/windows/advanced/',
      '/Th-tech/windows/security-guide/'
    ],
    'android': [
      '/Th-tech/android/', 
      '/Th-tech/android/advanced/',
      '/Th-tech/android/architecture-performance/'
    ],
    'networks': [  // ✅ أضفنا المقال الجديد لمسار الشبكات
      '/Th-tech/networks/', 
      '/Th-tech/networks/advanced-network-guide/',
      '/Th-tech/networks/performance-protocols/'
    ],
    'coding': ['/Th-tech/programming/', '/Th-tech/devops/'],
    'security': ['/Th-tech/security/']
  };

  function updateBadges() {
    const readArticles = JSON.parse(localStorage.getItem('read_articles') || '[]');
    
    Object.keys(paths).forEach(pathId => {
      const badgeEl = document.getElementById(`badge-${pathId}`);
      if (!badgeEl) return;

      const articlesInPath = paths[pathId];
      const readCount = articlesInPath.filter(url => readArticles.includes(url)).length;
      const total = articlesInPath.length;
      const percentage = total > 0 ? (readCount / total) * 100 : 0;

      const fill = badgeEl.querySelector('.progress-fill');
      if (fill) fill.style.width = `${percentage}%`;

      const statusEl = badgeEl.querySelector('.badge-status');
      if (readCount === total && total > 0) {
        badgeEl.classList.remove('locked');
        badgeEl.classList.add('unlocked');
        if (statusEl) statusEl.textContent = '✨ مكتمل!';
      } else {
        badgeEl.classList.add('locked');
        badgeEl.classList.remove('unlocked');
        if (statusEl) statusEl.textContent = `(${readCount}/${total})`;
      }
    });
  }

  // ✅ دالة لتحديث تقدم المسار بناءً على الأجزاء المقروءة
  function updatePathProgress() {
    const pathStructure = {
      'windows-security': {
        beginner: ['part1', 'part2'],
        intermediate: ['part3', 'part4'],
        advanced: ['part5', 'part6', 'part7']
      },
      'android': {
        beginner: ['android-basic', 'android-components'],
        intermediate: ['android-kotlin', 'android-compose'],
        advanced: ['android-zygote', 'android-perfetto', 'android-security']
      },
      'networks': {  // ✅ أضفنا هيكلية مسار الشبكات
        beginner: ['networks-basic', 'networks-ip'],
        intermediate: ['networks-ospf', 'networks-vlan'],
        advanced: ['networks-wireshark', 'networks-telemetry', 'networks-ha']
      }
    };

    const readSections = Object.keys(localStorage).filter(k => k.startsWith('read_section_')).map(k => k.replace('read_section_', ''));

    Object.keys(pathStructure).forEach(pathId => {
      const levels = pathStructure[pathId];
      
      Object.keys(levels).forEach(levelName => {
        const requiredParts = levels[levelName];
        const levelCard = document.querySelector(`.level[data-path="${pathId}"][data-level="${levelName}"]`);
        
        if (!levelCard) return;

        let completedCount = 0;

        requiredParts.forEach(partId => {
          const taskItem = document.getElementById(`task-${partId}`);
          if (taskItem) {
            if (readSections.includes(partId)) {
              taskItem.classList.add('done');
              completedCount++;
            } else {
              taskItem.classList.remove('done');
            }
          }
        });

        if (completedCount === requiredParts.length) {
          levelCard.classList.add('completed');
        } else {
          levelCard.classList.remove('completed');
        }
      });
    });
  }

  // تشغيل الدوال عند تحميل الصفحة
  document.addEventListener('DOMContentLoaded', () => {
    updateBadges();
    updatePathProgress();
  });

  // ✅ تحديث فوري عند العودة للتبويب
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      updateBadges();
      updatePathProgress();
    }
  });
  
  window.addEventListener('focus', () => {
    updateBadges();
    updatePathProgress();
  });
  
  // ✅ تحديث فوري عبر التبويبات
  window.addEventListener('storage', () => {
    updateBadges();
    updatePathProgress();
  });
  
  // ✅ تحديث فوري عند استقبال حدث من مقال مقروء
  window.addEventListener('badge-update', () => {
    updateBadges();
    updatePathProgress();
  });
</script>
