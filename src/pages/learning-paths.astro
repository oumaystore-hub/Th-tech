    .hero-section h1 { font-size: 1.2rem; }
    .hero-section p { font-size: 0.8rem; }
    .path-header { flex-direction: column; text-align: center; padding: 0.6rem; }
    .path-icon { font-size: 1.4rem; }
    .path-header h2 { font-size: 0.9rem; }
    .path-content { padding: 0.6rem; gap: 0.3rem; }
    .level { padding: 0.5rem; }
    .level h3 { font-size: 0.8rem; }
    .level li { font-size: 0.65rem; }
    .badges-grid { grid-template-columns: repeat(2, 1fr); }
    .tips-grid { grid-template-columns: 1fr; }
    .badge-card { padding: 0.6rem; }
    .badge-icon { font-size: 1.5rem; }
    .badge-card h3 { font-size: 0.7rem; }
  }
</style>

<script>
  // ✅ منطق الشارات والتقدم مع التحديث الفوري
  const paths = {
    'windows': ['/Th-tech/windows/', '/Th-tech/windows/advanced/', '/Th-tech/windows/security-guide/'],
    'android': ['/Th-tech/android/', '/Th-tech/android/advanced/', '/Th-tech/android/architecture-performance/'],
    'networks': ['/Th-tech/networks/', '/Th-tech/networks/advanced-network-guide/', '/Th-tech/networks/performance-protocols/'],
    'ai-ml': ['/Th-tech/ai/', '/Th-tech/ai/advanced-ai-guide/', '/Th-tech/ai/ml-deep-learning/'],
    'cybersec': ['/Th-tech/security/', '/Th-tech/security/advanced/', '/Th-tech/security/pentest-incident-response/'],
    'programming': ['/Th-tech/programming/', '/Th-tech/programming/advanced-programming-guide/', '/Th-tech/programming/architecture-devops/'],
    '5g-tech': ['/Th-tech/5g-technology/', '/Th-tech/5g-technology/advanced/', '/Th-tech/5g-technology/network-slicing-applications/'],
    'mobile-dev': ['/Th-tech/mobile/', '/Th-tech/mobile/advanced-mobile-guide/', '/Th-tech/mobile/cross-platform-development/'],
    'ios-dev': ['/Th-tech/ios/', '/Th-tech/ios/advanced/', '/Th-tech/ios/swiftui-advanced/'],
    'data-science': ['/Th-tech/data-science/', '/Th-tech/data-science/advanced-data-science-guide/', '/Th-tech/data-science/ml-ai-guide/'],
    'cloud': ['/Th-tech/cloud/', '/Th-tech/cloud/advanced-cloud-guide/', '/Th-tech/cloud/kubernetes-devops-guide/'],
    'blockchain': ['/Th-tech/blockchain/', '/Th-tech/blockchain/advanced-blockchain-guide/', '/Th-tech/blockchain/smart-contracts-web3-guide/'],
    'devops-sre': ['/Th-tech/devops/', '/Th-tech/devops/advanced-devops-guide/', '/Th-tech/devops/sre-monitoring-guide/'],
    'edge-computing': ['/Th-tech/edge-computing/', '/Th-tech/edge-computing/advanced/', '/Th-tech/edge-computing/iiot-edge-ai-guide/'],
    'iot': ['/Th-tech/iot/', '/Th-tech/iot/advanced-iot-guide/', '/Th-tech/iot/industrial-security-iot-guide/'],
    'coding': ['/Th-tech/devops/']
  };

  function updateBadges() {
    const readArticles = JSON.parse(localStorage.getItem('read_articles') || '[]');
    Object.keys(paths).forEach(pathId => {
      const badgeEl = document.getElementById(`badge-${pathId}`);
      if (!badgeEl) return;
      const articlesInPath = paths[pathId];
      const readCount = articlesInPath.filter(url => readArticles.includes(url)).length;
      const total = articlesInPath.length;
      const percentage = total > 0 ? (readCount / total) * 100 : 0;
      const fill = badgeEl.querySelector('.progress-fill');
      if (fill) fill.style.width = `${percentage}%`;
      const statusEl = badgeEl.querySelector('.badge-status');
      if (readCount === total && total > 0) {
        badgeEl.classList.remove('locked');
        badgeEl.classList.add('unlocked');
        if (statusEl) statusEl.textContent = '✨ مكتمل!';
      } else {
        badgeEl.classList.add('locked');
        badgeEl.classList.remove('unlocked');
        if (statusEl) statusEl.textContent = `(${readCount}/${total})`;
      }
    });
  }

  function updatePathProgress() {
    const pathStructure = {
      'windows-security': { beginner: ['part1','part2'], intermediate: ['part3','part4'], advanced: ['part5','part6','part7'] },
      'android': { beginner: ['android-basic','android-components'], intermediate: ['android-kotlin','android-compose'], advanced: ['android-zygote','android-perfetto','android-security'] },
      'networks': { beginner: ['networks-basic','networks-ip'], intermediate: ['networks-ospf','networks-vlan'], advanced: ['networks-wireshark','networks-telemetry','networks-ha'] },
      'ai-ml': { beginner: ['ai-basic','ai-ml-basics'], intermediate: ['ai-sklearn','ai-supervised'], advanced: ['ai-deep','ai-llms','ai-rag'] },
      'cybersec': { beginner: ['cyber-cia','cyber-crypto'], intermediate: ['cyber-siem','cyber-incident'], advanced: ['cyber-pentest','cyber-forensics','cyber-purple'] },
      'programming': { beginner: ['prog-basics','prog-oop'], intermediate: ['prog-patterns','prog-performance'], advanced: ['prog-arch','prog-containers','prog-cicd'] },
      '5g-tech': { beginner: ['5g-basics','5g-architecture'], intermediate: ['5g-mimo','5g-openran'], advanced: ['5g-slicing','5g-industrial','5g-v2x'] },
      'mobile-dev': { beginner: ['mobile-basics','mobile-lifecycle'], intermediate: ['mobile-architecture','mobile-cicd'], advanced: ['mobile-flutter','mobile-rn','mobile-kmp'] },
      'ios-dev': { beginner: ['ios-basics','ios-xcode'], intermediate: ['ios-swiftui','ios-combine'], advanced: ['ios-swiftui-adv','ios-uikit','ios-publish'] },
      'data-science': { beginner: ['ds-basics','ds-stats'], intermediate: ['ds-ml','ds-bigdata'], advanced: ['ds-nlp','ds-cv','ds-ethics'] },
      'cloud': { beginner: ['cloud-basics','cloud-providers'], intermediate: ['cloud-k8s','cloud-iac'], advanced: ['cloud-helm','cloud-mesh','cloud-security'] },
      'blockchain': { beginner: ['bc-basics','bc-bitcoin'], intermediate: ['bc-defi','bc-nft'], advanced: ['bc-solidity','bc-dapps','bc-web3'] },
      'devops-sre': { beginner: ['devops-basics','devops-ci'], intermediate: ['devops-k8s','devops-iac'], advanced: ['sre-slo','sre-obs','sre-chaos'] },
      'edge-computing': { beginner: ['edge-basics','edge-vs-cloud'], intermediate: ['edge-arch','edge-security'], advanced: ['edge-ai','edge-iiot','edge-robotics'] },
      'iot': { beginner: ['iot-basics','iot-protocols'], intermediate: ['iot-edge','iot-iiot'], advanced: ['iot-security','iot-compliance','iot-supply'] }
    };
    const readSections = Object.keys(localStorage).filter(k => k.startsWith('read_section_')).map(k => k.replace('read_section_', ''));
    Object.keys(pathStructure).forEach(pathId => {
      const levels = pathStructure[pathId];
      Object.keys(levels).forEach(levelName => {
        const requiredParts = levels[levelName];
        const levelCard = document.querySelector(`.level[data-path="${pathId}"][data-level="${levelName}"]`);
        if (!levelCard) return;
        let completedCount = 0;
        requiredParts.forEach(partId => {
          const taskItem = document.getElementById(`task-${partId}`);
          if (taskItem) {
            if (readSections.includes(partId)) { taskItem.classList.add('done'); completedCount++; }
            else { taskItem.classList.remove('done'); }
          }
        });
        if (completedCount === requiredParts.length) { levelCard.classList.add('completed'); }
        else { levelCard.classList.remove('completed'); }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => { updateBadges(); updatePathProgress(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { updateBadges(); updatePathProgress(); } });
  window.addEventListener('focus', () => { updateBadges(); updatePathProgress(); });
  window.addEventListener('storage', () => { updateBadges(); updatePathProgress(); });
  window.addEventListener('badge-update', () => { updateBadges(); updatePathProgress(); });
</script>
