---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = "مسارات التعلم - Th.Tech";
export const description = "مسارات تعلم منظمة من المبتدئ إلى المتقدم في البرمجة، الشبكات، الذكاء الاصطناعي، وأكثر";
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body>
  <Header />

  <main class="learning-paths-page">
    <div class="hero-section">
      <h1>🎯 مسارات التعلم</h1>
      <p>اختر مسارك التقني وابدأ رحلتك من الصفر حتى الاحتراف</p>
    </div>

    <!-- ✅ مسار أمان Windows -->
    <section class="path-card" id="windows-security">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🔐</span>
        <div>
          <h2>أمان Windows المتقدم</h2>
          <p>من التشفير إلى الاستجابة للحوادث</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="windows-security" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الحماية</h3>
          <ul>
            <li id="task-part1">✅ الجزء 1: حماية العتاد</li>
            <li id="task-part2">✅ الجزء 2: Defender</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="windows-security" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>تأمين الهوية</h3>
          <ul>
            <li id="task-part3">✅ الجزء 3: الصلاحيات</li>
            <li id="task-part4">✅ الجزء 4: التدقيق</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part3" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="windows-security" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>الاستجابة و Zero Trust</h3>
          <ul>
            <li id="task-part5">✅ الجزء 5: خطة الاستجابة</li>
            <li id="task-part6">✅ الجزء 6: PowerShell</li>
            <li id="task-part7">✅ الجزء 7: Zero Trust</li>
          </ul>
          <a href="/Th-tech/windows/security-guide/#part5" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار Android -->
    <section class="path-card" id="android-path">
      <div class="path-header" style="background: linear-gradient(135deg, #3ddc84, #00c853)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>تطوير وأمن Android</h2>
          <p>من الأساسيات إلى معمارية النظام</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="android" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات Android</h3>
          <ul>
            <li id="task-android-basic">✅ مقدمة في Android</li>
            <li id="task-android-components">✅ Activity, Service</li>
          </ul>
          <a href="/Th-tech/android/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="android" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التطوير المتقدم</h3>
          <ul>
            <li id="task-android-kotlin">✅ Kotlin و Coroutines</li>
            <li id="task-android-compose">✅ Jetpack Compose</li>
          </ul>
          <a href="/Th-tech/android/advanced/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="android" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>معمارية النظام</h3>
          <ul>
            <li id="task-android-zygote">✅ Zygote و ART</li>
            <li id="task-android-perfetto">✅ تحليل الأداء</li>
            <li id="task-android-security">✅ SELinux</li>
          </ul>
          <a href="/Th-tech/android/architecture-performance/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الشبكات -->
    <section class="path-card" id="networks">
      <div class="path-header" style="background: linear-gradient(135deg, #10b981, #059669)">
        <span class="path-icon">🌐</span>
        <div>
          <h2>الشبكات والاتصالات</h2>
          <p>من الأساسيات إلى البروتوكولات المتقدمة</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="networks" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>الأساسيات</h3>
          <ul>
            <li id="task-networks-basic">✅ OSI Model و TCP/IP</li>
            <li id="task-networks-ip">✅ IP Addressing</li>
          </ul>
          <a href="/Th-tech/networks/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="networks" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الشبكات المتقدمة</h3>
          <ul>
            <li id="task-networks-ospf">✅ OSPF و BGP</li>
            <li id="task-networks-vlan">✅ VLANs و Firewalls</li>
          </ul>
          <a href="/Th-tech/networks/advanced-network-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="networks" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>تحليل الأداء</h3>
          <ul>
            <li id="task-networks-wireshark">✅ Wireshark</li>
            <li id="task-networks-telemetry">✅ Telemetry و QoS</li>
            <li id="task-networks-ha">✅ High Availability</li>
          </ul>
          <a href="/Th-tech/networks/performance-protocols/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الذكاء الاصطناعي -->
    <section class="path-card" id="ai-ml">
      <div class="path-header" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9)">
        <span class="path-icon">🤖</span>
        <div>
          <h2>الذكاء الاصطناعي</h2>
          <p>من المفاهيم إلى النماذج اللغوية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="ai-ml" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>المفاهيم الأساسية</h3>
          <ul>
            <li id="task-ai-basic">✅ Python للمبتدئين</li>
            <li id="task-ai-ml-basics">✅ مبادئ ML</li>
          </ul>
          <a href="/Th-tech/ai/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="ai-ml" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التعلم الآلي</h3>
          <ul>
            <li id="task-ai-sklearn">✅ Scikit-learn</li>
            <li id="task-ai-supervised">✅ التعلم تحت الإشراف</li>
          </ul>
          <a href="/Th-tech/ai/advanced-ai-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="ai-ml" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>التعلم العميق و LLMs</h3>
          <ul>
            <li id="task-ai-deep">✅ الشبكات العصبية</li>
            <li id="task-ai-llms">✅ النماذج اللغوية</li>
            <li id="task-ai-rag">✅ RAG و Fine-tuning</li>
          </ul>
          <a href="/Th-tech/ai/ml-deep-learning/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الأمن السيبراني -->
    <section class="path-card" id="cybersec">
      <div class="path-header" style="background: linear-gradient(135deg, #ef4444, #dc2626)">
        <span class="path-icon">🛡️</span>
        <div>
          <h2>الأمن السيبراني</h2>
          <p>من الأساسيات إلى اختبار الاختراق</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="cybersec" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات الأمان</h3>
          <ul>
            <li id="task-cyber-cia">✅ CIA Triad</li>
            <li id="task-cyber-crypto">✅ التشفير الأساسي</li>
          </ul>
          <a href="/Th-tech/security/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="cybersec" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الأمن الدفاعي</h3>
          <ul>
            <li id="task-cyber-siem">✅ SIEM</li>
            <li id="task-cyber-incident">✅ Incident Response</li>
          </ul>
          <a href="/Th-tech/security/advanced/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="cybersec" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>اختبار الاختراق</h3>
          <ul>
            <li id="task-cyber-pentest">✅ PTES و OWASP</li>
            <li id="task-cyber-forensics">✅ التحليل الجنائي</li>
            <li id="task-cyber-purple">✅ Purple Teaming</li>
          </ul>
          <a href="/Th-tech/security/pentest-incident-response/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار البرمجة والتطوير -->
    <section class="path-card" id="programming">
      <div class="path-header" style="background: linear-gradient(135deg, #0284c7, #00d4ff)">
        <span class="path-icon">💻</span>
        <div>
          <h2>البرمجة والتطوير</h2>
          <p>من الأساسيات إلى DevOps</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="programming" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات البرمجة</h3>
          <ul>
            <li id="task-prog-basics">✅ لغات البرمجة</li>
            <li id="task-prog-oop">✅ OOP و SOLID</li>
          </ul>
          <a href="/Th-tech/programming/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="programming" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-prog-patterns">✅ أنماط التصميم</li>
            <li id="task-prog-performance">✅ تحسين الأداء</li>
          </ul>
          <a href="/Th-tech/programming/advanced-programming-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="programming" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>هندسة البرمجيات</h3>
          <ul>
            <li id="task-prog-arch">✅ Clean Architecture</li>
            <li id="task-prog-containers">✅ Docker و K8s</li>
            <li id="task-prog-cicd">✅ CI/CD و GitOps</li>
          </ul>
          <a href="/Th-tech/programming/architecture-devops/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار تقنية 5G -->
    <section class="path-card" id="5g-tech">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon">📡</span>
        <div>
          <h2>تقنية 5G المتقدمة</h2>
          <p>من Network Slicing إلى التطبيقات الصناعية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="5g-tech" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات تقنية 5G</h3>
          <ul>
            <li id="task-5g-basics">✅ eMBB و URLLC</li>
            <li id="task-5g-architecture">✅ معمارية 5GC</li>
          </ul>
          <a href="/Th-tech/5g-technology/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="5g-tech" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التقنيات المتقدمة</h3>
          <ul>
            <li id="task-5g-mimo">✅ Massive MIMO</li>
            <li id="task-5g-openran">✅ Open RAN</li>
          </ul>
          <a href="/Th-tech/5g-technology/advanced/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="5g-tech" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>Network Slicing</h3>
          <ul>
            <li id="task-5g-slicing">✅ Network Slicing</li>
            <li id="task-5g-industrial">✅ الصناعة 4.0</li>
            <li id="task-5g-v2x">✅ V2X و Telesurgery</li>
          </ul>
          <a href="/Th-tech/5g-technology/network-slicing-applications/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار تطوير التطبيقات المحمولة -->
    <section class="path-card" id="mobile-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon">📱</span>
        <div>
          <h2>تطوير التطبيقات المحمولة</h2>
          <p>من الأساسيات إلى Cross-Platform</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="mobile-dev" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات Mobile Dev</h3>
          <ul>
            <li id="task-mobile-basics">✅ Native vs Cross-Platform</li>
            <li id="task-mobile-lifecycle">✅ Lifecycle</li>
          </ul>
          <a href="/Th-tech/mobile/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="mobile-dev" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-mobile-architecture">✅ Clean Architecture</li>
            <li id="task-mobile-cicd">✅ CI/CD</li>
          </ul>
          <a href="/Th-tech/mobile/advanced-mobile-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="mobile-dev" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>Cross-Platform</h3>
          <ul>
            <li id="task-mobile-flutter">✅ Flutter</li>
            <li id="task-mobile-rn">✅ React Native</li>
            <li id="task-mobile-kmp">✅ Kotlin Multiplatform</li>
          </ul>
          <a href="/Th-tech/mobile/cross-platform-development/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار نظام iOS -->
    <section class="path-card" id="ios-dev">
      <div class="path-header" style="background: linear-gradient(135deg, #f59e0b, #d97706)">
        <span class="path-icon"></span>
        <div>
          <h2>نظام iOS المتقدم</h2>
          <p>من SwiftUI إلى النشر على App Store</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="ios-dev" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات iOS</h3>
          <ul>
            <li id="task-ios-basics">✅ ما هو iOS و Swift</li>
            <li id="task-ios-xcode">✅ Xcode وبيئة التطوير</li>
          </ul>
          <a href="/Th-tech/ios/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="ios-dev" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-ios-swiftui">✅ SwiftUI</li>
            <li id="task-ios-combine">✅ Combine و Core Data</li>
          </ul>
          <a href="/Th-tech/ios/advanced/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="ios-dev" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>SwiftUI و UIKit</h3>
          <ul>
            <li id="task-ios-swiftui-adv">✅ SwiftUI المتقدم</li>
            <li id="task-ios-uikit">✅ UIKit Interoperability</li>
            <li id="task-ios-publish">✅ النشر على App Store</li>
          </ul>
          <a href="/Th-tech/ios/swiftui-advanced/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار علم البيانات والذكاء الاصطناعي -->
    <section class="path-card" id="data-science">
      <div class="path-header" style="background: linear-gradient(135deg, #0284c7, #00d4ff)">
        <span class="path-icon">📊</span>
        <div>
          <h2>علم البيانات والذكاء الاصطناعي</h2>
          <p>من التحليل الإحصائي إلى النماذج التنبؤية</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="data-science" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات علم البيانات</h3>
          <ul>
            <li id="task-ds-basics">✅ ما هو علم البيانات</li>
            <li id="task-ds-stats">✅ الإحصاء والتحليل</li>
          </ul>
          <a href="/Th-tech/data-science/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="data-science" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>التعلم الآلي المتقدم</h3>
          <ul>
            <li id="task-ds-ml">✅ خوارزميات ML</li>
            <li id="task-ds-bigdata">✅ Big Data و MLOps</li>
          </ul>
          <a href="/Th-tech/data-science/advanced-data-science-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="data-science" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>الذكاء الاصطناعي التطبيقي</h3>
          <ul>
            <li id="task-ds-nlp">✅ NLP</li>
            <li id="task-ds-cv">✅ Computer Vision</li>
            <li id="task-ds-ethics">✅ أخلاقيات الذكاء الاصطناعي</li>
          </ul>
          <a href="/Th-tech/data-science/ml-ai-guide/" class="path-link">أتقن ←</a>
        </div>
      </div>
    </section>

    <!-- ✅ مسار الحوسبة السحابية -->
    <section class="path-card" id="cloud">
      <div class="path-header" style="background: linear-gradient(135deg, #0284c7, #00d4ff)">
        <span class="path-icon">☁️</span>
        <div>
          <h2>الحوسبة السحابية و DevOps</h2>
          <p>من أساسيات السحابة إلى Kubernetes المتقدم</p>
        </div>
      </div>
      <div class="path-content">
        <div class="level beginner" data-path="cloud" data-level="beginner">
          <span class="level-badge">مبتدئ</span>
          <h3>أساسيات السحابة</h3>
          <ul>
            <li id="task-cloud-basics">✅ IaaS، PaaS، SaaS</li>
            <li id="task-cloud-providers">✅ AWS، Azure، GCP</li>
          </ul>
          <a href="/Th-tech/cloud/#part1" class="path-link">ابدأ ←</a>
        </div>
        <div class="level intermediate" data-path="cloud" data-level="intermediate">
          <span class="level-badge">متوسط</span>
          <h3>الهندسة المتقدمة</h3>
          <ul>
            <li id="task-cloud-k8s">✅ Kubernetes أساسيات</li>
            <li id="task-cloud-iac">✅ Terraform و IaC</li>
          </ul>
          <a href="/Th-tech/cloud/advanced-cloud-guide/" class="path-link">تابع ←</a>
        </div>
        <div class="level advanced" data-path="cloud" data-level="advanced">
          <span class="level-badge">متقدم</span>
          <h3>Kubernetes و DevOps</h3>
          <ul>
            <li id="task-cloud-helm">✅ Helm و GitOps</li>
            <li id="task-cloud-mesh">✅ Service Mesh</li>
            <li id="task-cloud-security">✅ أمن السحابة</li>
          </ul>
          <a href="/Th-tech/cloud/kubernetes-devops-guide/" class="path-link">أتقن ←</a>
        </div>
