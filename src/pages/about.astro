---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>عن Th.Tech | منصاتنا التقنية</title>
</head>
<body>
  <Header />
  
  <main class="about-page">
    <div class="container">
      <section class="hero-section">
        <h1>عن Th.Tech</h1>
        <p class="subtitle">منصتك العربية للتعلم والبرمجة</p>
      </section>

      <section class="content-section">
        <div class="card">
          <h2>🎯 رؤيتنا</h2>
          <p>
            نؤمن بأن البرمجة حق للجميع. لذلك أنشأنا Th.Tech لتكون منصتك الشاملة 
            لتعلم البرمجة باللغة العربية، مع أدوات احترافية تساعدك على التطبيق العملي المباشر.
          </p>
        </div>

        <div class="card">
          <h2>🚀 ماذا نقدم؟</h2>
          <ul class="features-list">
            <li>
              <span class="icon">💻</span>
              <div>
                <h3>محرر أكواد تفاعلي</h3>
                <p>اكتب وشغّل كود Python و JavaScript مباشرة من المتصفح</p>
              </div>
            </li>
            <li>
              <span class="icon">📚</span>
              <div>
                <h3>شروحات عملية</h3>
                <p>محتوى عربي مبسط يغطي أساسيات البرمجة والمشاريع العملية</p>
              </div>
            </li>
            <li>
              <span class="icon">🎓</span>
              <div>
                <h3>مسارات تعلم منظمة</h3>
                <p>من الصفر إلى الاحتراف في الذكاء الاصطناعي، الأمن السيبراني، والمزيد</p>
              </div>
            </li>
            <li>
              <span class="icon">🆓</span>
              <div>
                <h3>مجاني 100%</h3>
                <p>جميع أدواتنا ومحتوانا متاح مجاناً للجميع</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="card">
          <h2>👨💻 لمن هذا الموقع؟</h2>
          <div class="audience-grid">
            <div class="audience-item">
              <h4>🎓 الطلاب</h4>
              <p>الذين يريدون تعلم البرمجة بطريقة عملية</p>
            </div>
            <div class="audience-item">
              <h4> المبتدئين</h4>
              <p>الذين يبحثون عن بداية صحيحة في عالم البرمجة</p>
            </div>
            <div class="audience-item">
              <h4>🚀 المطورين</h4>
              <p>الذين يحتاجون أدوات سريعة لاختبار الكود</p>
            </div>
          </div>
        </div>

        <div class="card cta-card">
          <h2> ابدأ الآن!</h2>
          <p>لا تنتظر أكثر - ابدأ رحلتك في البرمجة اليوم</p>
          <div class="cta-buttons">
            <a href="/Th-tech/playground/" class="btn btn-primary">جرّب المحرر الآن</a>
            <a href="/Th-tech/guides/" class="btn btn-secondary">تصفح الشروحات</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .about-page {
    min-height: 100vh;
    background: var(--bg, #080c12);
    color: var(--text, #e6edf3);
  }
  
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .hero-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--blue, #38a8ff);
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--muted, #7d8b99);
  }

  .card {
    background: var(--panel, #0d131b);
    border: 1px solid var(--border, #202c39);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .card h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text, #e6edf3);
  }

  .features-list {
    list-style: none;
    padding: 0;
  }

  .features-list li {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--panel2, #111923);
    border-radius: 8px;
  }

  .features-list .icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .features-list h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--blue, #38a8ff);
  }

  .features-list p {
    color: var(--muted, #7d8b99);
    line-height: 1.6;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .audience-item {
    text-align: center;
    padding: 1.5rem;
    background: var(--panel2, #111923);
    border-radius: 8px;
  }

  .audience-item h4 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--blue, #38a8ff);
  }

  .cta-card {
    text-align: center;
    background: linear-gradient(135deg, var(--panel2, #111923), var(--panel, #0d131b));
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.8rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-primary {
    background: var(--blue, #38a8ff);
    color: white;
  }

  .btn-primary:hover {
    background: var(--blue2, #168bd0);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--blue, #38a8ff);
    border: 2px solid var(--blue, #38a8ff);
  }

  .btn-secondary:hover {
    background: var(--blue, #38a8ff);
    color: white;
  }

  @media (max-width: 600px) {
    .hero-section h1 {
      font-size: 2rem;
    }
    
    .features-list li {
      flex-direction: column;
    }
    
    .cta-buttons {
      flex-direction: column;
    }
    
    .btn {
      width: 100%;
    }
  }
</style>
