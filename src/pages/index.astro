---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta
    name="description"
    content="Th.Tech — منصة تقنية عربية للتعلم، البرمجة، الذكاء الاصطناعي، الأمن السيبراني والحوسبة السحابية."
  />

  <meta
    name="keywords"
    content="Th.Tech, برمجة, ذكاء اصطناعي, أمن سيبراني, Python, JavaScript, AWS, Docker"
  />

  <meta name="theme-color" content="#0b1120" />

  <title>Th.Tech | المنصة التقنية</title>

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script>
    (() => {
      try {
        const saved = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', saved);
      } catch {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="hero">

      <div class="hero-bg">
        <img
          src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920"
          alt="Th.Tech Technology"
          loading="eager"
        />

        <div class="hero-grid"></div>
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>
        <div class="overlay"></div>
      </div>

      <div class="container hero-container">

        <div class="hero-content reveal">

          <span class="badge">
            <span class="badge-dot"></span>
            <i class="fas fa-rocket"></i>
            اكتشف، تعلّم، وابتكر
          </span>

          <h1>
            ابنِ
            <span id="typewriter" class="gradient-text"></span>
            <span class="cursor">|</span>
          </h1>

          <p class="hero-description">
            منصة تقنية عربية تجمع بين المعرفة، الأدوات التفاعلية،
            والمحتوى العملي لمساعدتك على تطوير مهاراتك الرقمية خطوة بخطوة.
          </p>

          <div class="hero-actions">

            <a href="/Th-tech/playground/" class="btn btn-primary">
              <i class="fas fa-code"></i>
              ابدأ البرمجة الآن
              <i class="fas fa-arrow-left btn-arrow"></i>
            </a>

            <a href="/Th-tech/guides/" class="btn btn-secondary">
              <i class="fas fa-book-open"></i>
              تصفح المكتبة
            </a>

          </div>

          <div class="hero-features">

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-bolt"></i>
              </span>
              <span>تنفيذ فوري</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-shield-alt"></i>
              </span>
              <span>آمن 100%</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-gift"></i>
              </span>
              <span>مجاني تماماً</span>
            </div>

          </div>

          <!-- Mini credibility bar -->

          <div class="hero-mini-stats">

            <div>
              <strong>150+</strong>
              <span>دليل تقني</span>
            </div>

            <div class="mini-line"></div>

            <div>
              <strong>50K+</strong>
              <span>قارئ شهرياً</span>
            </div>

            <div class="mini-line"></div>

            <div>
              <strong>100%</strong>
              <span>مجاني</span>
            </div>

          </div>

        </div>


        <!-- =====================================
             HERO VISUAL
        ====================================== -->

        <div class="hero-visual reveal">

          <div class="tech-orbit orbit-one"></div>
          <div class="tech-orbit orbit-two"></div>

          <div class="hero-center-logo">
            <div class="logo-core">
              <span>TH</span>
              <small>TECH</small>
            </div>

            <div class="logo-ring"></div>
          </div>


          <!-- Python -->

          <div class="float-card card-1">

            <div class="card-icon python-icon">
              <i class="fab fa-python"></i>
            </div>

            <div class="code-box">
              <div>
                <span class="code-key">print</span>
                <span>(</span>
                <span class="code-string">"مرحباً"</span>
                <span>)</span>
              </div>

              <div class="code-comment">
                # Python 3.11
              </div>
            </div>

          </div>


          <!-- JavaScript -->

          <div class="float-card card-2">

            <div class="small-icon js-icon">
              <i class="fab fa-js"></i>
            </div>

            <div>
              <strong>JavaScript</strong>
              <small>Modern Web</small>
            </div>

          </div>


          <!-- Terminal -->

          <div class="float-card card-3">

            <div class="small-icon terminal-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <strong>Terminal</strong>
              <small>Ready to code</small>
            </div>

          </div>


          <!-- Lessons -->

          <div class="float-card card-4">

            <div class="small-icon success-icon">
              <i class="fas fa-check"></i>
            </div>

            <div>
              <strong>+150 درس</strong>
              <small>متاح الآن</small>
            </div>

          </div>


          <!-- Floating mini nodes -->

          <span class="floating-node node-1">
            <i class="fas fa-code"></i>
          </span>

          <span class="floating-node node-2">
            <i class="fas fa-brain"></i>
          </span>

          <span class="floating-node node-3">
            <i class="fas fa-cloud"></i>
          </span>

        </div>

      </div>

      <div class="hero-scroll">
        <span>اكتشف المزيد</span>
        <i class="fas fa-chevron-down"></i>
      </div>

    </section>


    <!-- =========================================
         TICKER
    ========================================== -->

    <div class="tech-ticker">

      <div class="ticker-fade ticker-fade-right"></div>
      <div class="ticker-fade ticker-fade-left"></div>

      <div class="ticker-track">

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-alt"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>

        <!-- Duplicate for infinite effect -->

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-alt"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>

      </div>

    </div>


    <!-- =========================================
         STATS
    ========================================== -->

    <section class="stats">

      <div class="container">

        <div class="stats-header reveal">
          <span class="section-eyebrow">
            <i class="fas fa-chart-line"></i>
            Th.Tech بالأرقام
          </span>

          <p>
            معرفة تقنية مصممة لتكون عملية، واضحة، ومتاحة للجميع.
          </p>
        </div>

        <div class="stats-grid">

          <div class="stat-item reveal">

            <div class="stat-icon-wrapper">
              <i class="fas fa-book-open stat-icon"></i>
            </div>

            <span
              class="stat-num"
              data-target="150"
              data-suffix="+"
            >0</span>

            <span class="stat-label">
              دليل شامل
            </span>

          </div>

          <div class="stat-divider"></div>

          <div class="stat-item reveal">

            <div class="stat-icon-wrapper">
              <i class="fas fa-users stat-icon"></i>
            </div>

            <span
              class="stat-num"
              data-target="50"
              data-suffix="K+"
            >0</span>

            <span class="stat-label">
              قارئ شهرياً
            </span>

          </div>

          <div class="stat-divider"></div>

          <div class="stat-item reveal">

            <div class="stat-icon-wrapper">
              <i class="fas fa-percentage stat-icon"></i>
            </div>

            <span
              class="stat-num"
              data-target="100"
              data-suffix="%"
            >0</span>

            <span class="stat-label">
              محتوى مجاني
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         TRACKS
    ========================================== -->

    <section class="tracks">

      <div class="container">

        <div class="section-heading reveal">

          <span class="section-eyebrow">
            <i class="fas fa-layer-group"></i>
            ابدأ من هنا
          </span>

          <h2>
            مسارات
            <span>التعلم</span>
          </h2>

          <p>
            اختر المسار المناسب لك وابدأ رحلة تطوير مهاراتك التقنية.
          </p>

        </div>


        <div class="tracks-grid">


          <!-- AI -->

          <a
            href="/Th-tech/ai/"
            class="track reveal"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600"
                alt="الذكاء الاصطناعي"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">
                01
              </span>

            </div>

            <div class="track-body">

              <div class="track-top">

                <div class="icon">
                  <i class="fas fa-brain"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

              <h3>
                الذكاء الاصطناعي
              </h3>

              <p>
                تعلم الآلة والشبكات العصبية وتطبيقات الذكاء الاصطناعي الحديثة.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Machine Learning
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Deep Learning
                </li>

              </ul>

            </div>

          </a>


          <!-- Programming -->

          <a
            href="/Th-tech/programming/"
            class="track reveal"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600"
                alt="البرمجة"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">
                02
              </span>

            </div>

            <div class="track-body">

              <div class="track-top">

                <div class="icon">
                  <i class="fas fa-code"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

              <h3>
                البرمجة
              </h3>

              <p>
                تعلم تطوير المواقع والتطبيقات وبناء المشاريع البرمجية الحديثة.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Full Stack
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  DevOps
                </li>

              </ul>

            </div>

          </a>


          <!-- Security -->

          <a
            href="/Th-tech/security/"
            class="track reveal"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600"
                alt="الأمن السيبراني"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">
                03
              </span>

            </div>

            <div class="track-body">

              <div class="track-top">

                <div class="icon">
                  <i class="fas fa-lock"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

              <h3>
                الأمن السيبراني
              </h3>

              <p>
                تعرف على أساسيات الحماية وأمن المعلومات واختبار الاختراق الأخلاقي.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Ethical Hacking
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Security
                </li>

              </ul>

            </div>

          </a>


          <!-- Cloud -->

          <a
            href="/Th-tech/cloud/"
            class="track reveal"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600"
                alt="الحوسبة السحابية"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">
                04
              </span>

            </div>

            <div class="track-body">

              <div class="track-top">

                <div class="icon">
                  <i class="fas fa-cloud"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>

              <h3>
                السحابة
              </h3>

              <p>
                تعلم AWS وDocker وKubernetes وبناء البنية التحتية الحديثة.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  AWS
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Docker
                </li>

              </ul>

            </div>

          </a>

        </div>

      </div>

    </section>


    <!-- =========================================
         FEATURES
    ========================================== -->

    <section class="features">

      <div class="container">

        <div class="section-heading reveal">

          <span class="section-eyebrow">
            <i class="fas fa-sparkles"></i>
            تجربة مختلفة
          </span>

          <h2>
            لماذا
            <span>Th.Tech؟</span>
          </h2>

          <p>
            أدوات ومحتوى مصممان لجعل التعلم التقني أبسط وأكثر فعالية.
          </p>

        </div>


        <div class="features-grid">


          <div class="feature-box reveal">

            <div class="feature-number">
              01
            </div>

            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>
              سرعة فائقة
            </h3>

            <p>
              تنفيذ الكود فوراً بدون انتظار وتجربة برمجية سلسة.
            </p>

          </div>


          <div class="feature-box reveal">

            <div class="feature-number">
              02
            </div>

            <div class="feature-icon">
              <i class="fas fa-mobile-alt"></i>
            </div>

            <h3>
              متجاوب
            </h3>

            <p>
              تجربة محسنة للعمل على الهاتف واللوحي والحاسوب.
            </p>

          </div>


          <div class="feature-box reveal">

            <div class="feature-number">
              03
            </div>

            <div class="feature-icon">
              <i class="fas fa-save"></i>
            </div>

            <h3>
              حفظ تلقائي
            </h3>

            <p>
              كودك يُحفظ في المتصفح لتتمكن من العودة إليه بسهولة.
            </p>

          </div>


          <div class="feature-box reveal">

            <div class="feature-number">
              04
            </div>

            <div class="feature-icon">
              <i class="fas fa-download"></i>
            </div>

            <h3>
              تصدير سهل
            </h3>

            <p>
              احفظ أعمالك وأكوادك بصيغ مختلفة بكل سهولة.
            </p>

          </div>


        </div>

      </div>

    </section>


    <!-- =========================================
         FAQ
    ========================================== -->

    <section class="faq">

      <div class="container">

        <div class="section-heading reveal">

          <span class="section-eyebrow">
            <i class="fas fa-circle-question"></i>
            لديك سؤال؟
          </span>

          <h2>
            الأسئلة
            <span>الشائعة</span>
          </h2>

          <p>
            إجابات سريعة على أهم الأسئلة حول المنصة.
          </p>

        </div>


        <div class="faq-grid">


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-user-graduate"></i>
            </div>

            <div>
              <h3>
                هل أحتاج خبرة سابقة؟
              </h3>

              <p>
                لا! نبدأ معك من الأساسيات ونساعدك على التقدم خطوة بخطوة.
              </p>
            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <h3>
                كيف أستخدم المحرر؟
              </h3>

              <p>
                اكتب الكود داخل المحرر واضغط على زر "تشغيل" لمشاهدة النتيجة.
              </p>
            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-save"></i>
            </div>

            <div>
              <h3>
                هل يمكنني حفظ أعمالي؟
              </h3>

              <p>
                نعم، يمكن حفظ الأكواد في المتصفح والعودة إليها لاحقاً.
              </p>
            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>
                ما اللغات المدعومة؟
              </h3>

              <p>
                Python وJavaScript وHTML وغيرها من التقنيات التي ستتم إضافتها.
              </p>
            </div>

          </div>


        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- Scroll Top -->

  <button
    id="scrollTop"
    class="scroll-top"
    aria-label="العودة إلى الأعلى"
  >
    <i class="fas fa-arrow-up"></i>
  </button>


  <style>

    /* =====================================================
       ROOT
    ===================================================== */

    :root {

      --bg: #0b1120;
      --bg2: #0f172a;
      --bg3: #162033;

      --text: #f1f5f9;
      --text-muted: #94a3b8;

      --primary: #3b82f6;
      --primary-hover: #2563eb;

      --cyan: #06b6d4;

      --border: rgba(148,163,184,0.14);

      --card: rgba(30,41,59,0.78);

      --shadow:
        0 20px 60px rgba(0,0,0,0.28);

      --glow:
        rgba(59,130,246,0.28);
    }


    [data-theme="light"] {

      --bg: #ffffff;
      --bg2: #f8fafc;
      --bg3: #f1f5f9;

      --text: #0f172a;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;

      --cyan: #0891b2;

      --border: rgba(15,23,42,0.10);

      --card: rgba(255,255,255,0.92);

      --shadow:
        0 20px 50px rgba(15,23,42,0.09);

      --glow:
        rgba(37,99,235,0.12);
    }


    /* =====================================================
       RESET
    ===================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }


    body {

      background: var(--bg);
      color: var(--text);

      font-family: 'Cairo', sans-serif;

      line-height: 1.6;

      overflow-x: hidden;

      transition:
        background-color .3s ease,
        color .3s ease;
    }


    a {
      color: inherit;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    .container {

      width: 100%;
      max-width: 1200px;

      margin: 0 auto;

      padding:
        0 1.5rem;
    }


    section {
      padding: 5.5rem 0;
      position: relative;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero {

      min-height: 100vh;

      display: flex;
      align-items: center;

      position: relative;

      padding:
        130px 0 90px;

      overflow: hidden;
    }


    .hero-bg {

      position: absolute;
      inset: 0;

      z-index: -5;

      overflow: hidden;
    }


    .hero-bg img {

      width: 100%;
      height: 100%;

      object-fit: cover;

      filter:
        brightness(.30)
        saturate(.85);

      transform: scale(1.03);
    }


    .overlay {

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          180deg,
          rgba(11,17,32,.65) 0%,
          rgba(11,17,32,.82) 50%,
          var(--bg) 100%
        );
    }


    .hero-grid {

      position: absolute;
      inset: 0;

      opacity: .17;

      background-image:
        linear-gradient(
          rgba(59,130,246,.20) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(59,130,246,.20) 1px,
          transparent 1px
        );

      background-size: 55px 55px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 85%
        );

      animation:
        gridMove 18s linear infinite;
    }


    @keyframes gridMove {

      from {
        transform: translateY(0);
      }

      to {
        transform: translateY(55px);
      }

    }


    .hero-glow {

      position: absolute;

      width: 500px;
      height: 500px;

      border-radius: 50%;

      filter: blur(100px);

      pointer-events: none;

      opacity: .35;
    }


    .glow-one {

      background: var(--primary);

      top: -180px;
      right: -100px;

      animation:
        glowMove 8s ease-in-out infinite;
    }


    .glow-two {

      background: var(--cyan);

      bottom: -280px;
      left: -150px;

      animation:
        glowMove 10s ease-in-out infinite reverse;
    }


    @keyframes glowMove {

      0%,
      100% {
        transform: translate(0,0);
      }

      50% {
        transform: translate(35px,-25px);
      }

    }


    .hero-container {

      display: grid;

      grid-template-columns:
        1.05fr
        .95fr;

      gap: 4rem;

      align-items: center;

      width: 100%;
    }


    .hero-content {
      position: relative;
      z-index: 3;
    }


    .badge {

      display: inline-flex;

      align-items: center;

      gap: .6rem;

      background:
        rgba(59,130,246,.10);

      color:
        #60a5fa;

      padding:
        .55rem 1.1rem;

      border-radius: 50px;

      margin-bottom: 1.6rem;

      font-weight: 700;

      font-size: .88rem;

      border:
        1px solid
        rgba(96,165,250,.22);

      backdrop-filter:
        blur(10px);

      box-shadow:
        0 10px 35px
        rgba(0,0,0,.08);
    }


    .badge-dot {

      width: 7px;
      height: 7px;

      background:
        #22c55e;

      border-radius: 50%;

      box-shadow:
        0 0 0 5px
        rgba(34,197,94,.10);

      animation:
        pulseDot 2s infinite;
    }


    @keyframes pulseDot {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: .4;
      }

    }


    h1 {

      font-size:
        clamp(
          2.2rem,
          5vw,
          4rem
        );

      margin-bottom: 1.5rem;

      line-height: 1.25;

      font-weight: 800;

      letter-spacing: -.03em;
    }


    .gradient-text {

      background:
        linear-gradient(
          120deg,
          #60a5fa,
          #3b82f6,
          #06b6d4
        );

      -webkit-background-clip:
        text;

      background-clip:
        text;

      -webkit-text-fill-color:
        transparent;

      color: transparent;
    }


    .cursor {

      color: var(--primary);

      animation:
        blink 1s infinite;
    }


    @keyframes blink {

      50% {
        opacity: 0;
      }

    }


    .hero-description {

      max-width: 650px;

      color:
        rgba(226,232,240,.76);

      margin-bottom: 2rem;

      line-height: 2;

      font-size:
        clamp(
          .98rem,
          2vw,
          1.12rem
        );
    }


    [data-theme="light"] .hero-description {
      color: #64748b;
    }


    /* =====================================================
       BUTTONS
    ===================================================== */

    .hero-actions {

      display: flex;

      gap: .9rem;

      margin-bottom: 2rem;

      flex-wrap: wrap;
    }


    .btn {

      min-height: 54px;

      padding:
        .85rem 1.35rem;

      border-radius: 13px;

      font-weight: 700;

      text-decoration: none;

      transition:
        transform .3s ease,
        box-shadow .3s ease,
        border-color .3s ease,
        background .3s ease;

      cursor: pointer;

      border: none;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: .55rem;

      font-size: .95rem;
    }


    .btn-primary {

      background:
        linear-gradient(
          135deg,
          var(--primary),
          #2563eb
        );

      color: white;

      box-shadow:
        0 12px 30px
        rgba(37,99,235,.28);
    }


    .btn-primary:hover {

      transform:
        translateY(-3px);

      box-shadow:
        0 18px 38px
        rgba(37,99,235,.38);
    }


    .btn-arrow {

      font-size: .75rem;

      transition:
        transform .3s ease;
    }


    .btn-primary:hover .btn-arrow {
      transform: translateX(-4px);
    }


    .btn-secondary {

      background:
        rgba(255,255,255,.055);

      color: var(--text);

      border:
        1px solid
        rgba(148,163,184,.22);

      backdrop-filter:
        blur(12px);
    }


    .btn-secondary:hover {

      transform:
        translateY(-3px);

      border-color:
        rgba(59,130,246,.55);

      color:
        #60a5fa;

      background:
        rgba(59,130,246,.08);
    }


    /* =====================================================
       HERO FEATURES
    ===================================================== */

    .hero-features {

      display: flex;

      gap: 1.5rem;

      flex-wrap: wrap;
    }


    .hero-feature {

      display: flex;

      align-items: center;

      gap: .55rem;

      color:
        rgba(226,232,240,.72);

      font-size: .87rem;
    }


    .feature-check {

      width: 28px;
      height: 28px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 8px;

      color:
        #60a5fa;

      background:
        rgba(59,130,246,.12);

      border:
        1px solid
        rgba(59,130,246,.18);
    }


    /* =====================================================
       HERO MINI STATS
    ===================================================== */

    .hero-mini-stats {

      margin-top: 2rem;

      display: flex;

      align-items: center;

      gap: 1.3rem;

      width: fit-content;

      padding:
        .8rem 1.1rem;

      border-radius: 14px;

      background:
        rgba(15,23,42,.42);

      border:
        1px solid
        rgba(148,163,184,.12);

      backdrop-filter:
        blur(15px);
    }


    .hero-mini-stats div:not(.mini-line) {

      display: flex;

      flex-direction: column;

      gap: .1rem;
    }


    .hero-mini-stats strong {

      font-size: 1rem;

      color:
        #e2e8f0;
    }


    .hero-mini-stats span {

      color:
        #94a3b8;

      font-size: .7rem;
    }


    .mini-line {

      width: 1px;
      height: 30px;

      background:
        rgba(148,163,184,.18);
    }


    /* =====================================================
       HERO VISUAL
    ===================================================== */

    .hero-visual {

      position: relative;

      height: 540px;

      display: flex;

      align-items: center;
      justify-content: center;
    }


    .hero-center-logo {

      position: relative;

      width: 180px;
      height: 180px;

      display: flex;

      align-items: center;
      justify-content: center;

      z-index: 1;
    }


    .logo-core {

      width: 110px;
      height: 110px;

      border-radius: 30px;

      display: flex;

      align-items: center;
      justify-content: center;

      flex-direction: column;

      background:
        linear-gradient(
          145deg,
          rgba(59,130,246,.20),
          rgba(6,182,212,.08)
        );

      border:
        1px solid
        rgba(96,165,250,.35);

      box-shadow:
        0 0 50px
        rgba(59,130,246,.22),

        inset 0 0 30px
        rgba(59,130,246,.07);

      backdrop-filter:
        blur(15px);
    }


    .logo-core span {

      font-size: 2rem;

      font-weight: 800;

      line-height: 1;

      background:
        linear-gradient(
          135deg,
          #60a5fa,
          #22d3ee
        );

      -webkit-background-clip:
        text;

      -webkit-text-fill-color:
        transparent;
    }


    .logo-core small {

      margin-top: .3rem;

      letter-spacing:
        .2em;

      color:
        #94a3b8;

      font-size: .55rem;
    }


    .logo-ring {

      position: absolute;

      inset: -20px;

      border-radius: 50%;

      border:
        1px solid
        rgba(59,130,246,.15);

      animation:
        ringRotate 15s linear infinite;
    }


    .logo-ring::before {

      content: '';

      position: absolute;

      width: 9px;
      height: 9px;

      border-radius: 50%;

      background:
        #60a5fa;

      box-shadow:
        0 0 20px
        #3b82f6;

      top: 10px;
      left: 50%;
    }


    @keyframes ringRotate {

      to {
        transform: rotate(360deg);
      }

    }


    .tech-orbit {

      position: absolute;

      border:
        1px dashed
        rgba(59,130,246,.13);

      border-radius: 50%;

      pointer-events: none;
    }


    .orbit-one {

      width: 350px;
      height: 350px;

      animation:
        ringRotate 25s linear infinite;
    }


    .orbit-two {

      width: 480px;
      height: 480px;

      animation:
        ringRotate 35s linear infinite reverse;
    }


    /* =====================================================
       FLOATING CARDS
    ===================================================== */

    .float-card {

      position: absolute;

      background:
        rgba(15,23,42,.72);

      backdrop-filter:
        blur(18px);

      padding: 1rem;

      border-radius: 15px;

      border:
        1px solid
        rgba(148,163,184,.16);

      box-shadow:
        0 18px 50px
        rgba(0,0,0,.25);

      display: flex;

      align-items: center;

      gap: .7rem;

      color:
        #e2e8f0;

      font-weight: 600;

      font-size: .85rem;

      z-index: 3;

      animation:
        float 6s ease-in-out infinite;
    }


    .float-card::after {

      content: '';

      position: absolute;

      inset: 0;

      border-radius: inherit;

      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.05),
          transparent 50%
        );

      pointer-events: none;
    }


    .float-card:hover {

      border-color:
        rgba(96,165,250,.35);

      transform:
        translateY(-8px) scale(1.02);
    }


    .card-1 {

      top: 55px;
      left: 5px;

      width: 230px;

      flex-direction: column;

      align-items: stretch;

      animation-delay: 0s;
    }


    .card-2 {

      top: 145px;
      right: 0;

      animation-delay: 1.4s;
    }


    .card-3 {

      bottom: 145px;
      left: 0;

      animation-delay: 2.7s;
    }


    .card-4 {

      bottom: 45px;
      right: 75px;

      animation-delay: 4s;
    }


    .card-icon {

      width: 42px;
      height: 42px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 11px;

      font-size: 1.5rem;

      background:
        rgba(59,130,246,.1);

      color:
        #60a5fa;
    }


    .python-icon {
      align-self: flex-start;
    }


    .small-icon {

      width: 40px;
      height: 40px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 10px;

      font-size: 1.25rem;
    }


    .js-icon {

      background:
        rgba(250,204,21,.10);

      color:
        #facc15;
    }


    .terminal-icon {

      background:
        rgba(6,182,212,.10);

      color:
        #22d3ee;
    }


    .success-icon {

      background:
        rgba(34,197,94,.10);

      color:
        #4ade80;
    }


    .float-card strong {

      display: block;

      color:
        #f1f5f9;
    }


    .float-card small {

      display: block;

      font-size: .65rem;

      color:
        #64748b;

      font-weight: 500;
    }


    .code-box {

      font-family:
        'Fira Code',
        monospace;

      direction: ltr;

      text-align: left;

      width: 100%;

      font-size: .82rem;

      background:
        rgba(2,6,23,.45);

      border:
        1px solid
        rgba(148,163,184,.08);

      border-radius: 9px;

      padding: .75rem;
    }


    .code-key {
      color: #60a5fa;
    }


    .code-string {
      color: #34d399;
    }


    .code-comment {
      color:
        #64748b;

      margin-top: .3rem;
    }


    @keyframes float {

      0%,
      100% {
        transform:
          translateY(0);
      }

      50% {
        transform:
          translateY(-15px);
      }

    }


    /* =====================================================
       FLOATING NODES
    ===================================================== */

    .floating-node {

      position: absolute;

      width: 40px;
      height: 40px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      color:
        #60a5fa;

      background:
        rgba(15,23,42,.65);

      border:
        1px solid
        rgba(59,130,246,.18);

      backdrop-filter:
        blur(12px);

      box-shadow:
        0 10px 30px
        rgba(0,0,0,.2);

      animation:
        floatNode 5s ease-in-out infinite;
    }


    .node-1 {
      top: 20px;
      right: 35%;

      animation-delay: 1s;
    }


    .node-2 {
      bottom: 75px;
      right: 25%;

      animation-delay: 2s;
    }


    .node-3 {
      top: 42%;
      left: 7%;

      animation-delay: 3s;
    }


    @keyframes floatNode {

      0%,
      100% {
        transform:
          translateY(0)
          rotate(0);
      }

      50% {
        transform:
          translateY(-12px)
          rotate(5deg);
      }

    }


    /* =====================================================
       HERO SCROLL
    ===================================================== */

    .hero-scroll {

      position: absolute;

      bottom: 25px;
      left: 50%;

      transform:
        translateX(-50%);

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: .3rem;

      color:
        #64748b;

      font-size: .65rem;

      z-index: 4;
    }


    .hero-scroll i {

      color:
        #3b82f6;

      animation:
        scrollBounce 1.7s infinite;
    }


    @keyframes scrollBounce {

      0%,
      100% {
        transform:
          translateY(0);
      }

      50% {
        transform:
          translateY(5px);
      }

    }


    /* =====================================================
       TICKER
    ===================================================== */

    .tech-ticker {

      position: relative;

      background:
        var(--bg2);

      padding:
        1.1rem 0;

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);

      overflow: hidden;
    }


    .ticker-track {

      display: flex;

      gap: 3.5rem;

      width: max-content;

      animation:
        scrollTicker 35s linear infinite;
    }


    .tech-item {

      color:
        var(--text-muted);

      font-weight: 700;

      display: flex;

      align-items: center;

      gap: .55rem;

      white-space: nowrap;

      font-size: .9rem;

      transition:
        color .3s ease;
    }


    .tech-item i {
      color:
        var(--primary);

      font-size: 1.1rem;
    }


    .tech-item:hover {
      color:
        var(--text);
    }


    @keyframes scrollTicker {

      from {
        transform:
          translateX(0);
      }

      to {
        transform:
          translateX(-50%);
      }

    }


    .ticker-fade {

      position: absolute;

      top: 0;
      bottom: 0;

      width: 100px;

      z-index: 2;

      pointer-events: none;
    }


    .ticker-fade-right {

      right: 0;

      background:
        linear-gradient(
          to left,
          var(--bg2),
          transparent
        );
    }


    .ticker-fade-left {

      left: 0;

      background:
        linear-gradient(
          to right,
          var(--bg2),
          transparent
        );
    }


    /* =====================================================
       SECTION HEADINGS
    ===================================================== */

    .section-heading {

      text-align: center;

      max-width: 720px;

      margin:
        0 auto 3.5rem;
    }


    .section-eyebrow {

      display: inline-flex;

      align-items: center;

      gap: .45rem;

      color:
        var(--primary);

      font-size: .78rem;

      font-weight: 800;

      margin-bottom: .7rem;

      text-transform: uppercase;

      letter-spacing: .04em;
    }


    .section-heading h2 {

      margin-bottom: .7rem;
    }


    .section-heading h2 span {

      color:
        var(--primary);
    }


    .section-heading p {

      color:
        var(--text-muted);

      font-size: .95rem;
    }


    h2 {

      text-align: center;

      font-size:
        clamp(
          1.7rem,
          4vw,
          2.35rem
        );

      margin-bottom: 3rem;

      color:
        var(--text);

      font-weight: 800;
    }


    h2 i {

      color:
        var(--primary);

      margin-left: .5rem;
    }


    /* =====================================================
       STATS
    ===================================================== */

    .stats {

      background:
        var(--bg2);

      padding:
        3.7rem 0;

      border-bottom:
        1px solid
        var(--border);
    }


    .stats-header {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 2.5rem;

      padding-bottom: 1rem;

      border-bottom:
        1px solid
        var(--border);
    }


    .stats-header p {

      color:
        var(--text-muted);

      font-size: .85rem;
    }


    .stats-grid {

      display: flex;

      justify-content: center;

      align-items: stretch;

      gap: 4rem;

      flex-wrap: wrap;
    }


    .stat-item {

      min-width: 170px;

      text-align: center;

      display: flex;

      flex-direction: column;

      align-items: center;
    }


    .stat-icon-wrapper {

      width: 48px;
      height: 48px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        rgba(59,130,246,.08);

      border:
        1px solid
        rgba(59,130,246,.14);

      margin-bottom: .8rem;
    }


    .stat-icon {

      font-size:
        1.25rem;

      color:
        var(--primary);
    }


    .stat-num {

      display: block;

      font-size:
        2.6rem;

      font-weight: 800;

      color:
        var(--primary);

      line-height: 1;

      letter-spacing:
        -.04em;
    }


    .stat-label {

      margin-top: .5rem;

      color:
        var(--text-muted);

      font-size: .82rem;
    }


    .stat-divider {

      width: 1px;

      height: 75px;

      align-self: center;

      background:
        var(--border);
    }


    /* =====================================================
       TRACKS
    ===================================================== */

    .tracks {
      background:
        var(--bg);
    }


    .tracks-grid {

      display: grid;

      grid-template-columns:
        repeat(
          4,
          1fr
        );

      gap: 1.3rem;
    }


    .track {

      position: relative;

      background:
        var(--card);

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      overflow: hidden;

      text-decoration: none;

      color:
        var(--text);

      transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;

      display: flex;

      flex-direction: column;
    }


    .track:hover {

      transform:
        translateY(-8px);

      border-color:
        rgba(59,130,246,.45);

      box-shadow:
        0 22px 55px
        var(--glow);
    }


    .track-img {

      height: 190px;

      overflow: hidden;

      position: relative;
    }


    .track-img img {

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform .6s ease;
    }


    .track:hover .track-img img {

      transform:
        scale(1.08);
    }


    .track-img-overlay {

      position: absolute;

      inset: 0;

      background:
        linear-gradient(
          to top,
          rgba(2,6,23,.72),
          transparent 65%
        );
    }


    .track-number {

      position: absolute;

      top: 15px;
      right: 15px;

      font-size: .68rem;

      font-weight: 800;

      color:
        white;

      background:
        rgba(2,6,23,.45);

      border:
        1px solid
        rgba(255,255,255,.12);

      padding:
        .25rem .5rem;

      border-radius: 7px;

      backdrop-filter:
        blur(8px);
    }


    .track-body {

      padding:
        1.3rem;

      flex: 1;

      display: flex;

      flex-direction: column;
    }


    .track-top {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: .9rem;
    }


    .icon {

      width: 47px;
      height: 47px;

      background:
        var(--bg3);

      border-radius: 12px;

      display: flex;

      align-items: center;
      justify-content: center;

      color:
        var(--primary);

      font-size:
        1.25rem;

      border:
        1px solid
        var(--border);

      transition:
        transform .3s ease,
        background .3s ease;
    }


    .track:hover .icon {

      transform:
        rotate(-5deg)
        scale(1.06);

      background:
        rgba(59,130,246,.10);
    }


    .track-arrow {

      width: 31px;
      height: 31px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 50%;

      color:
        var(--text-muted);

      background:
        var(--bg3);

      transition:
        all .3s ease;
    }


    .track:hover .track-arrow {

      color:
        white;

      background:
        var(--primary);

      transform:
        translateX(-3px);
    }


    .track-body h3 {

      margin-bottom: .45rem;

      font-size: 1.12rem;

      color:
        var(--text);
    }


    .track-body > p {

      color:
        var(--text-muted);

      font-size: .82rem;

      margin-bottom: 1rem;

      line-height: 1.8;
    }


    .track-list {

      list-style: none;

      margin-top: auto;

      padding-top: .8rem;

      border-top:
        1px solid
        var(--border);
    }


    .track-list li {

      padding: .3rem 0;

      color:
        var(--text-muted);

      font-size: .76rem;

      display: flex;

      align-items: center;
    }


    .track-list i {

      color:
        var(--primary);

      margin-left: .5rem;

      font-size: .62rem;
    }


    /* =====================================================
       FEATURES
    ===================================================== */

    .features {

      background:
        var(--bg2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);
    }


    .features-grid {

      display: grid;

      grid-template-columns:
        repeat(
          4,
          1fr
        );

      gap: 1.3rem;
    }


    .feature-box {

      position: relative;

      background:
        var(--card);

      border:
        1px solid
        var(--border);

      border-radius: 17px;

      padding:
        2rem 1.5rem;

      text-align: center;

      transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;

      overflow: hidden;
    }


    .feature-box::before {

      content: '';

      position: absolute;

      top: 0;
      left: 0;

      width: 100%;
      height: 2px;

      background:
        linear-gradient(
          90deg,
          transparent,
          var(--primary),
          transparent
        );

      opacity: 0;

      transition:
        opacity .3s ease;
    }


    .feature-box:hover::before {
      opacity: 1;
    }


    .feature-box:hover {

      transform:
        translateY(-7px);

      border-color:
        rgba(59,130,246,.35);

      box-shadow:
        0 20px 50px
        var(--glow);
    }


    .feature-number {

      position: absolute;

      top: 15px;
      right: 17px;

      color:
        rgba(148,163,184,.18);

      font-size: .7rem;

      font-weight: 800;
    }


    .feature-icon {

      width: 65px;
      height: 65px;

      background:
        rgba(59,130,246,.08);

      border:
        1px solid
        rgba(59,130,246,.13);

      border-radius: 18px;

      display: flex;

      align-items: center;
      justify-content: center;

      color:
        var(--primary);

      font-size:
        1.6rem;

      margin:
        0 auto 1.2rem;

      transition:
        transform .3s ease,
        background .3s ease;
    }


    .feature-box:hover .feature-icon {

      transform:
        scale(1.08)
        rotate(-4deg);

      background:
        rgba(59,130,246,.13);
    }


    .feature-box h3 {

      margin-bottom: .5rem;

      font-size: 1.08rem;

      color:
        var(--text);
    }


    .feature-box p {

      margin: 0;

      font-size: .82rem;

      color:
        var(--text-muted);

      line-height: 1.8;
    }


    /* =====================================================
       FAQ
    ===================================================== */

    .faq {

      background:
        var(--bg);
    }


    .faq-grid {

      display: grid;

      grid-template-columns:
        repeat(
          2,
          1fr
        );

      gap: 1rem;
    }


    .faq-item {

      display: flex;

      gap: 1rem;

      background:
        var(--card);

      padding:
        1.4rem;

      border-radius: 15px;

      border:
        1px solid
        var(--border);

      transition:
        transform .3s ease,
        border-color .3s ease,
        background .3s ease;
    }


    .faq-item:hover {

      transform:
        translateY(-4px);

      border-color:
        rgba(59,130,246,.35);

      background:
        rgba(59,130,246,.035);
    }


    .faq-icon {

      flex:
        0 0 43px;

      width: 43px;
      height: 43px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 11px;

      color:
        var(--primary);

      background:
        rgba(59,130,246,.08);

      border:
        1px solid
        rgba(59,130,246,.12);
    }


    .faq-item h3 {

      color:
        var(--text);

      margin-bottom: .45rem;

      font-size: .95rem;
    }


    .faq-item p {

      margin: 0;

      color:
        var(--text-muted);

      line-height: 1.8;

      font-size: .8rem;
    }


    /* =====================================================
       SCROLL TOP
    ===================================================== */

    .scroll-top {

      position: fixed;

      bottom: 1.5rem;
      left: 1.5rem;

      width: 48px;
      height: 48px;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-hover)
        );

      color:
        white;

      border: none;

      border-radius: 14px;

      cursor: pointer;

      opacity: 0;

      visibility: hidden;

      transform:
        translateY(15px);

      transition:
        all .3s ease;

      z-index: 999;

      font-size: 1rem;

      box-shadow:
        0 10px 30px
        rgba(37,99,235,.3);
    }


    .scroll-top.show {

      opacity: 1;

      visibility: visible;

      transform:
        translateY(0);
    }


    .scroll-top:hover {

      transform:
        translateY(-4px);
    }


    /* =====================================================
       REVEAL ANIMATION
    ===================================================== */

    .reveal {

      opacity: 0;

      transform:
        translateY(25px);

      transition:
        opacity .7s ease,
        transform .7s ease;
    }


    .reveal.visible {

      opacity: 1;

      transform:
        translateY(0);
    }


    /* =====================================================
       TABLET
    ===================================================== */

    @media (max-width: 1100px) {

      .hero-container {

        grid-template-columns:
          1fr 1fr;

        gap: 2rem;
      }


      .hero-visual {
        transform:
          scale(.9);
      }


      .tracks-grid,
      .features-grid {

        grid-template-columns:
          repeat(
            2,
            1fr
          );
      }

    }


    /* =====================================================
       MOBILE / TABLET
    ===================================================== */

    @media (max-width: 850px) {

      .hero {

        min-height:
          auto;

        padding:
          110px 0 70px;
      }


      .hero-container {

        grid-template-columns:
          1fr;

        text-align: center;
      }


      .hero-content {

        display: flex;

        flex-direction: column;

        align-items: center;
      }


      .hero-description {

        max-width:
          600px;
      }


      .hero-features {

        justify-content:
          center;
      }


      .hero-mini-stats {

        margin-left: auto;
        margin-right: auto;
      }


      .hero-visual {

        display: none;
      }


      .hero-scroll {
        display: none;
      }


      .stats-header {

        flex-direction: column;

        align-items: center;

        text-align: center;

        gap: .5rem;
      }


      .stats-grid {

        gap: 2rem;
      }


      .stat-divider {

        width: 50px;

        height: 1px;
      }

    }


    /* =====================================================
       SMALL MOBILE
    ===================================================== */

    @media (max-width: 600px) {

      .container {
        padding:
          0 1rem;
      }


      section {
        padding:
          4rem 0;
      }


      h1 {

        font-size:
          2rem;

        line-height:
          1.35;
      }


      .hero {

        padding:
          100px 0 55px;
      }


      .hero-description {

        font-size:
          .92rem;

        line-height:
          1.9;
      }


      .hero-actions {

        flex-direction:
          column;

        width: 100%;

        max-width:
          360px;
      }


      .btn {

        width:
          100%;
      }


      .hero-features {

        flex-direction:
          column;

        gap: .7rem;

        align-items:
          flex-start;
      }


      .hero-mini-stats {

        width:
          100%;

        justify-content:
          space-around;

        gap: .6rem;

        padding:
          .7rem;
      }


      .hero-mini-stats strong {
        font-size: .9rem;
      }


      .hero-mini-stats span {
        font-size: .62rem;
      }


      .mini-line {
        height: 25px;
      }


      .tech-ticker {
        padding:
          .8rem 0;
      }


      .tech-item {
        font-size:
          .78rem;
      }


      .ticker-track {
        gap:
          2rem;
      }


      .tracks-grid,
      .features-grid,
      .faq-grid {

        grid-template-columns:
          1fr;
      }


      .tracks-grid {
        gap:
          1rem;
      }


      .track-img {
        height:
          200px;
      }


      .features-grid {
        gap:
          1rem;
      }


      .faq-grid {
        gap:
          .8rem;
      }


      .faq-item {
        padding:
          1.1rem;
      }


      .faq-item p {
        font-size:
          .76rem;
      }


      .stats {
        padding:
          3rem 0;
      }


      .stats-grid {
        flex-direction:
          column;

        gap:
          1.7rem;
      }


      .stat-divider {

        width:
          80px;

        height:
          1px;
      }


      .section-heading {
        margin-bottom:
          2.3rem;
      }


      .section-heading h2 {
        margin-bottom:
          .5rem;
      }


      .scroll-top {

        width:
          45px;

        height:
          45px;

        left:
          1rem;

        bottom:
          1rem;
      }

    }


    /* =====================================================
       VERY SMALL SCREENS
    ===================================================== */

    @media (max-width: 380px) {

      h1 {
        font-size:
          1.8rem;
      }


      .hero-mini-stats {

        gap:
          .3rem;
      }


      .hero-mini-stats strong {
        font-size:
          .82rem;
      }


      .hero-mini-stats span {
        font-size:
          .57rem;
      }

    }


    /* =====================================================
       REDUCED MOTION
    ===================================================== */

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {

        animation-duration:
          .01ms !important;

        animation-iteration-count:
          1 !important;

        scroll-behavior:
          auto !important;

        transition-duration:
          .01ms !important;
      }

    }

  </style>


  <script>

    /* =====================================================
       TYPEWRITER
    ===================================================== */

    const typewriter =
      document.getElementById('typewriter');

    const text =
      "المستقبل الرقمي بأدوات احترافية";

    let typeIndex = 0;

    function type() {

      if (!typewriter) return;

      if (typeIndex < text.length) {

        typewriter.textContent +=
          text.charAt(typeIndex);

        typeIndex++;

        setTimeout(type, 70);

      }

    }

    setTimeout(type, 500);


    /* =====================================================
       COUNTERS
    ===================================================== */

    const counters =
      document.querySelectorAll('.stat-num');

    const counterObserver =
      new IntersectionObserver(
        (entries, observer) => {

          entries.forEach(entry => {

            if (!entry.isIntersecting)
              return;

            const counter =
              entry.target;

            const target =
              Number(
                counter.dataset.target
              );

            const suffix =
              counter.dataset.suffix || '';

            const duration =
              1200;

            const start =
              performance.now();

            function update(now) {

              const progress =
                Math.min(
                  (now - start) / duration,
                  1
                );

              const eased =
                1 -
                Math.pow(
                  1 - progress,
                  3
                );

              const current =
                Math.floor(
                  eased * target
                );

              counter.textContent =
                current + suffix;

              if (progress < 1) {

                requestAnimationFrame(
                  update
                );

              } else {

                counter.textContent =
                  target + suffix;
              }

            }

            requestAnimationFrame(update);

            observer.unobserve(counter);

          });

        },
        {
          threshold: .4
        }
      );


    counters.forEach(counter => {
      counterObserver.observe(counter);
    });


    /* =====================================================
       REVEAL ON SCROLL
    ===================================================== */

    const revealElements =
      document.querySelectorAll('.reveal');


    const revealObserver =
      new IntersectionObserver(
        (entries, observer) => {

          entries.forEach(entry => {

            if (
              entry.isIntersecting
            ) {

              entry.target.classList.add(
                'visible'
              );

              observer.unobserve(
                entry.target
              );

            }

          });

        },
        {
          threshold: .12
        }
      );


    revealElements.forEach(
      element => {
        revealObserver.observe(element);
      }
    );


    /* =====================================================
       SCROLL TOP
    ===================================================== */

    const scrollTop =
      document.getElementById(
        'scrollTop'
      );


    window.addEventListener(
      'scroll',
      () => {

        if (!scrollTop) return;

        if (window.scrollY > 350) {

          scrollTop.classList.add(
            'show'
          );

        } else {

          scrollTop.classList.remove(
            'show'
          );

        }

      },
      {
        passive: true
      }
    );


    scrollTop?.addEventListener(
      'click',
      () => {

        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });

      }
    );


    /* =====================================================
       THEME EVENT
    ===================================================== */

    window.addEventListener(
      'themeChange',
      (event) => {

        if (
          event.detail === 'dark' ||
          event.detail === 'light'
        ) {

          document.documentElement
            .setAttribute(
              'data-theme',
              event.detail
            );

        }

      }
    );


    /* =====================================================
       CARD STAGGER
    ===================================================== */

    document
      .querySelectorAll(
        '.tracks-grid .reveal, .features-grid .reveal, .faq-grid .reveal'
      )
      .forEach(
        (element, index) => {

          element.style.transitionDelay =
            `${Math.min(index * 70, 280)}ms`;

        }
      );

  </script>

</body>
</html>
