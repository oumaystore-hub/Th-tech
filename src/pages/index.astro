---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((file) => file.match(/\.\/tools\/([^/]+)\/index\.astro$/)?.[1])
  .filter(Boolean);

const displayName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolsData = toolSlugs.map((slug) => ({
  slug,
  name: displayName(slug),
  href: `${base}/tools/${slug}/`
}));

const featuredSlugs = [
  'json-formatter',
  'json-validator',
  'base64-encoder-decoder',
  'qr-code-generator',
  'color-picker',
  'api-request-builder'
];

const featuredMeta = {
  'json-formatter': {
    icon: 'fa-solid fa-code',
    image:
      'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=900&q=80',
    description: 'تنسيق JSON وتحسين قراءته بسرعة وسهولة.'
  },

  'json-validator': {
    icon: 'fa-solid fa-check-double',
    image:
      'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=900&q=80',
    description: 'تحقق من صحة JSON واكتشف الأخطاء بسهولة.'
  },

  'base64-encoder-decoder': {
    icon: 'fa-solid fa-lock',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=900&q=80',
    description: 'تشفير وفك ترميز Base64 مباشرة من المتصفح.'
  },

  'qr-code-generator': {
    icon: 'fa-solid fa-qrcode',
    image:
      'https://images.unsplash.com/photo-1595079676339-1534801ad6cf?auto=format&fit=crop&w=900&q=80',
    description: 'إنشاء رموز QR بسرعة وبدون تعقيد.'
  },

  'color-picker': {
    icon: 'fa-solid fa-palette',
    image:
      'https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=900&q=80',
    description: 'اختيار وتحليل الألوان واستخراج قيمها.'
  },

  'api-request-builder': {
    icon: 'fa-solid fa-plug',
    image:
      'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=900&q=80',
    description: 'إرسال واختبار طلبات API مباشرة من المتصفح.'
  }
};

const featuredTools = featuredSlugs
  .map((slug) => {
    const tool = toolsData.find((item) => item.slug === slug);

    if (!tool) return null;

    return {
      ...tool,
      ...featuredMeta[slug]
    };
  })
  .filter(Boolean);

const quickTools = featuredTools.slice(0, 6);

const tracks = [
  {
    icon: 'fa-solid fa-robot',
    title: 'الذكاء الاصطناعي',
    description: 'أدوات وتقنيات تساعدك على العمل والتعلم باستخدام AI.',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-code',
    title: 'البرمجة',
    description: 'أدوات للمطورين والمبرمجين لتسريع العمل.',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'الأمان والخصوصية',
    description: 'أدوات للتشفير، الهاش، الترميز وحماية البيانات.',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-globe',
    title: 'الويب',
    description: 'أدوات HTML وCSS وURL وAPI وغيرها.',
    href: '#tools'
  }
];

const missions = [
  {
    icon: 'fa-solid fa-code',
    title: 'أتعامل مع JSON',
    description: 'نسّق أو تحقق من بيانات JSON بسرعة.',
    href: `${base}/tools/json-formatter/`
  },
  {
    icon: 'fa-solid fa-plug',
    title: 'أختبر API',
    description: 'أرسل طلبات HTTP واختبر الاستجابات.',
    href: `${base}/tools/api-request-builder/`
  },
  {
    icon: 'fa-solid fa-lock',
    title: 'أريد تشفير أو ترميز',
    description: 'استخدم أدوات Base64 والهاش والتشفير.',
    href: `${base}/tools/`
  },
  {
    icon: 'fa-solid fa-palette',
    title: 'أتعامل مع الألوان',
    description: 'اختر لوناً واحصل على قيمته بسهولة.',
    href: `${base}/tools/color-picker/`
  }
];

const labs = [
  {
    icon: 'fa-solid fa-code',
    title: 'مختبر المطور',
    description: 'أدوات عملية للمطورين والمبرمجين.',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'مختبر الخصوصية',
    description: 'أدوات لمعالجة البيانات محلياً في المتصفح.',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-robot',
    title: 'مختبر الذكاء الاصطناعي',
    description: 'استكشف أدوات وتقنيات مرتبطة بالذكاء الاصطناعي.',
    href: '#tracks'
  }
];

const tickerItems = [
  'JSON',
  'JavaScript',
  'HTML',
  'CSS',
  'API',
  'SQL',
  'QR CODE',
  'BASE64',
  'JWT',
  'REGEX',
  'UUID',
  'HASH',
  'MARKDOWN',
  'TIMESTAMP'
];

const faqs = [
  {
    question: 'ما هو Th.Tech؟',
    answer:
      'Th.Tech منصة تقنية تجمع مجموعة كبيرة من الأدوات المجانية التي تساعد المطورين والمصممين والطلاب والمستخدمين في إنجاز المهام اليومية بسرعة.'
  },
  {
    question: 'هل الأدوات مجانية؟',
    answer:
      'نعم، الأدوات المتوفرة على المنصة مصممة للاستخدام المجاني دون الحاجة إلى اشتراك.'
  },
  {
    question: 'هل تعمل الأدوات على الهاتف؟',
    answer:
      'نعم، تم تصميم الأدوات والواجهة لتعمل على الهاتف والكمبيوتر والأجهزة اللوحية.'
  },
  {
    question: 'هل يتم إرسال بياناتي إلى خادم خارجي؟',
    answer:
      'الكثير من الأدوات تعمل مباشرة داخل المتصفح. تختلف طريقة المعالجة حسب طبيعة كل أداة، لذلك يُفضّل مراجعة وصف الأداة قبل استخدامها مع بيانات حساسة.'
  }
];

const toolsCount = toolSlugs.length;

const codeEditorHref = `${base}/tools/code-editor/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description:
    'Th.Tech منصة تقنية توفر أدوات مجانية للمطورين والمصممين والطلاب والمستخدمين.',
  publisher: {
    '@type': 'Organization',
    name: 'Th.Tech',
    url: `${siteUrl}${base}/`
  },
  sameAs: [
    'https://www.facebook.com/share/1PzewvX774/',
    'https://www.instagram.com/thtech.ma',
    'https://x.com/thtechma',
    'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438',
    'https://www.youtube.com/@thtechma'
  ]
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Th.Tech - أدوات تقنية مجانية للمطورين والمصممين</title>

    <meta
      name="description"
      content="Th.Tech منصة تقنية توفر أدوات مجانية للمطورين والمصممين والطلاب والمستخدمين، تشمل JSON وAPI وBase64 وQR والألوان وغيرها."
    />

    <meta
      name="keywords"
      content="أدوات تقنية, أدوات برمجة, JSON, API, Base64, QR Code, CSS, HTML, JavaScript, Th.Tech"
    />

    <meta name="author" content="Th.Tech" />

    <link rel="canonical" href={`${siteUrl}${base}/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <style>
      :root {
        --bg: #f8fafc;
        --surface: #ffffff;
        --surface-2: #f1f5f9;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #0284c7;
        --primary-2: #0369a1;
        --border: #e2e8f0;
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        --radius: 22px;
        --max-width: 1180px;
      }

      html.dark-mode {
        --bg: #0b1120;
        --surface: #111827;
        --surface-2: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --primary: #38bdf8;
        --primary-2: #0ea5e9;
        --border: #263449;
        --shadow: 0 20px 50px rgba(0, 0, 0, 0.28);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 10% 10%,
            rgba(14, 165, 233, 0.08),
            transparent 28%
          ),
          radial-gradient(
            circle at 90% 20%,
            rgba(99, 102, 241, 0.06),
            transparent 28%
          ),
          var(--bg);
        color: var(--text);
        font-family: 'Cairo', sans-serif;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      .container {
        width: min(var(--max-width), calc(100% - 32px));
        margin-inline: auto;
      }

      .section {
        padding: 70px 0;
      }

      .section-heading {
        text-align: center;
        max-width: 720px;
        margin: 0 auto 38px;
      }

      .section-heading .eyebrow {
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
      }

      .section-heading h2 {
        margin: 0 0 10px;
        font-size: clamp(26px, 4vw, 38px);
        line-height: 1.25;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 14px;
      }

      /* =========================
         HERO
         ========================= */

      .hero {
        position: relative;
        min-height: 650px;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: 80px 0;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 55px;
        align-items: center;
      }

      .hero-content {
        position: relative;
        z-index: 2;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(2, 132, 199, 0.08);
        border: 1px solid rgba(2, 132, 199, 0.18);
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 18px;
      }

      .hero-badge i {
        font-size: 11px;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(38px, 6vw, 72px);
        line-height: 1.05;
        letter-spacing: -1.5px;
      }

      .hero h1 span {
        color: var(--primary);
      }

      .hero-text {
        margin: 20px 0 28px;
        max-width: 650px;
        color: var(--muted);
        line-height: 2;
        font-size: 16px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .hero-button {
        min-height: 48px;
        padding: 0 20px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        font-weight: 800;
        font-size: 14px;
        transition: 0.2s ease;
      }

      .hero-button.primary {
        background: var(--primary);
        color: #fff;
      }

      .hero-button.secondary {
        background: var(--surface);
        border: 1px solid var(--border);
      }

      .hero-button:hover {
        transform: translateY(-2px);
      }

      .hero-visual {
        position: relative;
      }

      .hero-card {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 22px;
        box-shadow: var(--shadow);
        backdrop-filter: blur(16px);
      }

      html.dark-mode .hero-card {
        background: rgba(17, 24, 39, 0.78);
      }

      .hero-terminal {
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        font-family: 'JetBrains Mono', monospace;
      }

      .terminal-top {
        height: 42px;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .terminal-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #64748b;
      }

      .terminal-code {
        padding: 22px;
        font-size: 12px;
        line-height: 2;
        min-height: 260px;
      }

      .code-blue {
        color: #38bdf8;
      }

      .code-green {
        color: #4ade80;
      }

      .code-purple {
        color: #c084fc;
      }

      .code-gray {
        color: #94a3b8;
      }

      /* =========================
         TICKER
         ========================= */

      .ticker {
        overflow: hidden;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }

      .ticker-track {
        display: flex;
        width: max-content;
        gap: 30px;
        padding: 14px 0;
        animation: ticker 28s linear infinite;
      }

      .ticker-item {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        white-space: nowrap;
      }

      .ticker-item::before {
        content: '◆';
        color: var(--primary);
        font-size: 7px;
      }

      @keyframes ticker {
        from {
          transform: translateX(0);
        }

        to {
          transform: translateX(-50%);
        }
      }

      /* =========================
         STATS
         ========================= */

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .stat {
        padding: 26px;
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }

      .stat-number {
        display: block;
        font-size: 34px;
        font-weight: 900;
        color: var(--primary);
        font-family: 'JetBrains Mono', monospace;
      }

      .stat-label {
        color: var(--muted);
        font-size: 13px;
        margin-top: 4px;
      }

      /* =========================
         SEARCH
         ========================= */

      .search-box {
        max-width: 760px;
        margin: 0 auto 30px;
        position: relative;
      }

      .search-box i {
        position: absolute;
        right: 17px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
      }

      .search-box input {
        width: 100%;
        height: 58px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--surface);
        color: var(--text);
        outline: none;
        padding: 0 48px 0 18px;
      }

      .search-box input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
      }

      /* =========================
         TOOLS
         ========================= */

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
      }

      .tool-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 19px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: 0.2s ease;
      }

      .tool-card:hover {
        transform: translateY(-3px);
        border-color: rgba(2, 132, 199, 0.35);
        box-shadow: var(--shadow);
      }

      .tool-icon {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        background: rgba(2, 132, 199, 0.09);
        color: var(--primary);
      }

      .tool-info {
        min-width: 0;
      }

      .tool-info strong {
        display: block;
        font-size: 14px;
        margin-bottom: 3px;
      }

      .tool-info span {
        display: block;
        color: var(--muted);
        font-size: 11px;
      }

      /* =========================
         FEATURED
         ========================= */

      .featured-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .featured-card {
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 22px;
        transition: 0.2s ease;
      }

      .featured-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow);
      }

      .featured-image {
        height: 175px;
        overflow: hidden;
        position: relative;
      }

      .featured-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .featured-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(2, 6, 23, 0.7),
          transparent 60%
        );
      }

      .featured-icon {
        position: absolute;
        bottom: 14px;
        right: 14px;
        width: 43px;
        height: 43px;
        border-radius: 13px;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        display: grid;
        place-items: center;
        color: #fff;
      }

      .featured-content {
        padding: 19px;
      }

      .featured-content h3 {
        margin: 0 0 7px;
        font-size: 16px;
      }

      .featured-content p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
      }

      .featured-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 14px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
      }

      /* =========================
         TRACKS
         ========================= */

      .tracks {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      .track-card {
        padding: 25px 20px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        text-align: center;
      }

      .track-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        margin: 0 auto 15px;
        background: rgba(2, 132, 199, 0.08);
        color: var(--primary);
      }

      .track-card h3 {
        margin: 0 0 8px;
        font-size: 15px;
      }

      .track-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* =========================
         MISSIONS
         ========================= */

      .missions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      .mission-card {
        padding: 22px;
        background: linear-gradient(
          145deg,
          var(--surface),
          var(--surface-2)
        );
        border: 1px solid var(--border);
        border-radius: 20px;
      }

      .mission-icon {
        color: var(--primary);
        font-size: 21px;
        margin-bottom: 13px;
      }

      .mission-card h3 {
        margin: 0 0 7px;
        font-size: 14px;
      }

      .mission-card p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      .mission-card a {
        display: inline-flex;
        margin-top: 13px;
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
      }

      /* =========================
         CODE EDITOR
         ========================= */

      .editor-section {
        padding-top: 55px;
        padding-bottom: 55px;
      }

      .editor-card {
        position: relative;
        overflow: hidden;
        min-height: 310px;
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        align-items: center;
        gap: 10px;
        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(56, 189, 248, 0.14),
            transparent 32%
          ),
          #0f172a;
        border-radius: 28px;
        border: 1px solid rgba(148, 163, 184, 0.15);
        box-shadow: var(--shadow);
      }

      .editor-info {
        position: relative;
        z-index: 2;
        padding: 35px;
      }

      .editor-info .eyebrow {
        color: #38bdf8;
        font-size: 12px;
        font-weight: 800;
      }

      .editor-info h2 {
        margin: 8px 0 10px;
        color: #fff;
        font-size: clamp(25px, 4vw, 38px);
        line-height: 1.25;
      }

      .editor-info p {
        margin: 0;
        max-width: 470px;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.9;
      }

      .editor-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        margin-top: 20px;
        padding: 0 17px;
        border-radius: 12px;
        background: #38bdf8;
        color: #082f49;
        font-size: 12px;
        font-weight: 900;
        transition: 0.2s ease;
      }

      .editor-button:hover {
        transform: translateY(-2px);
      }

      .editor-window {
        width: 90%;
        min-height: 220px;
        margin-inline: auto;
        background: #020617;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.3);
        transform: perspective(1000px) rotateY(-5deg);
      }

      .window-header {
        height: 38px;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 13px;
        background: #111827;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .window-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #475569;
      }

      .code-lines {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .code-line {
        height: 6px;
        border-radius: 99px;
        background: #334155;
      }

      .code-line.short {
        width: 42%;
      }

      .code-line.medium {
        width: 67%;
      }

      .code-line.long {
        width: 88%;
      }

      .code-line.blue {
        background: #0ea5e9;
        opacity: 0.75;
      }

      .code-line.green {
        background: #22c55e;
        opacity: 0.65;
      }

      /* =========================
         LABS
         ========================= */

      .lab-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .lab-card {
        padding: 27px;
        border-radius: 22px;
        background: var(--surface);
        border: 1px solid var(--border);
        transition: 0.2s ease;
      }

      .lab-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow);
      }

      .lab-card i {
        font-size: 22px;
        color: var(--primary);
        margin-bottom: 15px;
      }

      .lab-card h3 {
        margin: 0 0 8px;
        font-size: 16px;
      }

      .lab-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* =========================
         FAQ
         ========================= */

      .faq {
        max-width: 850px;
        margin: auto;
      }

      .faq-item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 17px;
        margin-bottom: 12px;
        overflow: hidden;
      }

      .faq-question {
        width: 100%;
        border: 0;
        background: transparent;
        color: var(--text);
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: right;
        cursor: pointer;
        font-weight: 800;
        font-size: 13px;
      }

      .faq-question i {
        color: var(--primary);
        transition: transform 0.2s ease;
      }

      .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.25s ease;
      }

      .faq-answer-inner {
        padding: 0 20px 18px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .faq-item.active .faq-question i {
        transform: rotate(180deg);
      }

      /* =========================
         CTA
         ========================= */

      .cta {
        padding: 50px 25px;
        text-align: center;
        border-radius: 28px;
        background:
          radial-gradient(
            circle at 50% 0%,
            rgba(56, 189, 248, 0.2),
            transparent 55%
          ),
          #0f172a;
        color: #fff;
      }

      .cta h2 {
        margin: 0 0 10px;
        font-size: clamp(25px, 4vw, 38px);
      }

      .cta p {
        max-width: 650px;
        margin: 0 auto 22px;
        color: #94a3b8;
        line-height: 1.9;
        font-size: 13px;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 19px;
        border-radius: 12px;
        background: #38bdf8;
        color: #082f49;
        font-weight: 900;
        font-size: 13px;
      }

      /* =========================
         REVEAL
         ========================= */

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.6s ease,
          transform 0.6s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* =========================
         SCROLL TOP
         ========================= */

      #scrollTop {
        position: fixed;
        left: 18px;
        bottom: 18px;
        width: 42px;
        height: 42px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--surface);
        color: var(--primary);
        display: grid;
        place-items: center;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: 0.2s ease;
        z-index: 50;
      }

      #scrollTop.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      /* =========================
         TABLET
         ========================= */

      @media (max-width: 1050px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 35px;
        }

        .hero-content {
          text-align: center;
        }

        .hero-text {
          margin-inline: auto;
        }

        .hero-actions {
          justify-content: center;
        }

        .hero-visual {
          max-width: 760px;
          width: 100%;
          margin-inline: auto;
        }

        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .tracks,
        .missions {
          grid-template-columns: repeat(2, 1fr);
        }

        .editor-window {
          width: 80%;
          margin-bottom: 35px;
          transform: none;
        }
      }

      /* =========================
         MOBILE
         ========================= */

      @media (max-width: 760px) {
        .container {
          width: min(100% - 24px, var(--max-width));
        }

        .section {
          padding: 42px 0;
        }

        .section-heading {
          margin-bottom: 25px;
        }

        .section-heading h2 {
          font-size: 25px;
        }

        .section-heading p {
          font-size: 12px;
          line-height: 1.8;
        }

        /* HERO */

        .hero {
          min-height: auto;
          padding: 48px 0 38px;
        }

        .hero-grid {
          gap: 25px;
        }

        .hero-badge {
          font-size: 10px;
          padding: 7px 10px;
          margin-bottom: 13px;
        }

        .hero h1 {
          font-size: clamp(32px, 10vw, 48px);
          letter-spacing: -0.8px;
        }

        .hero-text {
          margin: 15px auto 20px;
          font-size: 13px;
          line-height: 1.9;
        }

        .hero-actions {
          gap: 8px;
        }

        .hero-button {
          min-height: 42px;
          padding: 0 14px;
          font-size: 11px;
        }

        .hero-card {
          padding: 12px;
          border-radius: 19px;
        }

        .terminal-code {
          min-height: 190px;
          padding: 15px;
          font-size: 9px;
          line-height: 1.9;
        }

        /* STATS */

        .stats {
          grid-template-columns: repeat(3, 1fr);
          gap: 8px;
        }

        .stat {
          padding: 16px 8px;
          border-radius: 15px;
        }

        .stat-number {
          font-size: 22px;
        }

        .stat-label {
          font-size: 9px;
        }

        /* SEARCH */

        .search-box {
          margin-bottom: 18px;
        }

        .search-box input {
          height: 50px;
          border-radius: 14px;
          font-size: 12px;
          padding-right: 43px;
        }

        /* TOOLS */

        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 9px;
        }

        .tool-card {
          min-width: 0;
          padding: 13px 10px;
          border-radius: 15px;
          gap: 9px;
        }

        .tool-icon {
          flex: 0 0 34px;
          width: 34px;
          height: 34px;
          border-radius: 10px;
          font-size: 12px;
        }

        .tool-info strong {
          font-size: 10px;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .tool-info span {
          font-size: 8px;
        }

        /* FEATURED */

        .featured-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .featured-image {
          height: 150px;
        }

        .featured-content {
          padding: 15px;
        }

        .featured-content h3 {
          font-size: 14px;
        }

        .featured-content p {
          font-size: 10px;
        }

        /* TRACKS */

        .tracks,
        .missions {
          grid-template-columns: repeat(2, 1fr);
          gap: 10px;
        }

        .track-card {
          padding: 18px 11px;
          border-radius: 16px;
        }

        .track-icon {
          width: 40px;
          height: 40px;
          border-radius: 12px;
          margin-bottom: 10px;
        }

        .track-card h3 {
          font-size: 12px;
        }

        .track-card p {
          font-size: 9px;
          line-height: 1.7;
        }

        .mission-card {
          padding: 16px;
          border-radius: 16px;
        }

        .mission-icon {
          font-size: 17px;
          margin-bottom: 9px;
        }

        .mission-card h3 {
          font-size: 11px;
        }

        .mission-card p {
          font-size: 9px;
        }

        .mission-card a {
          font-size: 9px;
        }

        /* =========================
           EDITOR MOBILE FIX
           ========================= */

        .editor-section {
          padding-top: 28px;
          padding-bottom: 28px;
        }

        .editor-card {
          display: block;
          min-height: 0;
          border-radius: 19px;
        }

        .editor-info {
          padding: 20px 16px 10px;
        }

        .editor-info .eyebrow {
          font-size: 9px;
        }

        .editor-info h2 {
          margin: 6px 0 6px;
          font-size: 21px;
          line-height: 1.35;
        }

        .editor-info p {
          font-size: 10px;
          line-height: 1.7;
        }

        .editor-button {
          min-height: 37px;
          margin-top: 12px;
          padding: 0 12px;
          border-radius: 9px;
          font-size: 9px;
        }

        .editor-window {
          width: calc(100% - 24px);
          min-height: 125px;
          margin: 0 auto 16px;
          border-radius: 13px;
          transform: none;
        }

        .window-header {
          height: 31px;
          padding: 0 10px;
        }

        .window-dot {
          width: 6px;
          height: 6px;
        }

        .code-lines {
          padding: 13px;
          gap: 7px;
        }

        .code-line {
          height: 5px;
        }

        /* LAB */

        .lab-grid {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .lab-card {
          padding: 18px;
          border-radius: 16px;
        }

        .lab-card i {
          font-size: 18px;
          margin-bottom: 9px;
        }

        .lab-card h3 {
          font-size: 13px;
        }

        .lab-card p {
          font-size: 10px;
          line-height: 1.8;
        }

        /* FAQ */

        .faq-question {
          padding: 15px;
          font-size: 11px;
        }

        .faq-answer-inner {
          padding: 0 15px 15px;
          font-size: 10px;
        }

        /* CTA */

        .cta {
          padding: 34px 18px;
          border-radius: 20px;
        }

        .cta h2 {
          font-size: 24px;
        }

        .cta p {
          font-size: 10px;
          line-height: 1.8;
        }

        .cta-button {
          min-height: 41px;
          padding: 0 15px;
          font-size: 10px;
        }
      }

      /* =========================
         SMALL PHONES
         ========================= */

      @media (max-width: 390px) {
        .container {
          width: calc(100% - 18px);
        }

        .hero {
          padding-top: 38px;
        }

        .hero h1 {
          font-size: 31px;
        }

        .hero-text {
          font-size: 12px;
        }

        .tools-grid {
          gap: 7px;
        }

        .tool-card {
          padding: 11px 8px;
        }

        .tool-icon {
          flex-basis: 31px;
          width: 31px;
          height: 31px;
        }

        .tool-info strong {
          font-size: 9px;
        }

        .tracks,
        .missions {
          gap: 7px;
        }

        .editor-info h2 {
          font-size: 19px;
        }

        .editor-window {
          min-height: 115px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- =========================
         HERO
         ========================= -->

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-content reveal">
              <div class="hero-badge">
                <i class="fa-solid fa-bolt"></i>
                منصة تقنية عربية
              </div>

              <h1>
                أدواتك التقنية
                <span>في مكان واحد</span>
              </h1>

              <p class="hero-text">
                Th.Tech تجمع لك مجموعة كبيرة من الأدوات التقنية المجانية
                للمطورين والمصممين والطلاب وكل شخص يعمل مع التكنولوجيا.
              </p>

              <div class="hero-actions">
                <a class="hero-button primary" href="#tools">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  استكشف الأدوات
                </a>

                <a class="hero-button secondary" href="#tracks">
                  <i class="fa-solid fa-compass"></i>
                  استكشف المسارات
                </a>
              </div>
            </div>

            <div class="hero-visual reveal">
              <div class="hero-card">
                <div class="hero-terminal">
                  <div class="terminal-top">
                    <span class="terminal-dot"></span>
                    <span class="terminal-dot"></span>
                    <span class="terminal-dot"></span>
                  </div>

                  <div class="terminal-code">
                    <div>
                      <span class="code-purple">const</span>
                      <span class="code-blue"> ThTech</span>
                      =
                      <span class="code-green">tools</span>;
                    </div>

                    <div>
                      <span class="code-purple">const</span>
                      <span class="code-blue"> result</span>
                      =
                      <span class="code-green">await</span>
                      ThTech.use();
                    </div>

                    <div class="code-gray">
                      // أدوات تقنية سريعة
                    </div>

                    <div>
                      <span class="code-blue">JSON</span>
                      |
                      <span class="code-blue">API</span>
                      |
                      <span class="code-blue">QR</span>
                      |
                      <span class="code-blue">CSS</span>
                    </div>

                    <div>
                      <span class="code-green">✓ Ready</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           TICKER
           ========================= -->

      <div class="ticker">
        <div class="ticker-track">
          {tickerItems.map((item) => (
            <span class="ticker-item">{item}</span>
          ))}

          {tickerItems.map((item) => (
            <span class="ticker-item">{item}</span>
          ))}
        </div>
      </div>

      <!-- =========================
           STATS
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="stats">
            <div class="stat reveal">
              <span class="stat-number" data-count={toolsCount}>0</span>
              <span class="stat-label">أداة تقنية</span>
            </div>

            <div class="stat reveal">
              <span class="stat-number">100%</span>
              <span class="stat-label">مجانية</span>
            </div>

            <div class="stat reveal">
              <span class="stat-number">24/7</span>
              <span class="stat-label">متاحة دائماً</span>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           TOOL FINDER
           ========================= -->

      <section class="section" id="tools">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">TOOL FINDER</div>

            <h2>ابحث عن الأداة التي تحتاجها</h2>

            <p>
              استخدم البحث للوصول بسرعة إلى الأداة المناسبة لمهمتك.
            </p>
          </div>

          <div class="search-box reveal">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input
              id="toolSearch"
              type="search"
              placeholder="ابحث عن أداة..."
              aria-label="البحث عن أداة"
            />
          </div>

          <div class="tools-grid" id="toolsGrid">
            {quickTools.map((tool) => (
              <a
                class="tool-card reveal"
                href={tool.href}
                data-tool-name={tool.name.toLowerCase()}
              >
                <div class="tool-icon">
                  <i class={tool.icon}></i>
                </div>

                <div class="tool-info">
                  <strong>{tool.name}</strong>
                  <span>أداة تقنية</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           FEATURED
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">FEATURED TOOLS</div>

            <h2>أدوات مميزة</h2>

            <p>
              مجموعة مختارة من الأدوات التي يمكنك استخدامها مباشرة.
            </p>
          </div>

          <div class="featured-grid">
            {featuredTools.map((tool) => (
              <a class="featured-card reveal" href={tool.href}>
                <div class="featured-image">
                  <img
                    src={tool.image}
                    alt={tool.name}
                    loading="lazy"
                  />

                  <div class="featured-overlay"></div>

                  <div class="featured-icon">
                    <i class={tool.icon}></i>
                  </div>
                </div>

                <div class="featured-content">
                  <h3>{tool.name}</h3>

                  <p>{tool.description}</p>

                  <span class="featured-link">
                    فتح الأداة
                    <i class="fa-solid fa-arrow-left"></i>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           TRACKS
           ========================= -->

      <section class="section" id="tracks">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">LEARNING TRACKS</div>

            <h2>استكشف حسب المجال</h2>

            <p>
              اختر المجال الأقرب إلى المهمة التي تريد إنجازها.
            </p>
          </div>

          <div class="tracks">
            {tracks.map((track) => (
              <a class="track-card reveal" href={track.href}>
                <div class="track-icon">
                  <i class={track.icon}></i>
                </div>

                <h3>{track.title}</h3>

                <p>{track.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           MISSIONS
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">QUICK MISSIONS</div>

            <h2>ماذا تريد أن تنجز اليوم؟</h2>

            <p>
              ابدأ مباشرة من المهمة التي تريد تنفيذها.
            </p>
          </div>

          <div class="missions">
            {missions.map((mission) => (
              <div class="mission-card reveal">
                <div class="mission-icon">
                  <i class={mission.icon}></i>
                </div>

                <h3>{mission.title}</h3>

                <p>{mission.description}</p>

                <a href={mission.href}>
                  ابدأ الآن
                  <i class="fa-solid fa-arrow-left"></i>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           CODE EDITOR
           ========================= -->

      <section class="section editor-section">
        <div class="container">
          <div class="editor-card reveal">
            <div class="editor-info">
              <div class="eyebrow">TH.TECH CODE LAB</div>

              <h2>محرر الأكواد</h2>

              <p>
                اكتب وجرب أكوادك مباشرة من المتصفح باستخدام محرر بسيط وسريع.
              </p>

              <a class="editor-button" href={codeEditorHref}>
                <i class="fa-solid fa-code"></i>
                افتح محرر الأكواد
              </a>
            </div>

            <div class="editor-window">
              <div class="window-header">
                <span class="window-dot"></span>
                <span class="window-dot"></span>
                <span class="window-dot"></span>
              </div>

              <div class="code-lines">
                <div class="code-line short blue"></div>
                <div class="code-line long"></div>
                <div class="code-line medium green"></div>
                <div class="code-line long"></div>
                <div class="code-line short"></div>
                <div class="code-line medium blue"></div>
                <div class="code-line long"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           LABS
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">TH.TECH LABS</div>

            <h2>مختبر Th.Tech</h2>

            <p>
              مساحات تجمع الأدوات حسب نوع الاستخدام والهدف.
            </p>
          </div>

          <div class="lab-grid">
            {labs.map((lab) => (
              <a class="lab-card reveal" href={lab.href}>
                <i class={lab.icon}></i>

                <h3>{lab.title}</h3>

                <p>{lab.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           FAQ
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="section-heading reveal">
            <div class="eyebrow">FAQ</div>

            <h2>الأسئلة الشائعة</h2>

            <p>
              إجابات سريعة عن المنصة والأدوات.
            </p>
          </div>

          <div class="faq">
            {faqs.map((faq) => (
              <div class="faq-item reveal">
                <button class="faq-question" type="button">
                  <span>{faq.question}</span>

                  <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="faq-answer">
                  <div class="faq-answer-inner">
                    {faq.answer}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- =========================
           CTA
           ========================= -->

      <section class="section">
        <div class="container">
          <div class="cta reveal">
            <h2>جاهز لاستكشاف Th.Tech؟</h2>

            <p>
              اكتشف الأدوات التي تحتاجها وأنجز مهامك التقنية بشكل أسرع.
            </p>

            <a class="cta-button" href="#tools">
              <i class="fa-solid fa-arrow-down"></i>
              استكشف الأدوات
            </a>
          </div>
        </div>
      </section>
    </main>

    <button id="scrollTop" aria-label="العودة إلى الأعلى">
      <i class="fa-solid fa-arrow-up"></i>
    </button>

    <Footer />

    <script>
      const searchInput = document.getElementById('toolSearch');
      const toolCards = Array.from(
        document.querySelectorAll('#toolsGrid .tool-card')
      );

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const query = searchInput.value.trim().toLowerCase();

          toolCards.forEach((card) => {
            const name =
              card.getAttribute('data-tool-name')?.toLowerCase() || '';

            card.style.display =
              !query || name.includes(query) ? '' : 'none';
          });
        });
      }

      /* FAQ */

      document.querySelectorAll('.faq-question').forEach((button) => {
        button.addEventListener('click', () => {
          const item = button.closest('.faq-item');
          const answer = item?.querySelector('.faq-answer');

          if (!item || !answer) return;

          const isActive = item.classList.contains('active');

          document.querySelectorAll('.faq-item').forEach((faqItem) => {
            faqItem.classList.remove('active');

            const faqAnswer =
              faqItem.querySelector('.faq-answer');

            if (faqAnswer) {
              faqAnswer.style.maxHeight = null;
            }
          });

          if (!isActive) {
            item.classList.add('active');
            answer.style.maxHeight = `${answer.scrollHeight}px`;
          }
        });
      });

      /* Reveal */

      const revealItems = document.querySelectorAll('.reveal');

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.08
        }
      );

      revealItems.forEach((item) => {
        revealObserver.observe(item);
      });

      /* Counter */

      const counters = document.querySelectorAll('[data-count]');

      const counterObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const element = entry.target;
            const target = Number(element.dataset.count || 0);

            let current = 0;
            const duration = 900;
            const startTime = performance.now();

            const updateCounter = (time) => {
              const progress = Math.min(
                (time - startTime) / duration,
                1
              );

              current = Math.floor(target * progress);
              element.textContent = current;

              if (progress < 1) {
                requestAnimationFrame(updateCounter);
              } else {
                element.textContent = target;
              }
            };

            requestAnimationFrame(updateCounter);
            observer.unobserve(element);
          });
        },
        {
          threshold: 0.5
        }
      );

      counters.forEach((counter) => {
        counterObserver.observe(counter);
      });

      /* Scroll Top */

      const scrollTopButton =
        document.getElementById('scrollTop');

      window.addEventListener(
        'scroll',
        () => {
          if (!scrollTopButton) return;

          if (window.scrollY > 500) {
            scrollTopButton.classList.add('visible');
          } else {
            scrollTopButton.classList.remove('visible');
          }
        },
        { passive: true }
      );

      scrollTopButton?.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });

      /* Keyboard shortcut */

      document.addEventListener('keydown', (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key.toLowerCase() === 'k'
        ) {
          event.preventDefault();

          searchInput?.focus();

          document
            .getElementById('tools')
            ?.scrollIntoView({
              behavior: 'smooth'
            });
        }
      });
    </script>
  </body>
</html>
