---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | المستقبل الرقمي يبدأ هنا</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، البرمجة، والأمن السيبراني. محتوى تقني معمق وشروحات عملية." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Segoe+UI&display=swap" rel="stylesheet">

  <!-- Pyodide for Python execution -->
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section -->
    <section class="hero reveal">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI Technology" loading="eager" />
        <div class="overlay"></div>
      </div>
      
      <div class="container hero-content">
        <span class="hero-badge reveal-delay-1">🚀 نحو المستقبل</span>
        
        <h1 class="reveal-delay-2">
          <span class="typing-text">ابنِ غدك الرقمي معنا</span>
        </h1>
        
        <p class="hero-desc reveal-delay-3">
          شروحات عملية في الذكاء الاصطناعي، البرمجة، والأمن السيبراني — لمطورين يطمحون للتميز
        </p>
        
        <div class="hero-buttons reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary">استكشف الأدلة</a>
          <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
        </div>
      </div>
    </section>

    <!-- 🔹 إحصائيات -->
    <section class="stats reveal">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <span class="counter" data-target="150" data-suffix="+">0</span>
            <span class="counter-label">دليل شامل</span>
          </div>
          <div class="stat-item">
            <span class="counter" data-target="50" data-suffix="K+">0</span>
            <span class="counter-label">قارئ شهرياً</span>
          </div>
          <div class="stat-item">
            <span class="counter" data-target="100" data-suffix="%">0</span>
            <span class="counter-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 المجالات -->
    <section class="topics reveal">
      <div class="container">
        <h2 class="section-title">اختر مسارك</h2>
        
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card reveal-delay-1">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة، الشبكات العصبية، وتطبيقات الـ AI</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/programming/" class="topic-card reveal-delay-2">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>البرمجة</h3>
              <p>لغات البرمجة، الأطر الحديثة، وهندسة البرمجيات</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/security/" class="topic-card reveal-delay-3">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات، الاختراق الأخلاقي، والدفاع الرقمي</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card reveal-delay-4">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، وGoogle Cloud</p>
              <span class="arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 أحدث المقالات -->
    <section class="articles reveal">
      <div class="container">
        <h2 class="section-title">أحدث المقالات</h2>
        
        <div class="articles-grid">
          <article class="article-card reveal-delay-1">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
              <span class="article-badge">جديد</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag ai">AI</span>
                <span class="read-time">5 دقائق</span>
              </div>
              <h3>دليلك الشامل لتعلم الآلة</h3>
              <p>رحلة عملية من الصفر للاحتراف</p>
            </div>
          </article>

          <article class="article-card reveal-delay-2">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
              <span class="article-badge popular">شائع</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag security">Security</span>
                <span class="read-time">8 دقائق</span>
              </div>
              <h3>أمن السحابة: أفضل الممارسات</h3>
              <p>استراتيجيات حماية متقدمة</p>
            </div>
          </article>

          <article class="article-card reveal-delay-3">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Code" loading="lazy" />
              <span class="article-badge updated">محدّث</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag code">Code</span>
                <span class="read-time">6 دقائق</span>
              </div>
              <h3>مبادئ SOLID للمحترفين</h3>
              <p>الأنماط التصميمية الاحترافية</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 لماذا Th.Tech -->
    <section class="why-us reveal">
      <div class="container">
        <h2 class="section-title">لماذا Th.Tech؟</h2>
        
        <div class="features-grid">
          <div class="feature reveal-delay-1">
            <div class="feature-icon"></div>
            <h3>محتوى عملي</h3>
            <p>شروحات تطبيقية مع أمثلة واقعية</p>
          </div>
          
          <div class="feature reveal-delay-2">
            <div class="feature-icon"></div>
            <h3>تحديث مستمر</h3>
            <p>محتوى يُحدَّث أسبوعياً بأحدث التقنيات</p>
          </div>
          
          <div class="feature reveal-delay-3">
            <div class="feature-icon"></div>
            <h3>شامل ومعمق</h3>
            <p>من الأساسيات إلى الاحتراف</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 محرر الكود المدمج (مع Pyodide) -->
    <section class="code-editor-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">جرّب الكود الآن</h2>
          <p class="section-subtitle">محرر تفاعلي مع دعم Python الحقيقي عبر Pyodide</p>
        </div>
        
        <div class="code-editor-container">
          <div class="editor-header">
            <div class="language-tabs">
              <button class="tab active" data-lang="javascript" onclick="switchLanguage('javascript')">JavaScript</button>
              <button class="tab" data-lang="python" onclick="switchLanguage('python')">
                Python 
                <span id="py-status" class="py-status">● جاري التحميل</span>
              </button>
              <button class="tab" data-lang="html" onclick="switchLanguage('html')">HTML/CSS</button>
            </div>
            <button class="run-btn" id="runBtn" onclick="runCode()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span id="runBtnText">تشغيل الكود</span>
            </button>
          </div>
          
          <div class="editor-body">
            <div class="code-input-wrapper">
              <textarea 
                id="codeEditor" 
                class="code-editor"
                placeholder="اكتب الكود هنا..."
                spellcheck="false"
              ></textarea>
            </div>
            
            <div class="output-wrapper">
              <div class="output-header">
                <span>النتيجة</span>
                <button class="clear-btn" onclick="clearOutput()">مسح</button>
              </div>
              <div id="output" class="code-output">
                <span class="output-placeholder">اكتب كوداً ثم اضغط "تشغيل" لرؤية النتيجة...</span>
              </div>
            </div>
          </div>
          
          <div class="editor-footer">
            <span class="hint">💡 Ctrl+Enter للتشغيل السريع • Python يعمل عبر Pyodide (WebAssembly)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 النشرة البريدية -->
    <section class="newsletter reveal">
      <div class="container">
        <div class="newsletter-box">
          <div class="newsletter-icon"></div>
          <h2>اشترك في نشرتنا</h2>
          <p>احصل على أحدث المقالات مباشرة في بريدك</p>
          <form class="newsletter-form">
            <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
            <button type="submit" class="btn btn-primary">اشترك الآن</button>
          </form>
          <p class="newsletter-note"> نحمي خصوصيتك. لا رسائل مزعجة.</p>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA -->
    <section class="cta reveal">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك اليوم</h2>
          <p>انضم إلى مجتمع المطورين والمبتكرين</p>
          <a href="/Th-tech/guides/" class="btn btn-light">تصفح الأدلة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --border: rgba(2,132,199,0.15);
    --radius: 16px;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --primary-dark: #0284c7;
    --border: rgba(56,189,248,0.15);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  html { 
    scroll-behavior: smooth; 
    scroll-padding-top: 80px;
  }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container { 
    max-width: 1100px; 
    margin: 0 auto; 
    padding: 0 1.5rem; 
  }

  /* Hero Section */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4);
  }
  
  .hero-content {
    position: relative;
    z-index: 1;
    padding: 2rem;
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.3);
  }
  
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    margin-bottom: 1rem;
    font-weight: 800;
  }
  
  .typing-text {
    display: inline-block;
    border-right: 3px solid white;
    white-space: nowrap;
    overflow: hidden;
    animation: typing 3s steps(25, end), blink 0.75s step-end infinite;
  }
  
  @keyframes typing {
    from { width: 0; }
    to { width: 100%; }
  }
  
  @keyframes blink {
    50% { border-color: transparent; }
  }
  
  @media (max-width: 768px) {
    .typing-text {
      animation: none;
      border: none;
      white-space: normal;
    }
  }
  
  .hero-desc {
    font-size: 1.2rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  
  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s;
  }
  
  .btn-primary {
    background: var(--primary);
    color: white;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    background: var(--primary-dark);
  }
  
  .btn-outline {
    background: transparent;
    border: 2px solid white;
    color: white;
  }
  
  .btn-outline:hover {
    background: white;
    color: var(--text);
  }
  
  .btn-light {
    background: white;
    color: var(--primary);
  }
  
  .btn-light:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  /* Stats */
  .stats {
    padding: 3rem 0;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }
  
  .counter {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    display: block;
  }
  
  .counter-label {
    color: var(--text-sec);
    font-size: 0.95rem;
  }
  
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* Topics */
  .topics {
    padding: 4rem 0;
    background: var(--bg);
  }
  
  .section-title {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 3rem;
    color: var(--text);
  }
  
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .topic-card {
    background: var(--card);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
    border: 1px solid var(--border);
  }
  
  .topic-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  
  .topic-img {
    height: 200px;
    overflow: hidden;
  }
  
  .topic-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  
  .topic-card:hover .topic-img img {
    transform: scale(1.1);
  }
  
  .topic-content {
    padding: 1.5rem;
  }
  
  .topic-content h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  
  .topic-content p {
    color: var(--text-sec);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  
  .arrow {
    color: var(--primary);
    font-size: 1.5rem;
    transition: transform 0.3s;
  }
  
  .topic-card:hover .arrow {
    transform: translateX(5px);
  }
  
  @media (max-width: 768px) {
    .topics-grid { grid-template-columns: 1fr; }
  }

  /* Articles */
  .articles {
    padding: 4rem 0;
    background: var(--card);
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  .article-card {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s;
    text-decoration: none;
    color: var(--text);
  }
  
  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }
  
  .article-image {
    position: relative;
    height: 180px;
    overflow: hidden;
  }
  
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  
  .article-card:hover .article-image img {
    transform: scale(1.05);
  }
  
  .article-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    background: #10b981;
    color: white;
  }
  
  .article-badge.popular { background: #f59e0b; }
  .article-badge.updated { background: #3b82f6; }
  
  .article-content {
    padding: 1.5rem;
  }
  
  .article-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    font-size: 0.85rem;
  }
  
  .tag {
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  
  .tag.ai { background: rgba(59,130,246,0.1); color: #3b82f6; }
  .tag.security { background: rgba(239,68,68,0.1); color: #ef4444; }
  .tag.code { background: rgba(16,185,129,0.1); color: #10b981; }
  
  .read-time { color: var(--text-sec); }
  
  .article-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
    line-height: 1.4;
  }
  
  .article-content p {
    color: var(--text-sec);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  
  @media (max-width: 1024px) {
    .articles-grid { grid-template-columns: repeat(2, 1fr); }
  }
  
  @media (max-width: 768px) {
    .articles-grid { grid-template-columns: 1fr; }
  }

  /* Why Us */
  .why-us {
    padding: 4rem 0;
    background: var(--bg);
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  
  .feature {
    text-align: center;
    padding: 2rem;
    background: var(--card);
    border-radius: var(--radius);
    transition: transform 0.3s;
    border: 1px solid var(--border);
  }
  
  .feature:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }
  
  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .feature h3 {
    margin-bottom: 0.5rem;
  }
  
  .feature p {
    color: var(--text-sec);
  }
  
  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
  }

  /* Code Editor */
  .code-editor-section {
    padding: 5rem 0;
    background: var(--card);
  }
  
  .code-editor-container {
    background: var(--bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }
  
  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .language-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tab {
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-sec);
    font-weight: 600;
    cursor: pointer;
