---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = `https://oumaystore-hub.github.io${base}`;

/* ==========================================
   اكتشاف الأدوات تلقائياً
   ========================================== */

const toolModules = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(toolModules)
  .map((file) => {
    const match = file.match(/\.\/tools\/([^/]+)\/index\.astro$/);
    return match ? match[1] : null;
  })
  .filter(Boolean) as string[];

const displayName = (slug: string) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

/* ==========================================
   الأدوات المفضلة
   ========================================== */

const preferredTools = [
  'api-request-builder',
  'json-formatter',
  'json-validator',
  'sql-formatter',
  'base64-encoder',
  'base64-decoder',
  'qr-code-generator',
  'barcode-generator',
  'color-picker',
  'regex-tester',
  'uuid-generator'
];

const sortedTools = [...toolSlugs].sort((a, b) => {
  const ai = preferredTools.indexOf(a);
  const bi = preferredTools.indexOf(b);

  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;

  return a.localeCompare(b);
});

const featuredTools = sortedTools.slice(0, 12);
const toolsCount = toolSlugs.length;

const toolSearchData = sortedTools.map((slug) => ({
  slug,
  name: displayName(slug)
}));

/* ==========================================
   المسارات
   ========================================== */

const tracks = [
  {
    title: 'الذكاء الاصطناعي',
    slug: 'ai',
    icon: 'fa-brain',
    image:
      'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1200&q=80',
    description:
      'استكشف الذكاء الاصطناعي والتقنيات التي تقود مستقبل التقنية.',
    tags: ['AI', 'Machine Learning', 'Automation']
  },
  {
    title: 'البرمجة',
    slug: 'programming',
    icon: 'fa-code',
    image:
      'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعلم البرمجة وتطوير التطبيقات وفهم الأدوات الأساسية للمطورين.',
    tags: ['JavaScript', 'Python', 'Web']
  },
  {
    title: 'الأمن السيبراني',
    slug: 'security',
    icon: 'fa-shield-halved',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعرف على الأمن السيبراني والشبكات والتشفير وحماية الأنظمة.',
    tags: ['Security', 'Networks', 'Cryptography']
  },
  {
    title: 'الحوسبة السحابية',
    slug: 'cloud',
    icon: 'fa-cloud',
    image:
      'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80',
    description:
      'اكتشف الحوسبة السحابية والبنية التحتية والخدمات الحديثة.',
    tags: ['AWS', 'Cloud', 'DevOps']
  }
];

/* ==========================================
   الأسئلة
   ========================================== */

const faqs = [
  {
    question: 'هل أحتاج إلى خبرة سابقة؟',
    answer:
      'لا. يمكنك البدء من المستوى الذي يناسبك واستكشاف الأدوات والمحتوى تدريجياً حسب احتياجاتك.'
  },
  {
    question: 'هل الأدوات تعمل مباشرة من المتصفح؟',
    answer:
      'نعم، العديد من أدوات Th.Tech مصممة للعمل مباشرة من المتصفح مع التركيز على السرعة وسهولة الاستخدام.'
  },
  {
    question: 'ما أنواع الأدوات الموجودة؟',
    answer:
      'ستجد أدوات للمطورين والبيانات والنصوص وJSON وSQL والترميز والتشفير والألوان والروابط وغيرها.'
  },
  {
    question: 'هل الموقع مناسب للهاتف؟',
    answer:
      'نعم، الواجهة متجاوبة مع الحاسوب والهاتف والأجهزة اللوحية.'
  }
];

/* ==========================================
   SEO / JSON-LD
   ========================================== */

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Th.Tech',
      description:
        'Th.Tech منصة تقنية تجمع الأدوات التفاعلية والمحتوى التعليمي والمراجع التقنية.',
      inLanguage: 'ar'
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Th.Tech',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/logo1.png`,
      email: 'thtech.tech@gmail.com',
      sameAs: [
        'https://www.facebook.com/share/1PzewvX774/',
        'https://www.instagram.com/thtech.ma',
        'https://x.com/thtechma',
        'https://www.youtube.com/@thtechma',
        'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438'
      ]
    }
  ]
};
---

<html lang="ar" dir="rtl" data-base={base}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | منصة تقنية للأدوات والبرمجة والتقنية</title>

  <meta
    name="description"
    content="Th.Tech منصة تقنية تجمع الأدوات التفاعلية والمحتوى التقني والبرمجة والذكاء الاصطناعي والأمن السيبراني والحوسبة السحابية."
  />

  <meta
    name="keywords"
    content="Th.Tech, أدوات تقنية, أدوات للمطورين, برمجة, ذكاء اصطناعي, أمن سيبراني, SQL, JSON, JavaScript, Python"
  />

  <meta name="author" content="Th.Tech" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={`${siteUrl}/`} />
  <link rel="icon" type="image/png" href={`${siteUrl}/logo1.png`} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="Th.Tech" />
  <meta property="og:title" content="Th.Tech | المنصة التقنية" />
  <meta
    property="og:description"
    content="أدوات تقنية تفاعلية ومحتوى تقني للمطورين والمهتمين بالتكنولوجيا."
  />
  <meta property="og:url" content={`${siteUrl}/`} />
  <meta property="og:image" content={`${siteUrl}/logo1.png`} />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Th.Tech | المنصة التقنية" />
  <meta
    name="twitter:description"
    content="منصة تقنية تجمع الأدوات والمحتوى التقني في تجربة حديثة."
  />
  <meta name="twitter:image" content={`${siteUrl}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <script
    type="application/json"
    id="th-tech-tool-data"
    set:html={JSON.stringify(toolSearchData)}
  ></script>

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (
          saved === 'dark' ||
          (!saved &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>
