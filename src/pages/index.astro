        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(14, 165, 233, 0.1);
        color: #0284c7;
      }

      .track-card h3 {
        margin: 20px 0 7px;
        font-size: 18px;
      }

      .track-card p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 2;
      }

      .track-card a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 18px;
        color: #0284c7;
        font-size: 11px;
        font-weight: 800;
      }

      /* =========================
         WHY
      ========================== */

      .why-section {
        background: rgba(241, 245, 249, 0.55);
      }

      :global(html.dark-mode) .why-section {
        background: rgba(15, 23, 42, 0.35);
      }

      .why-layout {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 70px;
        align-items: center;
      }

      .why-content h2 {
        margin: 10px 0;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.2;
      }

      .why-content > p {
        max-width: 500px;
        color: #64748b;
        font-size: 13px;
        line-height: 2;
        margin-bottom: 24px;
      }

      .why-features {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
      }

      .why-feature {
        display: flex;
        gap: 13px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        background: white;
      }

      :global(html.dark-mode) .why-feature {
        border-color: #1e293b;
        background: #0f172a;
      }

      .why-feature > div {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: rgba(14, 165, 233, 0.1);
        color: #0284c7;
      }

      .why-feature h3 {
        margin: 0 0 4px;
        font-size: 13px;
      }

      .why-feature p {
        margin: 0;
        color: #64748b;
        font-size: 10px;
        line-height: 1.8;
      }

      /* =========================
         FAQ
      ========================== */

      .faq-list {
        max-width: 850px;
        margin: auto;
      }

      .faq-item {
        margin-bottom: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: white;
        overflow: hidden;
      }

      :global(html.dark-mode) .faq-item {
        border-color: #1e293b;
        background: #0f172a;
      }

      .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 21px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
        list-style: none;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary span {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: rgba(14, 165, 233, 0.1);
        color: #0284c7;
        transition: 0.25s ease;
      }

      .faq-item[open] summary span {
        transform: rotate(45deg);
      }

      .faq-item p {
        margin: 0;
        padding: 0 21px 20px;
        color: #64748b;
        font-size: 12px;
        line-height: 2;
      }

      .faq-item p a {
        color: #0284c7;
        font-weight: 800;
      }

      /* =========================
         CTA
      ========================== */

      .cta-section {
        padding: 30px 0 100px;
      }

      .cta-card {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 75px 30px;
        border-radius: 30px;
        color: white;
        background:
          radial-gradient(circle at 20% 30%, rgba(56, 189, 248, 0.15), transparent 30%),
          radial-gradient(circle at 80% 70%, rgba(99, 102, 241, 0.18), transparent 35%),
          #020617;
      }

      .cta-content {
        position: relative;
        z-index: 2;
      }

      .cta-content h2 {
        margin: 12px 0 8px;
        font-size: clamp(32px, 5vw, 55px);
        line-height: 1.2;
      }

      .cta-content p {
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
      }

      .cta-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .ghost-button {
        color: white;
        border: 1px solid #334155;
        background: rgba(15, 23, 42, 0.6);
      }

      /* =========================
         REVEAL
      ========================== */

      .reveal {
        opacity: 0;
        transform: translateY(25px);
        transition:
          opacity 0.7s ease var(--delay, 0ms),
          transform 0.7s ease var(--delay, 0ms);
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* =========================
         TABLET
      ========================== */

      @media (max-width: 1000px) {
        .container {
          width: min(100% - 30px, 900px);
        }

        .stats-grid,
        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .category-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .playground-card {
          grid-template-columns: 1fr;
        }

        .playground-content {
          text-align: center;
        }

        .playground-content p {
          margin-inline: auto;
        }

        .playground-features,
        .playground-button {
          justify-content: center;
        }

        .why-layout {
          grid-template-columns: 1fr;
          gap: 40px;
        }
      }

      /* =========================
         MOBILE
      ========================== */

      @media (max-width: 700px) {
        .container {
          width: calc(100% - 24px);
        }

        .hero {
          min-height: auto;
          padding: 75px 0 55px;
        }

        .hero-title {
          font-size: clamp(38px, 12vw, 55px);
          letter-spacing: -1.2px;
        }

        .hero-description {
          font-size: 13px;
          line-height: 1.9;
          margin-top: 18px;
        }

        .hero-actions {
          margin-top: 24px;
        }

        .primary-button,
        .secondary-button,
        .ghost-button,
        .playground-button {
          min-height: 43px;
          padding-inline: 16px;
          font-size: 12px;
        }

        .hero-trust {
          gap: 10px 15px;
          font-size: 10px;
        }

        .floating-code {
          display: none;
        }

        .stats-section {
          margin-top: 0;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 8px;
        }

        .stat-card {
          padding: 13px;
          gap: 9px;
        }

        .stat-icon {
          width: 36px;
          height: 36px;
          flex-basis: 36px;
          font-size: 12px;
        }

        .stat-card strong {
          font-size: 16px;
        }

        .stat-card span {
          font-size: 9px;
        }

        .search-section {
          padding-top: 42px;
        }

        .search-box {
          padding: 20px 13px;
          border-radius: 19px;
        }

        .search-heading h2 {
          font-size: 21px;
        }

        .search-heading p {
          font-size: 10px;
        }

        .search-input-wrap input {
          height: 49px;
          padding-right: 42px;
          padding-left: 13px;
          font-size: 11px;
        }

        .search-input-wrap kbd {
          display: none;
        }

        .section {
          padding: 58px 0;
        }

        .section-header {
          display: block;
          margin-bottom: 23px;
        }

        .section-header h2 {
          font-size: 23px;
        }

        .section-header p {
          font-size: 10px;
          line-height: 1.8;
        }

        .text-link {
          margin-top: 12px;
        }

        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 9px;
        }

        .tool-card {
          min-height: 215px;
          padding: 14px;
          border-radius: 15px;
        }

        .tool-icon {
          width: 37px;
          height: 37px;
          font-size: 13px;
        }

        .tool-card h3 {
          margin-top: 15px;
          font-size: 12px;
        }

        .tool-card p {
          font-size: 9px;
          line-height: 1.7;
        }

        .tool-card-footer {
          margin-top: 12px;
          padding-top: 10px;
          font-size: 9px;
        }

        .category-grid {
          grid-template-columns: 1fr;
          gap: 9px;
        }

        .category-card {
          padding: 16px;
        }

        .playground-card {
          padding: 24px 16px;
          border-radius: 21px;
          gap: 22px;
        }

        .playground-content h2 {
          font-size: 30px;
        }

        .playground-content p {
          font-size: 11px;
          line-height: 1.9;
        }

        .playground-features {
          gap: 8px;
        }

        .editor-window {
          transform: none;
        }

        .editor-body {
          min-height: 180px;
        }

        .editor-body pre {
          padding: 13px;
          font-size: 8px;
        }

        .line-numbers {
          padding: 13px 8px;
          font-size: 8px;
        }

        .tracks-grid {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .track-card {
          padding: 22px;
        }

        .why-features {
          grid-template-columns: 1fr;
          gap: 9px;
        }

        .why-content h2 {
          font-size: 31px;
        }

        .why-content > p {
          font-size: 11px;
        }

        .why-feature {
          padding: 15px;
        }

        .faq-item summary {
          padding: 16px;
          font-size: 11px;
        }

        .faq-item p {
          padding: 0 16px 17px;
          font-size: 10px;
        }

        .cta-section {
          padding-bottom: 65px;
        }

        .cta-card {
          padding: 50px 17px;
          border-radius: 22px;
        }

        .cta-content h2 {
          font-size: 32px;
        }

        .cta-content p {
          font-size: 10px;
        }
      }

      @media (max-width: 420px) {
        .tools-grid {
          grid-template-columns: 1fr;
        }

        .tool-card {
          min-height: 185px;
        }

        .hero-title {
          font-size: 39px;
        }

        .hero-actions {
          flex-direction: column;
        }

        .hero-actions a {
          width: 100%;
        }

        .hero-trust {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          justify-items: center;
        }
      }

      /* =========================
         REDUCED MOTION
      ========================== */

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>

    <!-- =========================
         INTERACTIONS
    ========================== -->

    <script>
      const toolData = [
        ...document.querySelectorAll('.tool-card')
      ].map((card) => ({
        name: card.querySelector('h3')?.textContent?.trim() || '',
        href: card.getAttribute('href') || '',
        icon:
          card.querySelector('.tool-icon i')?.className ||
          'fa-solid fa-wand-magic-sparkles'
      }));

      const searchInput =
        document.querySelector('#toolSearch');

      const searchResults =
        document.querySelector('#searchResults');

      const renderSearchResults = (query) => {
        if (!searchResults) return;

        const value = query.trim().toLowerCase();

        if (!value) {
          searchResults.innerHTML = '';
          return;
        }

        const matches = toolData
          .filter((tool) =>
            tool.name.toLowerCase().includes(value)
          )
          .slice(0, 6);

        if (!matches.length) {
          searchResults.innerHTML = `
            <div class="search-result">
              <div class="search-result-icon">
                <i class="fa-solid fa-face-frown"></i>
              </div>
              <div>
                <strong>لم نجد أداة مطابقة</strong>
                <small>جرّب كلمة أخرى</small>
              </div>
            </div>
          `;

          return;
        }

        searchResults.innerHTML = matches
          .map(
            (tool) => `
              <a href="${tool.href}" class="search-result">
                <div class="search-result-icon">
                  <i class="${tool.icon}"></i>
                </div>

                <div>
                  <strong>${tool.name}</strong>
                  <small>فتح الأداة</small>
                </div>
              </a>
            `
          )
          .join('');
      };

      searchInput?.addEventListener('input', (event) => {
        renderSearchResults(event.target.value);
      });

      document.addEventListener('keydown', (event) => {
        if (
          (event.ctrlKey || event.metaKey) &&
          event.key.toLowerCase() === 'k'
        ) {
          event.preventDefault();
          searchInput?.focus();
        }

        if (event.key === 'Escape') {
          if (document.activeElement === searchInput) {
            searchInput.value = '';
            renderSearchResults('');
            searchInput.blur();
          }
        }
      });

      /* Reveal on scroll */

      const revealItems =
        document.querySelectorAll('.reveal');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: '0px 0px -35px 0px'
          }
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) =>
          item.classList.add('visible')
        );
      }

      /* Counter */

      const counter = document.querySelector(
        '[data-counter]'
      );

      if (counter) {
        const target = Number(
          counter.getAttribute('data-counter')
        );

        let started = false;

        const runCounter = () => {
          if (started) return;

          started = true;

          const duration = 900;
          const start = performance.now();

          const animate = (now) => {
            const progress = Math.min(
              (now - start) / duration,
              1
            );

            const eased =
              1 - Math.pow(1 - progress, 3);

            counter.textContent = Math.floor(
              eased * target
            );

            if (progress < 1) {
              requestAnimationFrame(animate);
            } else {
              counter.textContent = target;
            }
          };

          requestAnimationFrame(animate);
        };

        if ('IntersectionObserver' in window) {
          const counterObserver =
            new IntersectionObserver(
              (entries, obs) => {
                if (entries[0].isIntersecting) {
                  runCounter();
                  obs.disconnect();
                }
              },
              { threshold: 0.5 }
            );

          counterObserver.observe(counter);
        } else {
          runCounter();
        }
      }
    </script>
  </body>
</html>
