---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | المنصة التقنية المتقدمة</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <!-- Font Awesome للأيقونات الاحترافية -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&h=1080&fit=crop" alt="Tech" loading="eager" />
        <div class="overlay"></div>
      </div>
      
      <div class="container hero-container">
        <div class="hero-content">
          <span class="badge"><i class="fas fa-rocket"></i> اكتشف، تعلّم، وابتكر</span>
          <h1>
            ابنِ <span id="typewriter" class="gradient-text"></span><span class="cursor">|</span>
          </h1>
          <p class="hero-desc">منصة رائدة توفر شروحات تقنية معمقة، أدلة مرجعية شاملة، ومختبر أكواد تفاعلي.</p>
          
          <div class="hero-actions">
            <a href="/Th-tech/playground/" class="btn btn-primary">
              <i class="fas fa-code"></i> ابدأ البرمجة الآن
            </a>
            <a href="/Th-tech/guides/" class="btn btn-secondary">
              <i class="fas fa-book"></i> تصفح المكتبة
            </a>
          </div>
          
          <!-- ميزات جديدة -->
          <div class="hero-features">
            <div class="hero-feature">
              <i class="fas fa-bolt"></i>
              <span>تنفيذ فوري</span>
            </div>
            <div class="hero-feature">
              <i class="fas fa-shield-alt"></i>
              <span>آمن 100%</span>
            </div>
            <div class="hero-feature">
              <i class="fas fa-gift"></i>
              <span>مجاني تماماً</span>
            </div>
          </div>
        </div>

        <!-- Floating Cards -->
        <div class="hero-visual">
          <div class="float-card glass">
            <i class="fab fa-python" style="color: #3776ab; font-size: 2.5rem;"></i>
            <div class="code-snippet">
              <div class="code-line"><span class="tag">print</span>(<span class="str">"مرحباً"</span>)</div>
              <div class="code-line"><span class="comment"># Python 3.11</span></div>
            </div>
          </div>
          <div class="float-card glass delay-1">
            <i class="fab fa-js" style="color: #f7df1e; font-size: 2rem;"></i>
            <span>JavaScript ES6+</span>
          </div>
          <div class="float-card glass delay-2">
            <i class="fas fa-terminal" style="color: #10b981;"></i>
            <span>Terminal Ready</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Ticker -->
    <div class="tech-ticker">
      <div class="ticker-track">
        <span class="tech-item"><i class="fab fa-js"></i> JavaScript</span>
        <span class="tech-item"><i class="fab fa-python"></i> Python</span>
        <span class="tech-item"><i class="fab fa-react"></i> React</span>
        <span class="tech-item"><i class="fab fa-aws"></i> AWS</span>
        <span class="tech-item"><i class="fas fa-shield-alt"></i> CyberSec</span>
        <span class="tech-item"><i class="fab fa-docker"></i> Docker</span>
        <span class="tech-item"><i class="fab fa-node"></i> Node.js</span>
        <span class="tech-item"><i class="fas fa-database"></i> SQL</span>
      </div>
    </div>

    <!-- Stats -->
    <section class="stats-bar">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <i class="fas fa-book-open stat-icon"></i>
            <span class="stat-value" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <i class="fas fa-users stat-icon"></i>
            <span class="stat-value" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <i class="fas fa-percentage stat-icon"></i>
            <span class="stat-value" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tracks with Real Icons -->
    <section class="tracks">
      <div class="container">
        <div class="section-header">
          <h2><i class="fas fa-graduation-cap"></i> مسارات التعلم</h2>
          <p>اختر المسار الذي يناسب طموحك التقني</p>
        </div>
        
        <div class="tracks-grid">
          <a href="/Th-tech/ai/" class="track-card">
            <div class="track-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=350&fit=crop" alt="AI" />
              <div class="track-overlay"></div>
            </div>
            <div class="track-content">
              <div class="track-icon">
                <i class="fas fa-brain"></i>
              </div>
              <div class="track-info">
                <h3>الذكاء الاصطناعي</h3>
                <p>تعلم الآلة، الشبكات العصبية، وهندسة الأوامر.</p>
                <ul class="track-list">
                  <li><i class="fas fa-check"></i> Machine Learning</li>
                  <li><i class="fas fa-check"></i> Deep Learning</li>
                  <li><i class="fas fa-check"></i> NLP</li>
                </ul>
              </div>
            </div>
          </a>

          <a href="/Th-tech/programming/" class="track-card">
            <div class="track-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=350&fit=crop" alt="Code" />
              <div class="track-overlay"></div>
            </div>
            <div class="track-content">
              <div class="track-icon">
                <i class="fas fa-code"></i>
              </div>
              <div class="track-info">
                <h3>هندسة البرمجيات</h3>
                <p>تطوير التطبيقات، الأنماط المعمارية، وDevOps.</p>
                <ul class="track-list">
                  <li><i class="fas fa-check"></i> Full Stack</li>
                  <li><i class="fas fa-check"></i> DevOps</li>
                  <li><i class="fas fa-check"></i> Clean Code</li>
                </ul>
              </div>
            </div>
          </a>

          <a href="/Th-tech/security/" class="track-card">
            <div class="track-image">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=350&fit=crop" alt="Security" />
              <div class="track-overlay"></div>
            </div>
            <div class="track-content">
              <div class="track-icon">
                <i class="fas fa-lock"></i>
              </div>
              <div class="track-info">
                <h3>الأمن السيبراني</h3>
                <p>اختبار الاختراق الأخلاقي وتحليل الثغرات.</p>
                <ul class="track-list">
                  <li><i class="fas fa-check"></i> Ethical Hacking</li>
                  <li><i class="fas fa-check"></i> Network Security</li>
                  <li><i class="fas fa-check"></i> Cryptography</li>
                </ul>
              </div>
            </div>
          </a>

          <a href="/Th-tech/cloud/" class="track-card">
            <div class="track-image">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=350&fit=crop" alt="Cloud" />
              <div class="track-overlay"></div>
            </div>
            <div class="track-content">
              <div class="track-icon">
                <i class="fas fa-cloud"></i>
              </div>
              <div class="track-info">
                <h3>الحوسبة السحابية</h3>
                <p>نشر التطبيقات، Docker، Kubernetes وAWS.</p>
                <ul class="track-list">
                  <li><i class="fas fa-check"></i> AWS & Azure</li>
                  <li><i class="fas fa-check"></i> Kubernetes</li>
                  <li><i class="fas fa-check"></i> Docker</li>
                </ul>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Articles -->
    <section class="articles">
      <div class="container">
        <div class="section-header">
          <h2><i class="fas fa-newspaper"></i> أحدث المقالات</h2>
          <p>محتوى تقني محدّث باستمرار</p>
        </div>
        
        <div class="articles-grid">
          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" />
              <span class="article-badge new">جديد</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag ai"><i class="fas fa-robot"></i> AI</span>
                <span class="read-time"><i class="far fa-clock"></i> 5 دقائق</span>
              </div>
              <h3>دليلك الشامل لتعلم الآلة</h3>
              <p>رحلة عملية من الصفر للاحتراف في بناء النماذج الذكية</p>
              <a href="#" class="read-more">اقرأ المزيد <i class="fas fa-arrow-left"></i></a>
            </div>
          </article>

          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" />
              <span class="article-badge popular">شائع</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag security"><i class="fas fa-shield-alt"></i> Security</span>
                <span class="read-time"><i class="far fa-clock"></i> 8 دقائق</span>
              </div>
              <h3>أمن السحابة: أفضل الممارسات</h3>
              <p>استراتيجيات حماية متقدمة لتطبيقاتك على AWS و Azure</p>
              <a href="#" class="read-more">اقرأ المزيد <i class="fas fa-arrow-left"></i></a>
            </div>
          </article>

          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Code" />
              <span class="article-badge updated">محدّث</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag code"><i class="fas fa-code"></i> Code</span>
                <span class="read-time"><i class="far fa-clock"></i> 6 دقائق</span>
              </div>
              <h3>مبادئ SOLID للمحترفين</h3>
              <p>الأنماط التصميمية التي تفصل بين الكود العادي والاحترافي</p>
              <a href="#" class="read-more">اقرأ المزيد <i class="fas fa-arrow-left"></i></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Features Section (جديد) -->
    <section class="features-section">
      <div class="container">
        <div class="section-header">
          <h2><i class="fas fa-star"></i> لماذا Th.Tech؟</h2>
        </div>
        <div class="features-grid">
          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>
            <h3>سرعة فائقة</h3>
            <p>تنفيذ الكود فوراً بدون انتظار</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-mobile-alt"></i>
            </div>
            <h3>متجاوب</h3>
            <p>يعمل على جميع الأجهزة بامتياز</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-save"></i>
            </div>
            <h3>حفظ تلقائي</h3>
            <p>كودك يُحفظ تلقائياً في المتصفح</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-download"></i>
            </div>
            <h3>تصدير سهل</h3>
            <p>حمّل أكوادك بصيغ مختلفة</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <div class="section-header">
          <h2><i class="fas fa-question-circle"></i> الأسئلة الشائعة</h2>
        </div>
        <div class="faq-grid">
          <div class="faq-item">
            <h3><i class="fas fa-user-graduate"></i> هل أحتاج خبرة سابقة؟</h3>
            <p>لا! نبدأ معك من الصفر حتى الاحتراف مع شروحات مبسطة.</p>
          </div>
          <div class="faq-item">
            <h3><i class="fas fa-terminal"></i> كيف أستخدم المحرر؟</h3>
            <p>اكتب الكود واضغط "تشغيل" لترى النتيجة فوراً.</p>
          </div>
          <div class="faq-item">
            <h3><i class="fas fa-save"></i> هل يمكنني حفظ أعمالي؟</h3>
            <p>نعم! يُحفظ تلقائياً في LocalStorage.</p>
          </div>
          <div class="faq-item">
            <h3><i class="fas fa-code"></i> ما اللغات المدعومة؟</h3>
            <p>Python و JavaScript و HTML/CSS.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter">
      <div class="container">
        <div class="newsletter-box">
          <div class="newsletter-icon"><i class="fas fa-envelope"></i></div>
          <h2>اشترك في نشرتنا</h2>
          <p>احصل على أحدث المقالات والشروحات مباشرة في بريدك</p>
          <form class="newsletter-form" onsubmit="handleSubscribe(event)">
            <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
            <button type="submit" class="btn btn-primary">اشترك الآن</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Scroll to Top -->
  <button id="scrollTop" class="scroll-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
    <i class="fas fa-arrow-up"></i>
  </button>

  <style>
    :root {
      --bg: #0b1120;
      --bg-secondary: #0f172a;
      --bg-tertiary: #1e293b;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --border: #1e293b;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --accent: #06b6d4;
      --card-bg: #1e293b;
    }

    [data-theme="light"] {
      --bg: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #f1f5f9;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --card-bg: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Cairo', sans-serif; line-height: 1.6; transition: background 0.3s, color 0.3s; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    section { padding: 4rem 0; }

    /* Hero */
    .hero { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 100px 0; }
    .hero-bg { position: absolute; inset: 0; z-index: -1; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5); }
    .overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(11,17,32,0.6), var(--bg)); }
    
    .hero-container { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; width: 100%; }
    .badge { display: inline-block; background: rgba(59,130,246,0.2); color: var(--primary); padding: 0.5rem 1.5rem; border-radius: 50px; margin-bottom: 1.5rem; font-weight: 700; }
    h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; }
    .gradient-text { background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .cursor { display: inline-block; width: 3px; height: 1em; background-color: var(--primary); animation: blink 1s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .hero-desc { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 2.5rem; }
    
    .hero-actions { display: flex; gap: 1rem; margin-bottom: 2rem; }
    .btn { padding: 0.9rem 2rem; border-radius: 10px; font-weight: 700; text-decoration: none; transition: 0.3s; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 0.5rem; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(59,130,246,0.4); }
    .btn-secondary { background: var(--bg-tertiary); color: var(--text); border: 1px solid var(--border); }
    
    .hero-features { display: flex; gap: 2rem; }
    .hero-feature { display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.9rem; }
    .hero-feature i { color: var(--primary); }

    /* Floating Cards */
    .hero-visual { position: relative; height: 400px; }
    .float-card {
      position: absolute;
      background: rgba(30, 41, 59, 0.8);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      animation: float 6s ease-in-out infinite;
    }
    .float-card:first-child { top: 50px; left: 0; width: 280px; }
    .float-card.delay-1 { bottom: 150px; right: 50px; animation-delay: 2s; }
    .float-card.delay-2 { bottom: 50px; left: 100px; animation-delay: 4s; }
    .code-line { font-family: 'Fira Code', monospace; direction: ltr; text-align: left; margin: 0.3rem 0; }
    .tag { color: #f472b6; } .str { color: #34d399; } .comment { color: var(--text-muted); }
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

    /* Ticker */
    .tech-ticker { background: var(--bg-secondary); padding: 1.2rem 0; border-bottom: 1px solid var(--border); overflow: hidden; }
    .ticker-track { display: flex; gap: 3rem; width: max-content; animation: scroll 30s linear infinite; }
    .tech-item { color: var(--text-muted); font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* Stats */
    .stats-bar { background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
    .stats-grid { display: flex; justify-content: center; align-items: center; gap: 4rem; }
    .stat-item { text-align: center; }
    .stat-icon { font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem; display: block; }
    .stat-value { display: block; font-size: 2.5rem; font-weight: 800; color: var(--primary); }
    .stat-label { color: var(--text-muted); }
    .stat-divider { width: 1px; height: 60px; background: var(--border); }

    /* Tracks */
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-header h2 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
    .section-header h2 i { color: var(--primary); }
    .section-header p { color: var(--text-muted); }
    
    .tracks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
    .track-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--text); transition: 0.3s; }
    .track-card:hover { transform: translateY(-5px); border-color: var(--primary); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .track-image { position: relative; height: 180px; overflow: hidden; }
    .track-image img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
    .track-card:hover .track-image img { transform: scale(1.1); }
    .track-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent, var(--card-bg)); }
    .track-content { padding: 1.5rem; }
    .track-icon { width: 60px; height: 60px; background: var(--bg-tertiary); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 1.8rem; margin-bottom: 1rem; }
    .track-info h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
    .track-info p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
    .track-list { list-style: none; }
    .track-list li { padding: 0.3rem 0; color: var(--text-muted); font-size: 0.85rem; }
    .track-list i { color: var(--primary); margin-left: 0.5rem; font-size: 0.8rem; }

    /* Articles */
    .articles { background: var(--bg-secondary); }
    .articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
    .article-card { background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border); transition: 0.3s; }
    .article-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .article-image { position: relative; height: 200px; overflow: hidden; }
    .article-image img { width: 100%; height: 100%; object-fit: cover; }
    .article-badge { position: absolute; top: 1rem; right: 1rem; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; color: white; }
    .article-badge.new { background: #10b981; }
    .article-badge.popular { background: #f59e0b; }
    .article-badge.updated { background: #3b82f6; }
    .article-content { padding: 1.5rem; }
    .article-meta { display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.85rem; }
    .tag { padding: 0.3rem 0.8rem; border-radius: 6px; font-weight: 700; }
    .tag.ai { background: rgba(59,130,246,0.1); color: #3b82f6; }
    .tag.security { background: rgba(239,68,68,0.1); color: #ef4444; }
    .tag.code { background: rgba(16,185,129,0.1); color: #10b981; }
    .article-content h3 { font-size: 1.2rem; margin-bottom: 0.8rem; }
    .article-content p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem; }
    .read-more { color: var(--primary); text-decoration: none; font-weight: 600; }

    /* Features */
    .features-section { background: var(--bg); }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
    .feature-box { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; text-align: center; transition: 0.3s; }
    .feature-box:hover { transform: translateY(-5px); border-color: var(--primary); }
    .feature-icon { width: 70px; height: 70px; background: var(--bg-tertiary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 2rem; margin: 0 auto 1rem; }
    .feature-box h3 { margin-bottom: 0.5rem; }
    .feature-box p { color: var(--text-muted); font-size: 0.95rem; }

    /* FAQ */
    .faq-section { background: var(--bg-secondary); }
    .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
    .faq-item { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
    .faq-item h3 { color: var(--primary); margin-bottom: 1rem; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem; }
    .faq-item p { color: var(--text-muted); line-height: 1.6; }

    /* Newsletter */
    .newsletter { text-align: center; }
    .newsletter-box { max-width: 600px; margin: 0 auto; background: var(--card-bg); padding: 3rem; border-radius: 16px; border: 1px solid var(--border); }
    .newsletter-icon { font-size: 3.5rem; color: var(--primary); margin-bottom: 1rem; }
    .newsletter h2 { margin-bottom: 0.5rem; }
    .newsletter p { color: var(--text-muted); margin-bottom: 2rem; }
    .newsletter-form { display: flex; gap: 1rem; }
    .newsletter-form input { flex: 1; padding: 1rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-secondary); color: var(--text); }
    .newsletter-form input:focus { outline: none; border-color: var(--primary); }

    /* Scroll Top */
    .scroll-top {
      position: fixed; bottom: 2rem; left: 2rem; width: 50px; height: 50px;
      background: var(--primary); color: white; border: none; border-radius: 50%;
      cursor: pointer; opacity: 0; transition: 0.3s; z-index: 999;
    }
    .scroll-top.show { opacity: 1; }
    .scroll-top:hover { transform: translateY(-3px); }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-container { grid-template-columns: 1fr; text-align: center; }
      .hero-visual { display: none; }
      .hero-features { justify-content: center; }
      .stats-grid { flex-direction: column; gap: 2rem; }
      .stat-divider { width: 50px; height: 1px; }
      .tracks-grid, .articles-grid, .features-grid, .faq-grid { grid-template-columns: 1fr; }
      .newsletter-form { flex-direction: column; }
    }
  </style>

  <script>
    // Typewriter
    const text = "المستقبل الرقمي بأدوات احترافية";
    let i = 0;
    function type() {
      if (i < text.length) {
        document.getElementById('typewriter').textContent += text.charAt(i);
        i++;
        setTimeout(type, 80);
      }
    }
    setTimeout(type, 500);

    // Counters
    document.querySelectorAll('.stat-value').forEach(counter => {
      const target = +counter.dataset.target;
      const suffix = counter.dataset.suffix || '';
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            let current = 0;
            const step = target / 50;
            const timer = setInterval(() => {
              current += step;
              if (current >= target) {
                counter.textContent = target + suffix;
                clearInterval(timer);
              } else {
                counter.textContent = Math.floor(current) + suffix;
              }
            }, 30);
            observer.unobserve(entry.target);
          }
        });
      });
      observer.observe(counter);
    });

    // Scroll Top
    window.addEventListener('scroll', () => {
      const btn = document.getElementById('scrollTop');
      if (window.scrollY > 300) btn.classList.add('show');
      else btn.classList.remove('show');
    });

    // Newsletter
    function handleSubscribe(e) {
      e.preventDefault();
      alert('✅ شكراً لاشتراكك!');
      e.target.reset();
    }

    // Listen for theme changes from Header
    window.addEventListener('themeChange', (e) => {
      document.documentElement.setAttribute('data-theme', e.detail);
    });
  </script>
</body>
</html>
