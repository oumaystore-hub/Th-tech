  }
</style>

<script>
  /* ==========================================
     TOOL DATA
     ========================================== */

  const toolDataElement =
    document.getElementById('th-tech-tool-data');

  let toolsData = [];

  try {
    toolsData = toolDataElement
      ? JSON.parse(toolDataElement.textContent || '[]')
      : [];
  } catch {
    toolsData = [];
  }

  /* ==========================================
     BASE PATH
     ========================================== */

  const siteBase =
    document.documentElement.dataset.base || '';

  /* ==========================================
     TYPEWRITER
     ========================================== */

  const typingElement =
    document.getElementById('typing-text');

  const typingWords = [
    'المستقبل الرقمي',
    'مشاريعك التقنية',
    'أفكارك البرمجية',
    'مهاراتك الرقمية'
  ];

  let wordIndex = 0;
  let charIndex = typingWords[0].length;
  let deleting = true;
  let typingTimer = 0;

  const clearTypingTimer = () => {
    if (typingTimer) {
      window.clearTimeout(typingTimer);
      typingTimer = 0;
    }
  };

  const typeEffect = () => {
    if (!typingElement || document.hidden) return;

    const current = typingWords[wordIndex];

    if (deleting) {
      charIndex--;

      typingElement.textContent =
        current.slice(0, charIndex);

      if (charIndex <= 0) {
        deleting = false;

        wordIndex =
          (wordIndex + 1) % typingWords.length;

        typingTimer = window.setTimeout(
          typeEffect,
          350
        );

        return;
      }

      typingTimer = window.setTimeout(
        typeEffect,
        42
      );

      return;
    }

    charIndex++;

    typingElement.textContent =
      current.slice(0, charIndex);

    if (charIndex >= current.length) {
      deleting = true;

      typingTimer = window.setTimeout(
        typeEffect,
        1800
      );

      return;
    }

    typingTimer = window.setTimeout(
      typeEffect,
      70
    );
  };

  typingTimer = window.setTimeout(
    typeEffect,
    1500
  );

  /* ==========================================
     TAB VISIBILITY
     ========================================== */

  document.addEventListener(
    'visibilitychange',
    () => {
      if (document.hidden) {
        clearTypingTimer();
        return;
      }

      if (typingElement) {
        typingTimer = window.setTimeout(
          typeEffect,
          500
        );
      }
    }
  );

  /* ==========================================
     COUNTER
     ========================================== */

  const counters =
    document.querySelectorAll('.counter');

  const statsSection =
    document.querySelector('.stats-section');

  const animateCounter = (element) => {
    if (element.dataset.animated === 'true') {
      return;
    }

    element.dataset.animated = 'true';

    const target = Number(
      element.dataset.target || 0
    );

    if (!target) {
      element.textContent = '0';
      return;
    }

    const duration = 800;
    const startTime = performance.now();

    const update = (now) => {
      const progress = Math.min(
        (now - startTime) / duration,
        1
      );

      const eased =
        1 - Math.pow(1 - progress, 3);

      element.textContent =
        Math.floor(target * eased).toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        element.textContent =
          target.toString();
      }
    };

    requestAnimationFrame(update);
  };

  if (
    statsSection &&
    counters.length &&
    'IntersectionObserver' in window
  ) {
    const observer =
      new IntersectionObserver(
        (entries, obs) => {
          if (!entries[0]?.isIntersecting) return;

          counters.forEach(animateCounter);
          obs.disconnect();
        },
        {
          threshold: 0.15
        }
      );

    observer.observe(statsSection);
  } else {
    counters.forEach(animateCounter);
  }

  /* ==========================================
     SEARCH
     ========================================== */

  const toolSearch =
    document.getElementById('tool-search');

  const resultsContainer =
    document.getElementById(
      'tool-search-results'
    );

  const emptyState =
    document.getElementById(
      'tool-search-empty'
    );

  const clearSearch =
    document.getElementById(
      'clear-tool-search'
    );

  const searchWrapper =
    document.querySelector(
      '.search-input-wrap'
    );

  const randomTool =
    document.getElementById('random-tool');

  const normalize = (value) =>
    String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[-_]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  /* ==========================================
     أيقونات البحث
     ========================================== */

  const getToolIcon = (tool) => {
    const value =
      `${tool.name} ${tool.slug}`.toLowerCase();

    if (
      value.includes('json') ||
      value.includes('javascript') ||
      value.includes('js')
    ) {
      return 'fa-file-code';
    }

    if (
      value.includes('sql') ||
      value.includes('database') ||
      value.includes('db')
    ) {
      return 'fa-database';
    }

    if (
      value.includes('qr')
    ) {
      return 'fa-qrcode';
    }

    if (
      value.includes('barcode')
    ) {
      return 'fa-barcode';
    }

    if (
      value.includes('image') ||
      value.includes('photo') ||
      value.includes('png') ||
      value.includes('jpg')
    ) {
      return 'fa-image';
    }

    if (
      value.includes('color') ||
      value.includes('hex') ||
      value.includes('rgb')
    ) {
      return 'fa-palette';
    }

    if (
      value.includes('url') ||
      value.includes('link') ||
      value.includes('uri')
    ) {
      return 'fa-link';
    }

    if (
      value.includes('api') ||
      value.includes('request') ||
      value.includes('http')
    ) {
      return 'fa-plug';
    }

    if (
      value.includes('base64') ||
      value.includes('encode') ||
      value.includes('decode')
    ) {
      return 'fa-lock';
    }

    if (
      value.includes('hash') ||
      value.includes('crypto') ||
      value.includes('encrypt') ||
      value.includes('decrypt')
    ) {
      return 'fa-shield-halved';
    }

    if (
      value.includes('regex') ||
      value.includes('regexp')
    ) {
      return 'fa-filter';
    }

    if (
      value.includes('uuid') ||
      value.includes('guid')
    ) {
      return 'fa-fingerprint';
    }

    if (
      value.includes('xml') ||
      value.includes('yaml') ||
      value.includes('csv')
    ) {
      return 'fa-file-lines';
    }

    if (
      value.includes('markdown') ||
      value.includes('md')
    ) {
      return 'fa-file-lines';
    }

    if (
      value.includes('text') ||
      value.includes('word') ||
      value.includes('character') ||
      value.includes('counter')
    ) {
      return 'fa-align-left';
    }

    if (
      value.includes('timestamp') ||
      value.includes('date') ||
      value.includes('time')
    ) {
      return 'fa-calendar-days';
    }

    if (
      value.includes('html')
    ) {
      return 'fa-brands fa-html5';
    }

    if (
      value.includes('css')
    ) {
      return 'fa-brands fa-css3-alt';
    }

    return 'fa-code';
  };

  const getToolType = (tool) => {
    const value =
      `${tool.name} ${tool.slug}`.toLowerCase();

    if (value.includes('json')) return 'JSON';
    if (value.includes('sql')) return 'SQL';
    if (value.includes('qr')) return 'QR';
    if (value.includes('barcode')) return 'Barcode';
    if (value.includes('color')) return 'Color';
    if (value.includes('url') || value.includes('link')) return 'Web';
    if (value.includes('api') || value.includes('request')) return 'API';
    if (value.includes('base64')) return 'Encoding';
    if (value.includes('hash') || value.includes('crypto')) return 'Security';
    if (value.includes('regex')) return 'Developer';
    if (value.includes('uuid')) return 'Utility';

    return 'Developer Tool';
  };

  const createResult = (tool) => {
    const link =
      document.createElement('a');

    link.className = 'search-result';

    link.href =
      `${siteBase}/tools/${tool.slug}/`;

    link.setAttribute(
      'aria-label',
      `فتح أداة ${tool.name}`
    );

    const icon =
      document.createElement('span');

    icon.className =
      'search-result-icon';

    const iconElement =
      document.createElement('i');

    const iconClass =
      getToolIcon(tool);

    iconElement.className =
      iconClass.startsWith('fa-brands')
        ? iconClass
        : `fa-solid ${iconClass}`;

    icon.appendChild(iconElement);

    const content =
      document.createElement('span');

    content.className =
      'search-result-content';

    const name =
      document.createElement('span');

    name.className =
      'search-result-name';

    name.textContent =
      tool.name;

    const type =
      document.createElement('span');

    type.className =
      'search-result-type';

    type.textContent =
      getToolType(tool);

    content.appendChild(name);
    content.appendChild(type);

    const arrow =
      document.createElement('span');

    arrow.className =
      'search-result-arrow';

    arrow.innerHTML =
      '<i class="fa-solid fa-arrow-left"></i>';

    link.appendChild(icon);
    link.appendChild(content);
    link.appendChild(arrow);

    return link;
  };

  const renderResults = (query = '') => {
    if (!resultsContainer) return;

    const normalizedQuery =
      normalize(query);

    resultsContainer.replaceChildren();

    if (!normalizedQuery) {
      emptyState?.setAttribute(
        'hidden',
        ''
      );

      return;
    }

    const words =
      normalizedQuery.split(/\s+/);

    const matches =
      toolsData
        .map((tool) => {
          const name =
            normalize(tool.name);

          const slug =
            normalize(tool.slug);

          let score = 0;

          if (
            name === normalizedQuery
          ) {
            score += 100;
          }

          if (
            name.includes(normalizedQuery)
          ) {
            score += 50;
          }

          if (
            slug.includes(normalizedQuery)
          ) {
            score += 40;
          }

          words.forEach((word) => {
            if (word.length < 2) return;

            if (name.includes(word)) {
              score += 15;
            }

            if (slug.includes(word)) {
              score += 10;
            }
          });

          return {
            tool,
            score
          };
        })
        .filter(
          (item) => item.score > 0
        )
        .sort(
          (a, b) =>
            b.score - a.score ||
            a.tool.name.localeCompare(
              b.tool.name
            )
        )
        .slice(0, 8);

    if (!matches.length) {
      emptyState?.removeAttribute(
        'hidden'
      );

      return;
    }

    emptyState?.setAttribute(
      'hidden',
      ''
    );

    const fragment =
      document.createDocumentFragment();

    matches.forEach(({ tool }) => {
      fragment.appendChild(
        createResult(tool)
      );
    });

    resultsContainer.appendChild(
      fragment
    );
  };

  if (toolSearch) {
    toolSearch.addEventListener(
      'input',
      () => {
        const value =
          toolSearch.value.trim();

        searchWrapper?.classList.toggle(
          'has-value',
          Boolean(value)
        );

        renderResults(value);
      }
    );
  }

  if (clearSearch) {
    clearSearch.addEventListener(
      'click',
      () => {
        if (!toolSearch) return;

        toolSearch.value = '';

        searchWrapper?.classList.remove(
          'has-value'
        );

        renderResults('');

        toolSearch.focus();
      }
    );
  }

  if (randomTool) {
    randomTool.addEventListener(
      'click',
      () => {
        if (!toolsData.length) return;

        const index =
          Math.floor(
            Math.random() *
              toolsData.length
          );

        const selected =
          toolsData[index];

        if (!selected?.slug) return;

        window.location.href =
          `${siteBase}/tools/${selected.slug}/`;
      }
    );
  }

  /* ==========================================
     TOOL TRACKING
     ========================================== */

  document
    .querySelectorAll('[data-tool-link]')
    .forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const slug =
            link.getAttribute(
              'data-tool-link'
            );

          if (!slug) return;

          try {
            localStorage.setItem(
              'thtech-last-tool',
              slug
            );
          } catch {}
        }
      );
    });

  /* ==========================================
     SCROLL TOP
     ========================================== */

  const scrollTop =
    document.getElementById(
      'scroll-top'
    );

  if (scrollTop) {
    let ticking = false;

    const update = () => {
      scrollTop.classList.toggle(
        'visible',
        window.scrollY > 450
      );

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(update);
      },
      {
        passive: true
      }
    );

    scrollTop.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    );
  }

  /* ==========================================
     FAQ
     ========================================== */

  const faqItems =
    document.querySelectorAll(
      '.faq-item'
    );

  faqItems.forEach((item) => {
    item.addEventListener(
      'toggle',
      () => {
        if (
          !(item instanceof HTMLDetailsElement) ||
          !item.open
        ) {
          return;
        }

        faqItems.forEach((other) => {
          if (
            other !== item &&
            other instanceof HTMLDetailsElement
          ) {
            other.open = false;
          }
        });
      }
    );
  });
</script>
