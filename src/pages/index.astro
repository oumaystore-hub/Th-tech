---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | المنصة التقنية</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <span class="badge">منصة المطورين</span>
          <h1>ابنِ <span class="gradient">مستقبلك الرقمي</span><br />بأدوات احترافية</h1>
          <p>شروحات تقنية معمقة، أدلة مرجعية، ومختبر أكواد تفاعلي.<br />كل ما تحتاجه في مكان واحد.</p>
          <div class="hero-actions">
            <a href="/Th-tech/guides/" class="btn btn-primary">تصفح الأدلة</a>
            <a href="/Th-tech/playground/" class="btn btn-secondary">المختبر</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-box"><span class="stat-num">150+</span><span class="stat-label">دليل تقني</span></div>
          <div class="stat-box"><span class="stat-num">50K+</span><span class="stat-label">قارئ شهرياً</span></div>
          <div class="stat-box"><span class="stat-num">100%</span><span class="stat-label">محتوى مجاني</span></div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="container">
        <div class="section-header"><h2>المسارات التقنية</h2><p>اختر المجال الذي يناسب مسارك المهني</p></div>
        <div class="features-grid">
          <a href="/Th-tech/ai/" class="feature-card"><div class="card-icon"></div><h3>الذكاء الاصطناعي</h3><p>تعلم الآلة، النماذج اللغوية، وتطبيقات الـ AI.</p></a>
          <a href="/Th-tech/programming/" class="feature-card"><div class="card-icon">💻</div><h3>هندسة البرمجيات</h3><p>الأطر الحديثة، الأنماط التصميمية، وأفضل الممارسات.</p></a>
          <a href="/Th-tech/security/" class="feature-card"><div class="card-icon"></div><h3>الأمن السيبراني</h3><p>اختبار الاختراق، تحليل الثغرات، وحماية البنى التحتية.</p></a>
          <a href="/Th-tech/cloud/" class="feature-card"><div class="card-icon">☁️</div><h3>الحوسبة السحابية</h3><p>نشر التطبيقات، DevOps، وإدارة البنى على AWS وAzure.</p></a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2>جاهز للبدء؟</h2>
          <p>انضم إلى مجتمع المطورين واحصل على الوصول الكامل للمحتوى.</p>
          <a href="/Th-tech/guides/" class="btn btn-light">استعرض المحتوى</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #ffffff; --bg-secondary: #f8fafc; --bg-tertiary: #f1f5f9;
    --text: #0f172a; --text-muted: #64748b; --border: #e2e8f0;
    --primary: #2563eb; --primary-hover: #1d4ed8; --success: #10b981;
    --card: #ffffff; --shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  [data-theme="dark"] {
    --bg: #0b1120; --bg-secondary: #0f172a; --bg-tertiary: #1e293b;
    --text: #f1f5f9; --text-muted: #94a3b8; --border: #334155;
    --primary: #3b82f6; --primary-hover: #2563eb;
    --card: #1e293b; --shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Cairo', sans-serif; line-height: 1.6; transition: background 0.3s, color 0.3s; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  section { padding: 5rem 0; }

  .hero { background: var(--bg-secondary); padding: 6rem 0 5rem; text-align: center; }
  .badge { display: inline-block; background: var(--bg-tertiary); color: var(--primary); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; border: 1px solid var(--border); }
  .hero h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem; }
  .gradient { background: linear-gradient(135deg, var(--primary), #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero p { font-size: 1.2rem; color: var(--text-muted); max-width: 700px; margin: 0 auto 2.5rem; line-height: 1.7; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn { display: inline-flex; align-items: center; padding: 0.9rem 2rem; border-radius: 10px; font-weight: 700; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; font-size: 1rem; }
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); }
  .btn-secondary { background: var(--bg-tertiary); color: var(--text); border: 1px solid var(--border); }
  .btn-secondary:hover { border-color: var(--primary); color: var(--primary); }
  .btn-light { background: white; color: var(--primary); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: var(--shadow); }

  .stats { background: var(--bg); padding: 3rem 0; border-bottom: 1px solid var(--border); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .stat-num { display: block; font-size: 2.5rem; font-weight: 800; color: var(--primary); margin-bottom: 0.3rem; }
  .stat-label { color: var(--text-muted); font-size: 1rem; }

  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-header h2 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
  .section-header p { color: var(--text-muted); font-size: 1.1rem; }

  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
  .feature-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; text-decoration: none; color: var(--text); transition: all 0.2s; }
  .feature-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--primary); }
  .card-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .feature-card h3 { font-size: 1.3rem; margin-bottom: 0.5rem; font-weight: 700; }
  .feature-card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }

  .cta-section { background: var(--bg-secondary); text-align: center; padding: 6rem 0; }
  .cta-box { max-width: 600px; margin: 0 auto; }
  .cta-box h2 { font-size: 2.2rem; margin-bottom: 1rem; }
  .cta-box p { color: var(--text-muted); margin-bottom: 2rem; font-size: 1.1rem; }

  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-actions { flex-direction: column; }
    .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  // Counter Animation
  function initCounters() {
    const counters = document.querySelectorAll('.stat-num');
    counters.forEach(counter => {
      const target = parseInt(counter.textContent);
      const suffix = counter.textContent.replace(/[0-9]/g, '');
      let current = 0;
      const step = target / 50;
      const timer = setInterval(() => {
        current += step;
        if (current >= target) { counter.textContent = target + suffix; clearInterval(timer); }
        else { counter.textContent = Math.floor(current) + suffix; }
      }, 30);
    });
  }
  document.addEventListener('DOMContentLoaded', initCounters);
</script>
