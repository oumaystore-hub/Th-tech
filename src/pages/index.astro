---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = `https://oumaystore-hub.github.io${base}`;

/* ==========================================
   اكتشاف الأدوات تلقائياً
   ========================================== */

const toolModules = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(toolModules)
  .map((file) => {
    const match = file.match(/\.\/tools\/([^/]+)\/index\.astro$/);
    return match ? match[1] : null;
  })
  .filter(Boolean) as string[];

const displayName = (slug: string) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const preferredTools = [
  'api-request-builder',
  'json-formatter',
  'json-validator',
  'sql-formatter',
  'markdown-editor',
  'base64-encoder',
  'base64-decoder',
  'qr-code-generator',
  'barcode-generator',
  'color-picker',
  'regex-tester',
  'uuid-generator'
];

const sortedTools = [...toolSlugs].sort((a, b) => {
  const ai = preferredTools.indexOf(a);
  const bi = preferredTools.indexOf(b);

  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;

  return a.localeCompare(b);
});

const featuredTools = sortedTools.slice(0, 12);
const toolsCount = toolSlugs.length;

/* ==========================================
   بيانات الأدوات للبحث السريع
   ========================================== */

const toolSearchData = sortedTools.map((slug) => ({
  slug,
  name: displayName(slug)
}));

/* ==========================================
   بيانات المسارات
   ========================================== */

const tracks = [
  {
    title: 'الذكاء الاصطناعي',
    slug: 'ai',
    icon: 'fa-brain',
    image:
      'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1200&q=80',
    description:
      'استكشف الذكاء الاصطناعي وتعلم المفاهيم والتقنيات التي تقود مستقبل التقنية.',
    tags: ['AI', 'Machine Learning', 'Automation']
  },
  {
    title: 'البرمجة',
    slug: 'programming',
    icon: 'fa-code',
    image:
      'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعلم البرمجة وتطوير التطبيقات وفهم الأدوات والمفاهيم الأساسية للمطورين.',
    tags: ['JavaScript', 'Python', 'Web']
  },
  {
    title: 'الأمن السيبراني',
    slug: 'security',
    icon: 'fa-shield-halved',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعرف على مفاهيم الأمن السيبراني والشبكات والتشفير وحماية الأنظمة.',
    tags: ['Security', 'Networks', 'Cryptography']
  },
  {
    title: 'الحوسبة السحابية',
    slug: 'cloud',
    icon: 'fa-cloud',
    image:
      'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80',
    description:
      'اكتشف الحوسبة السحابية والبنية التحتية والخدمات الحديثة للمطورين.',
    tags: ['AWS', 'Cloud', 'DevOps']
  }
];

const faqs = [
  {
    question: 'هل أحتاج إلى خبرة سابقة؟',
    answer:
      'لا. يمكنك البدء من المستوى الذي يناسبك، واستكشاف الأدوات والمقالات والأدلة تدريجياً حسب احتياجاتك.'
  },
  {
    question: 'هل الأدوات تعمل مباشرة من المتصفح؟',
    answer:
      'نعم، العديد من أدوات Th.Tech مصممة للعمل مباشرة من المتصفح، مع التركيز على السرعة وسهولة الاستخدام وتقليل الحاجة إلى خدمات خارجية.'
  },
  {
    question: 'هل الأدوات مجانية؟',
    answer:
      'نعم، أدوات Th.Tech متاحة للاستخدام مجاناً، ويمكنك الوصول إليها مباشرة من قسم الأدوات.'
  },
  {
    question: 'ما أنواع الأدوات الموجودة؟',
    answer:
      'ستجد أدوات للمطورين والبيانات والنصوص وJSON وSQL والترميز والتشفير والألوان والروابط وغيرها.'
  },
  {
    question: 'هل أستطيع استخدام الموقع من الهاتف؟',
    answer:
      'نعم. تم تصميم الواجهة لتعمل على الحاسوب والهاتف والأجهزة اللوحية مع الحفاظ على سهولة التنقل والاستخدام.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Th.Tech',
      description:
        'منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والأدوات التقنية.',
      inLanguage: 'ar'
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Th.Tech',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/logo1.png`,
      email: 'thtech.tech@gmail.com',
      sameAs: [
        'https://www.facebook.com/share/1PzewvX774/',
        'https://www.instagram.com/thtech.ma',
        'https://x.com/thtechma',
        'https://www.youtube.com/@thtechma',
        'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438'
      ]
    }
  ]
};
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | منصة تقنية عربية للتعلم والأدوات والبرمجة</title>

  <meta
    name="description"
    content="Th.Tech منصة تقنية عربية تجمع الأدوات التفاعلية، البرمجة، الذكاء الاصطناعي، الأمن السيبراني، الحوسبة السحابية والأدلة التقنية في مكان واحد."
  />

  <meta
    name="keywords"
    content="Th.Tech, أدوات تقنية, أدوات للمطورين, برمجة, ذكاء اصطناعي, أمن سيبراني, SQL, JSON, JavaScript, Python, أدوات أونلاين"
  />

  <meta name="author" content="Th.Tech" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={`${siteUrl}/`} />
  <link rel="icon" type="image/png" href={`${siteUrl}/logo1.png`} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="Th.Tech" />
  <meta property="og:title" content="Th.Tech | المنصة التقنية" />
  <meta
    property="og:description"
    content="أدوات تقنية تفاعلية ومحتوى عربي للبرمجة والذكاء الاصطناعي والأمن السيبراني."
  />
  <meta property="og:url" content={`${siteUrl}/`} />
  <meta property="og:image" content={`${siteUrl}/logo1.png`} />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Th.Tech | المنصة التقنية" />
  <meta
    name="twitter:description"
    content="منصة تقنية عربية تجمع الأدوات والمحتوى التعليمي للمطورين والمهتمين بالتقنية."
  />
  <meta name="twitter:image" content={`${siteUrl}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (
          saved === 'dark' ||
          (!saved &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- ==========================================
         HERO
         ========================================== -->

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-background"></div>
      <div class="hero-grid"></div>

      <div class="container hero-container">
        <div class="hero-content">

          <div class="hero-badge">
            <span class="badge-dot"></span>
            اكتشف، تعلّم، وابتكر
          </div>

          <h1 id="hero-title">
            ابنِ
            <span class="typing-wrapper">
              <span id="typing-text">المستقبل الرقمي</span>
            </span>
            بأدوات احترافية
          </h1>

          <p class="hero-description">
            منصة تقنية عربية تجمع بين الأدوات التفاعلية، الشروحات، الأدلة
            المرجعية والمسارات التعليمية في تجربة حديثة وسريعة.
          </p>

          <div class="hero-actions">
            <a href={`${base}/tools/`} class="btn btn-primary">
