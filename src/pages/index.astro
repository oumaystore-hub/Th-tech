---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const playgroundHref = `${base}/playground/`;
const guidesHref = `${base}/guides/`;
const toolsHref = `${base}/tools/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Th.Tech | المنصة التقنية</title>

    <meta
      name="description"
      content="Th.Tech منصة تقنية عربية تجمع بين الشروحات المتقدمة، الأدلة المرجعية، الأدوات التفاعلية ومختبر الأكواد في تجربة تعليمية حديثة وسريعة."
    />

    <link
      rel="canonical"
      href={`${siteUrl}${base}/`}
    />

    <link
      rel="icon"
      type="image/png"
      href={`${base}/Th-tech/logo1.png`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');

          if (
            savedTheme === 'dark' ||
            (!savedTheme &&
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <!-- =========================
         HERO
    ========================== -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=85"
          alt=""
        />
        <div class="hero-overlay"></div>
        <div class="hero-grid"></div>
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
      </div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="badge">
            <span class="badge-dot"></span>
            <i class="fas fa-rocket"></i>
            اكتشف، تعلّم، وابتكر
          </div>

          <h1>
            ابنِ
            <span id="typewriter" class="gradient-text"></span>
            <span class="cursor">|</span>
          </h1>

          <p class="hero-description">
            منصة تقنية عربية تجمع بين الشروحات المتقدمة، الأدلة المرجعية،
            الأدوات التفاعلية ومختبر الأكواد في تجربة تعليمية حديثة وسريعة.
          </p>

          <div class="hero-actions">
            <a href={playgroundHref} class="btn btn-primary">
              <i class="fas fa-code"></i>
              <span>ابدأ البرمجة الآن</span>
              <i class="fas fa-arrow-left btn-arrow"></i>
            </a>

            <a href={guidesHref} class="btn btn-secondary">
              <i class="fas fa-book-open"></i>
              <span>تصفح المكتبة</span>
            </a>

            <a href={toolsHref} class="btn btn-tools">
              <i class="fas fa-wand-magic-sparkles"></i>
              <span>استكشف الأدوات</span>
            </a>
          </div>

          <div class="hero-features">
            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-bolt"></i>
              </span>
              <span>تنفيذ فوري</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-shield-alt"></i>
              </span>
              <span>آمن 100%</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-gift"></i>
              </span>
              <span>مجاني تماماً</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual -->
        <div class="hero-visual">
          <div class="visual-orbit orbit-1"></div>
          <div class="visual-orbit orbit-2"></div>

          <!-- Python -->
          <div class="float-card card-1">
            <div class="card-top">
              <div class="language-icon python">
                <i class="fab fa-python"></i>
              </div>

              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </div>

            <div class="code-box">
              <div>
                <span class="code-purple">print</span>
                <span class="code-white">(</span>
                <span class="code-green">"مرحباً"</span>
                <span class="code-white">)</span>
              </div>

              <div class="code-comment">
                # Python 3.11
              </div>

              <div class="code-output">
                <i class="fas fa-terminal"></i>
                Hello World
              </div>
            </div>
          </div>

          <!-- JavaScript -->
          <div class="float-card card-2">
            <div class="small-icon js-icon">
              <i class="fab fa-js"></i>
            </div>

            <div>
              <strong>JavaScript</strong>
              <small>Modern Web</small>
            </div>

            <i class="fas fa-check-circle status-icon"></i>
          </div>

          <!-- Terminal -->
          <div class="float-card card-3">
            <div class="small-icon terminal-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <strong>Terminal</strong>
              <small>Ready to code</small>
            </div>
          </div>

          <!-- Lessons -->
          <div class="float-card card-4">
            <div class="progress-icon">
              <i class="fas fa-check"></i>
            </div>

            <div>
              <strong>+150 درس</strong>
              <small>جاهز للتعلم</small>
            </div>
          </div>

          <!-- React -->
          <div class="float-card card-5">
            <div class="small-icon react-icon">
              <i class="fab fa-react"></i>
            </div>

            <div>
              <strong>React</strong>
              <small>UI Library</small>
            </div>
          </div>

          <!-- Docker -->
          <div class="float-card card-6">
            <div class="small-icon docker-icon">
              <i class="fab fa-docker"></i>
            </div>

            <div>
              <strong>Docker</strong>
              <small>Container</small>
            </div>
          </div>

          <!-- Animated Th.Tech Logo -->
          <div class="visual-center">
            <div class="logo-energy energy-1"></div>
            <div class="logo-energy energy-2"></div>

            <div class="logo-orbit logo-orbit-1"></div>
            <div class="logo-orbit logo-orbit-2"></div>

            <div class="center-ring">
              <div class="center-logo">
                <div class="logo-mark">
                  <span>Th</span>
                </div>

                <div class="logo-name">
                  <strong>.Tech</strong>
                </div>

                <div class="logo-status">
                  <span></span>
                  ONLINE
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-scroll">
        <span>اكتشف المزيد</span>
        <i class="fas fa-chevron-down"></i>
      </div>
    </section>

    <!-- =========================
         TECH TICKER
    ========================== -->
    <div class="tech-ticker">
      <div class="ticker-fade ticker-fade-right"></div>
      <div class="ticker-fade ticker-fade-left"></div>

      <div class="ticker-track">
        <div class="tech-item">
          <i class="fab fa-js"></i> JavaScript
        </div>

        <div class="tech-item">
          <i class="fab fa-python"></i> Python
        </div>

        <div class="tech-item">
          <i class="fab fa-react"></i> React
        </div>

        <div class="tech-item">
          <i class="fab fa-aws"></i> AWS
        </div>

        <div class="tech-item">
          <i class="fas fa-shield-halved"></i> CyberSec
        </div>

        <div class="tech-item">
          <i class="fab fa-docker"></i> Docker
        </div>

        <div class="tech-item">
          <i class="fab fa-node-js"></i> Node.js
        </div>

        <div class="tech-item">
          <i class="fas fa-database"></i> SQL
        </div>

        <div class="tech-item">
          <i class="fab fa-js"></i> JavaScript
        </div>

        <div class="tech-item">
          <i class="fab fa-python"></i> Python
        </div>

        <div class="tech-item">
          <i class="fab fa-react"></i> React
        </div>

        <div class="tech-item">
          <i class="fab fa-aws"></i> AWS
        </div>

        <div class="tech-item">
          <i class="fas fa-shield-halved"></i> CyberSec
        </div>

        <div class="tech-item">
          <i class="fab fa-docker"></i> Docker
        </div>

        <div class="tech-item">
          <i class="fab fa-node-js"></i> Node.js
        </div>

        <div class="tech-item">
          <i class="fas fa-database"></i> SQL
        </div>
      </div>
    </div>

    <!-- =========================
         STATS
    ========================== -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-icon-wrap">
              <i class="fas fa-book-open"></i>
            </div>

            <div>
              <span
                class="stat-num"
                data-target="150"
                data-suffix="+"
              >0</span>

              <span class="stat-label">
                دليل شامل
              </span>
            </div>
          </div>

          <div class="stat-divider"></div>

          <div class="stat-item">
            <div class="stat-icon-wrap">
              <i class="fas fa-users"></i>
            </div>

            <div>
              <span
                class="stat-num"
                data-target="50"
                data-suffix="K+"
              >0</span>

              <span class="stat-label">
                قارئ شهرياً
              </span>
            </div>
          </div>

          <div class="stat-divider"></div>

          <div class="stat-item">
            <div class="stat-icon-wrap">
              <i class="fas fa-percent"></i>
            </div>

            <div>
              <span
                class="stat-num"
                data-target="100"
                data-suffix="%"
              >0</span>

              <span class="stat-label">
                محتوى مجاني
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         TRACKS
    ========================== -->
    <section class="tracks">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">
            <i class="fas fa-layer-group"></i>
            تعلّم بطريقة منظمة
          </span>

          <h2>
            مسارات <span>التعلم</span>
          </h2>

          <p>
            اختر المجال الذي يناسبك وابدأ رحلة التعلم خطوة بخطوة.
          </p>
        </div>

        <div class="tracks-grid">
          <!-- AI -->
          <a href={`${base}/ai/`} class="track">
            <div class="track-img">
              <img
                src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=700&q=85"
                alt="AI"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">01</span>
            </div>

            <div class="track-body">
              <div class="track-icon">
                <i class="fas fa-brain"></i>
              </div>

              <div class="track-title-row">
                <h3>الذكاء الاصطناعي</h3>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>
              </div>

              <p>
                تعلم الآلة والشبكات العصبية وتطبيقات الذكاء الاصطناعي الحديثة.
              </p>

              <ul class="track-list">
                <li>
                  <i class="fas fa-check"></i>
                  Machine Learning
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Deep Learning
                </li>
              </ul>
            </div>
          </a>

          <!-- Programming -->
          <a href={`${base}/programming/`} class="track">
            <div class="track-img">
              <img
                src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=700&q=85"
                alt="Code"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">02</span>
            </div>

            <div class="track-body">
              <div class="track-icon">
                <i class="fas fa-code"></i>
              </div>

              <div class="track-title-row">
                <h3>البرمجة</h3>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>
              </div>

              <p>
                تعلم تطوير المواقع والتطبيقات وبناء المشاريع الحديثة.
              </p>

              <ul class="track-list">
                <li>
                  <i class="fas fa-check"></i>
                  Full Stack
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  DevOps
                </li>
              </ul>
            </div>
          </a>

          <!-- Security -->
          <a href={`${base}/security/`} class="track">
            <div class="track-img">
              <img
                src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=700&q=85"
                alt="Security"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">03</span>
            </div>

            <div class="track-body">
              <div class="track-icon">
                <i class="fas fa-shield-halved"></i>
              </div>

              <div class="track-title-row">
                <h3>الأمن السيبراني</h3>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>
              </div>

              <p>
                فهم أساسيات الحماية واختبار الاختراق وأمن الأنظمة.
              </p>

              <ul class="track-list">
                <li>
                  <i class="fas fa-check"></i>
                  Ethical Hacking
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Network Security
                </li>
              </ul>
            </div>
          </a>

          <!-- Cloud -->
          <a href={`${base}/cloud/`} class="track">
            <div class="track-img">
              <img
                src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=700&q=85"
                alt="Cloud"
                loading="lazy"
              />

              <div class="track-img-overlay"></div>

              <span class="track-number">04</span>
            </div>

            <div class="track-body">
              <div class="track-icon">
                <i class="fas fa-cloud"></i>
              </div>

              <div class="track-title-row">
                <h3>الحوسبة السحابية</h3>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>
              </div>

              <p>
                اكتشف AWS وDocker وKubernetes وبنية الخدمات السحابية.
              </p>

              <ul class="track-list">
                <li>
                  <i class="fas fa-check"></i>
                  AWS
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Docker
                </li>
              </ul>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- =========================
         FEATURES
    ========================== -->
    <section class="features">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">
            <i class="fas fa-sparkles"></i>
            تجربة مختلفة
          </span>

          <h2>
            لماذا <span>Th.Tech؟</span>
          </h2>

          <p>
            أدوات ومحتوى مصمم لتجعل التعلم التقني أبسط وأسرع.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>سرعة فائقة</h3>

            <p>
              تجربة سريعة وخفيفة مع تنفيذ الكود فورياً.
            </p>

            <span class="feature-number">01</span>
          </div>

          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-mobile-screen-button"></i>
            </div>

            <h3>متجاوب بالكامل</h3>

            <p>
              تصميم يعمل بسلاسة على الهاتف والكمبيوتر واللوحي.
            </p>

            <span class="feature-number">02</span>
          </div>

          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-floppy-disk"></i>
            </div>

            <h3>حفظ تلقائي</h3>

            <p>
              يتم حفظ أكوادك وأعمالك محلياً داخل المتصفح.
            </p>

            <span class="feature-number">03</span>
          </div>

          <div class="feature-box">
            <div class="feature-icon">
              <i class="fas fa-download"></i>
            </div>

            <h3>تصدير سهل</h3>

            <p>
              احفظ مشاريعك وأكوادك بسهولة وبصيغ مختلفة.
            </p>

            <span class="feature-number">04</span>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         FAQ
    ========================== -->
    <section class="faq">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">
            <i class="fas fa-circle-question"></i>
            لديك سؤال؟
          </span>

          <h2>
            الأسئلة <span>الشائعة</span>
          </h2>

          <p>
            إجابات سريعة على أكثر الأسئلة التي قد تخطر في بالك.
          </p>
        </div>

        <div class="faq-grid">
          <div class="faq-item">
            <div class="faq-icon">
              <i class="fas fa-user-graduate"></i>
            </div>

            <div>
              <h3>هل أحتاج خبرة سابقة؟</h3>

              <p>
                لا! نبدأ معك من الأساسيات ونتدرج بك حتى المستويات المتقدمة.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <div class="faq-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <h3>كيف أستخدم المحرر؟</h3>

              <p>
                اكتب الكود داخل المحرر واضغط على زر "تشغيل" لمشاهدة النتيجة.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <div class="faq-icon">
              <i class="fas fa-save"></i>
            </div>

            <div>
              <h3>هل يمكنني حفظ أعمالي؟</h3>

              <p>
                نعم، يتم حفظ الأكواد محلياً في المتصفح لتتمكن من العودة إليها.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <div class="faq-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>ما اللغات المدعومة؟</h3>

              <p>
                Python وJavaScript وHTML وغيرها من التقنيات التي ستتم إضافتها.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         FINAL CTA
    ========================== -->
    <section class="final-cta">
      <div class="cta-glow"></div>

      <div class="container">
        <div class="cta-box">
          <div class="cta-content">
            <span class="section-kicker">
              <i class="fas fa-code"></i>
              مستعد للبدء؟
            </span>

            <h2>
              حوّل أفكارك إلى <span>واقع رقمي.</span>
            </h2>

            <p>
              ابدأ الآن واستكشف عالم البرمجة والتقنية بطريقة مختلفة.
            </p>

            <a
              href={playgroundHref}
              class="btn btn-primary cta-button"
            >
              <i class="fas fa-terminal"></i>
              افتح مختبر الأكواد
              <i class="fas fa-arrow-left"></i>
            </a>
          </div>

          <div class="cta-decoration">
            <div class="cta-code">
              <span>&lt;</span>
              <strong>code</strong>
              <span>/&gt;</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />

    <button
      id="scrollTop"
      class="scroll-top"
      aria-label="العودة إلى الأعلى"
      type="button"
    >
      <i class="fas fa-arrow-up"></i>
    </button>

    <style>
      /* =====================================================
         ROOT
      ===================================================== */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: 'Cairo', sans-serif;
        background: var(--bg);
        color: var(--text);
        overflow-x: hidden;
      }

      :global(html) {
        --bg: #f8fafc;
        --bg2: #f1f5f9;
        --bg3: #eaf0f7;

        --text: #0f172a;
        --text-muted: #64748b;

        --primary: #2563eb;
        --primary-2: #1d4ed8;
        --cyan: #0891b2;

        --border: rgba(15, 23, 42, 0.09);
        --card: rgba(255, 255, 255, 0.86);

        --shadow:
          0 20px 60px rgba(15, 23, 42, 0.08);

        --radius: 22px;
      }

      :global(html.dark-mode) {
        --bg: #07101f;
        --bg2: #0b1426;
        --bg3: #111d32;

        --text: #f8fafc;
        --text-muted: #94a3b8;

        --primary: #3b82f6;
        --primary-2: #2563eb;
        --cyan: #06b6d4;

        --border: rgba(148, 163, 184, 0.12);
        --card: rgba(15, 23, 42, 0.72);

        --shadow:
          0 25px 70px rgba(0, 0, 0, 0.3);
      }

      .container {
        width: min(1180px, calc(100% - 40px));
        margin-inline: auto;
      }

      /* =====================================================
         HERO
      ===================================================== */

      .hero {
        position: relative;
        min-height: 720px;
        display: flex;
        align-items: center;
        overflow: hidden;
        isolation: isolate;
        background: #07101f;
        color: #fff;
      }

      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: -3;
      }

      .hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.42;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(2, 6, 23, 0.97),
            rgba(2, 6, 23, 0.82),
            rgba(2, 6, 23, 0.58)
          );
      }

      .hero-grid {
        position: absolute;
        inset: 0;
        opacity: 0.16;
        background-image:
          linear-gradient(
            rgba(255, 255, 255, 0.07) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.07) 1px,
            transparent 1px
          );
        background-size: 55px 55px;
        mask-image: linear-gradient(to bottom, #000, transparent);
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(30px);
        pointer-events: none;
      }

      .hero-glow-1 {
        width: 360px;
        height: 360px;
        right: 8%;
        top: 12%;
        background: rgba(37, 99, 235, 0.2);
      }

      .hero-glow-2 {
        width: 300px;
        height: 300px;
        left: 4%;
        bottom: 5%;
        background: rgba(6, 182, 212, 0.13);
      }

      .hero-container {
        position: relative;
        z-index: 2;
        min-height: 720px;
        display: grid;
        grid-template-columns: 0.92fr 1.08fr;
        align-items: center;
        gap: 45px;
        padding: 100px 0 80px;
      }

      .hero-content {
        max-width: 620px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 14px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(12px);
        border-radius: 999px;
        font-size: 13px;
        color: #dbeafe;
        margin-bottom: 22px;
      }

      .badge i {
        color: #60a5fa;
      }

      .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 12px rgba(34, 197, 94, 0.8);
        animation: onlinePulse 1.8s infinite;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(40px, 5vw, 72px);
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -1.8px;
      }

      .gradient-text {
        background:
          linear-gradient(
            135deg,
            #60a5fa,
            #22d3ee,
            #a78bfa
          );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .cursor {
        color: #38bdf8;
        animation: blink 0.85s infinite;
      }

      .hero-description {
        max-width: 620px;
        margin: 24px 0 0;
        color: #cbd5e1;
        line-height: 2;
        font-size: 16px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .btn {
        min-height: 52px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 14px;
        text-decoration: none;
        font-family: inherit;
        font-weight: 800;
        font-size: 14px;
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          background 0.25s ease;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .btn-primary {
        color: #fff;
        background: linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );
        box-shadow:
          0 12px 30px rgba(37, 99, 235, 0.28);
      }

      .btn-primary:hover {
        box-shadow:
          0 18px 40px rgba(37, 99, 235, 0.4);
      }

      .btn-secondary,
      .btn-tools {
        color: #f8fafc;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(12px);
      }

      .btn-secondary:hover,
      .btn-tools:hover {
        background: rgba(255, 255, 255, 0.12);
      }

      .btn-tools {
        border-color: rgba(34, 211, 238, 0.25);
      }

      .btn-tools i {
        color: #67e8f9;
      }

      .btn-arrow {
        font-size: 12px;
      }

      .hero-features {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
        margin-top: 24px;
      }

      .hero-feature {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #cbd5e1;
        font-size: 12px;
        font-weight: 700;
      }

      .feature-check {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
        font-size: 10px;
      }

      /* =====================================================
         HERO VISUAL
      ===================================================== */

      .hero-visual {
        position: relative;
        min-height: 560px;
        display: grid;
        place-items: center;
      }

      .visual-orbit {
        position: absolute;
        border: 1px solid rgba(96, 165, 250, 0.18);
        border-radius: 50%;
        transform: rotate(-15deg);
      }

      .orbit-1 {
        width: 500px;
        height: 260px;
      }

      .orbit-2 {
        width: 360px;
        height: 500px;
        transform: rotate(35deg);
      }

      .float-card {
        position: absolute;
        z-index: 4;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(15, 23, 42, 0.74);
        backdrop-filter: blur(18px);
        box-shadow:
          0 25px 50px rgba(0, 0, 0, 0.25);
        color: #fff;
      }

      .card-1 {
        width: 245px;
        padding: 15px;
        top: 30px;
        right: 10px;
        border-radius: 17px;
        animation: floatOne 5s ease-in-out infinite;
      }

      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .language-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        font-size: 18px;
      }

      .python {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
      }

      .window-dots {
        display: flex;
        gap: 5px;
      }

      .window-dots span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #64748b;
      }

      .code-box {
        margin-top: 12px;
        padding: 12px;
        border-radius: 12px;
        background: rgba(2, 6, 23, 0.7);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        direction: ltr;
        text-align: left;
      }

      .code-purple {
        color: #c084fc;
      }

      .code-white {
        color: #e2e8f0;
      }

      .code-green {
        color: #86efac;
      }

      .code-comment {
        margin-top: 7px;
        color: #64748b;
      }

      .code-output {
        margin-top: 9px;
        padding-top: 8px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        color: #67e8f9;
      }

      .card-2,
      .card-3,
      .card-4,
      .card-5,
      .card-6 {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 13px;
        border-radius: 14px;
        min-width: 145px;
      }

      .card-2 {
        top: 150px;
        left: 10px;
        animation: floatTwo 4.5s ease-in-out infinite;
      }

      .card-3 {
        bottom: 145px;
        right: 0;
        animation: floatThree 5.2s ease-in-out infinite;
      }

      .card-4 {
        bottom: 35px;
        left: 20px;
        animation: floatOne 4.8s ease-in-out infinite;
      }

      .card-5 {
        top: 350px;
        right: 25px;
        animation: floatTwo 5.5s ease-in-out infinite;
      }

      .card-6 {
        top: 70px;
        left: 75px;
        animation: floatThree 4.6s ease-in-out infinite;
      }

      .small-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        font-size: 17px;
      }

      .js-icon {
        color: #fde047;
        background: rgba(250, 204, 21, 0.12);
      }

      .terminal-icon {
        color: #67e8f9;
        background: rgba(34, 211, 238, 0.12);
      }

      .react-icon {
        color: #67e8f9;
        background: rgba(34, 211, 238, 0.12);
      }

      .docker-icon {
        color: #60a5fa;
        background: rgba(96, 165, 250, 0.12);
      }

      .float-card strong {
        display: block;
        font-size: 12px;
      }

      .float-card small {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 9px;
      }

      .status-icon {
        margin-inline-start: auto;
        color: #4ade80;
        font-size: 13px;
      }

      .progress-icon {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        color: #4ade80;
        background: rgba(34, 197, 94, 0.12);
        font-size: 12px;
      }

      /* =====================================================
         CENTER LOGO
      ===================================================== */

      .visual-center {
        position: relative;
        z-index: 5;
        width: 280px;
        height: 280px;
        display: grid;
        place-items: center;
        animation: logoFloat 5s ease-in-out infinite;
      }

      .center-ring {
        position: relative;
        width: 205px;
        height: 205px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background:
          radial-gradient(
            circle,
            rgba(37, 99, 235, 0.16),
            rgba(6, 182, 212, 0.04) 55%,
            transparent 72%
          );
        border: 1px solid rgba(96, 165, 250, 0.35);
        box-shadow:
          0 0 0 12px rgba(59, 130, 246, 0.025),
          0 0 45px rgba(37, 99, 235, 0.18),
          inset 0 0 45px rgba(6, 182, 212, 0.08);
        animation: logoPulse 3.5s ease-in-out infinite;
      }

      .center-logo {
        width: 122px;
        height: 122px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background:
          radial-gradient(
            circle at 35% 25%,
            rgba(96, 165, 250, 0.22),
            rgba(15, 23, 42, 0.97) 65%
          );
        border: 1px solid rgba(125, 211, 252, 0.28);
        box-shadow:
          0 0 35px rgba(37, 99, 235, 0.25),
          inset 0 0 25px rgba(6, 182, 212, 0.09);
        animation: logoTilt 6s ease-in-out infinite;
      }

      .logo-mark {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .logo-mark span {
        font-family: 'JetBrains Mono', monospace;
        font-size: 34px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -3px;
        background:
          linear-gradient(
            135deg,
            #60a5fa,
            #22d3ee,
            #a78bfa
          );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.25));
      }

      .logo-name {
        margin-top: 3px;
      }

      .logo-name strong {
        font-family: 'JetBrains Mono', monospace;
        font-size: 15px;
        color: #e2e8f0;
        letter-spacing: -1px;
      }

      .logo-status {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        color: #64748b;
        font-family: 'JetBrains Mono', monospace;
        font-size: 6px;
        letter-spacing: 1.5px;
      }

      .logo-status span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 9px rgba(34, 197, 94, 0.9);
        animation: onlinePulse 1.5s infinite;
      }

      .logo-orbit {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(96, 165, 250, 0.25);
        pointer-events: none;
      }

      .logo-orbit::after {
        content: '';
        position: absolute;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow:
          0 0 15px rgba(56, 189, 248, 0.9);
      }

      .logo-orbit-1 {
        width: 235px;
        height: 100px;
        transform: rotate(25deg);
        animation: orbitRotate 8s linear infinite;
      }

      .logo-orbit-1::after {
        top: -4px;
        left: 50%;
      }

      .logo-orbit-2 {
        width: 100px;
        height: 235px;
        transform: rotate(-35deg);
        animation: orbitRotateReverse 10s linear infinite;
      }

      .logo-orbit-2::after {
        top: 50%;
        right: -4px;
      }

      .logo-energy {
        position: absolute;
        width: 170px;
        height: 170px;
        border-radius: 50%;
        border: 1px solid rgba(34, 211, 238, 0.1);
        filter: blur(0.2px);
        animation: energyPulse 3s ease-in-out infinite;
      }

      .energy-2 {
        width: 250px;
        height: 250px;
        border-color: rgba(59, 130, 246, 0.07);
        animation-delay: 1.2s;
      }

      /* =====================================================
         HERO SCROLL
      ===================================================== */

      .hero-scroll {
        position: absolute;
        z-index: 5;
        bottom: 22px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        color: #94a3b8;
        font-size: 10px;
        animation: scrollBounce 2s infinite;
      }

      .hero-scroll i {
        color: #38bdf8;
      }

      /* =====================================================
         TICKER
      ===================================================== */

      .tech-ticker {
        position: relative;
        overflow: hidden;
        background: var(--bg2);
        border-bottom: 1px solid var(--border);
        border-top: 1px solid var(--border);
        direction: ltr;
      }

      .ticker-track {
        width: max-content;
        display: flex;
        align-items: center;
        gap: 42px;
        padding: 17px 0;
        animation: ticker 32s linear infinite;
      }

      .tech-item {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
      }

      .tech-item i {
        color: var(--primary);
        font-size: 16px;
      }

      .ticker-fade {
        position: absolute;
        z-index: 2;
        top: 0;
        bottom: 0;
        width: 100px;
        pointer-events: none;
      }

      .ticker-fade-right {
        right: 0;
        background: linear-gradient(
          90deg,
          transparent,
          var(--bg2)
        );
      }

      .ticker-fade-left {
        left: 0;
        background: linear-gradient(
          270deg,
          transparent,
          var(--bg2)
        );
      }

      /* =====================================================
         STATS
      ===================================================== */

      .stats {
        padding: 40px 0;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
      }

      .stats-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 25px;
      }

      .stat-item {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
      }

      .stat-icon-wrap {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: rgba(37, 99, 235, 0.09);
        color: var(--primary);
      }

      .stat-num {
        display: inline-block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 25px;
        font-weight: 800;
        color: var(--text);
      }

      .stat-label {
        display: block;
        margin-top: 2px;
        color: var(--text-muted);
        font-size: 11px;
      }

      .stat-divider {
        width: 1px;
        height: 42px;
        background: var(--border);
      }

      /* =====================================================
         SECTION HEADING
      ===================================================== */

      .section-heading {
        max-width: 700px;
        margin: 0 auto 42px;
        text-align: center;
      }

      .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 10px;
      }

      .section-heading h2 {
        margin: 0;
        color: var(--text);
        font-size: clamp(30px, 4vw, 46px);
        font-weight: 900;
        line-height: 1.25;
      }

      .section-heading h2 span {
        color: var(--primary);
      }

      .section-heading p {
        margin: 12px auto 0;
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.9;
      }

      /* =====================================================
         TRACKS
      ===================================================== */

      .tracks {
        padding: 95px 0;
        background: var(--bg2);
      }

      .tracks-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
      }

      .track {
        overflow: hidden;
        color: inherit;
        text-decoration: none;
        border: 1px solid var(--border);
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        transition:
          transform 0.3s ease,
          border-color 0.3s ease;
      }

      .track:hover {
        transform: translateY(-7px);
        border-color: rgba(37, 99, 235, 0.28);
      }

      .track-img {
        position: relative;
        height: 215px;
        overflow: hidden;
      }

      .track-img img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.6s ease;
      }

      .track:hover .track-img img {
        transform: scale(1.06);
      }

      .track-img-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            180deg,
            transparent 30%,
            rgba(2, 6, 23, 0.85)
          );
      }

      .track-number {
        position: absolute;
        bottom: 14px;
        right: 17px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        opacity: 0.8;
      }

      .track-body {
        position: relative;
        padding: 23px;
      }

      .track-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
        margin-bottom: 15px;
      }

      .track-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
      }

      .track-title-row h3 {
        margin: 0;
        font-size: 19px;
        color: var(--text);
      }

      .track-arrow {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        color: var(--primary);
        background: var(--bg2);
        transition: transform 0.25s ease;
      }

      .track:hover .track-arrow {
        transform: translateX(-4px);
      }

      .track-body p {
        margin: 10px 0 14px;
        color: var(--text-muted);
        font-size: 13px;
        line-height: 1.9;
      }

      .track-list {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .track-list li {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
      }

      .track-list i {
        color: #22c55e;
        font-size: 9px;
      }

      /* =====================================================
         FEATURES
      ===================================================== */

      .features {
        padding: 95px 0;
        background: var(--bg);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
      }

      .feature-box {
        position: relative;
        overflow: hidden;
        padding: 28px 22px;
        border: 1px solid var(--border);
        background: var(--card);
        border-radius: 20px;
        transition:
          transform 0.3s ease,
          border-color 0.3s ease;
      }

      .feature-box:hover {
        transform: translateY(-6px);
        border-color: rgba(37, 99, 235, 0.25);
      }

      .feature-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
        margin-bottom: 18px;
      }

      .feature-box h3 {
        margin: 0;
        color: var(--text);
        font-size: 17px;
      }

      .feature-box p {
        margin: 9px 0 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.9;
      }

      .feature-number {
        position: absolute;
        left: 15px;
        bottom: 8px;
        color: var(--text);
        opacity: 0.045;
        font-family: 'JetBrains Mono', monospace;
        font-size: 65px;
        font-weight: 900;
      }

      /* =====================================================
         FAQ
      ===================================================== */

      .faq {
        padding: 95px 0;
        background: var(--bg2);
      }

      .faq-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .faq-item {
        display: flex;
        gap: 16px;
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease;
      }

      .faq-item:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, 0.25);
      }

      .faq-icon {
        flex: 0 0 auto;
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
      }

      .faq-item h3 {
        margin: 0;
        color: var(--text);
        font-size: 15px;
      }

      .faq-item p {
        margin: 7px 0 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* =====================================================
         FINAL CTA
      ===================================================== */

      .final-cta {
        position: relative;
        padding: 80px 0;
        overflow: hidden;
        background: var(--bg);
      }

      .cta-glow {
        position: absolute;
        width: 400px;
        height: 400px;
        right: 50%;
        top: 50%;
        transform: translate(50%, -50%);
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.08);
        filter: blur(70px);
        pointer-events: none;
      }

      .cta-box {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
        padding: 55px;
        border: 1px solid var(--border);
        border-radius: 28px;
        background:
          linear-gradient(
            135deg,
            rgba(37, 99, 235, 0.08),
            rgba(6, 182, 212, 0.04)
          ),
          var(--card);
        box-shadow: var(--shadow);
      }

      .cta-content {
        position: relative;
        z-index: 2;
      }

      .cta-content h2 {
        margin: 0;
        color: var(--text);
        font-size: clamp(28px, 4vw, 45px);
        line-height: 1.3;
      }

      .cta-content h2 span {
        color: var(--primary);
      }

      .cta-content p {
        margin: 12px 0 22px;
        color: var(--text-muted);
        font-size: 14px;
      }

      .cta-button {
        min-width: 220px;
      }

      .cta-decoration {
        position: relative;
        width: 250px;
        height: 180px;
        display: grid;
        place-items: center;
      }

      .cta-code {
        direction: ltr;
        font-family: 'JetBrains Mono', monospace;
        font-size: 40px;
        font-weight: 700;
        opacity: 0.14;
      }

      .cta-code span {
        color: var(--cyan);
      }

      .cta-code strong {
        color: var(--primary);
      }

      /* =====================================================
         SCROLL TOP
      ===================================================== */

      .scroll-top {
        position: fixed;
        z-index: 100;
        left: 20px;
        bottom: 20px;
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 13px;
        color: #fff;
        background: var(--primary);
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3);
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(15px);
        transition:
          opacity 0.25s ease,
          visibility 0.25s ease,
          transform 0.25s ease;
      }

      .scroll-top.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      /* =====================================================
         REVEAL ANIMATION
      ===================================================== */

      .track,
      .feature-box,
      .faq-item,
      .stat-item {
        opacity: 0;
        transform: translateY(25px);
        transition:
          opacity 0.7s ease,
          transform 0.7s ease,
          border-color 0.3s ease;
      }

      .track.visible,
      .feature-box.visible,
      .faq-item.visible,
      .stat-item.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* =====================================================
         ANIMATIONS
      ===================================================== */

      @keyframes blink {
        0%,
        45% {
          opacity: 1;
        }

        46%,
        100% {
          opacity: 0;
        }
      }

      @keyframes floatOne {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(-9px);
        }
      }

      @keyframes floatTwo {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }

        50% {
          transform: translateY(-8px) rotate(1deg);
        }
      }

      @keyframes floatThree {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(8px);
        }
      }

      @keyframes logoFloat {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(-8px);
        }
      }

      @keyframes logoPulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow:
            0 0 0 12px rgba(59, 130, 246, 0.025),
            0 0 45px rgba(37, 99, 235, 0.18),
            inset 0 0 45px rgba(6, 182, 212, 0.08);
        }

        50% {
          transform: scale(1.025);
          box-shadow:
            0 0 0 20px rgba(59, 130, 246, 0.02),
            0 0 65px rgba(37, 99, 235, 0.27),
            inset 0 0 55px rgba(6, 182, 212, 0.12);
        }
      }

      @keyframes logoTilt {
        0%,
        100% {
          transform: rotate(0deg);
        }

        50% {
          transform: rotate(2deg);
        }
      }

      @keyframes orbitRotate {
        from {
          transform: rotate(25deg);
        }

        to {
          transform: rotate(385deg);
        }
      }

      @keyframes orbitRotateReverse {
        from {
          transform: rotate(-35deg);
        }

        to {
          transform: rotate(-395deg);
        }
      }

      @keyframes energyPulse {
        0%,
        100% {
          opacity: 0.25;
          transform: scale(0.9);
        }

        50% {
          opacity: 0.65;
          transform: scale(1.05);
        }
      }

      @keyframes onlinePulse {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }

        50% {
          opacity: 0.4;
          transform: scale(0.75);
        }
      }

      @keyframes scrollBounce {
        0%,
        100% {
          transform: translate(-50%, 0);
        }

        50% {
          transform: translate(-50%, 7px);
        }
      }

      @keyframes ticker {
        from {
          transform: translateX(0);
        }

        to {
          transform: translateX(-50%);
        }
      }

