---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | نحو التميز التقني</title>
  <meta name="description" content="منصة عربية رائدة في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني. محتوى تقني معمق يواكب أحدث الابتكارات العالمية." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section مع تأثيرات متقدمة -->
    <section class="hero hero-animated reveal">
      <div class="hero-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
      </div>
      
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI Technology" loading="eager" />
        <div class="overlay gradient-overlay"></div>
      </div>
      
      <div class="container hero-content">
        <div class="hero-badge-wrapper reveal-delay-1">
          <span class="hero-badge pulse">
            <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            نحو المستقبل الرقمي
          </span>
          <span class="badge-glow"></span>
        </div>
        
        <h1 class="reveal-delay-2">
          <span class="title-line">اكتشف آفاق</span>
          <span class="title-line highlight typing-text">الذكاء الاصطناعي والابتكار</span>
        </h1>
        
        <p class="hero-desc fade-in-up reveal-delay-3">
          منصة عربية رائدة تُقدّم محتوى تقنياً معمقاً في مجالات الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني — مصممة لتمكين المطورين والمبتكرين من بناء الغد.
        </p>
        
        <div class="hero-cta reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary btn-glow">
            <span>استكشف الأدلة الشاملة</span>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/Th-tech/articles/" class="btn btn-outline btn-white">
            <span>تصفح المقالات</span>
          </a>
        </div>

        <!-- Stats Inline -->
        <div class="hero-stats reveal-delay-4">
          <div class="hero-stat">
            <span class="stat-number counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="hero-stat">
            <span class="stat-number counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="hero-stat">
            <span class="stat-number counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="scroll-indicator">
        <div class="mouse">
          <div class="wheel"></div>
        </div>
        <span>مرر للأسفل</span>
      </div>
    </section>

    <!-- 🔹 Rotating Features مع تأثيرات 3D -->
    <section class="rotating-features reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">مسارات التعلّم المتقدمة</h2>
          <p class="section-subtitle">اختر مسارك وابدأ رحلتك الاحترافية</p>
        </div>
        
        <div class="rotating-cards-3d" id="rotatingCards">
          <!-- Card 1 -->
          <div class="feature-card-3d active">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <div class="icon-bg"></div>
                  <span class="card-icon">🤖</span>
                </div>
                <h3>الذكاء الاصطناعي التوليدي</h3>
                <p>استكشف نماذج اللغة الكبيرة (LLMs)، التعلم العميق، وتطبيقات الذكاء الاصطناعي التوليدي في المشاريع الواقعية.</p>
                <ul class="feature-list">
                  <li>✓ تعلم الآلة المتقدم</li>
                  <li>✓ الشبكات العصبية العميقة</li>
                  <li>✓ معالجة اللغة الطبيعية</li>
                </ul>
                <a href="/Th-tech/ai/" class="card-cta">
                  اكتشف المسار
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
                <div class="image-overlay"></div>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <div class="icon-bg"></div>
                  <span class="card-icon">🔒</span>
                </div>
                <h3>الأمن السيبراني المتقدم</h3>
                <p>تقنيات الحماية الاستباقية، التحليل الجنائي الرقمي، واستراتيجيات الدفاع السيبراني في البيئات المعقدة.</p>
                <ul class="feature-list">
                  <li>✓ الاختراق الأخلاقي</li>
                  <li>✓ تحليل الثغرات الأمنية</li>
                  <li>✓ استراتيجيات الدفاع</li>
                </ul>
                <a href="/Th-tech/security/" class="card-cta">
                  اكتشف المسار
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
                <div class="image-overlay"></div>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <div class="icon-bg"></div>
                  <span class="card-icon">☁️</span>
                </div>
                <h3>الحوسبة السحابية والبنية التحتية</h3>
                <p>نشر وإدارة التطبيقات على AWS، Azure، وGoogle Cloud مع أفضل ممارسات DevOps والبنية التحتية ككود.</p>
                <ul class="feature-list">
                  <li>✓ AWS و Azure و GCP</li>
                  <li>✓ البنية التحتية ككود</li>
                  <li>✓ DevOps و CI/CD</li>
                </ul>
                <a href="/Th-tech/cloud/" class="card-cta">
                  اكتشف المسار
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" />
                <div class="image-overlay"></div>
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <div class="icon-bg"></div>
                  <span class="card-icon">⚡</span>
                </div>
                <h3>هندسة البرمجيات الحديثة</h3>
                <p>منهجيات التطوير الرشيقة، الأنماط المعمارية المتقدمة، وبناء أنظمة قابلة للتوسع والصيانة.</p>
                <ul class="feature-list">
                  <li>✓ الأنماط المعمارية</li>
                  <li>✓ التطوير الرشيقة</li>
                  <li>✓ الأنظمة القابلة للتوسع</li>
                </ul>
                <a href="/Th-tech/programming/" class="card-cta">
                  اكتشف المسار
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" loading="lazy" />
                <div class="image-overlay"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="cards-navigation">
          <button class="nav-btn prev-btn" aria-label="السابق">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <div class="cards-dots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
            <span class="dot" data-index="3"></span>
          </div>
          <button class="nav-btn next-btn" aria-label="التالي">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- 🔹 Topics Grid مع تأثيرات Hover متقدمة -->
    <section class="topics-grid-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">المجالات التقنية</h2>
          <p class="section-subtitle">استكشف مجالات التكنولوجيا الحديثة</p>
        </div>
        
        <div class="topics-grid-advanced">
          <a href="/Th-tech/ai/" class="topic-card-advanced reveal-delay-1">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">🧠</div>
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة، الشبكات العصبية، وتطبيقات الـ AI</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/programming/" class="topic-card-advanced reveal-delay-2">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">💻</div>
              <h3>البرمجة</h3>
              <p>لغات البرمجة، الأطر الحديثة، وهندسة البرمجيات</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/security/" class="topic-card-advanced reveal-delay-3">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">️</div>
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات، الاختراق الأخلاقي، والدفاع الرقمي</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card-advanced reveal-delay-4">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">☁️</div>
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، وGoogle Cloud</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!--  Latest Articles مع تأثيرات دخول -->
    <section class="articles-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">أحدث المقالات</h2>
          <p class="section-subtitle">محتوى محدّث باستمرار لمواكبة التطورات</p>
        </div>
        
        <div class="articles-grid-advanced">
          <article class="article-card-advanced reveal-delay-1">
            <div class="article-badge-new">جديد</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="Article" loading="lazy" />
              <div class="article-overlay"></div>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">ذكاء اصطناعي</span>
                <span class="article-date">5 دقائق قراءة</span>
              </div>
              <h3>دليلك الشامل لتعلم الآلة في 2026</h3>
              <p>رحلة عملية من الصفر إلى الاحتراف في تعلم الآلة مع أمثلة تطبيقية ومشاريع واقعية.</p>
              <a href="/Th-tech/ai/" class="article-link">
                اقرأ المقال
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <article class="article-card-advanced reveal-delay-2">
            <div class="article-badge-popular">شائع</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Article" loading="lazy" />
              <div class="article-overlay"></div>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">سحابة</span>
                <span class="article-date">8 دقائق قراءة</span>
              </div>
              <h3>أمن السحابة: أفضل الممارسات</h3>
              <p>استراتيجيات حماية متقدمة لتطبيقاتك السحابية على AWS و Azure مع أمثلة عملية.</p>
              <a href="/Th-tech/cloud/" class="article-link">
                اقرأ المقال
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <article class="article-card-advanced reveal-delay-3">
            <div class="article-badge-updated">محدّث</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Article" loading="lazy" />
              <div class="article-overlay"></div>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">برمجة</span>
                <span class="article-date">6 دقائق قراءة</span>
              </div>
              <h3>البرمجة الكائنية: مفاهيم متقدمة</h3>
              <p>تعمّق في مبادئ SOLID والأنماط التصميمية الاحترافية لبناء أنظمة قابلة للصيانة.</p>
              <a href="/Th-tech/programming/" class="article-link">
                اقرأ المقال
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 Why Choose Us مع أرقام متحركة -->
    <section class="why-section reveal">
      <div class="container">
        <div class="why-grid">
          <div class="why-content reveal-delay-1">
            <h2 class="section-title text-right">لماذا Th.Tech؟</h2>
            <p class="why-desc">منصة عربية رائدة تُقدّم محتوى تقنياً معمقاً يُواكب أحدث الابتكارات العالمية، مع التركيز على التطبيق العملي والمسار الواضح من الأساسيات إلى الاحتراف.</p>
            
            <div class="why-features">
              <div class="why-feature">
                <div class="why-icon">⚡</div>
                <div class="why-text">
                  <h4>محتوى تطبيقي</h4>
                  <p>شروحات عملية مع أمثلة واقعية قابلة للتطبيق الفوري</p>
                </div>
              </div>
              
              <div class="why-feature">
                <div class="why-icon">🔄</div>
                <div class="why-text">
                  <h4>تحديث مستمر</h4>
                  <p>محتوى يُحدَّث أسبوعياً بأحدث التقنيات والاتجاهات العالمية</p>
                </div>
              </div>
              
              <div class="why-feature">
                <div class="why-icon">🎯</div>
                <div class="why-text">
                  <h4>مسار تعلم واضح</h4>
                  <p>من الأساسيات إلى الاحتراف مع مسارات تعلم منظمة</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="why-stats reveal-delay-2">
            <div class="stat-card">
              <div class="stat-icon"></div>
              <div class="stat-value counter" data-target="150" data-suffix="+">0</div>
              <div class="stat-label">دليل شامل</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">👥</div>
              <div class="stat-value counter" data-target="50" data-suffix="K+">0</div>
              <div class="stat-label">قارئ شهرياً</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon"></div>
              <div class="stat-value counter" data-target="100" data-suffix="%">0</div>
              <div class="stat-label">محتوى مجاني</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Newsletter مع تأثيرات -->
    <section class="newsletter-section reveal">
      <div class="container">
        <div class="newsletter-box">
          <div class="newsletter-bg"></div>
          <div class="newsletter-content">
            <div class="newsletter-icon">📬</div>
            <h2>اشترك في نشرتنا البريدية</h2>
            <p>احصل على أحدث المقالات والشروحات مباشرة في بريدك الإلكتروني</p>
            <form class="newsletter-form">
              <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
              <button type="submit" class="btn btn-primary btn-glow">
                <span>اشترك الآن</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              </button>
            </form>
            <p class="newsletter-note"> نحمي خصوصيتك. لا رسائل مزعجة.</p>
          </div>
        </div>
      </div>
    </section>

    <!--  CTA Section -->
    <section class="cta-section reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-bg"></div>
          <div class="cta-content">
            <h2>🚀 ابدأ رحلتك التقنية اليوم</h2>
            <p>انضم إلى مجتمع المطورين والمبتكرين الذين يبنون مستقبل التكنولوجيا</p>
            <a href="/Th-tech/guides/" class="btn btn-light btn-large">
              <span>تصفح الأدلة الشاملة</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.15);
    --radius: 16px;
    --shadow: 0 10px 40px rgba(0,0,0,0.1);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --primary-dark: #0284c7;
    --primary-light: #7dd3fc;
    --border: rgba(56,189,248,0.15);
    --shadow: 0 10px 40px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  html { 
    scroll-behavior: smooth; 
    scroll-padding-top: 80px;
  }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 0 1.5rem; 
  }

  /* ===== Hero Section مع تأثيرات متقدمة ===== */
  .hero {
    position: relative;
    min-height: 95vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.5);
    border-radius: 50%;
    animation: float 15s infinite;
  }

  .particle:nth-child(1) { left: 20%; top: 30%; animation-delay: 0s; }
  .particle:nth-child(2) { left: 60%; top: 50%; animation-delay: 2s; }
  .particle:nth-child(3) { left: 40%; top: 70%; animation-delay: 4s; }
  .particle:nth-child(4) { left: 80%; top: 20%; animation-delay: 6s; }
  .particle:nth-child(5) { left: 10%; top: 60%; animation-delay: 8s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-100px) translateX(50px); opacity: 0; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.3);
  }

  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2,132,199,0.4) 0%, rgba(14,165,233,0.4) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 2rem;
    max-width: 900px;
  }

  .hero-badge-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid rgba(255,255,255,0.3);
    position: relative;
    z-index: 1;
  }

  .badge-icon { width: 16px; height: 16px; }

  .pulse {
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .badge-glow {
    position: absolute;
    inset: -5px;
    background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);
    border-radius: 50px;
    animation: glow 2s infinite;
    z-index: 0;
  }

  @keyframes glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .title-line {
    display: block;
  }

  .title-line.highlight {
    background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .typing-text {
    display: inline-block;
    border-right: 3px solid white;
    white-space: nowrap;
    overflow: hidden;
    animation: typing 3s steps(30, end), blink 0.75s step-end infinite;
  }

  @keyframes typing { from { width: 0; } to { width: 100%; } }
  @keyframes blink { 50% { border-color: transparent; } }

  @media (max-width: 768px) {
    .typing-text {
      animation: none;
      border: none;
      white-space: normal;
    }
  }

  .hero-desc {
    font-size: 1.1rem;
    opacity: 0.95;
    max-width: 700px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .fade-in-up {
    animation: fadeInUp 0.8s ease;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
    position: relative;
    overflow: hidden;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 15px rgba(2,132,199,0.4);
  }

  .btn-glow::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.5s;
  }

  .btn-glow:hover::before {
    left: 100%;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(2,132,199,0.5);
  }

  .btn-outline {
    background: transparent;
    border: 2px solid white;
    color: white;
  }

  .btn-white {
    border-color: white;
    color: white;
  }

  .btn-outline:hover, .btn-white:hover {
    background: white;
    color: var(--text);
    transform: translateY(-3px);
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s;
  }

  .btn:hover .btn-icon {
    transform: translateX(5px);
  }

  /* Hero Stats */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 600px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.2);
  }

  .hero-stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .stat-label {
    font-size: 0.9rem;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .stat-number { font-size: 2rem; }
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: white;
    opacity: 0.7;
    animation: bounce 2s infinite;
  }

  .mouse {
    width: 26px;
    height: 40px;
    border: 2px solid white;
    border-radius: 20px;
    position: relative;
  }

  .wheel {
    width: 4px;
    height: 8px;
    background: white;
    border-radius: 2px;
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll 2s infinite;
  }

  @keyframes scroll {
    0% { opacity: 1; transform: translateX(-50%) translateY(0); }
    100% { opacity: 0; transform: translateX(-50%) translateY(15px); }
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  /* ===== Section Headers ===== */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 0.8rem;
    color: var(--text);
    font-weight: 700;
  }

  .section-subtitle {
    color: var(--text-sec);
    font-size: 1.05rem;
  }

  .text-right {
    text-align: right;
  }

  /* ===== Rotating Features 3D ===== */
  .rotating-features {
    padding: 5rem 0;
    background: var(--bg);
  }

  .rotating-cards-3d {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    min-height: 450px;
    perspective: 1000px;
  }

  .feature-card-3d {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    transform: rotateY(90deg) translateX(100px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .feature-card-3d.active {
    opacity: 1;
    transform: rotateY(0) translateX(0);
    pointer-events: all;
    z-index: 10;
  }

  .card-3d-inner {
    background: var(--card);
    border-radius: var(--radius);
    padding: 2.5rem;
    display: flex;
    gap: 2.5rem;
    align-items: center;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    transform-style: preserve-3d;
  }

  .card-3d-content {
    flex: 1;
  }

  .card-icon-wrapper {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 1.5rem;
  }

  .icon-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border-radius: 20px;
    transform: rotate(6deg);
    opacity: 0.2;
  }

  .card-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border-radius: 20px;
  }

  .card-3d-content h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .card-3d-content p {
    color: var(--text-sec);
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  .feature-list {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .feature-list li {
    padding: 0.4rem 0;
    color: var(--text-sec);
    font-size: 0.95rem;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    transition: gap 0.3s;
  }

  .card-cta svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s;
  }

  .card-cta:hover svg {
    transform: translateX(5px);
  }

  .card-3d-image {
    width: 350px;
    height: 280px;
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .card-3d-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .feature-card-3d:hover .card-3d-image img {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2,132,199,0.2), transparent);
  }

  .cards-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .nav-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--border);
    color: var(--primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }

  .nav-btn:hover {
    background: var(--primary);
    color: white;
    transform: scale(1.1);
    border-color: var(--primary);
  }

  .nav-btn svg {
    width: 24px;
    height: 24px;
  }

  .cards-dots {
    display: flex;
    gap: 0.8rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.3s;
  }

  .dot.active {
    background: var(--primary);
    width: 40px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .card-3d-inner {
      flex-direction: column;
      padding: 1.5rem;
    }
    .card-3d-image {
      width: 100%;
      height: 220px;
    }
    .rotating-cards-3d { min-height: 650px; }
  }

  /* ===== Topics Grid Advanced ===== */
  .topics-grid-section {
    padding: 5rem 0;
    background: var(--card);
  }

  .topics-grid-advanced {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .topic-card-advanced {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    min-height: 280px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .topic-card-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2,132,199,0.1), rgba(14,165,233,0.1));
    opacity: 0;
    transition: opacity 0.4s;
  }

  .topic-card-advanced:hover .topic-card-bg {
    opacity: 1;
  }

  .topic-card-content {
    position: relative;
    z-index: 1;
    padding: 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .topic-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    transition: transform 0.3s;
  }

  .topic-card-advanced:hover .topic-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .topic-card-content h3 {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }

  .topic-card-content p {
    color: var(--text-sec);
    font-size: 0.95rem;
    flex: 1;
  }

  .topic-arrow {
    color: var(--primary);
    font-size: 1.5rem;
    font-weight: bold;
    transition: transform 0.3s;
    align-self: flex-start;
    margin-top: 1rem;
  }

  .topic-card-advanced:hover .topic-arrow {
    transform: translateX(8px);
  }

  @media (max-width: 768px) {
    .topics-grid-advanced { grid-template-columns: 1fr; }
  }

  /* ===== Articles Section Advanced ===== */
  .articles-section {
    padding: 5rem 0;
    background: var(--bg);
  }

  .articles-grid-advanced {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .article-card-advanced {
    background: var(--card);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.4s;
    position: relative;
  }

  .article-card-advanced:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .article-badge-new,
  .article-badge-popular,
  .article-badge-updated {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 10;
  }

  .article-badge-new {
    background: #10b981;
    color: white;
  }

  .article-badge-popular {
    background: #f59e0b;
    color: white;
  }

  .article-badge-updated {
    background: #3b82f6;
    color: white;
  }

  .article-image {
    height: 200px;
    overflow: hidden;
    position: relative;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .article-card-advanced:hover .article-image img {
    transform: scale(1.1);
  }

  .article-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2,132,199,0.3), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .article-card-advanced:hover .article-overlay {
    opacity: 1;
  }

  .article-content {
    padding: 1.5rem;
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.8rem;
    font-size: 0.85rem;
  }

  .article-category {
    color: var(--primary);
    font-weight: 600;
  }

  .article-date {
    color: var(--text-sec);
  }

  .article-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  .article-content p {
    color: var(--text-sec);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    transition: gap 0.3s;
  }

  .article-link svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s;
  }

  .article-link:hover svg {
    transform: translateX(5px);
  }

  @media (max-width: 1024px) {
    .articles-grid-advanced { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .articles-grid-advanced { grid-template-columns: 1fr; }
  }

  /* ===== Why Section ===== */
  .why-section {
    padding: 5rem 0;
    background: var(--card);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .why-desc {
    color: var(--text-sec);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .why-features {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .why-feature {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .why-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .why-text h4 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
    color: var(--text);
  }

  .why-text p {
    color: var(--text-sec);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .why-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .stat-card {
    background: var(--bg);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid var(--border);
    transition: all 0.3s;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }

  .stat-icon {
    font-size: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .stat-label {
    color: var(--text-sec);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; gap: 3rem; }
    .text-right { text-align: center; }
  }

  /* ===== Newsletter Section ===== */
  .newsletter-section {
    padding: 5rem 0;
    background: var(--bg);
  }

  .newsletter-box {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .newsletter-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  }

  .newsletter-content {
    position: relative;
    z-index: 1;
    padding: 3rem 2rem;
    text-align: center;
    color: white;
  }

  .newsletter-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .newsletter-content h2 {
    font-size: 1.8rem;
    margin-bottom: 0.6rem;
  }

  .newsletter-content p {
    opacity: 0.95;
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .newsletter-form {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 250px;
    padding: 0.9rem 1.2rem;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-family: inherit;
    background: rgba(255,255,255,0.95);
  }

  .newsletter-form input:focus {
    outline: 3px solid rgba(255,255,255,0.5);
  }

  .newsletter-note {
    font-size: 0.85rem;
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .newsletter-form { flex-direction: column; }
    .newsletter-form input { width: 100%; }
  }

  /* ===== CTA Section ===== */
  .cta-section {
    padding: 4rem 1.5rem;
  }

  .cta-box {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  }

  .cta-content {
    position: relative;
    z-index: 1;
    padding: 3rem 2rem;
    text-align: center;
    color: white;
  }

  .cta-content h2 {
    font-size: 2rem;
    margin-bottom: 0.6rem;
  }

  .cta-content p {
    opacity: 0.95;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  /* ===== Scroll Animations ===== */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  @media (max-width: 768px) {
    .hero { min-height: 85vh; }
    .hero h1 { font-size: 1.8rem; }
    .hero-desc { font-size: 1rem; }
    .section-title { font-size: 1.5rem; }
    .hero-stats { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Scroll Reveal
  function initScrollReveal() {
    const reveals = document.querySelectorAll('.reveal, .reveal-delay-1, .reveal-delay-2, .reveal-delay-3, .reveal-delay-4');
    const revealOnScroll = () => {
      const windowHeight = window.innerHeight;
      const elementVisible = 100;
      reveals.forEach((reveal) => {
        const elementTop = reveal.getBoundingClientRect().top;
        if (elementTop < windowHeight - elementVisible) {
          reveal.classList.add('active');
        }
      });
    };
    window.addEventListener('scroll', revealOnScroll);
    revealOnScroll();
  }

  // Counter Animation
  function initCounterAnimation() {
    const counters = document.querySelectorAll('.counter');
    const animateCounter = (element, target, duration = 2000) => {
      let start = 0;
      const increment = target / (duration / 16);
      const updateCounter = () => {
        start += increment;
        if (start < target) {
          element.textContent = Math.floor(start) + (element.dataset.suffix || '');
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = target + (element.dataset.suffix || '');
        }
      };
      updateCounter();
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = parseInt(entry.target.dataset.target);
          animateCounter(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    counters.forEach(counter => {
      if (counter.dataset.target) observer.observe(counter);
    });
  }

  // Typing Effect
  function initTypingEffect() {
    const typingElements = document.querySelectorAll('.typing-text');
    typingElements.forEach((element) => {
      const originalText = element.textContent;
      element.textContent = '';
      element.style.animation = 'none';
      let i = 0;
      const typeWriter = () => {
        if (i < originalText.length) {
          element.textContent += originalText.charAt(i);
          i++;
          setTimeout(typeWriter, 50);
        } else {
          element.style.borderRight = 'none';
        }
      };
      setTimeout(typeWriter, 500);
    });
  }

  // Auto-Rotating Cards 3D
  function initRotatingCards() {
    const cards = document.querySelectorAll('.feature-card-3d');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');
    let currentIndex = 0;
    const totalCards = cards.length;
    const intervalTime = 6000;

    function showCard(index) {
      cards.forEach((card, i) => {
        card.classList.remove('active');
        dots[i].classList.remove('active');
      });
      cards[index].classList.add('active');
      dots[index].classList.add('active');
    }

    function nextCard() {
      currentIndex = (currentIndex + 1) % totalCards;
      showCard(currentIndex);
    }

    function prevCard() {
      currentIndex = (currentIndex - 1 + totalCards) % totalCards;
      showCard(currentIndex);
    }

    let interval = setInterval(nextCard, intervalTime);

    // Navigation buttons
    if (nextBtn) nextBtn.addEventListener('click', () => {
      nextCard();
      clearInterval(interval);
      interval = setInterval(nextCard, intervalTime);
    });

    if (prevBtn) prevBtn.addEventListener('click', () => {
      prevCard();
      clearInterval(interval);
      interval = setInterval(nextCard, intervalTime);
    });

    // Dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        showCard(currentIndex);
        clearInterval(interval);
        interval = setInterval(nextCard, intervalTime);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initScrollReveal();
    initCounterAnimation();
    initTypingEffect();
    initRotatingCards();
  });
</script>
