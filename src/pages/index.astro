---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | نحو عصر الذكاء الرقمي</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني. محتوى تقني معمق يواكب أحدث الابتكارات العالمية." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!--  Hero Section - صياغة ملهمة -->
    <section class="hero hero-animated reveal">
      <div class="hero-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
      </div>
      
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI Technology" loading="eager" />
        <div class="overlay gradient-overlay"></div>
      </div>
      
      <div class="container hero-content">
        <div class="hero-badge-wrapper reveal-delay-1">
          <span class="hero-badge pulse">
            <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            نحو عصر الذكاء الرقمي
          </span>
        </div>
        
        <h1 class="reveal-delay-2">
          <span class="title-line">صُغ مستقبلك الرقمي</span>
          <span class="title-line highlight typing-text">بأدوات التقنية الحديثة</span>
        </h1>
        
        <p class="hero-desc fade-in-up reveal-delay-3">
          منصة عربية رائدة تُترجم التعقيد التقني إلى حلول عملية. هنا نُمكّن المطورين والمبتكرين من إتقان الذكاء الاصطناعي، البرمجة، والأمن السيبراني لبناء الغد.
        </p>
        
        <div class="hero-cta reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary btn-glow">
            <span>ابدأ رحلة الاحتراف</span>
          </a>
          <a href="/Th-tech/articles/" class="btn btn-outline btn-white">
            <span>استكشف المكتبة</span>
          </a>
        </div>

        <div class="hero-stats reveal-delay-4">
          <div class="hero-stat">
            <span class="stat-number counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="hero-stat">
            <span class="stat-number counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="hero-stat">
            <span class="stat-number counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>

      <div class="scroll-indicator">
        <div class="mouse"><div class="wheel"></div></div>
      </div>
    </section>

    <!--  Rotating Features - عناوين قوية وجذابة -->
    <section class="rotating-features reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">مسارات التميز التقني</h2>
          <p class="section-subtitle">اختر تخصصك وابدأ في صقل مهاراتك مع الخبراء</p>
        </div>
        
        <!-- Fixed Height Container -->
        <div class="rotating-cards-wrapper">
          <!-- Card 1 -->
          <div class="feature-card-3d active">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon">🤖</span>
                </div>
                <h3>الذكاء الاصطناعي: محركات المستقبل</h3>
                <p>لا تتعلم فقط كيف تعمل النماذج، بل تعلم كيف تبني حلولاً ذكية تُغير قواعد اللعبة في عالم الأعمال.</p>
                <ul class="feature-list">
                  <li>✅ هندسة النماذج الكبيرة (LLMs)</li>
                  <li>✅ تطبيقات الشبكات العصبية</li>
                </ul>
                <a href="/Th-tech/ai/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=500&h=350&fit=crop" alt="AI" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon"></span>
                </div>
                <h3>الأمن السيبراني: الحصن الرقمي</h3>
                <p>في عالم مليء بالتهديدات، كن أنت خط الدفاع الأول. تعلم كيف تحمي البيانات وتكشف الثغرات باحترافية.</p>
                <ul class="feature-list">
                  <li>✅ الاختراق الأخلاقي المتقدم</li>
                  <li>✅ استراتيجيات الحماية المؤسسية</li>
                </ul>
                <a href="/Th-tech/security/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=500&h=350&fit=crop" alt="Security" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon">☁️</span>
                </div>
                <h3>الحوسبة السحابية: بنية لا حدود لها</h3>
                <p>انقل مشاريعك من جهازك المحلي إلى السحابة العالمية. تعلم كيف تبني أنظمة قابلة للتوسع باستخدام AWS و Azure.</p>
                <ul class="feature-list">
                  <li>✅ البنية التحتية ككود (IaC)</li>
                  <li>✅ نشر الحاويات وإدارتها</li>
                </ul>
                <a href="/Th-tech/cloud/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=500&h=350&fit=crop" alt="Cloud" loading="lazy" />
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="cards-navigation">
          <button class="nav-btn prev-btn" aria-label="السابق">❮</button>
          <div class="cards-dots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
          </div>
          <button class="nav-btn next-btn" aria-label="التالي">❯</button>
        </div>
      </div>
    </section>

    <!--  Topics Grid - عناوين مختصرة وقوية -->
    <section class="topics-grid-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">عالم التقنية بين يديك</h2>
        </div>
        
        <div class="topics-grid-advanced">
          <a href="/Th-tech/ai/" class="topic-card-advanced reveal-delay-1">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon"></div>
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة والشبكات العصبية</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/programming/" class="topic-card-advanced reveal-delay-2">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">💻</div>
              <h3>هندسة البرمجيات</h3>
              <p>بناء أنظمة قوية وقابلة للتوسع</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/security/" class="topic-card-advanced reveal-delay-3">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">️</div>
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات والبنية التحتية</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card-advanced reveal-delay-4">
            <div class="topic-card-bg"></div>
            <div class="topic-card-content">
              <div class="topic-icon">☁️</div>
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، والحلول السحابية</p>
              <span class="topic-arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 Articles - عناوين جذابة -->
    <section class="articles-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">أحدث الإصدارات</h2>
        </div>
        
        <div class="articles-grid-advanced">
          <article class="article-card-advanced reveal-delay-1">
            <div class="article-badge-new">جديد</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">AI</span>
                <span class="article-date">5 دقائق قراءة</span>
              </div>
              <h3>إتقان تعلم الآلة في 2026</h3>
              <p>رحلة عملية من الأساسيات إلى بناء نماذج ذكية قادرة على التنبؤ.</p>
              <a href="/Th-tech/ai/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>

          <article class="article-card-advanced reveal-delay-2">
            <div class="article-badge-popular">شائع</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">Cloud</span>
                <span class="article-date">8 دقائق قراءة</span>
              </div>
              <h3>أمن السحابة: استراتيجيات الدفاع</h3>
              <p>كيف تحمي تطبيقاتك على AWS و Azure من أحدث التهديدات الأمنية.</p>
              <a href="/Th-tech/cloud/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>

          <article class="article-card-advanced reveal-delay-3">
            <div class="article-badge-updated">محدّث</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">Code</span>
                <span class="article-date">6 دقائق قراءة</span>
              </div>
              <h3>مبادئ SOLID للمحترفين</h3>
              <p>الأنماط التصميمية التي تفصل بين الكود العادي والكود الاحترافي.</p>
              <a href="/Th-tech/programming/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 Why Us & Newsletter - صياغة مقنعة -->
    <section class="combined-section reveal">
      <div class="container">
        <div class="combined-grid">
          
          <!-- Why Us -->
          <div class="why-content">
            <h2 class="section-title text-right">لماذا Th.Tech هو وجهتك؟</h2>
            <p class="why-desc">لا نقدم مجرد مقالات، بل نقدم مسارات تعليمية مدروسة تُترجم النظرية إلى مهارة عملية.</p>
            
            <div class="why-features">
              <div class="why-feature">
                <div class="why-icon"></div>
                <div class="why-text">
                  <h4>تعلم بالممارسة</h4>
                  <p>أمثلة عملية (Hands-on) قابلة للتطبيق الفوري في مشاريعك</p>
                </div>
              </div>
              <div class="why-feature">
                <div class="why-icon">🔄</div>
                <div class="why-text">
                  <h4>مواكبة مستمرة</h4>
                  <p>محتوى يُحدَّث أسبوعياً ليعكس أحدث معايير الصناعة العالمية</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Newsletter -->
          <div class="newsletter-box">
            <div class="newsletter-bg"></div>
            <div class="newsletter-content">
              <div class="newsletter-icon">📬</div>
              <h2>انضم لنشرتنا التقنية</h2>
              <p>احصل على خلاصة التطورات التقنية مباشرة في بريدك</p>
              <form class="newsletter-form">
                <input type="email" placeholder="بريدك الإلكتروني" required />
                <button type="submit" class="btn btn-primary btn-glow">اشترك</button>
              </form>
              <p class="newsletter-note"> نحترم خصوصيتك. لا رسائل عشوائية.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 🔹 CTA - دعوة قوية للعمل -->
    <section class="cta-section reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-content">
            <h2>🚀 مستعد لصناعة الفرق؟</h2>
            <p>انضم لآلاف المطورين الذين يبنون مستقبل التكنولوجيا معنا</p>
            <a href="/Th-tech/guides/" class="btn btn-light btn-large">تصفح الأدلة الشاملة</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.15);
    --radius: 16px;
    --shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.15);
    --shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; line-height: 1.6; overflow-x: hidden; }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.2rem; }
  .section-header { text-align: center; margin-bottom: 2rem; }
  .section-title { font-size: 1.8rem; margin-bottom: 0.5rem; font-weight: 700; }
  .section-subtitle { color: var(--text-sec); font-size: 1rem; }
  .text-right { text-align: right; }

  /* Hero */
  .hero { position: relative; min-height: 85vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; overflow: hidden; }
  .hero-particles { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .particle { position: absolute; width: 8px; height: 8px; background: rgba(255,255,255,0.4); border-radius: 50%; animation: float 15s infinite; }
  .particle:nth-child(1) { left: 20%; top: 30%; animation-delay: 0s; }
  .particle:nth-child(2) { left: 70%; top: 60%; animation-delay: 3s; }
  .particle:nth-child(3) { left: 50%; top: 80%; animation-delay: 6s; }
  @keyframes float { 0%, 100% { transform: translateY(0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(-80px); opacity: 0; } }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.3); }
  .gradient-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(2,132,199,0.3) 0%, rgba(14,165,233,0.3) 100%); }
  .hero-content { position: relative; z-index: 2; padding: 1rem; max-width: 800px; }
  
  .hero-badge-wrapper { margin-bottom: 1rem; }
  .hero-badge { display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,255,255,0.15); backdrop-filter: blur(5px); padding: 0.3rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; border: 1px solid rgba(255,255,255,0.2); }
  .badge-icon { width: 14px; height: 14px; }
  .pulse { animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
  
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.8rem; font-weight: 800; line-height: 1.2; }
  .title-line { display: block; }
  .title-line.highlight { background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  
  .typing-text { display: inline-block; border-right: 2px solid white; white-space: nowrap; overflow: hidden; animation: typing 3s steps(25, end), blink 0.75s step-end infinite; }
  @keyframes typing { from { width: 0; } to { width: 100%; } }
  @keyframes blink { 50% { border-color: transparent; } }
  @media (max-width: 768px) { .typing-text { animation: none; border: none; white-space: normal; } }
  
  .hero-desc { font-size: 1rem; opacity: 0.95; max-width: 600px; margin: 0 auto 1.5rem; }
  .fade-in-up { animation: fadeInUp 0.8s ease; }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  
  .hero-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem; }
  
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1.5rem; border-radius: 10px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: all 0.3s; cursor: pointer; border: none; position: relative; overflow: hidden; }
  .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 15px rgba(2,132,199,0.3); }
  .btn-glow::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); transition: left 0.5s; }
  .btn-glow:hover::before { left: 100%; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(2,132,199,0.4); }
  .btn-outline { background: transparent; border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: var(--text); transform: translateY(-2px); }
  .btn-light { background: white; color: var(--primary); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
  .btn-large { padding: 0.9rem 2rem; font-size: 1rem; }
  
  .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 500px; margin: 0 auto; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.2); }
  .hero-stat { text-align: center; }
  .stat-number { display: block; font-size: 2rem; font-weight: 800; color: white; line-height: 1; margin-bottom: 0.2rem; }
  .stat-label { font-size: 0.85rem; opacity: 0.9; }
  @media (max-width: 768px) { .hero-stats { grid-template-columns: 1fr; gap: 1rem; } }
  
  .scroll-indicator { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; color: white; opacity: 0.6; animation: bounce 2s infinite; }
  .mouse { width: 24px; height: 36px; border: 2px solid white; border-radius: 18px; position: relative; }
  .wheel { width: 3px; height: 6px; background: white; border-radius: 2px; position: absolute; top: 6px; left: 50%; transform: translateX(-50%); animation: scroll 2s infinite; }
  @keyframes scroll { 0% { opacity: 1; transform: translateX(-50%) translateY(0); } 100% { opacity: 0; transform: translateX(-50%) translateY(12px); } }
  @keyframes bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(8px); } }

  /* Rotating Features */
  .rotating-features { padding: 3rem 0; background: var(--bg); }
  .rotating-cards-wrapper { 
    position: relative; 
    max-width: 900px; 
    margin: 0 auto; 
    min-height: 320px; 
  }
  
  .feature-card-3d { 
    position: absolute; 
    top: 0; 
    left: 0; 
    right: 0; 
    opacity: 0; 
    transform: translateX(30px); 
    transition: all 0.5s ease; 
    pointer-events: none; 
    z-index: 1;
  }
  .feature-card-3d.active { opacity: 1; transform: translateX(0); pointer-events: all; z-index: 2; }
  
  .card-3d-inner { 
    background: var(--card); 
    border-radius: var(--radius); 
    padding: 1.5rem; 
    display: flex; 
    gap: 1.5rem; 
    align-items: center; 
