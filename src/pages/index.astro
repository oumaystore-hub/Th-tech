            alt="الذكاء الاصطناعي"
            loading="lazy"
          />

          <div class="track-img-overlay"></div>

          <span class="track-number">01</span>

        </div>

        <div class="track-body">

          <div class="track-top">

            <div class="icon">
              <i class="fas fa-brain"></i>
            </div>

            <span class="track-arrow">
              <i class="fas fa-arrow-left"></i>
            </span>

          </div>

          <h3>الذكاء الاصطناعي</h3>

          <p>
            تعلم الآلة والشبكات العصبية والتقنيات الحديثة للذكاء الاصطناعي.
          </p>

