---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | المستقبل الرقمي يبدأ هنا</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، البرمجة، والأمن السيبراني." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <!-- Prism.js for Syntax Highlighting -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-javascript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-css.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-java.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-cpp.min.js"></script>
  
  <!-- Pyodide for Python -->
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section -->
    <section class="section hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI" loading="eager" />
        <div class="overlay"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <span class="badge">🚀 نحو المستقبل</span>
          <h1><span class="gradient">ابنِ غدك الرقمي</span><br />معنا</h1>
          <p class="hero-text">شروحات عملية في الذكاء الاصطناعي، البرمجة، والأمن السيبراني</p>
          <div class="hero-actions">
            <a href="/Th-tech/guides/" class="btn btn-primary">استكشف الأدلة</a>
            <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
          </div>
        </div>
      </div>
    </section>

    <!--  Stats -->
    <section class="section stats-bar">
      <div class="container">
        <div class="stats-grid">
          <div class="stat">
            <span class="stat-num counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Professional Code Editor -->
    <section class="section code-editor-section" id="codeEditor">
      <div class="container">
        <div class="section-head">
          <h2> محرر الأكواد التفاعلي</h2>
          <p>اكتب، شغّل، واختبر كودك مباشرة في المتصفح</p>
        </div>

        <div class="editor-container">
          <!-- Toolbar -->
          <div class="editor-toolbar">
            <div class="lang-selector">
              <label for="languageSelect">اللغة:</label>
              <select id="languageSelect" onchange="changeLanguage()">
                <option value="javascript">JavaScript</option>
                <option value="python">Python</option>
                <option value="html">HTML/CSS</option>
                <option value="java">Java</option>
                <option value="cpp">C++</option>
                <option value="sql">SQL</option>
              </select>
            </div>
            
            <div class="editor-actions">
              <button class="btn-action btn-reset" onclick="resetCode()" title="إعادة الكود الافتراضي">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 12"/></svg>
              </button>
              <button class="btn-action btn-copy" onclick="copyCode()" title="نسخ الكود">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
              <button class="btn-run" id="runBtn" onclick="runCode()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span id="runText">تشغيل الكود</span>
              </button>
            </div>
          </div>

          <!-- Editor Area -->
          <div class="editor-area">
            <div class="code-input-wrapper">
              <div class="line-numbers" id="lineNumbers"></div>
              <textarea 
                id="codeInput" 
                class="code-input" 
                spellcheck="false"
                placeholder="اكتب الكود هنا..."
                oninput="updateLineNumbers(); updatePreview()"
                onscroll="syncScroll()"
              ></textarea>
            </div>
            
            <div class="output-panel">
              <div class="output-header">
                <span>📤 المخرجات</span>
                <button class="btn-clear" onclick="clearOutput()">مسح</button>
              </div>
              <div id="output" class="code-output">
                <div class="output-placeholder">
                  <span class="icon">💡</span>
                  <p>اكتب كوداً ثم اضغط "تشغيل الكود" لرؤية النتيجة</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Info Bar -->
          <div class="editor-info">
            <span id="statusInfo">✅ جاهز</span>
            <span class="separator">|</span>
            <span id="langInfo">JavaScript</span>
            <span class="separator">|</span>
            <span id="pyodideStatus" style="display:none;">Python: <span id="pyStatus">جاري التحميل...</span></span>
          </div>
        </div>

        <!-- Quick Examples -->
        <div class="quick-examples">
          <h4>💡 أمثلة سريعة:</h4>
          <div class="example-buttons">
            <button class="btn-example" onclick="loadExample('hello')">مرحباً بالعالم</button>
            <button class="btn-example" onclick="loadExample('loop')">حلقة تكرار</button>
            <button class="btn-example" onclick="loadExample('function')">دالة</button>
            <button class="btn-example" onclick="loadExample('array')">مصفوفة</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Topics -->
    <section class="section topics">
      <div class="container">
        <div class="section-head">
          <h2>اختر مسارك</h2>
          <p>مسارات تعليمية مصممة لبناء مهاراتك التقنية</p>
        </div>
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة، الشبكات العصبية، وتطبيقات الـ AI</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/programming/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" loading="lazy" /></div>
            <div class="topic-body">
              <h3>البرمجة</h3>
              <p>لغات البرمجة، الأطر الحديثة، وهندسة البرمجيات</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/security/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات، الاختراق الأخلاقي، والدفاع الرقمي</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/cloud/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، وGoogle Cloud</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA -->
    <section class="section cta">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك اليوم</h2>
          <p>انضم إلى آلاف المطورين والمبتكرين</p>
          <a href="/Th-tech/guides/" class="btn btn-light">تصفح الأدلة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  /* === Variables === */
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-muted: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.15);
    --radius: 12px;
    --editor-bg: #1e1e1e;
    --editor-gutter: #2d2d2d;
    --spacing-section: 3.5rem;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.15);
    --editor-bg: #1e1e1e;
    --editor-gutter: #252526;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Cairo', system-ui, sans-serif;
    line-height: 1.6;
  }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: var(--spacing-section) 0; }
  .section-head { text-align: center; margin-bottom: 2.5rem; }
  .section-head h2 { font-size: 1.7rem; font-weight: 800; margin-bottom: 0.5rem; }
  .section-head p { color: var(--text-muted); }

  /* Hero */
  .hero {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.45); }
  .overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(2,132,199,0.4), rgba(14,165,233,0.4)); }
  .hero-content { max-width: 650px; padding: 2rem; }
  .badge {
    display: inline-block;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
    padding: 0.4rem 1.1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
    border: 1px solid rgba(255,255,255,0.25);
  }
  .hero h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 800; line-height: 1.2; margin-bottom: 0.8rem; }
  .gradient {
    background: linear-gradient(135deg, #fff, var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-text { font-size: 1.05rem; opacity: 0.95; margin-bottom: 1.8rem; }
  .hero-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.85rem 1.8rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s;
    cursor: pointer;
    border: none;
  }
  .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 12px rgba(2,132,199,0.25); }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(2,132,199,0.35); }
  .btn-outline { background: transparent; border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: var(--text); transform: translateY(-2px); }
  .btn-light { background: white; color: var(--primary); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.12); }

  /* Stats */
  .stats-bar { background: var(--card); border-bottom: 1px solid var(--border); padding: 1.8rem 0; }
  .stats-grid { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .stat { text-align: center; }
  .stat-num { display: block; font-size: 2rem; font-weight: 800; color: var(--primary); line-height: 1; }
  .stat-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }
  .stat-divider { width: 1px; height: 40px; background: var(--border); }

  /* === Professional Code Editor === */
  .code-editor-section { background: var(--bg); padding: 4rem 0; }
  
  .editor-container {
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }

  .editor-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lang-selector {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .lang-selector select {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .lang-selector select:hover {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(2,132,199,0.1);
  }

  .editor-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn-action {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-action:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .btn-action svg {
    width: 18px;
    height: 18px;
  }

  .btn-run {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 12px rgba(16,185,129,0.25);
  }

  .btn-run:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(16,185,129,0.35);
  }

  .btn-run:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-run svg {
    width: 18px;
    height: 18px;
  }

  .editor-area {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 450px;
  }

  .code-input-wrapper {
    position: relative;
    border-right: 1px solid var(--border);
    background: var(--editor-bg);
  }

  .line-numbers {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50px;
    background: var(--editor-gutter);
    color: #858585;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    padding: 1rem 0.8rem;
    text-align: right;
    user-select: none;
    overflow: hidden;
  }

  .code-input {
    width: 100%;
    height: 100%;
    min-height: 450px;
    padding: 1rem 1rem 1rem 3.5rem;
    background: transparent;
    color: #d4d4d4;
    border: none;
    resize: none;
    font-family: 'Fira Code', monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    tab-size: 2;
  }

  .code-input:focus {
    outline: none;
  }

  .output-panel {
    display: flex;
    flex-direction: column;
    background: var(--card);
  }

  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .btn-clear {
    padding: 0.3rem 0.7rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-clear:hover {
    background: rgba(239,68,68,0.1);
    color: #ef4444;
    border-color: #ef4444;
  }

  .code-output {
    flex: 1;
    padding: 1.2rem;
    background: var(--editor-bg);
    color: #d4d4d4;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
    overflow-y: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .output-placeholder {
    text-align: center;
    padding: 3rem 1rem;
    color: #666;
  }

  .output-placeholder .icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }

  .output-placeholder p {
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .code-output.error {
    color: #f48771;
    background: #2d1f1f;
  }

  .code-output.success {
    color: #89d185;
  }

  .editor-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 1.5rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .editor-info .separator {
    color: var(--border);
    margin: 0 0.5rem;
  }

  /* Quick Examples */
  .quick-examples {
    margin-top: 1.5rem;
    padding: 1.2rem;
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .quick-examples h4 {
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    color: var(--text);
  }

  .example-buttons {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .btn-example {
    padding: 0.45rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-example:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  /* Topics */
  .topics { background: var(--card); }
  .topics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .topic-card {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s;
    text-decoration: none;
    color: var(--text);
  }
  .topic-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); border-color: var(--primary); }
  .topic-img { height: 160px; overflow: hidden; }
  .topic-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .topic-card:hover .topic-img img { transform: scale(1.05); }
  .topic-body { padding: 1.2rem; }
  .topic-body h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .topic-body p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.8rem; }
  .link-arrow { color: var(--primary); font-size: 1.2rem; font-weight: bold; transition: transform 0.3s; display: inline-block; }
  .topic-card:hover .link-arrow { transform: translateX(4px); }

  /* CTA */
  .cta { background: var(--bg); padding: 3.5rem 1.5rem; }
  .cta-box {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    padding: 2.5rem 2rem;
    border-radius: var(--radius);
    color: white;
    box-shadow: 0 16px 35px rgba(2,132,199,0.25);
  }
  .cta-box h2 { font-size: 1.75rem; margin-bottom: 0.5rem; }
