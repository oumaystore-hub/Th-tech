    overflow-y: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .placeholder { color: #666; font-style: italic; }
  .code-output.error { color: #f48771; background: #2d1f1f; }
  .code-output.success { color: #89d185; }
  .code-output.loading { color: #f59e0b; }
  
  .editor-hint {
    padding: 0.7rem 1.2rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* === Why === */
  .why { background: var(--card); }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-grid); }
  .feature {
    text-align: center;
    padding: 1.5rem;
    background: var(--bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .feature:hover { transform: translateY(-4px) scale(1.02); box-shadow: var(--shadow-lg); }
  .feature-icon { font-size: 2.4rem; margin-bottom: 0.8rem; }
  .feature h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .feature p { color: var(--text-muted); font-size: 0.9rem; }

  /* === Newsletter === */
  .newsletter { background: var(--bg); }
  .newsletter-box {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    background: var(--card);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    transition: transform 0.3s;
  }
  .newsletter-box:hover { transform: translateY(-3px); }
  .newsletter-icon { font-size: 2.4rem; margin-bottom: 0.8rem; }
  .newsletter-box h3 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .newsletter-box p { color: var(--text-muted); margin-bottom: 1.5rem; font-size: 0.95rem; }
  .newsletter-form { display: flex; gap: 0.6rem; max-width: 380px; margin: 0 auto 0.8rem; }
  .newsletter-form input {
    flex: 1;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .newsletter-form input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(2,132,199,0.15); }
  .note { font-size: 0.8rem; color: var(--text-muted); }

  /* === CTA === */
  .cta { background: var(--card); padding: 3.5rem 1.2rem; }
  .cta-box {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    padding: 2.5rem 1.8rem;
    border-radius: var(--radius);
    color: white;
    box-shadow: 0 16px 35px rgba(2,132,199,0.25);
    transition: transform 0.3s;
  }
  .cta-box:hover { transform: translateY(-4px) scale(1.01); }
  .cta-box h2 { font-size: 1.75rem; margin-bottom: 0.5rem; }
  .cta-box p { opacity: 0.95; margin-bottom: 1.5rem; font-size: 1rem; }

  /* === Responsive === */
  @media (max-width: 1024px) {
    .topics-grid { grid-template-columns: 1fr 1fr; }
    .articles-grid { grid-template-columns: repeat(2, 1fr); }
    .features-grid { grid-template-columns: 1fr 1fr; }
    .editor-split { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    :root { --spacing-section: 3rem; --gap-grid: 0.85rem; }
    .hero { min-height: auto; padding: 3.5rem 0 2.5rem; }
    .hero h1 { font-size: 1.8rem; }
    .hero-text { font-size: 1rem; }
    .hero-actions { flex-direction: column; align-items: center; }
    .btn { width: 100%; max-width: 260px; }
    
    .stats-grid { flex-direction: column; gap: 1.2rem; }
    .stat-divider { width: 100%; height: 1px; }
    
    .topics-grid, .articles-grid, .features-grid { grid-template-columns: 1fr; }
    
    .editor-toolbar { flex-direction: column; align-items: stretch; }
    .lang-tabs { justify-content: center; }
    .editor-split { grid-template-columns: 1fr; }
    .code-input { border-right: none; border-bottom: 1px solid var(--border); min-height: 200px; }
    
    .newsletter-form { flex-direction: column; }
    .newsletter-form input { width: 100%; }
    
    .cta-box { padding: 2rem 1.2rem; }
    .cta-box h2 { font-size: 1.5rem; }
  }

  @media (max-width: 480px) {
    .section-head h2 { font-size: 1.45rem; }
    .stat-num { font-size: 1.75rem; }
    .topic-img { height: 140px; }
    .article-media { height: 130px; }
    .editor-split { min-height: 320px; }
    .code-input { min-height: 180px; }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  // Scroll Reveal with Stagger
  function initReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    
    document.querySelectorAll('.reveal-up').forEach(el => observer.observe(el));
  }

  // Counter Animation
  function initCounterAnimation() {
    const counters = document.querySelectorAll('.counter');
    const animateCounter = (element, target, duration = 1800) => {
      let start = 0;
      const increment = target / (duration / 16);
      const updateCounter = () => {
        start += increment;
        if (start < target) {
          element.textContent = Math.floor(start) + (element.dataset.suffix || '');
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = target + (element.dataset.suffix || '');
        }
      };
      updateCounter();
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = parseInt(entry.target.dataset.target);
          animateCounter(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    counters.forEach(counter => { if (counter.dataset.target) observer.observe(counter); });
  }

  // Typing Effect
  function initTypingEffect() {
    const el = document.querySelector('.hero h1');
    if (!el) return;
    const text = el.querySelector('.gradient')?.textContent || '';
    if (!text) return;
    
    const span = document.createElement('span');
    span.className = 'gradient';
    span.style.display = 'inline-block';
    span.style.borderRight = '3px solid white';
    span.style.whiteSpace = 'nowrap';
    span.style.overflow = 'hidden';
    span.style.animation = 'typing 2.8s steps(18, end), blink 0.75s step-end infinite';
    el.innerHTML = '';
    el.appendChild(span);
    
    let i = 0;
    const type = () => {
      if (i < text.length) {
        span.textContent += text.charAt(i++);
        setTimeout(type, 55);
      } else {
        span.style.borderRight = 'none';
      }
    };
    setTimeout(type, 400);
  }

  // Code Editor
  const codeExamples = {
    javascript: `// مرحباً بك في محرر JavaScript\nfunction greet(name) {\n  return \`مرحباً \${name}! \`;\n}\nconsole.log(greet("المطور"));`,
    python: `# مرحباً بك في محرر Python\ndef greet(name):\n    return f"مرحباً {name}! 🎉"\nprint(greet("المطور"))\n\nimport math\nprint(f"√16 = {math.sqrt(16)}")`,
    html: `<!-- بطاقة تفاعلية -->\n<div class="card">\n  <h2>مرحباً!</h2>\n  <button onclick="alert('🎉')">اضغط هنا</button>\n</div>\n<style>\n.card { background: linear-gradient(135deg, #667eea, #764ba2); color: white; padding: 2rem; border-radius: 12px; text-align: center; }\nbutton { margin-top: 1rem; padding: 0.8rem 1.5rem; background: white; color: #667eea; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }\n</style>`
  };

  let currentLang = 'javascript', pyodide = null, pyodideReady = false;

  async function initPyodide() {
    const status = document.getElementById('pyStatus');
    const btn = document.getElementById('runBtn');
    try {
      status.textContent = '●';
      status.className = 'py-status loading';
      btn.disabled = true;
      pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/" });
      pyodideReady = true;
      status.textContent = '●';
      status.className = 'py-status ready';
    } catch (e) {
      status.textContent = '●';
      status.className = 'py-status';
    }
    btn.disabled = false;
  }

  function switchLanguage(lang) {
    currentLang = lang;
    document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.lang === lang));
    document.getElementById('codeEditor').value = codeExamples[lang];
    clearOutput();
  }

  async function runCode() {
    const code = document.getElementById('codeEditor').value;
    const output = document.getElementById('output');
    const btn = document.getElementById('runBtn');
    const btnText = document.getElementById('runText');
    
    output.className = 'code-output';
    output.innerHTML = '<span class="placeholder">جاري التنفيذ...</span>';
    btn.disabled = true;
    btnText.textContent = 'جاري...';
    
    try {
      if (currentLang === 'javascript') runJS(code, output);
      else if (currentLang === 'python') await runPy(code, output);
      else if (currentLang === 'html') runHTML(code, output);
    } catch (err) {
      output.className = 'code-output error';
      output.textContent = ` خطأ: ${err.message}`;
    } finally {
      btn.disabled = false;
      btnText.textContent = 'تشغيل';
    }
  }

  function runJS(code, output) {
    let logs = [];
    const cons = {
      log: (...a) => logs.push(a.map(x => typeof x === 'object' ? JSON.stringify(x, null, 2) : String(x)).join(' ')),
      error: (...a) => logs.push(' ' + a.join(' ')),
      warn: (...a) => logs.push('️ ' + a.join(' '))
    };
    eval(`(function(c){${code}})(cons)`);
    output.className = logs.length ? 'code-output success' : 'code-output';
    output.textContent = logs.length ? logs.join('\n') : '✅ تم التنفيذ (لا يوجد مخرجات)';
  }

  async function runPy(code, output) {
    if (!pyodideReady) {
      output.className = 'code-output loading';
      output.textContent = '⏳ جاري تحميل Python...';
      await initPyodide();
      if (!pyodideReady) {
        output.className = 'code-output error';
        output.textContent = '❌ فشل تحميل Pyodide. حاول تحديث الصفحة.';
        return;
      }
    }
    try {
      pyodide.setStdout({ batched: m => { output.textContent += m; output.scrollTop = output.scrollHeight; } });
      pyodide.setStderr({ batched: m => { output.className = 'code-output error'; output.textContent += '❌ ' + m; } });
      await pyodide.runPythonAsync(code);
      if (!output.textContent.trim()) {
        output.className = 'code-output success';
        output.textContent = '✅ تم التنفيذ بنجاح';
      } else {
        output.className = 'code-output success';
      }
    } catch (err) {
      output.className = 'code-output error';
      output.textContent = `❌ خطأ: ${err.message}`;
    }
  }

  function runHTML(code, output) {
    output.className = 'code-output success';
    output.innerHTML = code;
  }

  function clearOutput() {
    const out = document.getElementById('output');
    out.innerHTML = '<span class="placeholder">اكتب كوداً ثم اضغط "تشغيل"...</span>';
    out.className = 'code-output';
  }

  document.addEventListener('DOMContentLoaded', () => {
    initReveal();
    initCounterAnimation();
    initTypingEffect();
    initPyodide();
    
    const editor = document.getElementById('codeEditor');
    if (editor) {
      editor.value = codeExamples.javascript;
      editor.addEventListener('keydown', e => {
        if (e.ctrlKey && e.key === 'Enter') runCode();
        if (e.key === 'Tab') {
          e.preventDefault();
          const s = editor.selectionStart, en = editor.selectionEnd;
          editor.value = editor.value.slice(0, s) + '  ' + editor.value.slice(en);
          editor.selectionStart = editor.selectionEnd = s + 2;
        }
      });
    }
    
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => switchLanguage(tab.dataset.lang));
    });
  });
</script>
