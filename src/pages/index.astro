---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((key) => {
    const match = key.match(/\.\/tools\/([^/]+)\/index\.astro$/);
    return match ? match[1] : null;
  })
  .filter(Boolean)
  .sort();

const toolCount = toolSlugs.length;

const prettyName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolNameArabic = (slug) => {
  const names = {
    'api-request-builder': 'API Request Builder',
    'json-formatter': 'JSON Formatter',
    'json-validator': 'JSON Validator',
    'sql-formatter': 'SQL Formatter',
    'base64-encoder-decoder': 'Base64 Encoder / Decoder',
    'url-encoder-decoder': 'URL Encoder / Decoder',
    'qr-code-generator': 'QR Code Generator',
    'uuid-generator': 'UUID Generator',
    'hash-generator': 'Hash Generator',
    'jwt-decoder': 'JWT Decoder',
    'regex-tester': 'Regex Tester',
    'timestamp-converter': 'Timestamp Converter',
    'color-picker': 'Color Picker',
    'markdown-editor': 'Markdown Editor',
    'text-counter': 'Text Counter',
    'line-counter': 'Line Counter',
    'code-editor': 'Code Editor',
    'html-formatter': 'HTML Formatter',
    'css-formatter': 'CSS Formatter',
    'javascript-formatter': 'JavaScript Formatter'
  };

  return names[slug] || prettyName(slug);
};

const iconFor = (slug) => {
  if (/json/.test(slug)) return 'fa-brackets-curly';
  if (/javascript|typescript|js/.test(slug)) return 'fa-js';
  if (/html/.test(slug)) return 'fa-code';
  if (/css/.test(slug)) return 'fa-css3-alt';
  if (/sql|database/.test(slug)) return 'fa-database';
  if (/api|request/.test(slug)) return 'fa-plug';
  if (/url|link/.test(slug)) return 'fa-link';
  if (/qr/.test(slug)) return 'fa-qrcode';
  if (/image|photo/.test(slug)) return 'fa-image';
  if (/color|hex/.test(slug)) return 'fa-palette';
  if (/text|word|character|line/.test(slug)) return 'fa-font';
  if (/hash|crypto|encrypt/.test(slug)) return 'fa-shield-halved';
  if (/jwt|token|auth/.test(slug)) return 'fa-key';
  if (/regex/.test(slug)) return 'fa-filter';
  if (/markdown|md/.test(slug)) return 'fa-file-lines';
  if (/time|date|timestamp/.test(slug)) return 'fa-clock';
  if (/uuid|guid/.test(slug)) return 'fa-fingerprint';

  return 'fa-wand-magic-sparkles';
};

const featuredSlugs = [
  'api-request-builder',
  'json-formatter',
  'json-validator',
  'sql-formatter',
  'base64-encoder-decoder',
  'qr-code-generator',
  'regex-tester',
  'jwt-decoder'
].filter((slug) => toolSlugs.includes(slug));

const featuredTools =
  featuredSlugs.length >= 4
    ? featuredSlugs
    : toolSlugs.slice(0, 8);

const categoryGroups = [
  {
    title: 'أدوات المطورين',
    icon: 'fa-code',
    description: 'أدوات تساعدك في البرمجة وتطوير المشاريع.',
    keywords: ['api', 'json', 'javascript', 'html', 'css', 'sql', 'code', 'regex']
  },
  {
    title: 'النصوص والبيانات',
    icon: 'fa-file-lines',
    description: 'تحليل النصوص وتحويل البيانات بسرعة.',
    keywords: ['text', 'line', 'word', 'csv', 'xml', 'yaml', 'markdown']
  },
  {
    title: 'الأمان والتشفير',
    icon: 'fa-shield-halved',
    description: 'تشفير وترميز وفحص البيانات الحساسة.',
    keywords: ['hash', 'crypto', 'base64', 'jwt', 'uuid', 'encrypt']
  },
  {
    title: 'الروابط والرموز',
    icon: 'fa-qrcode',
    description: 'أدوات الروابط وQR والأكواد المختلفة.',
    keywords: ['url', 'qr', 'barcode', 'link']
  }
];

const categoryCounts = categoryGroups.map((category) => ({
  ...category,
  count: toolSlugs.filter((slug) =>
    category.keywords.some((keyword) => slug.includes(keyword))
  ).length
}));

const playgroundHref = `${base}/playground/`;
const toolsHref = `${base}/tools/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description:
    'منصة عربية مجانية تضم مجموعة كبيرة من أدوات الذكاء الاصطناعي والتكنولوجيا والبرمجة.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}${base}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Th.Tech | أدوات تقنية وذكاء اصطناعي مجانية</title>

    <meta
      name="description"
      content="Th.Tech منصة عربية مجانية تضم أكثر من 100 أداة تقنية للمطورين والمصممين وصناع المحتوى، مع Playground لتجربة الأكواد مباشرة."
    />

    <meta
      name="keywords"
      content="أدوات تقنية, أدوات برمجة, ذكاء اصطناعي, JSON, API, SQL, QR, Base64, Regex, Playground"
    />

    <meta name="theme-color" content="#020617" />

    <link rel="canonical" href={`${siteUrl}${base}/`} />

    <link rel="icon" type="image/png" href={`${base}/Th-tech/logo1.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Fira+Code:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('theme');

        if (
          savedTheme === 'dark' ||
          (!savedTheme &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark-mode');
        }
      })();
    </script>
  </head>

  <body>
    <Header />

    <!-- =========================
         Background
    ========================== -->

    <div class="page-background" aria-hidden="true">
      <div class="background-grid"></div>
      <div class="background-glow glow-one"></div>
      <div class="background-glow glow-two"></div>
    </div>

    <main>
      <!-- =========================
           HERO
      ========================== -->

      <section class="hero">
        <div class="hero-orb orb-one"></div>
        <div class="hero-orb orb-two"></div>

        <div class="container hero-container">
          <div class="hero-badge reveal">
            <span class="status-dot"></span>
            منصة تقنية عربية مجانية
          </div>

          <h1 class="hero-title reveal">
            أدواتك التقنية
            <span>في مكان واحد</span>
          </h1>

          <p class="hero-description reveal">
            مجموعة متكاملة من الأدوات للمطورين والمصممين وصناع المحتوى.
            أنجز مهامك بسرعة، بدون تسجيل وبدون تعقيد.
          </p>

          <div class="hero-actions reveal">
            <a href={toolsHref} class="primary-button">
              <i class="fa-solid fa-toolbox"></i>
              استكشف الأدوات
            </a>

            <a href={playgroundHref} class="secondary-button">
              <i class="fa-solid fa-terminal"></i>
              جرّب Playground
            </a>
          </div>

          <div class="hero-trust reveal">
            <span>
              <i class="fa-solid fa-check"></i>
              مجاني
            </span>

            <span>
              <i class="fa-solid fa-bolt"></i>
              سريع
            </span>

            <span>
              <i class="fa-solid fa-lock"></i>
              خصوصية
            </span>

            <span>
              <i class="fa-solid fa-cloud"></i>
              بدون تثبيت
            </span>
          </div>
        </div>

        <!-- Floating code card -->

        <div class="floating-code code-card-one" aria-hidden="true">
          <div class="mini-window-head">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="mini-code">
            <span class="code-purple">const</span>
            <span class="code-blue">data</span>
            <span>=</span>
            <span class="code-green">{}</span>
          </div>
        </div>

        <div class="floating-code code-card-two" aria-hidden="true">
          <div class="mini-code">
            <span class="code-blue">200</span>
            <span class="code-green"> OK</span>
          </div>
        </div>
      </section>

      <!-- =========================
           QUICK STATS
      ========================== -->

      <section class="stats-section">
        <div class="container">
          <div class="stats-grid reveal-group">
            <div class="stat-card reveal">
              <div class="stat-icon">
                <i class="fa-solid fa-toolbox"></i>
              </div>

              <div>
                <strong data-counter={toolCount}>0</strong>
                <span>أداة متاحة</span>
              </div>
            </div>

            <div class="stat-card reveal">
              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <strong>100%</strong>
                <span>تعمل من المتصفح</span>
              </div>
            </div>

            <div class="stat-card reveal">
              <div class="stat-icon">
                <i class="fa-solid fa-user-shield"></i>
              </div>

              <div>
                <strong>0</strong>
                <span>تسجيل مطلوب</span>
              </div>
            </div>

            <div class="stat-card reveal">
              <div class="stat-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <strong>24/7</strong>
                <span>متاحة في أي وقت</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           SEARCH
      ========================== -->

      <section class="search-section">
        <div class="container">
          <div class="search-box reveal">
            <div class="search-heading">
              <span class="section-kicker">
                <i class="fa-solid fa-magnifying-glass"></i>
                ابحث بسرعة
              </span>

              <h2>ما الأداة التي تبحث عنها؟</h2>

              <p>
                اكتب اسم الأداة أو وظيفتها للوصول إليها مباشرة.
              </p>
            </div>

            <div class="search-input-wrap">
              <i class="fa-solid fa-magnifying-glass"></i>

              <input
                id="toolSearch"
                type="search"
                placeholder="مثال: JSON، API، QR، SQL..."
                autocomplete="off"
                aria-label="البحث عن أداة"
              />

              <kbd>Ctrl K</kbd>
            </div>

            <div id="searchResults" class="search-results"></div>
          </div>
        </div>
      </section>

      <!-- =========================
           FEATURED TOOLS
      ========================== -->

      <section class="section">
        <div class="container">
          <div class="section-header reveal">
            <div>
              <span class="section-kicker">
                <i class="fa-solid fa-fire"></i>
                أدوات مختارة
              </span>

              <h2>ابدأ بالأدوات الأكثر استخدامًا</h2>

              <p>
                مجموعة من الأدوات التي يمكنك استخدامها مباشرة من المتصفح.
              </p>
            </div>

            <a href={toolsHref} class="text-link">
              عرض جميع الأدوات
              <i class="fa-solid fa-arrow-left"></i>
            </a>
          </div>

          <div class="tools-grid">
            {
              featuredTools.map((slug, index) => (
                <a
                  href={`${base}/tools/${slug}/`}
                  class="tool-card reveal"
                  style={`--delay:${index * 60}ms`}
                >
                  <div class="tool-card-top">
                    <div class="tool-icon">
                      <i class={`fa-solid ${iconFor(slug)}`}></i>
                    </div>

                    <span class="tool-number">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <div class="tool-card-body">
                    <h3>{toolNameArabic(slug)}</h3>

                    <p>
                      أداة مجانية وسريعة لإنجاز مهمتك مباشرة من المتصفح.
                    </p>
                  </div>

                  <div class="tool-card-footer">
                    <span>فتح الأداة</span>
                    <i class="fa-solid fa-arrow-left"></i>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================
           CATEGORIES
      ========================== -->

      <section class="section categories-section">
        <div class="container">
          <div class="section-header centered reveal">
            <span class="section-kicker">
              <i class="fa-solid fa-layer-group"></i>
              التصنيفات
            </span>

            <h2>اختر المجال الذي تعمل عليه</h2>

            <p>
              أدوات مرتبة حسب طبيعة المهمة لتصل لما تحتاجه بسرعة.
            </p>
          </div>

          <div class="category-grid">
            {
              categoryCounts.map((category, index) => (
                <div
                  class="category-card reveal"
                  style={`--delay:${index * 80}ms`}
                >
                  <div class="category-icon">
                    <i class={`fa-solid ${category.icon}`}></i>
                  </div>

                  <div class="category-content">
                    <h3>{category.title}</h3>

                    <p>{category.description}</p>

                    <span>
                      {category.count} أدوات
                      <i class="fa-solid fa-arrow-left"></i>
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================
           PLAYGROUND
      ========================== -->

      <section class="section playground-section">
        <div class="container">
          <div class="playground-card reveal">
            <div class="playground-content">
              <div class="playground-label">
                <span class="live-dot"></span>
                TH.TECH PLAYGROUND
              </div>

              <h2>
                اكتب الكود.
                <span>جرّبه فورًا.</span>
              </h2>

              <p>
                بيئة تجريبية مباشرة من المتصفح لتجربة الأكواد والأفكار
                بسرعة، بدون إعدادات معقدة.
              </p>

              <div class="playground-features">
                <span>
                  <i class="fa-solid fa-check"></i>
                  تشغيل مباشر
                </span>

                <span>
                  <i class="fa-solid fa-check"></i>
                  عدة لغات
                </span>

                <span>
                  <i class="fa-solid fa-check"></i>
                  بدون تثبيت
                </span>
              </div>

              <a href={playgroundHref} class="playground-button">
                افتح Playground
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>

            <div class="playground-preview" aria-hidden="true">
              <div class="editor-window">
                <div class="editor-top">
                  <div class="window-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <div class="editor-file">
                    <i class="fa-brands fa-js"></i>
                    main.js
                  </div>
                </div>

                <div class="editor-body">
                  <div class="line-numbers">
                    01<br />
                    02<br />
                    03<br />
                    04<br />
                    05<br />
                    06<br />
                    07
                  </div>

                  <pre><code><span class="syntax-purple">const</span> <span class="syntax-blue">message</span> = <span class="syntax-green">"Hello Th.Tech"</span>;

<span class="syntax-purple">function</span> <span class="syntax-blue">run</span>() {
  <span class="syntax-purple">return</span> message;
}

<span class="syntax-blue">console</span>.log(run());</code></pre>
                </div>

                <div class="editor-output">
                  <span class="output-dot"></span>
                  Hello Th.Tech
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           TRACKS
      ========================== -->

      <section class="section">
        <div class="container">
          <div class="section-header centered reveal">
            <span class="section-kicker">
              <i class="fa-solid fa-route"></i>
              مسارات العمل
            </span>

            <h2>مجموعة أدوات لكل نوع من المهام</h2>

            <p>
              لا تحتاج إلى البحث طويلًا. اختر مسارك وابدأ.
            </p>
          </div>

          <div class="tracks-grid">
            <div class="track-card reveal">
              <div class="track-number">01</div>
              <div class="track-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>للمطورين</h3>

              <p>
                JSON وAPI وSQL وRegex وأدوات البرمجة اليومية.
              </p>

              <a href={toolsHref}>
                استكشف المسار
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>

            <div class="track-card reveal">
              <div class="track-number">02</div>
              <div class="track-icon">
                <i class="fa-solid fa-pen-ruler"></i>
              </div>

              <h3>للمصممين</h3>

              <p>
                الألوان والصور والنصوص والروابط والأدوات المساعدة.
              </p>

              <a href={toolsHref}>
                استكشف المسار
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>

            <div class="track-card reveal">
              <div class="track-number">03</div>
              <div class="track-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <h3>للمهام السريعة</h3>

              <p>
                تحويل وترميز وتنسيق وفحص الملفات والبيانات بسرعة.
              </p>

              <a href={toolsHref}>
                استكشف المسار
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           WHY TH.TECH
      ========================== -->

      <section class="section why-section">
        <div class="container">
          <div class="why-layout">
            <div class="why-content reveal">
              <span class="section-kicker">
                <i class="fa-solid fa-sparkles"></i>
                لماذا Th.Tech؟
              </span>

              <h2>
                أدوات بسيطة.
                <span>نتائج أسرع.</span>
              </h2>

              <p>
                صممنا Th.Tech ليكون مكانًا عمليًا للأدوات التي تحتاجها
                يوميًا، مع التركيز على السرعة والبساطة والخصوصية.
              </p>

              <a href={toolsHref} class="primary-button">
                ابدأ الآن
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>

            <div class="why-features">
              <div class="why-feature reveal">
                <div>
                  <i class="fa-solid fa-gauge-high"></i>
                </div>

                <section>
                  <h3>سرعة الاستخدام</h3>
                  <p>
                    واجهات خفيفة ومباشرة بدون خطوات غير ضرورية.
                  </p>
                </section>
              </div>

              <div class="why-feature reveal">
                <div>
                  <i class="fa-solid fa-lock"></i>
                </div>

                <section>
                  <h3>خصوصيتك أولًا</h3>
                  <p>
                    العديد من الأدوات تعمل مباشرة داخل المتصفح.
                  </p>
                </section>
              </div>

              <div class="why-feature reveal">
                <div>
                  <i class="fa-solid fa-mobile-screen-button"></i>
                </div>

                <section>
                  <h3>متجاوب مع كل الأجهزة</h3>
                  <p>
                    تجربة مصممة للهاتف والكمبيوتر والشاشات المختلفة.
                  </p>
                </section>
              </div>

              <div class="why-feature reveal">
                <div>
                  <i class="fa-solid fa-arrows-rotate"></i>
                </div>

                <section>
                  <h3>يتطور باستمرار</h3>
                  <p>
                    نضيف تحسينات وأدوات جديدة باستمرار.
                  </p>
                </section>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           FAQ
      ========================== -->

      <section class="section faq-section">
        <div class="container">
          <div class="section-header centered reveal">
            <span class="section-kicker">
              <i class="fa-solid fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>أسئلة قد تخطر في بالك</h2>

            <p>
              إجابات سريعة حول استخدام أدوات Th.Tech.
            </p>
          </div>

          <div class="faq-list">
            <details class="faq-item reveal">
              <summary>
                هل استخدام الأدوات مجاني؟
                <span><i class="fa-solid fa-plus"></i></span>
              </summary>

              <p>
                نعم، أدوات Th.Tech متاحة للاستخدام مباشرة من المتصفح دون
                الحاجة إلى إنشاء حساب لاستخدام الوظائف الأساسية.
              </p>
            </details>

            <details class="faq-item reveal">
              <summary>
                هل أحتاج إلى تثبيت برنامج؟
                <span><i class="fa-solid fa-plus"></i></span>
              </summary>

              <p>
                لا. معظم الأدوات تعمل مباشرة داخل المتصفح، ويمكنك استخدامها
                من الهاتف أو الكمبيوتر.
              </p>
            </details>

            <details class="faq-item reveal">
              <summary>
                هل تعمل الأدوات على الهاتف؟
                <span><i class="fa-solid fa-plus"></i></span>
              </summary>

              <p>
                نعم. تم تصميم الواجهة لتكون متجاوبة مع الشاشات الصغيرة
