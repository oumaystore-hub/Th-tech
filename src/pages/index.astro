---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | نحو التميز التقني</title>
  <meta name="description" content="منصة عربية رائدة في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني" />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section -->
    <section class="hero reveal">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI" loading="eager" />
        <div class="overlay"></div>
      </div>
      
      <div class="container hero-content">
        <div class="hero-badge reveal-delay-1">
          <span>🚀 نحو المستقبل الرقمي</span>
        </div>
        
        <h1 class="reveal-delay-2">
          <span class="highlight">صُغ مستقبلك</span> الرقمي
        </h1>
        
        <p class="hero-desc reveal-delay-3">
          منصة عربية رائدة تُقدّم محتوى تقنياً معمقاً في الذكاء الاصطناعي، البرمجة، والأمن السيبراني
        </p>
        
        <div class="hero-cta reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary btn-glow">استكشف الأدلة</a>
          <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
        </div>

        <div class="hero-stats reveal-delay-4">
          <div class="stat-item">
            <span class="stat-number counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-item">
            <span class="stat-number counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-item">
            <span class="stat-number counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>

      <div class="scroll-indicator">
        <div class="mouse"><div class="wheel"></div></div>
      </div>
    </section>

    <!-- 🔹 Rotating Features مع Auto-Scroll -->
    <section class="rotating-features reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">مسارات التميز التقني</h2>
          <p class="section-subtitle">اختر تخصصك وابدأ رحلتك الاحترافية</p>
        </div>
        
        <div class="rotating-cards-wrapper">
          <!-- Card 1 -->
          <div class="feature-card-3d active">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon">🤖</span>
                </div>
                <h3>الذكاء الاصطناعي التوليدي</h3>
                <p>استكشف نماذج اللغة الكبيرة (LLMs)، التعلم العميق، وتطبيقات الذكاء الاصطناعي في المشاريع الواقعية.</p>
                <ul class="feature-list">
                  <li>✓ تعلم الآلة المتقدم</li>
                  <li>✓ الشبكات العصبية العميقة</li>
                  <li>✓ معالجة اللغة الطبيعية</li>
                </ul>
                <a href="/Th-tech/ai/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=500&h=350&fit=crop" alt="AI" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon"></span>
                </div>
                <h3>الأمن السيبراني المتقدم</h3>
                <p>تقنيات الحماية الاستباقية، التحليل الجنائي الرقمي، واستراتيجيات الدفاع السيبراني.</p>
                <ul class="feature-list">
                  <li>✓ الاختراق الأخلاقي</li>
                  <li>✓ تحليل الثغرات الأمنية</li>
                  <li>✓ استراتيجيات الدفاع</li>
                </ul>
                <a href="/Th-tech/security/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=500&h=350&fit=crop" alt="Security" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon">☁️</span>
                </div>
                <h3>الحوسبة السحابية والبنية التحتية</h3>
                <p>نشر وإدارة التطبيقات على AWS، Azure، وGoogle Cloud مع أفضل ممارسات DevOps.</p>
                <ul class="feature-list">
                  <li>✓ AWS و Azure و GCP</li>
                  <li>✓ البنية التحتية ككود</li>
                  <li>✓ DevOps و CI/CD</li>
                </ul>
                <a href="/Th-tech/cloud/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=500&h=350&fit=crop" alt="Cloud" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="feature-card-3d">
            <div class="card-3d-inner">
              <div class="card-3d-content">
                <div class="card-icon-wrapper">
                  <span class="card-icon">⚡</span>
                </div>
                <h3>هندسة البرمجيات الحديثة</h3>
                <p>منهجيات التطوير الرشيقة، الأنماط المعمارية المتقدمة، وبناء أنظمة قابلة للتوسع.</p>
                <ul class="feature-list">
                  <li>✓ الأنماط المعمارية</li>
                  <li>✓ التطوير الرشيقة</li>
                  <li>✓ الأنظمة القابلة للتوسع</li>
                </ul>
                <a href="/Th-tech/programming/" class="card-cta">اكتشف المسار →</a>
              </div>
              <div class="card-3d-image">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=500&h=350&fit=crop" alt="Programming" loading="lazy" />
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="cards-navigation">
          <button class="nav-btn prev-btn" aria-label="السابق">❮</button>
          <div class="cards-dots">
            <span class="dot active" data-index="0"></span>
            <span class="dot" data-index="1"></span>
            <span class="dot" data-index="2"></span>
            <span class="dot" data-index="3"></span>
          </div>
          <button class="nav-btn next-btn" aria-label="التالي"></button>
        </div>
      </div>
    </section>

    <!-- 🔹 Topics Grid -->
    <section class="topics-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">المجالات التقنية</h2>
        </div>
        
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card reveal-delay-1">
            <div class="topic-icon"></div>
            <h3>الذكاء الاصطناعي</h3>
            <p>تعلم الآلة والشبكات العصبية</p>
          </a>
          
          <a href="/Th-tech/programming/" class="topic-card reveal-delay-2">
            <div class="topic-icon">💻</div>
            <h3>البرمجة</h3>
            <p>لغات وأطر حديثة</p>
          </a>
          
          <a href="/Th-tech/security/" class="topic-card reveal-delay-3">
            <div class="topic-icon">️</div>
            <h3>الأمن السيبراني</h3>
            <p>حماية واختراق أخلاقي</p>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card reveal-delay-4">
            <div class="topic-icon">☁️</div>
            <h3>السحابة</h3>
            <p>AWS و Azure</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 Articles -->
    <section class="articles-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">أحدث المقالات</h2>
        </div>
        
        <div class="articles-grid">
          <article class="article-card reveal-delay-1">
            <div class="article-badge">جديد</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">AI</span>
                <span class="article-time">5 دقائق</span>
              </div>
              <h3>دليلك الشامل لتعلم الآلة</h3>
              <p>رحلة عملية من الصفر للاحتراف</p>
              <a href="/Th-tech/ai/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>

          <article class="article-card reveal-delay-2">
            <div class="article-badge popular">شائع</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">Cloud</span>
                <span class="article-time">8 دقائق</span>
              </div>
              <h3>أمن السحابة: أفضل الممارسات</h3>
              <p>استراتيجيات حماية متقدمة</p>
              <a href="/Th-tech/cloud/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>

          <article class="article-card reveal-delay-3">
            <div class="article-badge updated">محدّث</div>
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=250&fit=crop" alt="Article" loading="lazy" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-category">Code</span>
                <span class="article-time">6 دقائق</span>
              </div>
              <h3>البرمجة الكائنية: مفاهيم متقدمة</h3>
              <p>مبادئ SOLID والأنماط</p>
              <a href="/Th-tech/programming/" class="article-link">اقرأ المزيد →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 Why Us & Newsletter -->
    <section class="combined-section reveal">
      <div class="container">
        <div class="combined-grid">
          
          <div class="why-content">
            <h2 class="section-title text-right">لماذا Th.Tech؟</h2>
            <p class="why-desc">محتوى تقني معمق يُواكب أحدث الابتكارات العالمية.</p>
            
            <div class="why-features">
              <div class="why-feature">
                <div class="why-icon"></div>
                <div class="why-text">
                  <h4>محتوى تطبيقي</h4>
                  <p>أمثلة واقعية قابلة للتطبيق</p>
                </div>
              </div>
              <div class="why-feature">
                <div class="why-icon">🔄</div>
                <div class="why-text">
                  <h4>تحديث مستمر</h4>
                  <p>أحدث التقنيات أسبوعياً</p>
                </div>
              </div>
            </div>
          </div>

          <div class="newsletter-box">
            <div class="newsletter-bg"></div>
            <div class="newsletter-content">
              <div class="newsletter-icon">📬</div>
              <h2>اشترك في النشرة</h2>
              <p>أحدث المقالات في بريدك</p>
              <form class="newsletter-form">
                <input type="email" placeholder="بريدك الإلكتروني" required />
                <button type="submit" class="btn btn-primary btn-glow">اشترك</button>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 🔹 CTA -->
    <section class="cta-section reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-content">
            <h2>🚀 ابدأ رحلتك الآن</h2>
            <p>انضم إلى مجتمع المطورين</p>
            <a href="/Th-tech/guides/" class="btn btn-light btn-large">تصفح الأدلة</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.15);
    --radius: 16px;
    --shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.15);
    --shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; line-height: 1.6; overflow-x: hidden; }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.2rem; }
  .section-header { text-align: center; margin-bottom: 2.5rem; }
  .section-title { font-size: 1.8rem; margin-bottom: 0.5rem; font-weight: 700; }
  .section-subtitle { color: var(--text-sec); font-size: 1rem; }
  .text-right { text-align: right; }

  /* Hero */
  .hero { position: relative; min-height: 85vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.35); }
  .overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(2,132,199,0.35) 0%, rgba(14,165,233,0.35) 100%); }
  .hero-content { position: relative; z-index: 1; padding: 2rem; max-width: 800px; }
  
  .hero-badge { display: inline-block; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); padding: 0.4rem 1.2rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.2); }
  
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem; font-weight: 800; line-height: 1.2; }
  .highlight { background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  
  .hero-desc { font-size: 1.05rem; opacity: 0.95; max-width: 600px; margin: 0 auto 2rem; }
  
  .hero-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.5rem; }
  
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1.8rem; border-radius: 10px; font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.3s; cursor: pointer; border: none; position: relative; overflow: hidden; }
  .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 15px rgba(2,132,199,0.3); }
  .btn-glow::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); transition: left 0.5s; }
  .btn-glow:hover::before { left: 100%; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(2,132,199,0.4); }
  .btn-outline { background: transparent; border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: var(--text); transform: translateY(-2px); }
  .btn-light { background: white; color: var(--primary); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
  .btn-large { padding: 0.9rem 2rem; font-size: 1rem; }
  
  .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; max-width: 500px; margin: 0 auto; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.2); }
  .stat-item { text-align: center; }
  .stat-number { display: block; font-size: 2rem; font-weight: 800; color: white; line-height: 1; margin-bottom: 0.3rem; }
  .stat-label { font-size: 0.85rem; opacity: 0.9; }
  
  .scroll-indicator { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; color: white; opacity: 0.6; animation: bounce 2s infinite; }
  .mouse { width: 24px; height: 36px; border: 2px solid white; border-radius: 18px; position: relative; }
  .wheel { width: 3px; height: 6px; background: white; border-radius: 2px; position: absolute; top: 6px; left: 50%; transform: translateX(-50%); animation: scroll 2s infinite; }
  @keyframes scroll { 0% { opacity: 1; transform: translateX(-50%) translateY(0); } 100% { opacity: 0; transform: translateX(-50%) translateY(12px); } }
  @keyframes bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(8px); } }

  /* Rotating Features with Auto-Scroll */
  .rotating-features { padding: 4rem 0; background: var(--bg); }
  .rotating-cards-wrapper { 
    position: relative; 
    max-width: 950px; 
    margin: 0 auto; 
    min-height: 380px;
    perspective: 1000px;
  }
  
  .feature-card-3d { 
    position: absolute; 
    top: 0; 
    left: 0; 
    right: 0; 
    opacity: 0; 
    transform: rotateY(90deg) translateX(50px); 
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1); 
    pointer-events: none; 
    z-index: 1;
  }
  .feature-card-3d.active { 
    opacity: 1; 
    transform: rotateY(0) translateX(0); 
    pointer-events: all; 
    z-index: 10;
  }
  
  .card-3d-inner { 
    background: var(--card); 
    border-radius: var(--radius); 
    padding: 2rem; 
    display: flex; 
    gap: 2rem; 
    align-items: center; 
    box-shadow: 0 10px 40px rgba(0,0,0,0.1); 
    border: 1px solid var(--border); 
    backdrop-filter: blur(10px);
  }
  
  .card-3d-content { flex: 1; }
  .card-icon-wrapper { position: relative; width: 70px; height: 70px; margin-bottom: 1.2rem; }
  .card-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; background: linear-gradient(135deg, var(--primary), var(--primary-light)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .card-3d-content h3 { font-size: 1.4rem; margin-bottom: 0.8rem; }
  .card-3d-content p { color: var(--text-sec); line-height: 1.7; margin-bottom: 1.2rem; font-size: 0.95rem; }
  .feature-list { list-style: none; margin-bottom: 1.5rem; padding: 0; }
  .feature-list li { padding: 0.4rem 0; color: var(--text-sec); font-size: 0.9rem; }
  
  .card-cta { color: var(--primary); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.95rem; transition: gap 0.3s; }
  .card-cta:hover { gap: 0.8rem; }
  
  .card-3d-image { width: 280px; height: 220px; border-radius: var(--radius); overflow: hidden; flex-shrink: 0; box-shadow: 0 8px 25px rgba(0,0,0,0.15); }
  .card-3d-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .feature-card-3d:hover .card-3d-image img { transform: scale(1.05); }
  
  .cards-navigation { display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 2.5rem; }
  .nav-btn { width: 45px; height: 45px; border-radius: 50%; background: var(--card); border: 2px solid var(--border); color: var(--primary); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.3s; }
  .nav-btn:hover { background: var(--primary); color: white; border-color: var(--primary); transform: scale(1.1); }
  .cards-dots { display: flex; gap: 0.8rem; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--border); cursor: pointer; transition: all 0.3s; }
  .dot.active { background: var(--primary); width: 35px; border-radius: 6px; }
  
  @media (max-width: 768px) {
    .card-3d-inner { flex-direction: column; padding: 1.5rem; }
    .card-3d-image { width: 100%; height: 200px; }
    .rotating-cards-wrapper { min-height: 550px; }
  }

  /* Topics */
  .topics-section { padding: 4rem 0; background: var(--card); }
  .topics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .topic-card { background: var(--bg); padding: 1.8rem; border-radius: var(--radius); text-align: center; text-decoration: none; color: var(--text); border: 1px solid var(--border); transition: all 0.3s; }
  .topic-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); border-color: var(--primary); }
  .topic-icon { font-size: 3rem; margin-bottom: 1rem; }
