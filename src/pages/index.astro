---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | نحو التميز التقني</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني. محتوى تقني معمق يواكب أحدث الابتكارات العالمية." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section -->
    <section class="hero reveal">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI Technology" loading="eager" />
        <div class="overlay"></div>
      </div>
      
      <div class="container hero-content">
        <span class="hero-badge reveal-delay-1">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          نحو المستقبل الرقمي
        </span>
        
        <h1 class="reveal-delay-2">
          <span class="typing-text">اكتشف آفاق الذكاء الاصطناعي والابتكار التقني</span>
        </h1>
        
        <p class="hero-desc reveal-delay-3">
          منصة عربية رائدة تُقدّم محتوى تقنياً معمقاً في مجالات الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني — مصممة لتمكين المطورين والمبتكرين من بناء الغد.
        </p>
        
        <div class="hero-buttons reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            استكشف الأدلة
          </a>
          <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
        </div>
      </div>
    </section>

    <!-- 🔹 Stats Section -->
    <section class="stats reveal">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <span class="counter" data-target="150" data-suffix="+">0</span>
            <span class="counter-label">دليل شامل</span>
          </div>
          <div class="stat-item">
            <span class="counter" data-target="50" data-suffix="K+">0</span>
            <span class="counter-label">قارئ شهرياً</span>
          </div>
          <div class="stat-item">
            <span class="counter" data-target="100" data-suffix="%">0</span>
            <span class="counter-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Auto-Rotating Cards (Testimonials/Features) -->
    <section class="rotating-section reveal">
      <div class="container">
        <h2 class="section-title">مسارات التعلّم المتقدمة</h2>
        
        <div class="rotating-cards" id="rotatingCards">
          <!-- Card 1 -->
          <div class="rotating-card active">
            <div class="card-content">
              <div class="card-icon">🤖</div>
              <h3>الذكاء الاصطناعي التوليدي</h3>
              <p>استكشف نماذج اللغة الكبيرة (LLMs)، التعلم العميق، وتطبيقات الذكاء الاصطناعي التوليدي في المشاريع الواقعية.</p>
              <a href="/Th-tech/ai/" class="card-link">اكتشف المزيد →</a>
            </div>
            <div class="card-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
            </div>
          </div>

          <!-- Card 2 -->
          <div class="rotating-card">
            <div class="card-content">
              <div class="card-icon">🔒</div>
              <h3>الأمن السيبراني المتقدم</h3>
              <p>تقنيات الحماية الاستباقية، التحليل الجنائي الرقمي، واستراتيجيات الدفاع السيبراني في البيئات المعقدة.</p>
              <a href="/Th-tech/security/" class="card-link">اكتشف المزيد →</a>
            </div>
            <div class="card-image">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
            </div>
          </div>

          <!-- Card 3 -->
          <div class="rotating-card">
            <div class="card-content">
              <div class="card-icon">☁️</div>
              <h3>الحوسبة السحابية والبنية التحتية</h3>
              <p>نشر وإدارة التطبيقات على AWS، Azure، وGoogle Cloud مع أفضل ممارسات DevOps والبنية التحتية ككود.</p>
              <a href="/Th-tech/cloud/" class="card-link">اكتشف المزيد →</a>
            </div>
            <div class="card-image">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" />
            </div>
          </div>

          <!-- Card 4 -->
          <div class="rotating-card">
            <div class="card-content">
              <div class="card-icon">⚡</div>
              <h3>هندسة البرمجيات الحديثة</h3>
              <p>منهجيات التطوير الرشيقة، الأنماط المعمارية المتقدمة، وبناء أنظمة قابلة للتوسع والصيانة.</p>
              <a href="/Th-tech/programming/" class="card-link">اكتشف المزيد →</a>
            </div>
            <div class="card-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" loading="lazy" />
            </div>
          </div>
        </div>

        <!-- Navigation Dots -->
        <div class="rotating-dots">
          <span class="dot active" data-index="0"></span>
          <span class="dot" data-index="1"></span>
          <span class="dot" data-index="2"></span>
          <span class="dot" data-index="3"></span>
        </div>
      </div>
    </section>

    <!-- 🔹 Topics Grid -->
    <section class="topics reveal">
      <div class="container">
        <h2 class="section-title">المجالات التقنية</h2>
        
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card reveal-delay-1">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=400&h=250&fit=crop" alt="AI" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة، الشبكات العصبية، وتطبيقات الـ AI</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/programming/" class="topic-card reveal-delay-2">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=250&fit=crop" alt="Programming" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>البرمجة</h3>
              <p>لغات البرمجة، الأطر الحديثة، وهندسة البرمجيات</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/security/" class="topic-card reveal-delay-3">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=400&h=250&fit=crop" alt="Security" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات، الاختراق الأخلاقي، والدفاع الرقمي</p>
              <span class="arrow">→</span>
            </div>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card reveal-delay-4">
            <div class="topic-img">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400&h=250&fit=crop" alt="Cloud" loading="lazy" />
            </div>
            <div class="topic-content">
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، وGoogle Cloud</p>
              <span class="arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 Latest Articles Section (New) -->
    <section class="articles reveal">
      <div class="container">
        <h2 class="section-title">أحدث المقالات</h2>
        <div class="articles-grid">
          <article class="article-card reveal-delay-1">
            <div class="article-badge">جديد</div>
            <h3>دليلك الشامل لتعلم الآلة في 2026</h3>
            <p>رحلة عملية من الصفر إلى الاحتراف في تعلم الآلة مع أمثلة تطبيقية</p>
            <a href="/Th-tech/ai/" class="article-link">اقرأ المقال</a>
          </article>
          <article class="article-card reveal-delay-2">
            <div class="article-badge">شائع</div>
            <h3>أمن السحابة: أفضل الممارسات</h3>
            <p>استراتيجيات حماية متقدمة لتطبيقاتك السحابية على AWS و Azure</p>
            <a href="/Th-tech/cloud/" class="article-link">اقرأ المقال</a>
          </article>
          <article class="article-card reveal-delay-3">
            <div class="article-badge">محدّث</div>
            <h3>البرمجة الكائنية: مفاهيم متقدمة</h3>
            <p>تعمّق في مبادئ SOLID والأنماط التصميمية الاحترافية</p>
            <a href="/Th-tech/programming/" class="article-link">اقرأ المقال</a>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 Why Us Section -->
    <section class="why-us reveal">
      <div class="container">
        <h2 class="section-title">لماذا Th.Tech؟</h2>
        <div class="features-grid">
          <div class="feature reveal-delay-1">
            <div class="feature-icon">⚡</div>
            <h3>محتوى تطبيقي</h3>
            <p>شروحات عملية مع أمثلة واقعية قابلة للتطبيق الفوري</p>
          </div>
          <div class="feature reveal-delay-2">
            <div class="feature-icon">🔄</div>
            <h3>تحديث مستمر</h3>
            <p>محتوى يُحدَّث أسبوعياً بأحدث التقنيات والاتجاهات العالمية</p>
          </div>
          <div class="feature reveal-delay-3">
            <div class="feature-icon">🎯</div>
            <h3>مسار تعلم واضح</h3>
            <p>من الأساسيات إلى الاحتراف مع مسارات تعلم منظمة</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Newsletter Section (New) -->
    <section class="newsletter reveal">
      <div class="container">
        <div class="newsletter-box">
          <div class="newsletter-icon">📬</div>
          <h2>اشترك في نشرتنا البريدية</h2>
          <p>احصل على أحدث المقالات والشروحات مباشرة في بريدك</p>
          <form class="newsletter-form">
            <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
            <button type="submit" class="btn btn-primary">اشترك الآن</button>
          </form>
          <p class="newsletter-note"> نحمي خصوصيتك. لا رسائل مزعجة.</p>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA Section -->
    <section class="cta reveal">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك التقنية اليوم</h2>
          <p>انضم إلى مجتمع المطورين والمبتكرين الذين يبنون مستقبل التكنولوجيا</p>
          <a href="/Th-tech/guides/" class="btn btn-light">تصفح الأدلة الشاملة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --border: rgba(2,132,199,0.15);
    --radius: 12px;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --border: rgba(56,189,248,0.15);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  html { 
    scroll-behavior: smooth; 
    scroll-padding-top: 80px;
  }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container { 
    max-width: 1000px; 
    margin: 0 auto; 
    padding: 0 1.2rem; 
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4);
  }
  
  .hero-content {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.2);
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
    backdrop-filter: blur(10px);
  }
  
  .badge-icon { width: 16px; height: 16px; }
  
  .hero h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin-bottom: 0.8rem;
    font-weight: 800;
  }
  
  .typing-text {
    display: inline-block;
    border-right: 2px solid white;
    white-space: nowrap;
    overflow: hidden;
    animation: typing 2.5s steps(25, end), blink 0.75s step-end infinite;
  }
  
  @keyframes typing { from { width: 0; } to { width: 100%; } }
  @keyframes blink { 50% { border-color: transparent; } }
  
  @media (max-width: 768px) {
    .typing-text {
      animation: none;
      border: none;
      white-space: normal;
    }
  }
  
  .hero-desc {
    font-size: 1rem;
    opacity: 0.9;
    max-width: 650px;
    margin: 0 auto 1.5rem;
  }
  
  .hero-buttons {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s;
    cursor: pointer;
    border: none;
  }
  
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { transform: translateY(-2px); background: var(--primary-dark); }
  
  .btn-outline { background: transparent; border: 2px solid white; color: white; }
  .btn-outline:hover { background: white; color: var(--text); }
  
  .btn-light { background: white; color: var(--primary); }
  .btn-light:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }

  /* Stats */
  .stats {
    padding: 2rem 0;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }
  
  .counter {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--primary);
    display: block;
    line-height: 1;
  }
  
  .counter-label {
    color: var(--text-sec);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }
  
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; gap: 1rem; }
    .counter { font-size: 1.5rem; }
  }

  /* Rotating Cards Section */
  .rotating-section {
    padding: 3rem 0;
    background: var(--bg);
  }
  
  .section-title {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--text);
  }
  
  .rotating-cards {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    min-height: 350px;
  }
  
  .rotating-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--card);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    gap: 2rem;
    align-items: center;
    opacity: 0;
    transform: translateX(50px);
    transition: all 0.5s ease;
    border: 1px solid var(--border);
    pointer-events: none;
  }
  
  .rotating-card.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: all;
  }
  
  .card-content {
    flex: 1;
  }
  
  .card-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .card-content h3 {
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
    color: var(--text);
  }
  
  .card-content p {
    color: var(--text-sec);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  
  .card-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: gap 0.3s;
  }
  
  .card-link:hover {
    gap: 0.6rem;
  }
  
  .card-image {
    width: 250px;
    height: 200px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
  }
  
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .rotating-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .dot.active {
    background: var(--primary);
    width: 30px;
    border-radius: 5px;
  }
  
  @media (max-width: 768px) {
    .rotating-card {
      flex-direction: column;
      padding: 1.5rem;
    }
    .card-image {
      width: 100%;
      height: 180px;
    }
    .rotating-cards { min-height: 450px; }
  }

  /* Topics */
  .topics {
    padding: 3rem 0;
    background: var(--card);
  }
  
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  
  .topic-card {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  
  .topic-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }
  
  .topic-img {
    height: 140px;
    overflow: hidden;
  }
  
  .topic-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  
  .topic-card:hover .topic-img img {
    transform: scale(1.05);
  }
  
  .topic-content {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .topic-content h3 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  
  .topic-content p {
    color: var(--text-sec);
    font-size: 0.85rem;
    margin-bottom: 0.8rem;
    flex: 1;
  }
  
  .arrow {
    color: var(--primary);
    font-size: 1.2rem;
    font-weight: bold;
    transition: transform 0.3s;
  }
  
  .topic-card:hover .arrow {
    transform: translateX(3px);
  }
  
  @media (max-width: 768px) {
    .topics-grid { grid-template-columns: 1fr; }
    .topic-img { height: 120px; }
  }

  /* Articles Section */
  .articles {
    padding: 3rem 0;
    background: var(--bg);
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  .article-card {
    background: var(--card);
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    position: relative;
