---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | المستقبل الرقمي يبدأ هنا</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، البرمجة، والأمن السيبراني." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- Hero Section -->
    <section class="section hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI" loading="eager" />
        <div class="overlay"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <span class="badge"> منصة المطورين العربية</span>
          <h1><span class="gradient">ابنِ غدك الرقمي</span><br />معنا</h1>
          <p class="hero-text">شروحات عملية في الذكاء الاصطناعي، البرمجة، والأمن السيبراني. تعلم، طبق، وتميز.</p>
          <div class="hero-actions">
            <a href="/Th-tech/guides/" class="btn btn-primary">استكشف الأدلة</a>
            <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="section stats-bar">
      <div class="container">
        <div class="stats-grid">
          <div class="stat">
            <span class="stat-num counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Code Editor -->
    <section class="section editor-section" id="editor">
      <div class="container">
        <div class="section-head">
          <h2>محرر الأكواد التفاعلي</h2>
          <p>اكتب، شغّل، واختبر كودك مباشرة في المتصفح - يدعم JavaScript و Python</p>
        </div>

        <div class="editor-wrapper">
          <div class="editor-header">
            <div class="editor-tabs">
              <button class="tab active" onclick="setLanguage('javascript')">JavaScript</button>
              <button class="tab" onclick="setLanguage('python')">Python</button>
              <button class="tab" onclick="setLanguage('html')">HTML/CSS</button>
            </div>
            <div class="editor-controls">
              <button class="btn-reset" onclick="resetCode()" title="إعادة"></button>
              <button class="btn-run" onclick="runCode()">▶ تشغيل الكود</button>
            </div>
          </div>

          <div class="editor-main">
            <div class="editor-pane">
              <div class="pane-header">
                <span>📝 المحرر</span>
                <span class="lang-badge" id="langBadge">JavaScript</span>
              </div>
              <textarea id="codeInput" class="code-area" spellcheck="false" placeholder="// اكتب الكود هنا..."></textarea>
            </div>
            
            <div class="editor-pane">
              <div class="pane-header">
                <span> المخرجات</span>
                <button class="btn-clear" onclick="clearOutput()">مسح</button>
              </div>
              <div id="output" class="output-area">
                <div class="output-placeholder">
                  <span class="icon">💡</span>
                  <p>اكتب كوداً ثم اضغط "تشغيل الكود"</p>
                </div>
              </div>
            </div>
          </div>

          <div class="editor-footer">
            <span id="status">✅ جاهز</span>
            <span class="separator">|</span>
            <span id="pyStatus" style="display:none; color:#fbbf24;">⏳ Python Loading...</span>
          </div>
        </div>

        <div class="examples-bar">
          <span>أمثلة سريعة:</span>
          <button class="btn-example" onclick="loadExample('hello')">Hello World</button>
          <button class="btn-example" onclick="loadExample('calc')">آلة حاسبة</button>
          <button class="btn-example" onclick="loadExample('loop')">تكرار</button>
        </div>
      </div>
    </section>

    <!-- Topics -->
    <section class="section topics">
      <div class="container">
        <div class="section-head">
          <h2>اختر مسارك</h2>
        </div>
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" /></div>
            <div class="topic-body">
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة والشبكات العصبية</p>
            </div>
          </a>
          <a href="/Th-tech/programming/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" /></div>
            <div class="topic-body">
              <h3>البرمجة</h3>
              <p>لغات وأطر حديثة</p>
            </div>
          </a>
          <a href="/Th-tech/security/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" /></div>
            <div class="topic-body">
              <h3>الأمن السيبراني</h3>
              <p>حماية واختراق أخلاقي</p>
            </div>
          </a>
          <a href="/Th-tech/cloud/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" /></div>
            <div class="topic-body">
              <h3>السحابة</h3>
              <p>AWS و Azure</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك</h2>
          <p>انضم إلى آلاف المطورين</p>
          <a href="/Th-tech/guides/" class="btn btn-light">تصفح الأدلة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #0a0e1a;
    --bg-secondary: #111827;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --primary: #3b82f6;
    --primary-dark: #2563eb;
    --accent: #10b981;
    --border: #334155;
    --radius: 12px;
    --font-main: 'Cairo', sans-serif;
    --font-code: 'Fira Code', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--text); font-family: var(--font-main); line-height: 1.6; }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .section { padding: 5rem 0; }
  .section-head { text-align: center; margin-bottom: 3rem; }
  .section-head h2 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; background: linear-gradient(135deg, #fff, var(--primary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .section-head p { color: var(--text-muted); font-size: 1.1rem; }

  /* Hero */
  .hero { min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; position: relative; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.35); }
  .overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(59,130,246,0.4), rgba(15,23,42,0.9)); }
  .hero-content { max-width: 700px; padding: 2rem; z-index: 1; }
  .badge { display: inline-block; background: rgba(59,130,246,0.2); color: var(--primary); padding: 0.5rem 1.2rem; border-radius: 50px; font-size: 0.9rem; font-weight: 600; margin-bottom: 1.5rem; border: 1px solid rgba(59,130,246,0.3); }
  .hero h1 { font-size: clamp(2.5rem, 6vw, 3.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.2rem; }
  .gradient { background: linear-gradient(135deg, #fff, #60a5fa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-text { font-size: 1.2rem; color: #cbd5e1; margin-bottom: 2.5rem; line-height: 1.7; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.9rem 2.2rem; border-radius: 10px; font-weight: 700; font-size: 1rem; transition: all 0.3s; cursor: pointer; border: none; text-decoration: none; }
  .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 15px rgba(59,130,246,0.4); }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(59,130,246,0.5); }
  .btn-outline { background: transparent; border: 2px solid rgba(255,255,255,0.3); color: white; }
  .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; transform: translateY(-3px); }
  .btn-light { background: white; color: var(--primary-dark); }
  .btn-light:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }

  /* Stats */
  .stats-bar { background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 2.5rem 0; }
  .stats-grid { display: flex; align-items: center; justify-content: center; gap: 4rem; }
  .stat { text-align: center; }
  .stat-num { display: block; font-size: 2.5rem; font-weight: 800; color: var(--primary); line-height: 1; }
  .stat-label { font-size: 0.95rem; color: var(--text-muted); margin-top: 0.5rem; font-weight: 600; }
  .stat-divider { width: 1px; height: 50px; background: var(--border); }

  /* Code Editor - Professional */
  .editor-section { background: var(--bg-secondary); }
  
  .editor-wrapper {
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: rgba(15,23,42,0.5);
    border-bottom: 1px solid var(--border);
  }

  .editor-tabs { display: flex; gap: 0.5rem; }
  .tab {
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-muted);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-family: var(--font-main);
  }
  .tab:hover { color: var(--text); background: rgba(59,130,246,0.1); }
  .tab.active { background: var(--primary); color: white; border-color: var(--primary); }

  .editor-controls { display: flex; gap: 0.8rem; align-items: center; }
  
  .btn-reset {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.3s;
  }
  .btn-reset:hover { background: var(--primary); color: white; border-color: var(--primary); transform: rotate(180deg); }

  .btn-run {
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.7rem 1.8rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(16,185,129,0.3);
  }
  .btn-run:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16,185,129,0.4); }
  .btn-run:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .editor-main { display: grid; grid-template-columns: 1fr 1fr; min-height: 500px; }

  .editor-pane { display: flex; flex-direction: column; }
  .editor-pane:first-child { border-left: 1px solid var(--border); }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    background: rgba(15,23,42,0.3);
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .lang-badge {
    background: var(--primary);
    color: white;
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.3s;
  }
  .btn-clear:hover { background: #ef4444; color: white; border-color: #ef4444; }

  .code-area {
    flex: 1;
    background: var(--bg);
    color: #e2e8f0;
    border: none;
    padding: 1.5rem;
    font-family: var(--font-code);
    font-size: 0.95rem;
    line-height: 1.7;
    resize: none;
    tab-size: 2;
  }
  .code-area:focus { outline: none; }

  .output-area {
    flex: 1;
    background: var(--bg);
    padding: 1.5rem;
    font-family: var(--font-code);
    font-size: 0.9rem;
    overflow-y: auto;
    color: #e2e8f0;
    white-space: pre-wrap;
  }

  .output-placeholder {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }
  .output-placeholder .icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
  .output-placeholder p { font-size: 1rem; }

  .editor-footer {
    padding: 0.8rem 1.5rem;
    background: rgba(15,23,42,0.5);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .separator { opacity: 0.5; }

  .examples-bar {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .btn-example {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s;
  }
  .btn-example:hover { background: var(--primary); border-color: var(--primary); color: white; transform: translateY(-2px); }

  /* Topics */
  .topics { background: var(--bg); }
  .topics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .topic-card {
    background: var(--card);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s;
    text-decoration: none;
    color: var(--text);
  }
  .topic-card:hover { transform: translateY(-8px); border-color: var(--primary); box-shadow: 0 15px 40px rgba(59,130,246,0.2); }
  .topic-img { height: 200px; overflow: hidden; }
  .topic-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .topic-card:hover .topic-img img { transform: scale(1.08); }
  .topic-body { padding: 1.8rem; }
  .topic-body h3 { font-size: 1.3rem; margin-bottom: 0.6rem; color: #fff; }
  .topic-body p { color: var(--text-muted); font-size: 1rem; }

  /* CTA */
  .cta { background: var(--bg-secondary); padding: 6rem 2rem; }
  .cta-box {
    max-width: 650px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    padding: 3.5rem 3rem;
    border-radius: 20px;
    color: white;
    box-shadow: 0 20px 60px rgba(59,130,246,0.3);
  }
  .cta-box h2 { font-size: 2.2rem; margin-bottom: 1rem; }
  .cta-box p { opacity: 0.95; margin-bottom: 2rem; font-size: 1.15rem; }

  /* Responsive */
  @media (max-width: 1024px) {
    .topics-grid { grid-template-columns: 1fr 1fr; }
    .editor-main { grid-template-columns: 1fr; }
    .editor-pane:first-child { border-left: none; border-bottom: 1px solid var(--border); }
    .code-area, .output-area { min-height: 300px; }
  }

  @media (max-width: 768px) {
    .hero { min-height: auto; padding: 6rem 0 4rem; }
    .hero h1 { font-size: 2.2rem; }
    .hero-actions { flex-direction: column; }
    .btn { width: 100%; }
    
    .stats-grid { flex-direction: column; gap: 2rem; }
    .stat-divider { width: 100%; height: 1px; }
    
    .topics-grid { grid-template-columns: 1fr; }
    
    .editor-header { flex-direction: column; gap: 1rem; }
    .editor-tabs { width: 100%; justify-content: center; }
    .editor-controls { width: 100%; justify-content: space-between; }
    
    .section { padding: 3rem 0; }
    .container { padding: 0 1.2rem; }
  }
</style>

<script>
  // Counter Animation
  function initCounters() {
    const counters = document.querySelectorAll('.counter');
    counters.forEach(counter => {
      const target = parseInt(counter.dataset.target);
      const suffix = counter.dataset.suffix || '';
      const duration = 2000;
      const step = target / (duration / 16);
      let current = 0;
      
      const timer = setInterval(() => {
        current += step;
        if (current >= target) {
          counter.textContent = target + suffix;
          clearInterval(timer);
        } else {
          counter.textContent = Math.floor(current) + suffix;
        }
      }, 16);
    });
  }

  // Code Examples
  const examples = {
    javascript: {
      hello: 'console.log(" مرحباً بالعالم!");\nconsole.log("أهلاً بك في Th.Tech");',
      calc: 'const a = 10;\nconst b = 5;\n\nconsole.log("الجمع:", a + b);\nconsole.log("الطرح:", a - b);\nconsole.log("الضرب:", a * b);\nconsole.log("القسمة:", a / b);',
      loop: 'for (let i = 1; i <= 5; i++) {\n  console.log("الرقم:", i);\n}\n\nconst arr = [1, 2, 3, 4, 5];\nconsole.log("المجموع:", arr.reduce((a, b) => a + b, 0));'
    },
    python: {
      hello: 'print("👋 مرحباً بالعالم!")\nprint("أهلاً بك في Th.Tech")',
      calc: 'a = 10\nb = 5\n\nprint("الجمع:", a + b)\nprint("الطرح:", a - b)\nprint("الضرب:", a * b)\nprint("القسمة:", a / b)',
      loop: 'for i in range(1, 6):\n    print("الرقم:", i)\n\narr = [1, 2, 3, 4, 5]\nprint("المجموع:", sum(arr))'
    },
    html: {
      hello: '<h1 style="color: #3b82f6; text-align: center;">👋 مرحباً!</h1>\n<p style="text-align: center; color: #94a3b8;">أهلاً بك في Th.Tech</p>',
      calc: '<div style="text-align: center; padding: 2rem;">\n  <h2 style="color: #10b981;">النتيجة: 15</h2>\n  <p>10 + 5 = 15</p>\n</div>',
      loop: '<ul style="list-style: none; padding: 1rem;">\n  <li style="padding: 0.5rem; background: #1e293b; margin: 0.5rem 0; border-radius: 8px;">📌 عنصر 1</li>\n  <li style="padding: 0.5rem; background: #1e293b; margin: 0.5rem 0; border-radius: 8px;">📌 عنصر 2</li>\n  <li style="padding: 0.5rem; background: #1e293b; margin: 0.5rem 0; border-radius: 8px;">📌 عنصر 3</li>\n</ul>'
    }
  };

  let currentLang = 'javascript';
  let pyodide = null;
  let pyodideReady = false;

  // Initialize
  function init() {
    const textarea = document.getElementById('codeInput');
    if (textarea) {
      textarea.value = examples.javascript.hello;
    }
    loadPyodideRuntime();
  }

  // Load Pyodide
  async function loadPyodideRuntime() {
    const statusEl = document.getElementById('pyStatus');
    try {
      pyodide = await loadPyodide({
        indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/"
      });
      pyodideReady = true;
      if (statusEl) {
        statusEl.style.display = 'none';
      }
    } catch (error) {
      console.error('Pyodide load failed:', error);
      if (statusEl) {
        statusEl.textContent = '❌ Python Failed';
        statusEl.style.color = '#ef4444';
      }
    }
  }

  // Set Language
  function setLanguage(lang) {
    currentLang = lang;
    
    // Update tabs
    document.querySelectorAll('.tab').forEach(tab => {
      tab.classList.remove('active');
      if (tab.textContent.toLowerCase().includes(lang === 'javascript' ? 'javascript' : lang === 'python' ? 'python' : 'html')) {
        tab.classList.add('active');
      }
    });
    
    // Update badge
    const badge = document.getElementById('langBadge');
    if (badge) {
      const names = { javascript: 'JavaScript', python: 'Python', html: 'HTML/CSS' };
      badge.textContent = names[lang];
    }
    
    // Load example
    const textarea = document.getElementById('codeInput');
    if (textarea && examples[lang]) {
      textarea.value = examples[lang].hello;
    }
    
    // Show Python status
    const pyStatus = document.getElementById('pyStatus');
    if (pyStatus) {
      pyStatus.style.display = lang === 'python' ? 'inline' : 'none';
    }
    
    clearOutput();
    updateStatus('✅ جاهز');
  }

  // Run Code
  async function runCode() {
    const code = document.getElementById('codeInput').value;
    const output = document.getElementById('output');
    const runBtn = document.querySelector('.btn-run');
    
    if (!code.trim()) {
      output.innerHTML = '<div style="color: #fbbf24; padding: 1rem;">⚠️ يرجى كتابة كود أولاً</div>';
      return;
    }
    
    output.innerHTML = '<div style="color: #94a3b8; padding: 1rem;">⏳ جاري التنفيذ...</div>';
    if (runBtn) runBtn.disabled = true;
    
    try {
      if (currentLang === 'javascript') {
        await runJavaScript(code, output);
      } else if (currentLang === 'python') {
        await runPython(code, output);
      } else if (currentLang === 'html') {
        output.innerHTML = code;
      }
      updateStatus('✅ تم التنفيذ');
    } catch (error) {
      output.innerHTML = '<div style="color: #ef4444; padding: 1rem;">❌ خطأ: ' + error.message + '</div>';
      updateStatus('❌ حدث خطأ');
    } finally {
      if (runBtn) runBtn.disabled = false;
    }
  }

  // Run JavaScript
  async function runJavaScript(code, output) {
    const logs = [];
    const customConsole = {
      log: (...args) => logs.push(args.map(arg => typeof arg === 'object' ? JSON.stringify(arg, null, 2) : String(arg)).join(' ')),
      error: (...args) => logs.push('❌ ' + args.join(' ')),
      warn: (...args) => logs.push('⚠️ ' + args.join(' '))
    };
    
    try {
      const fn = new Function('console', code);
      fn(customConsole);
      
      if (logs.length > 0) {
        output.innerHTML = '<div style="color: #e2e8f0;">' + logs.join('<br>') + '</div>';
      } else {
        output.innerHTML = '<div style="color: #10b981; padding: 1rem;">✅ تم التنفيذ بنجاح<br><small>(لا توجد مخرجات)</small></div>';
      }
    } catch (error) {
      throw error;
    }
  }

  // Run Python
  async function runPython(code, output) {
    if (!pyodideReady) {
      output.innerHTML = '<div style="color: #fbbf24; padding: 1rem;">⏳ جاري تحميل Python...<br><small>قد يستغرق بضع ثوانٍ</small></div>';
      await loadPyodideRuntime();
      if (!pyodideReady) {
        throw new Error('فشل تحميل Python');
      }
    }
    
    let result = '';
    pyodide.setStdout({ batched: (msg) => { result += msg; } });
    pyodide.setStderr({ batched: (msg) => { result += '❌ ' + msg; } });
    
    try {
      await pyodide.runPythonAsync(code);
      
      if (result.trim()) {
        output.innerHTML = '<div style="color: #e2e8f0; white-space: pre-wrap;">' + result + '</div>';
      } else {
        output.innerHTML = '<div style="color: #10b981; padding: 1rem;">✅ تم التنفيذ بنجاح<br><small>(لا توجد مخرجات)</small></div>';
      }
    } catch (error) {
      throw error;
    }
  }

  // Clear Output
  function clearOutput() {
    const output = document.getElementById('output');
    if (output) {
      output.innerHTML = '<div class="output-placeholder"><span class="icon">💡</span><p>اكتب كوداً ثم اضغط "تشغيل الكود"</p></div>';
    }
    updateStatus('✅ جاهز');
  }

  // Reset Code
  function resetCode() {
    const textarea = document.getElementById('codeInput');
    if (textarea) {
      textarea.value = examples[currentLang].hello;
    }
    clearOutput();
    updateStatus('🔄 تم إعادة الكود');
  }

  // Load Example
  function loadExample(type) {
    const textarea = document.getElementById('codeInput');
    if (textarea && examples[currentLang] && examples[currentLang][type]) {
      textarea.value = examples[currentLang][type];
      clearOutput();
      updateStatus('📝 تم تحميل المثال');
    }
  }

  // Update Status
  function updateStatus(msg) {
    const status = document.getElementById('status');
    if (status) status.textContent = msg;
  }

  // Tab Support
  document.addEventListener('keydown', (e) => {
    if (e.target.id === 'codeInput' && e.key === 'Tab') {
      e.preventDefault();
      const start = e.target.selectionStart;
      const end = e.target.selectionEnd;
      e.target.value = e.target.value.substring(0, start) + '  ' + e.target.value.substring(end);
      e.target.selectionStart = e.target.selectionEnd = start + 2;
    }
    
    // Ctrl+Enter to run
    if (e.ctrlKey && e.key === 'Enter' && e.target.id === 'codeInput') {
      runCode();
    }
  });

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
