---

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />  <title>Th.Tech | المنصة التقنية</title>
  <meta
    name="description"
    content="Th.Tech — منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والسحابة."
  />  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
</head><body>
  <Header />  <main><!-- =========================================================
     HERO
========================================================== -->
<section class="hero">

  <div class="hero-bg">
    <img
      src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=85"
      alt="Th.Tech Technology"
    />
    <div class="hero-overlay"></div>
    <div class="hero-grid"></div>
    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div>
  </div>

  <div class="container hero-container">

    <div class="hero-content">

      <div class="badge">
        <span class="badge-dot"></span>
        <i class="fas fa-rocket"></i>
        اكتشف، تعلّم، وابتكر
      </div>

      <h1>
        ابنِ
        <span id="typewriter" class="gradient-text"></span>
        <span class="cursor">|</span>
      </h1>

      <p class="hero-description">
        منصة تقنية عربية تجمع بين المعرفة، البرمجة، الأدوات التفاعلية
        والتقنيات الحديثة في تجربة تعليمية واحدة.
      </p>

      <div class="hero-actions">

        <a href="/Th-tech/playground/" class="btn btn-primary">
          <i class="fas fa-code"></i>
          <span>ابدأ البرمجة الآن</span>
          <i class="fas fa-arrow-left btn-arrow"></i>
        </a>

        <a href="/Th-tech/guides/" class="btn btn-secondary">
          <i class="fas fa-book-open"></i>
          <span>تصفح المكتبة</span>
        </a>

      </div>

      <div class="hero-features">

        <div class="hero-feature">
          <span class="feature-check">
            <i class="fas fa-bolt"></i>
          </span>
          <span>تنفيذ فوري</span>
        </div>

        <div class="hero-feature">
          <span class="feature-check">
            <i class="fas fa-shield-alt"></i>
          </span>
          <span>بيئة آمنة</span>
        </div>

        <div class="hero-feature">
          <span class="feature-check">
            <i class="fas fa-gift"></i>
          </span>
          <span>مجاني تماماً</span>
        </div>

      </div>

    </div>

    <!-- =====================================================
         HERO VISUAL
    ====================================================== -->
    <div class="hero-visual">

      <div class="visual-orbit orbit-one"></div>
      <div class="visual-orbit orbit-two"></div>

      <div class="visual-center">
        <div class="center-icon">
          <i class="fas fa-code"></i>
        </div>

        <div class="center-lines">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="center-label">
          <strong>TH.TECH</strong>
          <small>Digital Future</small>
        </div>
      </div>

      <div class="float-card card-1">

        <div class="card-icon python-icon">
          <i class="fab fa-python"></i>
        </div>

        <div class="code-box">
          <div>print("مرحباً")</div>
          <div class="code-comment"># Python 3.11</div>
        </div>

      </div>

      <div class="float-card card-2">
        <div class="small-icon js-icon">
          <i class="fab fa-js"></i>
        </div>
        <span>JavaScript</span>
      </div>

      <div class="float-card card-3">
        <div class="small-icon terminal-icon">
          <i class="fas fa-terminal"></i>
        </div>
        <span>Terminal</span>
      </div>

      <div class="float-card card-4">
        <div class="small-icon success-icon">
          <i class="fas fa-check"></i>
        </div>
        <span>+150 درس</span>
      </div>

    </div>

  </div>

  <div class="scroll-indicator">
    <span>اكتشف المزيد</span>
    <i class="fas fa-chevron-down"></i>
  </div>

</section>


