---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const playgroundHref = `${base}/playground/`;
const toolsHref = `${base}/tools/`;
const articlesHref = `${base}/guides/`;
const tracksHref = `${base}/programming/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | المنصة التقنية</title>

  <meta
    name="description"
    content="Th.Tech منصة تقنية عربية تجمع بين الأدوات التفاعلية، المقالات، الشروحات، مسارات التعلم ومختبر الأكواد."
  />

  <link rel="canonical" href={`${siteUrl}${base}/`} />
  <link rel="icon" type="image/png" href={`${base}/Th-tech/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script is:inline>
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark-mode');
      }
    } catch {}
  </script>
</head>

<body>
  <Header />

  <!-- =====================================================
       HERO
  ====================================================== -->
  <section class="hero">

    <div class="hero-bg" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=85"
        alt=""
      />
      <div class="hero-overlay"></div>
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
      <div class="hero-glow hero-glow-2"></div>
    </div>

    <div class="container hero-container">

      <div class="hero-content">

        <div class="badge">
          <span class="badge-dot"></span>
          <i class="fas fa-rocket"></i>
          اكتشف، تعلّم، وابتكر
        </div>

        <h1>
          ابنِ
          <span id="typewriter" class="gradient-text"></span>
          <span class="cursor">|</span>
        </h1>

        <p class="hero-description">
          منصة تقنية عربية تجمع بين الشروحات المتقدمة، الأدلة المرجعية،
          الأدوات التفاعلية ومختبر الأكواد في تجربة تعليمية حديثة وسريعة.
        </p>

        <!-- أزرار Hero -->
        <div class="hero-actions">

          <a href={playgroundHref} class="btn btn-primary">
            <i class="fas fa-code"></i>
            <span>ابدأ البرمجة الآن</span>
            <i class="fas fa-arrow-left btn-arrow"></i>
          </a>

          <a href={toolsHref} class="btn btn-secondary">
            <i class="fas fa-wand-magic-sparkles"></i>
            <span>استكشف الأدوات</span>
          </a>

          <a href={articlesHref} class="btn btn-articles">
            <i class="fas fa-newspaper"></i>
            <span>تصفح المقالات</span>
          </a>

        </div>

        <div class="hero-features">

          <div class="hero-feature">
            <span class="feature-check">
              <i class="fas fa-bolt"></i>
            </span>
            <span>تنفيذ فوري</span>
          </div>

          <div class="hero-feature">
            <span class="feature-check">
              <i class="fas fa-shield-alt"></i>
            </span>
            <span>آمن 100%</span>
          </div>

          <div class="hero-feature">
            <span class="feature-check">
              <i class="fas fa-gift"></i>
            </span>
            <span>مجاني تماماً</span>
          </div>

        </div>
      </div>


      <!-- HERO VISUAL -->
      <div class="hero-visual">

        <div class="visual-orbit orbit-1"></div>
        <div class="visual-orbit orbit-2"></div>

        <!-- Python -->
        <div class="float-card card-1">
          <div class="card-top">

            <div class="language-icon python">
              <i class="fab fa-python"></i>
            </div>

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

          </div>

          <div class="code-box">
            <div>
              <span class="code-purple">print</span>
              <span class="code-white">(</span>
              <span class="code-green">"مرحباً"</span>
              <span class="code-white">)</span>
            </div>

            <div class="code-comment">
              # Python 3.11
            </div>

            <div class="code-output">
              <i class="fas fa-terminal"></i>
              Hello World
            </div>
          </div>
        </div>


        <!-- JavaScript -->
        <div class="float-card card-2">
          <div class="small-icon js-icon">
            <i class="fab fa-js"></i>
          </div>

          <div>
            <strong>JavaScript</strong>
            <small>Modern Web</small>
          </div>

          <i class="fas fa-check-circle status-icon"></i>
        </div>


        <!-- Terminal -->
        <div class="float-card card-3">
          <div class="small-icon terminal-icon">
            <i class="fas fa-terminal"></i>
          </div>

          <div>
            <strong>Terminal</strong>
            <small>Ready to code</small>
          </div>
        </div>


        <!-- Lessons -->
        <div class="float-card card-4">
          <div class="progress-icon">
            <i class="fas fa-check"></i>
          </div>

          <div>
            <strong>+150 درس</strong>
            <small>جاهز للتعلم</small>
          </div>
        </div>


        <!-- React -->
        <div class="float-card card-5">
          <div class="small-icon react-icon">
            <i class="fab fa-react"></i>
          </div>

          <div>
            <strong>React</strong>
            <small>UI Library</small>
          </div>
        </div>


        <!-- Docker -->
        <div class="float-card card-6">
          <div class="small-icon docker-icon">
            <i class="fab fa-docker"></i>
          </div>

          <div>
            <strong>Docker</strong>
            <small>Container</small>
          </div>
        </div>


        <!-- الشعار المركزي -->
        <div class="visual-center">

          <div class="logo-energy energy-1"></div>
          <div class="logo-energy energy-2"></div>

          <div class="logo-orbit logo-orbit-1"></div>
          <div class="logo-orbit logo-orbit-2"></div>

          <div class="center-ring">

            <div class="center-logo">

              <div class="logo-mark">
                <span>Th</span>
              </div>

              <div class="logo-name">
                <strong>.Tech</strong>
              </div>

              <div class="logo-status">
                <span></span>
                ONLINE
              </div>

            </div>

          </div>

        </div>

      </div>
    </div>

    <div class="hero-scroll">
      <span>اكتشف المزيد</span>
      <i class="fas fa-chevron-down"></i>
    </div>

  </section>


  <!-- =====================================================
       TECH TICKER
  ====================================================== -->
  <div class="tech-ticker">

    <div class="ticker-fade ticker-fade-right"></div>
    <div class="ticker-fade ticker-fade-left"></div>

    <div class="ticker-track">

      <div class="tech-item">
        <i class="fab fa-js"></i>
        JavaScript
      </div>

      <div class="tech-item">
        <i class="fab fa-python"></i>
        Python
      </div>

      <div class="tech-item">
        <i class="fab fa-react"></i>
        React
      </div>

      <div class="tech-item">
        <i class="fab fa-aws"></i>
        AWS
      </div>

      <div class="tech-item">
        <i class="fas fa-shield-halved"></i>
        CyberSec
      </div>

      <div class="tech-item">
        <i class="fab fa-docker"></i>
        Docker
      </div>

      <div class="tech-item">
        <i class="fab fa-node-js"></i>
        Node.js
      </div>

      <div class="tech-item">
        <i class="fas fa-database"></i>
        SQL
      </div>

      <div class="ticker-logo">

        <div class="ticker-logo-glow"></div>

        <img
          src={`${base}/Th-tech/logo1.png`}
          alt="Th.Tech"
          loading="lazy"
        />

      </div>

      <div class="tech-item">
        <i class="fab fa-js"></i>
        JavaScript
      </div>

      <div class="tech-item">
        <i class="fab fa-python"></i>
        Python
      </div>

      <div class="tech-item">
        <i class="fab fa-react"></i>
        React
      </div>

      <div class="tech-item">
        <i class="fab fa-aws"></i>
        AWS
      </div>

      <div class="tech-item">
        <i class="fas fa-shield-halved"></i>
        CyberSec
      </div>

      <div class="tech-item">
        <i class="fab fa-docker"></i>
        Docker
      </div>

      <div class="tech-item">
        <i class="fab fa-node-js"></i>
        Node.js
      </div>

      <div class="tech-item">
        <i class="fas fa-database"></i>
        SQL
      </div>

    </div>
  </div>


  <!-- =====================================================
       STATS
  ====================================================== -->
  <section class="stats">

    <div class="container">

      <div class="stats-grid">

        <!-- الأدوات -->
        <div class="stat-item">

          <div class="stat-icon-wrap">
            <i class="fas fa-toolbox"></i>
          </div>

          <div>
            <span
              class="stat-num"
              data-target="118"
              data-suffix="+"
            >0</span>

            <span class="stat-label">
              أداة تقنية
            </span>
          </div>

        </div>

        <div class="stat-divider"></div>


        <!-- المحتوى -->
        <div class="stat-item">

          <div class="stat-icon-wrap">
            <i class="fas fa-book-open"></i>
          </div>

          <div>
            <span
              class="stat-num"
              data-target="150"
              data-suffix="+"
            >0</span>

            <span class="stat-label">
              دليل ومقال
            </span>
          </div>

        </div>

        <div class="stat-divider"></div>


        <!-- مجاني -->
        <div class="stat-item">

          <div class="stat-icon-wrap">
            <i class="fas fa-gift"></i>
          </div>

          <div>
            <span
              class="stat-num"
              data-target="100"
              data-suffix="%"
            >0</span>

            <span class="stat-label">
              محتوى مجاني
            </span>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       TRACKS
  ====================================================== -->
  <section class="tracks">

    <div class="container">

      <div class="section-heading">

        <span class="section-kicker">
          <i class="fas fa-layer-group"></i>
          تعلّم بطريقة منظمة
        </span>

        <h2>
          مسارات
          <span>التعلم</span>
        </h2>

        <p>
          اختر المجال الذي يناسبك وابدأ رحلة التعلم خطوة بخطوة.
        </p>

      </div>


      <div class="tracks-grid">

        <!-- AI -->
        <a href={`${base}/ai/`} class="track">

          <div class="track-img">

            <img
              src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=700&q=85"
              alt="AI"
              loading="lazy"
            />

            <div class="track-img-overlay"></div>

            <span class="track-number">01</span>

          </div>

          <div class="track-body">

            <div class="track-icon">
              <i class="fas fa-brain"></i>
            </div>

            <div class="track-title-row">

              <h3>الذكاء الاصطناعي</h3>

              <span class="track-arrow">
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

            <p>
              تعلم الآلة والشبكات العصبية وتطبيقات الذكاء الاصطناعي الحديثة.
            </p>

            <ul class="track-list">
              <li>
                <i class="fas fa-check"></i>
                Machine Learning
              </li>

              <li>
                <i class="fas fa-check"></i>
                Deep Learning
              </li>
            </ul>

          </div>

        </a>


        <!-- Programming -->
        <a href={`${base}/programming/`} class="track">

          <div class="track-img">

            <img
              src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=700&q=85"
              alt="Code"
              loading="lazy"
            />

            <div class="track-img-overlay"></div>

            <span class="track-number">02</span>

          </div>

          <div class="track-body">

            <div class="track-icon">
              <i class="fas fa-code"></i>
            </div>

            <div class="track-title-row">

              <h3>البرمجة</h3>

              <span class="track-arrow">
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

            <p>
              تعلم تطوير المواقع والتطبيقات وبناء المشاريع الحديثة.
            </p>

            <ul class="track-list">

              <li>
                <i class="fas fa-check"></i>
                Full Stack
              </li>

              <li>
                <i class="fas fa-check"></i>
                DevOps
              </li>

            </ul>

          </div>

        </a>


        <!-- Security -->
        <a href={`${base}/security/`} class="track">

          <div class="track-img">

            <img
              src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=700&q=85"
              alt="Security"
              loading="lazy"
            />

            <div class="track-img-overlay"></div>

            <span class="track-number">03</span>

          </div>

          <div class="track-body">

            <div class="track-icon">
              <i class="fas fa-shield-halved"></i>
            </div>

            <div class="track-title-row">

              <h3>الأمن السيبراني</h3>

              <span class="track-arrow">
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

            <p>
              فهم أساسيات الحماية واختبار الاختراق وأمن الأنظمة.
            </p>

            <ul class="track-list">

              <li>
                <i class="fas fa-check"></i>
                Ethical Hacking
              </li>

              <li>
                <i class="fas fa-check"></i>
                Network Security
              </li>

            </ul>

          </div>

        </a>


        <!-- Cloud -->
        <a href={`${base}/cloud/`} class="track">

          <div class="track-img">

            <img
              src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=700&q=85"
              alt="Cloud"
              loading="lazy"
            />

            <div class="track-img-overlay"></div>

            <span class="track-number">04</span>

          </div>

          <div class="track-body">

            <div class="track-icon">
              <i class="fas fa-cloud"></i>
            </div>

            <div class="track-title-row">

              <h3>الحوسبة السحابية</h3>

              <span class="track-arrow">
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

            <p>
              اكتشف AWS وDocker وKubernetes وبنية الخدمات السحابية.
            </p>

            <ul class="track-list">

              <li>
                <i class="fas fa-check"></i>
                AWS
              </li>

              <li>
                <i class="fas fa-check"></i>
                Docker
              </li>

            </ul>

          </div>

        </a>

      </div>


      <!-- زر المسارات الأخرى -->
      <div class="tracks-more">

        <a href={tracksHref} class="btn btn-outline">

          <i class="fas fa-layer-group"></i>

          <span>استكشف المسارات الأخرى</span>

          <i class="fas fa-arrow-left"></i>

        </a>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FEATURES
  ====================================================== -->
  <section class="features">

    <div class="container">

      <div class="section-heading">

        <span class="section-kicker">
          <i class="fas fa-sparkles"></i>
          تجربة مختلفة
        </span>

        <h2>
          لماذا
          <span>Th.Tech؟</span>
        </h2>

        <p>
          أدوات ومحتوى مصمم لتجعل التعلم التقني أبسط وأسرع.
        </p>

      </div>


      <div class="features-grid">

        <div class="feature-box">

          <div class="feature-icon">
            <i class="fas fa-bolt"></i>
          </div>

          <h3>سرعة فائقة</h3>

          <p>
            تجربة سريعة وخفيفة مع تنفيذ الكود فورياً.
          </p>

          <span class="feature-number">01</span>

        </div>


        <div class="feature-box">

          <div class="feature-icon">
            <i class="fas fa-mobile-screen-button"></i>
          </div>

          <h3>متجاوب بالكامل</h3>

          <p>
            تصميم يعمل بسلاسة على الهاتف والكمبيوتر واللوحي.
          </p>

          <span class="feature-number">02</span>

        </div>


        <div class="feature-box">

          <div class="feature-icon">
            <i class="fas fa-floppy-disk"></i>
          </div>

          <h3>حفظ تلقائي</h3>

          <p>
            يتم حفظ أكوادك وأعمالك محلياً داخل المتصفح.
          </p>

          <span class="feature-number">03</span>

        </div>


        <div class="feature-box">

          <div class="feature-icon">
            <i class="fas fa-download"></i>
          </div>

          <h3>تصدير سهل</h3>

          <p>
            احفظ مشاريعك وأكوادك بسهولة وبصيغ مختلفة.
          </p>

          <span class="feature-number">04</span>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FAQ
  ====================================================== -->
  <section class="faq">

    <div class="container">

      <div class="section-heading">

        <span class="section-kicker">
          <i class="fas fa-circle-question"></i>
          لديك سؤال؟
        </span>

        <h2>
          الأسئلة
          <span>الشائعة</span>
        </h2>

        <p>
          إجابات سريعة على أكثر الأسئلة التي قد تخطر في بالك.
        </p>

      </div>


      <div class="faq-grid">

        <div class="faq-item">

          <div class="faq-icon">
            <i class="fas fa-user-graduate"></i>
          </div>

          <div>
            <h3>هل أحتاج خبرة سابقة؟</h3>

            <p>
              لا! نبدأ معك من الأساسيات ونتدرج بك حتى المستويات المتقدمة.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <div class="faq-icon">
            <i class="fas fa-terminal"></i>
          </div>

          <div>
            <h3>كيف أستخدم المحرر؟</h3>

            <p>
              اكتب الكود داخل المحرر واضغط على زر "تشغيل" لمشاهدة النتيجة.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <div class="faq-icon">
            <i class="fas fa-save"></i>
          </div>

          <div>
            <h3>هل يمكنني حفظ أعمالي؟</h3>

            <p>
              نعم، يتم حفظ الأكواد محلياً في المتصفح لتتمكن من العودة إليها.
            </p>
          </div>

        </div>


        <div class="faq-item">

          <div class="faq-icon">
            <i class="fas fa-code"></i>
          </div>

          <div>
            <h3>ما اللغات المدعومة؟</h3>

            <p>
              Python وJavaScript وHTML وغيرها من التقنيات التي ستتم إضافتها.
            </p>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FINAL CTA
  ====================================================== -->
  <section class="final-cta">

    <div class="cta-glow"></div>

    <div class="container">

      <div class="cta-box">

        <div class="cta-content">

          <span class="section-kicker">
            <i class="fas fa-code"></i>
            مستعد للبدء؟
          </span>

          <h2>
            حوّل أفكارك إلى
            <span>واقع رقمي.</span>
          </h2>

          <p>
            ابدأ الآن واستكشف عالم البرمجة والتقنية بطريقة مختلفة.
          </p>

          <a
            href={playgroundHref}
            class="btn btn-primary cta-button"
          >
            <i class="fas fa-terminal"></i>
            افتح مختبر الأكواد
            <i class="fas fa-arrow-left"></i>
          </a>

        </div>

        <div class="cta-decoration">

          <div class="cta-code">
            <span>&lt;</span>
            <strong>code</strong>
            <span>/&gt;</span>
          </div>

        </div>

      </div>

    </div>

  </section>


  <Footer />


  <!-- Scroll Top -->
  <button
    class="scroll-top"
    id="scrollTop"
    aria-label="العودة إلى الأعلى"
  >
    <i class="fas fa-arrow-up"></i>
  </button>


  <style>

    /* =====================================================
       VARIABLES
    ====================================================== */

    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --bg3: #eaf0f7;

      --text: #0f172a;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --cyan: #0891b2;

      --border: rgba(15, 23, 42, .08);

      --card: rgba(255, 255, 255, .88);

      --shadow:
        0 20px 60px rgba(15, 23, 42, .08);

      --radius: 24px;
    }


    html.dark-mode {

      --bg: #07101f;
      --bg2: #0b1426;
      --bg3: #111d32;

      --text: #f8fafc;
      --text-muted: #94a3b8;

      --primary: #3b82f6;
      --primary-dark: #2563eb;
      --cyan: #06b6d4;

      --border: rgba(148, 163, 184, .12);

      --card: rgba(15, 23, 42, .72);

      --shadow:
        0 20px 60px rgba(0, 0, 0, .3);
    }


    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      overflow-x: hidden;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: min(1180px, calc(100% - 40px));
      margin-inline: auto;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .hero {
      position: relative;
      min-height: 760px;
      display: flex;
      align-items: center;
      overflow: hidden;
      isolation: isolate;
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: -3;
    }


    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(.8);
    }


    .hero-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(248, 250, 252, .98),
          rgba(248, 250, 252, .88) 45%,
          rgba(248, 250, 252, .65)
        );
    }


    html.dark-mode .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(7, 16, 31, .98),
          rgba(7, 16, 31, .88) 45%,
          rgba(7, 16, 31, .72)
        );
    }


    .hero-grid {
      position: absolute;
      inset: 0;
      opacity: .18;
      background-image:
        linear-gradient(
          rgba(37, 99, 235, .16) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(37, 99, 235, .16) 1px,
          transparent 1px
        );
      background-size: 50px 50px;
      mask-image: linear-gradient(to bottom, black, transparent);
    }


    .hero-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }


    .hero-glow-1 {
      width: 350px;
      height: 350px;
      background: rgba(37, 99, 235, .20);
      top: 5%;
      right: 5%;
    }


    .hero-glow-2 {
      width: 300px;
      height: 300px;
      background: rgba(6, 182, 212, .16);
      bottom: 0;
      left: 10%;
    }


    .hero-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      align-items: center;
      padding-top: 60px;
    }


    .hero-content {
      position: relative;
      z-index: 5;
    }


    .badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(37, 99, 235, .08);
      border: 1px solid rgba(37, 99, 235, .14);
      color: var(--primary);
      font-size: .82rem;
      font-weight: 700;
      margin-bottom: 22px;
    }


    .badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 12px rgba(34, 197, 94, .7);
    }


    .hero h1 {
      margin: 0 0 20px;
      font-size: clamp(2.5rem, 5vw, 4.8rem);
      line-height: 1.15;
      font-weight: 900;
      letter-spacing: -1px;
    }


    .gradient-text {
      background:
        linear-gradient(
          90deg,
          var(--primary),
          var(--cyan)
        );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }


    .cursor {
      color: var(--primary);
      animation: cursorBlink 1s infinite;
    }


    @keyframes cursorBlink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }


    .hero-description {
      max-width: 650px;
      color: var(--text-muted);
      line-height: 2;
      font-size: 1.05rem;
      margin: 0 0 28px;
    }


    /* =====================================================
       HERO BUTTONS
    ====================================================== */

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-bottom: 24px;
    }


    .btn {
      min-height: 50px;
      padding: 0 19px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border-radius: 14px;
      font-family: inherit;
      font-size: .9rem;
      font-weight: 800;
      transition:
        transform .25s ease,
        box-shadow .25s ease,
        background .25s ease,
        border-color .25s ease;
      cursor: pointer;
      border: 1px solid transparent;
    }


    .btn:hover {
      transform: translateY(-3px);
    }


    .btn-primary {
      color: #fff;
      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--cyan)
        );
      box-shadow:
        0 12px 28px rgba(37, 99, 235, .22);
    }


    .btn-primary:hover {
      box-shadow:
        0 16px 34px rgba(37, 99, 235, .32);
    }


    .btn-secondary,
    .btn-articles {
      color: var(--text);
      background: rgba(255, 255, 255, .68);
      border-color: var(--border);
      backdrop-filter: blur(12px);
    }


    html.dark-mode .btn-secondary,
    html.dark-mode .btn-articles {
      background: rgba(15, 23, 42, .7);
    }


    .btn-secondary:hover,
    .btn-articles:hover {
      border-color: rgba(37, 99, 235, .3);
    }


    .btn-articles {
      color: var(--primary);
    }


    .btn-arrow {
      transition: transform .25s ease;
    }


    .btn-primary:hover .btn-arrow {
      transform: translateX(-4px);
    }


    .hero-features {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      color: var(--text-muted);
      font-size: .82rem;
      font-weight: 600;
    }


    .hero-feature {
      display: flex;
      align-items: center;
      gap: 7px;
    }


    .feature-check {
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: #16a34a;
      background: rgba(34, 197, 94, .10);
      font-size: .65rem;
    }


    /* =====================================================
       HERO VISUAL
    ====================================================== */

    .hero-visual {
      position: relative;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
    }


    .visual-orbit {
      position: absolute;
      border: 1px solid rgba(37, 99, 235, .16);
      border-radius: 50%;
      pointer-events: none;
    }


    .orbit-1 {
      width: 480px;
      height: 480px;
      transform: rotate(-20deg) skewX(-5deg);
    }


    .orbit-2 {
      width: 370px;
      height: 370px;
      transform: rotate(25deg) skewX(8deg);
      border-color: rgba(6, 182, 212, .18);
    }


    /* =====================================================
       FLOAT CARDS
    ====================================================== */

    .float-card {
      position: absolute;
      z-index: 4;
      background: rgba(255,255,255,.88);
      border: 1px solid rgba(255,255,255,.7);
      box-shadow:
        0 20px 50px rgba(15, 23, 42, .13);
      backdrop-filter: blur(16px);
      border-radius: 16px;
      animation: cardFloat 5s ease-in-out infinite;
    }


    html.dark-mode .float-card {
      background: rgba(15, 23, 42, .82);
      border-color: rgba(148,163,184,.12);
      box-shadow:
        0 20px 50px rgba(0,0,0,.35);
    }


    @keyframes cardFloat {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-9px);
      }
    }


    .card-1 {
      width: 230px;
      padding: 15px;
      top: 35px;
      right: 5px;
    }


    .card-2 {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 13px 15px;
      left: 0;
      top: 110px;
      animation-delay: -.8s;
    }


    .card-3 {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 13px 15px;
      right: -8px;
      bottom: 100px;
      animation-delay: -1.5s;
    }


    .card-4 {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 13px 15px;
      left: 25px;
      bottom: 60px;
      animation-delay: -2s;
    }


    .card-5 {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      right: 55px;
      top: 225px;
      animation-delay: -2.5s;
    }


    .card-6 {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      left: 70px;
      bottom: 175px;
      animation-delay: -3s;
    }


    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }


    .language-icon {
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9px;
      background: #3776ab;
      color: white;
    }


    .window-dots {
      display: flex;
      gap: 4px;
    }


    .window-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #94a3b8;
    }


    .code-box {
      padding: 12px;
      border-radius: 10px;
      background: #0f172a;
      font-family: "JetBrains Mono", monospace;
      font-size: .68rem;
      direction: ltr;
      text-align: left;
    }


    .code-purple {
      color: #c084fc;
    }


    .code-green {
      color: #4ade80;
    }


    .code-white {
      color: #e2e8f0;
    }


    .code-comment {
      color: #64748b;
      margin-top: 5px;
    }


    .code-output {
      margin-top: 8px;
      padding-top: 7px;
      border-top: 1px solid rgba(255,255,255,.08);
      color: #38bdf8;
    }


    .small-icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-size: 1.1rem;
    }


    .js-icon {
      background: rgba(234,179,8,.15);
      color: #eab308;
    }


    .terminal-icon {
      background: rgba(37,99,235,.12);
      color: var(--primary);
    }


    .react-icon {
      background: rgba(6,182,212,.12);
      color: #06b6d4;
    }


    .docker-icon {
      background: rgba(14,165,233,.12);
      color: #0ea5e9;
    }


    .float-card strong {
      display: block;
      font-size: .78rem;
    }


    .float-card small {
      display: block;
      color: var(--text-muted);
      font-size: .63rem;
      margin-top: 2px;
    }


    .status-icon {
      color: #22c55e;
      margin-right: auto;
    }


    .progress-icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: #22c55e;
      background: rgba(34,197,94,.12);
    }


    /* =====================================================
       CENTER LOGO
    ====================================================== */

    .visual-center {
      position: relative;
      width: 280px;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3;
      animation: logoFloat 5s ease-in-out infinite;
    }


    .center-ring {
      position: relative;
      width: 205px;
      height: 205px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid rgba(56,189,248,.5);
      background:
        radial-gradient(
          circle,
          rgba(37,99,235,.13),
          rgba(6,182,212,.04) 55%,
          transparent 72%
        );
      box-shadow:
        0 0 50px rgba(37,99,235,.18),
        inset 0 0 40px rgba(6,182,212,.08);
      animation: logoPulse 3s ease-in-out infinite;
    }


    .center-ring::before,
    .center-ring::after {
      content: "";
      position: absolute;
      inset: 13px;
      border-radius: 50%;
      border: 1px dashed rgba(56,189,248,.28);
    }


    .center-ring::after {
      inset: 27px;
      border-style: solid;
      border-color: rgba(37,99,235,.18);
    }


    .center-logo {
      position: relative;
      width: 122px;
      height: 122px;
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background:
        radial-gradient(
          circle at 35% 25%,
          rgba(56,189,248,.22),
          rgba(15,23,42,.97) 68%
        );
      border: 1px solid rgba(56,189,248,.55);
      box-shadow:
        0 0 30px rgba(37,99,235,.25),
        inset 0 0 25px rgba(6,182,212,.12);
      animation: logoTilt 6s ease-in-out infinite;
    }


    .logo-mark {
      font-family: "JetBrains Mono", monospace;
      font-size: 1.55rem;
      font-weight: 900;
      line-height: 1;
      color: #38bdf8;
      text-shadow:
        0 0 12px rgba(56,189,248,.75);
    }


    .logo-name {
      margin-top: 3px;
      font-family: "JetBrains Mono", monospace;
      font-size: .82rem;
      color: #e2e8f0;
      letter-spacing: .5px;
    }


    .logo-status {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 7px;
      font-family: "JetBrains Mono", monospace;
      font-size: .42rem;
      color: #64748b;
      letter-spacing: 1px;
    }


    .logo-status span {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e;
      animation: onlinePulse 1.5s infinite;
    }


    .logo-orbit {
      position: absolute;
      border: 1px solid rgba(56,189,248,.28);
      border-radius: 50%;
      pointer-events: none;
    }


    .logo-orbit-1 {
      width: 245px;
      height: 110px;
      transform: rotate(35deg);
      animation: orbitRotate 9s linear infinite;
    }


    .logo-orbit-2 {
      width: 245px;
      height: 110px;
      transform: rotate(-35deg);
      border-color: rgba(37,99,235,.24);
      animation: orbitRotateReverse 11s linear infinite;
    }


    .logo-energy {
      position: absolute;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow:
        0 0 15px #38bdf8,
        0 0 30px rgba(6,182,212,.5);
    }


    .energy-1 {
      width: 7px;
      height: 7px;
      top: 20px;
      right: 65px;
      animation: energyPulse 2.5s infinite;
    }


    .energy-2 {
      width: 5px;
      height: 5px;
      bottom: 32px;
      left: 65px;
      animation: energyPulse 3s infinite reverse;
    }


    @keyframes logoPulse {
      0%, 100% {
        box-shadow:
          0 0 45px rgba(37,99,235,.14),
          inset 0 0 30px rgba(6,182,212,.06);
      }

      50% {
        box-shadow:
          0 0 75px rgba(37,99,235,.28),
          inset 0 0 45px rgba(6,182,212,.13);
      }
    }


    @keyframes logoFloat {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-8px);
      }
    }


    @keyframes logoTilt {
      0%, 100% {
        transform: rotate(0deg);
      }

      50% {
        transform: rotate(2deg);
      }
    }


    @keyframes orbitRotate {
      from {
        transform: rotate(35deg);
      }

      to {
        transform: rotate(395deg);
      }
    }


    @keyframes orbitRotateReverse {
      from {
        transform: rotate(-35deg);
      }

      to {
        transform: rotate(-395deg);
      }
    }


    @keyframes energyPulse {
      0%, 100% {
        opacity: .3;
        transform: scale(.8);
      }

      50% {
        opacity: 1;
        transform: scale(1.4);
      }
    }


    @keyframes onlinePulse {
      0%, 100% {
        opacity: .5;
      }

      50% {
        opacity: 1;
      }
    }


    /* =====================================================
       HERO SCROLL
    ====================================================== */

    .hero-scroll {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      color: var(--text-muted);
      font-size: .68rem;
      animation: scrollFloat 2s ease-in-out infinite;
    }


    .hero-scroll i {
      color: var(--primary);
    }


    @keyframes scrollFloat {
      0%, 100% {
        transform: translate(-50%, 0);
      }

      50% {
        transform: translate(-50%, 5px);
      }
    }


    /* =====================================================
       TICKER
    ====================================================== */

    .tech-ticker {
      position: relative;
      overflow: hidden;
      height: 78px;
      display: flex;
      align-items: center;
      background: var(--bg2);
      border-block: 1px solid var(--border);
    }


    .ticker-track {
      width: max-content;
      display: flex;
      align-items: center;
      gap: 30px;
      animation: tickerMove 35s linear infinite;
      padding-inline: 30px;
    }


    .tech-item {
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      color: var(--text-muted);
      font-family: "JetBrains Mono", monospace;
      font-size: .75rem;
      font-weight: 600;
    }


    .tech-item i {
      color: var(--primary);
      font-size: 1rem;
    }


    .ticker-logo {
      position: relative;
      width: 82px;
      height: 52px;
      flex: 0 0 82px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-inline: 8px;
      border-radius: 14px;
      background: var(--bg);
      border: 1px solid rgba(37,99,235,.15);
      overflow: hidden;
    }


    .ticker-logo img {
      position: relative;
      z-index: 2;
      width: 68px;
      height: 42px;
      object-fit: contain;
      display: block;
    }


    .ticker-logo-glow {
      position: absolute;
      width: 55px;
      height: 55px;
      border-radius: 50%;
      background: rgba(6,182,212,.15);
      filter: blur(18px);
    }


    .ticker-fade {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 100px;
      z-index: 5;
      pointer-events: none;
    }


    .ticker-fade-right {
      right: 0;
      background:
        linear-gradient(
          to left,
          var(--bg2),
          transparent
        );
    }


    .ticker-fade-left {
      left: 0;
      background:
        linear-gradient(
          to right,
          var(--bg2),
          transparent
        );
    }


    @keyframes tickerMove {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(50%);
      }
    }


    /* =====================================================
       STATS
    ====================================================== */

    .stats {
      padding: 55px 0;
      background: var(--bg);
    }


    .stats-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 28px;
      max-width: 900px;
      margin: auto;
    }


    .stat-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
      text-align: center;
    }


    .stat-icon-wrap {
      width: 50px;
      height: 50px;
      flex: 0 0 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 15px;
      color: var(--primary);
      background: rgba(37,99,235,.09);
    }


    .stat-num {
      display: block;
      font-size: 1.8rem;
      line-height: 1;
      font-weight: 900;
      color: var(--text);
    }


    .stat-label {
      display: block;
      margin-top: 5px;
      color: var(--text-muted);
      font-size: .72rem;
    }


    .stat-divider {
      width: 1px;
      height: 45px;
      background: var(--border);
    }


    /* =====================================================
       SECTIONS
    ====================================================== */

    .tracks,
    .features,
    .faq {
      padding: 95px 0;
    }


    .tracks {
      background: var(--bg2);
    }


    .features {
      background: var(--bg);
    }


    .faq {
      background: var(--bg2);
    }


    .section-heading {
      max-width: 700px;
      margin: 0 auto 45px;
      text-align: center;
    }


    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--primary);
      font-size: .78rem;
      font-weight: 800;
      margin-bottom: 10px;
    }


    .section-heading h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    .section-heading p {
      margin: 12px 0 0;
      color: var(--text-muted);
      line-height: 1.9;
      font-size: .92rem;
    }


    /* =====================================================
       TRACKS
    ====================================================== */

    .tracks-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }


    .track {
      overflow: hidden;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      transition:
        transform .3s ease,
        box-shadow .3s ease;
    }


    .track:hover {
      transform: translateY(-7px);
      box-shadow:
        0 28px 65px rgba(15,23,42,.12);
    }


    .track-img {
      position: relative;
      height: 175px;
      overflow: hidden;
    }


    .track-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
    }


    .track:hover .track-img img {
      transform: scale(1.06);
    }


    .track-img-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(2,6,23,.72),
          transparent 60%
        );
    }


    .track-number {
      position: absolute;
      left: 15px;
      bottom: 12px;
