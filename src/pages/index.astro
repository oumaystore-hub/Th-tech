---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | المستقبل الرقمي يبدأ هنا</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي، البرمجة، والأمن السيبراني. محتوى تقني معمق وشروحات عملية." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <!-- خطوط احترافية -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  
  <!-- مكتبات خارجية للمحرر -->
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section -->
    <section class="section hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1920&h=1080&fit=crop" alt="AI" loading="eager" />
        <div class="overlay"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <span class="badge">🚀 نحو المستقبل</span>
          <h1><span class="gradient">ابنِ غدك الرقمي</span><br />معنا</h1>
          <p class="hero-text">شروحات عملية في الذكاء الاصطناعي، البرمجة، والأمن السيبراني</p>
          <div class="hero-actions">
            <a href="/Th-tech/guides/" class="btn btn-primary">استكشف الأدلة</a>
            <a href="/Th-tech/articles/" class="btn btn-outline">المقالات</a>
          </div>
        </div>
      </div>
    </section>

    <!--  Stats -->
    <section class="section stats-bar">
      <div class="container">
        <div class="stats-grid">
          <div class="stat">
            <span class="stat-num counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!--  Professional Code Editor -->
    <section class="section editor-section" id="editor">
      <div class="container">
        <div class="section-head">
          <h2>محرر الأكواد التفاعلي</h2>
          <p>اكتب، شغّل، واختبر كودك مباشرة في المتصفح</p>
        </div>

        <div class="editor-card">
          <!-- Toolbar -->
          <div class="editor-toolbar">
            <div class="toolbar-left">
              <div class="file-tab active">
                <span id="langIcon">JS</span>
                <span id="fileName">script.js</span>
              </div>
            </div>
            <div class="toolbar-right">
              <select id="languageSelect" onchange="changeLanguage()">
                <option value="javascript">JavaScript</option>
                <option value="python">Python</option>
                <option value="html">HTML/CSS</option>
                <option value="java">Java</option>
                <option value="cpp">C++</option>
                <option value="sql">SQL</option>
              </select>
              <div class="toolbar-actions">
                <button class="btn-icon" onclick="resetCode()" title="إعادة تعيين">↺</button>
                <button class="btn-icon" onclick="copyCode()" title="نسخ الكود">⎘</button>
                <button class="btn-run" id="runBtn" onclick="runCode()">
                  <span>▶ تشغيل</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Editor Area -->
          <div class="editor-body">
            <div class="code-pane">
              <div class="line-numbers" id="lineNumbers">1</div>
              <textarea 
                id="codeInput" 
                class="code-input" 
                spellcheck="false"
                placeholder="اكتب الكود هنا..."
                oninput="updateLineNumbers(); updateStatus('تم التعديل...')"
                onscroll="syncScroll()"
                onkeydown="handleTab(event)"
              ></textarea>
            </div>
            
            <div class="output-pane">
              <div class="output-header">
                <span>المخرجات (Terminal)</span>
                <button class="btn-clear" onclick="clearOutput()">✕</button>
              </div>
              <div id="output" class="code-output">
                <div class="output-placeholder">
                  <span class="icon">💡</span>
                  <p>اضغط على "تشغيل" لرؤية النتيجة</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Status Bar -->
          <div class="editor-status">
            <span id="statusText">✅ جاهز</span>
            <span class="separator">|</span>
            <span>UTF-8</span>
            <span class="separator">|</span>
            <span id="pyStatus" style="color: #f59e0b;">● Python Loading...</span>
          </div>
        </div>

        <!-- Quick Examples -->
        <div class="quick-examples">
          <span>💡 أمثلة سريعة:</span>
          <button class="btn-sm" onclick="loadExample('hello')">Hello World</button>
          <button class="btn-sm" onclick="loadExample('loop')">Loop</button>
          <button class="btn-sm" onclick="loadExample('array')">Array</button>
        </div>
      </div>
    </section>

    <!--  Topics -->
    <section class="section topics">
      <div class="container">
        <div class="section-head">
          <h2>اختر مسارك</h2>
          <p>مسارات تعليمية مصممة لبناء مهاراتك التقنية</p>
        </div>
        <div class="topics-grid">
          <a href="/Th-tech/ai/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة، الشبكات العصبية، وتطبيقات الـ AI</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/programming/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Programming" loading="lazy" /></div>
            <div class="topic-body">
              <h3>البرمجة</h3>
              <p>لغات البرمجة، الأطر الحديثة، وهندسة البرمجيات</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/security/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات، الاختراق الأخلاقي، والدفاع الرقمي</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
          <a href="/Th-tech/cloud/" class="topic-card">
            <div class="topic-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" /></div>
            <div class="topic-body">
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، وGoogle Cloud</p>
              <span class="link-arrow">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!--  CTA -->
    <section class="section cta">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك اليوم</h2>
          <p>انضم إلى آلاف المطورين والمبتكرين</p>
          <a href="/Th-tech/guides/" class="btn btn-light">تصفح الأدلة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  /* === Variables & Reset === */
  :root {
    --bg: #0f111a;
    --bg-secondary: #161b22;
    --card: #1e2530;
    --text: #e6edf3;
    --text-muted: #8b949e;
    --primary: #58a6ff;
    --primary-dark: #1f6feb;
    --accent: #3fb950;
    --border: #30363d;
    --radius: 8px;
    --font-main: 'Cairo', sans-serif;
    --font-code: 'Fira Code', monospace;
    --editor-bg: #0d1117;
    --line-num-bg: #161b22;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    line-height: 1.6;
  }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 4rem 0; }
  .section-head { text-align: center; margin-bottom: 2.5rem; }
  .section-head h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem; color: #fff; }
  .section-head p { color: var(--text-muted); }

  /* Hero */
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.3); }
  .overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(31,111,235,0.4), rgba(13,17,23,0.8)); }
  .hero-content { max-width: 650px; padding: 2rem; z-index: 1; }
  .badge {
    display: inline-block;
    background: rgba(88,166,255,0.15);
    color: var(--primary);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
    border: 1px solid rgba(88,166,255,0.3);
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; }
  .gradient { background: linear-gradient(135deg, #fff, var(--primary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-text { font-size: 1.1rem; color: #c9d1d9; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 2rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary-dark); color: white; }
  .btn-primary:hover { background: var(--primary); }
  .btn-outline { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: white; }
  .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; }
  .btn-light { background: white; color: #0d1117; }
  .btn-light:hover { background: #f0f3f6; }

  /* Stats */
  .stats-bar { background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 2rem 0; }
  .stats-grid { display: flex; align-items: center; justify-content: center; gap: 3rem; }
  .stat { text-align: center; }
  .stat-num { display: block; font-size: 2.2rem; font-weight: 800; color: var(--primary); line-height: 1; }
  .stat-label { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.5rem; }
  .stat-divider { width: 1px; height: 40px; background: var(--border); }

  /* === Professional Code Editor === */
  .editor-section { background: var(--bg); }
  
  .editor-card {
    background: var(--editor-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .editor-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .file-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--editor-bg);
    padding: 0.4rem 1rem;
    border-radius: 6px 6px 0 0;
    border: 1px solid var(--border);
    border-bottom: none;
    font-size: 0.9rem;
    color: #fff;
  }

  #langIcon {
    background: var(--primary-dark);
    color: white;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .toolbar-right { display: flex; align-items: center; gap: 1rem; }

  .toolbar-right select {
    background: var(--bg-secondary);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-family: inherit;
    cursor: pointer;
  }

  .toolbar-actions { display: flex; gap: 0.5rem; }

  .btn-icon {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.2s;
  }
  .btn-icon:hover { background: rgba(255,255,255,0.1); color: #fff; }

  .btn-run {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 0.4rem 1.2rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s;
  }
  .btn-run:hover { filter: brightness(1.1); }
  .btn-run:disabled { opacity: 0.6; cursor: not-allowed; }

  .editor-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 450px;
  }

  .code-pane {
    position: relative;
    display: flex;
    border-right: 1px solid var(--border);
  }

  .line-numbers {
    width: 50px;
    background: var(--line-num-bg);
    color: var(--text-muted);
    font-family: var(--font-code);
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 1rem 0.5rem;
    text-align: right;
    user-select: none;
    overflow: hidden;
  }

  .code-input {
    flex: 1;
    background: var(--editor-bg);
    color: #e6edf3;
    border: none;
    resize: none;
    font-family: var(--font-code);
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 1rem;
    tab-size: 2;
  }
  .code-input:focus { outline: none; }

  .output-pane {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
  }

  .output-header {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-clear {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
  }
  .btn-clear:hover { color: #f85149; }

  .code-output {
    flex: 1;
    padding: 1rem;
    background: var(--editor-bg);
    color: #e6edf3;
    font-family: var(--font-code);
    font-size: 0.9rem;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  .output-placeholder {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
  .output-placeholder .icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }

  .editor-status {
    padding: 0.4rem 1rem;
    background: var(--primary-dark);
    color: white;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .separator { opacity: 0.5; }

  .quick-examples {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .btn-sm {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.2s;
  }
  .btn-sm:hover { background: var(--primary-dark); border-color: var(--primary-dark); color: white; }

  /* Topics */
  .topics { background: var(--bg-secondary); }
  .topics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .topic-card {
    background: var(--bg);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s;
    text-decoration: none;
    color: var(--text);
  }
  .topic-card:hover { transform: translateY(-5px); border-color: var(--primary); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
  .topic-img { height: 180px; overflow: hidden; }
  .topic-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .topic-card:hover .topic-img img { transform: scale(1.05); }
  .topic-body { padding: 1.5rem; }
  .topic-body h3 { font-size: 1.2rem; margin-bottom: 0.5rem; color: #fff; }
  .topic-body p { color: var(--text-muted); font-size: 0.95rem; }
  .link-arrow { display: inline-block; margin-top: 0.5rem; color: var(--primary); font-weight: 700; }

  /* CTA */
  .cta { background: var(--bg); padding: 5rem 1.5rem; }
  .cta-box {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, var(--primary-dark), #1158a0);
    padding: 3rem 2rem;
    border-radius: 16px;
    color: white;
    box-shadow: 0 15px 40px rgba(31,111,235,0.2);
  }
  .cta-box h2 { font-size: 2rem; margin-bottom: 0.8rem; }
  .cta-box p { opacity: 0.9; margin-bottom: 2rem; font-size: 1.1rem; }

  /* Responsive */
  @media (max-width: 1024px) {
    .topics-grid { grid-template-columns: 1fr 1fr; }
    .editor-body { grid-template-columns: 1fr; }
    .code-pane { border-right: none; border-bottom: 1px solid var(--border); }
    .code-input { min-height: 300px; }
  }

  @media (max-width: 768px) {
    .hero { min-height: auto; padding: 5rem 0 3rem; }
    .hero h1 { font-size: 2rem; }
    .hero-actions { flex-direction: column; }
    .btn { width: 100%; }
    
    .stats-grid { flex-direction: column; gap: 1.5rem; }
    .stat-divider { width: 100%; height: 1px; }
    
    .topics-grid { grid-template-columns: 1fr; }
    
    .editor-toolbar { flex-direction: column; gap: 1rem; align-items: stretch; }
    .toolbar-right { justify-content: space-between; }
    
    .line-numbers { display: none; }
  }
</style>

<script>
  // === Counter Animation ===
  function initCounterAnimation() {
    const counters = document.querySelectorAll('.counter');
    const animateCounter = (element, target, duration = 2000) => {
      let start = 0;
      const increment = target / (duration / 16);
      const updateCounter = () => {
        start += increment;
        if (start < target) {
          element.textContent = Math.floor(start) + (element.dataset.suffix || '');
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = target + (element.dataset.suffix || '');
        }
      };
      updateCounter();
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = parseInt(entry.target.dataset.target);
          animateCounter(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    counters.forEach(counter => { if (counter.dataset.target) observer.observe(counter); });
  }

  // === Code Editor Logic ===
  // Code Examples - Safe strings to avoid build errors
  const codeExamples = {
    javascript: `// مرحباً بك في محرر JavaScript
function greet(name) {
  return \`مرحباً \${name}! \`;
}

console.log(greet("المطور"));

// حساب مجموع الأرقام
const numbers = [1, 2, 3, 4, 5];
const sum = numbers.reduce((a, b) => a + b, 0);
console.log("المجموع:", sum);`,

    python: `# مرحباً بك في محرر Python
def greet(name):
    return f"مرحباً {name}! "

print(greet("المطور"))

# حساب المجموع
numbers = [1, 2, 3, 4, 5]
total = sum(numbers)
print(f"المجموع: {total}")

# استخدام مكتبة math
import math
print(f"الجذر التربيعي لـ 16 = {math.sqrt(16)}")`,

    // Using string concatenation for HTML to prevent build errors with </script>
    html: `<!-- بطاقة تفاعلية -->\n<div class="card">\n  <h2>مرحباً بك!</h2>\n  <button onclick="showMessage()">اضغط هنا</button>\n</div>\n<style>\n.card { background: #1e2530; color: white; padding: 2rem; border-radius: 8px; text-align: center; font-family: sans-serif; }\nbutton { margin-top: 1rem; padding: 0.5rem 1rem; background: #58a6ff; border: none; border-radius: 4px; color: white; cursor: pointer; }\n</style>\n` + '<script>\nfunction showMessage() { alert("مرحباً! "); }\n' + '<' + '/script>',

    java: `// مرحباً بك في محرر Java
public class Main {
    public static void main(String[] args) {
        System.out.println("مرحباً بك في Java! ");
        
        int[] numbers = {1, 2, 3, 4, 5};
        int sum = 0;
        for (int num : numbers) {
            sum += num;
        }
        System.out.println("المجموع: " + sum);
    }
}`,

    cpp: `// مرحباً بك في محرر C++
#include <iostream>
#include <vector>
using namespace std;

int main() {
    cout << "مرحباً بك في C++! " << endl;
    
    vector<int> numbers = {1, 2, 3, 4, 5};
    int sum = 0;
    for (int num : numbers) {
        sum += num;
    }
    cout << "المجموع: " << sum << endl;
    
    return 0;
}`,

    sql: `-- مرحباً بك في محرر SQL
-- إنشاء جدول
CREATE TABLE users (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100)
);

-- إدراج بيانات
INSERT INTO users VALUES (1, 'أحمد', 'ahmed@test.com');

-- استعلام
SELECT * FROM users;`
  };

  let currentLang = 'javascript';
  let pyodide = null;
  let pyodideReady = false;

  // Initialize Editor
  function initEditor() {
    const editor = document.getElementById('codeInput');
    if (editor) {
      editor.value = codeExamples.javascript;
      updateLineNumbers();
    }
    initPyodide();
  }

  // Update Line Numbers
  function updateLineNumbers() {
    const editor = document.getElementById('codeInput');
    const lineNumbers = document.getElementById('lineNumbers');
    if (!editor || !lineNumbers) return;
    
    const lines = editor.value.split('\n').length;
    lineNumbers.innerHTML = Array(lines).fill(0).map((_, i) => i + 1).join('<br>');
  }

  // Sync Scroll
  function syncScroll() {
    const editor = document.getElementById('codeInput');
    const lineNumbers = document.getElementById('lineNumbers');
    if (lineNumbers) lineNumbers.scrollTop = editor.scrollTop;
  }

  // Handle Tab Key
  function handleTab(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = e.target.selectionStart;
      const end = e.target.selectionEnd;
      e.target.value = e.target.value.substring(0, start) + '  ' + e.target.value.substring(end);
      e.target.selectionStart = e.target.selectionEnd = start + 2;
      updateLineNumbers();
    }
  }

  // Change Language
  function changeLanguage() {
    const select = document.getElementById('languageSelect');
    currentLang = select.value;
    const editor = document.getElementById('codeInput');
    const langIcon = document.getElementById('langIcon');
    const fileName = document.getElementById('fileName');
    const pyStatus = document.getElementById('pyStatus');
    
    editor.value = codeExamples[currentLang] || '';
    updateLineNumbers();
    clearOutput();
    updateStatus('✅ جاهز');
    
    const extensions = { javascript: 'js', python: 'py', html: 'html', java: 'java', cpp: 'cpp', sql: 'sql' };
    langIcon.textContent = currentLang.toUpperCase().substring(0, 2);
    fileName.textContent = `script.${extensions[currentLang]}`;
    
    pyStatus.style.display = currentLang === 'python' ? 'inline' : 'none';
  }

  // Run Code
  async function runCode() {
    const code = document.getElementById('codeInput').value;
    const output = document.getElementById('output');
    const runBtn = document.getElementById('runBtn');
    
    output.innerHTML = '<div class="output-placeholder"><span class="icon"></span><p>جاري التنفيذ...</p></div>';
    runBtn.disabled = true;
    
    try {
      if (currentLang === 'javascript') {
        runJavaScript(code, output);
      } else if (currentLang === 'python') {
        await runPython(code, output);
      } else if (currentLang === 'html') {
        runHTML(code, output);
      } else {
        // For Java, C++, SQL: Show info message
        output.innerHTML = `<div style="padding: 1rem; color: #e6edf3;">
          <strong>✅ تم التحقق من صحة الكود</strong><br><br>
          لغة ${currentLang.toUpperCase()} تتطلب بيئة تنفيذ خاصة (Compiler/Interpreter).<br>
          هذا المحرر يدعم JavaScript, Python, و HTML مباشرة في المتصفح.
        </div>`;
      }
      updateStatus('✅ تم التنفيذ');
    } catch (error) {
      output.innerHTML = `<div style="color: #f85149; padding: 1rem;">❌ خطأ: ${error.message}</div>`;
      updateStatus(' خطأ');
    } finally {
      runBtn.disabled = false;
    }
  }

  // Run JavaScript
  function runJavaScript(code, output) {
    let logs = [];
    const cons = {
      log: (...a) => logs.push(a.map(x => typeof x === 'object' ? JSON.stringify(x, null, 2) : String(x)).join(' ')),
      error: (...a) => logs.push(' ' + a.join(' ')),
      warn: (...a) => logs.push('️ ' + a.join(' '))
    };
    try {
      eval(`(function(c){${code}})(cons)`);
      output.textContent = logs.length ? logs.join('\n') : '✅ تم التنفيذ (لا يوجد مخرجات)';
      output.style.color = '#e6edf3';
    } catch (e) {
      output.textContent = `❌ خطأ: ${e.message}`;
      output.style.color = '#f85149';
    }
  }

  // Run Python
  async function runPython(code, output) {
    if (!pyodideReady) {
      output.innerHTML = '<div class="output-placeholder"><span class="icon"></span><p>جاري تحميل Python...<br><small>قد يستغرق بضع ثوانٍ</small></p></div>';
      await initPyodide();
      if (!pyodideReady) {
        output.textContent = '❌ فشل تحميل Pyodide. يرجى تحديث الصفحة.';
        return;
      }
    }
    
    try {
      pyodide.setStdout({ batched: m => { if(output.textContent.includes('جاري')) output.textContent = ''; output.textContent += m; } });
      pyodide.setStderr({ batched: m => { output.innerHTML += `<span style="color:#f85149">${m}</span>`; } });
      
      await pyodide.runPythonAsync(code);
      if (output.textContent.includes('جاري')) {
        output.textContent = '✅ تم التنفيذ بنجاح';
      }
    } catch (e) {
      output.innerHTML = `<span style="color:#f85149">❌ خطأ: ${e.message}</span>`;
    }
  }

  // Run HTML
  function runHTML(code, output) {
    output.innerHTML = code;
  }

  // Initialize Pyodide
  async function initPyodide() {
    const pyStatus = document.getElementById('pyStatus');
    try {
      pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/" });
      pyodideReady = true;
      if(pyStatus) { pyStatus.textContent = '● Python Ready'; pyStatus.style.color = '#3fb950'; }
    } catch (e) {
      if(pyStatus) { pyStatus.textContent = '● Python Failed'; pyStatus.style.color = '#f85149'; }
    }
  }

  // Utils
  function clearOutput() {
    const output = document.getElementById('output');
    output.innerHTML = '<div class="output-placeholder"><span class="icon">💡</span><p>اضغط على "تشغيل" لرؤية النتيجة</p></div>';
    updateStatus('✅ جاهز');
  }

  function resetCode() {
    document.getElementById('codeInput').value = codeExamples[currentLang];
    updateLineNumbers();
    clearOutput();
  }

  function copyCode() {
    navigator.clipboard.writeText(document.getElementById('codeInput').value);
    updateStatus('📋 تم النسخ');
    setTimeout(() => updateStatus('✅ جاهز'), 2000);
  }

  function loadExample(type) {
    const examples = {
      hello: { javascript: 'console.log("Hello World! 🌍");', python: 'print("Hello World! 🌍")', html: '<h1>Hello World!</h1>', java: 'System.out.println("Hello World!");', cpp: 'cout << "Hello World!" << endl;', sql: "SELECT 'Hello World!';" },
      loop: { javascript: 'for(let i=1; i<=3; i++) console.log(i);', python: 'for i in range(1, 4):\\n    print(i)', html: '<ol><li>1</li><li>2</li></ol>', java: 'for(int i=1; i<=3; i++) System.out.println(i);', cpp: 'for(int i=1; i<=3; i++) cout << i << endl;', sql: 'SELECT * FROM users LIMIT 3;' },
      array: { javascript: 'console.log([1,2,3].map(x=>x*2));', python: 'print([x*2 for x in [1,2,3]])', html: '<ul><li>2</li><li>4</li></ul>', java: 'int[] a={1,2,3}; for(int x:a) System.out.println(x*2);', cpp: 'vector<int> v={1,2,3}; for(int x:v) cout<<x*2<<endl;', sql: 'SELECT id*2 FROM numbers;' }
    };
    
    const editor = document.getElementById('codeInput');
    if (editor && examples[type]) {
      // For Python, replace \n with actual newline
      let code = examples[type][currentLang];
      if (currentLang === 'python') code = code.replace(/\\n/g, '\n');
      
      editor.value = code;
      updateLineNumbers();
      clearOutput();
    }
  }

  function updateStatus(msg) {
    document.getElementById('statusText').textContent = msg;
  }

  // Event Listeners
  document.addEventListener('DOMContentLoaded', () => {
    initCounterAnimation();
    initEditor();
  });
</script>
