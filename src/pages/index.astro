    /* =========================================================
       THEME VARIABLES
    ========================================================== */

    :root {

      --bg: #07101f;
      --bg2: #0b1628;
      --bg3: #111f34;

      --text: #f8fafc;
      --text-muted: #94a3b8;

      --primary: #38bdf8;
      --primary-strong: #2563eb;
      --primary-hover: #0ea5e9;

      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(56, 189, 248, 0.35);

      --card: rgba(15, 23, 42, 0.82);
      --card-solid: #111c30;

      --shadow:
        0 20px 60px rgba(0, 0, 0, 0.28);

      --shadow-blue:
        0 15px 45px rgba(37, 99, 235, 0.18);
    }


    [data-theme="light"] {

      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --bg3: #e8f0f8;

      --text: #0f172a;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-strong: #1d4ed8;
      --primary-hover: #1e40af;

      --border: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(37, 99, 235, 0.25);

      --card: rgba(255, 255, 255, 0.92);
      --card-solid: #ffffff;

      --shadow:
        0 20px 50px rgba(15, 23, 42, 0.08);

      --shadow-blue:
        0 15px 45px rgba(37, 99, 235, 0.12);
    }


    /* =========================================================
       GLOBAL
    ========================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      background: var(--bg);
      color: var(--text);

      font-family: 'Cairo', sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color 0.3s ease,
        color 0.3s ease;
    }


    img {
      display: block;
      max-width: 100%;
    }


    a {
      color: inherit;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    .container {

      width: min(1200px, calc(100% - 40px));

      margin-inline: auto;
    }


    section {
      padding: 100px 0;
      position: relative;
    }


    /* =========================================================
       HERO
    ========================================================== */

    .hero {

      min-height: 820px;

      display: flex;
      align-items: center;

      position: relative;

      overflow: hidden;

      padding:
        150px 0
        100px;
    }


    .hero-bg {

      position: absolute;
      inset: 0;

      z-index: -2;
    }


    .hero-bg img {

      width: 100%;
      height: 100%;

      object-fit: cover;

      filter: brightness(0.3) saturate(0.9);
    }


    [data-theme="light"] .hero-bg img {
      filter: brightness(0.65) saturate(0.8);
    }


    .hero-overlay {

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          90deg,
          rgba(7, 16, 31, 0.98) 0%,
          rgba(7, 16, 31, 0.82) 42%,
          rgba(7, 16, 31, 0.45) 100%
        );
    }


    [data-theme="light"] .hero-overlay {

      background:
        linear-gradient(
          90deg,
          rgba(248, 250, 252, 0.96) 0%,
          rgba(248, 250, 252, 0.85) 45%,
          rgba(248, 250, 252, 0.55) 100%
        );
    }


    .hero-grid {

      position: absolute;
      inset: 0;

      opacity: 0.15;

      background-image:
        linear-gradient(
          rgba(56, 189, 248, 0.12) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(56, 189, 248, 0.12) 1px,
          transparent 1px
        );

      background-size: 60px 60px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 85%
        );
    }


    .hero-glow {

      position: absolute;

      width: 500px;
      height: 500px;

      border-radius: 50%;

      background: rgba(37, 99, 235, 0.14);

      filter: blur(100px);

      pointer-events: none;
    }


    .hero-glow-one {
      top: -200px;
      right: 15%;
    }


    .hero-glow-two {
      bottom: -300px;
      left: 5%;
    }


    .hero-container {

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 0.9fr);

      gap: 70px;

      align-items: center;
    }


    .hero-content {
      position: relative;
      z-index: 2;
    }


    /* =========================================================
       BADGE
    ========================================================== */

    .badge {

      display: inline-flex;

      align-items: center;
      gap: 9px;

      padding: 8px 16px;

      margin-bottom: 25px;

      border-radius: 999px;

      background:
        rgba(56, 189, 248, 0.09);

      border:
        1px solid
        rgba(56, 189, 248, 0.22);

      color: var(--primary);

      font-size: 0.9rem;

      font-weight: 700;

      backdrop-filter: blur(12px);
    }


    .badge-dot {

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--primary);

      box-shadow:
        0 0 0 5px
        rgba(56, 189, 248, 0.08);

      animation: pulseDot 2s infinite;
    }


    @keyframes pulseDot {

      0%,
      100% {
        box-shadow:
          0 0 0 4px
          rgba(56, 189, 248, 0.08);
      }

      50% {
        box-shadow:
          0 0 0 8px
          rgba(56, 189, 248, 0.02);
      }
    }


    /* =========================================================
       HERO TYPOGRAPHY
    ========================================================== */

    h1 {

      max-width: 780px;

      font-size:
        clamp(
          2.4rem,
          5vw,
          4.7rem
        );

      line-height: 1.2;

      font-weight: 900;

      letter-spacing: -1px;

      margin-bottom: 25px;
    }


    .gradient-text {

      background:
        linear-gradient(
          135deg,
          #60a5fa 0%,
          #38bdf8 45%,
          #22d3ee 100%
        );

      -webkit-background-clip: text;
      background-clip: text;

      -webkit-text-fill-color: transparent;

      color: transparent;
    }


    .cursor {

      color: var(--primary);

      animation: blink 1s infinite;
    }


    @keyframes blink {

      50% {
        opacity: 0;
      }
    }


    .hero-description {

      max-width: 650px;

      color: var(--text-muted);

      font-size: 1.08rem;

      line-height: 2;

      margin-bottom: 32px;
    }


    /* =========================================================
       BUTTONS
    ========================================================== */

    .hero-actions {

      display: flex;

      gap: 13px;

      flex-wrap: wrap;

      margin-bottom: 30px;
    }


    .btn {

      min-height: 56px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 10px;

      padding:
        0 22px;

      border-radius: 14px;

      text-decoration: none;

      font-weight: 800;

      font-size: 0.95rem;

      border: 1px solid transparent;

      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease;
    }


    .btn-primary {

      color: #fff;

      background:
        linear-gradient(
          135deg,
          var(--primary-strong),
          var(--primary-hover)
        );

      box-shadow:
        0 12px 35px
        rgba(37, 99, 235, 0.28);
    }


    .btn-primary:hover {

      transform: translateY(-3px);

      box-shadow:
        0 18px 45px
        rgba(37, 99, 235, 0.38);
    }


    .btn-secondary {

      background:
        rgba(255, 255, 255, 0.05);

      color: var(--text);

      border-color:
        rgba(148, 163, 184, 0.22);

      backdrop-filter: blur(10px);
    }


    [data-theme="light"] .btn-secondary {
      background: rgba(255, 255, 255, 0.8);
    }


    .btn-secondary:hover {

      transform: translateY(-3px);

      border-color: var(--primary);

      color: var(--primary);
    }


    .btn-arrow {

      transition:
        transform 0.25s ease;
    }


    .btn-primary:hover .btn-arrow {
      transform: translateX(-4px);
    }


    /* =========================================================
       HERO FEATURES
    ========================================================== */

    .hero-features {

      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 22px;
    }


    .hero-feature {

      display: flex;

      align-items: center;

      gap: 8px;

      color: var(--text-muted);

      font-size: 0.88rem;

      font-weight: 600;
    }


    .feature-check {

      width: 27px;
      height: 27px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 8px;

      background:
        rgba(56, 189, 248, 0.1);

      color: var(--primary);

      font-size: 0.75rem;
    }


    /* =========================================================
       HERO VISUAL
    ========================================================== */

    .hero-visual {

      height: 530px;

      position: relative;

      display: flex;

      align-items: center;
      justify-content: center;
    }


    .visual-center {

      width: 220px;
      height: 220px;

      position: relative;

      display: flex;

      flex-direction: column;

      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background:
        radial-gradient(
          circle at 50% 40%,
          rgba(56, 189, 248, 0.16),
          rgba(15, 23, 42, 0.8) 65%
        );

      border:
        1px solid
        rgba(56, 189, 248, 0.2);

      box-shadow:
        0 0 70px
        rgba(37, 99, 235, 0.16),
        inset 0 0 40px
        rgba(56, 189, 248, 0.04);

      z-index: 2;
    }


    [data-theme="light"] .visual-center {

      background:
        radial-gradient(
          circle at 50% 40%,
          rgba(37, 99, 235, 0.1),
          rgba(255, 255, 255, 0.94) 65%
        );
    }


    .center-icon {

      width: 70px;
      height: 70px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 20px;

      color: #fff;

      font-size: 2rem;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #06b6d4
        );

      box-shadow:
        0 12px 30px
        rgba(37, 99, 235, 0.3);
    }


    .center-lines {

      display: flex;

      gap: 5px;

      margin-top: 13px;
    }


    .center-lines span {

      width: 18px;
      height: 3px;

      border-radius: 20px;

      background: var(--primary);

      opacity: 0.6;
    }


    .center-lines span:nth-child(2) {
      width: 28px;
      opacity: 0.9;
    }


    .center-label {

      display: flex;

      flex-direction: column;

      align-items: center;

      margin-top: 8px;
    }


    .center-label strong {

      font-size: 0.75rem;

      letter-spacing: 2px;

      color: var(--text);
    }


    .center-label small {

      color: var(--text-muted);

      font-size: 0.58rem;

      letter-spacing: 1px;
    }


    /* =========================================================
       ORBITS
    ========================================================== */

    .visual-orbit {

      position: absolute;

      border-radius: 50%;

      border:
        1px dashed
        rgba(56, 189, 248, 0.16);

      animation:
        orbitSpin 25s linear infinite;
    }


    .orbit-one {

      width: 350px;
      height: 350px;
    }


    .orbit-two {

      width: 470px;
      height: 470px;

      animation-duration: 35s;

      animation-direction: reverse;
    }


    @keyframes orbitSpin {

      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }


    /* =========================================================
       FLOATING CARDS
    ========================================================== */

    .float-card {

      position: absolute;

      display: flex;

      align-items: center;

      gap: 11px;

      padding: 13px 16px;

      background:
        rgba(15, 23, 42, 0.75);

      border:
        1px solid
        rgba(148, 163, 184, 0.16);

      border-radius: 15px;

      color: var(--text);

      box-shadow:
        0 20px 50px
        rgba(0, 0, 0, 0.2);

      backdrop-filter: blur(15px);

      z-index: 4;

      font-size: 0.82rem;

      font-weight: 700;

      animation:
        floatCard 6s ease-in-out infinite;
    }


    [data-theme="light"] .float-card {

      background:
        rgba(255, 255, 255, 0.88);

      box-shadow:
        0 20px 45px
        rgba(15, 23, 42, 0.1);
    }


    .float-card i {
      font-size: 1.5rem;
    }


    .card-1 {

      width: 230px;

      top: 50px;
      left: 0;

      flex-direction: column;

      align-items: flex-start;

      animation-delay: 0s;
    }


    .card-2 {

      top: 105px;
      right: 0;

      animation-delay: 1s;
    }


    .card-3 {

      bottom: 125px;
      left: 25px;

      animation-delay: 2s;
    }


    .card-4 {

      bottom: 50px;
      right: 75px;

      animation-delay: 3s;
    }


    @keyframes floatCard {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-13px);
      }
    }


    .card-icon {

      width: 42px;
      height: 42px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      font-size: 1.5rem;
    }


    .python-icon {

      background:
        rgba(59, 130, 246, 0.12);

      color: #60a5fa;
    }


    .small-icon {

      width: 38px;
      height: 38px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 10px;
    }


    .js-icon {

      color: #facc15;

      background:
        rgba(250, 204, 21, 0.1);
    }


    .terminal-icon {

      color: #38bdf8;

      background:
        rgba(56, 189, 248, 0.1);
    }


    .success-icon {

      color: #22c55e;

      background:
        rgba(34, 197, 94, 0.1);
    }


    .code-box {

      width: 100%;

      direction: ltr;

      text-align: left;

      font-family:
        'Fira Code',
        'Courier New',
        monospace;

      font-size: 0.8rem;

      line-height: 1.8;
    }


    .code-comment {
      color: var(--text-muted);
    }


    /* =========================================================
       SCROLL INDICATOR
    ========================================================== */

    .scroll-indicator {

      position: absolute;

      bottom: 25px;
      left: 50%;

      transform: translateX(-50%);

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 4px;

      color: var(--text-muted);

      font-size: 0.68rem;

      opacity: 0.65;

      animation:
        scrollBounce 2s infinite;
    }


    .scroll-indicator i {
      color: var(--primary);
    }


    @keyframes scrollBounce {

      0%,
      100% {
        transform:
          translate(-50%, 0);
      }

      50% {
        transform:
          translate(-50%, 6px);
      }
    }


    /* =========================================================
       TICKER
    ========================================================== */

    .tech-ticker {

      overflow: hidden;

      padding: 17px 0;

      background: var(--bg2);

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);
    }


    .ticker-track {

      display: flex;

      width: max-content;

      gap: 60px;

      animation:
        tickerScroll 35s linear infinite;
    }


    .tech-item {

      display: flex;

      align-items: center;

      gap: 9px;

      white-space: nowrap;

      color: var(--text-muted);

      font-size: 0.86rem;

      font-weight: 700;
    }


    .tech-item i {
      color: var(--primary);
      font-size: 1.05rem;
    }


    @keyframes tickerScroll {

      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(50%);
      }
    }


    /* =========================================================
       STATS
    ========================================================== */

    .stats {

      padding: 45px 0;

      background:
        linear-gradient(
          180deg,
          var(--bg2),
          var(--bg)
        );

      border-bottom:
        1px solid var(--border);
    }


    .stats-grid {

      display: flex;

      align-items: center;
      justify-content: center;

      gap: 65px;
    }


    .stat-item {

      display: flex;

      align-items: center;

      gap: 15px;

      min-width: 190px;
    }


    .stat-icon-wrapper {

      width: 50px;
      height: 50px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 14px;

      background:
        rgba(37, 99, 235, 0.08);

      color: var(--primary);

      font-size: 1.25rem;
    }


    .stat-content {

      display: flex;

      flex-direction: column;
    }


    .stat-num {

      display: block;

      font-size: 2rem;

      line-height: 1;

      font-weight: 900;

      color: var(--primary);
    }


    .stat-label {

      margin-top: 5px;

      color: var(--text-muted);

      font-size: 0.78rem;
    }


    .stat-divider {

      width: 1px;
      height: 50px;

      background: var(--border);
    }


    /* =========================================================
       SECTION HEADING
    ========================================================== */

    .section-heading {

      max-width: 700px;

      margin: 0 auto 55px;

      text-align: center;
    }


    .section-kicker {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-bottom: 12px;

      color: var(--primary);

      font-size: 0.78rem;

      font-weight: 800;

      letter-spacing: 0.3px;
    }


    h2 {

      margin-bottom: 10px;

      color: var(--text);

      font-size:
        clamp(
          1.8rem,
          4vw,
          2.5rem
        );

      line-height: 1.3;

      font-weight: 900;
    }


    h2 i {

      margin-left: 8px;

      color: var(--primary);

      font-size: 0.8em;
    }


    .section-heading > p {

      color: var(--text-muted);

      font-size: 0.95rem;
    }


    /* =========================================================
       TRACKS
    ========================================================== */

    .tracks {

      background: var(--bg);
    }


    .tracks-grid {

      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 20px;
    }


    .track {

      position: relative;

      overflow: hidden;

      display: flex;

      flex-direction: column;

      min-height: 480px;

      background: var(--card);

      border:
        1px solid var(--border);

      border-radius: 20px;

      text-decoration: none;

      transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
    }


    .track:hover {

      transform: translateY(-8px);

      border-color:
        var(--border-strong);

      box-shadow:
        var(--shadow-blue);
    }


    .track-img {

      height: 190px;

      position: relative;

      overflow: hidden;
    }


    .track-img img {

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform 0.6s ease;
    }


    .track:hover .track-img img {
      transform: scale(1.08);
    }


    .track-img-overlay {

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          to top,
          rgba(7, 16, 31, 0.75),
          transparent 65%
        );
    }


    .track-number {

      position: absolute;

      top: 15px;
      right: 15px;

      padding: 4px 9px;

      border-radius: 8px;

      background:
        rgba(7, 16, 31, 0.55);

      border:
        1px solid
        rgba(255, 255, 255, 0.1);

      color: #fff;

      font-size: 0.7rem;

      font-weight: 800;
    }


    .track-body {

      display: flex;

      flex: 1;

      flex-direction: column;

      padding: 22px;
    }


    .track-top {

      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-bottom: 15px;
    }


    .icon {

      width: 50px;
      height: 50px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 14px;

      background: var(--bg3);

      color: var(--primary);

      font-size: 1.25rem;
    }


    .track-arrow {

      width: 35px;
      height: 35px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 50%;

      color: var(--text-muted);

      background: var(--bg3);

      transition:
        all 0.3s ease;
    }


    .track:hover .track-arrow {

      background: var(--primary);

      color: #fff;

      transform:
        translateX(-3px);
    }


    h3 {

      color: var(--text);

      font-size: 1.12rem;

      font-weight: 800;

      margin-bottom: 7px;
    }


    .track-body > p {

      color: var(--text-muted);

      font-size: 0.83rem;

      line-height: 1.8;

      margin-bottom: 15px;
    }


    .track-list {

      list-style: none;

      margin-top: auto;
    }


    .track-list li {

      display: flex;

      align-items: center;

      gap: 7px;

      padding: 5px 0;

      color: var(--text-muted);

      font-size: 0.77rem;
    }


    .track-list i {

      color: var(--primary);

      font-size: 0.65rem;
    }


    /* =========================================================
       FEATURES
    ========================================================== */

    .features {

      background: var(--bg2);
    }


    .features-grid {

      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 20px;
    }


    .feature-box {

      position: relative;

      overflow: hidden;

      padding: 30px 22px;

      text-align: center;

      background: var(--card);

      border:
        1px solid var(--border);

      border-radius: 20px;

      transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }


    .feature-box::before {

      content: "";

      position: absolute;

      width: 130px;
      height: 130px;

      top: -70px;
      right: -60px;

      border-radius: 50%;

      background:
        rgba(37, 99, 235, 0.06);
    }


    .feature-box:hover {

      transform: translateY(-7px);

      border-color:
        var(--border-strong);

      box-shadow:
        var(--shadow-blue);
    }


    .feature-icon {

      width: 68px;
      height: 68px;

      display: flex;

      align-items: center;
      justify-content: center;

      margin: 0 auto 18px;

      border-radius: 20px;

      color: var(--primary);

      background: var(--bg3);

      font-size: 1.65rem;

      transition:
        transform 0.3s ease;
    }


    .feature-box:hover .feature-icon {
      transform: scale(1.06);
    }


    .feature-number {

      display: block;

      margin-bottom: 8px;

      color: var(--primary);

      font-size: 0.68rem;

      font-weight: 900;

      letter-spacing: 1px;

      opacity: 0.75;
    }


    .feature-box h3 {
      margin-bottom: 8px;
    }


    .feature-box p {

      color: var(--text-muted);

      font-size: 0.82rem;

      line-height: 1.8;
    }


    /* =========================================================
       FAQ
    ========================================================== */

    .faq {

      background: var(--bg);
    }


    .faq-grid {

      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 15px;
    }


    .faq-item {

      display: flex;

      align-items: flex-start;

      gap: 15px;

      padding: 22px;

      background: var(--card);

      border:
        1px solid var(--border);

      border-radius: 17px;

      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
    }


    .faq-item:hover {

      transform: translateY(-4px);

      border-color:
        var(--border-strong);
    }


    .faq-icon {

      flex: 0 0 42px;

      width: 42px;
      height: 42px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background:
        rgba(37, 99, 235, 0.08);

      color: var(--primary);

      font-size: 0.95rem;
    }


    .faq-item h3 {

      margin-bottom: 6px;

      color: var(--text);

      font-size: 0.95rem;
    }


    .faq-item p {

      color: var(--text-muted);

      font-size: 0.8rem;

      line-height: 1.8;
    }


    /* =========================================================
       SCROLL TOP
    ========================================================== */

    .scroll-top {

      position: fixed;

      left: 25px;
      bottom: 25px;

      width: 48px;
      height: 48px;

      display: flex;

      align-items: center;
      justify-content: center;

      border: 1px solid
        rgba(255, 255, 255, 0.08);

      border-radius: 15px;

      background:
        linear-gradient(
          135deg,
          var(--primary-strong),
          var(--primary-hover)
        );

      color: #fff;

      cursor: pointer;

      opacity: 0;

      visibility: hidden;

      transform:
        translateY(15px);

      transition:
        opacity 0.3s ease,
        visibility 0.3s ease,
        transform 0.3s ease;

      z-index: 999;

      box-shadow:
        0 10px 30px
        rgba(37, 99, 235, 0.25);
    }


    .scroll-top.show {

      opacity: 1;

      visibility: visible;

      transform:
        translateY(0);
    }


    .scroll-top:hover {

      transform:
        translateY(-4px);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @media (max-width: 1100px) {

      .hero-container {
        gap: 30px;
      }

      .tracks-grid,
      .features-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .hero-visual {
        transform: scale(0.9);
      }

      .stats-grid {
        gap: 35px;
      }
    }


    @media (max-width: 900px) {

      section {
        padding: 75px 0;
      }


      .hero {

        min-height: auto;

        padding:
          130px 0
          90px;
      }


      .hero-container {

        grid-template-columns: 1fr;

        text-align: center;
      }


      .hero-content {

        display: flex;

        flex-direction: column;

        align-items: center;
      }


      .hero-description {
        max-width: 650px;
      }


      .hero-visual {

        display: none;
      }


      .hero-features {
        justify-content: center;
      }


      .stats-grid {
        gap: 25px;
      }
    }


    @media (max-width: 680px) {

      .container {
        width:
          min(
            100% - 28px,
            1200px
          );
      }


      section {
        padding: 60px 0;
      }


      .hero {

        padding:
          115px 0
          70px;
      }


      h1 {

        font-size:
          clamp(
            2rem,
            10vw,
            3rem
          );

        letter-spacing: -0.5px;
      }


      .hero-description {

        font-size: 0.9rem;

        line-height: 1.9;
      }


      .hero-actions {

        width: 100%;

        flex-direction: column;
      }


      .btn {

        width: 100%;
      }


      .hero-features {

        width: 100%;

        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 8px;
      }


      .hero-feature {

        flex-direction: column;

        justify-content: center;

        gap: 5px;

        font-size: 0.7rem;
      }


      .feature-check {

        width: 25px;
        height: 25px;
      }


      .stats {
        padding: 35px 0;
      }


      .stats-grid {

        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 8px;
      }


      .stat-item {

        min-width: 0;

        flex-direction: column;

        gap: 8px;

        text-align: center;
      }


      .stat-icon-wrapper {

        width: 42px;
        height: 42px;

        font-size: 1rem;
      }


      .stat-num {
        font-size: 1.5rem;
      }


      .stat-label {
        font-size: 0.65rem;
      }


      .stat-divider {
        display: none;
      }


      .tracks-grid,
      .features-grid,
      .faq-grid {

        grid-template-columns: 1fr;
