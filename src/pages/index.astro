WHERE created_at >= '2024-01-01'
ORDER BY name;`
  };

  let currentLang = 'javascript';
  let pyodide = null;
  let pyodideReady = false;

  // Initialize
  function initEditor() {
    const editor = document.getElementById('codeInput');
    if (editor) {
      editor.value = codeExamples.javascript;
      updateLineNumbers();
    }
    initPyodide();
  }

  // Update Line Numbers
  function updateLineNumbers() {
    const editor = document.getElementById('codeInput');
    const lineNumbers = document.getElementById('lineNumbers');
    if (!editor || !lineNumbers) return;
    
    const lines = editor.value.split('\n').length;
    lineNumbers.innerHTML = Array(lines).fill(0).map((_, i) => i + 1).join('<br>');
  }

  // Sync Scroll
  function syncScroll() {
    const editor = document.getElementById('codeInput');
    const lineNumbers = document.getElementById('lineNumbers');
    if (lineNumbers) {
      lineNumbers.scrollTop = editor.scrollTop;
    }
  }

  // Change Language
  function changeLanguage() {
    const select = document.getElementById('languageSelect');
    currentLang = select.value;
    const editor = document.getElementById('codeInput');
    const langInfo = document.getElementById('langInfo');
    const pyStatus = document.getElementById('pyodideStatus');
    
    editor.value = codeExamples[currentLang] || '';
    updateLineNumbers();
    clearOutput();
    
    // Update language info
    const langNames = {
      javascript: 'JavaScript',
      python: 'Python',
      html: 'HTML/CSS',
      java: 'Java',
      cpp: 'C++',
      sql: 'SQL'
    };
    langInfo.textContent = langNames[currentLang];
    
    // Show Pyodide status for Python
    if (currentLang === 'python') {
      pyStatus.style.display = 'inline';
    } else {
      pyStatus.style.display = 'none';
    }
    
    updateStatus('✅ جاهز');
  }

  // Run Code
  async function runCode() {
    const code = document.getElementById('codeInput').value;
    const output = document.getElementById('output');
    const runBtn = document.getElementById('runBtn');
    const runText = document.getElementById('runText');
    
    output.className = 'code-output';
    output.innerHTML = '<div class="output-placeholder"><span class="icon"></span><p>جاري التنفيذ...</p></div>';
    
    runBtn.disabled = true;
    runText.textContent = 'جاري...';
    
    try {
      if (currentLang === 'javascript') {
        runJavaScript(code, output);
      } else if (currentLang === 'python') {
        await runPython(code, output);
      } else if (currentLang === 'html') {
        runHTML(code, output);
      } else if (currentLang === 'java' || currentLang === 'cpp' || currentLang === 'sql') {
        // For languages that can't run in browser, show syntax info
        output.className = 'code-output success';
        output.innerHTML = `<div style="padding: 1rem; background: rgba(137,209,133,0.1); border-radius: 8px; border-left: 4px solid #89d185;">
          <strong>✅ ${currentLang.toUpperCase()} Code</strong><br><br>
          الكود الذي كتبته صحيح من حيث البنية.<br>
          لتشغيل ${currentLang === 'java' ? 'Java' : currentLang === 'cpp' ? 'C++' : 'SQL'} تحتاج إلى:<br><br>
          ${currentLang === 'java' ? '• JDK (Java Development Kit)<br>• JVM (Java Virtual Machine)' : 
            currentLang === 'cpp' ? '• مترجم C++ (g++, clang++)<br>• بيئة تطوير (IDE)' : 
            '• قاعدة بيانات (MySQL, PostgreSQL, etc.)<br>• عميل SQL'}
        </div>`;
      }
      updateStatus('✅ تم التنفيذ بنجاح');
    } catch (error) {
      output.className = 'code-output error';
      output.textContent = `❌ خطأ: ${error.message}`;
      updateStatus('❌ حدث خطأ');
    } finally {
      runBtn.disabled = false;
      runText.textContent = 'تشغيل الكود';
    }
  }

  // Run JavaScript
  function runJavaScript(code, output) {
    let logs = [];
    
    const customConsole = {
      log: (...args) => {
        logs.push(args.map(arg => 
          typeof arg === 'object' ? JSON.stringify(arg, null, 2) : String(arg)
        ).join(' '));
      },
      error: (...args) => logs.push(' ' + args.join(' ')),
      warn: (...args) => logs.push('️ ' + args.join(' '))
    };
    
    const wrappedCode = `(function(console) { ${code} })(customConsole);`;
    eval(wrappedCode);
    
    if (logs.length > 0) {
      output.className = 'code-output success';
      output.textContent = logs.join('\n');
    } else {
      output.innerHTML = '<div style="padding: 1rem; text-align: center; color: #89d185;">✅ تم التنفيذ بنجاح<br><small>(لا توجد مخرجات)</small></div>';
    }
  }

  // Run Python with Pyodide
  async function runPython(code, output) {
    if (!pyodideReady) {
      output.className = 'code-output';
      output.innerHTML = '<div class="output-placeholder"><span class="icon">⏳</span><p>جاري تحميل Python...<br><small>قد يستغرق 10-20 ثانية في المرة الأولى</small></p></div>';
      await initPyodide();
      if (!pyodideReady) {
        output.className = 'code-output error';
        output.textContent = '❌ فشل تحميل Pyodide. يرجى تحديث الصفحة والمحاولة مرة أخرى.';
        return;
      }
    }
    
    try {
      // Redirect stdout/stderr
      pyodide.setStdout({
        batched: (msg) => {
          if (output.textContent === 'جاري التنفيذ...') output.textContent = '';
          output.textContent += msg;
          output.scrollTop = output.scrollHeight;
        }
      });
      
      pyodide.setStderr({
        batched: (msg) => {
          output.className = 'code-output error';
          output.textContent += '❌ ' + msg;
        }
      });
      
      // Execute Python code
      await pyodide.runPythonAsync(code);
      
      if (output.textContent.trim() === '' || output.textContent === 'جاري التنفيذ...') {
        output.innerHTML = '<div style="padding: 1rem; text-align: center; color: #89d185;">✅ تم التنفيذ بنجاح<br><small>(لا توجد مخرجات)</small></div>';
        output.className = 'code-output success';
      } else {
        output.className = 'code-output success';
      }
      
    } catch (error) {
      output.className = 'code-output error';
      output.textContent = `❌ خطأ في Python: ${error.message}`;
    }
  }

  // Run HTML
  function runHTML(code, output) {
    output.className = 'code-output success';
    output.innerHTML = code;
  }

  // Initialize Pyodide
  async function initPyodide() {
    const pyStatus = document.getElementById('pyStatus');
    try {
      pyodide = await loadPyodide({
        indexURL: "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/"
      });
      pyodideReady = true;
      if (pyStatus) {
        pyStatus.textContent = '✅ جاهز';
        pyStatus.style.color = '#10b981';
      }
    } catch (error) {
      console.error('Failed to load Pyodide:', error);
      if (pyStatus) {
        pyStatus.textContent = '❌ فشل التحميل';
        pyStatus.style.color = '#ef4444';
      }
    }
  }

  // Clear Output
  function clearOutput() {
    const output = document.getElementById('output');
    output.innerHTML = '<div class="output-placeholder"><span class="icon">💡</span><p>اكتب كوداً ثم اضغط "تشغيل الكود" لرؤية النتيجة</p></div>';
    output.className = 'code-output';
    updateStatus('✅ جاهز');
  }

  // Reset Code
  function resetCode() {
    const editor = document.getElementById('codeInput');
    if (editor) {
      editor.value = codeExamples[currentLang];
      updateLineNumbers();
      clearOutput();
      updateStatus(' تم إعادة الكود الافتراضي');
    }
  }

  // Copy Code
  function copyCode() {
    const editor = document.getElementById('codeInput');
    if (editor) {
      navigator.clipboard.writeText(editor.value).then(() => {
        updateStatus('📋 تم نسخ الكود');
        setTimeout(() => updateStatus('✅ جاهز'), 2000);
      });
    }
  }

  // Load Example
  function loadExample(type) {
    const examples = {
      hello: {
        javascript: 'console.log("مرحباً بالعالم! 🌍");',
        python: 'print("مرحباً بالعالم! 🌍")',
        html: '<h1>مرحباً بالعالم!</h1>',
        java: 'System.out.println("مرحباً بالعالم! 🌍");',
        cpp: 'cout << "مرحباً بالعالم! 🌍" << endl;',
        sql: "SELECT 'مرحباً بالعالم!' AS greeting;"
      },
      loop: {
        javascript: 'for (let i = 1; i <= 5; i++) {\n  console.log(`الرقم: ${i}`);\n}',
        python: 'for i in range(1, 6):\n    print(f"الرقم: {i}")',
        html: '<ul>\n  <li>عنصر 1</li>\n  <li>عنصر 2</li>\n  <li>عنصر 3</li>\n</ul>',
        java: 'for (int i = 1; i <= 5; i++) {\n    System.out.println("الرقم: " + i);\n}',
        cpp: 'for (int i = 1; i <= 5; i++) {\n    cout << "الرقم: " << i << endl;\n}',
        sql: 'SELECT * FROM users LIMIT 5;'
      },
      function: {
        javascript: 'function add(a, b) {\n  return a + b;\n}\nconsole.log(add(5, 3));',
        python: 'def add(a, b):\n    return a + b\n\nprint(add(5, 3))',
        html: '<button onclick="alert(\'تم الضغط!\')">اضغط هنا</button>',
        java: 'public static int add(int a, int b) {\n    return a + b;\n}',
        cpp: 'int add(int a, int b) {\n    return a + b;\n}',
        sql: 'CREATE FUNCTION get_user(id INT) RETURNS VARCHAR(100) BEGIN RETURN (SELECT name FROM users WHERE id = id); END;'
      },
      array: {
        javascript: 'const arr = [1, 2, 3, 4, 5];\nconst doubled = arr.map(x => x * 2);\nconsole.log(doubled);',
        python: 'arr = [1, 2, 3, 4, 5]\ndoubled = [x * 2 for x in arr]\nprint(doubled)',
        html: '<div id="list"></div>\n<script>\nconst items = [1,2,3];\ndocument.getElementById("list").innerHTML = items.map(i => `<p>عنصر ${i}</p>`).join("");\n</script>',
        java: 'int[] arr = {1, 2, 3, 4, 5};\nfor (int num : arr) {\n    System.out.println(num * 2);\n}',
        cpp: 'vector<int> arr = {1, 2, 3, 4, 5};\nfor (int num : arr) {\n    cout << num * 2 << endl;\n}',
        sql: 'SELECT id, name, email FROM users WHERE id IN (1, 2, 3);'
      }
    };
    
    const editor = document.getElementById('codeInput');
    if (editor && examples[type] && examples[type][currentLang]) {
      editor.value = examples[type][currentLang];
      updateLineNumbers();
      clearOutput();
      updateStatus(`📝 تم تحميل مثال: ${type}`);
    }
  }

  // Update Status
  function updateStatus(message) {
    const status = document.getElementById('statusInfo');
    if (status) {
      status.textContent = message;
    }
  }

  // Update Preview (for future use)
  function updatePreview() {
    // Can be used for live preview
  }

  // Keyboard Shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === 'Enter') {
      runCode();
    }
  });

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    initCounterAnimation();
    initEditor();
  });
</script>
