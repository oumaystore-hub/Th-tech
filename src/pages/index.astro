  .article-image { height: 180px; overflow: hidden; position: relative; }
  .article-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .article-card:hover .article-image img { transform: scale(1.08); }
  .article-content { padding: 1.5rem; }
  .article-meta { display: flex; justify-content: space-between; margin-bottom: 0.8rem; font-size: 0.85rem; }
  .article-category { color: var(--primary); font-weight: 600; }
  .article-time { color: var(--text-sec); }
  .article-content h3 { font-size: 1.05rem; margin-bottom: 0.6rem; line-height: 1.4; }
  .article-content p { color: var(--text-sec); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem; }
  .article-link { color: var(--primary); font-weight: 600; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.3rem; }
  .article-link:hover { gap: 0.6rem; transition: gap 0.3s; }
  @media (max-width: 1024px) { .articles-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .articles-grid { grid-template-columns: 1fr; } }

  /* Combined Section */
  .combined-section { padding: 4rem 0; background: var(--card); }
  .combined-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .why-desc { color: var(--text-sec); font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7; }
  .why-features { display: flex; flex-direction: column; gap: 1.5rem; }
  .why-feature { display: flex; gap: 1.2rem; align-items: flex-start; }
  .why-icon { font-size: 2rem; flex-shrink: 0; }
  .why-text h4 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .why-text p { color: var(--text-sec); font-size: 0.95rem; line-height: 1.6; }
  
  .newsletter-box { position: relative; border-radius: var(--radius); overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
