}`,

    sql: `-- مرحباً بك في محرر SQL
-- استعلامات قاعدة بيانات

-- إنشاء جدول
CREATE TABLE users (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100),
    created_at DATE
);

-- إدراج بيانات
INSERT INTO users VALUES 
(1, 'أحمد محمد', 'ahmed@example.com', '2024-01-15'),
(2, 'سارة أحمد', 'sara@example.com', '2024-01-16');

