---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((file) => file.match(/\.\/tools\/([^/]+)\/index\.astro$/)?.[1])
  .filter(Boolean);

const displayName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolsData = toolSlugs.map((slug) => ({
  slug,
  name: displayName(slug),
  href: `${base}/tools/${slug}/`
}));

const toolsCount = toolsData.length;

/*
 * الأدوات الظاهرة في الصفحة الرئيسية فقط.
 * باقي الأدوات تبقى موجودة في الموقع دون تغيير.
 */
const featuredSlugs = [
  'json-formatter',
  'json-validator',
  'base64-encoder-decoder',
  'qr-code-generator',
  'color-picker',
  'api-request-builder'
];

const featuredMeta = {
  'json-formatter': {
    icon: 'fa-solid fa-code',
    type: 'JSON',
    image:
      'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=900&q=80'
  },

  'json-validator': {
    icon: 'fa-solid fa-circle-check',
    type: 'VALIDATOR',
    image:
      'https://images.unsplash.com/photo-1516116216624-53e697fedbea?auto=format&fit=crop&w=900&q=80'
  },

  'base64-encoder-decoder': {
    icon: 'fa-solid fa-lock',
    type: 'BASE64',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=900&q=80'
  },

  'qr-code-generator': {
    icon: 'fa-solid fa-qrcode',
    type: 'QR CODE',
    image:
      'https://images.unsplash.com/photo-1595079676339-1534801ad6cf?auto=format&fit=crop&w=900&q=80'
  },

  'color-picker': {
    icon: 'fa-solid fa-palette',
    type: 'COLOR',
    image:
      'https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=900&q=80'
  },

  'api-request-builder': {
    icon: 'fa-solid fa-plug',
    type: 'API',
    image:
      'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=900&q=80'
  }
};

const featuredTools = featuredSlugs
  .map((slug) => {
    const tool = toolsData.find((item) => item.slug === slug);

    if (!tool) return null;

    return {
      ...tool,
      ...(featuredMeta[slug] || {
        icon: 'fa-solid fa-wand-magic-sparkles',
        type: 'TOOL',
        image:
          'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=900&q=80'
      })
    };
  })
  .filter(Boolean);

const quickTools = featuredTools.slice(0, 6);

const tracks = [
  {
    icon: 'fa-solid fa-brain',
    title: 'الذكاء الاصطناعي',
    tag: 'AI',
    description: 'أدوات وتقنيات تساعدك على اكتشاف عالم الذكاء الاصطناعي.',
    image:
      'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1100&q=80'
  },

  {
    icon: 'fa-solid fa-code',
    title: 'البرمجة',
    tag: 'CODE',
    description: 'أدوات عملية للمطورين والبيانات وواجهات البرمجة.',
    image:
      'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1100&q=80'
  },

  {
    icon: 'fa-solid fa-shield-halved',
    title: 'الأمن والخصوصية',
    tag: 'SECURITY',
    description: 'تشفير وتحويل وترميز وفحص البيانات بطريقة عملية.',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=1100&q=80'
  },

  {
    icon: 'fa-solid fa-globe',
    title: 'الويب',
    tag: 'WEB',
    description: 'أدوات للمواقع والمحتوى والمشاريع الرقمية الحديثة.',
    image:
      'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1100&q=80'
  }
];

const missions = [
  {
    icon: 'fa-solid fa-brackets-curly',
    title: 'JSON والبيانات',
    description: 'تنسيق وفحص وتحويل البيانات بسهولة.',
    href: `${base}/tools/json-formatter/`
  },
  {
    icon: 'fa-solid fa-plug',
    title: 'API وHTTP',
    description: 'اختبر طلبات API وتعامل مع البيانات.',
    href: `${base}/tools/api-request-builder/`
  },
  {
    icon: 'fa-solid fa-lock',
    title: 'التشفير والترميز',
    description: 'Base64 وHash وUUID وأدوات أخرى.',
    href: `${base}/tools/`
  },
  {
    icon: 'fa-solid fa-palette',
    title: 'الألوان والتصميم',
    description: 'اختر وحلل الألوان لمشاريعك.',
    href: `${base}/tools/color-picker/`
  }
];

const labs = [
  {
    icon: 'fa-solid fa-terminal',
    title: 'مختبر المطور',
    description: 'مجموعة مختارة من أدوات البرمجة والبيانات وواجهات API.',
    tag: 'DEVELOPER',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-user-shield',
    title: 'مختبر الخصوصية',
    description: 'أدوات للتشفير والترميز والتحقق من البيانات.',
    tag: 'PRIVACY',
    href: '#tools'
  },
  {
    icon: 'fa-solid fa-wand-magic-sparkles',
    title: 'مختبر الذكاء الاصطناعي',
    description: 'مساحة مخصصة لاكتشاف أدوات وتقنيات AI الجديدة.',
    tag: 'AI',
    href: '#tracks'
  }
];

const tickerItems = [
  ['fa-solid fa-code', 'JSON'],
  ['fa-brands fa-js', 'JavaScript'],
  ['fa-brands fa-html5', 'HTML'],
  ['fa-brands fa-css3-alt', 'CSS'],
  ['fa-solid fa-plug', 'API'],
  ['fa-solid fa-database', 'SQL'],
  ['fa-solid fa-qrcode', 'QR CODE'],
  ['fa-solid fa-lock', 'BASE64'],
  ['fa-solid fa-key', 'JWT'],
  ['fa-solid fa-filter', 'REGEX'],
  ['fa-solid fa-fingerprint', 'UUID'],
  ['fa-solid fa-hashtag', 'HASH'],
  ['fa-brands fa-markdown', 'MARKDOWN'],
  ['fa-solid fa-clock', 'TIMESTAMP']
];

const faqs = [
  {
    q: 'ما هي منصة Th.Tech؟',
    a: 'Th.Tech منصة تقنية عربية تجمع أدوات ويب عملية للبرمجة والبيانات والذكاء الاصطناعي والأمن والويب في مكان واحد.'
  },
  {
    q: 'هل الأدوات مجانية؟',
    a: 'نعم، الأدوات متاحة للاستخدام مباشرة من المتصفح دون الحاجة إلى تثبيت برامج إضافية.'
  },
  {
    q: 'هل تعمل الأدوات على الهاتف؟',
    a: 'نعم، تم تصميم المنصة والأدوات لتكون متجاوبة مع الهاتف والأجهزة اللوحية والكمبيوتر.'
  },
  {
    q: 'هل يتم إرسال البيانات إلى خادم خارجي؟',
    a: 'تعتمد المعالجة على نوع الأداة. العديد من الأدوات تعمل داخل المتصفح مباشرة، لذلك ننصح بمراجعة وصف كل أداة قبل استخدام بيانات حساسة.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description:
    'Th.Tech منصة تقنية عربية للأدوات والبرمجة والذكاء الاصطناعي',
  inLanguage: 'ar',
  publisher: {
    '@type': 'Organization',
    name: 'Th.Tech',
    url: `${siteUrl}${base}/`,
    sameAs: [
      'https://www.facebook.com/share/1PzewvX774/',
      'https://www.instagram.com/thtech.ma',
      'https://x.com/thtechma',
      'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438',
      'https://www.youtube.com/@thtechma'
    ]
  }
};

/*
 * رابط محرر الأكواد.
 * إذا كان slug صفحته مختلفاً لديك، غيّر هذا السطر فقط.
 */
const codeEditorHref = `${base}/tools/code-editor/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    Th.Tech | أدوات تقنية عربية للبرمجة والذكاء الاصطناعي
  </title>

  <meta
    name="description"
    content="Th.Tech منصة تقنية عربية تضم أدوات مجانية للبرمجة والويب والذكاء الاصطناعي والأمن السيبراني والبيانات."
  />

  <meta
    name="keywords"
    content="Th.Tech, أدوات تقنية, أدوات برمجة, JSON, API, QR, Base64, ذكاء اصطناعي, أدوات ويب"
  />

  <meta name="theme-color" content="#07111f" />

  <link rel="canonical" href={`${siteUrl}${base}/`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <style>
    :root {
      --bg: #f6f9fc;
      --surface: rgba(255,255,255,.88);
      --surface-solid: #fff;
      --surface-soft: #eef7fb;

      --text: #0f172a;
      --muted: #607084;
      --soft: #8a98a9;

      --border: rgba(15,23,42,.08);
      --primary: #0891b2;
      --blue: #2563eb;
      --violet: #6366f1;
      --cyan: #06b6d4;

      --container: 1160px;

      --r-xl: 26px;
      --r-lg: 19px;
      --r-md: 14px;

      --shadow:
        0 15px 45px rgba(15,23,42,.065);
    }

    html.dark-mode {
      --bg: #050a12;
      --surface: rgba(12,23,39,.84);
      --surface-solid: #0c1727;
      --surface-soft: #0d1b2d;

      --text: #f8fafc;
      --muted: #9aabbd;
      --soft: #718196;

      --border: rgba(148,163,184,.105);

      --primary: #22d3ee;
      --blue: #60a5fa;
      --violet: #818cf8;
      --cyan: #67e8f9;

      --shadow:
        0 18px 55px rgba(0,0,0,.25);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      overflow-x: hidden;

      font-family: "Cairo", sans-serif;

      color: var(--text);

      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(6,182,212,.065),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 12%,
          rgba(99,102,241,.055),
          transparent 25%
        ),
        var(--bg);

      transition:
        background .3s ease,
        color .3s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(
        var(--container),
        calc(100% - 40px)
      );

      margin-inline: auto;
    }

    /* =====================================================
       BACKGROUND
    ===================================================== */

    .background {
      position: fixed;
      inset: 0;
      z-index: -5;

      pointer-events: none;
      overflow: hidden;
    }

    .grid-bg {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(14,165,233,.025) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(14,165,233,.025) 1px,
          transparent 1px
        );

      background-size: 48px 48px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 70%
        );
    }

    .orb {
      position: absolute;

      border-radius: 50%;

      filter: blur(75px);

      opacity: .12;
    }

    .orb-one {
      width: 280px;
      height: 280px;

      top: 40px;
      right: -130px;

      background: #22d3ee;

      animation:
        orbOne 18s ease-in-out infinite;
    }

    .orb-two {
      width: 240px;
      height: 240px;

      top: 850px;
      left: -120px;

      background: #6366f1;

      animation:
        orbTwo 21s ease-in-out infinite;
    }

    @keyframes orbOne {
      50% {
        transform:
          translate(-35px,25px);
      }
    }

    @keyframes orbTwo {
      50% {
        transform:
          translate(30px,-25px);
      }
    }

    /* =====================================================
       HERO
    ===================================================== */

    .hero {
      padding:
        72px 0
        58px;
    }

    .hero-grid {
      display: grid;

      grid-template-columns:
        1fr
        .9fr;

      align-items: center;

      gap: 65px;
    }

    .hero-content {
      animation:
        heroIn .7s ease both;
    }

    @keyframes heroIn {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding:
        7px 12px;

      border:
        1px solid var(--border);

      border-radius: 999px;

      background:
        var(--surface);

      color:
        var(--muted);

      font-size: 10px;
      font-weight: 700;

      box-shadow:
        var(--shadow);
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background:
        var(--cyan);

      box-shadow:
        0 0 0 4px
        rgba(6,182,212,.1);

      animation:
        pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse {
      50% {
        transform: scale(1.2);
        opacity: .7;
      }
    }

    .hero h1 {
      margin:
        19px 0
        15px;

      max-width: 650px;

      font-size:
        clamp(38px,5vw,59px);

      line-height: 1.16;

      letter-spacing: -1.8px;

      font-weight: 900;
    }

    .gradient {
      background:
        linear-gradient(
          100deg,
          var(--primary),
          var(--blue),
          var(--violet)
        );

      background-size: 180% auto;

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;

      animation:
        gradient 6s ease-in-out infinite;
    }

    @keyframes gradient {
      50% {
        background-position: 100% center;
      }
    }

    .hero-description {
      max-width: 610px;

      margin: 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 2;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;

      gap: 10px;

      margin-top: 24px;
    }

    .btn {
      min-height: 45px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      padding:
        0 17px;

      border:
        1px solid var(--border);

      border-radius: 12px;

      font-size: 11px;
      font-weight: 800;

      transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
    }

    .btn:hover {
      transform:
        translateY(-2px);
    }

    .btn-primary {
      color: #fff;

      border-color: transparent;

      background:
        linear-gradient(
          135deg,
          #0891b2,
          #2563eb
        );

      box-shadow:
        0 12px 28px
        rgba(37,99,235,.2);
    }

    .btn-secondary {
      color: var(--text);

      background:
        var(--surface);
    }

    .btn-secondary:hover {
      border-color:
        rgba(6,182,212,.28);
    }

    .hero-note {
      display: flex;
      flex-wrap: wrap;

      gap: 15px;

      margin-top: 19px;

      color: var(--soft);

      font-size: 9px;
      font-weight: 700;
    }

    .hero-note span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .hero-note i {
      color: var(--primary);
    }

    /* =====================================================
       HERO VISUAL
    ===================================================== */

    .hero-visual {
      min-height: 410px;

      display: grid;
      place-items: center;

      animation:
        visualIn .85s .1s ease both;
    }

    @keyframes visualIn {
      from {
        opacity: 0;
        transform: scale(.96);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .visual {
      position: relative;

      width: 410px;
      height: 410px;
    }

    .visual::before {
      content: "";

      position: absolute;
      inset: 55px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(6,182,212,.18),
          rgba(99,102,241,.07) 45%,
          transparent 70%
        );

      filter: blur(20px);

      animation:
        visualGlow 4s ease-in-out infinite;
    }

    @keyframes visualGlow {
      50% {
        transform: scale(1.07);
        opacity: .75;
      }
    }

    .ring {
      position: absolute;

      top: 50%;
      left: 50%;

      border-radius: 50%;

      transform:
        translate(-50%,-50%);
    }

    .ring-one {
      width: 250px;
      height: 250px;

      border:
        1px solid
        rgba(6,182,212,.2);

      border-top-color:
        rgba(6,182,212,.8);

      animation:
        rotate 14s linear infinite;
    }

    .ring-two {
      width: 320px;
      height: 320px;

      border:
        1px dashed
        rgba(99,102,241,.22);

      border-left-color:
        rgba(6,182,212,.65);

      animation:
        rotateReverse 19s linear infinite;
    }

    .ring-three {
      width: 385px;
      height: 385px;

      border:
        1px solid
        rgba(56,189,248,.07);

      border-bottom-color:
        rgba(99,102,241,.45);

      animation:
        rotate 25s linear infinite;
    }

    @keyframes rotate {
      to {
        transform:
          translate(-50%,-50%)
          rotate(360deg);
      }
    }

    @keyframes rotateReverse {
      to {
        transform:
          translate(-50%,-50%)
          rotate(-360deg);
      }
    }

    .brand-core {
      position: absolute;

      top: 50%;
      left: 50%;

      width: 190px;
      height: 190px;

      transform:
        translate(-50%,-50%);

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      border:
        1px solid
        rgba(103,232,249,.25);

      border-radius: 50%;

      background:
        radial-gradient(
          circle at 30% 20%,
          rgba(34,211,238,.15),
          transparent 40%
        ),
        radial-gradient(
          circle at 75% 80%,
          rgba(99,102,241,.15),
          transparent 45%
        ),
        rgba(8,17,31,.94);

      box-shadow:
        0 25px 65px
        rgba(2,8,23,.2),
        0 0 45px
        rgba(34,211,238,.1);

      animation:
        coreFloat 5s ease-in-out infinite;
    }

    html:not(.dark-mode) .brand-core {
      background:
        radial-gradient(
          circle at 30% 20%,
          rgba(6,182,212,.09),
          transparent 40%
        ),
        #fff;

      box-shadow:
        0 25px 60px
        rgba(15,23,42,.1);
    }

    @keyframes coreFloat {
      50% {
        transform:
          translate(-50%,-55%);
      }
    }

    .brand-symbol {
      width: 67px;
      height: 67px;

      animation:
        symbol 4s ease-in-out infinite;
    }

    @keyframes symbol {
      50% {
        transform:
          translateY(-4px)
          scale(1.03);
      }
    }

    .brand-symbol svg {
      width: 100%;
      height: 100%;

      filter:
        drop-shadow(
          0 0 15px
          rgba(34,211,238,.25)
        );
    }

    .brand-name {
      margin-top: 5px;

      font-size: 25px;
      font-weight: 900;

      letter-spacing: -1px;

      background:
        linear-gradient(
          90deg,
          #67e8f9,
          #38bdf8,
          #818cf8
        );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }

    .brand-subtitle {
      margin-top: 5px;

      color:
        rgba(186,230,253,.55);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 6px;

      letter-spacing: 1.7px;
    }

    html:not(.dark-mode) .brand-subtitle {
      color:
        rgba(15,23,42,.42);
    }

    .floating-badge {
      position: absolute;

      display: flex;
      align-items: center;
      gap: 7px;

      padding:
        8px 11px;

      border:
        1px solid var(--border);

      border-radius: 11px;

      background:
        var(--surface);

      color: var(--text);

      box-shadow:
        var(--shadow);

      backdrop-filter:
        blur(12px);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 8px;
      font-weight: 700;
    }

    .floating-badge i {
      color: var(--primary);
    }

    .badge-one {
      top: 58px;
      right: 5px;

      animation:
        badgeFloat 5s ease-in-out infinite;
    }

    .badge-two {
      bottom: 62px;
      left: 0;

      animation:
        badgeFloat 6s ease-in-out infinite reverse;
    }

    @keyframes badgeFloat {
      50% {
        transform:
          translateY(-7px);
      }
    }

    .node {
      position: absolute;

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          #67e8f9,
          #6366f1
        );

      box-shadow:
        0 0 15px
        rgba(34,211,238,.7);

      animation:
        nodePulse 2.8s ease-in-out infinite;
    }

    .node-a {
      top: 66px;
      left: 98px;
    }

    .node-b {
      top: 155px;
      right: 25px;

      animation-delay: -.7s;
    }

    .node-c {
      bottom: 80px;
      right: 105px;

      animation-delay: -1.4s;
    }

    .node-d {
      bottom: 145px;
      left: 40px;

      animation-delay: -2s;
    }

    @keyframes nodePulse {
      50% {
        transform: scale(1.4);
        opacity: .55;
      }
    }

    /* =====================================================
       TICKER
    ===================================================== */

    .ticker {
      overflow: hidden;

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);

      background:
        rgba(255,255,255,.28);
    }

    html.dark-mode .ticker {
      background:
        rgba(7,17,31,.35);
    }

    .ticker-track {
      width: max-content;

      display: flex;
      align-items: center;

      gap: 28px;

      padding: 13px 0;

      animation:
        ticker 36s linear infinite;
    }

    .ticker-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      white-space: nowrap;

      color: var(--soft);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 9px;
      font-weight: 700;
    }

    .ticker-item i {
      color: var(--primary);
      font-size: 11px;
    }

    .ticker-dot {
      width: 3px;
      height: 3px;

      border-radius: 50%;

      background: var(--primary);

      opacity: .5;
    }

    @keyframes ticker {
      to {
        transform:
          translateX(-50%);
      }
    }

    /* =====================================================
       GENERAL
    ===================================================== */

    .section {
      padding:
        70px 0;
    }

    .section-head {
      max-width: 680px;

      margin:
        0 auto
        38px;

      text-align: center;
    }

    .section-kicker {
      display: inline-flex;

      padding:
        5px 9px;

      border-radius: 999px;

      background:
        rgba(6,182,212,.07);

      color: var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 8px;
      font-weight: 800;

      letter-spacing: 1px;
    }

    .section-head h2 {
      margin:
        12px 0
        8px;

      font-size:
        clamp(26px,3.4vw,39px);

      line-height: 1.3;

      font-weight: 900;
    }

    .section-head p {
      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.9;
    }

    /* =====================================================
       STATS
    ===================================================== */

    .stats {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 10px;
    }

    .stat {
      min-height: 110px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);

      text-align: center;
    }

    .stat-number {
      font-size: 29px;
      font-weight: 900;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--violet)
        );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }

    .stat-label {
      margin-top: 2px;

      color: var(--muted);

      font-size: 9px;
      font-weight: 700;
    }

    /* =====================================================
       TOOL FINDER
    ===================================================== */

    .finder {
      padding: 17px;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-xl);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);
    }

    .search-box {
      position: relative;
    }

    .search-box i {
      position: absolute;

      top: 50%;
      right: 17px;

      transform:
        translateY(-50%);

      color: var(--soft);
    }

    .search-box input {
      width: 100%;
      height: 50px;

      padding:
        0 45px
        0 15px;

      border:
        1px solid var(--border);

      border-radius: 12px;

      outline: 0;

      background:
        var(--surface-solid);

      color: var(--text);

      font-size: 11px;
    }

    .search-box input:focus {
      border-color:
        rgba(6,182,212,.4);

      box-shadow:
        0 0 0 4px
        rgba(6,182,212,.06);
    }

    .search-results {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 8px;

      margin-top: 11px;
    }

    .search-result {
      display: flex;
      align-items: center;

      gap: 9px;

      min-height: 58px;

      padding: 8px;

      border:
        1px solid var(--border);

      border-radius: 11px;

      background:
        rgba(255,255,255,.35);

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    html.dark-mode .search-result {
      background:
        rgba(15,23,42,.35);
    }

    .search-result:hover {
      transform:
        translateY(-2px);

      border-color:
        rgba(6,182,212,.25);
    }

    .search-icon {
      width: 33px;
      height: 33px;

      flex: 0 0 33px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      background:
        linear-gradient(
          135deg,
          rgba(6,182,212,.1),
          rgba(99,102,241,.1)
        );

      color: var(--primary);

      font-size: 12px;
    }

    .search-result strong {
      display: block;

      overflow: hidden;

      font-size: 9px;

      white-space: nowrap;

      text-overflow: ellipsis;
    }

    .search-result small {
      display: block;

      margin-top: 2px;

      color: var(--soft);

      font-size: 7px;
    }

    .no-results {
      display: none;

      padding: 18px;

      color: var(--muted);

      text-align: center;

      font-size: 10px;
    }

    /* =====================================================
       TOOLS
    ===================================================== */

    .tools-grid {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 14px;
    }

    .tool-card {
      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);

      transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
    }

    .tool-card:hover {
      transform:
        translateY(-5px);

      border-color:
        rgba(6,182,212,.25);

      box-shadow:
        0 22px 55px
        rgba(15,23,42,.1);
    }

    .tool-image {
      position: relative;

      height: 145px;

      overflow: hidden;

      background:
        #07111f;
    }

    .tool-image img {
      width: 100%;
      height: 100%;

      display: block;

      object-fit: cover;

      opacity: .67;

      transition:
        transform .5s ease,
        opacity .3s ease;
    }

    .tool-card:hover .tool-image img {
      transform: scale(1.06);
      opacity: .78;
    }

    .tool-image::after {
      content: "";

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          to top,
          rgba(2,8,23,.82),
          rgba(2,8,23,.1)
        );
    }

    .tool-icon {
      position: absolute;

      z-index: 2;

      right: 14px;
      bottom: 13px;

      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border:
        1px solid
        rgba(255,255,255,.18);

      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          #0891b2,
          #6366f1
        );

      color: #fff;

      box-shadow:
        0 10px 25px
        rgba(0,0,0,.22);
    }

    .tool-body {
      padding: 15px;
    }

    .tool-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .tool-type {
      color: var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 7px;
      font-weight: 800;
    }

    .tool-status {
      color: var(--soft);

      font-size: 7px;
      font-weight: 700;
    }

    .tool-status::before {
      content: "";

      display: inline-block;

      width: 5px;
      height: 5px;

      margin-left: 4px;

      border-radius: 50%;

      background: #22c55e;
    }

    .tool-card h3 {
      margin:
        8px 0
        5px;

      font-size: 14px;
      font-weight: 800;
    }

    .tool-card p {
      margin: 0;

      color: var(--muted);

      font-size: 9px;

      line-height: 1.8;
    }

    .tool-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;

      margin-top: 10px;

      color: var(--primary);

      font-size: 8px;
      font-weight: 800;
    }

    .center {
      display: flex;
      justify-content: center;

      margin-top: 25px;
    }

    /* =====================================================
       TRACKS WITH IMAGES
    ===================================================== */

    .tracks {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 12px;
    }

    .track {
      position: relative;

      min-height: 215px;

      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background: #07111f;

      box-shadow:
        var(--shadow);

      transition:
        transform .25s ease;
    }

    .track:hover {
      transform:
        translateY(-5px);
    }

    .track img {
      position: absolute;
      inset: 0;

      width: 100%;
      height: 100%;

      object-fit: cover;

      opacity: .55;

      transition:
        transform .5s ease;
    }

    .track:hover img {
      transform: scale(1.06);
    }

    .track::after {
      content: "";

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          to top,
          rgba(2,8,23,.96),
          rgba(2,8,23,.22)
        );
    }

    .track-content {
      position: relative;
      z-index: 2;

      height: 100%;

      min-height: 215px;

      padding: 18px;

      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .track-icon {
      position: absolute;

      top: 17px;
      right: 17px;

      width: 39px;
      height: 39px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      background:
        rgba(255,255,255,.1);

      border:
        1px solid
        rgba(255,255,255,.13);

      color: #67e8f9;
    }

    .track-tag {
      color: #67e8f9;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 7px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .track h3 {
      margin:
        6px 0
        5px;

      color: #fff;

      font-size: 15px;
    }

    .track p {
      margin: 0;

      color:
        rgba(226,232,240,.7);

      font-size: 9px;

      line-height: 1.8;
    }

    /* =====================================================
       CODE EDITOR LINK
    ===================================================== */

    .editor-card {
      position: relative;

      overflow: hidden;

      min-height: 310px;

      display: grid;

      grid-template-columns:
        .9fr
        1.1fr;

      align-items: center;

      border:
        1px solid
        rgba(34,211,238,.15);

      border-radius:
        25px;

      background:
        radial-gradient(
          circle at 85% 20%,
          rgba(6,182,212,.16),
          transparent 30%
        ),
        radial-gradient(
          circle at 10% 90%,
          rgba(99,102,241,.14),
          transparent 32%
        ),
        #07111f;

      box-shadow:
        0 25px 70px
        rgba(2,8,23,.16);
    }

    .editor-info {
      position: relative;
      z-index: 2;

      padding: 35px;
    }

    .editor-label {
      display: inline-flex;

      color: #67e8f9;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 8px;
      font-weight: 800;

      letter-spacing: 1px;
    }

    .editor-info h2 {
      margin:
        12px 0
        10px;

      color: #fff;

      font-size:
        clamp(25px,3vw,38px);

      font-weight: 900;
    }

    .editor-info p {
      max-width: 480px;

      margin: 0;

      color: #91a2b8;

      font-size: 11px;

      line-height: 2;
    }

    .editor-button {
      margin-top: 21px;
    }

    .editor-window {
      position: relative;

      width: 90%;
      min-height: 220px;

      margin-inline: auto;

      border:
        1px solid
        rgba(148,163,184,.15);

      border-radius: 15px;

      background:
        rgba(15,23,42,.75);

      box-shadow:
        0 20px 45px
        rgba(0,0,0,.2);

      transform:
        perspective(900px)
        rotateY(-5deg);
    }

    .window-header {
      height: 37px;

      display: flex;
      align-items: center;

      gap: 5px;

      padding-inline: 12px;

      border-bottom:
        1px solid
        rgba(148,163,184,.1);
    }

    .window-header span {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #475569;
    }

    .window-title {
      margin-right: auto;

      color: #64748b;

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 7px;
    }

    .code-lines {
      padding: 22px;

      display: grid;
      gap: 10px;
    }

    .code-line {
      height: 7px;

      border-radius: 99px;

      background:
        rgba(103,232,249,.28);
    }

    .code-line:nth-child(2) {
      width: 78%;
      background:
        rgba(129,140,248,.3);
    }

    .code-line:nth-child(3) {
      width: 61%;
    }

    .code-line:nth-child(4) {
      width: 86%;
      background:
        rgba(56,189,248,.18);
    }

    .code-line:nth-child(5) {
      width: 43%;
      background:
        rgba(129,140,248,.3);
    }

    .code-line:nth-child(6) {
      width: 69%;
    }

    /* =====================================================
       LAB
    ===================================================== */

    .lab-grid {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 12px;
    }

    .lab {
      padding: 21px;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    .lab:hover {
      transform:
        translateY(-4px);

      border-color:
        rgba(6,182,212,.25);
    }

    .lab-icon {
      width: 43px;
      height: 43px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          rgba(6,182,212,.1),
          rgba(99,102,241,.11)
        );

      color: var(--primary);
    }

    .lab-tag {
      display: block;

      margin-top: 17px;

      color: var(--primary);

      font-family:
        "JetBrains Mono",
        monospace;

      font-size: 7px;
      font-weight: 800;
    }

    .lab h3 {
      margin:
        6px 0
        5px;

      font-size: 15px;
    }

    .lab p {
      margin: 0;

      color: var(--muted);

      font-size: 9px;

      line-height: 1.9;
    }

    .lab-link {
      display: inline-flex;
      gap: 5px;

      margin-top: 12px;

      color: var(--primary);

      font-size: 8px;
      font-weight: 800;
    }

    /* =====================================================
       MISSIONS
    ===================================================== */

    .missions {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 10px;
    }

    .mission {
      padding: 18px;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);

      transition:
        transform .2s ease;
    }

    .mission:hover {
      transform:
        translateY(-4px);
    }

    .mission-icon {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      background:
        rgba(6,182,212,.08);

      color: var(--primary);
    }

    .mission h3 {
      margin:
        12px 0
        5px;

      font-size: 13px;
    }

    .mission p {
      margin: 0;

      color: var(--muted);

      font-size: 8px;

      line-height: 1.8;
    }

    /* =====================================================
       WHY
    ===================================================== */

    .why-grid {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 11px;
    }

    .why {
      padding: 20px;

      border:
        1px solid var(--border);

      border-radius:
        var(--r-lg);

      background:
        var(--surface);

      box-shadow:
        var(--shadow);
    }

    .why i {
      color: var(--primary);

      font-size: 17px;
    }

    .why h3 {
      margin:
        11px 0
        5px;

      font-size: 13px;
    }

    .why p {
      margin: 0;

      color: var(--muted);

      font-size: 9px;

      line-height: 1.9;
    }

    /* =====================================================
       FAQ
    ===================================================== */

    .faq {
      max-width: 800px;

      margin-inline: auto;

      display: grid;
      gap: 8px;
    }

    .faq-item {
      overflow: hidden;

      border:
        1px solid var(--border);

      border-radius: 13px;

      background:
        var(--surface);
    }

    .faq-button {
      width: 100%;

      min-height: 57px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding:
        0 16px;

      border: 0;

      background: transparent;

      color: var(--text);

      text-align: right;

      font-size: 10px;
      font-weight: 800;
    }

    .faq-button i {
      color: var(--primary);

      transition:
        transform .2s ease;
    }

    .faq-item.open
      .faq-button i {
      transform:
        rotate(180deg);
    }

    .faq-answer {
      display: grid;

      grid-template-rows:
        0fr;

      transition:
        grid-template-rows .25s ease;
    }

    .faq-inner {
      overflow: hidden;

      padding:
        0 16px;

      color: var(--muted);

      font-size: 9px;

      line-height: 1.9;
    }

    .faq-item.open
      .faq-answer {
      grid-template-rows:
        1fr;
    }

    .faq-item.open
      .faq-inner {
      padding-bottom: 16px;
    }

    /* =====================================================
       CTA
    ===================================================== */

    .cta {
      position: relative;

      overflow: hidden;

      padding:
        52px 25px;

      border:
        1px solid
        rgba(34,211,238,.17);

      border-radius:
        26px;

      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(34,211,238,.15),
          transparent 30%
        ),
        radial-gradient(
          circle at 85% 80%,
          rgba(99,102,241,.16),
          transparent 32%
        ),
        #091525;

      text-align: center;
    }

    .cta h2 {
      margin:
        0 0
        9px;

      color: #fff;

      font-size:
        clamp(25px,3.5vw,38px);

      font-weight: 900;
    }

    .cta p {
      max-width: 570px;

      margin:
        0 auto
        20px;

      color: #91a2b8;

      font-size: 10px;

      line-height: 1.9;
    }

    /* =====================================================
       REVEAL
    ===================================================== */

    .reveal {
      opacity: 0;

      transform:
        translateY(15px);

      transition:
        opacity .55s ease,
        transform .55s ease;
    }

    .reveal.visible {
      opacity: 1;

      transform:
        translateY(0);
    }

    /* =====================================================
       TOP
    ===================================================== */

    .top-button {
      position: fixed;

      left: 17px;
      bottom: 17px;

      z-index: 100;

      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      border:
        1px solid var(--border);

      border-radius: 11px;

      background:
        var(--surface);

      color: var(--primary);

      box-shadow:
        var(--shadow);

      backdrop-filter:
        blur(10px);

      opacity: 0;
      visibility: hidden;

      transform:
        translateY(8px);

      transition:
        opacity .2s ease,
        visibility .2s ease,
        transform .2s ease;
    }

    .top-button.show {
      opacity: 1;
      visibility: visible;

      transform:
        translateY(0);
    }

    /* =====================================================
       TABLET
    ===================================================== */

    @media (max-width: 1050px) {
      .hero-grid {
        grid-template-columns: 1fr;

        gap: 35px;

        text-align: center;
      }

      .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .hero-visual {
        min-height: 390px;
      }

      .search-results {
        grid-template-columns:
          repeat(3,1fr);
      }

      .tracks {
        grid-template-columns:
          repeat(2,1fr);
      }

      .stats {
        grid-template-columns:
          repeat(2,1fr);
      }

      .editor-card {
        grid-template-columns: 1fr;
      }

      .editor-window {
        width: 80%;

        margin:
          0 auto
          35px;

        transform: none;
      }

      .missions {
        grid-template-columns:
          repeat(2,1fr);
      }
    }

    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 760px) {
      .container {
        width:
          calc(100% - 28px);
      }

      .hero {
        padding:
          48px 0
          35px;
      }

      .hero-grid {
        gap: 5px;
      }

      .hero h1 {
        font-size:
          clamp(31px,8.8vw,39px);

        letter-spacing:
          -1px;
      }

      .hero-description {
        max-width: 560px;

        font-size: 11px;

        line-height: 1.9;
      }

      .hero-actions {
        justify-content: center;
      }

      .btn {
        min-height: 42px;

        padding-inline: 13px;

        font-size: 9px;
      }

      .hero-note {
        justify-content: center;

        gap: 9px;

        font-size: 7px;
      }

      .hero-visual {
        min-height: 320px;

        margin-top: 4px;
      }

      .visual {
        width: 320px;
        height: 320px;
      }

      .ring-one {
        width: 210px;
        height: 210px;
      }

      .ring-two {
        width: 270px;
        height: 270px;
      }

      .ring-three {
        width: 310px;
        height: 310px;
      }

      .brand-core {
        width: 160px;
        height: 160px;
      }

      .brand-symbol {
        width: 58px;
        height: 58px;
      }

      .brand-name {
        font-size: 21px;
      }

      .brand-subtitle {
        font-size: 5px;
      }

      .badge-one {
        top: 45px;
        right: -2px;
      }

      .badge-two {
        bottom: 45px;
        left: -2px;
      }

      .floating-badge {
        padding:
          7px 9px;

        font-size: 7px;
      }

      .section {
        padding:
          55px 0;
      }

      .section-head {
        margin-bottom:
          28px;
      }

      .section-head h2 {
        font-size:
          clamp(23px,6.8vw,30px);
      }

      .section-head p {
        font-size: 10px;
      }

      .stats {
        grid-template-columns:
          repeat(2,1fr);

        gap: 8px;
      }

      .stat {
        min-height: 95px;
      }

      .stat-number {
        font-size: 25px;
      }

      .stat-label {
        font-size: 7px;
      }

      .finder {
        padding: 12px;

        border-radius: 18px;
      }

      .search-results {
        grid-template-columns:
          repeat(2,1fr);

        gap: 6px;
      }

      .search-result {
        min-height: 55px;

        padding: 7px;

        gap: 6px;
      }

      .search-icon {
        width: 29px;
        height: 29px;

        flex-basis: 29px;

        font-size: 10px;
      }

      .search-result strong {
        font-size: 7px;
      }

      .search-result small {
        font-size: 6px;
      }

      /*
       * الأدوات الرئيسية على الهاتف عمودان
       */
      .tools-grid {
        grid-template-columns:
          repeat(2,minmax(0,1fr));

        gap: 8px;
      }

      .tool-image {
        height: 95px;
      }

      .tool-icon {
        width: 33px;
        height: 33px;

        right: 9px;
        bottom: 9px;

        border-radius: 9px;

        font-size: 11px;
      }

      .tool-body {
        padding: 10px;
      }

      .tool-type,
      .tool-status {
        font-size: 6px;
      }

      .tool-card h3 {
        margin:
          6px 0
          4px;

        font-size: 9px;
      }

      .tool-card p {
        font-size: 7px;

        line-height: 1.65;
      }

      .tool-link {
        margin-top: 7px;

        font-size: 6px;
      }

      .tracks {
        grid-template-columns:
          repeat(2,1fr);

        gap: 8px;
      }

      .track {
        min-height: 170px;
      }

      .track-content {
        min-height: 170px;

        padding: 13px;
      }

      .track-icon {
        width: 33px;
        height: 33px;

        top: 12px;
        right: 12px;

        font-size: 12px;
      }

      .track-tag {
        font-size: 6px;
      }

      .track h3 {
        font-size: 11px;
      }

      .track p {
        font-size: 7px;
      }

      .editor-card {
        min-height: 0;

        border-radius:
          19px;
      }

      .editor-info {
        padding: 24px 18px;
      }

      .editor-info h2 {
        font-size: 25px;
      }

      .editor-info p {
        font-size: 9px;
      }

      .editor-window {
        width: calc(100% - 26px);

        min-height: 175px;

        margin:
          0 auto
          24px;
      }

      .code-lines {
        padding: 16px;
      }

      .lab-grid {
        grid-template-columns:
          1fr;

        gap: 8px;
      }

      .lab {
        padding: 16px;
      }

      .missions {
        grid-template-columns:
          repeat(2,1fr);

        gap: 8px;
      }

      .mission {
        padding: 14px;
      }

      .mission h3 {
        font-size: 10px;
      }

      .mission p {
        font-size: 7px;
      }

      .why-grid {
        grid-template-columns:
          repeat(2,1fr);

        gap: 8px;
      }

      .why {
        padding: 14px;
      }

      .why i {
        font-size: 14px;
      }

      .why h3 {
        font-size: 10px;
      }

      .why p {
        font-size: 7px;
      }

      .faq-button {
        min-height: 52px;

        padding-inline: 13px;

        font-size: 8px;
      }

      .faq-inner {
        padding-inline: 13px;

        font-size: 8px;
      }

      .cta {
        padding:
          39px 16px;

        border-radius: 20px;
      }

      .cta h2 {
        font-size:
          clamp(23px,7vw,29px);
      }

      .cta p {
        font-size: 8px;
      }
    }

    @media (max-width: 390px) {
      .container {
        width:
          calc(100% - 22px);
      }

      .hero {
        padding-top: 40px;
      }

      .hero h1 {
        font-size: 30px;
      }

      .hero-description {
        font-size: 10px;
      }

      .hero-note {
        font-size: 6px;
      }

      .visual {
        width: 280px;
        height: 280px;
      }

      .ring-one {
        width: 185px;
        height: 185px;
      }

      .ring-two {
        width: 230px;
        height: 230px;
      }

      .ring-three {
        width: 270px;
        height: 270px;
      }

      .brand-core {
        width: 145px;
        height: 145px;
      }

      .brand-symbol {
        width: 52px;
        height: 52px;
      }

      .brand-name {
        font-size: 19px;
      }

      .floating-badge {
        display: none;
      }

      .tool-card h3 {
        font-size: 8px;
      }

      .tool-card p {
        font-size: 6.5px;
      }

      .track {
        min-height: 160px;
      }

      .track-content {
        min-height: 160px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration:
          .01ms !important;

        animation-iteration-count:
          1 !important;

        transition-duration:
          .01ms !important;
      }
    }
  </style>
</head>

<body>

  <div class="background" aria-hidden="true">
    <div class="grid-bg"></div>
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
  </div>

  <Header />

  <main>

    <!-- =================================================
         HERO
    ================================================== -->

    <section class="hero">

      <div class="container hero-grid">

        <div class="hero-content">

          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            منصة تقنية عربية تتطور باستمرار
          </div>

          <h1>
            أدوات تقنية
            <br />
            <span class="gradient">
              أبسط. أسرع. أذكى.
            </span>
          </h1>

          <p class="hero-description">
            Th.Tech تجمع أدوات عملية للبرمجة والويب والبيانات
            والذكاء الاصطناعي والأمن في تجربة واحدة بسيطة
            تعمل مباشرة من المتصفح.
          </p>

          <div class="hero-actions">

            <a
              href="#tools"
              class="btn btn-primary"
            >
              <i class="fa-solid fa-compass"></i>
              استكشف الأدوات
            </a>

            <a
              href={codeEditorHref}
              class="btn btn-secondary"
            >
              <i class="fa-solid fa-code"></i>
              محرر الأكواد
            </a>

          </div>

          <div class="hero-note">

            <span>
              <i class="fa-solid fa-bolt"></i>
              سريع
            </span>

            <span>
              <i class="fa-solid fa-browser"></i>
              من المتصفح
            </span>

            <span>
              <i class="fa-solid fa-mobile-screen"></i>
              متجاوب
            </span>

            <span>
              <i class="fa-solid fa-circle-check"></i>
              مجاني
            </span>

          </div>

        </div>

        <!-- BRAND VISUAL -->

        <div class="hero-visual">

          <div class="visual">

            <div class="ring ring-one"></div>
            <div class="ring ring-two"></div>
            <div class="ring ring-three"></div>

            <span class="node node-a"></span>
            <span class="node node-b"></span>
            <span class="node node-c"></span>
            <span class="node node-d"></span>

            <div class="floating-badge badge-one">
              <i class="fa-solid fa-microchip"></i>
              AI TOOLS
            </div>

            <div class="floating-badge badge-two">
              <i class="fa-solid fa-terminal"></i>
              DEV TOOLS
            </div>

            <div class="brand-core">

              <div class="brand-symbol">

                <svg
                  viewBox="0 0 160 160"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >

                  <defs>

                    <linearGradient
                      id="brandGradient"
                      x1="20"
                      y1="20"
                      x2="140"
                      y2="140"
                    >
                      <stop
                        offset="0%"
                        stop-color="#22d3ee"
                      />

                      <stop
                        offset="50%"
                        stop-color="#38bdf8"
                      />

                      <stop
                        offset="100%"
                        stop-color="#6366f1"
                      />
                    </linearGradient>

                  </defs>

                  <circle
                    cx="80"
                    cy="80"
                    r="64"
                    fill="url(#brandGradient)"
                    opacity=".1"
                  />

                  <circle
                    cx="80"
                    cy="80"
                    r="59"
                    fill="none"
                    stroke="url(#brandGradient)"
                    stroke-width="2"
                    opacity=".65"
                  />

                  <g
                    fill="none"
                    stroke="url(#brandGradient)"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >

                    <path d="M38 48H87" />
                    <path d="M62.5 48V112" />
                    <path d="M93 48V112" />
                    <path d="M122 48V112" />
                    <path d="M93 80H122" />

                  </g>

                  <circle
                    cx="122"
                    cy="48"
                    r="5"
                    fill="#67e8f9"
                  />

                </svg>

              </div>

              <div class="brand-name">
                Th<strong>.Tech</strong>
              </div>

              <div class="brand-subtitle">
                TECH • AI • TOOLS
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- =================================================
         TECH TICKER
    ================================================== -->

    <div class="ticker">

      <div class="ticker-track">

        {
          [...tickerItems, ...tickerItems].map(
            ([icon, label], index) => (
              <span
                class="ticker-item"
                aria-hidden={
                  index >= tickerItems.length
                    ? 'true'
                    : undefined
                }
              >

                <i class={icon}></i>

                {label}

                <span class="ticker-dot"></span>

              </span>
            )
          )
        }

      </div>

    </div>

    <!-- =================================================
         STATS
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="stats">

          <div class="stat reveal">

            <strong
              class="stat-number"
              data-counter={toolsCount}
            >
              0
            </strong>

            <span class="stat-label">
              أداة تقنية
            </span>

          </div>

          <div class="stat reveal">

            <strong class="stat-number">
              100%
            </strong>

            <span class="stat-label">
              تجربة مباشرة
            </span>

          </div>

          <div class="stat reveal">

            <strong class="stat-number">
              24/7
            </strong>

            <span class="stat-label">
              متاحة دائماً
            </span>

          </div>

          <div class="stat reveal">

            <strong class="stat-number">
              0
            </strong>

            <span class="stat-label">
              تثبيت مطلوب
            </span>

          </div>

        </div>

      </div>

    </section>

    <!-- =================================================
         FINDER
    ================================================== -->

    <section
      id="tools"
      class="section"
    >

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            TOOL FINDER
          </span>

          <h2>
            ابحث عن أداتك بسرعة
          </h2>

          <p>
            اكتب اسم الأداة أو التقنية للوصول إليها مباشرة.
          </p>

        </div>

        <div class="finder reveal">

          <div class="search-box">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input
              id="tool-search"
              type="search"
              placeholder="مثال: JSON أو QR أو API..."
              autocomplete="off"
              aria-label="البحث عن أداة"
            />

          </div>

          <div
            class="search-results"
            id="search-results"
          >

            {
              quickTools.map((tool) => (
                <a
                  class="search-result"
                  href={tool.href}
                  data-tool-name={tool.name.toLowerCase()}
                >

                  <span class="search-icon">

                    <i class={tool.icon}></i>

                  </span>

                  <span>

                    <strong>
                      {tool.name}
                    </strong>

                    <small>
                      {tool.type}
                    </small>

                  </span>

                </a>
              ))
            }

          </div>

          <div
            class="no-results"
            id="no-results"
          >
            لم يتم العثور على أداة مطابقة.
          </div>

        </div>

      </div>

    </section>

    <!-- =================================================
         FEATURED TOOLS
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            FEATURED
          </span>

          <h2>
            أدوات تستحق التجربة
          </h2>

          <p>
            اخترنا لك مجموعة صغيرة من الأدوات المفيدة للاستخدام اليومي.
          </p>

        </div>

        <div class="tools-grid">

          {
            featuredTools.map((tool, index) => (
              <a
                class="tool-card reveal"
                href={tool.href}
                style={`transition-delay:${index * 45}ms`}
              >

                <div class="tool-image">

                  <img
                    src={tool.image}
                    alt={tool.name}
                    loading={index > 1 ? 'lazy' : 'eager'}
                    width="900"
                    height="500"
                  />

                  <span class="tool-icon">
                    <i class={tool.icon}></i>
                  </span>

                </div>

                <div class="tool-body">

                  <div class="tool-meta">

                    <span class="tool-type">
                      {tool.type}
                    </span>

                    <span class="tool-status">
                      متاح
                    </span>

                  </div>

                  <h3>
                    {tool.name}
                  </h3>

                  <p>
                    أداة مجانية وسريعة للاستخدام
                    مباشرة من المتصفح.
                  </p>

                  <span class="tool-link">
                    فتح الأداة
                    <span>←</span>
                  </span>

                </div>

              </a>
            ))
          }

        </div>

        <div class="center">

          <a
            href={`${base}/tools/`}
            class="btn btn-secondary"
          >
            <i class="fa-solid fa-grid-2"></i>
            استكشف جميع الأدوات
          </a>

        </div>

      </div>

    </section>

    <!-- =================================================
         TRACKS
    ================================================== -->

    <section
      id="tracks"
      class="section"
    >

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            EXPLORE
          </span>

          <h2>
            اكتشف عالم Th.Tech
          </h2>

          <p>
            مجالات تقنية مختلفة، وأدوات مصممة لتخدم كل مهمة.
          </p>

        </div>

        <div class="tracks">

          {
            tracks.map((track) => (
              <a
                href="#tools"
                class="track reveal"
              >

                <img
                  src={track.image}
                  alt={track.title}
                  loading="lazy"
                  width="1100"
                  height="700"
                />

                <div class="track-content">

                  <span class="track-icon">
                    <i class={track.icon}></i>
                  </span>

                  <span class="track-tag">
                    {track.tag}
                  </span>

                  <h3>
                    {track.title}
                  </h3>

                  <p>
                    {track.description}
                  </p>

                </div>

              </a>
            ))
          }

        </div>

      </div>

    </section>

    <!-- =================================================
         CODE EDITOR LINK
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="editor-card reveal">

          <div class="editor-info">

            <span class="editor-label">
              CODE PLAYGROUND
            </span>

            <h2>
              محرر الأكواد
            </h2>

            <p>
              مساحة مخصصة لكتابة وتجربة HTML وCSS وJavaScript
              بطريقة مباشرة ومنظمة.
            </p>

            <a
              href={codeEditorHref}
              class="btn btn-primary editor-button"
            >
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
              فتح محرر الأكواد
            </a>

          </div>

          <div class="editor-window">

            <div class="window-header">

              <span></span>
              <span></span>
              <span></span>

              <span class="window-title">
                Th.Tech / code-editor
              </span>

            </div>

            <div class="code-lines">

              <div class="code-line"></div>
              <div class="code-line"></div>
              <div class="code-line"></div>
              <div class="code-line"></div>
              <div class="code-line"></div>
              <div class="code-line"></div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- =================================================
         LAB
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            TH.TECH LAB
          </span>

          <h2>
            مختبر Th.Tech
          </h2>

          <p>
            ثلاث مساحات تجمع لك الأدوات حسب طريقة استخدامك.
          </p>

        </div>

        <div class="lab-grid">

          {
            labs.map((lab) => (
              <a
                href={lab.href}
                class="lab reveal"
              >

                <div class="lab-icon">
                  <i class={lab.icon}></i>
                </div>

                <span class="lab-tag">
                  {lab.tag}
                </span>

                <h3>
                  {lab.title}
                </h3>

                <p>
                  {lab.description}
                </p>

                <span class="lab-link">
                  استكشف
                  <span>←</span>
                </span>

              </a>
            ))
          }

        </div>

      </div>

    </section>

    <!-- =================================================
         MISSIONS
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            FIND BY TASK
          </span>

          <h2>
            ماذا تريد أن تنجز؟
          </h2>

          <p>
            بدلاً من البحث عن اسم الأداة، ابدأ من المهمة التي تريد تنفيذها.
          </p>

        </div>

        <div class="missions">

          {
            missions.map((mission) => (
              <a
                href={mission.href}
                class="mission reveal"
              >

                <div class="mission-icon">
                  <i class={mission.icon}></i>
                </div>

                <h3>
                  {mission.title}
                </h3>

                <p>
                  {mission.description}
                </p>

              </a>
            ))
          }

        </div>

      </div>

    </section>

    <!-- =================================================
         WHY TH.TECH
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            WHY TH.TECH
          </span>

          <h2>
            مصمم ليكون عملياً
          </h2>

          <p>
            تجربة تقنية واضحة بدون تعقيد غير ضروري.
          </p>

        </div>

        <div class="why-grid">

          <div class="why reveal">

            <i class="fa-solid fa-bolt"></i>

            <h3>
              سريع ومباشر
            </h3>

            <p>
              افتح الأداة وأنجز مهمتك دون خطوات كثيرة.
            </p>

          </div>

          <div class="why reveal">

            <i class="fa-solid fa-mobile-screen"></i>

            <h3>
              يعمل على الهاتف
            </h3>

            <p>
              واجهة متجاوبة مع الشاشات الصغيرة والكبيرة.
            </p>

          </div>

          <div class="why reveal">

            <i class="fa-solid fa-shield-halved"></i>

            <h3>
              الخصوصية مهمة
            </h3>

            <p>
              العديد من الأدوات تعمل مباشرة داخل المتصفح.
            </p>

          </div>

          <div class="why reveal">

            <i class="fa-solid fa-language"></i>

            <h3>
              تجربة عربية
            </h3>

            <p>
              واجهة واضحة باللغة العربية مع مصطلحات تقنية مفهومة.
            </p>

          </div>

          <div class="why reveal">

            <i class="fa-solid fa-box-open"></i>

            <h3>
              بدون تثبيت
            </h3>

            <p>
              استخدم الأدوات مباشرة من المتصفح.
            </p>

          </div>

          <div class="why reveal">

            <i class="fa-solid fa-arrows-rotate"></i>

            <h3>
              تتطور باستمرار
            </h3>

            <p>
              المنصة مصممة لإضافة أدوات وتجارب جديدة باستمرار.
            </p>

          </div>

        </div>

      </div>

    </section>

    <!-- =================================================
         FAQ
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="section-head reveal">

          <span class="section-kicker">
            FAQ
          </span>

          <h2>
            الأسئلة الشائعة
          </h2>

          <p>
            معلومات مختصرة حول المنصة والأدوات.
          </p>

        </div>

        <div class="faq">

          {
            faqs.map((faq, index) => (
              <div
                class:list={[
                  'faq-item',
                  index === 0 ? 'open' : ''
                ]}
              >

                <button
                  type="button"
                  class="faq-button"
                  aria-expanded={
                    index === 0
                      ? 'true'
                      : 'false'
                  }
                >

                  <span>
                    {faq.q}
                  </span>

                  <i class="fa-solid fa-chevron-down"></i>

                </button>

                <div class="faq-answer">

                  <div class="faq-inner">
                    {faq.a}
                  </div>

                </div>

              </div>
            ))
          }

        </div>

      </div>

    </section>

    <!-- =================================================
         CTA
    ================================================== -->

    <section class="section">

      <div class="container">

        <div class="cta reveal">

          <h2>
            ابدأ مهمتك الآن
          </h2>

          <p>
            مجموعة أدوات تقنية عملية في مكان واحد،
            جاهزة للاستخدام متى احتجتها.
          </p>

          <a
            href={`${base}/tools/`}
            class="btn btn-primary"
          >
            <i class="fa-solid fa-rocket"></i>
            استكشف الأدوات
          </a>

        </div>

      </div>

    </section>

  </main>

  <Footer />

  <button
    class="top-button"
    id="top-button"
    type="button"
    aria-label="العودة إلى الأعلى"
  >
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <script>
    /* ==================================================
       SEARCH
    ================================================== */

    const searchInput =
      document.getElementById('tool-search');

    const searchResults =
      document.querySelectorAll('.search-result');

    const noResults =
      document.getElementById('no-results');

    searchInput?.addEventListener(
      'input',
      () => {
        const query =
          searchInput.value
            .trim()
            .toLowerCase();

        let visible = 0;

        searchResults.forEach((item) => {
          const name =
            item.dataset.toolName || '';

          const match =
            !query ||
            name.includes(query);

          item.style.display =
            match
              ? 'flex'
              : 'none';

          if (match) {
            visible++;
          }
        });

        if (noResults) {
          noResults.style.display =
            visible === 0
              ? 'block'
              : 'none';
        }
      }
    );

    /* ==================================================
       FAQ
    ================================================== */

    document
      .querySelectorAll('.faq-button')
      .forEach((button) => {

        button.addEventListener(
          'click',
          () => {

            const item =
              button.closest('.faq-item');

            if (!item) return;

            const wasOpen =
              item.classList.contains('open');

            document
              .querySelectorAll('.faq-item')
              .forEach((other) => {

                other.classList.remove('open');

                other
                  .querySelector('.faq-button')
                  ?.setAttribute(
                    'aria-expanded',
                    'false'
                  );

              });

            if (!wasOpen) {

              item.classList.add('open');

              button.setAttribute(
                'aria-expanded',
                'true'
              );

            }

          }
        );

      });

    /* ==================================================
       REVEAL
    ================================================== */

    const revealItems =
      document.querySelectorAll('.reveal');

    if ('IntersectionObserver' in window) {

      const observer =
        new IntersectionObserver(
          (entries, obs) => {

            entries.forEach((entry) => {

              if (
                entry.isIntersecting
              ) {

                entry.target.classList.add(
                  'visible'
                );

                obs.unobserve(
                  entry.target
                );

              }

            });

          },
          {
            threshold: .06,
            rootMargin:
              '0px 0px -25px 0px'
          }
        );

      revealItems.forEach((item) => {
        observer.observe(item);
      });

    } else {

      revealItems.forEach((item) => {
        item.classList.add('visible');
      });

    }

    /* ==================================================
       COUNTER
    ================================================== */

    const counter =
      document.querySelector(
        '[data-counter]'
      );

    let counterDone = false;

    function runCounter() {

      if (
        counterDone ||
        !counter
      ) {
        return;
      }

      counterDone = true;

      const target =
        Number(counter.dataset.counter);

      const start =
        performance.now();

      const duration = 800;

      function update(now) {

        const progress =
          Math.min(
            (now - start) /
              duration,
            1
          );

        const eased =
          1 -
          Math.pow(
            1 - progress,
            3
          );

        counter.textContent =
          Math.round(
            target * eased
          );

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    }

    if ('IntersectionObserver' in window) {

      const counterObserver =
        new IntersectionObserver(
          (entries, observer) => {

            if (
              entries.some(
                (entry) =>
                  entry.isIntersecting
              )
            ) {

              runCounter();

              observer.disconnect();

            }

          },
          {
            threshold: .35
          }
        );

      if (counter) {
        counterObserver.observe(counter);
      }

    } else {

      runCounter();

    }

    /* ==================================================
       SCROLL TOP
    ================================================== */

    const topButton =
      document.getElementById(
        'top-button'
      );

    let ticking = false;

    window.addEventListener(
      'scroll',
      () => {

        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {

          topButton?.classList.toggle(
            'show',
            window.scrollY > 500
          );

          ticking = false;

        });

      },
      {
        passive: true
      }
    );

    topButton?.addEventListener(
      'click',
      () => {

        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });

      }
    );

    /* ==================================================
       CTRL / CMD + K
    ================================================== */

    document.addEventListener(
      'keydown',
      (event) => {

        if (
          (event.ctrlKey ||
            event.metaKey) &&
          event.key.toLowerCase() === 'k'
        ) {

          event.preventDefault();

          searchInput?.focus();

          document
            .getElementById('tools')
            ?.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });

        }

      }
    );
  </script>

</body>
</html>
