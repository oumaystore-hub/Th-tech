---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((file) => file.match(/\.\/tools\/([^/]+)\/index\.astro$/)?.[1])
  .filter(Boolean);

const displayName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolsData = toolSlugs.map((slug) => ({
  slug,
  name: displayName(slug),
  href: `${base}/tools/${slug}/`
}));

const toolsCount = toolsData.length;

const featuredSlugs = [
  'json-formatter',
  'json-validator',
  'base64-encoder-decoder',
  'qr-code-generator',
  'color-picker',
  'api-request-builder'
];

const featuredMeta = {
  'json-formatter': {
    icon: 'fa-solid fa-code',
    type: 'JSON',
    visual: 'json'
  },
  'json-validator': {
    icon: 'fa-solid fa-circle-check',
    type: 'VALIDATOR',
    visual: 'check'
  },
  'base64-encoder-decoder': {
    icon: 'fa-solid fa-lock',
    type: 'BASE64',
    visual: 'base64'
  },
  'qr-code-generator': {
    icon: 'fa-solid fa-qrcode',
    type: 'QR CODE',
    visual: 'qr'
  },
  'color-picker': {
    icon: 'fa-solid fa-palette',
    type: 'COLOR',
    visual: 'color'
  },
  'api-request-builder': {
    icon: 'fa-solid fa-plug',
    type: 'API',
    visual: 'api'
  }
};

const featuredTools = featuredSlugs
  .map((slug) => {
    const tool = toolsData.find((item) => item.slug === slug);

    if (!tool) return null;

    return {
      ...tool,
      ...(featuredMeta[slug] || {
        icon: 'fa-solid fa-wand-magic-sparkles',
        type: 'TOOL',
        visual: 'default'
      })
    };
  })
  .filter(Boolean);

const remainingTools = toolsData
  .filter((tool) => !featuredSlugs.includes(tool.slug))
  .slice(0, 12);

const tracks = [
  {
    icon: 'fa-solid fa-brain',
    title: 'الذكاء الاصطناعي',
    description: 'اكتشف أدوات وتقنيات الذكاء الاصطناعي الحديثة.',
    tag: 'AI',
    href: '#tools',
    className: 'track-ai'
  },
  {
    icon: 'fa-solid fa-code',
    title: 'البرمجة',
    description: 'أدوات عملية تساعدك على كتابة وتحليل وتحسين الكود.',
    tag: 'CODE',
    href: '#tools',
    className: 'track-code'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'الأمن السيبراني',
    description: 'أدوات مفيدة للتشفير والتحقق وتحليل البيانات.',
    tag: 'SECURITY',
    href: '#tools',
    className: 'track-security'
  },
  {
    icon: 'fa-solid fa-cloud',
    title: 'الويب والسحابة',
    description: 'أدوات للمطورين وأصحاب المواقع والمشاريع الرقمية.',
    tag: 'WEB',
    href: '#tools',
    className: 'track-web'
  }
];

const tickerItems = [
  {
    icon: 'fa-solid fa-code',
    label: 'JSON'
  },
  {
    icon: 'fa-brands fa-js',
    label: 'JavaScript'
  },
  {
    icon: 'fa-brands fa-html5',
    label: 'HTML'
  },
  {
    icon: 'fa-brands fa-css3-alt',
    label: 'CSS'
  },
  {
    icon: 'fa-solid fa-plug',
    label: 'API'
  },
  {
    icon: 'fa-solid fa-qrcode',
    label: 'QR CODE'
  },
  {
    icon: 'fa-solid fa-lock',
    label: 'BASE64'
  },
  {
    icon: 'fa-solid fa-key',
    label: 'JWT'
  },
  {
    icon: 'fa-solid fa-filter',
    label: 'REGEX'
  },
  {
    icon: 'fa-solid fa-database',
    label: 'SQL'
  },
  {
    icon: 'fa-solid fa-fingerprint',
    label: 'UUID'
  },
  {
    icon: 'fa-solid fa-hashtag',
    label: 'HASH'
  },
  {
    icon: 'fa-brands fa-markdown',
    label: 'MARKDOWN'
  },
  {
    icon: 'fa-solid fa-palette',
    label: 'COLOR'
  },
  {
    icon: 'fa-solid fa-clock',
    label: 'TIMESTAMP'
  },
  {
    icon: 'fa-solid fa-file-code',
    label: 'YAML'
  }
];

const faqs = [
  {
    q: 'ما هي منصة Th.Tech؟',
    a: 'Th.Tech هي منصة تقنية عربية تجمع أدوات ويب مجانية ومحتوى تقني يساعد المطورين والطلاب وصناع المحتوى والمستخدمين على إنجاز مهامهم بسرعة.'
  },
  {
    q: 'هل الأدوات مجانية؟',
    a: 'نعم، الأدوات الموجودة في المنصة مصممة للاستخدام المجاني مباشرة من المتصفح.'
  },
  {
    q: 'هل يتم إرسال بياناتي إلى خادم خارجي؟',
    a: 'معظم الأدوات تعمل مباشرة داخل المتصفح. تختلف آلية المعالجة حسب الأداة، لذلك يفضل دائماً مراجعة وصف الأداة قبل التعامل مع بيانات حساسة.'
  },
  {
    q: 'هل يمكنني استخدام الأدوات من الهاتف؟',
    a: 'نعم. تم تصميم واجهة المنصة والأدوات لتعمل على الهواتف والأجهزة اللوحية وأجهزة الكمبيوتر.'
  },
  {
    q: 'هل تحتاج الأدوات إلى تثبيت برامج؟',
    a: 'لا. الهدف من المنصة هو توفير أدوات عملية يمكن استخدامها مباشرة من المتصفح دون الحاجة إلى تثبيت برامج إضافية.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description: 'منصة تقنية عربية للأدوات والبرمجة والذكاء الاصطناعي',
  inLanguage: 'ar',
  publisher: {
    '@type': 'Organization',
    name: 'Th.Tech',
    url: `${siteUrl}${base}/`,
    sameAs: [
      'https://www.facebook.com/share/1PzewvX774/',
      'https://www.instagram.com/thtech.ma',
      'https://x.com/thtechma',
      'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438',
      'https://www.youtube.com/@thtechma'
    ]
  }
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      Th.Tech | منصة تقنية عربية للأدوات والبرمجة والذكاء الاصطناعي
    </title>

    <meta
      name="description"
      content="Th.Tech منصة تقنية عربية تضم أدوات مجانية للبرمجة والذكاء الاصطناعي والأمن السيبراني والويب، مع تجربة سريعة ومباشرة من المتصفح."
    />

    <meta
      name="keywords"
      content="أدوات تقنية, أدوات برمجة, ذكاء اصطناعي, أدوات ويب, JSON, API, QR, Base64, مطورين, Th.Tech"
    />

    <meta name="theme-color" content="#07111f" />

    <link rel="canonical" href={`${siteUrl}${base}/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <style>
      :root {
        --bg: #f7fafc;
        --bg-2: #eef6fb;
        --surface: rgba(255, 255, 255, 0.86);
        --surface-solid: #ffffff;
        --surface-soft: #f1f7fb;

        --text: #0f172a;
        --text-soft: #5b6b7d;
        --text-muted: #8290a0;

        --border: rgba(15, 23, 42, 0.085);
        --border-strong: rgba(14, 165, 233, 0.2);

        --primary: #0891b2;
        --primary-2: #2563eb;
        --accent: #6366f1;
        --cyan: #06b6d4;

        --container: 1180px;

        --radius-xl: 28px;
        --radius-lg: 20px;
        --radius-md: 15px;
        --radius-sm: 11px;

        --shadow-sm:
          0 8px 30px rgba(15, 23, 42, 0.045);

        --shadow-md:
          0 18px 50px rgba(15, 23, 42, 0.075);

        --shadow-lg:
          0 28px 80px rgba(15, 23, 42, 0.11);
      }

      html.dark-mode {
        --bg: #050a12;
        --bg-2: #08111d;

        --surface: rgba(13, 23, 39, 0.82);
        --surface-solid: #0d1727;
        --surface-soft: #101d30;

        --text: #f8fafc;
        --text-soft: #9aaabd;
        --text-muted: #718198;

        --border: rgba(148, 163, 184, 0.11);
        --border-strong: rgba(34, 211, 238, 0.2);

        --primary: #22d3ee;
        --primary-2: #60a5fa;
        --accent: #818cf8;
        --cyan: #67e8f9;

        --shadow-sm:
          0 8px 30px rgba(0, 0, 0, 0.18);

        --shadow-md:
          0 18px 55px rgba(0, 0, 0, 0.25);

        --shadow-lg:
          0 30px 80px rgba(0, 0, 0, 0.32);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        overflow-x: hidden;

        font-family: "Cairo", sans-serif;

        color: var(--text);

        background:
          radial-gradient(
            circle at 15% 5%,
            rgba(6, 182, 212, 0.065),
            transparent 24%
          ),
          radial-gradient(
            circle at 88% 12%,
            rgba(99, 102, 241, 0.055),
            transparent 25%
          ),
          var(--bg);

        transition:
          background 0.3s ease,
          color 0.3s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(
          var(--container),
          calc(100% - 40px)
        );

        margin-inline: auto;
      }

      /* =====================================================
         BACKGROUND
      ===================================================== */

      .page-background {
        position: fixed;
        inset: 0;
        z-index: -10;
        pointer-events: none;
        overflow: hidden;
      }

      .bg-grid {
        position: absolute;
        inset: 0;

        background-image:
          linear-gradient(
            rgba(14, 165, 233, 0.025) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(14, 165, 233, 0.025) 1px,
            transparent 1px
          );

        background-size: 46px 46px;

        mask-image:
          linear-gradient(
            to bottom,
            black,
            transparent 72%
          );
      }

      .bg-orb {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(80px);
        opacity: 0.16;
        will-change: transform;
      }

      .bg-orb-one {
        width: 300px;
        height: 300px;
        top: 2%;
        right: -130px;
        background: #22d3ee;
        animation:
          bgFloatOne 18s ease-in-out infinite;
      }

      .bg-orb-two {
        width: 260px;
        height: 260px;
        top: 32%;
        left: -120px;
        background: #6366f1;
        animation:
          bgFloatTwo 21s ease-in-out infinite;
      }

      @keyframes bgFloatOne {
        0%,
        100% {
          transform: translate3d(0, 0, 0);
        }

        50% {
          transform: translate3d(-35px, 25px, 0);
        }
      }

      @keyframes bgFloatTwo {
        0%,
        100% {
          transform: translate3d(0, 0, 0);
        }

        50% {
          transform: translate3d(30px, -25px, 0);
        }
      }

      /* =====================================================
         HERO
      ===================================================== */

      .hero {
        position: relative;

        min-height: 650px;

        padding:
          72px 0
          55px;

        display: flex;
        align-items: center;
      }

      .hero-grid {
        position: relative;
        z-index: 2;

        display: grid;

        grid-template-columns:
          1fr
          0.92fr;

        align-items: center;

        gap: 55px;
      }

      .hero-content {
        animation:
          heroIn 0.8s ease both;
      }

      @keyframes heroIn {
        from {
          opacity: 0;
          transform: translateY(18px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding:
          7px 12px;

        border:
          1px solid var(--border);

        border-radius: 999px;

        background:
          var(--surface);

        color:
          var(--text-soft);

        font-size: 11px;
        font-weight: 700;

        box-shadow:
          var(--shadow-sm);

        backdrop-filter: blur(12px);
      }

      .hero-badge-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background:
          var(--cyan);

        box-shadow:
          0 0 0 4px
          rgba(6, 182, 212, 0.1);

        animation:
          badgePulse 2.4s ease-in-out infinite;
      }

      @keyframes badgePulse {
        0%,
        100% {
          opacity: 0.7;
          transform: scale(0.9);
        }

        50% {
          opacity: 1;
          transform: scale(1.15);
        }
      }

      .hero h1 {
        max-width: 690px;

        margin:
          20px 0
          16px;

        font-size:
          clamp(39px, 5vw, 62px);

        line-height: 1.13;

        letter-spacing: -2px;

        font-weight: 900;
      }

      .hero h1 .gradient-text {
        background:
          linear-gradient(
            100deg,
            var(--primary),
            var(--primary-2),
            var(--accent)
          );

        background-size: 180% auto;

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;

        animation:
          gradientShift 6s ease-in-out infinite;
      }

      @keyframes gradientShift {
        0%,
        100% {
          background-position: 0% center;
        }

        50% {
          background-position: 100% center;
        }
      }

      .hero-description {
        max-width: 620px;

        margin: 0;

        color: var(--text-soft);

        font-size: 15px;

        line-height: 2;

        font-weight: 500;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 10px;

        margin-top: 25px;
      }

      .btn {
        min-height: 47px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding:
          0 18px;

        border:
          1px solid var(--border);

        border-radius:
          13px;

        font-size: 12px;
        font-weight: 800;

        transition:
          transform 0.22s ease,
          box-shadow 0.22s ease,
          border-color 0.22s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        color: #ffffff;

        border-color: transparent;

        background:
          linear-gradient(
            135deg,
            #0891b2,
            #2563eb
          );

        box-shadow:
          0 12px 28px
          rgba(37, 99, 235, 0.2);
      }

      .btn-primary:hover {
        box-shadow:
          0 16px 34px
          rgba(37, 99, 235, 0.27);
      }

      .btn-secondary {
        color: var(--text);

        background:
          var(--surface);

        backdrop-filter:
          blur(10px);
      }

      .btn-secondary:hover {
        border-color:
          var(--border-strong);
      }

      .hero-trust {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 15px;

        margin-top: 20px;

        color: var(--text-muted);

        font-size: 10px;
        font-weight: 700;
      }

      .hero-trust span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .hero-trust i {
        color: var(--primary);
      }

      /* =====================================================
         HERO VISUAL
      ===================================================== */

      .hero-visual {
        position: relative;

        min-height: 475px;

        display: flex;
        align-items: center;
        justify-content: center;

        animation:
          visualIn 0.9s 0.1s ease both;
      }

      @keyframes visualIn {
        from {
          opacity: 0;
          transform: scale(0.96);
        }

        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .visual-stage {
        position: relative;

        width: 445px;
        height: 445px;

        display: grid;
        place-items: center;
      }

      .visual-glow {
        position: absolute;
        inset: 60px;

        border-radius: 50%;

        background:
          radial-gradient(
            circle,
            rgba(6, 182, 212, 0.17),
            rgba(99, 102, 241, 0.08) 40%,
            transparent 70%
          );

        filter: blur(25px);

        animation:
          visualGlow 4s ease-in-out infinite;
      }

      @keyframes visualGlow {
        0%,
        100% {
          opacity: 0.65;
          transform: scale(0.96);
        }

        50% {
          opacity: 1;
          transform: scale(1.04);
        }
      }

      .visual-ring {
        position: absolute;

        top: 50%;
        left: 50%;

        border-radius: 50%;

        transform:
          translate(-50%, -50%);

        pointer-events: none;
      }

      .visual-ring-one {
        width: 275px;
        height: 275px;

        border:
          1px solid
          rgba(6, 182, 212, 0.16);

        border-top-color:
          rgba(6, 182, 212, 0.8);

        animation:
          rotateRing 14s linear infinite;
      }

      .visual-ring-two {
        width: 350px;
        height: 350px;

        border:
          1px dashed
          rgba(99, 102, 241, 0.19);

        border-left-color:
          rgba(6, 182, 212, 0.7);

        animation:
          rotateRingReverse 19s linear infinite;
      }

      .visual-ring-three {
        width: 420px;
        height: 420px;

        border:
          1px solid
          rgba(56, 189, 248, 0.07);

        border-bottom-color:
          rgba(99, 102, 241, 0.48);

        animation:
          rotateRing 26s linear infinite;
      }

      @keyframes rotateRing {
        from {
          transform:
            translate(-50%, -50%)
            rotate(0deg);
        }

        to {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }
      }

      @keyframes rotateRingReverse {
        from {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }

        to {
          transform:
            translate(-50%, -50%)
            rotate(0deg);
        }
      }

      .logo-core {
        position: relative;
        z-index: 5;

        width: 220px;
        height: 220px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background:
          radial-gradient(
            circle at 32% 22%,
            rgba(34, 211, 238, 0.15),
            transparent 38%
          ),
          radial-gradient(
            circle at 75% 78%,
            rgba(99, 102, 241, 0.16),
            transparent 45%
          ),
          rgba(8, 17, 31, 0.92);

        border:
          1px solid
          rgba(103, 232, 249, 0.28);

        box-shadow:
          0 20px 60px
          rgba(2, 8, 23, 0.2),
          0 0 45px
          rgba(34, 211, 238, 0.11),
          inset 0 0 35px
          rgba(56, 189, 248, 0.055);

        backdrop-filter:
          blur(15px);

        animation:
          coreFloat 5s ease-in-out infinite;
      }

      @keyframes coreFloat {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(-7px);
        }
      }

      html:not(.dark-mode) .logo-core {
        background:
          radial-gradient(
            circle at 32% 22%,
            rgba(6, 182, 212, 0.1),
            transparent 38%
          ),
          radial-gradient(
            circle at 75% 78%,
            rgba(99, 102, 241, 0.08),
            transparent 45%
          ),
          rgba(255, 255, 255, 0.93);

        border-color:
          rgba(14, 165, 233, 0.22);

        box-shadow:
          0 20px 55px
          rgba(15, 23, 42, 0.09),
          0 0 35px
          rgba(14, 165, 233, 0.08);
      }

      .logo-symbol {
        width: 83px;
        height: 83px;

        display: grid;
        place-items: center;

        animation:
          symbolFloat 4s ease-in-out infinite;
      }

      .logo-symbol svg {
        width: 100%;
        height: 100%;

        filter:
          drop-shadow(
            0 0 9px
            rgba(34, 211, 238, 0.32)
          )
          drop-shadow(
            0 0 20px
            rgba(99, 102, 241, 0.14)
          );
      }

      @keyframes symbolFloat {
        0%,
        100% {
          transform:
            translateY(0)
            scale(1);
        }

        50% {
          transform:
            translateY(-3px)
            scale(1.025);
        }
      }

      .logo-name {
        margin-top: 5px;

        font-size: 27px;
        line-height: 1;

        font-weight: 900;

        letter-spacing: -1px;

        background:
          linear-gradient(
            90deg,
            #67e8f9,
            #38bdf8,
            #818cf8
          );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
      }

      .logo-subtitle {
        margin-top: 8px;

        color:
          rgba(186, 230, 253, 0.6);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 7px;

        font-weight: 700;

        letter-spacing: 2px;
      }

      html:not(.dark-mode) .logo-subtitle {
        color:
          rgba(15, 23, 42, 0.48);
      }

      .orbit-node {
        position: absolute;
        z-index: 7;

        width: 8px;
        height: 8px;

        border-radius: 50%;

        background:
          linear-gradient(
            135deg,
            #67e8f9,
            #6366f1
          );

        box-shadow:
          0 0 10px
          rgba(34, 211, 238, 0.75),
          0 0 23px
          rgba(99, 102, 241, 0.3);

        animation:
          nodePulse 2.8s ease-in-out infinite;
      }

      .node-one {
        top: 65px;
        right: 92px;
      }

      .node-two {
        top: 145px;
        left: 27px;
        animation-delay: -0.7s;
      }

      .node-three {
        bottom: 68px;
        right: 95px;
        animation-delay: -1.4s;
      }

      .node-four {
        bottom: 145px;
        left: 48px;
        animation-delay: -2.1s;
      }

      @keyframes nodePulse {
        0%,
        100% {
          transform: scale(0.75);
          opacity: 0.5;
        }

        50% {
          transform: scale(1.3);
          opacity: 1;
        }
      }

      .tech-chip {
        position: absolute;
        z-index: 9;

        min-width: 115px;

        padding:
          9px 11px;

        display: flex;
        align-items: center;
        gap: 8px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);

        backdrop-filter:
          blur(13px);

        color:
          var(--text);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;

        font-weight: 700;
      }

      .tech-chip i {
        color:
          var(--primary);
      }

      .chip-one {
        top: 74px;
        right: 5px;

        animation:
          chipFloatOne 5s ease-in-out infinite;
      }

      .chip-two {
        bottom: 76px;
        left: 3px;

        animation:
          chipFloatTwo 6s ease-in-out infinite;
      }

      @keyframes chipFloatOne {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(-8px);
        }
      }

      @keyframes chipFloatTwo {
        0%,
        100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(8px);
        }
      }

      /* =====================================================
         TICKER
      ===================================================== */

      .tech-ticker {
        overflow: hidden;

        border-top:
          1px solid var(--border);

        border-bottom:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.3);
      }

      html.dark-mode .tech-ticker {
        background:
          rgba(7, 17, 31, 0.38);
      }

      .ticker-track {
        width: max-content;

        display: flex;
        align-items: center;

        gap: 34px;

        padding:
          13px 0;

        animation:
          tickerMove 34s linear infinite;
      }

      .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        color:
          var(--text-muted);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 10px;

        font-weight: 700;

        white-space: nowrap;
      }

      .ticker-item i {
        color:
          var(--primary);

        font-size: 11px;
      }

      .ticker-separator {
        width: 3px;
        height: 3px;

        border-radius: 50%;

        background:
          var(--primary);

        opacity: 0.45;
      }

      @keyframes tickerMove {
        from {
          transform: translateX(0);
        }

        to {
          transform: translateX(-50%);
        }
      }

      /* =====================================================
         SECTIONS
      ===================================================== */

      .section {
        padding:
          78px 0;
      }

      .section-heading {
        max-width: 700px;

        margin:
          0 auto
          42px;

        text-align: center;
      }

      .section-kicker {
        display: inline-flex;

        padding:
          6px 10px;

        border-radius:
          999px;

        background:
          rgba(6, 182, 212, 0.07);

        color:
          var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;

        font-weight: 800;

        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin:
          13px 0
          9px;

        font-size:
          clamp(27px, 3.5vw, 41px);

        line-height: 1.25;

        font-weight: 900;

        letter-spacing: -0.7px;
      }

      .section-heading p {
        margin: 0;

        color:
          var(--text-soft);

        font-size: 13px;

        line-height: 1.9;
      }

      /* =====================================================
         STATS
      ===================================================== */

      .stats-grid {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 13px;
      }

      .stat-card {
        position: relative;

        min-height: 126px;

        padding:
          20px 15px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);

        backdrop-filter:
          blur(12px);
      }

      .stat-card::after {
        content: "";

        position: absolute;

        width: 80px;
        height: 80px;

        left: -30px;
        bottom: -35px;

        border-radius: 50%;

        background:
          rgba(6, 182, 212, 0.08);

        filter: blur(3px);
      }

      .stat-number {
        display: block;

        font-size: 32px;

        line-height: 1.2;

        font-weight: 900;

        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--accent)
          );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
      }

      .stat-label {
        margin-top: 4px;

        color:
          var(--text-soft);

        font-size: 10px;

        font-weight: 700;
      }

      /* =====================================================
         TOOL FINDER
      ===================================================== */

      .tool-finder {
        padding: 21px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-xl);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-md);

        backdrop-filter:
          blur(14px);
      }

      .tool-search {
        position: relative;
      }

      .tool-search i {
        position: absolute;

        top: 50%;
        right: 18px;

        transform:
          translateY(-50%);

        color:
          var(--text-muted);

        font-size: 13px;
      }

      .tool-search input {
        width: 100%;

        height: 53px;

        padding:
          0 48px
          0 16px;

        border:
          1px solid var(--border);

        border-radius:
          13px;

        outline: none;

        background:
          var(--surface-solid);

        color:
          var(--text);

        font-size: 12px;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .tool-search input:focus {
        border-color:
          rgba(6, 182, 212, 0.42);

        box-shadow:
          0 0 0 4px
          rgba(6, 182, 212, 0.07);
      }

      .tool-results {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 10px;

        margin-top: 14px;
      }

      .tool-result {
        min-height: 66px;

        display: flex;
        align-items: center;

        gap: 10px;

        padding:
          10px;

        border:
          1px solid var(--border);

        border-radius:
          13px;

        background:
          rgba(255, 255, 255, 0.38);

        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }

      html.dark-mode .tool-result {
        background:
          rgba(15, 23, 42, 0.4);
      }

      .tool-result:hover {
        transform:
          translateY(-2px);

        border-color:
          var(--border-strong);
      }

      .tool-result-icon {
        width: 37px;
        height: 37px;

        flex: 0 0 37px;

        display: grid;
        place-items: center;

        border-radius:
          10px;

        background:
          linear-gradient(
            135deg,
            rgba(6, 182, 212, 0.11),
            rgba(99, 102, 241, 0.11)
          );

        color:
          var(--primary);

        font-size: 14px;
      }

      .tool-result strong {
        display: block;

        max-width: 150px;

        overflow: hidden;

        color:
          var(--text);

        font-size: 10px;

        font-weight: 800;

        white-space: nowrap;

        text-overflow: ellipsis;
      }

      .tool-result small {
        display: block;

        margin-top: 2px;

        color:
          var(--text-muted);

        font-size: 8px;
      }

      .no-results {
        display: none;

        padding: 20px;

        color:
          var(--text-soft);

        text-align: center;

        font-size: 11px;
      }

      /* =====================================================
         FEATURED TOOLS
      ===================================================== */

      .tools-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 14px;
      }

      .tool-card {
        position: relative;

        min-width: 0;

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);

        backdrop-filter:
          blur(12px);

        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .tool-card:hover {
        transform:
          translateY(-5px);

        border-color:
          var(--border-strong);

        box-shadow:
          var(--shadow-md);
      }

      .tool-visual {
        position: relative;

        height: 116px;

        overflow: hidden;

        display: flex;
        align-items: center;
        justify-content: center;

        background:
          linear-gradient(
            135deg,
            #07111f,
            #0b1b31
          );
      }

      .tool-visual::after {
        content: "";

        position: absolute;

        inset: 0;

        background:
          linear-gradient(
            120deg,
            transparent 20%,
            rgba(255, 255, 255, 0.055),
            transparent 80%
          );

        transform:
          translateX(-100%);

        transition:
          transform 0.6s ease;
      }

      .tool-card:hover .tool-visual::after {
        transform:
          translateX(100%);
      }

      .tool-visual-grid {
        position: absolute;
        inset: 0;

        opacity: 0.35;

        background-image:
          linear-gradient(
            rgba(103, 232, 249, 0.09) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(103, 232, 249, 0.09) 1px,
            transparent 1px
          );

        background-size: 18px 18px;
      }

      .tool-visual-window {
        position: relative;
        z-index: 2;

        width: 72%;

        padding: 11px;

        border:
          1px solid
          rgba(148, 163, 184, 0.18);

        border-radius: 10px;

        background:
          rgba(2, 8, 23, 0.62);

        box-shadow:
          0 15px 30px
          rgba(0, 0, 0, 0.18);

        transform:
          perspective(500px)
          rotateX(3deg);
      }

      .window-top {
        display: flex;
        align-items: center;
        gap: 4px;

        margin-bottom: 8px;
      }

      .window-top span {
        width: 5px;
        height: 5px;

        border-radius: 50%;

        background:
          #64748b;
      }

      .window-lines {
        display: grid;
        gap: 4px;
      }

      .window-line {
        height: 4px;

        border-radius: 99px;

        background:
          rgba(103, 232, 249, 0.38);
      }

      .window-line:nth-child(2) {
        width: 72%;
        background:
          rgba(129, 140, 248, 0.4);
      }

      .window-line:nth-child(3) {
        width: 52%;
        background:
          rgba(34, 211, 238, 0.25);
      }

      .tool-visual-symbol {
        position: absolute;
        z-index: 3;

        width: 48px;
        height: 48px;

        display: grid;
        place-items: center;

        border-radius: 14px;

        background:
          linear-gradient(
            135deg,
            rgba(34, 211, 238, 0.95),
            rgba(99, 102, 241, 0.95)
          );

        color: #ffffff;

        font-size: 18px;

        box-shadow:
          0 10px 28px
          rgba(34, 211, 238, 0.2);
      }

      .tool-card-body {
        padding: 16px;
      }

      .tool-card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 8px;
      }

      .tool-card-type {
        color:
          var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 8px;

        font-weight: 800;

        letter-spacing: 0.7px;
      }

      .tool-card-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;

        color:
          var(--text-muted);

        font-size: 8px;
        font-weight: 700;
      }

      .tool-card-status::before {
        content: "";

        width: 5px;
        height: 5px;

        border-radius: 50%;

        background:
          #22c55e;

        box-shadow:
          0 0 7px
          rgba(34, 197, 94, 0.5);
      }

      .tool-card h3 {
        margin:
          9px 0
          5px;

        font-size: 14px;

        line-height: 1.5;

        font-weight: 800;
      }

      .tool-card p {
        margin: 0;

        color:
          var(--text-soft);

        font-size: 10px;

        line-height: 1.8;
      }

      .tool-card-link {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        margin-top: 11px;

        color:
          var(--primary);

        font-size: 9px;

        font-weight: 800;
      }

      .all-tools-link {
        display: flex;
        justify-content: center;

        margin-top: 28px;
      }

      /* =====================================================
         TRACKS
      ===================================================== */

      .tracks-grid {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 13px;
      }

      .track-card {
        position: relative;

        min-height: 205px;

        padding: 20px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);

        transition:
          transform 0.25s ease,
          border-color 0.25s ease;
      }

      .track-card::before {
        content: "";

        position: absolute;

        width: 130px;
        height: 130px;

        top: -70px;
        left: -50px;

        border-radius: 50%;

        background:
          rgba(6, 182, 212, 0.08);

        filter: blur(10px);
      }

      .track-card:hover {
        transform:
          translateY(-5px);

        border-color:
          var(--border-strong);
      }

      .track-icon {
        width: 43px;
        height: 43px;

        display: grid;
        place-items: center;

        margin-bottom: 13px;

        border-radius: 13px;

        background:
          linear-gradient(
            135deg,
            rgba(6, 182, 212, 0.1),
            rgba(99, 102, 241, 0.11)
          );

        color:
          var(--primary);

        font-size: 17px;
      }

      .track-tag {
        color:
          var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 8px;

        font-weight: 800;

        letter-spacing: 1px;
      }

      .track-card h3 {
        margin:
          8px 0
          5px;

        font-size: 16px;

        font-weight: 800;
      }

      .track-card p {
        margin: 0;

        color:
          var(--text-soft);

        font-size: 10px;

        line-height: 1.8;
      }

      /* =====================================================
         CODE EDITOR
      ===================================================== */

      .editor-wrapper {
        display: grid;

        grid-template-columns:
          1fr
          0.92fr;

        min-height: 495px;

        overflow: hidden;

        border:
          1px solid
          rgba(148, 163, 184, 0.14);

        border-radius:
          24px;

        background:
          #07111f;

        box-shadow:
          0 25px 70px
          rgba(2, 8, 23, 0.18);
      }

      .editor-panel {
        min-width: 0;

        display: flex;
        flex-direction: column;
      }

      .editor-toolbar {
        min-height: 57px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        padding:
          9px 13px;

        border-bottom:
          1px solid
          rgba(148, 163, 184, 0.1);

        background:
          rgba(15, 23, 42, 0.68);
      }

      .editor-tabs {
        display: flex;
        gap: 4px;
      }

      .editor-tab {
        min-height: 34px;

        padding:
          0 11px;

        border: 0;

        border-radius:
          8px;

        background:
          transparent;

        color:
          #8190a5;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;

        font-weight: 700;
      }

      .editor-tab:hover,
      .editor-tab.active {
        color:
          #67e8f9;

        background:
          rgba(34, 211, 238, 0.08);
      }

      .editor-actions {
        display: flex;
        gap: 5px;
      }

      .editor-action {
        width: 33px;
        height: 33px;

        display: grid;
        place-items: center;

        border:
          1px solid
          rgba(148, 163, 184, 0.12);

        border-radius:
          8px;

        background:
          rgba(15, 23, 42, 0.7);

        color:
          #8190a5;

        font-size: 11px;
      }

      .editor-action:hover {
        color:
          #67e8f9;

        border-color:
          rgba(34, 211, 238, 0.28);
      }

      .editor-body {
        position: relative;

        flex: 1;

        display: flex;

        min-height: 395px;

        overflow: hidden;
      }

      .line-numbers {
        width: 45px;

        flex: 0 0 45px;

        padding:
          18px 7px;

        overflow: hidden;

        background:
          rgba(2, 8, 23, 0.35);

        color:
          #45546a;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 10px;

        line-height: 1.8;

        text-align: center;

        user-select: none;
      }

      .code-editor {
        flex: 1;

        min-width: 0;

        width: 100%;

        resize: none;

        padding:
          18px;

        border: 0;

        outline: 0;

        background:
          transparent;

        color:
          #dbeafe;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 11px;

        line-height: 1.8;

        tab-size: 2;
      }

      .editor-status {
        min-height: 33px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding:
          0 13px;

        border-top:
          1px solid
          rgba(148, 163, 184, 0.09);

        color:
          #5f7189;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 8px;
      }

      .status-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .status-live::before {
        content: "";

        width: 5px;
        height: 5px;

        border-radius: 50%;

        background:
          #22c55e;

        box-shadow:
          0 0 7px
          rgba(34, 197, 94, 0.7);
      }

      .preview-panel {
        min-width: 0;

        display: flex;
        flex-direction: column;

        background:
          #f8fafc;
      }

      .preview-header {
        min-height: 57px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding:
          0 16px;

        border-bottom:
          1px solid
          #e2e8f0;

        background:
          #ffffff;

        color:
          #0f172a;
      }

      .preview-dots {
        display: flex;
        gap: 5px;
      }

      .preview-dots span {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background:
          #cbd5e1;
      }

      .preview-title {
        color:
          #64748b;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 8px;
      }

      #code-preview {
        flex: 1;

        width: 100%;

        min-height: 350px;

        border: 0;

        background:
          #ffffff;
      }

      .editor-info {
        padding:
          17px;

        border-top:
          1px solid
          rgba(148, 163, 184, 0.1);

        background:
          #07111f;

        color:
          #8190a5;

        font-size: 9px;

        line-height: 1.8;
      }

      .editor-info strong {
        color:
          #dbeafe;
      }

      /* =====================================================
         STEPS
      ===================================================== */

      .steps-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 13px;
      }

      .step-card {
        padding: 24px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);
      }

      .step-number {
        width: 42px;
        height: 42px;

        display: grid;
        place-items: center;

        border-radius:
          12px;

        background:
          linear-gradient(
            135deg,
            rgba(6, 182, 212, 0.1),
            rgba(99, 102, 241, 0.11)
          );

        color:
          var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 11px;

        font-weight: 800;
      }

      .step-card h3 {
        margin:
          15px 0
          7px;

        font-size: 15px;
      }

      .step-card p {
        margin: 0;

        color:
          var(--text-soft);

        font-size: 10px;

        line-height: 1.9;
      }

      /* =====================================================
         FEATURES
      ===================================================== */

      .features-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 12px;
      }

      .feature {
        padding: 20px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);

        box-shadow:
          var(--shadow-sm);
      }

      .feature i {
        color:
          var(--primary);

        font-size: 18px;
      }

      .feature h3 {
        margin:
          11px 0
          5px;

        font-size: 13px;
      }

      .feature p {
        margin: 0;

        color:
          var(--text-soft);

        font-size: 9px;

        line-height: 1.9;
      }

      /* =====================================================
         FAQ
      ===================================================== */

      .faq-list {
        max-width: 820px;

        margin-inline: auto;

        display: grid;

        gap: 8px;
      }

      .faq-item {
        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          14px;

        background:
          var(--surface);
      }

      .faq-question {
        width: 100%;

        min-height: 59px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding:
          0 17px;

        border: 0;

        background:
          transparent;

        color:
          var(--text);

        text-align: right;

        font-size: 11px;

        font-weight: 800;
      }

      .faq-question i {
        color:
          var(--primary);

        font-size: 10px;

        transition:
          transform 0.2s ease;
      }

      .faq-item.open
        .faq-question
        i {
        transform:
          rotate(180deg);
      }

      .faq-answer {
        display: grid;

        grid-template-rows:
          0fr;

        transition:
          grid-template-rows 0.25s ease;
      }

      .faq-answer-inner {
        overflow: hidden;

        padding:
          0 17px;

        color:
          var(--text-soft);

        font-size: 10px;

        line-height: 1.9;
      }

      .faq-item.open
        .faq-answer {
        grid-template-rows:
          1fr;
      }

      .faq-item.open
        .faq-answer-inner {
        padding-bottom:
          17px;
      }

      /* =====================================================
         CTA
      ===================================================== */

      .cta {
        position: relative;

        overflow: hidden;

        padding:
          55px 25px;

        border:
          1px solid
          rgba(34, 211, 238, 0.18);

        border-radius:
          28px;

        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(34, 211, 238, 0.16),
            transparent 32%
          ),
          radial-gradient(
            circle at 90% 80%,
            rgba(99, 102, 241, 0.17),
            transparent 35%
          ),
          #091525;

        text-align: center;

        box-shadow:
          0 25px 70px
          rgba(2, 8, 23, 0.18);
      }

      .cta::before {
        content: "";

        position: absolute;

        top: 0;
        bottom: 0;

        width: 90px;

        background:
          linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.045),
            transparent
          );

        transform:
          translateX(-160px);

        animation:
          ctaShine 8s linear infinite;
      }

      @keyframes ctaShine {
        to {
          transform:
            translateX(
              calc(100vw + 160px)
            );
        }
      }

      .cta-content {
        position: relative;
        z-index: 2;
      }

      .cta h2 {
        margin:
          0 0
          10px;

        color:
          #ffffff;

        font-size:
          clamp(26px, 3.5vw, 39px);

        font-weight: 900;
      }

      .cta p {
        max-width: 590px;

        margin:
          0 auto
          22px;

        color:
          #91a2b8;

        font-size: 12px;

        line-height: 1.9;
      }

      /* =====================================================
         REVEAL
      ===================================================== */

      .reveal {
        opacity: 0;

        transform:
          translateY(18px);

        transition:
          opacity 0.55s ease,
          transform 0.55s ease;
      }

      .reveal.visible {
        opacity: 1;

        transform:
          translateY(0);
      }

      /* =====================================================
         SCROLL TOP
      ===================================================== */

      .scroll-top {
        position: fixed;

        left: 18px;
        bottom: 18px;

        z-index: 100;

        width: 41px;
        height: 41px;

        display: grid;
        place-items: center;

        border:
          1px solid var(--border);

        border-radius:
          12px;

        background:
          var(--surface);

        color:
          var(--primary);

        backdrop-filter:
          blur(12px);

        opacity: 0;
        visibility: hidden;

        transform:
          translateY(8px);

        transition:
          opacity 0.2s ease,
          visibility 0.2s ease,
          transform 0.2s ease;
      }

      .scroll-top.show {
        opacity: 1;
        visibility: visible;

        transform:
          translateY(0);
      }

      /* =====================================================
         RESPONSIVE — TABLET
      ===================================================== */

      @media (max-width: 1050px) {
        .hero-grid {
          grid-template-columns: 1fr;

          gap: 30px;

          text-align: center;
        }

        .hero-content {
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .hero-description {
          max-width: 680px;
        }

        .hero-visual {
          min-height: 430px;
        }

        .tool-results {
          grid-template-columns:
            repeat(3, 1fr);
        }

        .tracks-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .stats-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .editor-wrapper {
          grid-template-columns:
            1fr;
        }

        .preview-panel {
          min-height: 370px;
        }
      }

      /* =====================================================
         RESPONSIVE — MOBILE
      ===================================================== */

      @media (max-width: 760px) {
        .container {
          width:
            calc(100% - 28px);
        }

        .hero {
          min-height: auto;

          padding:
            52px 0
            30px;
        }

        .hero-grid {
          gap: 10px;
        }

        .hero h1 {
          margin-top: 17px;

          font-size:
            clamp(32px, 9.5vw, 43px);

          line-height: 1.17;

          letter-spacing:
            -1.2px;
        }

        .hero-description {
          font-size: 12px;

          line-height: 1.9;
        }

        .hero-actions {
          justify-content: center;

          width: 100%;

          margin-top: 20px;
        }

        .btn {
          min-height: 43px;

          padding-inline: 14px;

          font-size: 10px;
        }

        .hero-trust {
          justify-content: center;

          gap: 10px;

          font-size: 8px;
        }

        .hero-visual {
          min-height: 350px;

          margin-top: 4px;
        }

        .visual-stage {
          width: 330px;
          height: 330px;
        }

        .visual-ring-one {
          width: 220px;
          height: 220px;
        }

        .visual-ring-two {
          width: 275px;
          height: 275px;
        }

        .visual-ring-three {
          width: 315px;
          height: 315px;
        }

        .logo-core {
          width: 174px;
          height: 174px;
        }

        .logo-symbol {
          width: 65px;
          height: 65px;
        }

        .logo-name {
          font-size: 21px;
        }

        .logo-subtitle {
          font-size: 5px;
          letter-spacing: 1.4px;
        }

        .chip-one {
          top: 55px;
          right: -2px;
        }

        .chip-two {
          bottom: 55px;
          left: -2px;
        }

        .tech-chip {
          min-width: 100px;

          padding:
            7px 9px;

          font-size: 7px;
        }

        .section {
          padding:
            58px 0;
        }

        .section-heading {
          margin-bottom:
            30px;
        }

        .section-heading h2 {
          font-size:
            clamp(24px, 7vw, 31px);
        }

        .section-heading p {
          font-size: 11px;
        }

        .stats-grid {
          grid-template-columns:
            repeat(2, 1fr);

          gap: 9px;
        }

        .stat-card {
          min-height: 105px;

          padding:
            14px 8px;
        }

        .stat-number {
          font-size: 27px;
        }

        .stat-label {
          font-size: 8px;
        }

        .tool-finder {
          padding: 13px;

          border-radius:
            19px;
        }

        .tool-results {
          grid-template-columns:
            repeat(2, 1fr);

          gap: 7px;
        }

        .tool-result {
          min-height: 61px;

          padding: 8px;

          gap: 7px;

          border-radius: 11px;
        }

        .tool-result-icon {
          width: 32px;
          height: 32px;

          flex-basis: 32px;

          font-size: 11px;
        }

        .tool-result strong {
          max-width: 105px;

          font-size: 8px;
        }

        .tool-result small {
          font-size: 7px;
        }

        /*
         * مهم:
         * الأدوات على الهاتف عمودان
         */
        .tools-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));

          gap: 9px;
        }

        .tool-visual {
          height: 82px;
        }

        .tool-visual-window {
          width: 74%;

          padding: 7px;
        }

        .tool-visual-symbol {
          width: 34px;
          height: 34px;

          border-radius: 10px;

          font-size: 12px;
        }

        .tool-card-body {
          padding: 11px;
        }

        .tool-card-type {
          font-size: 6px;
        }

        .tool-card-status {
          font-size: 6px;
        }

        .tool-card h3 {
          margin-top: 7px;

          font-size: 10px;

          line-height: 1.45;
        }

        .tool-card p {
          font-size: 8px;

          line-height: 1.7;
        }

        .tool-card-link {
          margin-top: 8px;

          font-size: 7px;
        }

        .all-tools-link {
          margin-top: 22px;
        }

        .tracks-grid {
          grid-template-columns:
            repeat(2, 1fr);

          gap: 9px;
        }

        .track-card {
          min-height: 175px;

          padding: 14px;

          border-radius:
            15px;
        }

        .track-icon {
          width: 36px;
          height: 36px;

          margin-bottom: 9px;

          border-radius: 10px;

          font-size: 14px;
        }

        .track-tag {
          font-size: 6px;
        }

        .track-card h3 {
          margin:
            6px 0
            4px;

          font-size: 12px;
        }

        .track-card p {
          font-size: 8px;

          line-height: 1.7;
        }

        .editor-wrapper {
          border-radius:
            18px;
        }

        .editor-toolbar {
          min-height: 52px;

          padding:
            7px 9px;
        }

        .editor-tab {
          min-height: 31px;

          padding-inline: 8px;

          font-size: 8px;
        }

        .editor-action {
          width: 30px;
          height: 30px;

          font-size: 9px;
        }

        .editor-body {
          min-height: 330px;
        }

        .line-numbers {
          width: 35px;
          flex-basis: 35px;

          padding:
            15px 4px;

          font-size: 8px;
        }

        .code-editor {
          padding: 15px;

          font-size: 9px;

          line-height: 1.8;
        }

        .editor-status {
          min-height: 30px;

          padding-inline: 10px;

          font-size: 7px;
        }

        #code-preview {
          min-height: 250px;
        }

        .preview-panel {
          min-height: 330px;
        }

        .editor-info {
          padding:
            13px;

          font-size: 8px;
        }

        .steps-grid {
          grid-template-columns:
            1fr;

          gap: 9px;
        }

        .step-card {
          padding:
            18px;
        }

        .step-card h3 {
          font-size: 13px;
        }

        .step-card p {
          font-size: 9px;
        }

        .features-grid {
          grid-template-columns:
            repeat(2, 1fr);

          gap: 8px;
        }

        .feature {
          padding:
            15px;
        }

        .feature i {
          font-size: 15px;
        }

        .feature h3 {
          font-size: 11px;
        }

        .feature p {
          font-size: 8px;

          line-height: 1.8;
        }

        .faq-question {
          min-height: 54px;

          padding-inline: 13px;

          font-size: 9px;
        }

        .faq-answer-inner {
          padding-inline: 13px;

          font-size: 8px;
        }

        .cta {
          padding:
            40px 17px;

          border-radius:
            21px;
        }

        .cta h2 {
          font-size:
            clamp(23px, 7vw, 30px);
        }

        .cta p {
          font-size: 9px;
        }
      }

      /* =====================================================
         VERY SMALL PHONES
      ===================================================== */

      @media (max-width: 390px) {
        .container {
          width:
            calc(100% - 22px);
        }

        .hero {
          padding-top:
            42px;
        }

        .hero h1 {
          font-size: 31px;
        }

        .hero-description {
          font-size: 11px;
        }

        .hero-trust {
          gap: 7px;

          font-size: 7px;
        }

        .visual-stage {
          width: 285px;
          height: 285px;
        }

        .hero-visual {
          min-height: 300px;
        }

        .visual-ring-one {
          width: 195px;
          height: 195px;
        }

        .visual-ring-two {
          width: 235px;
          height: 235px;
        }

        .visual-ring-three {
          width: 270px;
          height: 270px;
        }

        .logo-core {
          width: 155px;
          height: 155px;
        }

        .logo-symbol {
          width: 57px;
          height: 57px;
        }

        .logo-name {
          font-size: 19px;
        }

        .tech-chip {
          display: none;
        }

        .tool-result strong {
          max-width: 92px;
        }

        .tool-card h3 {
          font-size: 9px;
        }

        .tool-card p {
          font-size: 7px;
        }

        .track-card {
          min-height: 165px;
        }

        .features-grid {
          gap: 7px;
        }

        .feature {
          padding: 12px;
        }
      }

      /* =====================================================
         REDUCED MOTION
      ===================================================== */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration:
            0.01ms !important;

          animation-iteration-count:
            1 !important;

          transition-duration:
            0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <div
      class="page-background"
      aria-hidden="true"
    >
      <div class="bg-grid"></div>
      <div class="bg-orb bg-orb-one"></div>
      <div class="bg-orb bg-orb-two"></div>
    </div>

    <Header />

    <main>

      <!-- =================================================
           HERO
      ================================================== -->

      <section class="hero">
        <div class="container hero-grid">

          <div class="hero-content">

            <div class="hero-badge">
              <span class="hero-badge-dot"></span>

              منصة تقنية عربية تتطور باستمرار
            </div>

            <h1>
              كل أدواتك التقنية
              <br />
              <span class="gradient-text">
                في مكان واحد
              </span>
            </h1>

            <p class="hero-description">
              Th.Tech تجمع لك أدوات عملية للبرمجة والويب
              والذكاء الاصطناعي والأمن السيبراني، لتنجز
              مهامك اليومية بسرعة ومن المتصفح مباشرة.
            </p>

            <div class="hero-actions">

              <a
                class="btn btn-primary"
                href="#tools"
              >
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                استكشف الأدوات
              </a>

              <a
                class="btn btn-secondary"
                href="#code-editor"
              >
                <i class="fa-solid fa-code"></i>
                جرّب محرر الأكواد
              </a>

            </div>

            <div class="hero-trust">

              <span>
                <i class="fa-solid fa-bolt"></i>
                سريع
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                مباشر من المتصفح
              </span>

              <span>
                <i class="fa-solid fa-mobile-screen"></i>
                متوافق مع الهاتف
              </span>

            </div>

          </div>

          <!-- =================================================
               PROFESSIONAL ANIMATED LOGO
          ================================================== -->

          <div class="hero-visual">

            <div class="visual-stage">

              <div class="visual-glow"></div>

              <div
                class="visual-ring visual-ring-one"
              ></div>

              <div
                class="visual-ring visual-ring-two"
              ></div>

              <div
                class="visual-ring visual-ring-three"
              ></div>

              <span
                class="orbit-node node-one"
              ></span>

              <span
                class="orbit-node node-two"
              ></span>

              <span
                class="orbit-node node-three"
              ></span>

              <span
                class="orbit-node node-four"
              ></span>

              <div class="tech-chip chip-one">
                <i class="fa-solid fa-microchip"></i>
                AI TOOLS
              </div>

              <div class="tech-chip chip-two">
                <i class="fa-solid fa-terminal"></i>
                DEV TOOLS
              </div>

              <div class="logo-core">

                <div class="logo-symbol">

                  <svg
                    viewBox="0 0 160 160"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >

                    <defs>

                      <linearGradient
                        id="thLogoGradient"
                        x1="20"
                        y1="20"
                        x2="140"
                        y2="140"
                      >
                        <stop
                          offset="0%"
                          stop-color="#22d3ee"
                        />

                        <stop
                          offset="48%"
                          stop-color="#38bdf8"
                        />

                        <stop
                          offset="100%"
                          stop-color="#6366f1"
                        />
                      </linearGradient>

                      <linearGradient
                        id="thLogoStroke"
                        x1="0"
                        y1="0"
                        x2="1"
                        y2="1"
                      >
                        <stop
                          offset="0%"
                          stop-color="#67e8f9"
                        />

                        <stop
                          offset="100%"
                          stop-color="#818cf8"
                        />
                      </linearGradient>

                    </defs>

                    <circle
                      cx="80"
                      cy="80"
                      r="66"
                      fill="url(#thLogoGradient)"
                      opacity="0.11"
                    />

                    <circle
                      cx="80"
                      cy="80"
                      r="61"
                      fill="none"
                      stroke="url(#thLogoStroke)"
                      stroke-width="2"
                      opacity="0.75"
                    />

                    <g
                      fill="none"
                      stroke="url(#thLogoGradient)"
                      stroke-width="10"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >

                      <path d="M38 48 H87" />

                      <path d="M62.5 48 V112" />

                      <path d="M93 48 V112" />

                      <path d="M122 48 V112" />

                      <path d="M93 80 H122" />

                    </g>

                    <circle
                      cx="122"
                      cy="48"
                      r="5"
                      fill="#67e8f9"
                    />

                  </svg>

                </div>

                <div class="logo-name">
                  Th<strong>.Tech</strong>
                </div>

                <div class="logo-subtitle">
                  TECH • AI • TOOLS
                </div>

              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- =================================================
           TECH TICKER
      ================================================== -->

      <div class="tech-ticker">

        <div class="ticker-track">

          {
            [...tickerItems, ...tickerItems].map(
              (item, index) => (
                <span
                  class="ticker-item"
                  aria-hidden={
                    index >= tickerItems.length
                      ? 'true'
                      : undefined
                  }
                >

                  <i class={item.icon}></i>

                  {item.label}

                  <span class="ticker-separator"></span>

                </span>
              )
            )
          }

        </div>

      </div>

      <!-- =================================================
           STATS
      ================================================== -->

      <section class="section">

        <div class="container">

          <div class="stats-grid">

            <div class="stat-card reveal">

              <span
                class="stat-number"
                data-counter={toolsCount}
              >
                0
              </span>

              <span class="stat-label">
                أداة تقنية
              </span>

            </div>

            <div class="stat-card reveal">

              <span
                class="stat-number"
                data-counter="4"
              >
                0
              </span>

              <span class="stat-label">
                مسارات تقنية
              </span>

            </div>

            <div class="stat-card reveal">

              <span
                class="stat-number"
                data-counter="100"
              >
                0
              </span>

              <span class="stat-label">
                تجربة مباشرة
              </span>

            </div>

            <div class="stat-card reveal">

              <span class="stat-number">
                ∞
              </span>

              <span class="stat-label">
                إمكانيات الاستخدام
              </span>

            </div>

          </div>

        </div>

      </section>

      <!-- =================================================
           TOOL FINDER
      ================================================== -->

      <section
        id="tools"
        class="section"
      >

        <div class="container">

          <div class="section-heading reveal">

            <span class="section-kicker">
              TOOL FINDER
            </span>

            <h2>
              ابحث عن الأداة التي تحتاجها
            </h2>

            <p>
              اكتب اسم الأداة أو التقنية للوصول إليها بسرعة.
            </p>

          </div>

          <div class="tool-finder reveal">

            <div class="tool-search">

              <i class="fa-solid fa-magnifying-glass"></i>

              <input
                id="tool-search"
                type="search"
                placeholder="ابحث مثلاً: JSON أو QR أو API..."
                autocomplete="off"
                aria-label="البحث عن أداة"
              />

            </div>

            <div
              class="tool-results"
              id="tool-results"
            >

              {
                [...featuredTools, ...remainingTools]
                  .slice(0, 18)
                  .map((tool) => (
                    <a
                      class="tool-result"
                      href={tool.href}
                      data-tool-name={tool.name.toLowerCase()}
                    >

                      <span class="tool-result-icon">

                        <i
                          class={
                            featuredMeta[tool.slug]?.icon ||
                            'fa-solid fa-wand-magic-sparkles'
                          }
                        ></i>

                      </span>

                      <span>

                        <strong>
                          {tool.name}
                        </strong>

                        <small>
                          أداة تقنية
