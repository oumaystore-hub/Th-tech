---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta
    name="description"
    content="Th.Tech — منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والحوسبة السحابية."
  />

  <meta name="theme-color" content="#0b1120" />

  <title>Th.Tech | المنصة التقنية</title>

  <link
    rel="icon"
    type="image/png"
    href="/Th-tech/logo1.png"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!--
    Apply saved theme before rendering.
    This prevents the page from flashing into the wrong theme.
  -->
  <script is:inline>
    (() => {
      try {
        const theme =
          localStorage.getItem('theme') || 'dark';

        document.documentElement.setAttribute(
          'data-theme',
          theme
        );
      } catch {
        document.documentElement.setAttribute(
          'data-theme',
          'dark'
        );
      }
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

      <div class="hero-background">

        <img
          src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920"
          alt="Technology"
          fetchpriority="high"
        />

        <div class="hero-overlay"></div>
        <div class="hero-grid"></div>

        <span class="hero-light light-1"></span>
        <span class="hero-light light-2"></span>
        <span class="hero-light light-3"></span>

      </div>

      <div class="container hero-container">

        <!-- HERO CONTENT -->

        <div class="hero-content reveal">

          <div class="hero-badge">

            <span class="status-dot"></span>

            <i class="fas fa-rocket"></i>

            اكتشف، تعلّم، وابتكر

          </div>


          <h1>

            ابنِ

            <span
              id="typewriter"
              class="gradient-text"
            ></span>

            <span class="cursor">|</span>

          </h1>


          <p class="hero-description">

            منصة تقنية عربية تجمع بين المعرفة والأدوات
            التفاعلية والمحتوى العملي لمساعدتك على تطوير
            مهاراتك الرقمية وبناء مستقبلك التقني.

          </p>


          <div class="hero-actions">

            <a
              href="/Th-tech/playground/"
              class="btn btn-primary"
            >

              <i class="fas fa-terminal"></i>

              ابدأ البرمجة الآن

              <i class="fas fa-arrow-left btn-arrow"></i>

            </a>


            <a
              href="/Th-tech/guides/"
              class="btn btn-secondary"
            >

              <i class="fas fa-book-open"></i>

              تصفح المكتبة

            </a>

          </div>


          <div class="hero-features">

            <div class="hero-feature">

              <span class="feature-icon">
                <i class="fas fa-bolt"></i>
              </span>

              <span>تنفيذ فوري</span>

            </div>


            <div class="hero-feature">

              <span class="feature-icon">
                <i class="fas fa-shield-halved"></i>
              </span>

              <span>آمن 100%</span>

            </div>


            <div class="hero-feature">

              <span class="feature-icon">
                <i class="fas fa-gift"></i>
              </span>

              <span>مجاني تماماً</span>

            </div>

          </div>


          <!-- HERO MINI STATS -->

          <div class="hero-mini">

            <div class="mini-stat">

              <strong>150+</strong>
              <span>دليل تقني</span>

            </div>


            <div class="mini-separator"></div>


            <div class="mini-stat">

              <strong>50K+</strong>
              <span>قارئ شهرياً</span>

            </div>


            <div class="mini-separator"></div>


            <div class="mini-stat">

              <strong>100%</strong>
              <span>مجاني</span>

            </div>

          </div>

        </div>


        <!-- HERO VISUAL -->

        <div class="hero-visual reveal">

          <div class="orbit orbit-a"></div>
          <div class="orbit orbit-b"></div>


          <div class="tech-core">

            <div class="core-inner">

              <strong>TH</strong>

              <span>TECH</span>

            </div>

            <div class="core-ring"></div>

          </div>


          <!-- Python Card -->

          <div class="floating-card python-card">

            <div class="card-heading">

              <div class="card-icon python">
                <i class="fab fa-python"></i>
              </div>

              <div>
                <strong>Python</strong>
                <small>Python 3.11</small>
              </div>

            </div>


            <div class="code-window">

              <div class="code-line">

                <span class="code-blue">print</span>
                <span>(</span>
                <span class="code-green">
                  "مرحباً"
                </span>
                <span>)</span>

              </div>


              <div class="code-comment">
                # Start coding...
              </div>

            </div>

          </div>


          <!-- JS -->

          <div class="floating-card js-card">

            <div class="round-icon js">
              <i class="fab fa-js"></i>
            </div>

            <div>
              <strong>JavaScript</strong>
              <small>Modern Web</small>
            </div>

          </div>


          <!-- Terminal -->

          <div class="floating-card terminal-card">

            <div class="round-icon terminal">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <strong>Terminal</strong>
              <small>Ready to code</small>
            </div>

          </div>


          <!-- Lessons -->

          <div class="floating-card lessons-card">

            <div class="round-icon success">
              <i class="fas fa-check"></i>
            </div>

            <div>
              <strong>+150 درس</strong>
              <small>متاح الآن</small>
            </div>

          </div>


          <!-- Floating nodes -->

          <span class="tech-node node-a">
            <i class="fas fa-code"></i>
          </span>

          <span class="tech-node node-b">
            <i class="fas fa-brain"></i>
          </span>

          <span class="tech-node node-c">
            <i class="fas fa-cloud"></i>
          </span>

        </div>

      </div>


      <div class="scroll-indicator">

        <span>اكتشف المزيد</span>

        <i class="fas fa-chevron-down"></i>

      </div>

    </section>


    <!-- =====================================================
         TECHNOLOGY TICKER
    ====================================================== -->

    <div class="tech-ticker">

      <div class="ticker-mask mask-right"></div>
      <div class="ticker-mask mask-left"></div>

      <div class="ticker-track">

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-halved"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node-js"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>


        <!-- Duplicate -->

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-halved"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node-js"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>

      </div>

    </div>


    <!-- =====================================================
         STATS
    ====================================================== -->

    <section class="stats">

      <div class="container">

        <div class="section-top reveal">

          <div>

            <span class="eyebrow">
              <i class="fas fa-chart-line"></i>
              Th.Tech بالأرقام
            </span>

            <h2>
              المعرفة التقنية
              <span>بشكل أبسط</span>
            </h2>

          </div>

          <p>
            محتوى عملي مصمم ليأخذك من الأساسيات
            إلى مستوى متقدم.
          </p>

        </div>


        <div class="stats-grid">

          <div class="stat-item reveal">

            <div class="stat-icon">
              <i class="fas fa-book-open"></i>
            </div>

            <span
              class="stat-number"
              data-target="150"
              data-suffix="+"
            >
              0
            </span>

            <span class="stat-label">
              دليل شامل
            </span>

          </div>


          <div class="stat-divider"></div>


          <div class="stat-item reveal">

            <div class="stat-icon">
              <i class="fas fa-users"></i>
            </div>

            <span
              class="stat-number"
              data-target="50"
              data-suffix="K+"
            >
              0
            </span>

            <span class="stat-label">
              قارئ شهرياً
            </span>

          </div>


          <div class="stat-divider"></div>


          <div class="stat-item reveal">

            <div class="stat-icon">
              <i class="fas fa-percent"></i>
            </div>

            <span
              class="stat-number"
              data-target="100"
              data-suffix="%"
            >
              0
            </span>

            <span class="stat-label">
              محتوى مجاني
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         LEARNING TRACKS
    ====================================================== -->

    <section class="tracks">

      <div class="container">

        <div class="section-heading reveal">

          <span class="eyebrow">
            <i class="fas fa-layer-group"></i>
            ابدأ رحلتك
          </span>

          <h2>
            مسارات
            <span>التعلم</span>
          </h2>

          <p>
            اختر المجال الذي يناسب أهدافك وابدأ التعلم
            بطريقة عملية ومنظمة.
          </p>

        </div>


        <div class="tracks-grid">


          <!-- AI -->

          <a
            href="/Th-tech/ai/"
            class="track reveal"
          >

            <div class="track-image">

              <img
                src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=700"
                alt="الذكاء الاصطناعي"
                loading="lazy"
              />

              <div class="image-overlay"></div>

              <span class="track-number">
                01
              </span>

            </div>


            <div class="track-body">

              <div class="track-head">

                <div class="track-icon">
                  <i class="fas fa-brain"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>


              <h3>
                الذكاء الاصطناعي
              </h3>

              <p>
                تعلم الآلة والشبكات العصبية
                وتطبيقات الذكاء الاصطناعي الحديثة.
              </p>


              <ul>

                <li>
                  <i class="fas fa-check"></i>
                  Machine Learning
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Deep Learning
                </li>

              </ul>

            </div>

          </a>


          <!-- Programming -->

          <a
            href="/Th-tech/programming/"
            class="track reveal"
          >

            <div class="track-image">

              <img
                src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=700"
                alt="البرمجة"
                loading="lazy"
              />

              <div class="image-overlay"></div>

              <span class="track-number">
                02
              </span>

            </div>


            <div class="track-body">

              <div class="track-head">

                <div class="track-icon">
                  <i class="fas fa-code"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>


              <h3>
                البرمجة
              </h3>

              <p>
                تطوير المواقع والتطبيقات
                وبناء المشاريع البرمجية الحديثة.
              </p>


              <ul>

                <li>
                  <i class="fas fa-check"></i>
                  Full Stack
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  DevOps
                </li>

              </ul>

            </div>

          </a>


          <!-- Security -->

          <a
            href="/Th-tech/security/"
            class="track reveal"
          >

            <div class="track-image">

              <img
                src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=700"
                alt="الأمن السيبراني"
                loading="lazy"
              />

              <div class="image-overlay"></div>

              <span class="track-number">
                03
              </span>

            </div>


            <div class="track-body">

              <div class="track-head">

                <div class="track-icon">
                  <i class="fas fa-lock"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>


              <h3>
                الأمن السيبراني
              </h3>

              <p>
                أساسيات الحماية وأمن المعلومات
                واختبار الاختراق الأخلاقي.
              </p>


              <ul>

                <li>
                  <i class="fas fa-check"></i>
                  Ethical Hacking
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Security
                </li>

              </ul>

            </div>

          </a>


          <!-- Cloud -->

          <a
            href="/Th-tech/cloud/"
            class="track reveal"
          >

            <div class="track-image">

              <img
                src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=700"
                alt="الحوسبة السحابية"
                loading="lazy"
              />

              <div class="image-overlay"></div>

              <span class="track-number">
                04
              </span>

            </div>


            <div class="track-body">

              <div class="track-head">

                <div class="track-icon">
                  <i class="fas fa-cloud"></i>
                </div>

                <span class="track-arrow">
                  <i class="fas fa-arrow-left"></i>
                </span>

              </div>


              <h3>
                السحابة
              </h3>

              <p>
                تعلم AWS وDocker وKubernetes
                وبناء البنية التحتية الحديثة.
              </p>


              <ul>

                <li>
                  <i class="fas fa-check"></i>
                  AWS
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Docker
                </li>

              </ul>

            </div>

          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FEATURES
    ====================================================== -->

    <section class="features">

      <div class="container">

        <div class="section-heading reveal">

          <span class="eyebrow">
            <i class="fas fa-sparkles"></i>
            تجربة مختلفة
          </span>

          <h2>
            لماذا
            <span>Th.Tech؟</span>
          </h2>

          <p>
            أدوات ومحتوى مصممان لجعل التعلم التقني
            أسرع وأسهل وأكثر فعالية.
          </p>

        </div>


        <div class="features-grid">


          <div class="feature-box reveal">

            <span class="feature-number">
              01
            </span>

            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>
              سرعة فائقة
            </h3>

            <p>
              تنفيذ الكود فوراً بدون انتظار
              وتجربة استخدام سلسة.
            </p>

          </div>


          <div class="feature-box reveal">

            <span class="feature-number">
              02
            </span>

            <div class="feature-icon">
              <i class="fas fa-mobile-screen"></i>
            </div>

            <h3>
              متجاوب بالكامل
            </h3>

            <p>
              تجربة محسنة للهاتف واللوحي
              والحاسوب.
            </p>

          </div>


          <div class="feature-box reveal">

            <span class="feature-number">
              03
            </span>

            <div class="feature-icon">
              <i class="fas fa-floppy-disk"></i>
            </div>

            <h3>
              حفظ تلقائي
            </h3>

            <p>
              كودك يحفظ في المتصفح لتتمكن
              من العودة إليه بسهولة.
            </p>

          </div>


          <div class="feature-box reveal">

            <span class="feature-number">
              04
            </span>

            <div class="feature-icon">
              <i class="fas fa-download"></i>
            </div>

            <h3>
              تصدير سهل
            </h3>

            <p>
              احفظ أعمالك وأكوادك
              بصيغ مختلفة بسهولة.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FAQ
    ====================================================== -->

    <section class="faq">

      <div class="container">

        <div class="section-heading reveal">

          <span class="eyebrow">
            <i class="fas fa-circle-question"></i>
            المساعدة
          </span>

          <h2>
            الأسئلة
            <span>الشائعة</span>
          </h2>

          <p>
            إجابات مختصرة على أهم الأسئلة حول المنصة.
          </p>

        </div>


        <div class="faq-grid">


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-user-graduate"></i>
            </div>

            <div>

              <h3>
                هل أحتاج خبرة سابقة؟
              </h3>

              <p>
                لا! نبدأ معك من الأساسيات
                ونساعدك على التقدم خطوة بخطوة.
              </p>

            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>

              <h3>
                كيف أستخدم المحرر؟
              </h3>

              <p>
                اكتب الكود واضغط على "تشغيل"
                لمشاهدة النتيجة مباشرة.
              </p>

            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-floppy-disk"></i>
            </div>

            <div>

              <h3>
                هل يمكنني حفظ أعمالي؟
              </h3>

              <p>
                نعم، يتم حفظ الأكواد في المتصفح
                ويمكنك العودة إليها لاحقاً.
              </p>

            </div>

          </div>


          <div class="faq-item reveal">

            <div class="faq-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>

              <h3>
                ما اللغات المدعومة؟
              </h3>

              <p>
                Python وJavaScript وHTML
                وغيرها من التقنيات التي ستتم إضافتها.
              </p>

            </div>

          </div>


        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- =====================================================
       SCROLL TOP
  ====================================================== -->

  <button
    id="scrollTop"
    class="scroll-top"
    aria-label="العودة إلى الأعلى"
  >

    <i class="fas fa-arrow-up"></i>

  </button>


  <style>

    /* =====================================================
       VARIABLES
    ====================================================== */

    :root {

      --bg: #080d18;
      --bg-2: #0d1424;
      --bg-3: #131d30;

      --card: rgba(20,30,48,.76);

      --text: #f8fafc;
      --muted: #94a3b8;

      --primary: #3b82f6;
      --primary-dark: #2563eb;
      --cyan: #06b6d4;

      --border: rgba(148,163,184,.13);

      --shadow:
        0 25px 70px rgba(0,0,0,.28);

      --glow:
        rgba(59,130,246,.22);
    }


    [data-theme="light"] {

      --bg: #ffffff;
      --bg-2: #f8fafc;
      --bg-3: #f1f5f9;

      --card: rgba(255,255,255,.92);

      --text: #0f172a;
      --muted: #64748b;

      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --cyan: #0891b2;

      --border: rgba(15,23,42,.09);

      --shadow:
        0 25px 70px rgba(15,23,42,.09);

      --glow:
        rgba(37,99,235,.12);
    }


    /* =====================================================
       RESET
    ====================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }


    body {

      background: var(--bg);

      color: var(--text);

      font-family: 'Cairo', sans-serif;

      line-height: 1.7;

      overflow-x: hidden;

      transition:
        background-color .35s ease,
        color .35s ease;
    }


    img {
      display: block;
    }


    a {
      color: inherit;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    .container {

      width: 100%;

      max-width: 1220px;

      margin: auto;

      padding:
        0 1.5rem;
    }


    section {
      position: relative;

      padding:
        5.5rem 0;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .hero {

      min-height:
        100vh;

      display:
        flex;

      align-items:
        center;

      position:
        relative;

      padding:
        130px 0 100px;

      overflow:
        hidden;
    }


    .hero-background {

      position:
        absolute;

      inset:
        0;

      z-index:
        -10;

      overflow:
        hidden;
    }


    .hero-background img {

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

      filter:
        brightness(.25)
        saturate(.75);

      transform:
        scale(1.04);
    }


    .hero-overlay {

      position:
        absolute;

      inset:
        0;

      background:
        linear-gradient(
          180deg,
          rgba(8,13,24,.58),
          rgba(8,13,24,.78) 48%,
          var(--bg) 100%
        );
    }


    .hero-grid {

      position:
        absolute;

      inset:
        0;

      opacity:
        .13;

      background-image:
        linear-gradient(
          rgba(59,130,246,.22) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(59,130,246,.22) 1px,
          transparent 1px
        );

      background-size:
        55px 55px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 85%
        );

      animation:
        gridAnimation 20s linear infinite;
    }


    @keyframes gridAnimation {

      to {
        transform:
          translateY(55px);
      }

    }


    .hero-light {

      position:
        absolute;

      width:
        450px;

      height:
        450px;

      border-radius:
        50%;

      filter:
        blur(100px);

      opacity:
        .18;

      pointer-events:
        none;
    }


    .light-1 {

      background:
        #2563eb;

      top:
        -180px;

      right:
        -120px;
    }


    .light-2 {

      background:
        #06b6d4;

      bottom:
        -260px;

      left:
        -150px;
    }


    .light-3 {

      background:
        #6366f1;

      top:
        35%;

      left:
        35%;

      opacity:
        .08;
    }


    .hero-container {

      width:
        100%;

      display:
        grid;

      grid-template-columns:
        1.05fr .95fr;

      gap:
        4rem;

      align-items:
        center;
    }


    /* =====================================================
       HERO CONTENT
    ====================================================== */

    .hero-content {
      position:
        relative;

      z-index:
        2;
    }


    .hero-badge {

      width:
        fit-content;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        .55rem;

      padding:
        .55rem 1rem;

      margin-bottom:
        1.4rem;

      border:
        1px solid
        rgba(96,165,250,.20);

      border-radius:
        999px;

      background:
        rgba(59,130,246,.08);

      color:
        #60a5fa;

      font-size:
        .82rem;

      font-weight:
        800;

      backdrop-filter:
        blur(12px);
    }


    .status-dot {

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        #22c55e;

      box-shadow:
        0 0 0 5px
        rgba(34,197,94,.09);
    }


    h1 {

      max-width:
        760px;

      margin-bottom:
        1.4rem;

      font-size:
        clamp(2.2rem,5vw,4rem);

      line-height:
        1.25;

      letter-spacing:
        -.035em;

      font-weight:
        800;
    }


    .gradient-text {

      background:
        linear-gradient(
          120deg,
          #60a5fa,
          #3b82f6,
          #22d3ee
        );

      -webkit-background-clip:
        text;

      background-clip:
        text;

      -webkit-text-fill-color:
        transparent;

      color:
        transparent;
    }


    .cursor {

      color:
        var(--primary);

      animation:
        cursorBlink 1s infinite;
    }


    @keyframes cursorBlink {

      50% {
        opacity:
          0;
      }

    }


    .hero-description {

      max-width:
        650px;

      margin-bottom:
        2rem;

      color:
        rgba(226,232,240,.72);

      font-size:
        1.05rem;

      line-height:
        2;
    }


    [data-theme="light"]
    .hero-description {

      color:
        #64748b;
    }


    /* =====================================================
       BUTTONS
    ====================================================== */

    .hero-actions {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        .85rem;

      margin-bottom:
        1.8rem;
    }


    .btn {

      min-height:
        54px;

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        .55rem;

      padding:
        .85rem 1.3rem;

      border-radius:
        13px;

      text-decoration:
        none;

      font-size:
        .9rem;

      font-weight:
        800;

      transition:
        all .3s ease;
    }


    .btn-primary {

      color:
        white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-dark)
        );

      box-shadow:
        0 14px 35px
        rgba(37,99,235,.28);
    }


    .btn-primary:hover {

      transform:
        translateY(-3px);

      box-shadow:
        0 18px 45px
        rgba(37,99,235,.4);
    }


    .btn-arrow {

      font-size:
        .7rem;

      transition:
        transform .3s ease;
    }


    .btn-primary:hover
    .btn-arrow {

      transform:
        translateX(-4px);
    }


    .btn-secondary {

      color:
        var(--text);

      border:
        1px solid
        rgba(148,163,184,.20);

      background:
        rgba(255,255,255,.045);

      backdrop-filter:
        blur(12px);
    }


    .btn-secondary:hover {

      color:
        var(--primary);

      border-color:
        rgba(59,130,246,.45);

      background:
        rgba(59,130,246,.07);

      transform:
        translateY(-3px);
    }


    /* =====================================================
       HERO FEATURES
    ====================================================== */

    .hero-features {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        1.25rem;
    }


    .hero-feature {

      display:
        flex;

      align-items:
        center;

      gap:
        .5rem;

      color:
        rgba(226,232,240,.68);

      font-size:
        .82rem;
    }


    [data-theme="light"]
    .hero-feature {

      color:
        #64748b;
    }


    .feature-icon {

      width:
        28px;

      height:
        28px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        8px;

      color:
        #60a5fa;

      background:
        rgba(59,130,246,.10);

      border:
        1px solid
        rgba(59,130,246,.14);

      font-size:
        .7rem;
    }


    /* =====================================================
       HERO MINI STATS
    ====================================================== */

    .hero-mini {

      width:
        fit-content;

      display:
        flex;

      align-items:
        center;

      gap:
        1.2rem;

      margin-top:
        2rem;

      padding:
        .75rem 1rem;

      border:
        1px solid
        rgba(148,163,184,.12);

      border-radius:
        14px;

      background:
        rgba(15,23,42,.42);

      backdrop-filter:
        blur(16px);
    }


    .mini-stat {

      display:
        flex;

      flex-direction:
        column;
    }


    .mini-stat strong {

      color:
        #e2e8f0;

      font-size:
        .95rem;
    }


    .mini-stat span {

      color:
        #64748b;

      font-size:
        .65rem;
    }


    .mini-separator {

      width:
        1px;

      height:
        28px;

      background:
        rgba(148,163,184,.18);
    }


    /* =====================================================
       HERO VISUAL
    ====================================================== */

    .hero-visual {

      position:
        relative;

      height:
        550px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;
    }


    .tech-core {

      position:
        relative;

      width:
        170px;

      height:
        170px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      z-index:
        2;
    }


    .core-inner {

      width:
        105px;

      height:
        105px;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        28px;

      border:
        1px solid
        rgba(96,165,250,.3);

      background:
        linear-gradient(
          145deg,
          rgba(59,130,246,.18),
          rgba(6,182,212,.06)
        );

      box-shadow:
        0 0 55px
        rgba(59,130,246,.20),

        inset 0 0 30px
        rgba(59,130,246,.07);

      backdrop-filter:
        blur(16px);
    }


    .core-inner strong {

      font-size:
        2rem;

      line-height:
        1;

      background:
        linear-gradient(
          135deg,
          #60a5fa,
          #22d3ee
        );

      -webkit-background-clip:
        text;

      -webkit-text-fill-color:
        transparent;
    }


    .core-inner span {

      margin-top:
        .3rem;

      color:
        #94a3b8;

      font-size:
        .55rem;

      letter-spacing:
        .25em;
    }


    .core-ring {

      position:
        absolute;

      inset:
        -20px;

      border:
        1px solid
        rgba(59,130,246,.15);

      border-radius:
        50%;

      animation:
        rotateRing 16s linear infinite;
    }


    .core-ring::before {

      content:
        '';

      position:
        absolute;

      top:
        9px;

      left:
        50%;

      width:
        8px;

      height:
        8px;

      border-radius:
        50%;

      background:
        #60a5fa;

      box-shadow:
        0 0 20px
        #3b82f6;
    }


    @keyframes rotateRing {

      to {
        transform:
          rotate(360deg);
      }

    }


    .orbit {

      position:
        absolute;

      border:
        1px dashed
        rgba(59,130,246,.13);

      border-radius:
        50%;
    }


    .orbit-a {

      width:
        350px;

      height:
        350px;

      animation:
        rotateRing 24s linear infinite;
    }


    .orbit-b {

      width:
        480px;

      height:
        480px;

      animation:
        rotateRing 35s linear infinite reverse;
    }


    /* =====================================================
       FLOATING CARDS
    ====================================================== */

    .floating-card {

      position:
        absolute;

      z-index:
        4;

      display:
        flex;

      align-items:
        center;

      gap:
        .7rem;

      padding:
        1rem;

      border:
        1px solid
        rgba(148,163,184,.15);

      border-radius:
        15px;

      color:
        #e2e8f0;

      background:
        rgba(15,23,42,.70);

      box-shadow:
        0 20px 55px
        rgba(0,0,0,.25);

      backdrop-filter:
        blur(18px);

      transition:
        border-color .3s ease,
        transform .3s ease;

      animation:
        floating 6s ease-in-out infinite;
    }


    .floating-card:hover {

      border-color:
        rgba(96,165,250,.38);

      transform:
        translateY(-7px);
    }


    .python-card {

      top:
        45px;

      left:
        0;

      width:
        235px;

      flex-direction:
        column;

      align-items:
        stretch;
    }


    .js-card {

      top:
        150px;

      right:
        0;

      animation-delay:
        1.2s;
    }


    .terminal-card {

      bottom:
        140px;

      left:
        5px;

      animation-delay:
        2.4s;
    }


    .lessons-card {

      bottom:
        40px;

      right:
        65px;

      animation-delay:
        3.7s;
    }


    @keyframes floating {

      0%,
      100% {
        transform:
          translateY(0);
      }

      50% {
        transform:
          translateY(-13px);
      }

    }


    .card-heading {

      display:
        flex;

      align-items:
        center;

      gap:
        .7rem;
    }


    .card-icon {

      width:
        42px;

      height:
        42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      font-size:
        1.45rem;
    }


    .python {

      color:
        #60a5fa;

      background:
        rgba(59,130,246,.10);
    }


    .card-heading strong {

      display:
        block;

      font-size:
        .85rem;
    }


    .card-heading small,
    .floating-card small {

      display:
        block;

      color:
        #64748b;

      font-size:
        .62rem;
    }


    .code-window {

      margin-top:
        .7rem;

      padding:
        .7rem;

      direction:
        ltr;

      text-align:
        left;

      font-family:
        monospace;

      font-size:
        .78rem;

      border:
        1px solid
        rgba(148,163,184,.08);

      border-radius:
        9px;

      background:
        rgba(2,6,23,.48);
    }


    .code-blue {
      color:
        #60a5fa;
    }


    .code-green {
      color:
        #34d399;
    }


    .code-comment {

      margin-top:
        .25rem;

      color:
        #64748b;
    }


    .round-icon {

      width:
        40px;

      height:
        40px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      font-size:
        1.2rem;
    }


    .round-icon.js {

      color:
        #facc15;

      background:
        rgba(250,204,21,.09);
    }


    .round-icon.terminal {

      color:
        #22d3ee;

      background:
        rgba(6,182,212,.09);
    }


    .round-icon.success {

      color:
        #4ade80;

      background:
        rgba(34,197,94,.09);
    }


    .tech-node {

      position:
        absolute;

      width:
        38px;

      height:
        38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      color:
        #60a5fa;

      background:
        rgba(15,23,42,.65);

      border:
        1px solid
        rgba(59,130,246,.16);

      backdrop-filter:
        blur(12px);

      animation:
        nodeFloat 5s ease-in-out infinite;
    }


    .node-a {

      top:
        25px;

      right:
        35%;

      animation-delay:
        1s;
    }


    .node-b {

      bottom:
        75px;

      right:
        24%;

      animation-delay:
        2s;
    }


    .node-c {

      top:
        42%;

      left:
        7%;

      animation-delay:
        3s;
    }


    @keyframes nodeFloat {

      50% {
        transform:
          translateY(-10px)
          rotate(5deg);
      }

    }


    /* =====================================================
       SCROLL INDICATOR
    ====================================================== */

    .scroll-indicator {

      position:
        absolute;

      bottom:
        25px;

      left:
        50%;

      transform:
        translateX(-50%);

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      gap:
        .2rem;

      color:
        #64748b;

      font-size:
        .62rem;
    }


    .scroll-indicator i {

      color:
        #3b82f6;

      animation:
        scrollDown 1.6s infinite;
    }


    @keyframes scrollDown {

      50% {
        transform:
          translateY(5px);
      }

    }


    /* =====================================================
       TICKER
    ====================================================== */

    .tech-ticker {

      position:
        relative;

      overflow:
        hidden;

      padding:
        1rem 0;

      background:
        var(--bg-2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);
    }


    .ticker-track {

      width:
        max-content;

      display:
        flex;

      gap:
        3.2rem;

      animation:
        tickerAnimation 35s linear infinite;
    }


    .tech-item {

      display:
        flex;

      align-items:
        center;

      gap:
        .5rem;

      white-space:
        nowrap;

      color:
        var(--muted);

      font-size:
        .84rem;

      font-weight:
        700;
    }


    .tech-item i {
      color:
        var(--primary);

      font-size:
        1rem;
    }


    @keyframes tickerAnimation {

      to {
        transform:
          translateX(-50%);
      }

    }


    .ticker-mask {

      position:
        absolute;

      top:
        0;

      bottom:
        0;

      width:
        100px;

      z-index:
        3;

      pointer-events:
        none;
    }


    .mask-right {

      right:
        0;

      background:
        linear-gradient(
          to left,
          var(--bg-2),
          transparent
        );
    }


    .mask-left {

      left:
        0;

      background:
        linear-gradient(
          to right,
          var(--bg-2),
          transparent
        );
    }


    /* =====================================================
       SECTION HEADING
    ====================================================== */

    .section-heading {

      max-width:
        700px;

      margin:
        0 auto 3.5rem;

      text-align:
        center;
    }


    .eyebrow {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        .45rem;

      margin-bottom:
        .65rem;

      color:
        var(--primary);

      font-size:
        .76rem;

      font-weight:
        800;
    }


    .section-heading h2,
    .section-top h2 {

      margin-bottom:
        .7rem;

      font-size:
        clamp(1.7rem,4vw,2.3rem);

      line-height:
        1.4;

      font-weight:
        800;
    }


    .section-heading h2 span,
    .section-top h2 span {

      color:
        var(--primary);
    }


    .section-heading p,
    .section-top p {

      color:
        var(--muted);

      font-size:
        .9rem;

      line-height:
        1.9;
    }


    /* =====================================================
       STATS
    ====================================================== */

    .stats {

      background:
        var(--bg-2);

      border-bottom:
        1px solid
        var(--border);
    }


    .section-top {

      display:
        flex;

      align-items:
        end;

      justify-content:
        space-between;

      gap:
        2rem;

      margin-bottom:
        2.8rem;

      padding-bottom:
        1rem;

      border-bottom:
        1px solid
        var(--border);
    }


    .section-top h2 {
      margin-bottom:
        0;
    }


    .section-top p {

      max-width:
        400px;

      text-align:
        left;
    }


    .stats-grid {

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        4rem;

      flex-wrap:
        wrap;
    }


    .stat-item {

      min-width:
        170px;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      text-align:
        center;
    }


    .stat-icon {

      width:
        50px;

      height:
        50px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        .75rem;

      border:
        1px solid
        rgba(59,130,246,.14);

      border-radius:
        13px;

      color:
        var(--primary);

      background:
        rgba(59,130,246,.08);
    }


    .stat-number {

      display:
        block;

      color:
        var(--primary);

      font-size:
        2.6rem;

      line-height:
        1;

      font-weight:
        800;
    }


    .stat-label {

      margin-top:
        .5rem;

      color:
        var(--muted);

      font-size:
        .78rem;
    }


    .stat-divider {

      width:
        1px;

      height:
        70px;

      background:
        var(--border);
    }


    /* =====================================================
       TRACKS
    ====================================================== */

    .tracks {

      background:
        var(--bg);
    }


    .tracks-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4,1fr);

      gap:
        1.25rem;
    }


    .track {

      overflow:
        hidden;

      display:
        flex;

      flex-direction:
        column;

      border:
        1px solid
        var(--border);

      border-radius:
        18px;

      background:
        var(--card);

      color:
        var(--text);

      text-decoration:
        none;

      box-shadow:
        0 10px 35px
        rgba(0,0,0,.05);

      transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
    }


    .track:hover {

      transform:
        translateY(-8px);

      border-color:
        rgba(59,130,246,.38);

      box-shadow:
        0 25px 60px
        var(--glow);
    }


    .track-image {

      position:
        relative;

      height:
        185px;

      overflow:
        hidden;
    }


    .track-image img {

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

      transition:
        transform .6s ease;
    }


    .track:hover
    .track-image img {

      transform:
        scale(1.08);
    }


    .image-overlay {

      position:
        absolute;

      inset:
        0;

      background:
        linear-gradient(
          to top,
          rgba(2,6,23,.72),
          transparent 65%
        );
    }


    .track-number {

      position:
        absolute;

      top:
        14px;

      right:
        14px;

      padding:
        .25rem .5rem;

      border:
        1px solid
        rgba(255,255,255,.12);

      border-radius:
        7px;

      color:
        white;

      background:
        rgba(2,6,23,.42);

      font-size:
        .65rem;

      font-weight:
        800;

      backdrop-filter:
        blur(8px);
    }


    .track-body {

      flex:
        1;

      display:
