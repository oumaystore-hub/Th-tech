---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO & Verification -->
  <title>Th.Tech | رواد المستقبل الرقمي</title>
  <meta name="description" content="منصة Th.Tech الرائدة في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني. محتوى تقني معمق يواكب أحدث الابتكارات العالمية." />
  <meta name="keywords" content="ذكاء اصطناعي, برمجة, أمن سيبراني, حوسبة سحابية, تعلم آلي, علوم بيانات, تقنية" />
  <meta name="author" content="Th-Tech Team" />
  <meta name="robots" content="index, follow" />
  <meta name="google-site-verification" content="GOxRhy_xfCo492sszjG7fICciSBqL6zPhI1e_B64KsI" />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <!-- Open Graph & Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://oumaystore-hub.github.io/Th-tech/" />
  <meta property="og:title" content="Th.Tech | رواد المستقبل الرقمي" />
  <meta property="og:description" content="منصة متخصصة في الذكاء الاصطناعي والتكنولوجيا الحديثة. محتوى تقني معمق وشروحات عملية." />
  <meta property="og:image" content="https://oumaystore-hub.github.io/Th-tech/logo1.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Th.Tech | رواد المستقبل الرقمي" />
  <meta name="twitter:description" content="منصة متخصصة في الذكاء الاصطناعي والتكنولوجيا الحديثة" />
  <meta name="twitter:image" content="https://oumaystore-hub.github.io/Th-tech/logo1.png" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section مع تأثير الكتابة -->
    <section class="hero section-anim reveal">
      <div class="hero-bg"></div>
      <div class="container hero-content">
        <span class="hero-badge reveal reveal-delay-1">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          نحو مستقبل رقمي مُلهِم
        </span>
        
        <!-- العنوان مع تأثير الكتابة -->
        <h1 class="reveal reveal-delay-2">
          <span class="typing-text">اكتشف آفاق الذكاء الاصطناعي والابتكار التقني</span>
        </h1>
        
        <p class="hero-desc reveal reveal-delay-3">
          منصة عربية رائدة تُقدّم محتوى تقنياً معمقاً في مجالات الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني — مصممة لتمكين المطورين والمبتكرين من بناء الغد.
        </p>
        
        <div class="hero-buttons reveal reveal-delay-4">
          <a href="/Th-tech/category/" class="btn btn-primary btn-animate">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            استكشف التصنيفات
          </a>
          <a href="/Th-tech/articles/" class="btn btn-outline btn-animate">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            تصفح المكتبة
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 قسم الإحصائيات مع العداد المتحرك -->
    <section class="stats section-anim reveal">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item reveal reveal-delay-1">
            <span class="counter" data-target="150" data-suffix="+">0</span>
            <span class="counter-label">مقال تقني مُعتمد</span>
          </div>
          <div class="stat-item reveal reveal-delay-2">
            <span class="counter" data-target="50" data-suffix="K+">0</span>
            <span class="counter-label">قارئ شهرياً</span>
          </div>
          <div class="stat-item reveal reveal-delay-3">
            <span class="counter" data-target="16" data-suffix="+">0</span>
            <span class="counter-label">دليل شامل</span>
          </div>
          <div class="stat-item reveal reveal-delay-4">
            <span class="counter" data-target="100" data-suffix="%">0</span>
            <span class="counter-label">محتوى مجاني بالكامل</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Features Section -->
    <section class="features section-anim">
      <div class="container">
        <div class="section-header reveal">
          <h2>لماذا <span class="highlight">Th.Tech</span>؟</h2>
          <p>نجمع بين الدقة التقنية وسلاسة العرض لنقدّم لك تجربة تعلم استثنائية</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-card card-hover reveal reveal-delay-1">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3>ذكاء اصطناعي مُتقدِّم</h3>
            <p>نواكب أحدث نماذج الـ LLMs وتقنيات التعلم الآلي، مع شروحات تطبيقية تُحوّل النظرية إلى ممارسة.</p>
          </div>
          
          <div class="feature-card card-hover reveal reveal-delay-2">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h3>أمن سيبراني موثوق</h3>
            <p>استراتيجيات حماية استباقية، وتحليلات للاختراق الأخلاقي، وأدوات دفاعية مُحدّثة لمواجهة التهديدات الرقمية.</p>
          </div>
          
          <div class="feature-card card-hover reveal reveal-delay-3">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
            </div>
            <h3>هندسة برمجيات احترافية</h3>
            <p>من أساسيات الخوارزميات إلى بناء أنظمة معقّدة باستخدام أحدث الأطر (Frameworks) وممارسات DevOps.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Highlights Section مع صور مصغرة -->
    <section class="highlights section-anim">
      <div class="container">
        <div class="section-header reveal">
          <h2>مسارات التعلُّم الرائدة</h2>
          <p>اختر مجال اهتمامك وابدأ رحلتك الاحترافية مع محتوى مُحدَّث أسبوعياً</p>
        </div>

        <div class="highlights-grid">
          <a href="/Th-tech/ai/" class="topic-card card-hover reveal reveal-delay-1">
            <div class="topic-image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
            </div>
            <div class="topic-content">
              <h3>تعلم الآلة والـ AI</h3>
              <p class="topic-desc">نماذج اللغة، الشبكات العصبية، وتطبيقات الذكاء الاصطناعي العملي</p>
              <span class="read-more link-underline">ابدأ المسار ←</span>
            </div>
          </a>
          
          <a href="/Th-tech/blockchain/" class="topic-card card-hover reveal reveal-delay-2">
            <div class="topic-image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </div>
            <div class="topic-content">
              <h3>البلوك تشين والعقود الذكية</h3>
              <p class="topic-desc">تقنيات اللامركزية، العملات الرقمية، وتطوير dApps</p>
              <span class="read-more link-underline">ابدأ المسار ←</span>
            </div>
          </a>
          
          <a href="/Th-tech/data-science/" class="topic-card card-hover reveal reveal-delay-3">
            <div class="topic-image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
            </div>
            <div class="topic-content">
              <h3>علوم البيانات والتحليلات</h3>
              <p class="topic-desc">معالجة البيانات الضخمة، التصور البياني، واتخاذ القرارات المعتمدة على البيانات</p>
              <span class="read-more link-underline">ابدأ المسار ←</span>
            </div>
          </a>
          
          <a href="/Th-tech/cloud/" class="topic-card card-hover reveal reveal-delay-4">
            <div class="topic-image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
            </div>
            <div class="topic-content">
              <h3>الحوسبة السحابية والبنية التحتية</h3>
              <p class="topic-desc">AWS، Azure، وGoogle Cloud — نشر وإدارة التطبيقات على السحابة</p>
              <span class="read-more link-underline">ابدأ المسار ←</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA Section -->
    <section class="cta section-anim reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-icon reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 class="reveal">🚀 هل أنت مستعد لصناعة الفرق الرقمي؟</h2>
          <p class="reveal reveal-delay-1">انضم إلى مجتمع Th.Tech المكوّن من آلاف المطورين، المهندسين، والمبتكرين الذين يبنون مستقبل التكنولوجيا اليوم.</p>
          <a href="/Th-tech/category/" class="btn btn-light btn-animate reveal reveal-delay-2">
            ابدأ رحلتك الآن
            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --accent: #0ea5e9;
    --border: rgba(2,132,199,0.15);
    --shadow: 0 4px 20px rgba(0,0,0,0.05);
    --radius: 16px;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --primary-dark: #0284c7;
    --accent: #7dd3fc;
    --border: rgba(56,189,248,0.15);
    --shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }
  
  .main-wrapper { overflow-x: hidden; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .highlight { color: var(--primary); font-weight: 700; }
  .section-header { text-align: center; margin-bottom: 2.5rem; }
  .section-header h2 { font-size: clamp(1.8rem, 4vw, 2.2rem); margin-bottom: 0.5rem; }
  .section-header p { color: var(--text-sec); font-size: 1.05rem; }

  /* Animations */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .section-anim {
    opacity: 0;
    animation: fadeUp 0.7s ease-out forwards;
  }
  .section-anim:nth-child(1) { animation-delay: 0.1s; }
  .section-anim:nth-child(2) { animation-delay: 0.2s; }
  .section-anim:nth-child(3) { animation-delay: 0.3s; }
  .section-anim:nth-child(4) { animation-delay: 0.4s; }

  /* Hero */
  .hero {
    position: relative;
    padding: 4rem 0 3rem;
    text-align: center;
    background: var(--bg);
  }
  .hero-bg {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 50% 30%, rgba(2,132,199,0.08) 0%, transparent 60%);
    z-index: 0;
  }
  .hero-content { position: relative; z-index: 1; }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary);
    color: white;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
    box-shadow: 0 4px 15px rgba(2,132,199,0.25);
    animation: pulse 3s infinite;
  }
  .badge-icon { width: 16px; height: 16px; }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }
  
  .hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.25;
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .typing-text {
    border-right: 3px solid var(--primary);
    white-space: nowrap;
    overflow: hidden;
    animation: typing 3.5s steps(35, end), blink-caret 0.75s step-end infinite;
    max-width: fit-content;
    margin: 0 auto;
  }
  
  @keyframes typing {
    from { width: 0; }
    to { width: 100%; }
  }
  
  @keyframes blink-caret {
    from, to { border-color: transparent; }
    50% { border-color: var(--primary); }
  }
  
  @media (max-width: 768px) {
    .typing-text {
      animation: none;
      border-right: none;
      white-space: normal;
      width: auto;
    }
  }
  
  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-sec);
    max-width: 700px;
    margin: 0 auto 2rem;
  }
  
  .hero-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.85rem 1.8rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .btn-icon { width: 18px; height: 18px; }
  .btn-arrow { width: 16px; height: 16px; transition: transform 0.3s; }
  .btn:hover .btn-arrow { transform: translateX(4px); }
  
  .btn-primary {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 15px rgba(2,132,199,0.25);
  }
  .btn-primary:hover { transform: translateY(-3px); background: var(--primary-dark); }
  
  .btn-outline {
    background: transparent;
    border: 2px solid var(--border);
    color: var(--text);
  }
  .btn-outline:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-3px); }
  
  .btn-light {
    background: white;
    color: var(--primary);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .btn-light:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }

  /* Stats */
  .stats {
    padding: 2.5rem 0;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  .stat-item { padding: 1rem; }
  .counter {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--primary);
    display: block;
    line-height: 1;
  }
  .counter-label {
    font-size: 0.9rem;
    color: var(--text-sec);
    margin-top: 0.4rem;
    display: block;
  }
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .counter { font-size: 1.8rem; }
  }

  /* Features */
  .features { padding: 3rem 0; background: var(--bg); }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .feature-card {
    background: var(--card);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid var(--border);
    transition: all 0.35s;
  }
  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: var(--primary);
  }
  .icon-box {
    width: 60px;
    height: 60px;
    margin: 0 auto 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(2,132,199,0.1), rgba(14,165,233,0.1));
    border-radius: 16px;
    color: var(--primary);
  }
  .icon-box svg { width: 32px; height: 32px; }
  .feature-card h3 { font-size: 1.25rem; margin-bottom: 0.8rem; }
  .feature-card p { color: var(--text-sec); font-size: 0.95rem; line-height: 1.6; }

  /* Highlights */
  .highlights { padding: 3rem 0; background: var(--card); }
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  .topic-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    text-decoration: none;
    transition: all 0.3s;
  }
  .topic-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.06);
  }
  .topic-image {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(2,132,199,0.15), rgba(14,165,233,0.15));
    border-radius: 12px;
    color: var(--primary);
  }
  .topic-image svg { width: 26px; height: 26px; }
  .topic-content h3 { font-size: 1.1rem; margin: 0 0 0.4rem; }
  .topic-desc {
    font-size: 0.9rem;
    color: var(--text-sec);
    margin-bottom: 0.8rem;
    line-height: 1.5;
  }
  .read-more { color: var(--primary); font-weight: 600; font-size: 0.85rem; }
  
  @media (max-width: 768px) {
    .highlights-grid { grid-template-columns: 1fr; }
  }

  /* CTA */
  .cta { padding: 2.5rem 1.5rem 3rem; }
  .cta-box {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-box::before {
    content: ''; position: absolute; top: -40%; right: -15%; width: 300px; height: 300px;
    background: rgba(255,255,255,0.1); border-radius: 50%;
  }
  .cta-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.15);
    border-radius: 50%;
    color: white;
  }
  .cta-icon svg { width: 36px; height: 36px; }
  .cta-box h2 { font-size: 1.8rem; margin-bottom: 0.8rem; position: relative; z-index: 1; }
  .cta-box p { font-size: 1rem; margin-bottom: 1.5rem; opacity: 0.95; position: relative; z-index: 1; }
  .btn-light {
    background: white;
    color: var(--primary);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .btn-light:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }

  /* Responsive */
  @media (max-width: 768px) {
    .hero { padding: 3rem 0 2.5rem; }
    .features, .highlights { padding: 2.5rem 0; }
    .cta-box { padding: 2.5rem 1.5rem; }
    .section-header { margin-bottom: 2rem; }
  }
</style>

<script>
  // ========================================
  // تأثير الكتابة (Typing Effect)
  // ========================================
  function initTypingEffect() {
    const typingElements = document.querySelectorAll('.typing-text');
    
    typingElements.forEach((element) => {
      const originalText = element.textContent;
      element.textContent = '';
      element.style.animation = 'none';
      
      let i = 0;
      const typeWriter = () => {
        if (i < originalText.length) {
          element.textContent += originalText.charAt(i);
          i++;
          setTimeout(typeWriter, 50);
        } else {
          element.style.borderRight = 'none';
        }
      };
      
      setTimeout(typeWriter, 500);
    });
  }

  // ========================================
  // تأثير العداد (Counter Animation)
  // ========================================
  function initCounterAnimation() {
    const counters = document.querySelectorAll('.counter');
    
    const animateCounter = (element, target, duration = 2000) => {
      let start = 0;
      const increment = target / (duration / 16);
      
      const updateCounter = () => {
        start += increment;
        if (start < target) {
          element.textContent = Math.floor(start) + (element.dataset.suffix || '');
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = target + (element.dataset.suffix || '');
        }
      };
      
      updateCounter();
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = parseInt(entry.target.dataset.target);
          animateCounter(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    
    counters.forEach(counter => {
      if (counter.dataset.target) {
        observer.observe(counter);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initTypingEffect();
    initCounterAnimation();
  });
</script>
