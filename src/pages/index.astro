---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const playgroundHref = `${base}/playground`;

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((key) => {
    const match = key.match(/\.\/tools\/([^/]+)\/index\.astro$/);
    return match ? match[1] : null;
  })
  .filter(Boolean);

const displayName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const featuredSlugs = [
  'json-formatter',
  'base64-encoder-decoder',
  'jwt-decoder',
  'qr-code-generator',
  'url-encoder-decoder',
  'regex-tester',
  'color-picker',
  'api-request-builder'
];

const featuredTools = featuredSlugs
  .filter((slug) => toolSlugs.includes(slug))
  .map((slug) => ({
    slug,
    name: displayName(slug)
  }));

const fallbackTools = toolSlugs
  .filter((slug) => !featuredSlugs.includes(slug))
  .slice(0, 8)
  .map((slug) => ({
    slug,
    name: displayName(slug)
  }));

const toolsToShow =
  featuredTools.length >= 4 ? featuredTools : fallbackTools;

const categories = [
  {
    icon: '⌘',
    title: 'المطورون',
    text: 'أدوات API و JSON و Regex و SQL والمزيد.',
    tag: 'Developer'
  },
  {
    icon: '{}',
    title: 'البيانات',
    text: 'تنسيق وتحويل وفحص البيانات بسرعة.',
    tag: 'Data'
  },
  {
    icon: '◉',
    title: 'الصور والألوان',
    text: 'أدوات الألوان والصور والرموز البصرية.',
    tag: 'Design'
  },
  {
    icon: '↗',
    title: 'النصوص والروابط',
    text: 'ترميز النصوص والروابط وتحليلها بسهولة.',
    tag: 'Utility'
  }
];

const faqs = [
  {
    q: 'هل أدوات Th.Tech مجانية؟',
    a: 'نعم، أدوات Th.Tech مصممة لتكون مجانية وسهلة الاستخدام مباشرة من المتصفح.'
  },
  {
    q: 'هل يتم إرسال بياناتي إلى خادم؟',
    a: 'الكثير من الأدوات تعمل مباشرة داخل المتصفح، لذلك يمكنك استخدامها دون الحاجة إلى رفع البيانات إلى خادم.'
  },
  {
    q: 'هل أحتاج إلى تثبيت برنامج؟',
    a: 'لا. يمكنك استخدام الأدوات مباشرة من المتصفح دون تثبيت برامج إضافية.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description:
    'Th.Tech منصة عربية تضم أدوات مجانية للمطورين والمصممين والمستخدمين.',
  inLanguage: 'ar'
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Th.Tech - أدوات تقنية مجانية للمطورين والمبدعين</title>

    <meta
      name="description"
      content="Th.Tech منصة تقنية عربية تضم أكثر من 100 أداة مجانية للمطورين والمصممين والمستخدمين، تعمل مباشرة من المتصفح."
    />

    <meta
      name="keywords"
      content="أدوات تقنية, أدوات للمطورين, JSON, API, Regex, Base64, QR Code, SQL, أدوات مجانية"
    />

    <link rel="canonical" href={`${siteUrl}${base}/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: 'Cairo', sans-serif;
        background: #f8fafc;
        color: #0f172a;
        overflow-x: hidden;
      }

      :global(html.dark-mode body) {
        background: #070b14;
        color: #f8fafc;
      }

      .page {
        min-height: 100vh;
      }

      /* =========================================
         HERO
      ========================================= */

      .hero {
        position: relative;
        min-height: 680px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        isolation: isolate;
        padding: 70px 20px 90px;
      }

      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: -3;
        background:
          radial-gradient(circle at 50% 30%, rgba(14, 165, 233, 0.13), transparent 30%),
          radial-gradient(circle at 15% 70%, rgba(99, 102, 241, 0.08), transparent 25%),
          radial-gradient(circle at 85% 70%, rgba(6, 182, 212, 0.08), transparent 25%);
      }

      .grid-bg {
        position: absolute;
        inset: 0;
        z-index: -2;
        opacity: 0.42;
        background-image:
          linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: linear-gradient(to bottom, black, transparent 85%);
      }

      :global(html.dark-mode) .grid-bg {
        opacity: 0.16;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      }

      .hero-content {
        width: min(1100px, 100%);
        text-align: center;
      }

      .logo-stage {
        position: relative;
        width: 190px;
        height: 190px;
        margin: 0 auto 34px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .logo-ring {
        position: absolute;
        border: 1px solid rgba(14, 165, 233, 0.28);
        border-radius: 50%;
      }

      .ring-one {
        width: 190px;
        height: 190px;
        animation: spin 16s linear infinite;
      }

      .ring-two {
        width: 145px;
        height: 145px;
        border-style: dashed;
        animation: spinReverse 11s linear infinite;
      }

      .ring-three {
        width: 112px;
        height: 112px;
        border-color: rgba(56, 189, 248, 0.4);
        animation: pulseRing 3s ease-in-out infinite;
      }

      .logo-glow {
        position: absolute;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(14, 165, 233, 0.18);
        filter: blur(30px);
        animation: glow 3s ease-in-out infinite;
      }

      .logo-box {
        position: relative;
        width: 88px;
        height: 88px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, #0ea5e9, #2563eb);
        box-shadow:
          0 20px 60px rgba(14, 165, 233, 0.28),
          inset 0 1px rgba(255, 255, 255, 0.4);
        transform: rotate(-5deg);
        animation: floatLogo 4s ease-in-out infinite;
      }

      .logo-text {
        color: white;
        font-size: 30px;
        font-weight: 900;
        letter-spacing: -2px;
        transform: rotate(5deg);
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 15px;
        margin-bottom: 19px;
        border: 1px solid rgba(14, 165, 233, 0.18);
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.07);
        color: #0284c7;
        font-size: 13px;
        font-weight: 700;
      }

      :global(html.dark-mode) .hero-badge {
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.08);
      }

      .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #0ea5e9;
        box-shadow: 0 0 0 5px rgba(14, 165, 233, 0.1);
        animation: dotPulse 2s infinite;
      }

      .hero h1 {
        max-width: 850px;
        margin: 0 auto;
        font-size: clamp(38px, 6vw, 76px);
        line-height: 1.08;
        letter-spacing: -2.5px;
        font-weight: 900;
      }

      .gradient-text {
        background: linear-gradient(100deg, #0284c7, #2563eb 48%, #06b6d4);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .hero-description {
        max-width: 650px;
        margin: 23px auto 0;
        color: #64748b;
        font-size: 17px;
        line-height: 1.9;
      }

      :global(html.dark-mode) .hero-description {
        color: #94a3b8;
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
      }

      .primary-btn,
      .secondary-btn {
        min-height: 48px;
        padding: 0 22px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-decoration: none;
        font-weight: 800;
        transition: 0.25s ease;
      }

      .primary-btn {
        color: white;
        background: #0284c7;
        box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
      }

      .primary-btn:hover {
        transform: translateY(-3px);
        background: #0369a1;
        box-shadow: 0 15px 32px rgba(2, 132, 199, 0.27);
      }

      .secondary-btn {
        color: #334155;
        background: white;
        border: 1px solid #e2e8f0;
      }

      .secondary-btn:hover {
        transform: translateY(-3px);
        border-color: #bae6fd;
      }

      :global(html.dark-mode) .secondary-btn {
        color: #e2e8f0;
        background: #111827;
        border-color: #1e293b;
      }

      /* =========================================
         SEARCH
      ========================================= */

      .search-wrap {
        width: min(760px, calc(100% - 32px));
        margin: -25px auto 0;
        position: relative;
        z-index: 5;
      }

      .search-box {
        min-height: 68px;
        padding: 8px 9px 8px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 19px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow:
          0 20px 55px rgba(15, 23, 42, 0.09),
          0 2px 5px rgba(15, 23, 42, 0.03);
        backdrop-filter: blur(15px);
      }

      :global(html.dark-mode) .search-box {
        background: rgba(17, 24, 39, 0.94);
        border-color: #1e293b;
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.28);
      }

      .search-icon {
        color: #94a3b8;
        font-size: 18px;
      }

      .search-box input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #0f172a;
        font-family: inherit;
        font-size: 15px;
      }

      :global(html.dark-mode) .search-box input {
        color: white;
      }

      .search-box input::placeholder {
        color: #94a3b8;
      }

      .search-key {
        display: none;
        padding: 4px 8px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        color: #94a3b8;
        font: 11px 'JetBrains Mono', monospace;
      }

      :global(html.dark-mode) .search-key {
        border-color: #334155;
      }

      .search-results {
        display: none;
        margin-top: 8px;
        padding: 8px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: white;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.13);
        max-height: 330px;
        overflow-y: auto;
      }

      :global(html.dark-mode) .search-results {
        background: #111827;
        border-color: #1e293b;
      }

      .search-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        color: inherit;
        text-decoration: none;
        border-radius: 10px;
      }

      .search-result:hover {
        background: #f1f5f9;
      }

      :global(html.dark-mode) .search-result:hover {
        background: #1e293b;
      }

      .search-result small {
        color: #94a3b8;
        font-family: 'JetBrains Mono', monospace;
        direction: ltr;
      }

      /* =========================================
         SECTIONS
      ========================================= */

      .section {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 92px 0;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
      }

      .section-label {
        display: inline-flex;
        margin-bottom: 9px;
        color: #0284c7;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .section h2 {
        margin: 0;
        font-size: clamp(25px, 4vw, 38px);
        line-height: 1.25;
        letter-spacing: -1px;
      }

      .section-description {
        max-width: 520px;
        margin: 8px 0 0;
        color: #64748b;
        line-height: 1.8;
        font-size: 14px;
      }

      :global(html.dark-mode) .section-description {
        color: #94a3b8;
      }

      .view-all {
        flex-shrink: 0;
        color: #0284c7;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
      }

      /* =========================================
         FEATURED TOOLS
      ========================================= */

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
      }

      .tool-card {
        position: relative;
        min-height: 155px;
        padding: 20px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: white;
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .tool-card::after {
        content: '';
        position: absolute;
        width: 100px;
        height: 100px;
        left: -50px;
        bottom: -55px;
        border-radius: 50%;
        background: rgba(14, 165, 233, 0.08);
        transition: 0.3s ease;
      }

      .tool-card:hover {
        transform: translateY(-5px);
        border-color: #bae6fd;
        box-shadow: 0 18px 35px rgba(15, 23, 42, 0.07);
      }

      .tool-card:hover::after {
        transform: scale(1.7);
      }

      :global(html.dark-mode) .tool-card {
        background: #0f172a;
        border-color: #1e293b;
      }

      :global(html.dark-mode) .tool-card:hover {
        border-color: #155e75;
        box-shadow: 0 18px 35px rgba(0, 0, 0, 0.2);
      }

      .tool-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 17px;
        border-radius: 12px;
        background: #f0f9ff;
        color: #0284c7;
        font-size: 16px;
      }

      :global(html.dark-mode) .tool-icon {
        background: #082f49;
        color: #38bdf8;
      }

      .tool-card h3 {
        margin: 0 0 6px;
        font-size: 15px;
      }

      .tool-card p {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.7;
      }

      .tool-arrow {
        position: absolute;
        left: 17px;
        bottom: 16px;
        color: #94a3b8;
        font-size: 13px;
      }

      /* =========================================
         PLAYGROUND
      ========================================= */

      .playground {
        position: relative;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 40px;
        align-items: center;
        padding: 50px;
        overflow: hidden;
        border-radius: 30px;
        background: #0b1120;
        color: white;
        box-shadow: 0 30px 70px rgba(15, 23, 42, 0.16);
      }

      .playground::before {
        content: '';
        position: absolute;
        width: 430px;
        height: 430px;
        left: -170px;
        top: -220px;
        border-radius: 50%;
        background: rgba(14, 165, 233, 0.13);
        filter: blur(10px);
      }

      .playground-copy {
        position: relative;
        z-index: 1;
      }

      .playground-label {
        color: #38bdf8;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1px;
      }

      .playground h2 {
        margin: 12px 0 13px;
        font-size: clamp(27px, 4vw, 43px);
        line-height: 1.2;
      }

      .playground p {
        max-width: 520px;
        margin: 0;
        color: #94a3b8;
        line-height: 1.9;
        font-size: 14px;
      }

      .playground-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        padding: 12px 18px;
        color: #082f49;
        background: #7dd3fc;
        border-radius: 12px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 900;
        transition: 0.25s ease;
      }

      .playground-btn:hover {
        transform: translateY(-3px);
        background: #bae6fd;
      }

      .code-window {
        position: relative;
        z-index: 1;
        border: 1px solid #1e293b;
        border-radius: 18px;
        overflow: hidden;
        background: #020617;
        box-shadow: 0 25px 55px rgba(0, 0, 0, 0.3);
        transform: rotate(1.5deg);
      }

      .window-bar {
        height: 39px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 13px;
        border-bottom: 1px solid #1e293b;
      }

      .window-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #334155;
      }

      .window-title {
        margin-right: auto;
        color: #64748b;
        font: 10px 'JetBrains Mono', monospace;
        direction: ltr;
      }

      .code {
        padding: 23px;
        direction: ltr;
        font: 12px/2 'JetBrains Mono', monospace;
      }

      .code-line {
        white-space: nowrap;
      }

      .c-num {
        display: inline-block;
        width: 27px;
        color: #334155;
        user-select: none;
      }

      .c-blue {
        color: #38bdf8;
      }

      .c-green {
        color: #86efac;
      }

      .c-purple {
        color: #c4b5fd;
      }

      .c-gray {
        color: #64748b;
      }

      /* =========================================
         CATEGORIES
      ========================================= */

      .categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
      }

      .category {
        padding: 23px;
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        background: white;
      }

      :global(html.dark-mode) .category {
        background: #0f172a;
        border-color: #1e293b;
      }

      .category-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 13px;
        background: #f0f9ff;
        color: #0284c7;
        font: 700 15px 'JetBrains Mono', monospace;
      }

      :global(html.dark-mode) .category-icon {
        background: #082f49;
        color: #38bdf8;
      }

      .category h3 {
        margin: 0 0 7px;
        font-size: 16px;
      }

      .category p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.8;
      }

      :global(html.dark-mode) .category p {
        color: #94a3b8;
      }

      /* =========================================
         VALUE STRIP
      ========================================= */

      .value-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
      }

      :global(html.dark-mode) .value-strip {
        border-color: #1e293b;
      }

      .value-item {
        padding: 25px 20px;
        text-align: center;
      }

      .value-item + .value-item {
        border-right: 1px solid #e2e8f0;
      }

      :global(html.dark-mode) .value-item + .value-item {
        border-color: #1e293b;
      }

      .value-number {
        display: block;
        color: #0284c7;
        font-size: 29px;
        font-weight: 900;
      }

      .value-label {
        color: #64748b;
        font-size: 12px;
      }

      :global(html.dark-mode) .value-label {
        color: #94a3b8;
      }

      /* =========================================
         FAQ
      ========================================= */

      .faq-list {
        max-width: 850px;
        margin: 0 auto;
      }

      .faq {
        border-bottom: 1px solid #e2e8f0;
      }

      :global(html.dark-mode) .faq {
        border-color: #1e293b;
      }

      .faq summary {
        cursor: pointer;
        padding: 20px 0;
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        font-size: 14px;
        font-weight: 800;
      }

      .faq summary::-webkit-details-marker {
        display: none;
      }

      .faq summary::after {
        content: '+';
        color: #0284c7;
        font: 20px 'JetBrains Mono', monospace;
      }

      .faq[open] summary::after {
        content: '−';
      }

      .faq p {
        margin: -4px 0 20px;
        padding-left: 30px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.9;
      }

      :global(html.dark-mode) .faq p {
        color: #94a3b8;
      }

      /* =========================================
         FINAL CTA
      ========================================= */

      .final-cta {
        text-align: center;
        padding: 65px 25px;
        margin-bottom: 60px;
        border: 1px solid #bae6fd;
        border-radius: 27px;
        background:
          radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.12), transparent 45%),
          white;
      }

      :global(html.dark-mode) .final-cta {
        background: #0f172a;
        border-color: #164e63;
      }

      .final-cta h2 {
        margin: 0;
        font-size: clamp(25px, 4vw, 39px);
      }

      .final-cta p {
        max-width: 570px;
        margin: 12px auto 24px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.9;
      }

      :global(html.dark-mode) .final-cta p {
        color: #94a3b8;
      }

      /* =========================================
         ANIMATIONS
      ========================================= */

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes spinReverse {
        to {
          transform: rotate(-360deg);
        }
      }

      @keyframes pulseRing {
        0%,
        100% {
          transform: scale(0.92);
          opacity: 0.55;
        }

        50% {
          transform: scale(1.08);
          opacity: 1;
        }
      }

      @keyframes glow {
        0%,
        100% {
          transform: scale(0.85);
          opacity: 0.5;
        }

        50% {
          transform: scale(1.1);
          opacity: 0.9;
        }
      }

      @keyframes floatLogo {
        0%,
        100% {
          transform: rotate(-5deg) translateY(0);
        }

        50% {
          transform: rotate(-1deg) translateY(-9px);
        }
      }

      @keyframes dotPulse {
        0%,
        100% {
          box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.2);
        }

        50% {
          box-shadow: 0 0 0 7px rgba(14, 165, 233, 0.08);
        }
      }

      /* =========================================
         TABLET
      ========================================= */

      @media (max-width: 900px) {
        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .categories {
          grid-template-columns: repeat(2, 1fr);
        }

        .playground {
          grid-template-columns: 1fr;
          padding: 38px;
        }

        .code-window {
          transform: none;
        }
      }

      /* =========================================
         MOBILE
      ========================================= */

      @media (max-width: 600px) {
        .hero {
          min-height: auto;
          padding: 52px 16px 78px;
        }

        .logo-stage {
          width: 145px;
          height: 145px;
          margin-bottom: 25px;
        }

        .ring-one {
          width: 145px;
          height: 145px;
        }

        .ring-two {
          width: 112px;
          height: 112px;
        }

        .ring-three {
          width: 88px;
          height: 88px;
        }

        .logo-box {
          width: 70px;
          height: 70px;
          border-radius: 20px;
        }

        .logo-text {
          font-size: 24px;
        }

        .hero-badge {
          font-size: 11px;
          padding: 7px 12px;
        }

        .hero h1 {
          font-size: 36px;
          letter-spacing: -1.5px;
        }

        .hero-description {
          font-size: 13px;
          line-height: 1.9;
          margin-top: 17px;
        }

        .hero-actions {
          margin-top: 23px;
        }

        .primary-btn,
        .secondary-btn {
          min-height: 43px;
          padding: 0 16px;
          font-size: 12px;
          border-radius: 11px;
        }

        .search-wrap {
          width: calc(100% - 24px);
          margin-top: -20px;
        }

        .search-box {
          min-height: 57px;
          border-radius: 15px;
          padding-left: 14px;
        }

        .search-box input {
          font-size: 13px;
        }

        .section {
          width: calc(100% - 24px);
          padding: 60px 0;
        }

        .section-head {
          display: block;
          margin-bottom: 22px;
        }

        .section h2 {
          font-size: 25px;
        }

        .section-description {
          font-size: 12px;
          line-height: 1.8;
        }

        .view-all {
          display: inline-block;
          margin-top: 12px;
        }

        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 9px;
        }

        .tool-card {
          min-height: 145px;
          padding: 15px;
          border-radius: 15px;
        }

        .tool-icon {
          width: 36px;
          height: 36px;
          margin-bottom: 13px;
          border-radius: 10px;
          font-size: 14px;
        }

        .tool-card h3 {
          font-size: 12px;
          line-height: 1.5;
        }

        .tool-card p {
          font-size: 10px;
        }

        .tool-arrow {
          left: 12px;
          bottom: 12px;
        }

        .playground {
          padding: 27px 19px;
          gap: 27px;
          border-radius: 21px;
        }

        .playground h2 {
          font-size: 27px;
        }

        .playground p {
          font-size: 12px;
        }

        .playground-btn {
          margin-top: 18px;
          font-size: 11px;
          padding: 10px 14px;
        }

        .code {
          padding: 15px;
          font-size: 9px;
          line-height: 2;
        }

        .c-num {
          width: 22px;
        }

        .categories {
          grid-template-columns: 1fr 1fr;
          gap: 9px;
        }

        .category {
          padding: 17px 14px;
          border-radius: 15px;
        }

        .category-icon {
          width: 38px;
          height: 38px;
          margin-bottom: 13px;
        }

        .category h3 {
          font-size: 13px;
        }

        .category p {
          font-size: 10px;
        }

        .value-strip {
          grid-template-columns: 1fr 1fr 1fr;
        }

        .value-item {
          padding: 20px 8px;
        }

        .value-number {
          font-size: 22px;
        }

        .value-label {
          font-size: 9px;
        }

        .faq summary {
          font-size: 12px;
        }

        .faq p {
          font-size: 11px;
        }

        .final-cta {
          padding: 42px 17px;
          margin-bottom: 35px;
          border-radius: 20px;
        }

        .final-cta h2 {
          font-size: 25px;
        }

        .final-cta p {
          font-size: 11px;
        }
      }

      @media (max-width: 380px) {
        .tools-grid,
        .categories {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 32px;
        }

        .value-number {
          font-size: 19px;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <Header />

      <main>
        <!-- HERO -->
        <section class="hero">
          <div class="hero-bg"></div>
          <div class="grid-bg"></div>

          <div class="hero-content">
            <div class="logo-stage" aria-label="Th.Tech">
              <div class="logo-ring ring-one"></div>
              <div class="logo-ring ring-two"></div>
              <div class="logo-ring ring-three"></div>
              <div class="logo-glow"></div>

              <div class="logo-box">
                <span class="logo-text">Th.</span>
              </div>
            </div>

            <div class="hero-badge">
              <span class="pulse-dot"></span>
              أدوات تقنية تعمل مباشرة من المتصفح
            </div>

            <h1>
              أدواتك اليومية،
              <span class="gradient-text">بشكل أبسط.</span>
            </h1>

            <p class="hero-description">
              Th.Tech يجمع لك أدوات المطورين والنصوص والبيانات والتصميم
              في مكان واحد، بسرعة وبدون تعقيد.
            </p>

            <div class="hero-actions">
              <a class="primary-btn" href="#tools">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                استكشف الأدوات
              </a>

              <a class="secondary-btn" href={playgroundHref}>
                <i class="fa-solid fa-code"></i>
                افتح Playground
              </a>
            </div>
          </div>
        </section>

        <!-- SEARCH -->
        <div class="search-wrap">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>

            <input
              id="toolSearch"
              type="search"
              placeholder="ابحث عن أداة... مثل JSON أو Base64 أو QR"
              autocomplete="off"
              aria-label="البحث عن أداة"
            />

            <span class="search-key">/</span>
          </div>

          <div id="searchResults" class="search-results"></div>
        </div>

        <!-- VALUE STRIP -->
        <section class="section" style="padding-top: 62px; padding-bottom: 20px;">
          <div class="value-strip">
            <div class="value-item">
              <span class="value-number">118+</span>
              <span class="value-label">أداة تقنية</span>
            </div>

            <div class="value-item">
              <span class="value-number">100%</span>
              <span class="value-label">مجانية</span>
            </div>

            <div class="value-item">
              <span class="value-number">0</span>
              <span class="value-label">تثبيت برامج</span>
            </div>
          </div>
        </section>

        <!-- FEATURED TOOLS -->
        <section class="section" id="tools">
          <div class="section-head">
            <div>
              <span class="section-label">TOOLS</span>
              <h2>أدوات تستحق التجربة</h2>

              <p class="section-description">
                مجموعة مختارة من الأدوات التي تساعدك على إنجاز المهام
                اليومية بسرعة.
              </p>
            </div>

            <a class="view-all" href={`${base}/tools/`}>
              عرض جميع الأدوات ←
            </a>
          </div>

          <div class="tools-grid">
            {
              toolsToShow.map((tool, index) => (
                <a
                  class="tool-card"
                  href={`${base}/tools/${tool.slug}/`}
                  data-tool-name={tool.name.toLowerCase()}
                >
                  <div class="tool-icon">
                    <i
                      class={
                        [
                          'fa-solid',
                          index % 4 === 0
                            ? 'fa-code'
                            : index % 4 === 1
                              ? 'fa-brackets-curly'
                              : index % 4 === 2
                                ? 'fa-wand-magic-sparkles'
                                : 'fa-bolt'
                        ].join(' ')
                      }
                    ></i>
                  </div>

                  <h3>{tool.name}</h3>

                  <p>
                    أداة مجانية وسريعة تعمل مباشرة من المتصفح.
                  </p>

                  <span class="tool-arrow">←</span>
                </a>
              ))
            }
          </div>
        </section>

        <!-- PLAYGROUND -->
        <section class="section" style="padding-top: 20px;">
          <div class="playground">
            <div class="playground-copy">
              <span class="playground-label">TH.TECH PLAYGROUND</span>

              <h2>
                اكتب.
                <br />
                جرّب.
                <br />
                ابنِ فكرتك.
              </h2>

              <p>
                مساحة تفاعلية لتجربة الأكواد والأفكار مباشرة من المتصفح،
                بدون إعدادات معقدة.
              </p>

              <a class="playground-btn" href={playgroundHref}>
                ابدأ التجربة
                <i class="fa-solid fa-arrow-left"></i>
              </a>
            </div>

            <div class="code-window">
              <div class="window-bar">
                <span class="window-dot"></span>
                <span class="window-dot"></span>
                <span class="window-dot"></span>

                <span class="window-title">
                  th-tech-playground.js
                </span>
              </div>

              <div class="code">
                <div class="code-line">
                  <span class="c-num">01</span>
                  <span class="c-purple">const</span>
                  <span class="c-blue"> idea</span>
                  <span class="c-gray"> = </span>
                  <span class="c-green">"Build something."</span>
                </div>

                <div class="code-line">
                  <span class="c-num">02</span>
                  <span class="c-purple">function</span>
                  <span class="c-blue"> create</span>
                  <span class="c-gray">() {</span>
                </div>

                <div class="code-line">
                  <span class="c-num">03</span>
                  <span class="c-gray">&nbsp;&nbsp;return</span>
                  <span class="c-green">&nbsp;"Th.Tech"</span>
                  <span class="c-gray">;</span>
                </div>

                <div class="code-line">
                  <span class="c-num">04</span>
                  <span class="c-gray">}</span>
                </div>

                <div class="code-line">
                  <span class="c-num">05</span>
                  <span class="c-blue">create</span>
                  <span class="c-gray">();</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- CATEGORIES -->
        <section class="section">
          <div class="section-head">
            <div>
              <span class="section-label">EXPLORE</span>
              <h2>كل شيء في مكان واحد</h2>

              <p class="section-description">
                تصفح الأدوات حسب نوع المهمة بدل البحث الطويل.
              </p>
            </div>
          </div>

          <div class="categories">
            {
              categories.map((category) => (
                <div class="category">
                  <div class="category-icon">
                    {category.icon}
                  </div>

                  <h3>{category.title}</h3>

                  <p>{category.text}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- FAQ -->
        <section class="section">
          <div class="section-head">
            <div>
              <span class="section-label">FAQ</span>
              <h2>أسئلة سريعة</h2>
            </div>
          </div>

          <div class="faq-list">
            {
              faqs.map((faq) => (
                <details class="faq">
                  <summary>{faq.q}</summary>
                  <p>{faq.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <!-- CTA -->
        <section class="section" style="padding-top: 20px;">
          <div class="final-cta">
            <h2>جاهز لإنجاز مهمتك؟</h2>

            <p>
              اختر إحدى الأدوات وابدأ مباشرة. لا تحتاج إلى تسجيل أو تثبيت
              برنامج.
            </p>

            <a class="primary-btn" href="#tools">
              استكشف Th.Tech
              <i class="fa-solid fa-arrow-left"></i>
            </a>
          </div>
        </section>
      </main>

      <Footer />
    </div>

    <script>
      const input = document.getElementById('toolSearch');
      const results = document.getElementById('searchResults');

      const toolData = [
        ...document.querySelectorAll('[data-tool-name]')
      ].map((card) => ({
        name: card.getAttribute('data-tool-name') || '',
        href: card.getAttribute('href') || '',
        title: card.querySelector('h3')?.textContent?.trim() || ''
      }));

      function renderResults(value) {
        if (!results) return;

        const query = value.trim().toLowerCase();

        if (!query) {
          results.style.display = 'none';
          results.innerHTML = '';
          return;
        }

        const matches = toolData
          .filter((tool) => tool.name.includes(query))
          .slice(0, 8);

        if (!matches.length) {
          results.innerHTML = `
            <div style="padding:16px;color:#94a3b8;text-align:center;font-size:13px;">
              لم يتم العثور على أداة مطابقة.
            </div>
          `;
        } else {
          results.innerHTML = matches
            .map(
              (tool) => `
                <a class="search-result" href="${tool.href}">
                  <strong>${tool.title}</strong>
                  <small>فتح ←</small>
                </a>
              `
            )
            .join('');
        }

        results.style.display = 'block';
      }

      input?.addEventListener('input', (event) => {
        renderResults(event.target.value);
      });

      document.addEventListener('click', (event) => {
        if (
          results &&
          input &&
          !results.contains(event.target) &&
          !input.contains(event.target)
        ) {
          results.style.display = 'none';
        }
      });

      document.addEventListener('keydown', (event) => {
        if (
          event.key === '/' &&
          document.activeElement?.tagName !== 'INPUT' &&
          document.activeElement?.tagName !== 'TEXTAREA'
        ) {
          event.preventDefault();
          input?.focus();
        }

        if (event.key === 'Escape') {
          results.style.display = 'none';
          input?.blur();
        }
      });
    </script>
  </body>
</html>
