---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | المنصة التقنية</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />

  <main>
    <!-- Hero مع ملء الفراغ -->
    <section class="hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920" alt="Tech" />
        <div class="overlay"></div>
      </div>
      
      <div class="container">
        <div class="hero-content">
          <span class="badge">اكتشف، تعلّم، وابتكر</span>
          <h1>
            ابنِ <span id="typewriter"></span><span class="cursor">|</span>
          </h1>
          <p>منصة رائدة توفر شروحات تقنية معمقة، أدلة مرجعية شاملة، ومختبر أكواد تفاعلي.</p>
          
          <div class="hero-actions">
            <a href="/Th-tech/playground/" class="btn btn-primary">ابدأ البرمجة الآن 💻</a>
            <a href="/Th-tech/guides/" class="btn btn-secondary">تصفح المكتبة 📚</a>
          </div>
        </div>

        <!-- عناصر لملء الفراغ -->
        <div class="floating-cards">
          <div class="float-card">
            <div class="code-box">
              <div>print("مرحباً")</div>
              <div style="color:#64748b"># Th.Tech</div>
            </div>
          </div>
          <div class="float-card card-2">
            <span>+150 درس</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div><span class="stat-num" data-target="150" data-suffix="+">0</span><span>دليل شامل</span></div>
          <div class="divider"></div>
          <div><span class="stat-num" data-target="50" data-suffix="K+">0</span><span>قارئ شهرياً</span></div>
          <div class="divider"></div>
          <div><span class="stat-num" data-target="100" data-suffix="%">0</span><span>محتوى مجاني</span></div>
        </div>
      </div>
    </section>

    <!-- Tracks بأيقونات SVG -->
    <section class="tracks">
      <div class="container">
        <h2>مسارات التعلم</h2>
        <div class="tracks-grid">
          <a href="#" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600" alt="AI" /></div>
            <div class="track-body">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-1v1a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-1H4a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg></div>
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة والشبكات العصبية</p>
            </div>
          </a>

          <a href="#" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600" alt="Code" /></div>
            <div class="track-body">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
              <h3>البرمجة</h3>
              <p>تطوير التطبيقات و DevOps</p>
            </div>
          </a>

          <a href="#" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600" alt="Security" /></div>
            <div class="track-body">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
              <h3>الأمن السيبراني</h3>
              <p>اختبار الاختراق والحماية</p>
            </div>
          </a>

          <a href="#" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600" alt="Cloud" /></div>
            <div class="track-body">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg></div>
              <h3>السحابة</h3>
              <p>AWS و Kubernetes</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ (بدون الأسئلة المحذوفة) -->
    <section class="faq">
      <div class="container">
        <h2>الأسئلة الشائعة</h2>
        <div class="faq-grid">
          <div class="faq-item"><h3>هل أحتاج خبرة سابقة؟</h3><p>لا! نبدأ معك من الصفر حتى الاحتراف.</p></div>
          <div class="faq-item"><h3>كيف أستخدم المحرر؟</h3><p>اكتب الكود واضغط "تشغيل" لترى النتيجة.</p></div>
          <div class="faq-item"><h3>هل يمكنني حفظ أعمالي؟</h3><p>نعم! يُحفظ تلقائياً في المتصفح.</p></div>
          <div class="faq-item"><h3>ما اللغات المدعومة؟</h3><p>Python و JavaScript و HTML/CSS.</p></div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    :root {
      --bg: #0b1120; --bg2: #0f172a; --text: #f1f5f9; --muted: #94a3b8;
      --primary: #3b82f6; --border: #1e293b; --card: #1e293b;
    }
    [data-theme="light"] {
      --bg: #fff; --bg2: #f8fafc; --text: #0f172a; --muted: #64748b;
      --primary: #2563eb; --border: #e2e8f0; --card: #fff;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Cairo', sans-serif; transition: 0.3s; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    
    /* Hero - ملء الفراغ */
    .hero { min-height: 100vh; display: flex; align-items: center; position: relative; padding: 100px 0; }
    .hero-bg { position: absolute; inset: 0; z-index: -1; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4); }
    .overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(11,17,32,0.6), var(--bg)); }
    
    .container { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .badge { display: inline-block; background: rgba(59,130,246,0.2); color: var(--primary); padding: 0.4rem 1.2rem; border-radius: 50px; margin-bottom: 1.5rem; font-weight: 700; }
    h1 { font-size: 3rem; margin-bottom: 1.5rem; }
    #typewriter { color: var(--primary); }
    .cursor { animation: blink 1s infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    p { color: var(--muted); margin-bottom: 2rem; line-height: 1.8; }
    
    .btn { padding: 0.9rem 2rem; border-radius: 10px; text-decoration: none; font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0.5rem; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-secondary { background: var(--card); color: var(--text); border: 1px solid var(--border); }
    
    /* Floating Cards لملء الفراغ */
    .floating-cards { position: relative; height: 400px; }
    .float-card { position: absolute; background: rgba(30,41,59,0.8); backdrop-filter: blur(10px); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); animation: float 6s ease-in-out infinite; }
    .float-card:first-child { top: 50px; left: 0; width: 250px; }
    .float-card.card-2 { bottom: 100px; right: 0; }
    .code-box { font-family: 'Fira Code', monospace; direction: ltr; text-align: left; }
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

    /* Stats */
    .stats { background: var(--bg2); padding: 3rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .stats-grid { display: flex; justify-content: center; align-items: center; gap: 4rem; }
    .stat-num { display: block; font-size: 2.5rem; font-weight: 800; color: var(--primary); }
    .divider { width: 1px; height: 50px; background: var(--border); }

    /* Tracks */
    .tracks { padding: 5rem 0; }
    h2 { text-align: center; font-size: 2rem; margin-bottom: 3rem; }
    .tracks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
    .track { background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--text); transition: 0.3s; }
    .track:hover { transform: translateY(-5px); border-color: var(--primary); }
    .track-img { height: 180px; overflow: hidden; }
    .track-img img { width: 100%; height: 100%; object-fit: cover; }
    .track-body { padding: 1.5rem; }
    .icon { width: 50px; height: 50px; background: var(--bg2); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--primary); margin-bottom: 1rem; }
    .icon svg { width: 28px; height: 28px; }
    h3 { margin-bottom: 0.5rem; }
    .track-body p { font-size: 0.9rem; margin: 0; }

    /* FAQ */
    .faq { background: var(--bg2); padding: 5rem 0; }
    .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
    .faq-item { background: var(--card); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); }
    .faq-item h3 { color: var(--primary); margin-bottom: 1rem; font-size: 1.1rem; }
    .faq-item p { margin: 0; }

    @media (max-width: 900px) {
      .container { grid-template-columns: 1fr; text-align: center; }
      .floating-cards { display: none; }
      .stats-grid { flex-direction: column; gap: 2rem; }
      .divider { width: 50px; height: 1px; }
    }
  </style>

  <script>
    // Typewriter Effect
    const text = "المستقبل الرقمي بأدوات احترافية";
    let i = 0;
    function type() {
      if (i < text.length) {
        document.getElementById('typewriter').textContent += text.charAt(i);
        i++;
        setTimeout(type, 100);
      }
    }
    setTimeout(type, 500);

    // Counters
    document.querySelectorAll('.stat-num').forEach(counter => {
      const target = +counter.dataset.target;
      const suffix = counter.dataset.suffix || '';
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            let current = 0;
            const update = () => {
              current += target / 50;
              if (current >= target) {
                counter.textContent = target + suffix;
              } else {
                counter.textContent = Math.floor(current) + suffix;
                requestAnimationFrame(update);
              }
            };
            update();
            observer.unobserve(entry.target);
          }
        });
      });
      observer.observe(counter);
    });

    // Dark Mode - فوري
    const saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    
    const btn = document.getElementById('theme-toggle');
    if(btn) {
      btn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }
  </script>
</body>
</html>
