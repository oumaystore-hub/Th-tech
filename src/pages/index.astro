---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | منصة المستقبل التقني</title>
  <meta name="description" content="المنصة العربية الأولى في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  
  <!-- خطوط احترافية (Cairo للعربية، Inter للأرقام) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!--  Hero Section مع تأثير الشفق (Aurora) -->
    <section class="hero-advanced">
      <div class="aurora-bg">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
        <div class="aurora-blob blob-3"></div>
      </div>
      
      <div class="container hero-content">
        <div class="hero-badge reveal-delay-1">
          <span class="badge-dot"></span>
          <span>نحو المستقبل الرقمي</span>
        </div>
        
        <h1 class="reveal-delay-2">
          <span class="text-gradient">صُغ مستقبلك</span> الرقمي
          <br />
          <span class="hero-sub">بأحدث التقنيات العالمية</span>
        </h1>
        
        <p class="hero-desc reveal-delay-3">
          منصة تعليمية احترافية تدمج بين عمق المحتوى وسلاسة التصميم، لتمكينك من إتقان الذكاء الاصطناعي، البرمجة، والأمن السيبراني.
        </p>
        
        <div class="hero-cta reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary">
            <span>استكشف الأدلة</span>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </a>
          <a href="/Th-tech/articles/" class="btn btn-glass">
            <span>تصفح المكتبة</span>
          </a>
        </div>

        <!-- شريط تقنيات متحرك (Infinite Marquee) -->
        <div class="tech-marquee reveal-delay-4">
          <div class="marquee-track">
            <span class="marquee-item">Python</span>
            <span class="marquee-item">React</span>
            <span class="marquee-item">AWS</span>
            <span class="marquee-item">TensorFlow</span>
            <span class="marquee-item">Docker</span>
            <span class="marquee-item">CyberSec</span>
            <span class="marquee-item">Linux</span>
            <span class="marquee-item">Node.js</span>
            <!-- تكرار للشريط المتصل -->
            <span class="marquee-item">Python</span>
            <span class="marquee-item">React</span>
            <span class="marquee-item">AWS</span>
            <span class="marquee-item">TensorFlow</span>
            <span class="marquee-item">Docker</span>
            <span class="marquee-item">CyberSec</span>
            <span class="marquee-item">Linux</span>
            <span class="marquee-item">Node.js</span>
          </div>
        </div>
      </div>
    </section>

    <!--  Bento Grid Features (تصميم شبكي حديث) -->
    <section class="bento-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">مسارات التميز التقني</h2>
          <p class="section-subtitle">اختر تخصصك وابدأ رحلة الاحتراف</p>
        </div>
        
        <div class="bento-grid">
          <!-- بطاقة الذكاء الاصطناعي (كبيرة) -->
          <div class="bento-card card-large reveal-delay-1">
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-icon-svg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
              <h3>الذكاء الاصطناعي التوليدي</h3>
              <p>استكشف نماذج اللغة الكبيرة (LLMs) وتطبيقات الذكاء الاصطناعي.</p>
              <ul class="feature-tags">
                <li>Machine Learning</li>
                <li>Neural Networks</li>
              </ul>
            </div>
            <a href="/Th-tech/ai/" class="card-link">اكتشف المسار <span>→</span></a>
          </div>

          <!-- بطاقة الأمن السيبراني -->
          <div class="bento-card reveal-delay-2">
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-icon-svg security-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              </div>
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات والتحليل الجنائي الرقمي.</p>
              <a href="/Th-tech/security/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>

          <!-- بطاقة البرمجة -->
          <div class="bento-card reveal-delay-3">
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-icon-svg code-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                  <line x1="12" y1="2" x2="12" y2="22"></line>
                </svg>
              </div>
              <h3>هندسة البرمجيات</h3>
              <p>بناء أنظمة قوية وقابلة للتوسع.</p>
              <a href="/Th-tech/programming/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>

          <!-- بطاقة السحابة -->
          <div class="bento-card reveal-delay-4">
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-icon-svg cloud-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                </svg>
              </div>
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، و DevOps.</p>
              <a href="/Th-tech/cloud/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--  Auto-Scrolling Articles Slider -->
    <section class="slider-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">أحدث الإصدارات</h2>
          <p class="section-subtitle">مقالات تقنية مختارة بعناية</p>
        </div>
        
        <div class="slider-wrapper">
          <div class="slider-track" id="sliderTrack">
            <!-- Article 1 -->
            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" />
                <div class="slide-badge">جديد</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-ai">AI</span><span class="read-time">5 دقائق</span></div>
                <h3>دليلك الشامل لتعلم الآلة</h3>
                <p>رحلة عملية من الصفر للاحتراف في بناء النماذج.</p>
              </div>
            </article>

            <!-- Article 2 -->
            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" />
                <div class="slide-badge popular">شائع</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-sec">Security</span><span class="read-time">8 دقائق</span></div>
                <h3>استراتيجيات الدفاع السيبراني</h3>
                <p>كيف تحمي مؤسستك من أحدث التهديدات.</p>
              </div>
            </article>

            <!-- Article 3 -->
            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Code" />
                <div class="slide-badge updated">محدّث</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-code">Code</span><span class="read-time">6 دقائق</span></div>
                <h3>مبادئ SOLID للمحترفين</h3>
                <p>الأنماط التصميمية التي تفصل بين الكود العادي والاحترافي.</p>
              </div>
            </article>

            <!-- Article 4 -->
            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" />
                <div class="slide-badge">جديد</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-cloud">Cloud</span><span class="read-time">10 دقائق</span></div>
                <h3>أمن السحابة في AWS</h3>
                <p>أفضل الممارسات لتأمين بنيتك التحتية.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!--  Newsletter & CTA -->
    <section class="cta-section reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-bg-glow"></div>
          <div class="cta-content">
            <h2>🚀 انضم إلى النخبة</h2>
            <p>انضم لآلاف المطورين الذين يبنون المستقبل معنا. احصل على أحدث المقالات مباشرة.</p>
            <form class="newsletter-form-inline">
              <input type="email" placeholder="بريدك الإلكتروني..." required />
              <button type="submit" class="btn btn-primary">اشترك الآن</button>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  /* === Global Variables & Reset === */
  :root {
    --bg: #0b0c10; /* Dark Base */
    --bg-card: #15171e;
    --text: #ffffff;
    --text-muted: #9ca3af;
    --primary: #3b82f6;
    --primary-glow: #2563eb;
    --accent: #8b5cf6;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.2);
    --radius: 20px;
    --radius-sm: 12px;
    --font-main: 'Cairo', sans-serif;
    --font-mono: 'Inter', sans-serif;
  }

  html.dark-mode {
    /* Keeping consistent with dark theme as default for tech */
    --bg: #0b0c10;
  }
  
  html.light-mode {
    --bg: #f8fafc;
    --bg-card: #ffffff;
    --text: #0f172a;
    --text-muted: #64748b;
    --border: rgba(0, 0, 0, 0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-title { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.8rem; letter-spacing: -0.5px; }
  .section-subtitle { color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  /* === Hero Section with Aurora === */
  .hero-advanced {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding-top: 4rem;
  }

  .aurora-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.15) 0%, transparent 60%);
  }

  .aurora-blob {
    position: absolute;
    filter: blur(80px);
    opacity: 0.6;
    animation: floatBlob 10s infinite alternate ease-in-out;
  }
  .blob-1 { top: -10%; left: -10%; width: 500px; height: 500px; background: rgba(59, 130, 246, 0.4); animation-delay: 0s; }
  .blob-2 { bottom: -10%; right: -10%; width: 600px; height: 600px; background: rgba(139, 92, 246, 0.3); animation-delay: -5s; }
  .blob-3 { top: 30%; left: 40%; width: 400px; height: 400px; background: rgba(14, 165, 233, 0.2); animation-delay: -2s; }

  @keyframes floatBlob {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -30px) scale(1.1); }
  }

  .hero-content { position: relative; z-index: 1; max-width: 900px; }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(10px);
  }
  .badge-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981; }

  .hero-advanced h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.1; margin-bottom: 1.5rem; font-weight: 900; }
  .text-gradient {
    background: linear-gradient(135deg, #fff 0%, #3b82f6 50%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub { display: block; font-size: 0.5em; color: var(--text-muted); font-weight: 600; margin-top: 0.5rem; }

  .hero-desc { font-size: 1.2rem; color: var(--text-muted); max-width: 650px; margin: 0 auto 2.5rem; line-height: 1.8; }

  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 4rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    cursor: pointer;
    border: none;
    position: relative;
    overflow: hidden;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(59, 130, 246, 0.6); }
  .btn-icon { width: 20px; height: 20px; }
  
  .btn-glass {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }
  .btn-glass:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--text-muted); }

  /* Infinite Marquee */
  .tech-marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 2rem;
    animation: scrollMarquee 30s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .marquee-item::before { content: '✦'; color: var(--primary); }
  @keyframes scrollMarquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* === Bento Grid Features === */
  .bento-section { padding: 6rem 0; }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 300px);
    gap: 1.5rem;
  }

  .bento-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .bento-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-hover);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .bento-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.1), transparent 40%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .bento-card:hover::before { opacity: 1; }

  .card-large { grid-column: span 2; }
  
  .card-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);
    z-index: 0;
  }

  .card-content { position: relative; z-index: 1; }
  
  .card-icon-svg {
    width: 50px;
    height: 50px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: var(--primary);
  }
  .card-icon-svg svg { width: 28px; height: 28px; }

  .bento-card h3 { font-size: 1.5rem; margin-bottom: 0.8rem; font-weight: 700; }
  .bento-card p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6; }

  .feature-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .feature-tags li {
    list-style: none;
    background: rgba(255,255,255,0.05);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .card-link {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.3s;
  }
  .card-link:hover { gap: 0.8rem; }
  .card-link span { font-size: 1.2rem; }

  @media (max-width: 900px) {
    .bento-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .card-large { grid-column: span 1; }
  }

  /* === Auto-Scrolling Slider === */
  .slider-section { padding: 6rem 0; background: linear-gradient(to bottom, transparent, rgba(59, 130, 246, 0.03)); }
  .slider-wrapper { overflow: hidden; position: relative; }
  .slider-wrapper::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0; width: 100px;
    background: linear-gradient(to left, var(--bg), transparent);
    pointer-events: none;
  }
  
  .slider-track {
    display: flex;
    gap: 1.5rem;
    animation: scrollSlider 40s linear infinite;
    width: max-content;
    padding: 1rem 0;
  }
  
  .slider-track:hover { animation-play-state: paused; }

  .slide-card {
    width: 350px;
    flex-shrink: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s;
  }
  .slide-card:hover { transform: translateY(-5px); border-color: var(--border-hover); }

  .slide-image { position: relative; height: 200px; overflow: hidden; }
  .slide-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .slide-card:hover .slide-image img { transform: scale(1.05); }
  
  .slide-badge {
    position: absolute;
    top: 1rem; right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(5px);
    color: white;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .slide-badge.popular { background: rgba(245, 158, 11, 0.8); }
  .slide-badge.updated { background: rgba(16, 185, 129, 0.8); }

  .slide-content { padding: 1.5rem; }
  .slide-meta { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.8rem; color: var(--text-muted); }
  .cat-ai { color: #3b82f6; }
  .cat-sec { color: #ef4444; }
  .cat-code { color: #10b981; }
  .cat-cloud { color: #8b5cf6; }

