    background: var(--card);
    color: var(--text);
    border: none;
    border-right: 1px solid var(--border);
    resize: none;
    font-family: 'Fira Code', monospace;
    font-size: 0.9rem;
    line-height: 1.55;
    tab-size: 2;
  }
  .code-input:focus { outline: none; }
  
  .output-panel { display: flex; flex-direction: column; }
  .output-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 1.2rem;
