---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | المنصة التقنية</title>
  <meta
    name="description"
    content="Th.Tech منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والحوسبة السحابية."
  />

  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <!-- Theme initialization -->
  <script is:inline>
    (() => {
      try {
        const savedTheme = localStorage.getItem('theme');

        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (error) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>

<body>
  <Header />

  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

      <div class="hero-bg">
        <img
          src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920"
          alt="Technology background"
        />
        <div class="hero-overlay"></div>

        <div class="hero-grid"></div>
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>
      </div>

      <div class="container hero-container">

        <div class="hero-content">

          <div class="badge">
            <span class="badge-dot"></span>
            <i class="fas fa-rocket"></i>
            اكتشف، تعلّم، وابتكر
          </div>

          <h1>
            ابنِ
            <span id="typewriter" class="gradient-text"></span>
            <span class="cursor">|</span>
          </h1>

          <p class="hero-description">
            منصة تقنية عربية تجمع بين المعرفة، البرمجة، الذكاء الاصطناعي
            والأدوات العملية لتساعدك على تطوير مهاراتك وبناء مشاريعك.
          </p>

          <div class="hero-actions">

            <a
              href="/Th-tech/playground/"
              class="btn btn-primary"
            >
              <i class="fas fa-code"></i>
              <span>ابدأ البرمجة الآن</span>
              <i class="fas fa-arrow-left btn-arrow"></i>
            </a>

            <a
              href="/Th-tech/guides/"
              class="btn btn-secondary"
            >
              <i class="fas fa-book-open"></i>
              <span>تصفح المكتبة</span>
            </a>

          </div>

          <div class="hero-features">

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-bolt"></i>
              </span>
              <span>تنفيذ فوري</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-shield-halved"></i>
              </span>
              <span>بيئة آمنة</span>
            </div>

            <div class="hero-feature">
              <span class="feature-check">
                <i class="fas fa-gift"></i>
              </span>
              <span>مجاني تماماً</span>
            </div>

          </div>

        </div>


        <!-- HERO VISUAL -->

        <div class="hero-visual">

          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>

          <div class="code-window">

            <div class="window-header">
              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="window-title">
                <i class="fas fa-terminal"></i>
                Th.Tech Playground
              </div>

              <div class="window-icon">
                <i class="fas fa-code"></i>
              </div>
            </div>

            <div class="code-content">

              <div class="code-line">
                <span class="line-number">01</span>
                <span class="purple">const</span>
                <span class="blue">future</span>
                <span>=</span>
                <span class="green">"Th.Tech"</span>
              </div>

              <div class="code-line">
                <span class="line-number">02</span>
                <span class="purple">function</span>
                <span class="yellow">learn</span>
                <span>() {</span>
              </div>

              <div class="code-line indent">
                <span class="purple">return</span>
                <span class="green">"Build something great"</span>
              </div>

              <div class="code-line">
                <span class="line-number">04</span>
                <span>}</span>
              </div>

              <div class="terminal-output">
                <span class="terminal-dot"></span>
                <span>Execution completed successfully</span>
              </div>

            </div>

          </div>


          <div class="floating-card float-python">

            <div class="floating-icon python-icon">
              <i class="fab fa-python"></i>
            </div>

            <div>
              <strong>Python</strong>
              <small>Programming</small>
            </div>

          </div>


          <div class="floating-card float-js">

            <div class="floating-icon js-icon">
              <i class="fab fa-js"></i>
            </div>

            <div>
              <strong>JavaScript</strong>
              <small>Web Development</small>
            </div>

          </div>


          <div class="floating-card float-terminal">

            <div class="floating-icon terminal-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <strong>Terminal</strong>
              <small>Developer Tools</small>
            </div>

          </div>


          <div class="floating-card float-lessons">

            <div class="floating-icon check-icon">
              <i class="fas fa-check"></i>
            </div>

            <div>
              <strong>150+</strong>
              <small>درس ودليل</small>
            </div>

          </div>

        </div>

      </div>

      <div class="hero-scroll">
        <span>اكتشف المزيد</span>
        <i class="fas fa-chevron-down"></i>
      </div>

    </section>


    <!-- =====================================================
         TECH TICKER
    ====================================================== -->

    <div class="tech-ticker">

      <div class="ticker-track">

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-halved"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node-js"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>

        <!-- duplicate for smooth ticker -->

        <span class="tech-item">
          <i class="fab fa-js"></i>
          JavaScript
        </span>

        <span class="tech-item">
          <i class="fab fa-python"></i>
          Python
        </span>

        <span class="tech-item">
          <i class="fab fa-react"></i>
          React
        </span>

        <span class="tech-item">
          <i class="fab fa-aws"></i>
          AWS
        </span>

        <span class="tech-item">
          <i class="fas fa-shield-halved"></i>
          CyberSec
        </span>

        <span class="tech-item">
          <i class="fab fa-docker"></i>
          Docker
        </span>

        <span class="tech-item">
          <i class="fab fa-node-js"></i>
          Node.js
        </span>

        <span class="tech-item">
          <i class="fas fa-database"></i>
          SQL
        </span>

      </div>

    </div>


    <!-- =====================================================
         STATS
    ====================================================== -->

    <section class="stats">

      <div class="container">

        <div class="stats-grid">

          <div class="stat-item">

            <div class="stat-icon-wrapper">
              <i class="fas fa-book-open"></i>
            </div>

            <span
              class="stat-num"
              data-target="150"
              data-suffix="+"
            >
              0
            </span>

            <span class="stat-label">
              دليل شامل
            </span>

          </div>


          <div class="stat-divider"></div>


          <div class="stat-item">

            <div class="stat-icon-wrapper">
              <i class="fas fa-users"></i>
            </div>

            <span
              class="stat-num"
              data-target="50"
              data-suffix="K+"
            >
              0
            </span>

            <span class="stat-label">
              قارئ شهرياً
            </span>

          </div>


          <div class="stat-divider"></div>


          <div class="stat-item">

            <div class="stat-icon-wrapper">
              <i class="fas fa-percentage"></i>
            </div>

            <span
              class="stat-num"
              data-target="100"
              data-suffix="%"
            >
              0
            </span>

            <span class="stat-label">
              محتوى مجاني
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         TRACKS
    ====================================================== -->

    <section class="tracks">

      <div class="container">

        <div class="section-heading">

          <span class="section-kicker">
            <i class="fas fa-layer-group"></i>
            مسارات متخصصة
          </span>

          <h2>
            مسارات
            <span>التعلم</span>
          </h2>

          <p>
            اختر المجال الذي يناسبك وابدأ رحلة التعلم خطوة بخطوة.
          </p>

        </div>


        <div class="tracks-grid">


          <!-- AI -->

          <a
            href="/Th-tech/ai/"
            class="track"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800"
                alt="Artificial Intelligence"
                loading="lazy"
              />

              <div class="track-overlay"></div>

              <span class="track-number">
                01
              </span>

              <div class="track-top-icon">
                <i class="fas fa-brain"></i>
              </div>

            </div>

            <div class="track-body">

              <span class="track-category">
                AI & MACHINE LEARNING
              </span>

              <h3>
                الذكاء الاصطناعي
              </h3>

              <p>
                تعلم الآلة والشبكات العصبية وبناء حلول ذكية.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Machine Learning
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Deep Learning
                </li>

              </ul>

              <span class="track-link">
                اكتشف المسار
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

          </a>


          <!-- Programming -->

          <a
            href="/Th-tech/programming/"
            class="track"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800"
                alt="Programming"
                loading="lazy"
              />

              <div class="track-overlay"></div>

              <span class="track-number">
                02
              </span>

              <div class="track-top-icon">
                <i class="fas fa-code"></i>
              </div>

            </div>

            <div class="track-body">

              <span class="track-category">
                DEVELOPMENT
              </span>

              <h3>
                البرمجة
              </h3>

              <p>
                تعلم تطوير التطبيقات والمواقع وأدوات DevOps.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Full Stack
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  DevOps
                </li>

              </ul>

              <span class="track-link">
                اكتشف المسار
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

          </a>


          <!-- Security -->

          <a
            href="/Th-tech/security/"
            class="track"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800"
                alt="Cyber Security"
                loading="lazy"
              />

              <div class="track-overlay"></div>

              <span class="track-number">
                03
              </span>

              <div class="track-top-icon">
                <i class="fas fa-lock"></i>
              </div>

            </div>

            <div class="track-body">

              <span class="track-category">
                CYBER SECURITY
              </span>

              <h3>
                الأمن السيبراني
              </h3>

              <p>
                تعرف على مفاهيم الحماية واختبار الاختراق بشكل مسؤول.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  Ethical Hacking
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Security
                </li>

              </ul>

              <span class="track-link">
                اكتشف المسار
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

          </a>


          <!-- Cloud -->

          <a
            href="/Th-tech/cloud/"
            class="track"
          >

            <div class="track-img">

              <img
                src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800"
                alt="Cloud Computing"
                loading="lazy"
              />

              <div class="track-overlay"></div>

              <span class="track-number">
                04
              </span>

              <div class="track-top-icon">
                <i class="fas fa-cloud"></i>
              </div>

            </div>

            <div class="track-body">

              <span class="track-category">
                CLOUD & DEVOPS
              </span>

              <h3>
                الحوسبة السحابية
              </h3>

              <p>
                تعرف على AWS وDocker وKubernetes والبنية السحابية.
              </p>

              <ul class="track-list">

                <li>
                  <i class="fas fa-check"></i>
                  AWS
                </li>

                <li>
                  <i class="fas fa-check"></i>
                  Docker
                </li>

              </ul>

              <span class="track-link">
                اكتشف المسار
                <i class="fas fa-arrow-left"></i>
              </span>

            </div>

          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FEATURES
    ====================================================== -->

    <section class="features">

      <div class="container">

        <div class="section-heading">

          <span class="section-kicker">
            <i class="fas fa-sparkles"></i>
            تجربة مختلفة
          </span>

          <h2>
            لماذا
            <span>Th.Tech؟</span>
          </h2>

          <p>
            أدوات وتجربة مصممة لتجعل التعلم التقني أبسط وأسرع.
          </p>

        </div>


        <div class="features-grid">


          <div class="feature-box">

            <div class="feature-number">
              01
            </div>

            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>

            <h3>
              سرعة فائقة
            </h3>

            <p>
              تجربة سريعة وتنفيذ فوري للأكواد بدون تعقيد.
            </p>

          </div>


          <div class="feature-box">

            <div class="feature-number">
              02
            </div>

            <div class="feature-icon">
              <i class="fas fa-mobile-screen-button"></i>
            </div>

            <h3>
              متجاوب بالكامل
            </h3>

            <p>
              تصميم يعمل بسلاسة على الهاتف والكمبيوتر والتابلت.
            </p>

          </div>


          <div class="feature-box">

            <div class="feature-number">
              03
            </div>

            <div class="feature-icon">
              <i class="fas fa-floppy-disk"></i>
            </div>

            <h3>
              حفظ تلقائي
            </h3>

            <p>
              احفظ أكوادك وأعمالك بسهولة داخل المتصفح.
            </p>

          </div>


          <div class="feature-box">

            <div class="feature-number">
              04
            </div>

            <div class="feature-icon">
              <i class="fas fa-download"></i>
            </div>

            <h3>
              تصدير سهل
            </h3>

            <p>
              إمكانية تصدير الأكواد والأعمال بصيغ مختلفة.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FAQ
    ====================================================== -->

    <section class="faq">

      <div class="container">

        <div class="section-heading">

          <span class="section-kicker">
            <i class="fas fa-circle-question"></i>
            تحتاج مساعدة؟
          </span>

          <h2>
            الأسئلة
            <span>الشائعة</span>
          </h2>

          <p>
            إجابات سريعة على أهم الأسئلة حول المنصة.
          </p>

        </div>


        <div class="faq-grid">


          <div class="faq-item">

            <div class="faq-icon">
              <i class="fas fa-user-graduate"></i>
            </div>

            <div>
              <h3>
                هل أحتاج خبرة سابقة؟
              </h3>

              <p>
                لا! نبدأ معك من الأساسيات وننتقل تدريجياً إلى المستويات المتقدمة.
              </p>
            </div>

          </div>


          <div class="faq-item">

            <div class="faq-icon">
              <i class="fas fa-terminal"></i>
            </div>

            <div>
              <h3>
                كيف أستخدم المحرر؟
              </h3>

              <p>
                اكتب الكود داخل المحرر واضغط على زر التشغيل لرؤية النتيجة.
              </p>
            </div>

          </div>


          <div class="faq-item">

            <div class="faq-icon">
              <i class="fas fa-save"></i>
            </div>

            <div>
              <h3>
                هل يمكنني حفظ أعمالي؟
              </h3>

              <p>
                نعم، يتم حفظ بيانات المحرر محلياً داخل المتصفح عند توفر هذه الميزة.
              </p>
            </div>

          </div>


          <div class="faq-item">

            <div class="faq-icon">
              <i class="fas fa-code"></i>
            </div>

            <div>
              <h3>
                ما اللغات المدعومة؟
              </h3>

              <p>
                تشمل المنصة حالياً Python وJavaScript وHTML وغيرها حسب الأداة.
              </p>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="cta">

      <div class="container">

        <div class="cta-box">

          <div class="cta-glow"></div>

          <div class="cta-content">

            <span class="section-kicker">
              <i class="fas fa-rocket"></i>
              ابدأ اليوم
            </span>

            <h2>
              جاهز لبناء
              <span>مستقبلك الرقمي؟</span>
            </h2>

            <p>
              تعلم، جرّب، طوّر مهاراتك وابنِ مشاريعك مع Th.Tech.
            </p>

            <a
              href="/Th-tech/playground/"
              class="btn btn-primary cta-button"
            >
              <i class="fas fa-terminal"></i>
              ابدأ الآن
              <i class="fas fa-arrow-left"></i>
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>


  <Footer />


  <!-- Scroll Top -->

  <button
    id="scrollTop"
    class="scroll-top"
    aria-label="العودة إلى الأعلى"
    type="button"
  >
    <i class="fas fa-arrow-up"></i>
  </button>


  <!-- =====================================================
       CSS
  ====================================================== -->

  <style>

    :root {
      --bg: #070b14;
      --bg2: #0b1120;
      --bg3: #111827;

      --card: #101827;
      --card-hover: #142033;

      --text: #f8fafc;
      --text-muted: #94a3b8;

      --primary: #3b82f6;
      --primary-hover: #2563eb;

      --cyan: #06b6d4;

      --border: rgba(148, 163, 184, 0.14);
      --border-hover: rgba(59, 130, 246, 0.55);

      --shadow: rgba(0, 0, 0, 0.35);

      --header-bg: rgba(7, 11, 20, 0.72);
    }


    [data-theme="light"] {

      --bg: #f8fafc;
      --bg2: #ffffff;
      --bg3: #f1f5f9;

      --card: #ffffff;
      --card-hover: #f8fafc;

      --text: #0f172a;
      --text-muted: #64748b;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;

      --cyan: #0891b2;

      --border: rgba(15, 23, 42, 0.10);
      --border-hover: rgba(37, 99, 235, 0.40);

      --shadow: rgba(15, 23, 42, 0.10);

      --header-bg: rgba(255, 255, 255, 0.82);
    }


    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }


    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Cairo', sans-serif;
      line-height: 1.7;
      overflow-x: hidden;

      transition:
        background-color 0.25s ease,
        color 0.25s ease;
    }


    img {
      max-width: 100%;
    }


    a {
      color: inherit;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    .container {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
    }


    section {
      position: relative;
      padding: 100px 0;
    }


    /* =====================================================
       HERO
    ====================================================== */


    .hero {
      min-height: 760px;
      min-height: 100vh;

      display: flex;
      align-items: center;

      position: relative;

      padding:
        150px 0
        100px;

      overflow: hidden;
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: -2;
      overflow: hidden;
    }


    .hero-bg img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      filter:
        brightness(0.32)
        saturate(0.8);

      transform: scale(1.04);
    }


    [data-theme="light"] .hero-bg img {
      filter:
        brightness(0.52)
        saturate(0.7);
    }


    .hero-overlay {
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          circle at 75% 45%,
          rgba(37, 99, 235, 0.22),
          transparent 34%
        ),
        linear-gradient(
          180deg,
          rgba(7, 11, 20, 0.55),
          var(--bg) 96%
        );
    }


    .hero-grid {
      position: absolute;
      inset: 0;

      opacity: 0.18;

      background-image:
        linear-gradient(
          rgba(148, 163, 184, 0.12) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(148, 163, 184, 0.12) 1px,
          transparent 1px
        );

      background-size: 55px 55px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent
        );
    }


    .hero-glow {
      position: absolute;

      width: 450px;
      height: 450px;

      border-radius: 50%;

      filter: blur(80px);

      opacity: 0.18;

      pointer-events: none;
    }


    .glow-one {
      background: #2563eb;
      top: 10%;
      right: 5%;
    }


    .glow-two {
      background: #06b6d4;
      bottom: 5%;
      left: 10%;
    }


    .hero-container {
      width: 100%;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      gap: 70px;

      align-items: center;
    }


    .hero-content {
      position: relative;
      z-index: 2;
    }


    .badge {
      display: inline-flex;

      align-items: center;
      gap: 9px;

      padding: 8px 16px;

      border-radius: 999px;

      background:
        rgba(59, 130, 246, 0.12);

      border:
        1px solid rgba(96, 165, 250, 0.28);

      color: #bfdbfe;

      font-size: 0.86rem;

      font-weight: 700;

      margin-bottom: 25px;

      backdrop-filter: blur(10px);
    }


    [data-theme="light"] .badge {
      color: #dbeafe;
    }


    .badge i {
      color: #60a5fa;
    }


    .badge-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #22c55e;

      box-shadow:
        0 0 0 5px rgba(34, 197, 94, 0.10);

      animation: pulseDot 2s infinite;
    }


    @keyframes pulseDot {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(0.75);
        opacity: 0.65;
      }
    }


    h1 {
      font-size:
        clamp(2.4rem, 5vw, 4.5rem);

      line-height: 1.18;

      font-weight: 900;

      letter-spacing: -1.5px;

      margin-bottom: 25px;
    }


    .gradient-text {
      display: inline;

      background:
        linear-gradient(
          135deg,
          #60a5fa 0%,
          #38bdf8 45%,
          #22d3ee 100%
        );

      -webkit-background-clip: text;
      background-clip: text;

      -webkit-text-fill-color: transparent;
    }


    .cursor {
      color: #60a5fa;

      animation:
        cursorBlink 1s infinite;
    }


    @keyframes cursorBlink {

      0%,
      45% {
        opacity: 1;
      }

      50%,
      100% {
        opacity: 0;
      }
    }


    .hero-description {
      max-width: 650px;

      color: #cbd5e1;

      font-size: 1.08rem;

      line-height: 2;

      margin-bottom: 32px;
    }


    [data-theme="light"] .hero-description {
      color: #e2e8f0;
    }


    .hero-actions {
      display: flex;

      align-items: center;

      gap: 13px;

      flex-wrap: wrap;

      margin-bottom: 30px;
    }


    .btn {
      min-height: 54px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 10px;

      padding:
        0 22px;

      border-radius: 13px;

      border: 1px solid transparent;

      text-decoration: none;

      font-weight: 800;

      font-size: 0.94rem;

      cursor: pointer;

      transition:
        transform 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
    }


    .btn-primary {
      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          #1d4ed8
        );

      box-shadow:
        0 10px 30px
        rgba(37, 99, 235, 0.28);
    }


    .btn-primary:hover {
      transform: translateY(-3px);

      box-shadow:
        0 16px 35px
        rgba(37, 99, 235, 0.38);
    }


    .btn-secondary {
      background:
        rgba(15, 23, 42, 0.50);

      border-color:
        rgba(148, 163, 184, 0.22);

      color: white;

      backdrop-filter: blur(12px);
    }


    .btn-secondary:hover {
      transform: translateY(-3px);

      border-color:
        rgba(96, 165, 250, 0.6);

      background:
        rgba(37, 99, 235, 0.12);
    }


    .btn-arrow {
      font-size: 0.75rem;

      transition:
        transform 0.25s ease;
    }


    .btn:hover .btn-arrow {
      transform: translateX(-4px);
    }


    .hero-features {
      display: flex;

      align-items: center;

      gap: 25px;

      flex-wrap: wrap;
    }


    .hero-feature {
      display: flex;

      align-items: center;

      gap: 8px;

      color: #cbd5e1;

      font-size: 0.85rem;
    }


    .feature-check {
      width: 28px;
      height: 28px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 8px;

      background:
        rgba(59, 130, 246, 0.14);

      color: #60a5fa;

      font-size: 0.75rem;
    }


    /* =====================================================
       HERO VISUAL
    ====================================================== */


    .hero-visual {
      min-height: 520px;

      position: relative;

      display: flex;

      align-items: center;
      justify-content: center;
    }


    .visual-orbit {
      position: absolute;

      border:
        1px solid
        rgba(96, 165, 250, 0.13);

      border-radius: 50%;

      pointer-events: none;
    }


    .orbit-one {
      width: 460px;
      height: 460px;

      animation:
        orbitRotate 25s linear infinite;
    }


    .orbit-two {
      width: 350px;
      height: 350px;

      animation:
        orbitRotateReverse 20s linear infinite;
    }


    @keyframes orbitRotate {

      from {
        transform: rotate(0);
      }

      to {
        transform: rotate(360deg);
      }
    }


    @keyframes orbitRotateReverse {

      from {
        transform: rotate(360deg);
      }

      to {
        transform: rotate(0);
      }
    }


    .code-window {
      position: relative;

      z-index: 5;

      width: min(490px, 90%);

      border-radius: 18px;

      overflow: hidden;

      background:
        rgba(8, 13, 24, 0.88);

      border:
        1px solid
        rgba(148, 163, 184, 0.18);

      box-shadow:
        0 35px 90px
        rgba(0, 0, 0, 0.45),
        0 0 60px
        rgba(37, 99, 235, 0.13);

      backdrop-filter: blur(20px);

      animation:
        windowFloat 6s ease-in-out infinite;
    }


    @keyframes windowFloat {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-9px);
      }
    }


    .window-header {
      height: 52px;

      display: flex;

      align-items: center;
      justify-content: space-between;

      padding: 0 16px;

      background:
        rgba(15, 23, 42, 0.85);

      border-bottom:
        1px solid
        rgba(148, 163, 184, 0.12);
    }


    .window-dots {
      display: flex;

      gap: 6px;
    }


    .window-dots span {
      width: 9px;
      height: 9px;

      border-radius: 50%;

      background: #475569;
    }


    .window-title {
      display: flex;

      align-items: center;

      gap: 7px;

      color: #94a3b8;

      font-size: 0.73rem;

      direction: ltr;
    }


    .window-title i {
      color: #60a5fa;
    }


    .window-icon {
      color: #475569;

      font-size: 0.75rem;
    }


    .code-content {
      padding: 25px;

      direction: ltr;

      text-align: left;

      font-family:
        'Fira Code',
        'Courier New',
        monospace;

      font-size: 0.82rem;

      color: #e2e8f0;
    }


    .code-line {
      min-height: 30px;

      display: flex;

      align-items: center;

      gap: 7px;

      white-space: nowrap;
    }


    .line-number {
      width: 25px;

      color: #475569;

      user-select: none;
    }


    .indent {
      padding-left: 32px;
    }


    .purple {
      color: #c084fc;
    }


    .blue {
      color: #60a5fa;
    }


    .green {
      color: #4ade80;
    }


    .yellow {
      color: #facc15;
    }


    .terminal-output {
      margin-top: 25px;

      padding:
        12px 14px;

      display: flex;

      align-items: center;

      gap: 9px;

      border-radius: 9px;

      background:
        rgba(34, 197, 94, 0.07);

      border:
        1px solid
        rgba(34, 197, 94, 0.12);

      color: #86efac;

      font-size: 0.72rem;

      direction: ltr;
    }


    .terminal-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #22c55e;

      box-shadow:
        0 0 10px
        rgba(34, 197, 94, 0.7);
    }


    .floating-card {
      position: absolute;

      z-index: 10;

      display: flex;

      align-items: center;

      gap: 11px;

      padding:
        11px 14px;

      min-width: 145px;

      border-radius: 14px;

      background:
        rgba(15, 23, 42, 0.80);

      border:
        1px solid
        rgba(148, 163, 184, 0.18);

      box-shadow:
        0 15px 35px
        rgba(0, 0, 0, 0.30);

      backdrop-filter: blur(18px);

      color: white;

      animation:
        cardFloat 5s ease-in-out infinite;
    }


    .floating-card strong {
      display: block;

      font-size: 0.8rem;
    }


    .floating-card small {
      display: block;

      color: #94a3b8;

      font-size: 0.62rem;

      direction: ltr;

      text-align: right;
    }


    .floating-icon {
      width: 37px;
      height: 37px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 10px;

      font-size: 1.05rem;
    }


    .python-icon {
      color: #60a5fa;
      background: rgba(59, 130, 246, 0.12);
    }


    .js-icon {
      color: #facc15;
      background: rgba(250, 204, 21, 0.10);
    }


    .terminal-icon {
      color: #4ade80;
      background: rgba(34, 197, 94, 0.10);
    }


    .check-icon {
      color: #22d3ee;
      background: rgba(34, 211, 238, 0.10);
    }


    .float-python {
      top: 50px;
      left: 0;

      animation-delay: 0s;
    }


    .float-js {
      top: 155px;
      right: -10px;

      animation-delay: 1.2s;
    }


    .float-terminal {
      bottom: 100px;
      left: -15px;

      animation-delay: 2.2s;
    }


    .float-lessons {
      bottom: 35px;
      right: 35px;

      animation-delay: 3.2s;
    }


    @keyframes cardFloat {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-13px);
      }
    }


    .hero-scroll {
      position: absolute;

      bottom: 25px;
      left: 50%;

      transform: translateX(-50%);

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 5px;

      color: #64748b;

      font-size: 0.68rem;

      animation:
        scrollBounce 2s infinite;
    }


    @keyframes scrollBounce {

      0%,
      100% {
        transform:
          translateX(-50%)
          translateY(0);
      }

      50% {
        transform:
          translateX(-50%)
          translateY(7px);
      }
    }


    /* =====================================================
       TICKER
    ====================================================== */


    .tech-ticker {
      position: relative;

      overflow: hidden;

      padding: 17px 0;

      background: var(--bg2);

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);
    }


    .ticker-track {
      width: max-content;

      display: flex;

      align-items: center;

      gap: 60px;

      animation:
        ticker 35s linear infinite;
    }


    .tech-item {
      display: flex;

      align-items: center;

      gap: 9px;

      color: var(--text-muted);

      font-size: 0.82rem;

      font-weight: 700;

      white-space: nowrap;
    }


    .tech-item i {
      color: var(--primary);

      font-size: 1rem;
    }


    @keyframes ticker {

      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(50%);
      }
    }


    /* =====================================================
       STATS
    ====================================================== */


    .stats {
      padding: 65px 0;

      background:
        linear-gradient(
          180deg,
          var(--bg2),
          var(--bg)
        );

      border-bottom:
        1px solid var(--border);
    }


    .stats-grid {
      display: grid;

      grid-template-columns:
        1fr
        auto
        1fr
        auto
        1fr;

      align-items: center;

      max-width: 850px;

      margin: auto;
    }


    .stat-item {
      text-align: center;
    }


    .stat-icon-wrapper {
      width: 48px;
      height: 48px;

      display: flex;

      align-items: center;
      justify-content: center;

      margin:
        0 auto 13px;

      border-radius: 14px;

      color: var(--primary);

      background:
        rgba(59, 130, 246, 0.09);

      font-size: 1.15rem;
    }


    .stat-num {
      display: block;

      color: var(--primary);

      font-size: 2.4rem;

      line-height: 1.1;

      font-weight: 900;
    }


    .stat-label {
      color: var(--text-muted);

      font-size: 0.78rem;
    }


    .stat-divider {
      width: 1px;
      height: 60px;

      background: var(--border);
    }


    /* =====================================================
       SECTION HEADING
    ====================================================== */


    .section-heading {
      max-width: 700px;

      margin:
        0 auto 50px;

      text-align: center;
    }


    .section-kicker {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      margin-bottom: 12px;

      color: var(--primary);

      font-size: 0.76rem;

      font-weight: 800;

      letter-spacing: 0.3px;
    }


    .section-heading h2 {
      font-size:
        clamp(1.8rem, 4vw, 2.6rem);

      line-height: 1.3;

      font-weight: 900;

      margin-bottom: 12px;
    }


    .section-heading h2 span {
      color: var(--primary);
    }


    .section-heading p {
      color: var(--text-muted);

      font-size: 0.92rem;
    }


    /* =====================================================
       TRACKS
    ====================================================== */


    .tracks {
      background: var(--bg);
    }


    .tracks-grid {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 20px;
    }


    .track {
      min-width: 0;

      display: flex;

      flex-direction: column;

      overflow: hidden;

      border-radius: 18px;

      background: var(--card);

      border:
        1px solid var(--border);

      text-decoration: none;

      transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        background 0.35s ease;
    }


    .track:hover {
      transform: translateY(-9px);

      border-color:
        var(--border-hover);

      background: var(--card-hover);

      box-shadow:
        0 20px 45px var(--shadow);
    }


    .track-img {
      height: 205px;

      position: relative;

      overflow: hidden;
    }


    .track-img img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform 0.6s ease;
    }


    .track:hover .track-img img {
      transform: scale(1.08);
    }


    .track-overlay {
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          180deg,
          transparent 20%,
          rgba(2, 6, 23, 0.78)
        );
    }


    .track-number {
      position: absolute;

      top: 14px;
      right: 14px;

      padding: 4px 8px;

      border-radius: 7px;

      background:
        rgba(2, 6, 23, 0.60);

      color: #cbd5e1;

      font-size: 0.62rem;

      font-weight: 800;

      backdrop-filter: blur(8px);
    }


    .track-top-icon {
      position: absolute;

      bottom: 15px;
      right: 15px;

      width: 45px;
      height: 45px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background:
        rgba(37, 99, 235, 0.85);

      color: white;

      font-size: 1.1rem;

      box-shadow:
        0 8px 20px
        rgba(37, 99, 235, 0.3);
    }


    .track-body {
      padding: 21px;

      display: flex;

      flex-direction: column;

      flex: 1;
    }


    .track-category {
      color: var(--primary);

      font-size: 0.58rem;

      font-weight: 900;

      letter-spacing: 0.8px;

      direction: ltr;

      text-align: right;

      margin-bottom: 8px;
    }


    .track h3 {
      font-size: 1.15rem;

      font-weight: 900;

      margin-bottom: 7px;
    }


    .track-body > p {
      min-height: 55px;

      color: var(--text-muted);

      font-size: 0.78rem;

      line-height: 1.8;

      margin-bottom: 10px;
    }


    .track-list {
      list-style: none;

      margin-bottom: 15px;
    }


    .track-list li {
      display: flex;

      align-items: center;

      gap: 7px;

      color: var(--text-muted);

      font-size: 0.72rem;

      padding: 3px 0;
    }


    .track-list i {
      color: #22c55e;

      font-size: 0.65rem;
    }


    .track-link {
      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-top: auto;

      padding-top: 14px;

      border-top:
        1px solid var(--border);

      color: var(--primary);

      font-size: 0.73rem;

      font-weight: 800;
    }


    .track-link i {
      transition:
        transform 0.25s ease;
    }


    .track:hover .track-link i {
      transform: translateX(-5px);
    }


    /* =====================================================
       FEATURES
    ====================================================== */


    .features {
      background:
        var(--bg2);

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);
    }


    .features-grid {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 18px;
    }


    .feature-box {
      position: relative;

      overflow: hidden;

      padding: 32px 24px;

      border-radius: 18px;

      background: var(--card);

      border:
        1px solid var(--border);

      text-align: center;

      transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }


    .feature-box:hover {
      transform: translateY(-7px);

      border-color:
        var(--border-hover);

      box-shadow:
        0 18px 40px var(--shadow);
    }


    .feature-number {
      position: absolute;

      top: 13px;
      left: 16px;

      color: var(--primary);

      opacity: 0.18;

      font-size: 0.65rem;

      font-weight: 900;
    }


    .feature-icon {
      width: 65px;
      height: 65px;

      display: flex;

      align-items: center;
      justify-content: center;

      margin:
        0 auto 18px;

      border-radius: 18px;

      background:
        rgba(59, 130, 246, 0.09);

      color: var(--primary);

      font-size: 1.55rem;

      transition:
        transform 0.3s ease;
    }


    .feature-box:hover .feature-icon {
      transform:
        rotate(-5deg)
        scale(1.05);
    }


    .feature-box h3 {
      font-size: 1rem;

      font-weight: 900;

      margin-bottom: 8px;
    }


    .feature-box p {
      color: var(--text-muted);

      font-size: 0.75rem;

      line-height: 1.8;
    }


    /* =====================================================
       FAQ
    ====================================================== */


    .faq {
      background: var(--bg);
    }


    .faq-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;
    }


    .faq-item {
      display: grid;

      grid-template-columns: 50px 1fr;

      gap: 15px;

      padding: 22px;

      border-radius: 16px;

      background: var(--card);

      border:
        1px solid var(--border);

      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
    }


    .faq-item:hover {
      transform: translateY(-4px);

      border-color:
        var(--border-hover);
    }


    .faq-icon {
      width: 50px;
      height: 50px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        rgba(59, 130, 246, 0.09);

      color: var(--primary);

      font-size: 1rem;
    }


    .faq-item h3 {
      font-size: 0.9rem;

      font-weight: 800;

      margin-bottom: 5px;
    }


    .faq-item p {
      color: var(--text-muted);

      font-size: 0.72rem;

      line-height: 1.8;
    }


    /* =====================================================
       CTA
    ====================================================== */


    .cta {
      padding-top: 30px;

      padding-bottom: 100px;
    }


    .cta-box {
      position: relative;

      overflow: hidden;

      padding: 65px 30px;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          #0f274d,
          #0b1830
        );

      border:
        1px solid
        rgba(96, 165, 250, 0.20);

      text-align: center;

      box-shadow:
        0 25px 60px
        rgba(0, 0, 0, 0.25);
    }


    .cta-glow {
      position: absolute;

      width: 350px;
      height: 350px;

      top: -200px;
      left: 50%;

      transform: translateX(-50%);

      border-radius: 50%;

      background:
        rgba(37, 99, 235, 0.35);

      filter: blur(80px);

      pointer-events: none;
    }


    .cta-content {
      position: relative;

      z-index: 2;
    }


    .cta h2 {
      font-size:
        clamp(1.7rem, 4vw, 2.5rem);

      font-weight: 900;

      margin-bottom: 12px;

      color: white;
    }


    .cta h2 span {
      color: #60a5fa;
    }


    .cta p {
      color: #94a3b8;

      font-size: 0.9rem;

      margin-bottom: 25px;
    }


    .cta-button {
      margin: auto;
    }


    /* =====================================================
       SCROLL TOP
    ====================================================== */


    .scroll-top {
      position: fixed;

      bottom: 24px;
      left: 24px;

      width: 48px;
      height: 48px;

      display: flex;

      align-items: center;
      justify-content: center;

      border: 0;

      border-radius: 14px;

      background:
        var(--primary);

      color: white;

      cursor: pointer;

      z-index: 999;

      opacity: 0;
      visibility: hidden;

      transform: translateY(15px);

      transition:
        opacity 0.3s ease,
        visibility 0.3s ease,
        transform 0.3s ease,
        background 0.3s ease;

      box-shadow:
        0 10px 25px
        rgba(37, 99, 235, 0.30);
    }


    .scroll-top.show {
      opacity: 1;

      visibility: visible;

      transform: translateY(0);
    }


    .scroll-top:hover {
      background:
        var(--primary-hover);

      transform:
        translateY(-3px);
    }


    /* =====================================================
       TABLET
    ====================================================== */


    @media (max-width: 1100px) {

      .hero-container {
        gap: 35px;
      }


      .tracks-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }


      .features-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }


      .hero-visual {
        transform:
          scale(0.90);
      }

    }


    /* =====================================================
       MOBILE
    ====================================================== */


    @media (max-width: 850px) {

      section {
        padding: 75px 0;
      }


      .container {
        width:
          min(
            100% - 30px,
            700px
          );
      }


      .hero {
        min-height: auto;

        padding:
          130px 0 80px;
      }


      .hero-container {
        grid-template-columns: 1fr;

        text-align: center;

        gap: 30px;
      }


      .hero-content {
        display: flex;

        flex-direction: column;

        align-items: center;
      }


      .hero-description {
        max-width: 600px;

        font-size: 0.94rem;
      }


      .hero-actions {
        justify-content: center;
      }


      .hero-features {
        justify-content: center;
      }


      .hero-visual {
        display: none;
      }


      .hero-scroll {
        display: none;
      }


      .stats-grid {
        grid-template-columns: 1fr;

        gap: 25px;
      }


      .stat-divider {
        width: 70px;
        height: 1px;

        margin: auto;
      }


      .faq-grid {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      section {
        padding: 60px 0;
      }


      .container {
        width:
          calc(100% - 24px);
      }


      .hero {
        padding:
          115px 0 65px;
      }


      .badge {
        font-size: 0.72rem;

        padding:
          7px 12px;
      }


      h1 {
        font-size:
          clamp(
            2rem,
            9vw,
            2.7rem
          );

        letter-spacing: -0.7px;
      }


      .hero-description {
        font-size: 0.84rem;

        line-height: 1.9;
      }


      .hero-actions {
        width: 100%;

        flex-direction: column;
      }


      .btn {
        width: 100%;
      }


      .hero-features {
        width: 100%;

        flex-direction: column;

        gap: 10px;
      }


      .hero-feature {
        justify-content: center;

        font-size: 0.75rem;
      }


      .tracks-grid,
      .features-grid {
        grid-template-columns: 1fr;
      }


      .track-img {
        height: 190px;
      }


      .section-heading {
        margin-bottom: 35px;
      }


      .section-heading h2 {
        font-size: 1.7rem;
      }


      .section-heading p {
        font-size: 0.78rem;
      }


      .feature-box {
        padding: 27px 20px;
      }


      .faq-item {
        grid-template-columns: 43px 1fr;

        padding: 17px;

        gap: 12px;
      }


      .faq-icon {
        width: 43px;
        height: 43px;
      }


      .faq-item h3 {
        font-size: 0.8rem;
      }


      .faq-item p {
        font-size: 0.68rem;
      }


      .cta {
        padding-top: 15px;
        padding-bottom: 65px;
      }


      .cta-box {
        padding:
          45px 18px;
      }


      .cta h2 {
        font-size: 1.55rem;
      }


      .cta p {
        font-size: 0.75rem;
      }


      .scroll-top {
        width: 44px;
        height: 44px;

        bottom: 16px;
        left: 16px;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }

    }

  </style>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script is:inline>
    (() => {

      /* ===================================================
         TYPEWRITER
      =================================================== */

      const typewriter =
        document.getElementById('typewriter');

      const text =
        'المستقبل الرقمي بأدوات احترافية';

      let typeIndex = 0;

      if (typewriter) {

        const typeText = () => {

          if (typeIndex < text.length) {

            typewriter.textContent +=
              text.charAt(typeIndex);

            typeIndex++;

            window.setTimeout(
              typeText,
              70
            );

          }

        };

        window.setTimeout(
          typeText,
          450
        );
      }


      /* ===================================================
         COUNTERS
      =================================================== */

      const counters =
        document.querySelectorAll('.stat-num');

      const counterObserver =
        new IntersectionObserver(
          (entries, observer) => {

            entries.forEach(entry => {

              if (!entry.isIntersecting) {
                return;
              }

              const counter =
                entry.target;

              const target =
                Number(
                  counter.getAttribute(
                    'data-target'
                  ) || 0
                );

              const suffix =
                counter.getAttribute(
                  'data-suffix'
                ) || '';

              let startTime = null;

              const duration = 1400;

              const animate = timestamp => {

                if (!startTime) {
                  startTime = timestamp;
                }

                const progress =
                  Math.min(
                    (timestamp - startTime) /
                    duration,
                    1
                  );

                const eased =
                  1 -
                  Math.pow(
                    1 - progress,
                    3
                  );

                const current =
                  Math.floor(
                    target * eased
                  );

                counter.textContent =
                  current + suffix;

                if (progress < 1) {

                  window.requestAnimationFrame(
                    animate
                  );

                } else {

                  counter.textContent =
                    target + suffix;

                }

              };

              window.requestAnimationFrame(
                animate
              );

              observer.unobserve(
                counter
              );

            });

          },
          {
            threshold: 0.35
          }
        );


      counters.forEach(counter => {
        counterObserver.observe(counter);
      });


      /* ===================================================
         SCROLL TOP
      =================================================== */

      const scrollTop =
        document.getElementById('scrollTop');


      const updateScrollButton = () => {

        if (!scrollTop) {
          return;
        }

        if (window.scrollY > 350) {

          scrollTop.classList.add(
            'show'
          );

        } else {

          scrollTop.classList.remove(
            'show'
          );

        }

      };


      window.addEventListener(
        'scroll',
        updateScrollButton,
        {
          passive: true
        }
      );


      if (scrollTop) {

        scrollTop.addEventListener(
          'click',
          () => {

            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });

          }
        );

      }


      /* ===================================================
         THEME SYNCHRONIZATION
         
         مهم جداً:
         لا نعتمد فقط على themeChange لأن Header
         قد يغير الثيم قبل تحميل هذا السكربت.
      =================================================== */


      const applyCurrentTheme = () => {

        const currentTheme =
          document.documentElement.getAttribute(
            'data-theme'
          );

        if (
          currentTheme !== 'light' &&
          currentTheme !== 'dark'
        ) {

          document.documentElement.setAttribute(
            'data-theme',
            'dark'
          );

        }

      };


      applyCurrentTheme();


      /* مراقبة أي تغيير في data-theme من Header */

      const themeObserver =
        new MutationObserver(
          mutations => {

            mutations.forEach(mutation => {

              if (
                mutation.type === 'attributes' &&
                mutation.attributeName === 'data-theme'
              ) {

                applyCurrentTheme();

              }

            });

          }
        );


      themeObserver.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['data-theme']
        }
      );


      /* دعم الحدث المستخدم في Header */

      window.addEventListener(
        'themeChange',
        event => {

          const theme =
            event &&
            event.detail;

          if (
            theme === 'light' ||
            theme === 'dark'
          ) {

            document.documentElement.setAttribute(
              'data-theme',
              theme
            );

            try {

              localStorage.setItem(
                'theme',
                theme
              );

            } catch (error) {
              /* localStorage unavailable */
            }

          }

        }
      );


      /* دعم تغيير الثيم من تبويب آخر */

      window.addEventListener(
        'storage',
        event => {

          if (
            event.key === 'theme' &&
            (
              event.newValue === 'light' ||
              event.newValue === 'dark'
            )
          ) {

            document.documentElement.setAttribute(
              'data-theme',
              event.newValue
            );

          }

        }
      );

    })();
  </script>

</body>
