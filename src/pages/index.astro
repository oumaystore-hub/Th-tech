}
</style>

<script>
function showMessage() {
  alert('🎉 مرحباً بك في Th.Tech!');
}
<\/script>`,

    java: `// مرحباً بك في محرر Java
public class Main {
    public static void main(String[] args) {
        System.out.println("مرحباً بك في Java! 🎉");
        
        // حساب المجموع
        int[] numbers = {1, 2, 3, 4, 5};
        int sum = 0;
        for (int num : numbers) {
            sum += num;
        }
        System.out.println("المجموع: " + sum);
