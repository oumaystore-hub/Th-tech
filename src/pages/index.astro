---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | المنصة التقنية</title>
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <script>
    (function() {
      const saved = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920" alt="Tech" />
        <div class="overlay"></div>
      </div>
      
      <div class="container hero-container">
        <div class="hero-content">
          <span class="badge"><i class="fas fa-rocket"></i> اكتشف، تعلّم، وابتكر</span>
          <h1>
            ابنِ <span id="typewriter" class="gradient-text"></span><span class="cursor">|</span>
          </h1>
          <p>منصة رائدة توفر شروحات تقنية معمقة، أدلة مرجعية شاملة، ومختبر أكواد تفاعلي.</p>
          
          <div class="hero-actions">
            <a href="/Th-tech/playground/" class="btn btn-primary">
              <i class="fas fa-code"></i> ابدأ البرمجة الآن
            </a>
            <a href="/Th-tech/guides/" class="btn btn-secondary">
              <i class="fas fa-book"></i> تصفح المكتبة
            </a>
          </div>
          
          <div class="hero-features">
            <div class="hero-feature"><i class="fas fa-bolt"></i><span>تنفيذ فوري</span></div>
            <div class="hero-feature"><i class="fas fa-shield-alt"></i><span>آمن 100%</span></div>
            <div class="hero-feature"><i class="fas fa-gift"></i><span>مجاني تماماً</span></div>
          </div>
        </div>

        <!-- Floating Cards -增加了更多图标 -->
        <div class="hero-visual">
          <div class="float-card card-1">
            <i class="fab fa-python"></i>
            <div class="code-box">
              <div>print("مرحباً")</div>
              <div style="color:var(--text-muted)"># Python 3.11</div>
            </div>
          </div>
          <div class="float-card card-2">
            <i class="fab fa-js"></i>
            <span>JavaScript</span>
          </div>
          <div class="float-card card-3">
            <i class="fas fa-terminal"></i>
            <span>Terminal</span>
          </div>
          <div class="float-card card-4">
            <i class="fas fa-check-circle"></i>
            <span>+150 درس</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Ticker -->
    <div class="tech-ticker">
      <div class="ticker-track">
        <span class="tech-item"><i class="fab fa-js"></i> JavaScript</span>
        <span class="tech-item"><i class="fab fa-python"></i> Python</span>
        <span class="tech-item"><i class="fab fa-react"></i> React</span>
        <span class="tech-item"><i class="fab fa-aws"></i> AWS</span>
        <span class="tech-item"><i class="fas fa-shield-alt"></i> CyberSec</span>
        <span class="tech-item"><i class="fab fa-docker"></i> Docker</span>
        <span class="tech-item"><i class="fab fa-node"></i> Node.js</span>
        <span class="tech-item"><i class="fas fa-database"></i> SQL</span>
      </div>
    </div>

    <!-- Stats -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <i class="fas fa-book-open stat-icon"></i>
            <span class="stat-num" data-target="150" data-suffix="+">0</span>
            <span>دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <i class="fas fa-users stat-icon"></i>
            <span class="stat-num" data-target="50" data-suffix="K+">0</span>
            <span>قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <i class="fas fa-percentage stat-icon"></i>
            <span class="stat-num" data-target="100" data-suffix="%">0</span>
            <span>محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tracks -->
    <section class="tracks">
      <div class="container">
        <h2><i class="fas fa-graduation-cap"></i> مسارات التعلم</h2>
        <div class="tracks-grid">
          <a href="/Th-tech/ai/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600" alt="AI" /></div>
            <div class="track-body">
              <div class="icon"><i class="fas fa-brain"></i></div>
              <h3>الذكاء الاصطناعي</h3>
              <p>تعلم الآلة والشبكات العصبية</p>
              <ul class="track-list">
                <li><i class="fas fa-check"></i> Machine Learning</li>
                <li><i class="fas fa-check"></i> Deep Learning</li>
              </ul>
            </div>
          </a>

          <a href="/Th-tech/programming/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600" alt="Code" /></div>
            <div class="track-body">
              <div class="icon"><i class="fas fa-code"></i></div>
              <h3>البرمجة</h3>
              <p>تطوير التطبيقات و DevOps</p>
              <ul class="track-list">
                <li><i class="fas fa-check"></i> Full Stack</li>
                <li><i class="fas fa-check"></i> DevOps</li>
              </ul>
            </div>
          </a>

          <a href="/Th-tech/security/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600" alt="Security" /></div>
            <div class="track-body">
              <div class="icon"><i class="fas fa-lock"></i></div>
              <h3>الأمن السيبراني</h3>
              <p>اختبار الاختراق والحماية</p>
              <ul class="track-list">
                <li><i class="fas fa-check"></i> Ethical Hacking</li>
                <li><i class="fas fa-check"></i> Security</li>
              </ul>
            </div>
          </a>

          <a href="/Th-tech/cloud/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600" alt="Cloud" /></div>
            <div class="track-body">
              <div class="icon"><i class="fas fa-cloud"></i></div>
              <h3>السحابة</h3>
              <p>AWS و Kubernetes</p>
              <ul class="track-list">
                <li><i class="fas fa-check"></i> AWS</li>
                <li><i class="fas fa-check"></i> Docker</li>
              </ul>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="container">
        <h2><i class="fas fa-star"></i> لماذا Th.Tech؟</h2>
        <div class="features-grid">
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-bolt"></i></div>
            <h3>سرعة فائقة</h3>
            <p>تنفيذ الكود فوراً بدون انتظار</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-mobile-alt"></i></div>
            <h3>متجاوب</h3>
            <p>يعمل على جميع الأجهزة</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-save"></i></div>
            <h3>حفظ تلقائي</h3>
            <p>كودك يُحفظ في المتصفح</p>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-download"></i></div>
            <h3>تصدير سهل</h3>
            <p>حمّل أكوادك بصيغ مختلفة</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="container">
        <h2><i class="fas fa-question-circle"></i> الأسئلة الشائعة</h2>
        <div class="faq-grid">
          <div class="faq-item"><h3><i class="fas fa-user-graduate"></i> هل أحتاج خبرة سابقة؟</h3><p>لا! نبدأ معك من الصفر حتى الاحتراف.</p></div>
          <div class="faq-item"><h3><i class="fas fa-terminal"></i> كيف أستخدم المحرر؟</h3><p>اكتب الكود واضغط "تشغيل".</p></div>
          <div class="faq-item"><h3><i class="fas fa-save"></i> هل يمكنني حفظ أعمالي؟</h3><p>نعم! يُحفظ تلقائياً.</p></div>
          <div class="faq-item"><h3><i class="fas fa-code"></i> ما اللغات المدعومة؟</h3><p>Python و JavaScript و HTML.</p></div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <button id="scrollTop" class="scroll-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
    <i class="fas fa-arrow-up"></i>
  </button>

  <style>
    /* CSS Variables - Dark Mode (Default) */
    :root {
      --bg: #0b1120;
      --bg2: #0f172a;
      --bg3: #1e293b;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --border: #1e293b;
      --card: #1e293b;
      --shadow: rgba(0, 0, 0, 0.3);
    }
    
    /* Light Mode */
    [data-theme="light"] {
      --bg: #ffffff;
      --bg2: #f8fafc;
      --bg3: #f1f5f9;
      --text: #0f172a;
      --text-muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --border: #e2e8f0;
      --card: #ffffff;
      --shadow: rgba(31, 55, 75, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html {
      scroll-behavior: smooth;
    }
    
    body { 
      background: var(--bg); 
      color: var(--text); 
      font-family: 'Cairo', sans-serif; 
      line-height: 1.6;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    
    .container { 
      max-width: 1200px; 
      margin: 0 auto; 
      padding: 0 1.5rem; 
    }
    
    section { padding: 4rem 0; }

    /* Hero - Fixed for mobile */
    .hero { 
      min-height: 100vh; 
      display: flex; 
      align-items: center; 
      position: relative; 
      padding: 120px 0 80px;
      overflow: hidden;
    }
    
    .hero-bg { 
      position: absolute; 
      inset: 0; 
      z-index: -1; 
    }
    
    .hero-bg img { 
      width: 100%; 
      height: 100%; 
      object-fit: cover; 
      filter: brightness(0.4); 
    }
    
    .overlay { 
      position: absolute; 
      inset: 0; 
      background: linear-gradient(to bottom, rgba(11,17,32,0.7), var(--bg)); 
    }
    
    .hero-container { 
      display: grid; 
      grid-template-columns: 1fr 1fr; 
      gap: 3rem; 
      align-items: center; 
      width: 100%;
    }
    
    .badge { 
      display: inline-block; 
      background: rgba(59,130,246,0.2); 
      color: var(--primary); 
      padding: 0.5rem 1.5rem; 
      border-radius: 50px; 
      margin-bottom: 1.5rem; 
      font-weight: 700;
      border: 1px solid var(--border);
    }
    
    h1 { 
      font-size: clamp(2rem, 5vw, 3.5rem); 
      margin-bottom: 1.5rem;
      line-height: 1.2;
    }
    
    .gradient-text { 
      background: linear-gradient(135deg, var(--primary), #06b6d4); 
      -webkit-background-clip: text; 
      -webkit-text-fill-color: transparent; 
    }
    
    .cursor { 
      animation: blink 1s infinite; 
      color: var(--primary);
    }
    
    @keyframes blink { 
      50% { opacity: 0; } 
    }
    
    .hero-content p { 
      color: var(--text-muted); 
      margin-bottom: 2rem; 
      line-height: 1.8;
      font-size: 1.1rem;
    }
    
    .hero-actions { 
      display: flex; 
      gap: 1rem; 
      margin-bottom: 2rem; 
      flex-wrap: wrap; 
    }
    
    .btn { 
      padding: 1rem 2rem; 
      border-radius: 12px; 
      font-weight: 700; 
      text-decoration: none; 
      transition: all 0.3s; 
      cursor: pointer; 
      border: none; 
      display: inline-flex; 
      align-items: center; 
      gap: 0.5rem;
      font-size: 1rem;
    }
    
    .btn-primary { 
      background: var(--primary); 
      color: white;
      box-shadow: 0 4px 15px rgba(59,130,246,0.3);
    }
    
    .btn-primary:hover { 
      transform: translateY(-2px); 
      box-shadow: 0 8px 25px rgba(59,130,246,0.4);
      background: var(--primary-hover);
    }
    
    .btn-secondary { 
      background: var(--card); 
      color: var(--text); 
      border: 2px solid var(--border);
    }
    
    .btn-secondary:hover { 
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-2px);
    }
    
    .hero-features { 
      display: flex; 
      gap: 2rem; 
      flex-wrap: wrap; 
    }
    
    .hero-feature { 
      display: flex; 
      align-items: center; 
      gap: 0.5rem; 
      color: var(--text-muted); 
      font-size: 0.9rem; 
    }
    
    .hero-feature i { 
      color: var(--primary);
      font-size: 1.2rem;
    }

    /* Floating Cards - Improved */
    .hero-visual { 
      position: relative; 
      height: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .float-card { 
      position: absolute;
      background: var(--card); 
      backdrop-filter: blur(10px); 
      padding: 1.2rem; 
      border-radius: 12px; 
      border: 1px solid var(--border);
      box-shadow: 0 10px 30px var(--shadow);
      animation: float 6s ease-in-out infinite;
      display: flex; 
      align-items: center; 
      gap: 0.8rem; 
      color: var(--text); 
      font-weight: 600;
      font-size: 0.9rem;
    }
    
    .float-card i {
      font-size: 1.8rem;
    }
    
    .float-card.card-1 { 
      top: 50px; 
      left: 0; 
      width: 220px;
      flex-direction: column;
      animation-delay: 0s;
    }
    
    .float-card.card-2 { 
      top: 200px; 
      right: 0;
      animation-delay: 1.5s;
    }
    
    .float-card.card-3 { 
      bottom: 150px; 
      left: 50px;
      animation-delay: 3s;
    }
    
    .float-card.card-4 { 
      bottom: 50px; 
      right: 100px;
      animation-delay: 4.5s;
    }
    
    .code-box { 
      font-family: 'Fira Code', monospace; 
      direction: ltr; 
      text-align: left; 
      width: 100%;
      font-size: 0.85rem;
    }
    
    @keyframes float { 
      0%, 100% { transform: translateY(0); } 
      50% { transform: translateY(-20px); } 
    }

    /* Ticker */
    .tech-ticker { 
      background: var(--bg2); 
      padding: 1rem 0; 
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      overflow: hidden; 
    }
    
    .ticker-track { 
      display: flex; 
      gap: 3rem; 
      width: max-content; 
      animation: scroll 30s linear infinite; 
    }
    
    .tech-item { 
      color: var(--text-muted); 
      font-weight: 600; 
      display: flex; 
      align-items: center; 
      gap: 0.5rem;
      white-space: nowrap;
    }
    
    @keyframes scroll { 
      0% { transform: translateX(0); } 
      100% { transform: translateX(-50%); } 
    }

    /* Stats */
    .stats { 
      background: var(--bg2); 
      padding: 3rem 0; 
      border-bottom: 1px solid var(--border); 
    }
    
    .stats-grid { 
      display: flex; 
      justify-content: center; 
      align-items: center; 
      gap: 4rem;
      flex-wrap: wrap;
    }
    
    .stat-item {
      text-align: center;
    }
    
    .stat-icon { 
      font-size: 2rem; 
      color: var(--primary); 
      display: block; 
      margin-bottom: 0.5rem; 
    }
    
    .stat-num { 
      display: block; 
      font-size: 2.5rem; 
      font-weight: 800; 
      color: var(--primary);
      line-height: 1;
    }
    
    .stat-item span:last-child {
      color: var(--text-muted);
      font-size: 0.9rem;
    }
    
    .divider { 
      width: 1px; 
      height: 60px; 
      background: var(--border); 
    }

    /* Tracks */
    h2 { 
      text-align: center; 
      font-size: 2rem; 
      margin-bottom: 3rem;
      color: var(--text);
    }
    
    h2 i { 
      color: var(--primary); 
      margin-left: 0.5rem; 
    }
    
    .tracks-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
      gap: 2rem; 
    }
    
    .track { 
      background: var(--card); 
      border: 1px solid var(--border); 
      border-radius: 12px; 
      overflow: hidden; 
      text-decoration: none; 
      color: var(--text); 
      transition: all 0.3s;
      display: flex;
      flex-direction: column;
    }
    
    .track:hover { 
      transform: translateY(-5px); 
      border-color: var(--primary);
      box-shadow: 0 10px 30px var(--shadow);
    }
    
    .track-img { 
      height: 180px; 
      overflow: hidden; 
    }
    
    .track-img img { 
      width: 100%; 
      height: 100%; 
      object-fit: cover;
      transition: transform 0.5s;
    }
    
    .track:hover .track-img img {
      transform: scale(1.1);
    }
    
    .track-body { 
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    
    .icon { 
      width: 50px; 
      height: 50px; 
      background: var(--bg3); 
      border-radius: 10px; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      color: var(--primary); 
      font-size: 1.5rem; 
      margin-bottom: 1rem; 
    }
    
    h3 { 
      margin-bottom: 0.5rem; 
      font-size: 1.2rem;
      color: var(--text);
    }
    
    .track-body > p { 
      color: var(--text-muted); 
      font-size: 0.9rem; 
      margin-bottom: 1rem;
    }
    
    .track-list { 
      list-style: none; 
      margin-top: auto;
    }
    
    .track-list li { 
      padding: 0.4rem 0; 
      color: var(--text-muted); 
      font-size: 0.85rem;
      display: flex;
      align-items: center;
    }
    
    .track-list i { 
      color: var(--primary); 
      margin-left: 0.5rem; 
      font-size: 0.7rem; 
    }

    /* Features */
    .features { 
      background: var(--bg); 
    }
    
    .features-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
      gap: 2rem; 
    }
    
    .feature-box { 
      background: var(--card); 
      border: 1px solid var(--border); 
      border-radius: 12px; 
      padding: 2rem; 
      text-align: center; 
      transition: all 0.3s; 
    }
    
    .feature-box:hover { 
      transform: translateY(-5px); 
      border-color: var(--primary);
      box-shadow: 0 10px 30px var(--shadow);
    }
    
    .feature-icon { 
      width: 70px; 
      height: 70px; 
      background: var(--bg3); 
      border-radius: 50%; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      color: var(--primary); 
      font-size: 2rem; 
      margin: 0 auto 1rem; 
    }
    
    .feature-box h3 { 
      margin-bottom: 0.5rem;
      color: var(--text);
    }
    
    .feature-box p { 
      margin: 0; 
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    /* FAQ */
    .faq { 
      background: var(--bg2); 
    }
    
    .faq-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
      gap: 1.5rem; 
    }
    
    .faq-item { 
      background: var(--card); 
      padding: 1.5rem; 
      border-radius: 12px; 
      border: 1px solid var(--border);
      transition: all 0.3s;
    }
    
    .faq-item:hover {
      border-color: var(--primary);
      transform: translateY(-3px);
    }
    
    .faq-item h3 { 
      color: var(--primary); 
      margin-bottom: 1rem; 
      font-size: 1.1rem; 
      display: flex; 
      align-items: center; 
      gap: 0.5rem; 
    }
    
    .faq-item p { 
      margin: 0;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Scroll Top */
    .scroll-top { 
      position: fixed; 
      bottom: 2rem; 
      left: 2rem; 
      width: 50px; 
      height: 50px; 
      background: var(--primary); 
      color: white; 
      border: none; 
      border-radius: 50%; 
      cursor: pointer; 
      opacity: 0; 
      transition: all 0.3s; 
      z-index: 999; 
      font-size: 1.2rem;
      box-shadow: 0 4px 15px rgba(59,130,246,0.4);
    }
    
    .scroll-top.show { 
      opacity: 1; 
    }
    
    .scroll-top:hover { 
      transform: translateY(-3px);
      background: var(--primary-hover);
    }

    /* Mobile Responsive - Improved */
    @media (max-width: 968px) {
      .hero-container { 
        grid-template-columns: 1fr; 
        text-align: center;
        gap: 2rem;
      }
      
      .hero-content {
        order: 1;
      }
      
      .hero-visual { 
        display: none; 
      }
      
      .hero-features { 
        justify-content: center; 
      }
      
      .hero-actions {
        justify-content: center;
      }
      
      .btn {
        width: 100%;
        justify-content: center;
      }
      
      .stats-grid { 
        gap: 2rem; 
      }
      
      .divider { 
        width: 50px; 
        height: 1px; 
      }
      
      .tracks-grid, 
      .features-grid, 
      .faq-grid { 
        grid-template-columns: 1fr; 
      }
      
      h1 {
        font-size: 2rem;
      }
      
      .hero {
        padding: 100px 0 60px;
      }
      
      section {
        padding: 3rem 0;
      }
    }
    
    @media (max-width: 640px) {
      .container {
        padding: 0 1rem;
      }
      
      .hero-actions {
        flex-direction: column;
      }
      
      .btn {
        width: 100%;
      }
      
      .hero-features {
        flex-direction: column;
        gap: 1rem;
      }
      
      .stats-grid {
        flex-direction: column;
      }
      
      .tech-ticker {
        padding: 0.8rem 0;
      }
      
      .tech-item {
        font-size: 0.85rem;
      }
      
      h2 {
        font-size: 1.5rem;
      }
      
      .track-list li {
        font-size: 0.8rem;
      }
    }
  </style>

  <script>
    // Typewriter
    const text = "المستقبل الرقمي بأدوات احترافية";
    let i = 0;
    function type() {
      if (i < text.length) {
        document.getElementById('typewriter').textContent += text.charAt(i);
        i++;
        setTimeout(type, 80);
      }
    }
    setTimeout(type, 500);

    // Counters
    document.querySelectorAll('.stat-num').forEach(counter => {
      const target = +counter.dataset.target;
      const suffix = counter.dataset.suffix || '';
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            let current = 0;
            const update = () => {
              current += target / 50;
              if (current >= target) {
                counter.textContent = target + suffix;
              } else {
                counter.textContent = Math.floor(current) + suffix;
                requestAnimationFrame(update);
              }
            };
            update();
            observer.unobserve(entry.target);
          }
        });
      });
      observer.observe(counter);
    });

    // Scroll Top
    window.addEventListener('scroll', () => {
      const btn = document.getElementById('scrollTop');
      if (window.scrollY > 300) btn.classList.add('show');
      else btn.classList.remove('show');
    });

    // Listen for theme changes
    window.addEventListener('themeChange', (e) => {
      document.documentElement.setAttribute('data-theme', e.detail);
    });
  </script>
</body>
</html>
