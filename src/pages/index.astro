            <i class="fa-solid fa-compass"></i>
            مجالات التقنية
          </span>

          <h2 id="tracks-title">
            استكشف مجالاتك المفضلة
          </h2>

        </div>

        <div class="tracks-grid">

          {
            tracks.map((track) => (
              <a
                href={`${base}/${track.slug}/`}
                class="track-card"
              >

                <div class="track-image">

                  <img
                    src={track.image}
                    alt={track.title}
                    loading="lazy"
                    decoding="async"
                  />

                  <div class="track-image-overlay"></div>

                  <div class="track-icon">
                    <i class={`fa-solid ${track.icon}`}></i>
                  </div>

                </div>

                <div class="track-content">

                  <h3>{track.title}</h3>

                  <p>{track.description}</p>

                  <div class="track-tags">
                    {
                      track.tags.map((tag) => (
                        <span>{tag}</span>
                      ))
                    }
                  </div>

                  <span class="track-link">
                    استكشف المجال
                    <i class="fa-solid fa-arrow-left"></i>
                  </span>

                </div>

              </a>
            ))
          }

        </div>

      </div>
    </section>

    <!-- ==========================================
         FAQ
         ========================================== -->

    <section
      class="faq-section"
      aria-labelledby="faq-title"
    >

      <div class="container faq-container">

        <div class="section-heading compact-heading">

          <span class="section-kicker">
            <i class="fa-solid fa-circle-question"></i>
            الأسئلة الشائعة
          </span>

          <h2 id="faq-title">
            قبل أن تبدأ
          </h2>

        </div>

        <div class="faq-list">

          {
            faqs.map((faq, index) => (
              <details
                class="faq-item"
                open={index === 0}
              >

                <summary>

                  <span>{faq.question}</span>

                  <i class="fa-solid fa-plus"></i>

                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>

              </details>
            ))
          }

        </div>

      </div>
    </section>

    <!-- ==========================================
         CTA
         ========================================== -->

    <section class="cta-section">

      <div class="container">

        <div class="cta-box">

          <div class="cta-icon">
            <i class="fa-solid fa-rocket"></i>
          </div>

          <h2>
            ابدأ رحلتك التقنية
          </h2>

          <p>
            اختر الأداة التي تحتاجها أو استكشف المجالات والمحتوى المتاح
            على Th.Tech.
          </p>

          <div class="cta-actions">

            <a
              href={`${base}/tools/`}
              class="btn btn-primary"
            >
              <i class="fa-solid fa-toolbox"></i>
              استكشف الأدوات
            </a>

            <a
              href={`${base}/contact/`}
              class="btn btn-secondary"
            >
              <i class="fa-solid fa-envelope"></i>
              تواصل معنا
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

  <button
    id="scroll-top"
    class="scroll-top"
    aria-label="العودة إلى أعلى الصفحة"
    type="button"
  >
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <Footer />
</body>
</html>

