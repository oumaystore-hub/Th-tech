---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/animations.css';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | منصة المستقبل التقني</title>
  <meta name="description" content="المنصة العربية الأولى في الذكاء الاصطناعي، الهندسة البرمجية، والأمن السيبراني." />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6QW7XVX75J"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6QW7XVX75J');
  </script>
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!--  Hero Section -->
    <section class="hero-advanced">
      <div class="aurora-bg">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
      </div>
      
      <div class="container hero-content">
        <div class="hero-badge reveal-delay-1">
          <span class="badge-dot"></span>
          <span>نحو المستقبل الرقمي</span>
        </div>
        
        <h1 class="reveal-delay-2">
          <span class="text-gradient">صُغ مستقبلك</span> الرقمي
          <br />
          <span class="hero-sub">بأحدث التقنيات العالمية</span>
        </h1>
        
        <p class="hero-desc reveal-delay-3">
          منصة تعليمية احترافية تدمج بين عمق المحتوى وسلاسة التصميم، لتمكينك من إتقان الذكاء الاصطناعي، البرمجة، والأمن السيبراني.
        </p>
        
        <div class="hero-cta reveal-delay-4">
          <a href="/Th-tech/guides/" class="btn btn-primary">
            <span>استكشف الأدلة</span>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </a>
          <a href="/Th-tech/articles/" class="btn btn-glass">تصفح المكتبة</a>
        </div>

        <!-- شريط متحرك بجمل كاملة -->
        <div class="tech-marquee reveal-delay-4">
          <div class="marquee-track">
            <span class="marquee-item">🚀 تعلم الذكاء الاصطناعي من الصفر للاحتراف</span>
            <span class="marquee-item"> إتقان البرمجة بأحدث الأطر التقنية</span>
            <span class="marquee-item">🔒 حماية بياناتك بأفضل استراتيجيات الأمن السيبراني</span>
            <span class="marquee-item">☁️ نشر تطبيقاتك على السحابة باحترافية</span>
            <span class="marquee-item"> تحليل البيانات الضخمة بذكاء</span>
            <span class="marquee-item">🤖 بناء نماذج تعلم آلي متقدمة</span>
            <!-- تكرار -->
            <span class="marquee-item">🚀 تعلم الذكاء الاصطناعي من الصفر للاحتراف</span>
            <span class="marquee-item">💻 إتقان البرمجة بأحدث الأطر التقنية</span>
            <span class="marquee-item">🔒 حماية بياناتك بأفضل استراتيجيات الأمن السيبراني</span>
            <span class="marquee-item">☁️ نشر تطبيقاتك على السحابة باحترافية</span>
            <span class="marquee-item">📊 تحليل البيانات الضخمة بذكاء</span>
            <span class="marquee-item">🤖 بناء نماذج تعلم آلي متقدمة</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Stats Section (ميزة جديدة) -->
    <section class="stats-section reveal">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon">📚</div>
            <div class="stat-number counter" data-target="150" data-suffix="+">0</div>
            <div class="stat-label">دليل شامل</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-number counter" data-target="50" data-suffix="K+">0</div>
            <div class="stat-label">قارئ شهرياً</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-number counter" data-target="100" data-suffix="%">0</div>
            <div class="stat-label">محتوى مجاني</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-number counter" data-target="24" data-suffix="/7">0</div>
            <div class="stat-label">دعم متواصل</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Bento Grid Features -->
    <section class="bento-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">مسارات التميز التقني</h2>
          <p class="section-subtitle">اختر تخصصك وابدأ رحلة الاحتراف</p>
        </div>
        
        <div class="bento-grid">
          <!-- AI Card with Image -->
          <div class="bento-card card-large reveal-delay-1">
            <div class="card-image-top">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=400&fit=crop" alt="AI" loading="lazy" />
              <div class="card-overlay"></div>
            </div>
            <div class="card-content">
              <div class="card-icon-svg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
              <h3>الذكاء الاصطناعي التوليدي</h3>
              <p>استكشف نماذج اللغة الكبيرة (LLMs) وتطبيقات الذكاء الاصطناعي في المشاريع الواقعية.</p>
              <ul class="feature-tags">
                <li>Machine Learning</li>
                <li>Neural Networks</li>
                <li>NLP</li>
              </ul>
              <a href="/Th-tech/ai/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>

          <!-- Security Card -->
          <div class="bento-card reveal-delay-2">
            <div class="card-image-top small">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=400&h=250&fit=crop" alt="Security" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-icon-svg security-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              </div>
              <h3>الأمن السيبراني</h3>
              <p>حماية البيانات والتحليل الجنائي الرقمي.</p>
              <a href="/Th-tech/security/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>

          <!-- Code Card -->
          <div class="bento-card reveal-delay-3">
            <div class="card-image-top small">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=250&fit=crop" alt="Code" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-icon-svg code-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                  <line x1="12" y1="2" x2="12" y2="22"></line>
                </svg>
              </div>
              <h3>هندسة البرمجيات</h3>
              <p>بناء أنظمة قوية وقابلة للتوسع.</p>
              <a href="/Th-tech/programming/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>

          <!-- Cloud Card -->
          <div class="bento-card reveal-delay-4">
            <div class="card-image-top small">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400&h=250&fit=crop" alt="Cloud" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-icon-svg cloud-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                </svg>
              </div>
              <h3>الحوسبة السحابية</h3>
              <p>AWS، Azure، و DevOps.</p>
              <a href="/Th-tech/cloud/" class="card-link">اكتشف المسار <span>→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Features Highlights (ميزة جديدة) -->
    <section class="features-highlights reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">لماذا Th.Tech؟</h2>
        </div>
        <div class="highlights-grid">
          <div class="highlight-item">
            <div class="highlight-icon"></div>
            <h4>محتوى تطبيقي</h4>
            <p>شروحات عملية مع أمثلة واقعية قابلة للتطبيق الفوري في مشاريعك</p>
          </div>
          <div class="highlight-item">
            <div class="highlight-icon">🔄</div>
            <h4>تحديث مستمر</h4>
            <p>محتوى يُحدَّث أسبوعياً بأحدث التقنيات والاتجاهات العالمية</p>
          </div>
          <div class="highlight-item">
            <div class="highlight-icon">🎯</div>
            <h4>مسار تعلم واضح</h4>
            <p>من الأساسيات إلى الاحتراف مع مسارات تعلم منظمة ومرتبة</p>
          </div>
          <div class="highlight-item">
            <div class="highlight-icon">‍🏫</div>
            <h4>خبراء متخصصون</h4>
            <p>محتوى يُعدّ بواسطة خبراء في المجال التقني بسنوات خبرة</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Auto-Scrolling Articles Slider -->
    <section class="slider-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">أحدث الإصدارات</h2>
          <p class="section-subtitle">مقالات تقنية مختارة بعناية</p>
        </div>
        
        <div class="slider-wrapper">
          <div class="slider-track" id="sliderTrack">
            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
                <div class="slide-badge">جديد</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-ai">AI</span><span class="read-time">5 دقائق</span></div>
                <h3>دليلك الشامل لتعلم الآلة</h3>
                <p>رحلة عملية من الصفر للاحتراف في بناء النماذج.</p>
              </div>
            </article>

            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
                <div class="slide-badge popular">شائع</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-sec">Security</span><span class="read-time">8 دقائق</span></div>
                <h3>استراتيجيات الدفاع السيبراني</h3>
                <p>كيف تحمي مؤسستك من أحدث التهديدات.</p>
              </div>
            </article>

            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Code" loading="lazy" />
                <div class="slide-badge updated">محدّث</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-code">Code</span><span class="read-time">6 دقائق</span></div>
                <h3>مبادئ SOLID للمحترفين</h3>
                <p>الأنماط التصميمية التي تفصل بين الكود العادي والاحترافي.</p>
              </div>
            </article>

            <article class="slide-card">
              <div class="slide-image">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop" alt="Cloud" loading="lazy" />
                <div class="slide-badge">جديد</div>
              </div>
              <div class="slide-content">
                <div class="slide-meta"><span class="cat-cloud">Cloud</span><span class="read-time">10 دقائق</span></div>
                <h3>أمن السحابة في AWS</h3>
                <p>أفضل الممارسات لتأمين بنيتك التحتية.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Testimonials (ميزة جديدة) -->
    <section class="testimonials-section reveal">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">آراء مجتمعنا</h2>
          <p class="section-subtitle">ماذا يقول مطورونا عن المنصة</p>
        </div>
        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="testimonial-text">"منصة استثنائية! ساعدتني في الانتقال من المبتدئ إلى المحترف في الذكاء الاصطناعي. المحتوى عملي ومباشر."</div>
            <div class="testimonial-author">
              <div class="author-avatar">أ</div>
              <div class="author-info">
                <div class="author-name">أحمد محمد</div>
                <div class="author-role">مطور ذكاء اصطناعي</div>
              </div>
            </div>
          </div>
          <div class="testimonial-card">
            <div class="testimonial-text">"أفضل منصة عربية تعلمت منها الأمن السيبراني. الشروحات واضحة والأمثلة تطبيقية 100%."</div>
            <div class="testimonial-author">
              <div class="author-avatar">س</div>
              <div class="author-info">
                <div class="author-name">سارة أحمد</div>
                <div class="author-role">أخصائية أمن سيبراني</div>
              </div>
            </div>
          </div>
          <div class="testimonial-card">
            <div class="testimonial-text">"المحتوى محدّث باستمرار ويعكس أحدث التقنيات. أنصح كل مطور بالانضمام لهذا المجتمع."</div>
            <div class="testimonial-author">
              <div class="author-avatar">خ</div>
              <div class="author-info">
                <div class="author-name">خالد علي</div>
                <div class="author-role">مهندس برمجيات</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA Section -->
    <section class="cta-section reveal">
      <div class="container">
        <div class="cta-box">
          <div class="cta-bg-glow"></div>
          <div class="cta-content">
            <h2>🚀 انضم إلى النخبة</h2>
            <p>انضم لآلاف المطورين الذين يبنون المستقبل معنا. احصل على أحدث المقالات مباشرة.</p>
            <form class="newsletter-form-inline">
              <input type="email" placeholder="بريدك الإلكتروني..." required />
              <button type="submit" class="btn btn-primary">اشترك الآن</button>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #0b0c10;
    --bg-card: #15171e;
    --text: #ffffff;
    --text-muted: #9ca3af;
    --primary: #3b82f6;
    --primary-glow: #2563eb;
    --accent: #8b5cf6;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.2);
    --radius: 20px;
    --radius-sm: 12px;
    --font-main: 'Cairo', sans-serif;
    --font-mono: 'Inter', sans-serif;
  }

  html.light-mode {
    --bg: #f8fafc;
    --bg-card: #ffffff;
    --text: #0f172a;
    --text-muted: #64748b;
    --border: rgba(0, 0, 0, 0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-title { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.8rem; }
  .section-subtitle { color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  /* Hero */
  .hero-advanced {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 6rem 0 4rem;
  }

  .aurora-bg { position: absolute; inset: 0; z-index: -1; }
  .aurora-blob {
    position: absolute;
    filter: blur(80px);
    opacity: 0.6;
    animation: floatBlob 10s infinite alternate ease-in-out;
  }
  .blob-1 { top: -10%; left: -10%; width: 500px; height: 500px; background: rgba(59, 130, 246, 0.4); }
  .blob-2 { bottom: -10%; right: -10%; width: 600px; height: 600px; background: rgba(139, 92, 246, 0.3); animation-delay: -5s; }

  @keyframes floatBlob {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -30px) scale(1.1); }
  }

  .hero-content { position: relative; z-index: 1; max-width: 900px; }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .badge-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981; }

  .hero-advanced h1 { font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1.5rem; font-weight: 900; }
  .text-gradient {
    background: linear-gradient(135deg, #fff 0%, #3b82f6 50%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub { display: block; font-size: 0.5em; color: var(--text-muted); font-weight: 600; margin-top: 0.5rem; }
  .hero-desc { font-size: 1.15rem; color: var(--text-muted); max-width: 650px; margin: 0 auto 2.5rem; line-height: 1.8; }

  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s;
    cursor: pointer;
    border: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(59, 130, 246, 0.6); }
  .btn-icon { width: 20px; height: 20px; }
  
  .btn-glass {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid var(--border);
  }
  .btn-glass:hover { background: rgba(255, 255, 255, 0.1); }

  /* Marquee with Sentences */
  .tech-marquee {
    width: 100%;
    overflow: hidden;
    padding: 1.5rem 0;
    background: rgba(255,255,255,0.02);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .marquee-track {
    display: flex;
    gap: 3rem;
    animation: scrollMarquee 40s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @keyframes scrollMarquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* Stats Section */
