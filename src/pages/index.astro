---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>Th.Tech | المستقبل الرقمي</title>
  <meta name="description" content="منصة متخصصة في الذكاء الاصطناعي والبرمجة والأمن السيبراني" />
  <link rel="canonical" href="https://oumaystore-hub.github.io/Th-tech/" />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <Header />

  <main class="main-wrapper">
    
    <!-- 🔹 Hero Section مع صورة -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="badge">🚀 نحو المستقبل</div>
            <h1>
              <span class="gradient-text">صُغ مستقبلك</span>
              <br />الرقمي معنا
            </h1>
            <p class="hero-text">منصة عربية متخصصة في الذكاء الاصطناعي، البرمجة، والأمن السيبراني</p>
            
            <div class="hero-buttons">
              <a href="/Th-tech/guides/" class="btn btn-primary">استكشف الأدلة</a>
              <a href="/Th-tech/articles/" class="btn btn-secondary">المقالات</a>
            </div>
          </div>
          
          <div class="hero-image">
            <div class="image-wrapper">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop" alt="AI Technology" loading="eager" />
              <div class="image-overlay"></div>
              
              <!-- Floating Cards -->
              <div class="floating-card card-1">
                <span class="float-icon"></span>
                <span>AI Powered</span>
              </div>
              
              <div class="floating-card card-2">
                <span class="float-icon">⚡</span>
                <span>Fast Learning</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <span class="stat-value counter" data-target="150" data-suffix="+">0</span>
            <span class="stat-label">دليل شامل</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value counter" data-target="50" data-suffix="K+">0</span>
            <span class="stat-label">قارئ شهرياً</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value counter" data-target="100" data-suffix="%">0</span>
            <span class="stat-label">محتوى مجاني</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 🔹 Features Grid -->
    <section class="features">
      <div class="container">
        <div class="section-header">
          <h2>مسارات التعلم</h2>
          <p>اختر تخصصك وابدأ الرحلة</p>
        </div>

        <div class="features-grid">
          <a href="/Th-tech/ai/" class="feature-card">
            <div class="card-icon ai-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3>الذكاء الاصطناعي</h3>
            <p>تعلم الآلة والشبكات العصبية</p>
          </a>

          <a href="/Th-tech/programming/" class="feature-card">
            <div class="card-icon code-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <h3>البرمجة</h3>
            <p>لغات وأطر حديثة</p>
          </a>

          <a href="/Th-tech/security/" class="feature-card">
            <div class="card-icon security-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3>الأمن السيبراني</h3>
            <p>حماية واختراق أخلاقي</p>
          </a>

          <a href="/Th-tech/cloud/" class="feature-card">
            <div class="card-icon cloud-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
              </svg>
            </div>
            <h3>السحابة</h3>
            <p>AWS و Azure</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 🔹 Why Section -->
    <section class="why">
      <div class="container">
        <div class="why-grid">
          <div class="why-content">
            <h2>لماذا Th.Tech؟</h2>
            <p class="why-text">محتوى تقني معمق يُواكب أحدث الابتكارات العالمية</p>
            
            <div class="why-list">
              <div class="why-item">
                <div class="why-icon"></div>
                <div>
                  <h4>محتوى تطبيقي</h4>
                  <p>أمثلة واقعية قابلة للتطبيق</p>
                </div>
              </div>
              
              <div class="why-item">
                <div class="why-icon"></div>
                <div>
                  <h4>تحديث مستمر</h4>
                  <p>أحدث التقنيات أسبوعياً</p>
                </div>
              </div>
              
              <div class="why-item">
                <div class="why-icon">🎯</div>
                <div>
                  <h4>مسار واضح</h4>
                  <p>من الأساسيات للاحتراف</p>
                </div>
              </div>
            </div>
          </div>

          <div class="why-visual">
            <div class="visual-card">
              <div class="visual-icon">📚</div>
              <div class="visual-number counter" data-target="150" data-suffix="+">0</div>
              <div class="visual-label">دليل شامل</div>
            </div>
            <div class="visual-card">
              <div class="visual-icon">👥</div>
              <div class="visual-number counter" data-target="50" data-suffix="K+">0</div>
              <div class="visual-label">قارئ شهرياً</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--  Articles Section -->
    <section class="articles">
      <div class="container">
        <div class="section-header">
          <h2>أحدث المقالات</h2>
          <p>محتوى محدّث باستمرار</p>
        </div>

        <div class="articles-grid">
          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop" alt="AI" loading="lazy" />
              <span class="article-badge">جديد</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag ai">AI</span>
                <span class="time">5 دقائق</span>
              </div>
              <h3>دليلك الشامل لتعلم الآلة</h3>
              <p>رحلة عملية من الصفر للاحتراف</p>
            </div>
          </article>

          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=400&fit=crop" alt="Security" loading="lazy" />
              <span class="article-badge popular">شائع</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag security">Security</span>
                <span class="time">8 دقائق</span>
              </div>
              <h3>أمن السحابة: أفضل الممارسات</h3>
              <p>استراتيجيات حماية متقدمة</p>
            </div>
          </article>

          <article class="article-card">
            <div class="article-image">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=400&fit=crop" alt="Code" loading="lazy" />
              <span class="article-badge updated">محدّث</span>
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="tag code">Code</span>
                <span class="time">6 دقائق</span>
              </div>
              <h3>مبادئ SOLID للمحترفين</h3>
              <p>الأنماط التصميمية الاحترافية</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 🔹 Newsletter -->
    <section class="newsletter">
      <div class="container">
        <div class="newsletter-box">
          <div class="newsletter-icon"></div>
          <h2>اشترك في نشرتنا</h2>
          <p>احصل على أحدث المقالات مباشرة في بريدك</p>
          <form class="newsletter-form">
            <input type="email" placeholder="أدخل بريدك الإلكتروني" required />
            <button type="submit" class="btn btn-primary">اشترك الآن</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 🔹 CTA -->
    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <h2>🚀 ابدأ رحلتك الآن</h2>
          <p>انضم لآلاف المطورين</p>
          <a href="/Th-tech/guides/" class="btn btn-light btn-large">تصفح الأدلة</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>

<style>
  :root {
    --bg: #fafafa;
    --card: #ffffff;
    --text: #0f172a;
    --text-muted: #64748b;
    --primary: #0284c7;
    --primary-light: #38bdf8;
    --border: #e2e8f0;
    --radius: 16px;
    --shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.1);
  }

  html.dark-mode {
    --bg: #0f172a;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --border: #334155;
    --shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
    --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.5);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    line-height: 1.6;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* === Hero Section === */
  .hero {
    min-height: 90vh;
    padding: 6rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(2,132,199,0.08) 0%, transparent 60%);
    z-index: -1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .hero-content { max-width: 600px; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(2,132,199,0.1);
    color: var(--primary);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 2rem;
    border: 1px solid rgba(2,132,199,0.2);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 15px rgba(2,132,199,0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(2,132,199,0.4);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 2px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-2px);
  }

  .btn-light {
    background: white;
    color: var(--primary);
  }

  .btn-light:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .btn-large { padding: 1rem 2.5rem; font-size: 1.1rem; }

  /* Hero Image */
  .hero-image {
    position: relative;
  }

  .image-wrapper {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2,132,199,0.2), transparent);
  }

  .floating-card {
    position: absolute;
    background: var(--card);
    padding: 0.8rem 1.2rem;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
    animation: float 3s ease-in-out infinite;
  }

  .float-icon { font-size: 1.2rem; }

  .card-1 {
    top: 20px;
    left: -20px;
    animation-delay: 0s;
  }

  .card-2 {
    bottom: 40px;
    right: -20px;
    animation-delay: 1.5s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem;
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .stat { text-align: center; }
  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .stat-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .stat-divider {
    width: 1px;
    height: 50px;
    background: var(--border);
  }

  /* === Features === */
  .features { padding: 5rem 0; background: var(--card); }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-header h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
  }
  
  .section-header p {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--bg);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    text-align: center;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--border);
    transition: all 0.3s;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
  }

  .card-icon {
    width: 65px;
    height: 65px;
    margin: 0 auto 1.2rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(2,132,199,0.1);
    color: var(--primary);
  }

  .card-icon svg { width: 32px; height: 32px; }

  .feature-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .feature-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* === Why Section === */
  .why { padding: 5rem 0; background: var(--bg); }
  
  .why-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .why-content h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .why-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .why-list { display: flex; flex-direction: column; gap: 1.8rem; }

  .why-item {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .why-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .why-item h4 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
    font-weight: 700;
  }

  .why-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .why-visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .visual-card {
    background: var(--card);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid var(--border);
  }

  .visual-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .visual-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .visual-label {
    color: var(--text-muted);
    font-weight: 600;
  }

  /* === Articles === */
  .articles { padding: 5rem 0; background: var(--card); }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .article-card {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: all 0.3s;
    text-decoration: none;
    color: var(--text);
  }

  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .article-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    background: #10b981;
    color: white;
  }

  .article-badge.popular { background: #f59e0b; }
  .article-badge.updated { background: #3b82f6; }

  .article-content { padding: 1.5rem; }

  .article-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    font-size: 0.85rem;
  }

  .tag {
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .tag.ai { background: rgba(59,130,246,0.1); color: #3b82f6; }
  .tag.security { background: rgba(239,68,68,0.1); color: #ef4444; }
  .tag.code { background: rgba(16,185,129,0.1); color: #10b981; }

  .time { color: var(--text-muted); }

  .article-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-content p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* === Newsletter === */
  .newsletter { padding: 4rem 0; background: var(--bg); }
  
  .newsletter-box {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    background: var(--card);
    padding: 3rem 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .newsletter-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .newsletter-box h2 {
    font-size: 1.8rem;
    margin-bottom: 0.8rem;
    font-weight: 700;
  }

  .newsletter-box p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.8rem;
    max-width: 450px;
