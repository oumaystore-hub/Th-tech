    return f"مرحباً {name}! 🎉"

print(greet("المطور"))

# حساب المجموع
numbers = [1, 2, 3, 4, 5]
total = sum(numbers)
print(f"المجموع: {total}")

# استخدام مكتبة math
import math
print(f"الجذر التربيعي لـ 16 = {math.sqrt(16)}")`,

    html: `<!-- بطاقة تفاعلية -->
<div class="card">
  <h2>مرحباً بك!</h2>
  <p>هذه بطاقة HTML مع تنسيق CSS</p>
  <button onclick="showMessage()">اضغط هنا</button>
</div>

<style>
