---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://oumaystore-hub.github.io';

const tools = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(tools)
  .map((file) => file.match(/\.\/tools\/([^/]+)\/index\.astro$/)?.[1])
  .filter(Boolean);

const displayName = (slug) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolsData = toolSlugs.map((slug) => ({
  slug,
  name: displayName(slug),
  href: `${base}/tools/${slug}/`
}));

const toolsCount = toolsData.length;

const featuredSlugs = [
  'json-formatter',
  'json-validator',
  'base64-encoder-decoder',
  'qr-code-generator',
  'color-picker',
  'api-request-builder'
];

const featuredTools = featuredSlugs
  .map((slug) => toolsData.find((tool) => tool.slug === slug))
  .filter(Boolean);

const remainingTools = toolsData
  .filter((tool) => !featuredSlugs.includes(tool.slug))
  .slice(0, 12);

const tracks = [
  {
    icon: '🤖',
    title: 'الذكاء الاصطناعي',
    description: 'اكتشف أدوات وتقنيات الذكاء الاصطناعي الحديثة.',
    tag: 'AI',
    href: '#tools'
  },
  {
    icon: '💻',
    title: 'البرمجة',
    description: 'أدوات عملية تساعدك على كتابة وتحليل وتحسين الكود.',
    tag: 'CODE',
    href: '#tools'
  },
  {
    icon: '🛡️',
    title: 'الأمن السيبراني',
    description: 'أدوات مفيدة للتشفير والتحقق وتحليل البيانات.',
    tag: 'SECURITY',
    href: '#tools'
  },
  {
    icon: '☁️',
    title: 'الويب والسحابة',
    description: 'أدوات للمطورين وأصحاب المواقع والمشاريع الرقمية.',
    tag: 'WEB',
    href: '#tools'
  }
];

const faqs = [
  {
    q: 'ما هي منصة Th.Tech؟',
    a: 'Th.Tech هي منصة تقنية عربية تجمع أدوات ويب مجانية ومحتوى تقني يساعد المطورين والطلاب وصناع المحتوى والمستخدمين على إنجاز مهامهم بسرعة.'
  },
  {
    q: 'هل الأدوات مجانية؟',
    a: 'نعم، الأدوات الموجودة في المنصة مصممة للاستخدام المجاني مباشرة من المتصفح.'
  },
  {
    q: 'هل يتم إرسال بياناتي إلى خادم خارجي؟',
    a: 'معظم الأدوات تعمل مباشرة داخل المتصفح. تختلف آلية المعالجة حسب الأداة، لذلك يفضل دائماً مراجعة وصف الأداة قبل التعامل مع بيانات حساسة.'
  },
  {
    q: 'هل يمكنني استخدام الأدوات من الهاتف؟',
    a: 'نعم. تم تصميم واجهة المنصة والأدوات لتعمل على الهواتف والأجهزة اللوحية وأجهزة الكمبيوتر.'
  },
  {
    q: 'هل تحتاج الأدوات إلى تثبيت برامج؟',
    a: 'لا. الهدف من المنصة هو توفير أدوات عملية يمكن استخدامها مباشرة من المتصفح دون الحاجة إلى تثبيت برامج إضافية.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Th.Tech',
  url: `${siteUrl}${base}/`,
  description: 'منصة تقنية عربية للأدوات والبرمجة والذكاء الاصطناعي',
  inLanguage: 'ar',
  publisher: {
    '@type': 'Organization',
    name: 'Th.Tech',
    url: `${siteUrl}${base}/`,
    sameAs: [
      'https://www.facebook.com/share/1PzewvX774/',
      'https://www.instagram.com/thtech.ma',
      'https://x.com/thtechma',
      'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438',
      'https://www.youtube.com/@thtechma'
    ]
  }
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Th.Tech | منصة تقنية عربية للأدوات والبرمجة والذكاء الاصطناعي</title>

    <meta
      name="description"
      content="Th.Tech منصة تقنية عربية تضم أدوات مجانية للبرمجة والذكاء الاصطناعي والأمن السيبراني والويب، مع تجربة سريعة ومباشرة من المتصفح."
    />

    <meta
      name="keywords"
      content="أدوات تقنية, أدوات برمجة, ذكاء اصطناعي, أدوات ويب, JSON, API, QR, Base64, مطورين, Th.Tech"
    />

    <meta name="theme-color" content="#08111f" />

    <link rel="canonical" href={`${siteUrl}${base}/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --bg: #f6f9fc;
        --bg-soft: #eef6fb;
        --surface: rgba(255, 255, 255, 0.82);
        --surface-solid: #ffffff;
        --text: #0f172a;
        --text-soft: #526174;
        --border: rgba(15, 23, 42, 0.09);

        --primary: #0891b2;
        --primary-2: #2563eb;
        --accent: #7c3aed;
        --cyan: #06b6d4;

        --shadow:
          0 20px 60px rgba(15, 23, 42, 0.08);

        --radius-xl: 30px;
        --radius-lg: 22px;
        --radius-md: 16px;

        --container: 1180px;
      }

      html.dark-mode {
        --bg: #060b14;
        --bg-soft: #0a1220;
        --surface: rgba(15, 23, 42, 0.72);
        --surface-solid: #0f172a;
        --text: #f8fafc;
        --text-soft: #94a3b8;
        --border: rgba(148, 163, 184, 0.12);

        --primary: #22d3ee;
        --primary-2: #60a5fa;
        --accent: #a78bfa;
        --cyan: #67e8f9;

        --shadow:
          0 25px 70px rgba(0, 0, 0, 0.32);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background:
          radial-gradient(
            circle at 10% 10%,
            rgba(34, 211, 238, 0.07),
            transparent 25%
          ),
          radial-gradient(
            circle at 90% 20%,
            rgba(124, 58, 237, 0.06),
            transparent 25%
          ),
          var(--bg);
        color: var(--text);
        overflow-x: hidden;
        transition:
          background 0.35s ease,
          color 0.35s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .container {
        width: min(var(--container), calc(100% - 40px));
        margin-inline: auto;
      }

      /* ========================================
         BACKGROUND
         ======================================== */

      .page-background {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -5;
        overflow: hidden;
      }

      .bg-grid {
        position: absolute;
        inset: 0;

        background-image:
          linear-gradient(
            rgba(14, 165, 233, 0.035) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(14, 165, 233, 0.035) 1px,
            transparent 1px
          );

        background-size: 44px 44px;

        mask-image: linear-gradient(
          to bottom,
          black,
          transparent 70%
        );
      }

      .bg-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.25;
      }

      .bg-orb-one {
        width: 320px;
        height: 320px;
        top: 5%;
        right: -100px;
        background: #22d3ee;
        animation: backgroundOrbOne 15s ease-in-out infinite;
      }

      .bg-orb-two {
        width: 280px;
        height: 280px;
        top: 30%;
        left: -100px;
        background: #6366f1;
        animation: backgroundOrbTwo 18s ease-in-out infinite;
      }

      @keyframes backgroundOrbOne {
        0%, 100% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(-50px, 35px, 0);
        }
      }

      @keyframes backgroundOrbTwo {
        0%, 100% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(55px, -30px, 0);
        }
      }

      /* ========================================
         HERO
         ======================================== */

      .hero {
        position: relative;
        min-height: 720px;
        padding:
          90px 0
          70px;

        display: flex;
        align-items: center;

        overflow: hidden;
      }

      .hero-grid {
        position: relative;
        z-index: 2;

        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 70px;
      }

      .hero-content {
        animation: heroContentIn 0.9s ease both;
      }

      @keyframes heroContentIn {
        from {
          opacity: 0;
          transform: translateY(25px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 8px 13px;

        border: 1px solid var(--border);
        border-radius: 999px;

        background: var(--surface);

        backdrop-filter: blur(14px);

        color: var(--text-soft);
        font-size: 13px;
        font-weight: 700;

        box-shadow:
          0 8px 30px rgba(15, 23, 42, 0.05);
      }

      .hero-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--cyan);
        box-shadow:
          0 0 0 5px rgba(34, 211, 238, 0.1),
          0 0 15px rgba(34, 211, 238, 0.6);

        animation: badgePulse 2s ease-in-out infinite;
      }

      @keyframes badgePulse {
        50% {
          transform: scale(1.3);
          opacity: 0.7;
        }
      }

      .hero h1 {
        margin: 22px 0 18px;

        max-width: 720px;

        font-size: clamp(42px, 6vw, 72px);
        line-height: 1.08;
        letter-spacing: -2.5px;
        font-weight: 900;
      }

      .hero h1 .gradient-text {
        background:
          linear-gradient(
            100deg,
            var(--primary),
            var(--primary-2),
            var(--accent)
          );

        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;

        background-size: 200% auto;

        animation: gradientMove 5s ease infinite;
      }

      @keyframes gradientMove {
        0%, 100% {
          background-position: 0% center;
        }

        50% {
          background-position: 100% center;
        }
      }

      .hero-description {
        max-width: 650px;

        margin: 0;

        color: var(--text-soft);

        font-size: 18px;
        line-height: 2;

        font-weight: 500;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;

        margin-top: 30px;
      }

      .btn {
        min-height: 50px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;

        padding: 0 20px;

        border-radius: 14px;

        border: 1px solid var(--border);

        font-weight: 800;

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          border-color 0.25s ease;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .btn-primary {
        color: white;

        background:
          linear-gradient(
            135deg,
            #0891b2,
            #2563eb,
            #6366f1
          );

        border-color: transparent;

        box-shadow:
          0 12px 30px rgba(37, 99, 235, 0.25);
      }

      .btn-primary:hover {
        box-shadow:
          0 18px 40px rgba(37, 99, 235, 0.32);
      }

      .btn-secondary {
        background: var(--surface);
        color: var(--text);
        backdrop-filter: blur(12px);
      }

      .hero-trust {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;

        margin-top: 25px;

        color: var(--text-soft);
        font-size: 12px;
        font-weight: 600;
      }

      .hero-trust span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .hero-trust i {
        color: var(--primary);
      }

      /* ========================================
         PROFESSIONAL LOGO
         ======================================== */

      .hero-visual {
        position: relative;

        min-height: 520px;

        display: flex;
        align-items: center;
        justify-content: center;

        animation: visualIn 1s 0.15s ease both;
      }

      @keyframes visualIn {
        from {
          opacity: 0;
          transform: scale(0.94);
        }

        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .th-tech-logo-core {
        --logo-cyan: #22d3ee;
        --logo-blue: #38bdf8;
        --logo-indigo: #6366f1;

        position: relative;

        width: 410px;
        height: 410px;

        display: flex;
        align-items: center;
        justify-content: center;

        isolation: isolate;
      }

      .logo-main {
        position: relative;
        z-index: 10;

        width: 225px;
        height: 225px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background:
          radial-gradient(
            circle at 30% 20%,
            rgba(34, 211, 238, 0.18),
            transparent 38%
          ),
          radial-gradient(
            circle at 75% 80%,
            rgba(99, 102, 241, 0.2),
            transparent 45%
          ),
          rgba(10, 18, 32, 0.92);

        border:
          1px solid rgba(103, 232, 249, 0.35);

        box-shadow:
          0 0 25px rgba(34, 211, 238, 0.18),
          0 0 65px rgba(59, 130, 246, 0.15),
          inset 0 0 40px rgba(56, 189, 248, 0.08);

        backdrop-filter: blur(16px);

        animation:
          logoFloat 5s ease-in-out infinite;
      }

      .logo-main::before {
        content: "";

        position: absolute;
        inset: 10px;

        border-radius: 50%;

        border:
          1px solid rgba(255, 255, 255, 0.08);

        pointer-events: none;
      }

      .logo-glow {
        position: absolute;
        inset: -30px;

        border-radius: 50%;

        background:
          radial-gradient(
            circle,
            rgba(34, 211, 238, 0.22),
            rgba(99, 102, 241, 0.1) 35%,
            transparent 70%
          );

        filter: blur(17px);

        z-index: -1;

        animation:
          logoGlow 3.5s ease-in-out infinite;
      }

      .logo-symbol {
        position: relative;

        width: 105px;
        height: 105px;

        display: flex;
        align-items: center;
        justify-content: center;

        animation:
          logoSymbolFloat 4s ease-in-out infinite;
      }

      .logo-symbol svg {
        width: 100%;
        height: 100%;

        filter:
          drop-shadow(
            0 0 8px
            rgba(34, 211, 238, 0.35)
          )
          drop-shadow(
            0 0 22px
            rgba(99, 102, 241, 0.2)
          );
      }

      .logo-name {
        margin-top: 2px;

        font-family: "Cairo", sans-serif;

        font-size: 28px;
        line-height: 1;

        font-weight: 900;
        letter-spacing: -1px;

        background:
          linear-gradient(
            90deg,
            #67e8f9,
            #38bdf8,
            #818cf8
          );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
      }

      .logo-name strong {
        font-weight: 900;
      }

      .logo-subtitle {
        margin-top: 9px;

        color: rgba(186, 230, 253, 0.68);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 8px;
        font-weight: 600;

        letter-spacing: 2.5px;
      }

      .logo-ring {
        position: absolute;

        top: 50%;
        left: 50%;

        border-radius: 50%;

        pointer-events: none;

        transform:
          translate(-50%, -50%);
      }

      .ring-one {
        width: 275px;
        height: 275px;

        border:
          1px solid rgba(34, 211, 238, 0.2);

        border-top-color:
          rgba(34, 211, 238, 0.9);

        border-right-color:
          rgba(99, 102, 241, 0.45);

        animation:
          ringRotateOne 12s linear infinite;
      }

      .ring-two {
        width: 330px;
        height: 330px;

        border:
          1px dashed rgba(99, 102, 241, 0.22);

        border-left-color:
          rgba(34, 211, 238, 0.78);

        animation:
          ringRotateTwo 18s linear infinite;
      }

      .ring-three {
        width: 380px;
        height: 380px;

        border:
          1px solid rgba(56, 189, 248, 0.09);

        border-bottom-color:
          rgba(129, 140, 248, 0.6);

        animation:
          ringRotateThree 25s linear infinite;
      }

      .orbit-point {
        position: absolute;

        z-index: 7;

        width: 8px;
        height: 8px;

        border-radius: 50%;

        background:
          linear-gradient(
            135deg,
            #67e8f9,
            #6366f1
          );

        box-shadow:
          0 0 10px rgba(34, 211, 238, 0.8),
          0 0 25px rgba(99, 102, 241, 0.4);

        animation:
          pointPulse 2.8s ease-in-out infinite;
      }

      .point-one {
        top: 55px;
        left: 98px;
      }

      .point-two {
        top: 120px;
        right: 30px;
        animation-delay: -0.7s;
      }

      .point-three {
        bottom: 55px;
        left: 80px;
        animation-delay: -1.4s;
      }

      .point-four {
        bottom: 90px;
        right: 55px;
        animation-delay: -2.1s;
      }

      .floating-tech-card {
        position: absolute;

        z-index: 15;

        min-width: 125px;

        padding: 10px 13px;

        display: flex;
        align-items: center;
        gap: 9px;

        border:
          1px solid var(--border);

        border-radius: 14px;

        background:
          rgba(255, 255, 255, 0.68);

        box-shadow:
          0 14px 35px rgba(15, 23, 42, 0.08);

        backdrop-filter: blur(14px);

        color: var(--text);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 10px;
        font-weight: 700;
      }

      html.dark-mode .floating-tech-card {
        background:
          rgba(15, 23, 42, 0.7);
      }

      .floating-tech-card i {
        color: var(--primary);
      }

      .floating-card-one {
        top: 85px;
        right: 0;

        animation:
          floatingCardOne 5s ease-in-out infinite;
      }

      .floating-card-two {
        bottom: 75px;
        left: 5px;

        animation:
          floatingCardTwo 6s ease-in-out infinite;
      }

      @keyframes logoFloat {
        0%, 100% {
          transform: translateY(0);
        }

        50% {
          transform: translateY(-8px);
        }
      }

      @keyframes logoSymbolFloat {
        0%, 100% {
          transform:
            translateY(0)
            scale(1);
        }

        50% {
          transform:
            translateY(-3px)
            scale(1.025);
        }
      }

      @keyframes logoGlow {
        0%, 100% {
          opacity: 0.55;
          transform: scale(0.96);
        }

        50% {
          opacity: 1;
          transform: scale(1.04);
        }
      }

      @keyframes ringRotateOne {
        from {
          transform:
            translate(-50%, -50%)
            rotate(0deg);
        }

        to {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }
      }

      @keyframes ringRotateTwo {
        from {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }

        to {
          transform:
            translate(-50%, -50%)
            rotate(0deg);
        }
      }

      @keyframes ringRotateThree {
        from {
          transform:
            translate(-50%, -50%)
            rotate(0deg);
        }

        to {
          transform:
            translate(-50%, -50%)
            rotate(360deg);
        }
      }

      @keyframes pointPulse {
        0%, 100% {
          transform: scale(0.8);
          opacity: 0.45;
        }

        50% {
          transform: scale(1.35);
          opacity: 1;
        }
      }

      @keyframes floatingCardOne {
        0%, 100% {
          transform: translate3d(0, 0, 0);
        }

        50% {
          transform: translate3d(0, -10px, 0);
        }
      }

      @keyframes floatingCardTwo {
        0%, 100% {
          transform: translate3d(0, 0, 0);
        }

        50% {
          transform: translate3d(0, 9px, 0);
        }
      }

      /* ========================================
         TECH TICKER
         ======================================== */

      .tech-ticker {
        overflow: hidden;

        border-top:
          1px solid var(--border);

        border-bottom:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.35);
      }

      html.dark-mode .tech-ticker {
        background:
          rgba(15, 23, 42, 0.35);
      }

      .ticker-track {
        width: max-content;

        display: flex;
        align-items: center;
        gap: 30px;

        padding: 15px 0;

        animation:
          tickerMove 28s linear infinite;
      }

      .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        color: var(--text-soft);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;
      }

      .ticker-item::before {
        content: "◆";

        color: var(--primary);

        font-size: 7px;
      }

      @keyframes tickerMove {
        from {
          transform: translateX(0);
        }

        to {
          transform: translateX(-50%);
        }
      }

      /* ========================================
         SECTIONS
         ======================================== */

      .section {
        padding: 95px 0;
      }

      .section-heading {
        max-width: 720px;

        margin:
          0 auto
          50px;

        text-align: center;
      }

      .section-kicker {
        display: inline-flex;

        padding: 7px 12px;

        border-radius: 999px;

        background:
          rgba(34, 211, 238, 0.08);

        color: var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1px;
      }

      .section-heading h2 {
        margin: 15px 0 10px;

        font-size:
          clamp(30px, 4vw, 46px);

        line-height: 1.2;

        font-weight: 900;
      }

      .section-heading p {
        margin: 0;

        color: var(--text-soft);

        font-size: 16px;
        line-height: 1.9;
      }

      /* ========================================
         TOOL FINDER
         ======================================== */

      .tool-finder {
        position: relative;

        padding: 25px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-xl);

        background: var(--surface);

        box-shadow: var(--shadow);

        backdrop-filter: blur(16px);
      }

      .tool-search {
        position: relative;
      }

      .tool-search i {
        position: absolute;

        top: 50%;
        right: 19px;

        transform: translateY(-50%);

        color: var(--text-soft);
      }

      .tool-search input {
        width: 100%;

        height: 58px;

        padding:
          0 52px
          0 18px;

        border:
          1px solid var(--border);

        border-radius: 15px;

        outline: none;

        background:
          var(--surface-solid);

        color: var(--text);

        font-size: 15px;

        transition:
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .tool-search input:focus {
        border-color:
          rgba(34, 211, 238, 0.5);

        box-shadow:
          0 0 0 4px
          rgba(34, 211, 238, 0.08);
      }

      .tool-results {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 12px;

        margin-top: 18px;
      }

      .tool-result {
        min-height: 72px;

        display: flex;
        align-items: center;

        gap: 12px;

        padding: 13px;

        border:
          1px solid var(--border);

        border-radius: 15px;

        background:
          rgba(255, 255, 255, 0.45);

        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          background 0.25s ease;
      }

      html.dark-mode .tool-result {
        background:
          rgba(15, 23, 42, 0.45);
      }

      .tool-result:hover {
        transform: translateY(-3px);

        border-color:
          rgba(34, 211, 238, 0.35);
      }

      .tool-result-icon {
        width: 40px;
        height: 40px;

        flex: 0 0 40px;

        display: grid;
        place-items: center;

        border-radius: 12px;

        background:
          linear-gradient(
            135deg,
            rgba(34, 211, 238, 0.12),
            rgba(99, 102, 241, 0.12)
          );

        color: var(--primary);
      }

      .tool-result strong {
        display: block;

        font-size: 12px;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .tool-result small {
        color: var(--text-soft);
        font-size: 9px;
      }

      .no-results {
        display: none;

        padding: 25px;

        text-align: center;

        color: var(--text-soft);

        font-size: 13px;
      }

      /* ========================================
         STATS
         ======================================== */

      .stats-grid {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 15px;
      }

      .stat-card {
        position: relative;

        padding: 25px;

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background: var(--surface);

        box-shadow:
          0 15px 45px rgba(15, 23, 42, 0.05);

        backdrop-filter: blur(14px);

        text-align: center;
      }

      .stat-card::after {
        content: "";

        position: absolute;

        width: 90px;
        height: 90px;

        left: -30px;
        bottom: -35px;

        border-radius: 50%;

        background:
          rgba(34, 211, 238, 0.08);

        filter: blur(5px);
      }

      .stat-number {
        display: block;

        font-size: 36px;

        font-weight: 900;

        background:
          linear-gradient(
            135deg,
            var(--primary),
            var(--accent)
          );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
      }

      .stat-label {
        color: var(--text-soft);

        font-size: 12px;
        font-weight: 700;
      }

      /* ========================================
         FEATURED TOOLS
         ======================================== */

      .tools-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 17px;
      }

      .tool-card {
        position: relative;

        padding: 23px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background: var(--surface);

        box-shadow:
          0 14px 40px rgba(15, 23, 42, 0.045);

        backdrop-filter: blur(12px);

        overflow: hidden;

        transition:
          transform 0.3s ease,
          border-color 0.3s ease,
          box-shadow 0.3s ease;
      }

      .tool-card::before {
        content: "";

        position: absolute;

        top: -70px;
        left: -70px;

        width: 160px;
        height: 160px;

        border-radius: 50%;

        background:
          radial-gradient(
            circle,
            rgba(34, 211, 238, 0.11),
            transparent 70%
          );

        transition:
          transform 0.5s ease;
      }

      .tool-card:hover {
        transform: translateY(-7px);

        border-color:
          rgba(34, 211, 238, 0.3);

        box-shadow:
          0 25px 60px rgba(15, 23, 42, 0.1);
      }

      .tool-card:hover::before {
        transform: scale(1.4);
      }

      .tool-icon {
        position: relative;
        z-index: 2;

        width: 50px;
        height: 50px;

        display: grid;
        place-items: center;

        border-radius: 15px;

        background:
          linear-gradient(
            135deg,
            rgba(34, 211, 238, 0.12),
            rgba(99, 102, 241, 0.13)
          );

        color: var(--primary);

        font-size: 20px;
      }

      .tool-card h3 {
        position: relative;
        z-index: 2;

        margin:
          17px 0
          7px;

        font-size: 16px;
        font-weight: 800;
      }

      .tool-card p {
        position: relative;
        z-index: 2;

        margin: 0;

        color: var(--text-soft);

        font-size: 12px;
        line-height: 1.8;
      }

      .tool-card-link {
        position: relative;
        z-index: 2;

        display: inline-flex;

        margin-top: 16px;

        color: var(--primary);

        font-size: 11px;
        font-weight: 800;
      }

      .all-tools-link {
        display: flex;
        justify-content: center;

        margin-top: 35px;
      }

      /* ========================================
         TRACKS
         ======================================== */

      .tracks-grid {
        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 16px;
      }

      .track-card {
        position: relative;

        min-height: 230px;

        padding: 24px;

        display: flex;
        flex-direction: column;

        justify-content: space-between;

        overflow: hidden;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background: var(--surface);

        transition:
          transform 0.3s ease,
          border-color 0.3s ease;
      }

      .track-card:hover {
        transform: translateY(-7px);

        border-color:
          rgba(34, 211, 238, 0.3);
      }

      .track-icon {
        font-size: 36px;

        filter:
          drop-shadow(
            0 8px 15px
            rgba(15, 23, 42, 0.1)
          );
      }

      .track-tag {
        color: var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1px;
      }

      .track-card h3 {
        margin:
          10px 0
          5px;

        font-size: 18px;
      }

      .track-card p {
        margin: 0;

        color: var(--text-soft);

        font-size: 12px;
        line-height: 1.8;
      }

      /* ========================================
         CODE EDITOR
         ======================================== */

      .editor-section {
        position: relative;
      }

      .editor-wrapper {
        display: grid;

        grid-template-columns:
          1fr 0.9fr;

        min-height: 510px;

        overflow: hidden;

        border:
          1px solid rgba(148, 163, 184, 0.16);

        border-radius:
          28px;

        background:
          #08111f;

        box-shadow:
          0 30px 80px rgba(2, 8, 23, 0.2);
      }

      .editor-panel {
        display: flex;
        flex-direction: column;

        min-width: 0;
      }

      .editor-toolbar {
        min-height: 60px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;

        padding:
          10px 15px;

        border-bottom:
          1px solid
          rgba(148, 163, 184, 0.12);

        background:
          rgba(15, 23, 42, 0.7);
      }

      .editor-tabs {
        display: flex;
        gap: 5px;
      }

      .editor-tab {
        min-height: 36px;

        padding:
          0 12px;

        border: 0;
        border-radius: 9px;

        background:
          transparent;

        color:
          #94a3b8;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 10px;
        font-weight: 700;
      }

      .editor-tab.active {
        background:
          rgba(34, 211, 238, 0.1);

        color:
          #67e8f9;
      }

      .editor-actions {
        display: flex;
        gap: 6px;
      }

      .editor-action {
        width: 35px;
        height: 35px;

        display: grid;
        place-items: center;

        border:
          1px solid
          rgba(148, 163, 184, 0.14);

        border-radius: 9px;

        background:
          rgba(15, 23, 42, 0.7);

        color:
          #94a3b8;
      }

      .editor-action:hover {
        color:
          #67e8f9;

        border-color:
          rgba(34, 211, 238, 0.3);
      }

      .editor-body {
        position: relative;

        flex: 1;

        display: flex;

        min-height: 430px;
      }

      .line-numbers {
        width: 48px;

        padding:
          20px 10px;

        background:
          rgba(2, 8, 23, 0.35);

        color:
          #475569;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 11px;

        line-height: 1.8;

        text-align: center;

        user-select: none;
      }

      .code-editor {
        flex: 1;

        width: 100%;

        resize: none;

        padding:
          20px;

        border: 0;

        outline: none;

        background:
          transparent;

        color:
          #dbeafe;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 12px;

        line-height: 1.8;

        tab-size: 2;
      }

      .editor-status {
        min-height: 34px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding:
          0 15px;

        border-top:
          1px solid
          rgba(148, 163, 184, 0.1);

        color:
          #64748b;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;
      }

      .status-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .status-live::before {
        content: "";

        width: 6px;
        height: 6px;

        border-radius: 50%;

        background:
          #22c55e;

        box-shadow:
          0 0 8px
          rgba(34, 197, 94, 0.7);
      }

      .preview-panel {
        position: relative;

        display: flex;
        flex-direction: column;

        background:
          #f8fafc;
      }

      .preview-header {
        min-height: 60px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding:
          0 18px;

        border-bottom:
          1px solid
          #e2e8f0;

        background:
          #ffffff;

        color:
          #0f172a;
      }

      .preview-dots {
        display: flex;
        gap: 6px;
      }

      .preview-dots span {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background:
          #cbd5e1;
      }

      .preview-title {
        color:
          #64748b;

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 9px;
      }

      #code-preview {
        flex: 1;

        width: 100%;

        border: 0;

        background: white;
      }

      .editor-info {
        padding: 22px;

        border-top:
          1px solid
          rgba(148, 163, 184, 0.12);

        background:
          rgba(15, 23, 42, 0.7);

        color: #94a3b8;

        font-size: 11px;

        line-height: 1.8;
      }

      .editor-info strong {
        color:
          #e2e8f0;
      }

      /* ========================================
         HOW IT WORKS
         ======================================== */

      .steps-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 20px;
      }

      .step-card {
        position: relative;

        padding: 30px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background: var(--surface);
      }

      .step-number {
        width: 45px;
        height: 45px;

        display: grid;
        place-items: center;

        border-radius: 13px;

        background:
          linear-gradient(
            135deg,
            rgba(34, 211, 238, 0.14),
            rgba(99, 102, 241, 0.15)
          );

        color: var(--primary);

        font-family:
          "JetBrains Mono",
          monospace;

        font-size: 14px;
        font-weight: 800;
      }

      .step-card h3 {
        margin:
          18px 0 8px;

        font-size: 17px;
      }

      .step-card p {
        margin: 0;

        color: var(--text-soft);

        font-size: 12px;
        line-height: 1.9;
      }

      /* ========================================
         FEATURES
         ======================================== */

      .features-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 15px;
      }

      .feature {
        padding: 22px;

        border:
          1px solid var(--border);

        border-radius:
          var(--radius-lg);

        background:
          var(--surface);
      }

      .feature i {
        color: var(--primary);

        font-size: 21px;
      }

      .feature h3 {
        margin:
          13px 0 6px;

        font-size: 15px;
      }

      .feature p {
        margin: 0;

        color: var(--text-soft);

        font-size: 11px;

        line-height: 1.9;
      }

      /* ========================================
         FAQ
         ======================================== */

      .faq-list {
        max-width: 850px;

        margin-inline: auto;

        display: grid;

        gap: 10px;
      }

      .faq-item {
        border:
          1px solid var(--border);

        border-radius:
          16px;

        background:
          var(--surface);

        overflow: hidden;
      }

      .faq-question {
        width: 100%;

        min-height: 65px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        padding:
          0 20px;

        border: 0;

        background: transparent;

        color: var(--text);

        text-align: right;

        font-size: 14px;
        font-weight: 800;
      }

      .faq-question i {
        color: var(--primary);

        transition:
          transform 0.25s ease;
      }

      .faq-item.open .faq-question i {
        transform:
          rotate(180deg);
      }

      .faq-answer {
        display: grid;

        grid-template-rows: 0fr;

        transition:
          grid-template-rows 0.3s ease;
      }

      .faq-answer-inner {
        overflow: hidden;

        color: var(--text-soft);

        font-size: 12px;
        line-height: 1.9;

        padding:
          0 20px;
      }

      .faq-item.open .faq-answer {
        grid-template-rows: 1fr;
      }

      .faq-item.open .faq-answer-inner {
        padding-bottom: 20px;
      }

      /* ========================================
         CTA
         ======================================== */

      .cta {
        position: relative;

        overflow: hidden;

        padding: 65px 30px;

        border:
          1px solid
          rgba(34, 211, 238, 0.2);

        border-radius:
          32px;

        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(34, 211, 238, 0.2),
            transparent 30%
          ),
          radial-gradient(
            circle at 90% 80%,
            rgba(99, 102, 241, 0.22),
            transparent 35%
          ),
          #0b1424;

        text-align: center;

        box-shadow:
          0 30px 80px
          rgba(2, 8, 23, 0.2);
      }

      .cta::before {
        content: "";

        position: absolute;

        inset: 0;

        background:
          linear-gradient(
            120deg,
            transparent,
            rgba(255, 255, 255, 0.05),
            transparent
          );

        transform:
          translateX(-100%);

        animation:
          ctaShine 7s linear infinite;
      }

      @keyframes ctaShine {
        to {
          transform:
            translateX(100%);
        }
      }

      .cta-content {
        position: relative;
        z-index: 2;
      }

      .cta h2 {
        margin: 0 0 12px;

        color: white;

        font-size:
          clamp(28px, 4vw, 44px);

        font-weight: 900;
      }

      .cta p {
        max-width: 620px;

        margin:
          0 auto 25px;

        color:
          #94a3b8;

        line-height: 1.9;
      }

      /* ========================================
         SCROLL REVEAL
         ======================================== */

      .reveal {
        opacity: 0;

        transform:
          translateY(24px);

        transition:
          opacity 0.7s ease,
          transform 0.7s ease;
      }

      .reveal.visible {
        opacity: 1;

        transform:
          translateY(0);
      }

      /* ========================================
         SCROLL TOP
         ======================================== */

      .scroll-top {
        position: fixed;

        left: 20px;
        bottom: 20px;

        z-index: 100;

        width: 43px;
        height: 43px;

        display: grid;
        place-items: center;

        border:
          1px solid var(--border);

        border-radius: 13px;

        background:
          var(--surface);

        color: var(--primary);

        backdrop-filter: blur(12px);

        opacity: 0;
        visibility: hidden;

        transform:
          translateY(10px);

        transition:
          opacity 0.25s ease,
          visibility 0.25s ease,
          transform 0.25s ease;
      }

      .scroll-top.show {
        opacity: 1;
        visibility: visible;

        transform:
          translateY(0);
      }

      /* ========================================
         LIGHT LOGO
         ======================================== */

      html:not(.dark-mode) .logo-main {
        background:
          radial-gradient(
            circle at 30% 20%,
            rgba(34, 211, 238, 0.12),
            transparent 38%
          ),
          radial-gradient(
            circle at 75% 80%,
            rgba(99, 102, 241, 0.1),
            transparent 45%
          ),
          rgba(255, 255, 255, 0.9);

        border-color:
          rgba(14, 165, 233, 0.25);

        box-shadow:
          0 15px 45px
          rgba(15, 23, 42, 0.1),
          0 0 35px
          rgba(14, 165, 233, 0.1),
          inset 0 0 30px
          rgba(14, 165, 233, 0.04);
      }

      html:not(.dark-mode) .logo-subtitle {
        color:
          rgba(15, 23, 42, 0.55);
      }

      /* ========================================
         RESPONSIVE
         ======================================== */

      @media (max-width: 1000px) {
        .hero-grid {
          grid-template-columns: 1fr;
          text-align: center;
        }

        .hero-content {
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .hero-visual {
          min-height: 470px;
        }

        .tool-results {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .tracks-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .stats-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .editor-wrapper {
          grid-template-columns: 1fr;
        }

        .preview-panel {
          min-height: 360px;
        }
      }

      @media (max-width: 760px) {
        .hero {
          padding:
            65px 0
            45px;
        }

        .hero h1 {
          font-size:
            clamp(37px, 11vw, 54px);

          letter-spacing: -1.5px;
        }

        .hero-description {
          font-size: 15px;
        }

        .hero-actions {
          justify-content: center;
        }

        .hero-visual {
          min-height: 390px;
        }

        .th-tech-logo-core {
          width: 320px;
          height: 320px;
        }

        .logo-main {
          width: 185px;
          height: 185px;
        }

        .logo-symbol {
          width: 86px;
          height: 86px;
        }

        .ring-one {
          width: 245px;
          height: 245px;
        }

        .ring-two {
          width: 285px;
          height: 285px;
        }

        .ring-three {
          width: 315px;
          height: 315px;
        }

        .floating-card-one {
          right: -5px;
        }

        .floating-card-two {
          left: -5px;
        }

        .section {
          padding: 70px 0;
        }

        .tools-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .features-grid {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .steps-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 520px) {
        .container {
          width:
            min(
              var(--container),
              calc(100% - 24px)
            );
        }

        .hero {
          min-height: auto;
        }

        .hero h1 {
          font-size: 38px;
        }

        .hero-description {
          font-size: 14px;
          line-height: 1.9;
        }

        .hero-trust {
          justify-content: center;
        }

        .hero-visual {
          min-height: 320px;
        }

        .th-tech-logo-core {
          width: 275px;
          height: 275px;
        }

        .logo-main {
          width: 165px;
          height: 165px;
        }

        .logo-symbol {
          width: 75px;
          height: 75px;
        }

        .logo-name {
          font-size: 22px;
        }

        .logo-subtitle {
          font-size: 6px;
          letter-spacing: 1.7px;
        }

        .ring-one {
          width: 215px;
          height: 215px;
        }

        .ring-two {
          width: 245px;
          height: 245px;
        }

        .ring-three {
          width: 270px;
          height: 270px;
        }

        .floating-tech-card {
          display: none;
        }

        .stats-grid,
        .tracks-grid,
        .tools-grid,
        .features-grid {
          grid-template-columns: 1fr;
        }

        .tool-results {
          grid-template-columns: 1fr;
        }

        .section-heading {
          margin-bottom: 32px;
        }

        .section-heading h2 {
          font-size: 29px;
        }

        .section-heading p {
          font-size: 13px;
        }

        .tool-finder {
          padding: 14px;
        }

        .editor-wrapper {
          border-radius: 20px;
        }

        .editor-toolbar {
          flex-wrap: wrap;
        }

        .editor-tabs {
          overflow-x: auto;
        }

        .editor-tab {
          flex: 0 0 auto;
        }

        .line-numbers {
          width: 37px;
          padding-inline: 5px;
        }

        .code-editor {
          padding: 15px;
          font-size: 10px;
        }

        .preview-panel {
          min-height: 300px;
        }

        .cta {
          padding:
            45px 18px;
          border-radius: 24px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="page-background" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-orb bg-orb-one"></div>
      <div class="bg-orb bg-orb-two"></div>
    </div>

    <Header />

    <main>
      <!-- =========================================
           HERO
           ========================================= -->

      <section class="hero">
        <div class="container hero-grid">

          <div class="hero-content">

            <div class="hero-badge">
              <span class="hero-badge-dot"></span>
              منصة تقنية عربية تتطور باستمرار
            </div>

            <h1>
              أدوات تقنية
              <br />
              <span class="gradient-text">أذكى وأسرع</span>
              <br />
              في مكان واحد
            </h1>

            <p class="hero-description">
              Th.Tech تجمع لك أدوات عملية للبرمجة والويب والذكاء الاصطناعي
              والأمن السيبراني، لتنجز مهامك اليومية مباشرة من المتصفح.
            </p>

            <div class="hero-actions">
              <a
                class="btn btn-primary"
                href="#tools"
              >
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                استكشف الأدوات
              </a>

              <a
                class="btn btn-secondary"
                href="#code-editor"
              >
                <i class="fa-solid fa-code"></i>
                جرّب محرر الأكواد
              </a>
            </div>

            <div class="hero-trust">
              <span>
                <i class="fa-solid fa-bolt"></i>
                سريع ومباشر
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                أدوات تعمل من المتصفح
              </span>

              <span>
                <i class="fa-solid fa-mobile-screen"></i>
                متوافق مع الهاتف
              </span>
            </div>

          </div>

          <!-- CENTRAL LOGO -->

          <div class="hero-visual">

            <div
              class="th-tech-logo-core"
              aria-label="Th.Tech"
            >

              <div class="logo-ring ring-one"></div>
              <div class="logo-ring ring-two"></div>
              <div class="logo-ring ring-three"></div>

              <span class="orbit-point point-one"></span>
              <span class="orbit-point point-two"></span>
              <span class="orbit-point point-three"></span>
              <span class="orbit-point point-four"></span>

              <div class="floating-tech-card floating-card-one">
                <i class="fa-solid fa-microchip"></i>
                AI TOOLS
              </div>

              <div class="floating-tech-card floating-card-two">
                <i class="fa-solid fa-terminal"></i>
                DEV TOOLS
              </div>

              <div class="logo-main">

                <div class="logo-glow"></div>

                <div class="logo-symbol">
                  <svg
                    viewBox="0 0 160 160"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <defs>
                      <linearGradient
                        id="thLogoGradient"
                        x1="20"
                        y1="20"
                        x2="140"
                        y2="140"
                      >
                        <stop
                          offset="0%"
                          stop-color="#22d3ee"
                        />

                        <stop
                          offset="48%"
                          stop-color="#38bdf8"
                        />

                        <stop
                          offset="100%"
                          stop-color="#6366f1"
                        />
                      </linearGradient>

                      <linearGradient
                        id="thLogoStroke"
                        x1="0"
                        y1="0"
                        x2="1"
                        y2="1"
                      >
                        <stop
                          offset="0%"
                          stop-color="#67e8f9"
                        />

                        <stop
                          offset="100%"
                          stop-color="#818cf8"
                        />
                      </linearGradient>
                    </defs>

                    <circle
                      cx="80"
                      cy="80"
                      r="66"
                      fill="url(#thLogoGradient)"
                      opacity="0.12"
                    />

                    <circle
                      cx="80"
                      cy="80"
                      r="61"
                      fill="none"
                      stroke="url(#thLogoStroke)"
                      stroke-width="2"
                      opacity="0.8"
                    />

                    <g
                      fill="none"
                      stroke="url(#thLogoGradient)"
                      stroke-width="10"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M38 48 H87" />
                      <path d="M62.5 48 V112" />

                      <path d="M93 48 V112" />
                      <path d="M122 48 V112" />
                      <path d="M93 80 H122" />
                    </g>

                    <circle
                      cx="122"
                      cy="48"
                      r="5"
                      fill="#67e8f9"
                    />
                  </svg>
                </div>

                <div class="logo-name">
                  <span>Th</span><strong>.Tech</strong>
                </div>

                <div class="logo-subtitle">
                  TECH • AI • TOOLS
                </div>

              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- =========================================
           TICKER
           ========================================= -->

      <div class="tech-ticker">
        <div class="ticker-track">
          {
            [
              'JSON',
              'JavaScript',
              'HTML',
              'CSS',
              'API',
              'QR CODE',
              'BASE64',
              'JWT',
              'REGEX',
              'SQL',
              'UUID',
              'HASH',
              'MARKDOWN',
              'COLOR',
              'TIMESTAMP',
              'YAML',
              'CSV',
              'XML',
              'JSON',
              'JavaScript',
              'HTML',
              'CSS',
              'API',
              'QR CODE',
              'BASE64',
              'JWT',
              'REGEX',
              'SQL',
              'UUID',
              'HASH'
            ].map((item) => (
              <span class="ticker-item">{item}</span>
            ))
          }
        </div>
      </div>

      <!-- =========================================
           STATS
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="stats-grid">

            <div class="stat-card reveal">
              <span
                class="stat-number"
                data-counter={toolsCount}
              >
                0
              </span>

              <span class="stat-label">
                أداة تقنية
              </span>
            </div>

            <div class="stat-card reveal">
              <span
                class="stat-number"
                data-counter="4"
              >
                0
              </span>

              <span class="stat-label">
                مسارات تقنية
              </span>
            </div>

            <div class="stat-card reveal">
              <span
                class="stat-number"
                data-counter="100"
              >
                0
              </span>

              <span class="stat-label">
                تجربة مباشرة
              </span>
            </div>

            <div class="stat-card reveal">
              <span class="stat-number">
                ∞
              </span>

              <span class="stat-label">
                إمكانيات الاستخدام
              </span>
            </div>

          </div>

        </div>
      </section>

      <!-- =========================================
           TOOL FINDER
           ========================================= -->

      <section
        id="tools"
        class="section"
      >
        <div class="container">

          <div class="section-heading reveal">
            <span class="section-kicker">
              TOOL FINDER
            </span>

            <h2>
              ابحث عن الأداة التي تحتاجها
            </h2>

            <p>
              اكتب اسم الأداة أو التقنية للوصول إليها بسرعة.
            </p>
          </div>

          <div class="tool-finder reveal">

            <div class="tool-search">
              <i class="fa-solid fa-magnifying-glass"></i>

              <input
                id="tool-search"
                type="search"
                placeholder="ابحث مثلاً: JSON أو QR أو API..."
                autocomplete="off"
                aria-label="البحث عن أداة"
              />
            </div>

            <div
              class="tool-results"
              id="tool-results"
            >
              {
                [...featuredTools, ...remainingTools]
                  .slice(0, 18)
                  .map((tool) => (
                    <a
                      class="tool-result"
                      href={tool.href}
                      data-tool-name={tool.name.toLowerCase()}
                    >
                      <span class="tool-result-icon">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                      </span>

                      <span>
                        <strong>{tool.name}</strong>
                        <small>أداة تقنية</small>
                      </span>
                    </a>
                  ))
              }
            </div>

            <div
              class="no-results"
              id="no-results"
            >
              لم يتم العثور على أداة مطابقة.
            </div>

          </div>

        </div>
      </section>

      <!-- =========================================
           FEATURED TOOLS
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="section-heading reveal">
            <span class="section-kicker">
              FEATURED TOOLS
            </span>

            <h2>
              أدوات مختارة لك
            </h2>

            <p>
              مجموعة من الأدوات العملية التي يمكنك استخدامها مباشرة.
            </p>
          </div>

          <div class="tools-grid">

            {
              featuredTools.map((tool, index) => (
                <a
                  class="tool-card reveal"
                  href={tool.href}
                  style={`transition-delay:${index * 50}ms`}
                >
                  <div class="tool-icon">
                    <i
                      class={
                        index === 0
                          ? 'fa-solid fa-code'
                          : index === 1
                            ? 'fa-solid fa-circle-check'
                            : index === 2
                              ? 'fa-solid fa-lock'
                              : index === 3
                                ? 'fa-solid fa-qrcode'
                                : index === 4
                                  ? 'fa-solid fa-palette'
                                  : 'fa-solid fa-plug'
                      }
                    ></i>
                  </div>

                  <h3>{tool.name}</h3>

                  <p>
                    أداة تقنية مجانية وسريعة للاستخدام مباشرة من المتصفح.
                  </p>

                  <span class="tool-card-link">
                    فتح الأداة ←
                  </span>
                </a>
              ))
            }

          </div>

          <div class="all-tools-link">
            <a
              class="btn btn-secondary"
              href={`${base}/tools/`}
            >
              <i class="fa-solid fa-grid-2"></i>
              مشاهدة جميع الأدوات
            </a>
          </div>

        </div>
      </section>

      <!-- =========================================
           TRACKS
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="section-heading reveal">
            <span class="section-kicker">
              TECH TRACKS
            </span>

            <h2>
              استكشف مجالات التقنية
            </h2>

            <p>
              مسارات تجمع الأدوات والمواضيع التقنية في تجربة واحدة.
            </p>
          </div>

          <div class="tracks-grid">

            {
              tracks.map((track) => (
                <a
                  href={track.href}
                  class="track-card reveal"
                >
                  <div>
                    <div class="track-icon">
                      {track.icon}
                    </div>

                    <span class="track-tag">
                      {track.tag}
                    </span>

                    <h3>
                      {track.title}
                    </h3>

                    <p>
                      {track.description}
                    </p>
                  </div>

                  <span class="tool-card-link">
                    استكشف ←
                  </span>
                </a>
              ))
            }

          </div>

        </div>
      </section>

      <!-- =========================================
           CODE EDITOR
           ========================================= -->

      <section
        id="code-editor"
        class="section editor-section"
      >
        <div class="container">

          <div class="section-heading reveal">

            <span class="section-kicker">
              CODE PLAYGROUND
            </span>

            <h2>
              محرر الأكواد
            </h2>

            <p>
              اكتب HTML أو CSS أو JavaScript وشاهد النتيجة مباشرة.
            </p>

          </div>

          <div class="editor-wrapper reveal">

            <!-- EDITOR -->

            <div class="editor-panel">

              <div class="editor-toolbar">

                <div class="editor-tabs">

                  <button
                    class="editor-tab active"
                    type="button"
                    data-language="html"
                  >
                    HTML
                  </button>

                  <button
                    class="editor-tab"
                    type="button"
                    data-language="css"
                  >
                    CSS
                  </button>

                  <button
                    class="editor-tab"
                    type="button"
                    data-language="js"
                  >
                    JS
                  </button>

                </div>

                <div class="editor-actions">

                  <button
                    class="editor-action"
                    type="button"
                    id="run-code"
                    aria-label="تشغيل الكود"
                    title="تشغيل"
                  >
                    <i class="fa-solid fa-play"></i>
                  </button>

                  <button
                    class="editor-action"
                    type="button"
                    id="copy-code"
                    aria-label="نسخ الكود"
                    title="نسخ"
                  >
                    <i class="fa-regular fa-copy"></i>
                  </button>

                  <button
                    class="editor-action"
                    type="button"
                    id="reset-code"
                    aria-label="إعادة ضبط"
                    title="إعادة ضبط"
                  >
                    <i class="fa-solid fa-rotate-left"></i>
                  </button>

                </div>

              </div>

              <div class="editor-body">

                <div
                  class="line-numbers"
                  id="line-numbers"
                  aria-hidden="true"
                >
                  1
                </div>

                <textarea
                  id="code-editor-input"
                  class="code-editor"
                  spellcheck="false"
                  aria-label="محرر الأكواد"
                ></textarea>

              </div>

              <div class="editor-status">

                <span class="status-live">
                  Live Preview
                </span>

                <span id="editor-language">
                  HTML
                </span>

              </div>

            </div>

            <!-- PREVIEW -->

            <div class="preview-panel">

              <div class="preview-header">

                <div class="preview-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <span class="preview-title">
                  preview.html
                </span>

              </div>

              <iframe
                id="code-preview"
                title="معاينة الكود"
                sandbox="allow-scripts"
              ></iframe>

              <div class="editor-info">
                <strong>
                  محرر سريع ومباشر
                </strong>
                <br />
                التغييرات تظهر في المعاينة مباشرة، ويمكنك تجربة HTML وCSS وJavaScript دون مغادرة الصفحة.
              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- =========================================
           HOW IT WORKS
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="section-heading reveal">
            <span class="section-kicker">
              HOW IT WORKS
            </span>

            <h2>
              تجربة بسيطة من ثلاث خطوات
            </h2>

            <p>
              لا حاجة لتعقيد المهمة؛ اختر الأداة وابدأ مباشرة.
            </p>
          </div>

          <div class="steps-grid">

            <div class="step-card reveal">
              <div class="step-number">01</div>

              <h3>
                اختر الأداة
              </h3>

              <p>
                استخدم البحث أو تصفح الأدوات للوصول إلى الأداة المناسبة لمهمتك.
              </p>
            </div>

            <div class="step-card reveal">
              <div class="step-number">02</div>

              <h3>
                أدخل بياناتك
              </h3>

              <p>
                استخدم الواجهة البسيطة للأداة وأدخل البيانات التي تريد معالجتها.
              </p>
            </div>

            <div class="step-card reveal">
              <div class="step-number">03</div>

              <h3>
                احصل على النتيجة
              </h3>

              <p>
                عاين النتيجة وانسخها أو استخدمها مباشرة في مشروعك.
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- =========================================
           FEATURES
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="section-heading reveal">

            <span class="section-kicker">
              WHY TH.TECH
            </span>

            <h2>
              لماذا Th.Tech؟
            </h2>

            <p>
              المنصة مصممة لتكون عملية، سريعة، وواضحة.
            </p>

          </div>

          <div class="features-grid">

            <div class="feature reveal">
              <i class="fa-solid fa-bolt"></i>

              <h3>
                سرعة الاستخدام
              </h3>

              <p>
                الوصول إلى الأدوات وتشغيلها مباشرة دون خطوات غير ضرورية.
              </p>
            </div>

            <div class="feature reveal">
              <i class="fa-solid fa-code"></i>

              <h3>
                أدوات للمطورين
              </h3>

              <p>
                مجموعة كبيرة من أدوات البرمجة والبيانات وواجهات API.
              </p>
            </div>

            <div class="feature reveal">
              <i class="fa-solid fa-mobile-screen"></i>

              <h3>
                تصميم متجاوب
              </h3>

              <p>
                تجربة مناسبة للهاتف والكمبيوتر والأجهزة اللوحية.
              </p>
            </div>

            <div class="feature reveal">
              <i class="fa-solid fa-moon"></i>

              <h3>
                وضع ليلي
              </h3>

              <p>
                واجهة مريحة للاستخدام في مختلف ظروف الإضاءة.
              </p>
            </div>

            <div class="feature reveal">
              <i class="fa-solid fa-shield-halved"></i>

              <h3>
                الخصوصية أولاً
              </h3>

              <p>
                العديد من الأدوات تعمل مباشرة داخل المتصفح دون الحاجة إلى خادم.
              </p>
            </div>

            <div class="feature reveal">
              <i class="fa-solid fa-arrows-rotate"></i>

              <h3>
                تطوير مستمر
              </h3>

              <p>
                المنصة قابلة للتوسع وإضافة أدوات وتجارب جديدة باستمرار.
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- =========================================
           FAQ
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="section-heading reveal">

            <span class="section-kicker">
              FAQ
            </span>

            <h2>
              الأسئلة الشائعة
            </h2>

            <p>
              إجابات سريعة حول المنصة والأدوات.
            </p>

          </div>

          <div class="faq-list">

            {
              faqs.map((faq, index) => (
                <div
                  class:list={[
                    'faq-item',
                    index === 0
                      ? 'open'
                      : ''
                  ]}
                >

                  <button
                    class="faq-question"
                    type="button"
                    aria-expanded={index === 0 ? 'true' : 'false'}
                  >
                    <span>
                      {faq.q}
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                  </button>

                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      {faq.a}
                    </div>
                  </div>

                </div>
              ))
            }

          </div>

        </div>
      </section>

      <!-- =========================================
           CTA
           ========================================= -->

      <section class="section">
        <div class="container">

          <div class="cta reveal">

            <div class="cta-content">

              <h2>
                جاهز لإنجاز مهمتك؟
              </h2>

              <p>
                اكتشف أدوات Th.Tech واستخدم الأدوات التي تحتاجها مباشرة من المتصفح.
              </p>

              <a
                href="#tools"
                class="btn btn-primary"
              >
                <i class="fa-solid fa-rocket"></i>
                ابدأ الآن
              </a>

            </div>

          </div>

        </div>
      </section>
    </main>

    <Footer />

    <button
      class="scroll-top"
      id="scroll-top"
      type="button"
      aria-label="العودة إلى الأعلى"
    >
      <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script>
      /* ==========================================
         CODE EDITOR
         ========================================== */

      const editor = document.getElementById(
        'code-editor-input'
      );

      const preview = document.getElementById(
        'code-preview'
      );

      const lineNumbers = document.getElementById(
        'line-numbers'
      );

      const editorLanguage = document.getElementById(
        'editor-language'
      );

      const tabs = document.querySelectorAll(
        '.editor-tab'
      );

      const runButton = document.getElementById(
        'run-code'
      );

      const copyButton = document.getElementById(
        'copy-code'
      );

      const resetButton = document.getElementById(
        'reset-code'
      );

      const editorCode = {
        html: `<div class="demo">
  <div class="icon">✦</div>
  <h1>مرحباً بك في Th.Tech</h1>
  <p>اكتب الكود وشاهد النتيجة مباشرة.</p>
  <button onclick="hello()">جرّب الآن</button>
</div>`,

        css: `.demo {
  font-family: Arial;
  text-align: center;
  padding: 45px;
  color: #0f172a;
}

.icon {
  font-size: 42px;
  color: #06b6d4;
}

h1 {
  margin: 12px 0;
}

button {
  border: 0;
  padding: 11px 18px;
  border-radius: 10px;
  background: #0891b2;
  color: white;
  cursor: pointer;
}`,

        js: `function hello() {
  alert("مرحباً من Th.Tech ✦");
}`
      };

      let currentLanguage = 'html';

      if (editor) {
        editor.value = editorCode.html;
      }

      function updateLineNumbers() {
        if (!editor || !lineNumbers) return;

        const lines =
          editor.value.split('\n').length;

        lineNumbers.innerHTML =
          Array.from(
            { length: lines },
            (_, index) => index + 1
          ).join('<br>');
      }

      function buildPreview() {
        if (!preview) return;

        const html =
          currentLanguage === 'html'
            ? editorCode.html
            : '';

        const css =
          currentLanguage === 'css'
            ? editorCode.css
            : editorCode.css;

        const js =
          currentLanguage === 'js'
            ? editorCode.js
            : editorCode.js;

        let finalHtml = '';

        if (currentLanguage === 'html') {
          finalHtml = editor.value;
        } else if (currentLanguage === 'css') {
          finalHtml = `
            <style>${editor.value}</style>
            ${editorCode.html}
          `;
        } else {
          finalHtml = `
            ${editorCode.html}
            <script>
              ${editor.value}
            <\/script>
          `;
        }

        if (currentLanguage === 'html') {
          finalHtml = `
            ${finalHtml}

            <style>
              ${editorCode.css}
            </style>

            <script>
              ${editorCode.js}
            <\/script>
          `;
        }

        preview.srcdoc = `
          <!doctype html>
          <html lang="ar" dir="rtl">
          <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width,initial-scale=1">
          </head>
          <body>
            ${finalHtml}
          </body>
          </html>
        `;

        updateLineNumbers();
      }

      function switchEditorLanguage(language) {
        if (!editor) return;

        currentLanguage = language;

        tabs.forEach((tab) => {
          tab.classList.toggle(
            'active',
            tab.dataset.language === language
          );
        });

        editorLanguage.textContent =
          language === 'js'
            ? 'JavaScript'
            : language.toUpperCase();

        editor.value =
          editorCode[language];

        updateLineNumbers();
        buildPreview();
      }

      tabs.forEach((tab) => {
        tab.addEventListener(
          'click',
          () => {
            switchEditorLanguage(
              tab.dataset.language
            );
          }
        );
      });

      editor?.addEventListener(
        'input',
        () => {
          editorCode[currentLanguage] =
            editor.value;

          updateLineNumbers();

          if (currentLanguage === 'html') {
            buildPreview();
          }
        }
      );

      editor?.addEventListener(
        'scroll',
        () => {
          if (!lineNumbers) return;

          lineNumbers.scrollTop =
            editor.scrollTop;
        }
      );

      runButton?.addEventListener(
        'click',
        buildPreview
      );

      copyButton?.addEventListener(
        'click',
        async () => {
          if (!editor) return;

          try {
            await navigator.clipboard.writeText(
              editor.value
            );

            copyButton.innerHTML =
              '<i class="fa-solid fa-check"></i>';

            setTimeout(() => {
              copyButton.innerHTML =
                '<i class="fa-regular fa-copy"></i>';
            }, 1200);
          } catch {
            editor.select();
            document.execCommand('copy');
          }
        }
      );

      resetButton?.addEventListener(
        'click',
        () => {
          editorCode.html = `<div class="demo">
  <div class="icon">✦</div>
  <h1>مرحباً بك في Th.Tech</h1>
  <p>اكتب الكود وشاهد النتيجة مباشرة.</p>
  <button onclick="hello()">جرّب الآن</button>
</div>`;

          editorCode.css = `.demo {
  font-family: Arial;
  text-align: center;
  padding: 45px;
  color: #0f172a;
}

.icon {
  font-size: 42px;
  color: #06b6d4;
}

h1 {
  margin: 12px 0;
}

button {
  border: 0;
  padding: 11px 18px;
  border-radius: 10px;
  background: #0891b2;
  color: white;
  cursor: pointer;
}`;

          editorCode.js = `function hello() {
  alert("مرحباً من Th.Tech ✦");
}`;

          switchEditorLanguage(
            currentLanguage
          );
        }
      );

      updateLineNumbers();
      buildPreview();

      /* ==========================================
         TOOL SEARCH
         ========================================== */

      const searchInput =
        document.getElementById(
          'tool-search'
        );

      const toolResults =
        document.querySelectorAll(
          '.tool-result'
        );

      const noResults =
        document.getElementById(
          'no-results'
        );

      searchInput?.addEventListener(
        'input',
        () => {
          const query =
            searchInput.value
              .trim()
              .toLowerCase();

          let visible = 0;

          toolResults.forEach((tool) => {
            const name =
              tool.dataset.toolName || '';

            const matches =
              !query ||
              name.includes(query);

            tool.style.display =
              matches
                ? 'flex'
                : 'none';

            if (matches) {
              visible++;
            }
          });

          if (noResults) {
            noResults.style.display =
              visible === 0
                ? 'block'
                : 'none';
          }
        }
      );

      /* ==========================================
         FAQ
         ========================================== */

      document
        .querySelectorAll('.faq-question')
        .forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              const item =
                button.closest('.faq-item');

              const wasOpen =
                item.classList.contains(
                  'open'
                );

              document
                .querySelectorAll(
                  '.faq-item'
                )
                .forEach((other) => {
                  other.classList.remove(
                    'open'
                  );

                  other
                    .querySelector(
                      '.faq-question'
                    )
                    ?.setAttribute(
                      'aria-expanded',
                      'false'
                    );
                });

              if (!wasOpen) {
                item.classList.add(
                  'open'
                );

                button.setAttribute(
                  'aria-expanded',
                  'true'
                );
              }
            }
          );
        });

      /* ==========================================
         SCROLL REVEAL
         ========================================== */

      const revealItems =
        document.querySelectorAll(
          '.reveal'
        );

      if (
        'IntersectionObserver' in window
      ) {
        const revealObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (
                  entry.isIntersecting
                ) {
                  entry.target.classList.add(
                    'visible'
                  );

                  observer.unobserve(
                    entry.target
                  );
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: '0px 0px -40px 0px'
            }
          );

        revealItems.forEach((item) => {
          revealObserver.observe(item);
        });
      } else {
        revealItems.forEach((item) => {
          item.classList.add('visible');
        });
      }

      /* ==========================================
         COUNTERS
         ========================================== */

      const counters =
        document.querySelectorAll(
          '[data-counter]'
        );

      function animateCounter(element) {
        const target =
          Number(
            element.dataset.counter
          );

        if (!Number.isFinite(target)) {
          return;
        }

        const duration = 1000;

        const start =
          performance.now();

        function update(now) {
          const progress =
            Math.min(
              (now - start) / duration,
              1
            );

          const eased =
            1 -
            Math.pow(
              1 - progress,
              3
            );

          element.textContent =
            Math.round(
              target * eased
            );

          if (progress < 1) {
            requestAnimationFrame(
              update
            );
          }
        }

        requestAnimationFrame(update);
      }

      if (
        'IntersectionObserver' in window
      ) {
        const counterObserver =
          new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (
                  entry.isIntersecting
                ) {
                  animateCounter(
                    entry.target
                  );

                  observer.unobserve(
                    entry.target
                  );
                }
              });
            },
            {
              threshold: 0.5
            }
          );

        counters.forEach((counter) => {
          counterObserver.observe(
            counter
          );
        });
      }

      /* ==========================================
         SCROLL TOP
         ========================================== */

      const scrollTop =
        document.getElementById(
          'scroll-top'
        );

      let scrollTicking = false;

      window.addEventListener(
        'scroll',
        () => {
          if (scrollTicking) return;

          scrollTicking = true;

          requestAnimationFrame(() => {
            scrollTop?.classList.toggle(
              'show',
              window.scrollY > 600
            );

            scrollTicking = false;
          });
        },
        {
          passive: true
        }
      );

      scrollTop?.addEventListener(
        'click',
        () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        }
      );

      /* ==========================================
         KEYBOARD SHORTCUT
         Ctrl/Cmd + K = TOOL SEARCH
         ========================================== */

      document.addEventListener(
        'keydown',
        (event) => {
          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key.toLowerCase() === 'k'
          ) {
            event.preventDefault();

            searchInput?.focus();

            document
              .getElementById('tools')
              ?.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
              });
          }
        }
      );
    </script>
  </body>
</html>
