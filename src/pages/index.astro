              <i class="fa-solid fa-bolt"></i>
              تنفيذ سريع
            </div>

            <div>
              <i class="fa-solid fa-lock"></i>
              تجربة آمنة
            </div>

            <div>
              <i class="fa-solid fa-gift"></i>
              مجاني
            </div>
          </div>

        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow"></div>

          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>

          <div class="code-card code-python">
            <div class="card-top">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <code>
              <span>def</span> build_future():<br />
              &nbsp;&nbsp;<span>return</span>
              <b>"Th.Tech"</b>
            </code>
          </div>

          <div class="code-card code-js">
            <div class="card-top">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <code>
              <span>const</span> future =<br />
              &nbsp;&nbsp;create(<b>technology</b>);
            </code>
          </div>

          <div class="code-card code-terminal">
            <div class="terminal-title">
              <span>Terminal</span>
              <i class="fa-solid fa-terminal"></i>
            </div>

            <code>
              $ npm run build<br />
              <span>✓ completed</span>
            </code>
          </div>

          <div class="hero-center">
            <div class="center-ring">
              <img
                src={`${base}/logo1.png`}
                alt="Th.Tech"
                width="90"
                height="90"
                decoding="async"
              />
            </div>

            <strong>Th.Tech</strong>
            <span>Technology Platform</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         TICKER
         ========================================== -->

    <section class="ticker-section" aria-label="التقنيات">
      <div class="ticker">
        <div class="ticker-track">
          <span>JavaScript</span>
          <span>Python</span>
          <span>React</span>
          <span>AWS</span>
          <span>Cyber Security</span>
          <span>Docker</span>
          <span>Node.js</span>
          <span>SQL</span>

          <span>JavaScript</span>
          <span>Python</span>
          <span>React</span>
          <span>AWS</span>
          <span>Cyber Security</span>
          <span>Docker</span>
          <span>Node.js</span>
          <span>SQL</span>
        </div>
      </div>
    </section>

    <!-- ==========================================
         STATS
         ========================================== -->

    <section class="stats-section">
      <div class="container stats-grid">

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-screwdriver-wrench"></i>
          </div>

          <strong class="counter" data-target={toolsCount}>0</strong>
          <span>أداة تقنية</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-route"></i>
          </div>

          <strong>4</strong>
          <span>مجالات تقنية</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-language"></i>
          </div>

          <strong>AR</strong>
          <span>محتوى عربي</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-infinity"></i>
          </div>

          <strong>مجاني</strong>
          <span>متاح للجميع</span>
        </div>

      </div>
    </section>

    <!-- ==========================================
         TOOL FINDER
         ========================================== -->

    <section class="tool-finder-section" aria-labelledby="finder-title">
      <div class="container">

        <div class="finder-box">

          <div class="finder-content">
            <div class="section-kicker">
              <i class="fa-solid fa-magnifying-glass"></i>
              البحث السريع
            </div>

            <h2 id="finder-title">
              ما الأداة التي تبحث عنها؟
            </h2>

            <p>
              ابحث بين أدوات Th.Tech مباشرة واستخدم الأداة المناسبة دون
              الحاجة إلى تصفح القائمة كاملة.
            </p>
          </div>

          <div class="finder-controls">

            <div class="search-input-wrap">
              <i class="fa-solid fa-magnifying-glass"></i>

              <input
                id="tool-search"
                type="search"
                placeholder="مثال: JSON أو SQL أو Base64..."
                autocomplete="off"
                aria-label="البحث عن أداة"
              />

              <button
                id="clear-tool-search"
                type="button"
                aria-label="مسح البحث"
                title="مسح البحث"
              >
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>

            <button
              id="random-tool"
              class="random-tool-btn"
              type="button"
            >
              <i class="fa-solid fa-shuffle"></i>
              أداة عشوائية
            </button>

          </div>

          <div
            id="tool-search-results"
            class="tool-search-results"
            aria-live="polite"
          ></div>

          <div id="tool-search-empty" class="tool-search-empty" hidden>
            <i class="fa-regular fa-face-frown"></i>
            <strong>لم نجد أداة بهذا الاسم</strong>
            <span>جرّب كلمة أخرى مثل JSON أو SQL أو QR.</span>
          </div>

        </div>

      </div>
    </section>

    <!-- ==========================================
         TOOLS
         ========================================== -->

    <section
      class="tools-section"
      id="tools"
      aria-labelledby="tools-title"
    >
      <div class="container">

        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            أدوات Th.Tech
          </div>

          <h2 id="tools-title">
            أدوات تقنية تساعدك على إنجاز عملك
          </h2>

          <p>
            مجموعة من الأدوات العملية للمطورين وصناع المحتوى والمهتمين
            بالتقنية، تعمل مباشرة من المتصفح.
          </p>
        </div>

        <div class="tools-grid">
          {
            featuredTools.map((slug) => (
              <a
                href={`${base}/tools/${slug}/`}
                class="tool-card"
                aria-label={`فتح أداة ${displayName(slug)}`}
                data-tool-link={slug}
              >
                <div class="tool-card-icon">
                  <i class="fa-solid fa-code"></i>
                </div>

                <div class="tool-card-content">
                  <h3>{displayName(slug)}</h3>

                  <p>
                    أداة تقنية متاحة مباشرة عبر المتصفح.
                  </p>
                </div>

                <span class="tool-arrow">
                  <i class="fa-solid fa-arrow-left"></i>
                </span>
              </a>
            ))
          }
        </div>

        <div class="section-action">
          <a
            href={`${base}/tools/`}
            class="outline-btn"
          >
            <span>عرض جميع الأدوات ({toolsCount})</span>
            <i class="fa-solid fa-arrow-left"></i>
          </a>
        </div>

      </div>
    </section>

    <!-- ==========================================
         TRACKS
         ========================================== -->

    <section
      class="tracks-section"
      aria-labelledby="tracks-title"
    >
      <div class="container">

        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-compass"></i>
            مجالات التقنية
          </div>

          <h2 id="tracks-title">
            اختر المجال الذي يناسبك
          </h2>

          <p>
            ابدأ من المجال الذي يهمك واستكشف الأدوات والمحتوى المرتبط به.
          </p>
        </div>

        <div class="tracks-grid">
          {
            tracks.map((track) => (
              <a
                href={`${base}/${track.slug}/`}
                class="track-card"
              >
                <div class="track-image">
                  <img
                    src={track.image}
                    alt={track.title}
                    loading="lazy"
                    decoding="async"
                  />

                  <div class="track-image-overlay"></div>

                  <div class="track-icon">
                    <i class={`fa-solid ${track.icon}`}></i>
                  </div>
                </div>

                <div class="track-content">
                  <h3>{track.title}</h3>

                  <p>{track.description}</p>

                  <div class="track-tags">
                    {track.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>

                  <span class="track-link">
                    استكشف المجال
                    <i class="fa-solid fa-arrow-left"></i>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ==========================================
         FEATURES
         ========================================== -->

    <section
      class="features-section"
      aria-labelledby="features-title"
    >
      <div class="container">

        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-sparkles"></i>
            لماذا Th.Tech؟
          </div>

          <h2 id="features-title">
            تجربة تقنية مصممة ببساطة
          </h2>

          <p>
            نركز على جعل الوصول إلى الأدوات والمعلومات التقنية أسرع وأسهل.
          </p>
        </div>

        <div class="features-grid">

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>سرعة في الوصول</h3>

            <p>
              انتقل مباشرة إلى الأداة أو المحتوى الذي تحتاجه بدون خطوات
              معقدة.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-mobile-screen-button"></i>
            </div>

            <h3>متجاوب بالكامل</h3>

            <p>
              تجربة مناسبة للحاسوب والهاتف والأجهزة اللوحية.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>خصوصية أفضل</h3>

            <p>
              العديد من الأدوات مصممة للعمل محلياً داخل المتصفح دون الحاجة
              إلى خادم خارجي.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>للمطورين والمهتمين</h3>

            <p>
              أدوات ومراجع تساعدك في البرمجة والبيانات والتقنيات الحديثة.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- ==========================================
         FAQ
         ========================================== -->

    <section
      class="faq-section"
      aria-labelledby="faq-title"
    >
      <div class="container faq-container">

        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-circle-question"></i>
            الأسئلة الشائعة
          </div>

          <h2 id="faq-title">
            أسئلة قد تساعدك قبل البدء
          </h2>

          <p>
            إجابات سريعة عن استخدام المنصة والأدوات.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details
                class="faq-item"
                open={index === 0}
              >
                <summary>
                  <span>{faq.question}</span>

                  <i class="fa-solid fa-plus"></i>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>

      </div>
    </section>

    <!-- ==========================================
         CTA
         ========================================== -->

