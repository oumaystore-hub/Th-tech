---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Th.Tech | المنصة التقنية</title>
  <meta name="description" content="Th.Tech منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والحوسبة السحابية." />
  <link rel="icon" type="image/png" href="/Th-tech/logo1.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- تطبيق الثيم فوراً قبل تحميل الصفحة (بنفس نظام صفحة Windows) -->
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>
<body>
  <Header />
  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=85" alt="" />
        <div class="hero-overlay"></div>
        <div class="hero-grid"></div>
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
      </div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="badge">
            <span class="badge-dot"></span>
            <i class="fas fa-rocket"></i>
            اكتشف، تعلّم، وابتكر
          </div>
          <h1>ابنِ <span id="typewriter" class="gradient-text"></span><span class="cursor">|</span></h1>
          <p class="hero-description">منصة تقنية عربية تجمع بين الشروحات المتقدمة، الأدلة المرجعية، الأدوات التفاعلية ومختبر الأكواد في تجربة تعليمية حديثة وسريعة.</p>
          
          <div class="hero-actions">
            <a href="/Th-tech/playground/" class="btn btn-primary">
              <i class="fas fa-code"></i><span>ابدأ البرمجة الآن</span><i class="fas fa-arrow-left btn-arrow"></i>
            </a>
            <a href="/Th-tech/guides/" class="btn btn-secondary">
              <i class="fas fa-book-open"></i><span>تصفح المكتبة</span>
            </a>
          </div>
          
          <div class="hero-features">
            <div class="hero-feature"><span class="feature-check"><i class="fas fa-bolt"></i></span><span>تنفيذ فوري</span></div>
            <div class="hero-feature"><span class="feature-check"><i class="fas fa-shield-alt"></i></span><span>آمن 100%</span></div>
            <div class="hero-feature"><span class="feature-check"><i class="fas fa-gift"></i></span><span>مجاني تماماً</span></div>
          </div>
        </div>

        <!-- Hero Visual -->
        <div class="hero-visual">
          <div class="visual-orbit orbit-1"></div>
          <div class="visual-orbit orbit-2"></div>

          <div class="float-card card-1">
            <div class="card-top">
              <div class="language-icon python"><i class="fab fa-python"></i></div>
              <div class="window-dots"><span></span><span></span><span></span></div>
            </div>
            <div class="code-box">
              <div><span class="code-purple">print</span><span class="code-white">(</span><span class="code-green">"مرحباً"</span><span class="code-white">)</span></div>
              <div class="code-comment"># Python 3.11</div>
              <div class="code-output"><i class="fas fa-terminal"></i> Hello World</div>
            </div>
          </div>

          <div class="float-card card-2">
            <div class="small-icon js-icon"><i class="fab fa-js"></i></div>
            <div><strong>JavaScript</strong><small>Modern Web</small></div>
            <i class="fas fa-check-circle status-icon"></i>
          </div>

          <div class="float-card card-3">
            <div class="small-icon terminal-icon"><i class="fas fa-terminal"></i></div>
            <div><strong>Terminal</strong><small>Ready to code</small></div>
          </div>

          <div class="float-card card-4">
            <div class="progress-icon"><i class="fas fa-check"></i></div>
            <div><strong>+150 درس</strong><small>جاهز للتعلم</small></div>
          </div>

          <div class="float-card card-5">
            <div class="small-icon react-icon"><i class="fab fa-react"></i></div>
            <div><strong>React</strong><small>UI Library</small></div>
          </div>

          <div class="float-card card-6">
            <div class="small-icon docker-icon"><i class="fab fa-docker"></i></div>
            <div><strong>Docker</strong><small>Container</small></div>
          </div>

          <div class="visual-center">
            <div class="center-ring">
              <div class="center-logo"><span>Th</span><small>.Tech</small></div>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-scroll"><span>اكتشف المزيد</span><i class="fas fa-chevron-down"></i></div>
    </section>

    <!-- TECH TICKER -->
    <div class="tech-ticker">
      <div class="ticker-fade ticker-fade-right"></div>
      <div class="ticker-fade ticker-fade-left"></div>
      <div class="ticker-track">
        <div class="tech-item"><i class="fab fa-js"></i> JavaScript</div>
        <div class="tech-item"><i class="fab fa-python"></i> Python</div>
        <div class="tech-item"><i class="fab fa-react"></i> React</div>
        <div class="tech-item"><i class="fab fa-aws"></i> AWS</div>
        <div class="tech-item"><i class="fas fa-shield-halved"></i> CyberSec</div>
        <div class="tech-item"><i class="fab fa-docker"></i> Docker</div>
        <div class="tech-item"><i class="fab fa-node-js"></i> Node.js</div>
        <div class="tech-item"><i class="fas fa-database"></i> SQL</div>
        <div class="tech-item"><i class="fab fa-js"></i> JavaScript</div>
        <div class="tech-item"><i class="fab fa-python"></i> Python</div>
        <div class="tech-item"><i class="fab fa-react"></i> React</div>
        <div class="tech-item"><i class="fab fa-aws"></i> AWS</div>
        <div class="tech-item"><i class="fas fa-shield-halved"></i> CyberSec</div>
        <div class="tech-item"><i class="fab fa-docker"></i> Docker</div>
        <div class="tech-item"><i class="fab fa-node-js"></i> Node.js</div>
        <div class="tech-item"><i class="fas fa-database"></i> SQL</div>
      </div>
    </div>

    <!-- STATS -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-icon-wrap"><i class="fas fa-book-open"></i></div>
            <div><span class="stat-num" data-target="150" data-suffix="+">0</span><span class="stat-label">دليل شامل</span></div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-icon-wrap"><i class="fas fa-users"></i></div>
            <div><span class="stat-num" data-target="50" data-suffix="K+">0</span><span class="stat-label">قارئ شهرياً</span></div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-icon-wrap"><i class="fas fa-percent"></i></div>
            <div><span class="stat-num" data-target="100" data-suffix="%">0</span><span class="stat-label">محتوى مجاني</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRACKS -->
    <section class="tracks">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker"><i class="fas fa-layer-group"></i> تعلّم بطريقة منظمة</span>
          <h2>مسارات <span>التعلم</span></h2>
          <p>اختر المجال الذي يناسبك وابدأ رحلة التعلم خطوة بخطوة.</p>
        </div>
        <div class="tracks-grid">
          <a href="/Th-tech/ai/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=700&q=85" alt="AI" loading="lazy" /><div class="track-img-overlay"></div><span class="track-number">01</span></div>
            <div class="track-body">
              <div class="track-icon"><i class="fas fa-brain"></i></div>
              <div class="track-title-row"><h3>الذكاء الاصطناعي</h3><span class="track-arrow"><i class="fas fa-arrow-left"></i></span></div>
              <p>تعلم الآلة والشبكات العصبية وتطبيقات الذكاء الاصطناعي الحديثة.</p>
              <ul class="track-list"><li><i class="fas fa-check"></i> Machine Learning</li><li><i class="fas fa-check"></i> Deep Learning</li></ul>
            </div>
          </a>
          <a href="/Th-tech/programming/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=700&q=85" alt="Code" loading="lazy" /><div class="track-img-overlay"></div><span class="track-number">02</span></div>
            <div class="track-body">
              <div class="track-icon"><i class="fas fa-code"></i></div>
              <div class="track-title-row"><h3>البرمجة</h3><span class="track-arrow"><i class="fas fa-arrow-left"></i></span></div>
              <p>تعلم تطوير المواقع والتطبيقات وبناء المشاريع الحديثة.</p>
              <ul class="track-list"><li><i class="fas fa-check"></i> Full Stack</li><li><i class="fas fa-check"></i> DevOps</li></ul>
            </div>
          </a>
          <a href="/Th-tech/security/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=700&q=85" alt="Security" loading="lazy" /><div class="track-img-overlay"></div><span class="track-number">03</span></div>
            <div class="track-body">
              <div class="track-icon"><i class="fas fa-shield-halved"></i></div>
              <div class="track-title-row"><h3>الأمن السيبراني</h3><span class="track-arrow"><i class="fas fa-arrow-left"></i></span></div>
              <p>فهم أساسيات الحماية واختبار الاختراق وأمن الأنظمة.</p>
              <ul class="track-list"><li><i class="fas fa-check"></i> Ethical Hacking</li><li><i class="fas fa-check"></i> Network Security</li></ul>
            </div>
          </a>
          <a href="/Th-tech/cloud/" class="track">
            <div class="track-img"><img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=700&q=85" alt="Cloud" loading="lazy" /><div class="track-img-overlay"></div><span class="track-number">04</span></div>
            <div class="track-body">
              <div class="track-icon"><i class="fas fa-cloud"></i></div>
              <div class="track-title-row"><h3>الحوسبة السحابية</h3><span class="track-arrow"><i class="fas fa-arrow-left"></i></span></div>
              <p>اكتشف AWS وDocker وKubernetes وبنية الخدمات السحابية.</p>
              <ul class="track-list"><li><i class="fas fa-check"></i> AWS</li><li><i class="fas fa-check"></i> Docker</li></ul>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker"><i class="fas fa-sparkles"></i> تجربة مختلفة</span>
          <h2>لماذا <span>Th.Tech؟</span></h2>
          <p>أدوات ومحتوى مصمم لتجعل التعلم التقني أبسط وأسرع.</p>
        </div>
        <div class="features-grid">
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-bolt"></i></div>
            <h3>سرعة فائقة</h3>
            <p>تجربة سريعة وخفيفة مع تنفيذ الكود فورياً.</p>
            <span class="feature-number">01</span>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-mobile-screen-button"></i></div>
            <h3>متجاوب بالكامل</h3>
            <p>تصميم يعمل بسلاسة على الهاتف والكمبيوتر واللوحي.</p>
            <span class="feature-number">02</span>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-floppy-disk"></i></div>
            <h3>حفظ تلقائي</h3>
            <p>يتم حفظ أكوادك وأعمالك محلياً داخل المتصفح.</p>
            <span class="feature-number">03</span>
          </div>
          <div class="feature-box">
            <div class="feature-icon"><i class="fas fa-download"></i></div>
            <h3>تصدير سهل</h3>
            <p>احفظ مشاريعك وأكوادك بسهولة وبصيغ مختلفة.</p>
            <span class="feature-number">04</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker"><i class="fas fa-circle-question"></i> لديك سؤال؟</span>
          <h2>الأسئلة <span>الشائعة</span></h2>
          <p>إجابات سريعة على أكثر الأسئلة التي قد تخطر في بالك.</p>
        </div>
        <div class="faq-grid">
          <div class="faq-item">
            <div class="faq-icon"><i class="fas fa-user-graduate"></i></div>
            <div><h3>هل أحتاج خبرة سابقة؟</h3><p>لا! نبدأ معك من الأساسيات ونتدرج بك حتى المستويات المتقدمة.</p></div>
          </div>
          <div class="faq-item">
            <div class="faq-icon"><i class="fas fa-terminal"></i></div>
            <div><h3>كيف أستخدم المحرر؟</h3><p>اكتب الكود داخل المحرر واضغط على زر "تشغيل" لمشاهدة النتيجة.</p></div>
          </div>
          <div class="faq-item">
            <div class="faq-icon"><i class="fas fa-save"></i></div>
            <div><h3>هل يمكنني حفظ أعمالي؟</h3><p>نعم، يتم حفظ الأكواد محلياً في المتصفح لتتمكن من العودة إليها.</p></div>
          </div>
          <div class="faq-item">
            <div class="faq-icon"><i class="fas fa-code"></i></div>
            <div><h3>ما اللغات المدعومة؟</h3><p>Python وJavaScript وHTML وغيرها من التقنيات التي ستتم إضافتها.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <div class="cta-glow"></div>
      <div class="container">
        <div class="cta-box">
          <div class="cta-content">
            <span class="section-kicker"><i class="fas fa-code"></i> مستعد للبدء؟</span>
            <h2>حوّل أفكارك إلى <span>واقع رقمي.</span></h2>
            <p>ابدأ الآن واستكشف عالم البرمجة والتقنية بطريقة مختلفة.</p>
            <a href="/Th-tech/playground/" class="btn btn-primary cta-button">
              <i class="fas fa-terminal"></i> افتح مختبر الأكواد <i class="fas fa-arrow-left"></i>
            </a>
          </div>
          <div class="cta-decoration">
            <div class="cta-code"><span>&lt;</span><strong>code</strong><span>/&gt;</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- SCROLL TOP -->
  <button id="scrollTop" class="scroll-top" aria-label="العودة إلى الأعلى" type="button">
    <i class="fas fa-arrow-up"></i>
  </button>

  <style>
    /* ===== THEME SYSTEM - نفس نظام صفحة Windows ===== */
    :root {
      /* Light Mode (Default) */
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --bg3: #eaf0f7;
      --text: #0f172a;
      --text-muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --cyan: #0891b2;
      --border: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(37, 99, 235, 0.25);
      --card: #ffffff;
      --card-solid: #ffffff;
      --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
      --radius: 20px;
    }

    /* Dark Mode - باستخدام class مثل صفحة Windows */
    html.dark-mode {
      --bg: #07101f;
      --bg2: #0b1426;
      --bg3: #111d32;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --cyan: #06b6d4;
      --border: rgba(148, 163, 184, 0.12);
      --border-strong: rgba(59, 130, 246, 0.28);
      --card: rgba(17, 29, 50, 0.82);
      --card-solid: #111d32;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
    }

    /* Reset & Base */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { 
      background: var(--bg); 
      color: var(--text); 
      font-family: 'Cairo', sans-serif; 
      line-height: 1.7; 
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    button, a { -webkit-tap-highlight-color: transparent; }
    .container { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 24px; }
    section { position: relative; padding: 110px 0; }

    /* HERO */
    .hero { min-height: 720px; height: calc(100vh - 0px); max-height: 900px; display: flex; align-items: center; position: relative; overflow: hidden; padding: 130px 0 90px; }
    .hero-bg { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.52) saturate(0.7); }
    html.dark-mode .hero-bg img { filter: brightness(0.34) saturate(0.8); }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(248,250,252,0.96) 0%, rgba(248,250,252,0.85) 45%, rgba(248,250,252,0.60) 100%); }
    html.dark-mode .hero-overlay { background: linear-gradient(90deg, rgba(7,16,31,0.97) 0%, rgba(7,16,31,0.84) 38%, rgba(7,16,31,0.55) 70%, rgba(7,16,31,0.86) 100%); }
    .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(37,99,235,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(37,99,235,0.07) 1px, transparent 1px); background-size: 60px 60px; mask-image: linear-gradient(to bottom, black, transparent 90%); opacity: 0.6; }
    html.dark-mode .hero-grid { background-image: linear-gradient(rgba(59,130,246,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.07) 1px, transparent 1px); }
    .hero-glow { position: absolute; width: 500px; height: 500px; border-radius: 50%; filter: blur(100px); opacity: 0.14; pointer-events: none; }
    .hero-glow-1 { background: var(--primary); top: -200px; right: 10%; }
    .hero-glow-2 { background: var(--cyan); bottom: -300px; left: 10%; }
    .hero-container { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .hero-content { position: relative; z-index: 5; }
    .badge { width: fit-content; display: inline-flex; align-items: center; gap: 9px; padding: 8px 16px; border-radius: 50px; background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.25); color: #2563eb; font-size: 0.9rem; font-weight: 700; margin-bottom: 25px; backdrop-filter: blur(12px); }
    html.dark-mode .badge { background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.25); color: #60a5fa; }
    .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px rgba(34,197,94,0.1), 0 0 15px rgba(34,197,94,0.5); }
    .hero h1 { max-width: 700px; font-size: clamp(2.6rem, 5vw, 4.5rem); line-height: 1.18; letter-spacing: -1px; margin-bottom: 24px; }
    .gradient-text { background: linear-gradient(135deg, #60a5fa, #3b82f6 45%, #22d3ee); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
    .cursor { color: var(--primary); animation: blink 1s infinite; }
    @keyframes blink { 0%, 45% { opacity: 1; } 50%, 100% { opacity: 0; } }
    .hero-description { max-width: 640px; color: var(--text-muted); font-size: 1.08rem; line-height: 2; margin-bottom: 32px; }
    .hero-actions { display: flex; align-items: center; gap: 13px; flex-wrap: wrap; margin-bottom: 32px; }
    .btn { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 13px 22px; border-radius: 13px; border: 1px solid transparent; font-family: inherit; font-size: 0.96rem; font-weight: 700; cursor: pointer; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease; }
    .btn-primary { color: #fff; background: linear-gradient(135deg, #3b82f6, #2563eb); box-shadow: 0 10px 30px rgba(37,99,235,0.25); }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(37,99,235,0.35); }
    .btn-arrow { transition: transform 0.25s ease; }
    .btn-primary:hover .btn-arrow { transform: translateX(-4px); }
    .btn-secondary { background: rgba(255,255,255,0.75); color: var(--text); border-color: rgba(15,23,42,0.09); backdrop-filter: blur(12px); }
    html.dark-mode .btn-secondary { background: rgba(15,23,42,0.55); color: var(--text); border-color: rgba(148,163,184,0.2); }
    .btn-secondary:hover { transform: translateY(-3px); border-color: var(--primary); color: var(--primary); }
    .hero-features { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }
