---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = `https://oumaystore-hub.github.io${base}`;

/* ==========================================
   اكتشاف الأدوات تلقائياً
   ========================================== */

const toolModules = import.meta.glob('./tools/*/index.astro', {
  eager: true,
  query: '?url',
  import: 'default'
});

const toolSlugs = Object.keys(toolModules)
  .map((file) => {
    const match = file.match(/\.\/tools\/([^/]+)\/index\.astro$/);
    return match ? match[1] : null;
  })
  .filter(Boolean) as string[];

const displayName = (slug: string) =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

/*
 * أدوات مفضلة تظهر أولاً إن كانت موجودة.
 * بقية الأدوات يتم اختيارها تلقائياً.
 */
const preferredTools = [
  'api-request-builder',
  'json-formatter',
  'json-validator',
  'sql-formatter',
  'markdown-editor',
  'base64-encoder',
  'base64-decoder',
  'qr-code-generator',
  'barcode-generator',
  'color-picker',
  'regex-tester',
  'uuid-generator'
];

const sortedTools = [...toolSlugs].sort((a, b) => {
  const ai = preferredTools.indexOf(a);
  const bi = preferredTools.indexOf(b);

  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;

  return a.localeCompare(b);
});

const featuredTools = sortedTools.slice(0, 12);
const toolsCount = toolSlugs.length;

/* ==========================================
   بيانات المسارات
   ========================================== */

const tracks = [
  {
    title: 'الذكاء الاصطناعي',
    slug: 'ai',
    icon: 'fa-brain',
    image:
      'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1200&q=80',
    description:
      'استكشف الذكاء الاصطناعي وتعلم المفاهيم والتقنيات التي تقود مستقبل التقنية.',
    tags: ['AI', 'Machine Learning', 'Automation']
  },
  {
    title: 'البرمجة',
    slug: 'programming',
    icon: 'fa-code',
    image:
      'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعلم البرمجة وتطوير التطبيقات وفهم الأدوات والمفاهيم الأساسية للمطورين.',
    tags: ['JavaScript', 'Python', 'Web']
  },
  {
    title: 'الأمن السيبراني',
    slug: 'security',
    icon: 'fa-shield-halved',
    image:
      'https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=1200&q=80',
    description:
      'تعرف على مفاهيم الأمن السيبراني والشبكات والتشفير وحماية الأنظمة.',
    tags: ['Security', 'Networks', 'Cryptography']
  },
  {
    title: 'الحوسبة السحابية',
    slug: 'cloud',
    icon: 'fa-cloud',
    image:
      'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80',
    description:
      'اكتشف الحوسبة السحابية والبنية التحتية والخدمات الحديثة للمطورين.',
    tags: ['AWS', 'Cloud', 'DevOps']
  }
];

const faqs = [
  {
    question: 'هل أحتاج إلى خبرة سابقة؟',
    answer:
      'لا. يمكنك البدء من المستوى الذي يناسبك، واستكشاف الأدوات والمقالات والأدلة تدريجياً حسب احتياجاتك.'
  },
  {
    question: 'هل الأدوات تعمل مباشرة من المتصفح؟',
    answer:
      'نعم، العديد من أدوات Th.Tech مصممة للعمل مباشرة من المتصفح، مع التركيز على السرعة وسهولة الاستخدام وتقليل الحاجة إلى خدمات خارجية.'
  },
  {
    question: 'هل الأدوات مجانية؟',
    answer:
      'نعم، أدوات Th.Tech متاحة للاستخدام مجاناً، ويمكنك الوصول إليها مباشرة من قسم الأدوات.'
  },
  {
    question: 'ما أنواع الأدوات الموجودة؟',
    answer:
      'ستجد أدوات للمطورين والبيانات والنصوص وJSON وSQL والترميز والتشفير والألوان والروابط وغيرها، ويتم تنظيمها باستمرار لتسهيل الوصول إليها.'
  },
  {
    question: 'هل أستطيع استخدام الموقع من الهاتف؟',
    answer:
      'نعم. تم تصميم الواجهة لتعمل على الحاسوب والهاتف والأجهزة اللوحية مع الحفاظ على سهولة التنقل والاستخدام.'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Th.Tech',
      description:
        'منصة تقنية عربية للتعلم والبرمجة والذكاء الاصطناعي والأمن السيبراني والأدوات التقنية.',
      inLanguage: 'ar'
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Th.Tech',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/logo1.png`,
      email: 'thtech.tech@gmail.com',
      sameAs: [
        'https://www.facebook.com/share/1PzewvX774/',
        'https://www.instagram.com/thtech.ma',
        'https://x.com/thtechma',
        'https://www.youtube.com/@thtechma',
        'https://www.linkedin.com/in/th-tech-المنصة-التقنية-341764438'
      ]
    }
  ]
};
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Th.Tech | منصة تقنية عربية للتعلم والأدوات والبرمجة</title>

  <meta
    name="description"
    content="Th.Tech منصة تقنية عربية تجمع الأدوات التفاعلية، البرمجة، الذكاء الاصطناعي، الأمن السيبراني، الحوسبة السحابية والأدلة التقنية في مكان واحد."
  />

  <meta
    name="keywords"
    content="Th.Tech, أدوات تقنية, أدوات للمطورين, برمجة, ذكاء اصطناعي, أمن سيبراني, SQL, JSON, JavaScript, Python, أدوات أونلاين"
  />

  <meta name="author" content="Th.Tech" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={`${siteUrl}/`} />
  <link rel="icon" type="image/png" href={`${siteUrl}/logo1.png`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="Th.Tech" />
  <meta property="og:title" content="Th.Tech | المنصة التقنية" />
  <meta
    property="og:description"
    content="أدوات تقنية تفاعلية ومحتوى عربي للبرمجة والذكاء الاصطناعي والأمن السيبراني."
  />
  <meta property="og:url" content={`${siteUrl}/`} />
  <meta property="og:image" content={`${siteUrl}/logo1.png`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Th.Tech | المنصة التقنية" />
  <meta
    name="twitter:description"
    content="منصة تقنية عربية تجمع الأدوات والمحتوى التعليمي للمطورين والمهتمين بالتقنية."
  />
  <meta name="twitter:image" content={`${siteUrl}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (
          saved === 'dark' ||
          (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>
  <Header />

  <main>
    <!-- ==========================================
         HERO
         ========================================== -->

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-background"></div>
      <div class="hero-grid"></div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            اكتشف، تعلّم، وابتكر
          </div>

          <h1 id="hero-title">
            ابنِ
            <span class="typing-wrapper">
              <span id="typing-text">المستقبل الرقمي</span>
            </span>
            بأدوات احترافية
          </h1>

          <p class="hero-description">
            منصة تقنية عربية تجمع بين الأدوات التفاعلية، الشروحات، الأدلة
            المرجعية والمسارات التعليمية في تجربة حديثة وسريعة.
          </p>

          <div class="hero-actions">
            <a href={`${base}/tools/`} class="btn btn-primary">
              <i class="fa-solid fa-toolbox"></i>
              <span>استكشف الأدوات</span>
            </a>

            <a href={`${base}/guides/`} class="btn btn-secondary">
              <i class="fa-solid fa-book-open"></i>
              <span>تصفح المكتبة</span>
            </a>
          </div>

          <div class="hero-features">
            <div>
              <i class="fa-solid fa-bolt"></i>
              تنفيذ سريع
            </div>

            <div>
              <i class="fa-solid fa-lock"></i>
              تجربة آمنة
            </div>

            <div>
              <i class="fa-solid fa-gift"></i>
              مجاني
            </div>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow"></div>

          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>

          <div class="code-card code-python">
            <div class="card-top">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <code>
              <span>def</span> build_future():<br />
              &nbsp;&nbsp;<span>return</span>
              <b>"Th.Tech"</b>
            </code>
          </div>

          <div class="code-card code-js">
            <div class="card-top">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <code>
              <span>const</span> future =<br />
              &nbsp;&nbsp;create(<b>technology</b>);
            </code>
          </div>

          <div class="code-card code-terminal">
            <div class="terminal-title">
              <span>Terminal</span>
              <i class="fa-solid fa-terminal"></i>
            </div>

            <code>
              $ npm run build<br />
              <span>✓ completed</span>
            </code>
          </div>

          <div class="hero-center">
            <div class="center-ring">
              <img src={`${base}/logo1.png`} alt="Th.Tech" />
            </div>

            <strong>Th.Tech</strong>
            <span>Technology Platform</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         TECH TICKER
         ========================================== -->

    <section class="ticker-section" aria-label="التقنيات">
      <div class="ticker">
        <div class="ticker-track">
          <span>JavaScript</span>
          <span>Python</span>
          <span>React</span>
          <span>AWS</span>
          <span>Cyber Security</span>
          <span>Docker</span>
          <span>Node.js</span>
          <span>SQL</span>

          <span>JavaScript</span>
          <span>Python</span>
          <span>React</span>
          <span>AWS</span>
          <span>Cyber Security</span>
          <span>Docker</span>
          <span>Node.js</span>
          <span>SQL</span>
        </div>
      </div>
    </section>

    <!-- ==========================================
         STATS
         ========================================== -->

    <section class="stats-section">
      <div class="container stats-grid">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-screwdriver-wrench"></i>
          </div>

          <strong class="counter" data-target={toolsCount}>0</strong>
          <span>أداة تقنية</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-route"></i>
          </div>

          <strong>4</strong>
          <span>مجالات تقنية</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-language"></i>
          </div>

          <strong>AR</strong>
          <span>محتوى عربي</span>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-infinity"></i>
          </div>

          <strong>مجاني</strong>
          <span>متاح للجميع</span>
        </div>
      </div>
    </section>

    <!-- ==========================================
         TOOLS
         ========================================== -->

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
      <div class="container">
        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            أدوات Th.Tech
          </div>

          <h2 id="tools-title">أدوات تقنية تساعدك على إنجاز عملك</h2>

          <p>
            مجموعة من الأدوات العملية للمطورين وصناع المحتوى والمهتمين
            بالتقنية، تعمل مباشرة من المتصفح.
          </p>
        </div>

        <div class="tools-grid">
          {
            featuredTools.map((slug) => (
              <a
                href={`${base}/tools/${slug}/`}
                class="tool-card"
                aria-label={`فتح أداة ${displayName(slug)}`}
              >
                <div class="tool-card-icon">
                  <i class="fa-solid fa-code"></i>
                </div>

                <div class="tool-card-content">
                  <h3>{displayName(slug)}</h3>
                  <p>أداة تقنية متاحة مباشرة عبر المتصفح.</p>
                </div>

                <span class="tool-arrow">
                  <i class="fa-solid fa-arrow-left"></i>
                </span>
              </a>
            ))
          }
        </div>

        <div class="section-action">
          <a href={`${base}/tools/`} class="outline-btn">
            <span>عرض جميع الأدوات</span>
            <i class="fa-solid fa-arrow-left"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- ==========================================
         TRACKS
         ========================================== -->

    <section class="tracks-section" aria-labelledby="tracks-title">
      <div class="container">
        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-compass"></i>
            مجالات التقنية
          </div>

          <h2 id="tracks-title">اختر المجال الذي يناسبك</h2>

          <p>
            ابدأ من المجال الذي يهمك واستكشف الأدوات والمحتوى المرتبط به.
          </p>
        </div>

        <div class="tracks-grid">
          {
            tracks.map((track) => (
              <a href={`${base}/${track.slug}/`} class="track-card">
                <div class="track-image">
                  <img
                    src={track.image}
                    alt={track.title}
                    loading="lazy"
                  />

                  <div class="track-image-overlay"></div>

                  <div class="track-icon">
                    <i class={`fa-solid ${track.icon}`}></i>
                  </div>
                </div>

                <div class="track-content">
                  <h3>{track.title}</h3>

                  <p>{track.description}</p>

                  <div class="track-tags">
                    {track.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>

                  <span class="track-link">
                    استكشف المجال
                    <i class="fa-solid fa-arrow-left"></i>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================
         FEATURES
         ========================================== -->

    <section class="features-section" aria-labelledby="features-title">
      <div class="container">
        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-sparkles"></i>
            لماذا Th.Tech؟
          </div>

          <h2 id="features-title">تجربة تقنية مصممة ببساطة</h2>

          <p>
            نركز على جعل الوصول إلى الأدوات والمعلومات التقنية أسرع وأسهل.
          </p>
        </div>

        <div class="features-grid">
          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>سرعة في الوصول</h3>

            <p>
              انتقل مباشرة إلى الأداة أو المحتوى الذي تحتاجه بدون خطوات
              معقدة.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-mobile-screen-button"></i>
            </div>

            <h3>متجاوب بالكامل</h3>

            <p>
              تجربة مناسبة للحاسوب والهاتف والأجهزة اللوحية.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>خصوصية أفضل</h3>

            <p>
              العديد من الأدوات مصممة للعمل محلياً داخل المتصفح دون الحاجة
              إلى خادم خارجي.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>للمطورين والمهتمين</h3>

            <p>
              أدوات ومراجع تساعدك في البرمجة والبيانات والتقنيات الحديثة.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ==========================================
         FAQ
         ========================================== -->

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="container faq-container">
        <div class="section-heading">
          <div class="section-kicker">
            <i class="fa-solid fa-circle-question"></i>
            الأسئلة الشائعة
          </div>

          <h2 id="faq-title">أسئلة قد تساعدك قبل البدء</h2>

          <p>
            إجابات سريعة عن استخدام المنصة والأدوات.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span>{faq.question}</span>

                  <i class="fa-solid fa-plus"></i>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================
         CTA
         ========================================== -->

    <section class="cta-section">
      <div class="cta-glow"></div>

      <div class="container">
        <div class="cta-box">
          <div class="cta-icon">
            <i class="fa-solid fa-rocket"></i>
          </div>

          <h2>حوّل أفكارك إلى واقع رقمي</h2>

          <p>
            ابدأ باستكشاف أدوات Th.Tech واستخدم الأدوات المناسبة لمهمتك
            مباشرة من المتصفح.
          </p>

          <div class="cta-actions">
            <a href={`${base}/tools/`} class="btn btn-primary">
              <i class="fa-solid fa-toolbox"></i>
              استكشف الأدوات
            </a>

            <a href={`${base}/contact/`} class="btn btn-secondary">
              <i class="fa-solid fa-envelope"></i>
              تواصل معنا
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ==========================================
       SCROLL TOP
       ========================================== -->

  <button
    id="scroll-top"
    class="scroll-top"
    aria-label="العودة إلى أعلى الصفحة"
    type="button"
  >
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <Footer />
</body>
</html>

<style>
  /* ==========================================
     VARIABLES
     ========================================== */

  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-2: #f1f5f9;
    --text: #0f172a;
    --text-soft: #64748b;
    --primary: #0284c7;
    --primary-dark: #0369a1;
    --accent: #06b6d4;
    --border: rgba(15, 23, 42, 0.09);
    --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    --radius: 22px;
  }

  html.dark-mode {
    --bg: #07111f;
    --surface: #0f1b2d;
    --surface-2: #162235;
    --text: #f1f5f9;
    --text-soft: #94a3b8;
    --primary: #38bdf8;
    --primary-dark: #0284c7;
    --accent: #22d3ee;
    --border: rgba(148, 163, 184, 0.12);
    --shadow: 0 20px 70px rgba(0, 0, 0, 0.25);
  }

  /* ==========================================
     BASE
     ========================================== */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    overflow-x: hidden;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  section {
    position: relative;
    padding: 100px 0;
  }

  /* ==========================================
     HERO
     ========================================== */

  .hero {
    min-height: 760px;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 80px 0;
    background:
      radial-gradient(
        circle at 75% 30%,
        rgba(14, 165, 233, 0.13),
        transparent 32%
      ),
      var(--bg);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image:
      linear-gradient(
        rgba(2, 132, 199, 0.1) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(2, 132, 199, 0.1) 1px,
        transparent 1px
      );
    background-size: 42px 42px;
    mask-image: linear-gradient(
      to bottom,
      black,
      transparent
    );
  }

  .hero-grid {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(6, 182, 212, 0.12);
    filter: blur(100px);
    left: -150px;
    bottom: -200px;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    animation: heroContent 0.8s ease both;
  }

  @keyframes heroContent {
    from {
      opacity: 0;
      transform: translateY(25px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid rgba(2, 132, 199, 0.2);
    background: rgba(2, 132, 199, 0.07);
    color: var(--primary);
    font-weight: 700;
    margin-bottom: 25px;
  }

  .badge-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 15px var(--accent);
  }

  .hero h1 {
    font-size: clamp(2.7rem, 5vw, 5rem);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -2px;
    margin-bottom: 25px;
  }

  .typing-wrapper {
    color: var(--primary);
    display: inline-block;
  }

  #typing-text {
    border-left: 3px solid var(--primary);
    padding-left: 8px;
  }

  .hero-description {
    max-width: 650px;
    color: var(--text-soft);
    font-size: 1.15rem;
    line-height: 2;
    margin-bottom: 30px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn {
    min-height: 54px;
    padding: 0 25px;
    border-radius: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 800;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .btn:hover {
    transform: translateY(-3px);
  }

  .btn-primary {
    color: white;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--accent)
    );
    box-shadow: 0 12px 30px rgba(2, 132, 199, 0.25);
  }

  .btn-secondary {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .hero-features div {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .hero-features i {
    color: var(--primary);
  }

  /* ==========================================
     HERO VISUAL
     ========================================== */

  .hero-visual {
    height: 520px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-glow {
    position: absolute;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    background: rgba(6, 182, 212, 0.14);
    filter: blur(70px);
  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(2, 132, 199, 0.18);
    border-radius: 50%;
  }

  .orbit-one {
    width: 420px;
    height: 420px;
    animation: rotate 25s linear infinite;
  }

  .orbit-two {
    width: 290px;
    height: 290px;
    animation: rotateReverse 18s linear infinite;
  }

  @keyframes rotate {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rotateReverse {
    to {
      transform: rotate(-360deg);
    }
  }

  .hero-center {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .center-ring {
    width: 90px;
    height: 90px;
    padding: 12px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--accent)
    );
    margin-bottom: 10px;
  }

  .center-ring img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    background: white;
  }

  .hero-center strong {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem;
  }

  .hero-center span {
    color: var(--text-soft);
    font-size: 0.7rem;
  }

  .code-card {
    position: absolute;
    z-index: 4;
    padding: 15px;
    border-radius: 13px;
    background: rgba(15, 23, 42, 0.93);
    color: #dbeafe;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    animation: floating 5s ease-in-out infinite;
  }

  @keyframes floating {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-12px);
    }
  }

  .code-card .card-top {
    display: flex;
    gap: 5px;
    margin-bottom: 12px;
  }

  .code-card .card-top span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #64748b;
  }

  .code-card code span {
    color: #38bdf8;
  }

  .code-card code b {
    color: #a7f3d0;
  }

  .code-python {
    top: 65px;
    right: 5px;
  }

  .code-js {
    bottom: 70px;
    left: 10px;
    animation-delay: 1s;
  }

  .code-terminal {
    bottom: 20px;
    right: 80px;
    animation-delay: 2s;
  }

  .terminal-title {
    display: flex;
    justify-content: space-between;
    color: #94a3b8;
    margin-bottom: 10px;
  }

  .code-terminal code span {
    color: #4ade80;
  }

  /* ==========================================
     TICKER
     ========================================== */

  .ticker-section {
    padding: 0;
    border-block: 1px solid var(--border);
    overflow: hidden;
    background: var(--surface);
  }

  .ticker {
    overflow: hidden;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    gap: 55px;
    padding: 22px 0;
    animation: ticker 35s linear infinite;
  }

  .ticker-track span {
    color: var(--text-soft);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    white-space: nowrap;
  }

  @keyframes ticker {
    to {
      transform: translateX(50%);
    }
  }

  /* ==========================================
     SECTION HEADING
     ========================================== */

  .section-heading {
    max-width: 720px;
    margin: 0 auto 50px;
    text-align: center;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-weight: 800;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.3;
    margin-bottom: 15px;
  }

  .section-heading p {
    color: var(--text-soft);
    line-height: 1.9;
  }

  /* ==========================================
     STATS
     ========================================== */

  .stats-section {
    padding: 45px 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .stat-card {
    text-align: center;
    padding: 20px;
    border-left: 1px solid var(--border);
  }

  .stat-card:last-child {
    border-left: 0;
  }

  .stat-icon {
    color: var(--primary);
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .stat-card strong {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--text);
  }

  .stat-card span {
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  /* ==========================================
     TOOLS
     ========================================== */

  .tools-section {
    background: var(--bg);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .tool-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px;
    min-height: 110px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .tool-card:hover {
    transform: translateY(-5px);
    border-color: rgba(2, 132, 199, 0.4);
    box-shadow: var(--shadow);
  }

  .tool-card-icon {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    color: var(--primary);
    background: rgba(2, 132, 199, 0.1);
    font-size: 1.2rem;
  }

  .tool-card-content {
    min-width: 0;
    flex: 1;
  }

  .tool-card h3 {
    font-size: 1rem;
    margin-bottom: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-card p {
    color: var(--text-soft);
    font-size: 0.78rem;
  }

  .tool-arrow {
    color: var(--primary);
    transition: transform 0.25s ease;
  }

  .tool-card:hover .tool-arrow {
    transform: translateX(-5px);
  }

  .section-action {
    text-align: center;
    margin-top: 35px;
  }

  .outline-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    transition: 0.25s ease;
  }

  .outline-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-2px);
  }

  /* ==========================================
     TRACKS
     ========================================== */

  .tracks-section {
    background: var(--surface);
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .track-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .track-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow);
  }

  .track-image {
    height: 190px;
    position: relative;
    overflow: hidden;
  }

  .track-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .track-card:hover .track-image img {
    transform: scale(1.06);
  }

  .track-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(2, 8, 23, 0.75),
      transparent
    );
  }

  .track-icon {
    position: absolute;
    bottom: 15px;
    right: 15px;
    width: 45px;
    height: 45px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    color: #fff;
  }

  .track-content {
    padding: 22px;
  }

  .track-content h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .track-content p {
    color: var(--text-soft);
    font-size: 0.88rem;
    line-height: 1.8;
    margin-bottom: 15px;
  }

  .track-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .track-tags span {
    padding: 5px 8px;
    border-radius: 7px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.7rem;
  }

  .track-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--primary);
    font-weight: 800;
    font-size: 0.85rem;
  }

  /* ==========================================
     FEATURES
     ========================================== */

  .features-section {
    background: var(--bg);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .feature-card {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: rgba(2, 132, 199, 0.35);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 15px;
    color: var(--primary);
    background: rgba(2, 132, 199, 0.1);
    margin-bottom: 18px;
    font-size: 1.2rem;
  }

  .feature-card h3 {
    margin-bottom: 10px;
  }

  .feature-card p {
    color: var(--text-soft);
    line-height: 1.8;
    font-size: 0.88rem;
  }

  /* ==========================================
     FAQ
     ========================================== */

  .faq-section {
    background: var(--surface);
  }

  .faq-container {
    max-width: 900px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg);
    overflow: hidden;
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 21px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-weight: 700;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary i {
    color: var(--primary);
    transition: transform 0.25s ease;
  }

  .faq-item[open] summary i {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 24px 22px;
    color: var(--text-soft);
    line-height: 1.9;
  }

  /* ==========================================
     CTA
     ========================================== */

  .cta-section {
    padding: 90px 0;
    overflow: hidden;
    background:
      radial-gradient(
        circle at center,
        rgba(6, 182, 212, 0.14),
        transparent 55%
      ),
      var(--bg);
  }

  .cta-box {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 70px 30px;
    border-radius: 30px;
    border: 1px solid rgba(2, 132, 199, 0.2);
    background:
      linear-gradient(
        135deg,
        rgba(2, 132, 199, 0.1),
        rgba(6, 182, 212, 0.05)
      ),
      var(--surface);
  }

  .cta-icon {
    width: 65px;
    height: 65px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    color: white;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--accent)
    );
    font-size: 1.5rem;
  }

  .cta-box h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 15px;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0 auto 28px;
    color: var(--text-soft);
    line-height: 1.9;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ==========================================
     SCROLL TOP
     ========================================== */

  .scroll-top {
    position: fixed;
    left: 22px;
    bottom: 22px;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: white;
    background: var(--primary);
    box-shadow: 0 10px 30px rgba(2, 132, 199, 0.3);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: 0.25s ease;
    z-index: 100;
  }

  .scroll-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .scroll-top:hover {
    transform: translateY(-3px);
  }

  /* ==========================================
     RESPONSIVE
     ========================================== */

  @media (max-width: 1100px) {
    .hero-container {
      gap: 30px;
    }

    .tracks-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    section {
      padding: 80px 0;
    }

    .hero {
      min-height: auto;
      padding: 80px 0;
    }

    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-description {
      margin-inline: auto;
    }

    .hero-actions,
    .hero-features {
      justify-content: center;
    }

    .hero-visual {
      height: 430px;
      margin-top: 20px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-card {
      border-left: 0;
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 24px, 1180px);
    }

    section {
      padding: 65px 0;
    }

    .hero {
      padding: 65px 0 45px;
    }

    .hero h1 {
      font-size: 2.45rem;
      letter-spacing: -1px;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-features {
      gap: 12px;
      font-size: 0.8rem;
    }

    .hero-visual {
      height: 330px;
    }

    .orbit-one {
      width: 280px;
      height: 280px;
    }

    .orbit-two {
      width: 210px;
      height: 210px;
    }

    .hero-center {
      width: 150px;
      height: 150px;
    }

    .center-ring {
      width: 62px;
      height: 62px;
      padding: 8px;
    }

    .hero-center strong {
      font-size: 0.95rem;
    }

    .hero-center span {
      font-size: 0.55rem;
    }

    .code-card {
      font-size: 0.56rem;
      padding: 10px;
    }

    .code-python {
      top: 15px;
      right: 0;
    }

    .code-js {
      bottom: 15px;
      left: 0;
    }

    .code-terminal {
      bottom: -5px;
      right: 45px;
    }

    .section-heading {
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: 1.9rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .stat-card {
      padding: 15px 5px;
    }

    .stat-card strong {
      font-size: 1.55rem;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tracks-grid,
    .features-grid {
      grid-template-columns: 1fr;
    }

    .track-image {
      height: 210px;
    }

    .feature-card {
      padding: 22px;
    }

    .faq-item summary {
      padding: 18px;
    }

    .faq-answer {
      padding: 0 18px 18px;
    }

    .cta-box {
      padding: 50px 20px;
      border-radius: 22px;
    }

    .cta-actions {
      flex-direction: column;
    }

    .cta-actions .btn {
      width: 100%;
    }

    .scroll-top {
      left: 14px;
      bottom: 14px;
      width: 44px;
      height: 44px;
    }
  }

  /* ==========================================
     REDUCED MOTION
     ========================================== */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  /* ==========================================
     THEME SYNC
     ========================================== */

  const syncTheme = () => {
    try {
      const saved = localStorage.getItem('theme');

      if (saved === 'dark') {
        document.documentElement.classList.add('dark-mode');
      } else if (saved === 'light') {
        document.documentElement.classList.remove('dark-mode');
      }
    } catch {}
  };

  syncTheme();

  window.addEventListener('themeChange', syncTheme);

  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') {
      syncTheme();
    }
  });

  const observer = new MutationObserver(() => {
    syncTheme();
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });

  /* ==========================================
     TYPEWRITER
     ========================================== */

  const typingElement = document.getElementById('typing-text');

  const typingWords = [
    'المستقبل الرقمي',
    'مشاريعك التقنية',
    'أفكارك البرمجية',
    'مهاراتك الرقمية'
  ];

  let wordIndex = 0;
  let charIndex = typingWords[0].length;
  let deleting = true;

  const typeEffect = () => {
    if (!typingElement) return;

    const current = typingWords[wordIndex];

    if (!deleting) {
      charIndex++;

      typingElement.textContent = current.slice(0, charIndex);

      if (charIndex >= current.length) {
        deleting = true;

        setTimeout(typeEffect, 1800);
        return;
      }

      setTimeout(typeEffect, 75);
    } else {
      charIndex--;

      typingElement.textContent = current.slice(0, charIndex);

      if (charIndex <= 0) {
        deleting = false;
        wordIndex = (wordIndex + 1) % typingWords.length;

        setTimeout(typeEffect, 350);
        return;
      }

      setTimeout(typeEffect, 40);
    }
  };

  setTimeout(typeEffect, 1500);

  /* ==========================================
     COUNTER
     ========================================== */

  const counters = document.querySelectorAll('.counter');

  const animateCounter = (element) => {
    const target = Number(element.getAttribute('data-target') || 0);

    if (!target) {
      element.textContent = '0';
      return;
    }

    const duration = 1200;
    const start = performance.now();

    const update = (now) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);

      element.textContent = Math.floor(target * eased).toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        element.textContent = target.toString();
      }
    };

    requestAnimationFrame(update);
  };

  const statsSection = document.querySelector('.stats-section');

  if (statsSection && counters.length) {
    const statsObserver = new IntersectionObserver(
      (entries, observer) => {
        if (entries[0]?.isIntersecting) {
          counters.forEach(animateCounter);
          observer.disconnect();
        }
      },
      { threshold: 0.25 }
    );

    statsObserver.observe(statsSection);
  }

  /* ==========================================
     SCROLL TOP
     ========================================== */

  const scrollTop = document.getElementById('scroll-top');

  if (scrollTop) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 500) {
          scrollTop.classList.add('visible');
        } else {
          scrollTop.classList.remove('visible');
        }
      },
      { passive: true }
    );

    scrollTop.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  /* ==========================================
     FAQ
     ========================================== */

  document.querySelectorAll('.faq-item').forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!(item instanceof HTMLDetailsElement)) return;

      if (item.open) {
        document.querySelectorAll('.faq-item').forEach((other) => {
          if (other !== item && other instanceof HTMLDetailsElement) {
            other.open = false;
          }
        });
      }
    });
  });
</script>
