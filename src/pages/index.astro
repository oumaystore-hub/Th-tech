  /* ==========================================
     REDUCED MOTION
     ========================================== */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  /* ==========================================
     THEME
     ========================================== */

  /*
   * لا يوجد MutationObserver هنا.
   * Header مسؤول عن تغيير class="dark-mode".
   * الصفحة تحتاج فقط إلى الاستماع للحدث.
   */

  window.addEventListener('themeChange', () => {
    document.documentElement.classList.toggle(
      'dark-mode',
      localStorage.getItem('theme') === 'dark'
    );
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') {
      document.documentElement.classList.toggle(
        'dark-mode',
        event.newValue === 'dark'
      );
    }
  });

  /* ==========================================
     TYPEWRITER
     ========================================== */

  const typingElement =
    document.getElementById('typing-text');

  const typingWords = [
    'المستقبل الرقمي',
    'مشاريعك التقنية',
    'أفكارك البرمجية',
    'مهاراتك الرقمية'
  ];

  let wordIndex = 0;
  let charIndex = typingWords[0].length;
  let deleting = true;
  let typingTimer = 0;

  const typeEffect = () => {
    if (!typingElement) return;

    /*
     * لا نستمر في تشغيل الحركة عندما تكون الصفحة
     * في الخلفية لتقليل استهلاك المعالج.
     */
    if (document.hidden) {
      typingTimer = window.setTimeout(typeEffect, 1000);
      return;
    }

    const current = typingWords[wordIndex];

    if (!deleting) {
      charIndex++;

      typingElement.textContent =
        current.slice(0, charIndex);

      if (charIndex >= current.length) {
        deleting = true;

        typingTimer = window.setTimeout(
          typeEffect,
          1800
        );

        return;
      }

      typingTimer = window.setTimeout(
        typeEffect,
        75
      );
    } else {
      charIndex--;

      typingElement.textContent =
        current.slice(0, charIndex);

      if (charIndex <= 0) {
        deleting = false;
        wordIndex =
          (wordIndex + 1) % typingWords.length;

        typingTimer = window.setTimeout(
          typeEffect,
          350
        );

        return;
      }

      typingTimer = window.setTimeout(
        typeEffect,
        40
      );
    }
  };

  typingTimer = window.setTimeout(
    typeEffect,
    1500
  );

  /* ==========================================
     COUNTER
     ========================================== */

  const counters =
    document.querySelectorAll('.counter');

  const animateCounter = (element) => {
    if (element.dataset.animated === 'true') return;

    element.dataset.animated = 'true';

    const target = Number(
      element.getAttribute('data-target') || 0
    );

    if (!target) {
      element.textContent = '0';
      return;
    }

    const duration = 900;
    const start = performance.now();

    const update = (now) => {
      const progress = Math.min(
        (now - start) / duration,
        1
      );

      const eased =
        1 - Math.pow(1 - progress, 3);

      element.textContent =
        Math.floor(target * eased).toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        element.textContent =
          target.toString();
      }
    };

    requestAnimationFrame(update);
  };

  const statsSection =
    document.querySelector('.stats-section');

  if (statsSection && counters.length) {
    const statsObserver =
      new IntersectionObserver(
        (entries, observer) => {
          if (entries[0]?.isIntersecting) {
            counters.forEach(animateCounter);
            observer.disconnect();
          }
        },
        {
          threshold: 0.2
        }
      );

    statsObserver.observe(statsSection);
  }

  /* ==========================================
     TOOL SEARCH
     ========================================== */

  const toolsData = [
    ...JSON.parse(
      JSON.stringify(
        {
          tools: toolSearchData
        }
      )
    ).tools
  ];

  const toolSearch =
    document.getElementById('tool-search');

  const resultsContainer =
    document.getElementById(
      'tool-search-results'
    );

  const emptyState =
    document.getElementById(
      'tool-search-empty'
    );

  const clearSearch =
    document.getElementById(
      'clear-tool-search'
    );

  const searchWrapper =
    document.querySelector(
      '.search-input-wrap'
    );

  const randomTool =
    document.getElementById(
      'random-tool'
    );

  const basePath = `${base}`;

  const normalize = (value) =>
    String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[-_]/g, ' ')
      .trim();

  const createResult = (tool) => {
    const link =
      document.createElement('a');

    link.className = 'search-result';
    link.href =
      `${basePath}/tools/${tool.slug}/`;
    link.setAttribute(
      'aria-label',
      `فتح أداة ${tool.name}`
    );

    link.innerHTML = `
      <span class="search-result-icon">
        <i class="fa-solid fa-code"></i>
      </span>

      <span class="search-result-name">
        ${tool.name}
      </span>
    `;

    return link;
  };

  const renderResults = (query = '') => {
    if (!resultsContainer) return;

    const normalizedQuery =
      normalize(query);

    resultsContainer.replaceChildren();

    if (!normalizedQuery) {
      emptyState?.setAttribute(
        'hidden',
        ''
      );

      return;
    }

    const words =
      normalizedQuery.split(/\s+/);

    const matches =
      toolsData
        .map((tool) => {
          const name =
            normalize(tool.name);

          const slug =
            normalize(tool.slug);

          let score = 0;

          if (name === normalizedQuery) {
            score += 100;
          }

          if (
            name.includes(normalizedQuery)
          ) {
            score += 50;
          }

          if (
            slug.includes(normalizedQuery)
          ) {
            score += 40;
          }

          words.forEach((word) => {
            if (word.length > 1) {
              if (name.includes(word)) {
                score += 15;
              }

              if (slug.includes(word)) {
                score += 10;
              }
            }
          });

          return {
            tool,
            score
          };
        })
        .filter((item) => item.score > 0)
        .sort(
          (a, b) =>
            b.score - a.score ||
            a.tool.name.localeCompare(
              b.tool.name
            )
        )
        .slice(0, 8);

    if (!matches.length) {
      emptyState?.removeAttribute(
        'hidden'
      );

      return;
    }

    emptyState?.setAttribute(
      'hidden',
      ''
    );

    const fragment =
      document.createDocumentFragment();

    matches.forEach(({ tool }) => {
      fragment.appendChild(
        createResult(tool)
      );
    });

    resultsContainer.appendChild(
      fragment
    );
  };

  if (toolSearch) {
    toolSearch.addEventListener(
      'input',
      () => {
        const value =
          toolSearch.value.trim();

        searchWrapper?.classList.toggle(
          'has-value',
          value.length > 0
        );

        renderResults(value);
      }
    );
  }

  if (clearSearch) {
    clearSearch.addEventListener(
      'click',
      () => {
        if (!toolSearch) return;

        toolSearch.value = '';

        searchWrapper?.classList.remove(
          'has-value'
        );

        renderResults('');

        toolSearch.focus();
      }
    );
  }

  if (randomTool) {
    randomTool.addEventListener(
      'click',
      () => {
        if (!toolsData.length) return;

        const randomIndex =
          Math.floor(
            Math.random() *
              toolsData.length
          );

        const selected =
          toolsData[randomIndex];

        if (selected?.slug) {
          window.location.href =
            `${basePath}/tools/${selected.slug}/`;
        }
      }
    );
  }

  /* ==========================================
     TOOL CARD TRACKING
     ========================================== */

  document
    .querySelectorAll('[data-tool-link]')
    .forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const slug =
            link.getAttribute(
              'data-tool-link'
            );

          if (!slug) return;

          try {
            localStorage.setItem(
              'thtech-last-tool',
              slug
            );
          } catch {}
        }
      );
    });

  /* ==========================================
     SCROLL TOP
     ========================================== */

  const scrollTop =
    document.getElementById(
      'scroll-top'
    );

  if (scrollTop) {
    let scrollTicking = false;

    const updateScrollButton = () => {
      scrollTop.classList.toggle(
        'visible',
        window.scrollY > 500
      );

      scrollTicking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (scrollTicking) return;

        scrollTicking = true;

        requestAnimationFrame(
          updateScrollButton
        );
      },
      {
        passive: true
      }
    );

    scrollTop.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    );
  }

  /* ==========================================
     FAQ
     ========================================== */

  const faqItems =
    document.querySelectorAll(
      '.faq-item'
    );

  faqItems.forEach((item) => {
    item.addEventListener(
      'toggle',
      () => {
        if (
          !(item instanceof HTMLDetailsElement)
        ) {
          return;
        }

        if (!item.open) return;

        faqItems.forEach((other) => {
          if (
            other !== item &&
            other instanceof HTMLDetailsElement
          ) {
            other.open = false;
          }
        });
      }
    );
  });

  /* ==========================================
     PAGE VISIBILITY
     ========================================== */

  document.addEventListener(
    'visibilitychange',
    () => {
      if (!document.hidden) {
        if (
          typingElement &&
          !typingTimer
        ) {
          typingTimer =
            window.setTimeout(
              typeEffect,
              500
            );
        }
      }
    }
  );
</script>
