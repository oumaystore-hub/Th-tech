  .article-badge-new, .article-badge-popular, .article-badge-updated { position: absolute; top: 0.8rem; right: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.7rem; font-weight: 700; z-index: 10; }
