  .topic-card-advanced:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .topic-card-bg { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(2,132,199,0.05), rgba(14,165,233,0.05)); opacity: 0; transition: opacity 0.3s; }
  .topic-card-advanced:hover .topic-card-bg { opacity: 1; }
  .topic-card-content { position: relative; z-index: 1; padding: 1.5rem; display: flex; flex-direction: column; }
