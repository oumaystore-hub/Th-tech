---
// ReadingProgress.astro
// شريط تقدم القراءة فقط (العداد سينقل لمنطقة الميتا)
---

<div class="reading-progress-wrapper">
  <div class="reading-progress-bar" id="progressBar"></div>
</div>

<style>
  .reading-progress-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
    pointer-events: none;
  }
  
  .reading-progress-bar {
    height: 4px;
    background: linear-gradient(90deg, #0284c7, #38bdf8, #0ea5e9);
    width: 0%;
    transition: width 0.1s ease-out;
    box-shadow: 0 0 10px rgba(2, 132, 199, 0.5);
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const progressBar = document.getElementById('progressBar');
      const article = document.querySelector('article');
      
      // حساب وقت القراءة وتخزينه في عنصر يمكن الوصول إليه
      if (article) {
        const wordCount = article.innerText.trim().split(/\s+/).length;
        const minutes = Math.ceil(wordCount / 200);
        
        // إنشاء عنصر مخزن للوقت يمكن استخدامه في أي مكان
        const timeElement = document.createElement('span');
        timeElement.id = 'calculatedReadingTime';
        timeElement.style.display = 'none';
        timeElement.textContent = minutes;
        document.body.appendChild(timeElement);
      }

      // تحديث شريط التقدم
      const updateProgress = () => {
        if (!article) return;
        
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const windowHeight = window.innerHeight;
        const scrollPos = window.scrollY;

        let progress = ((scrollPos - articleTop + windowHeight * 0.5) / articleHeight) * 100;
        progress = Math.min(100, Math.max(0, progress));
        
        if (progressBar) {
          progressBar.style.width = `${progress}%`;
        }
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    });
  }
</script>
