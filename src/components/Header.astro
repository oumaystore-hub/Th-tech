<style>
  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --primary-light: #0ea5e9;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }
  
  .site-header {
    background: var(--card);
    border-bottom: 2px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0.5rem 0;
    box-shadow: 0 2px 20px var(--shadow);
    backdrop-filter: blur(10px);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }
  
  .logo {
    flex-shrink: 0;
    margin-left: 2rem;
    transition: transform 0.3s;
  }
  
  .logo:hover {
    transform: scale(1.05);
  }
  
  .logo-img {
    height: 50px;
    width: auto;
    display: block;
  }
  
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  
  .nav-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .nav-link .icon {
    font-size: 1.2rem;
  }
  
  .nav-link:hover {
    color: var(--primary);
    background: rgba(2,132,199,0.1);
    transform: translateY(-2px);
  }
  
  .header-tools {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  
  .tool-btn {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border: none;
    color: white;
    width: 45px;
    height: 45px;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(2,132,199,0.3);
  }
  
  .tool-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 20px rgba(2,132,199,0.4);
  }
  
  .tool-btn:active {
    transform: scale(0.95);
  }
  
  .hamburger {
    display: none;
  }
  
  /* لوحة البحث المتقدمة */
  .search-panel {
    display: none;
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    background: var(--card);
    padding: 2rem 1.5rem;
    border-bottom: 2px solid var(--border);
    z-index: 999;
    box-shadow: 0 10px 40px var(--shadow);
    animation: slideDown 0.3s ease;
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .search-panel.active {
    display: block !important;
  }
  
  .search-container {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg);
    padding: 0.8rem 1.5rem;
    border-radius: 16px;
    border: 2px solid var(--border);
    transition: all 0.3s;
  }
  
  .search-container:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(2,132,199,0.1);
    transform: translateY(-2px);
  }
  
  .search-icon-wrapper {
    color: var(--primary);
    flex-shrink: 0;
  }
  
  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 1.05rem;
    outline: none;
  }
  
  .search-input::placeholder {
    color: var(--text-sec);
  }
  
  .close-btn {
    background: #ef4444;
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    flex-shrink: 0;
  }
  
  .close-btn:hover {
    background: #dc2626;
    transform: rotate(90deg) scale(1.1);
  }

  /* صندوق نتائج البحث */
  .search-results-box {
    max-width: 700px;
    margin: 15px auto 0;
    background: var(--card);
    border-radius: 12px;
    max-height: 400px;
    overflow-y: auto;
    box-shadow: 0 4px 20px var(--shadow);
    border: 1px solid var(--border);
  }

  .search-result-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 20px;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    transition: all 0.3s;
    background: var(--card);
  }

  .search-result-link:hover {
    background: linear-gradient(135deg, rgba(2,132,199,0.1), rgba(56,189,248,0.1));
    color: var(--primary);
    padding-right: 25px;
    transform: translateX(5px);
  }

  .search-result-link:last-child {
    border-bottom: none;
  }

  .result-title {
    font-weight: 600;
    font-size: 1rem;
  }

  .result-category {
    font-size: 0.85rem;
    color: var(--text-sec);
    background: var(--bg);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .result-highlight {
    background: linear-gradient(120deg, rgba(2,132,199,0.3), rgba(56,189,248,0.3));
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .no-results {
    padding: 40px 20px;
    text-align: center;
    color: var(--text-sec);
    font-size: 1.05rem;
  }

  .search-stats {
    max-width: 700px;
    margin: 10px auto 0;
    text-align: center;
    color: var(--text-sec);
    font-size: 0.9rem;
    padding: 0.5rem;
  }

  /* ✅ القائمة المتنقلة - مع دعم التمرير */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    background: var(--card);
    padding: 1rem 1.5rem;
    border-bottom: 2px solid var(--border);
    flex-direction: column;
    z-index: 999;
    box-shadow: 0 10px 40px var(--shadow);
    animation: slideDown 0.3s ease;
    gap: 0.5rem;
    
    /* ✅ إضافة التمرير للقائمة المتنقلة */
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  /* ✅ تحسين شريط التمرير للقائمة المتنقلة */
  .mobile-menu::-webkit-scrollbar {
    width: 6px;
  }
  .mobile-menu::-webkit-scrollbar-track {
    background: rgba(2,132,199,0.1);
    border-radius: 3px;
  }
  .mobile-menu::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 3px;
  }
  .mobile-menu::-webkit-scrollbar-thumb:hover {
    background: var(--primary-light);
  }
  
  .mobile-menu.active {
    display: flex;
  }
  
  .mobile-link {
    color: var(--text);
    text-decoration: none;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.05rem;
    transition: all 0.3s;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .mobile-link:hover {
    background: var(--bg);
    color: var(--primary);
    padding-right: 2rem;
  }

  /* ✅ قائمة التصنيفات المنبثقة */
  .mobile-dropdown {
    width: 100%;
    margin: 0.25rem 0;
  }
  
  .mobile-dropdown-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
    padding: 1rem 1.5rem;
    cursor: pointer;
    border-radius: 10px;
    transition: background 0.2s;
    border-bottom: 1px solid var(--border);
  }
  
  .mobile-dropdown-toggle:hover,
  .mobile-dropdown-toggle[aria-expanded="true"] {
    background: rgba(2,132,199,0.1);
    color: var(--primary);
  }
  
  .dropdown-text {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .dropdown-text .icon {
    font-size: 1.2rem;
  }
  
  .dropdown-chevron {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: var(--text-sec);
  }
  
  .mobile-dropdown-toggle[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
    color: var(--primary);
  }
  
  /* ✅ القائمة الفرعية - مع إصلاح ظهور جميع التصنيفات */
  .dropdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
    opacity: 0;
    background: rgba(2,132,199,0.03);
    border-radius: 0 0 10px 10px;
  }
  
  .dropdown-list.open {
    max-height: 60vh;
    opacity: 1;
    overflow-y: auto;
  }

  /* ✅ تحسين شريط التمرير */
  .dropdown-list.open::-webkit-scrollbar {
    width: 6px;
  }

  .dropdown-list.open::-webkit-scrollbar-track {
    background: rgba(2,132,199,0.1);
    border-radius: 3px;
  }

  .dropdown-list.open::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 3px;
  }

  .dropdown-list.open::-webkit-scrollbar-thumb:hover {
    background: var(--primary-light);
  }
  
  .dropdown-list li a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1.5rem 0.7rem 2.5rem;
    color: var(--text-sec);
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--border);
    transition: all 0.2s;
  }
  
  .dropdown-list li:last-child a { border-bottom: none; }
  
  .dropdown-list li a:hover {
    background: rgba(2,132,199,0.1);
    color: var(--primary);
    padding-right: 1.8rem;
  }
  
  /* ✅ تنسيق الأيقونات */
  .cat-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--primary);
  }
  
  .dropdown-list li a:hover .cat-icon {
    color: var(--primary-light);
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .container { height: 70px; padding: 0 1.5rem; }
    .tool-btn { width: 40px; height: 40px; }
    .search-panel, .mobile-menu { 
      top: 70px; 
      max-height: calc(100vh - 70px); /* ✅ تحديث الارتفاع للجوال */
    }
    .search-container { padding: 0.6rem 1rem; }
    .search-input { font-size: 0.95rem; }
  }
</style>

<script>
  // قاعدة بيانات شاملة للمحتوى - مع روابط صحيحة
  const siteContent = {
    articles: [
      { title: "الذكاء الاصطناعي", url: "/Th-tech/ai/", category: "تصنيف", keywords: ["ai", "machine learning", "تعلم آلي"] },
      { title: "الشبكات", url: "/Th-tech/networks/", category: "تصنيف", keywords: ["network", "router", "switch"] },
      { title: "البرمجة", url: "/Th-tech/programming/", category: "تصنيف", keywords: ["code", "software", "development"] },
      { title: "الأمن السيبراني", url: "/Th-tech/security/", category: "تصنيف", keywords: ["security", "cyber", "hacking"] },
      { title: "علم البيانات", url: "/Th-tech/data-science/", category: "تصنيف", keywords: ["data", "analytics", "statistics"] },
      { title: "DevOps", url: "/Th-tech/devops/", category: "تصنيف", keywords: ["devops", "ci/cd", "automation"] },
      { title: "IoT", url: "/Th-tech/iot/", category: "تصنيف", keywords: ["internet of things", "smart devices"] },
      { title: "Cloud", url: "/Th-tech/cloud/", category: "تصنيف", keywords: ["cloud computing", "aws", "azure"] },
      { title: "Blockchain", url: "/Th-tech/blockchain/", category: "تصنيف", keywords: ["blockchain", "crypto", "bitcoin"] },
      { title: "Mobile", url: "/Th-tech/mobile/", category: "تصنيف", keywords: ["mobile", "android", "ios"] },
      { title: "دليل الشبكات المتقدم", url: "/Th-tech/networks/advanced-network-guide/", category: "مقال", keywords: ["bgp", "ospf", "sd-wan"] },
      { title: "دليل البرمجة المتقدم", url: "/Th-tech/programming/advanced-programming-guide/", category: "مقال", keywords: ["solid", "design patterns", "clean code"] },
    ],
    
    // كلمات مفتاحية عامة
    generalKeywords: [
      { word: "tutorial", title: "دروس تعليمية", url: "/Th-tech/articles/" },
      { word: "guide", title: "أدلة شاملة", url: "/Th-tech/articles/" },
      { word: "beginner", title: "للمبتدئين", url: "/Th-tech/category/" },
      { word: "advanced", title: "مستوى متقدم", url: "/Th-tech/category/" },
    ]
  };

  // تبديل الوضع الليلي
  function toggleTheme() {
    const html = document.documentElement;
    const btn = document.getElementById('theme-btn');
    const moonIcon = document.getElementById('moon-icon');
    const sunIcon = document.getElementById('sun-icon');
    
    html.classList.toggle('dark-mode');
    
    if (html.classList.contains('dark-mode')) {
      localStorage.setItem('theme', 'dark');
      moonIcon.style.display = 'none';
      sunIcon.style.display = 'block';
      btn.setAttribute('title', 'الوضع النهاري');
    } else {
      localStorage.setItem('theme', 'light');
      moonIcon.style.display = 'block';
      sunIcon.style.display = 'none';
      btn.setAttribute('title', 'الوضع الليلي');
    }
  }

  // تمييز النص المطابق
  function highlightText(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<span class="result-highlight">$1</span>');
  }

  // البحث المتقدم
  function performAdvancedSearch(query) {
    const results = [];
    const queryLower = query.toLowerCase().trim();
    
    // البحث في المقالات
    siteContent.articles.forEach(article => {
      const titleMatch = article.title.toLowerCase().includes(queryLower);
      const categoryMatch = article.category.toLowerCase().includes(queryLower);
      const keywordMatch = article.keywords.some(k => k.toLowerCase().includes(queryLower));
      
      if (titleMatch || categoryMatch || keywordMatch) {
        results.push({
          ...article,
          matchType: titleMatch ? 'عنوان' : (categoryMatch ? 'تصنيف' : 'كلمة مفتاحية')
        });
      }
    });
    
    // البحث في الكلمات العامة
    siteContent.generalKeywords.forEach(item => {
      if (item.word.toLowerCase().includes(queryLower) || item.title.includes(queryLower)) {
        results.push({
          title: item.title,
          url: item.url,
          category: 'كلمة مفتاحية',
          matchType: 'عام'
        });
      }
    });
    
    return results;
  }

  // التهيئة عند التحميل
  document.addEventListener('DOMContentLoaded', () => {
    // الوضع المحفوظ
    const savedTheme = localStorage.getItem('theme');
    const themeBtn = document.getElementById('theme-btn');
    const moonIcon = document.getElementById('moon-icon');
    const sunIcon = document.getElementById('sun-icon');
    
    if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark-mode');
      moonIcon.style.display = 'none';
      sunIcon.style.display = 'block';
      themeBtn.setAttribute('title', 'الوضع النهاري');
    }

    // أزرار التحكم
    themeBtn.addEventListener('click', toggleTheme);

    // القائمة المتنقلة
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('active');
      menuBtn.innerHTML = mobileMenu.classList.contains('active') 
        ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>'
        : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';
    });

    // ✅ منطق قائمة التصنيفات المنبثقة
    const categoriesDropdown = document.getElementById('categoriesDropdown');
    if (categoriesDropdown) {
      const toggleBtn = categoriesDropdown.querySelector('.mobile-dropdown-toggle');
      const dropdownList = categoriesDropdown.querySelector('.dropdown-list');
      
      if (toggleBtn && dropdownList) {
        toggleBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          
          toggleBtn.setAttribute('aria-expanded', !isExpanded);
          dropdownList.classList.toggle('open');
        });

        // إغلاق القائمة تلقائياً عند اختيار تصنيف
        dropdownList.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            toggleBtn.setAttribute('aria-expanded', 'false');
            dropdownList.classList.remove('open');
          });
        });
      }
    }

    // البحث المتقدم
    const searchBtn = document.getElementById('search-btn');
    const searchPanel = document.getElementById('search-panel');
    const closeSearch = document.getElementById('close-search');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    const searchStats = document.getElementById('searchStats');
    
    searchBtn.addEventListener('click', () => {
      searchPanel.classList.add('active');
      setTimeout(() => searchInput.focus(), 100);
    });
    
    closeSearch.addEventListener('click', () => {
      searchPanel.classList.remove('active');
      searchInput.value = '';
      searchResults.innerHTML = '';
      searchStats.textContent = '';
    });

    // البحث عند الكتابة
    let searchTimeout;
    searchInput.addEventListener('input', function(e) {
      clearTimeout(searchTimeout);
      const query = e.target.value.trim();
      
      if (query.length < 2) {
        searchResults.innerHTML = '';
        searchStats.textContent = '';
        return;
      }
      
      // تأخير بسيط لتحسين الأداء
      searchTimeout = setTimeout(() => {
        const results = performAdvancedSearch(query);
        
        if (results.length > 0) {
          searchResults.innerHTML = results.map(r => `
            <a href="${r.url}" class="search-result-link">
              <span class="result-title">${highlightText(r.title, query)}</span>
              <span class="result-category">${r.category}</span>
            </a>
          `).join('');
          
          searchStats.textContent = `🔍 تم العثور على ${results.length} نتيجة لـ "${query}"`;
        } else {
          searchResults.innerHTML = '<div class="no-results">😕 لم يتم العثور على نتائج. جرب كلمات أخرى</div>';
          searchStats.textContent = '';
        }
      }, 300);
    });

    // إغلاق عند الضغط على Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchPanel.classList.remove('active');
        mobileMenu.classList.remove('active');
        if (categoriesDropdown) {
          const toggleBtn = categoriesDropdown.querySelector('.mobile-dropdown-toggle');
          const dropdownList = categoriesDropdown.querySelector('.dropdown-list');
          if (toggleBtn && dropdownList) {
            toggleBtn.setAttribute('aria-expanded', 'false');
            dropdownList.classList.remove('open');
          }
        }
        searchInput.value = '';
        searchResults.innerHTML = '';
      }
    });

    // إغلاق عند النقر خارج اللوحة
    document.addEventListener('click', (e) => {
      if (!searchPanel.contains(e.target) && !searchBtn.contains(e.target)) {
        searchPanel.classList.remove('active');
      }
    });
  });
</script>
