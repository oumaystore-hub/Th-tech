</header>

<style>
  /* ✅ نفس الـ CSS الأصلي تماماً */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --text-sec: #64748b;
    --primary: #0284c7;
    --primary-light: #38bdf8;
    --border: rgba(2,132,199,0.2);
    --shadow: rgba(0,0,0,0.1);
    --font-main: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
  }

  html.dark-mode {
    --bg: #0b1120;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-sec: #94a3b8;
    --primary: #38bdf8;
    --primary-light: #0ea5e9;
    --border: rgba(56,189,248,0.2);
    --shadow: rgba(0,0,0,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
  }
  
  .site-header {
    background: var(--card);
    border-bottom: 2px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0.5rem 0;
    box-shadow: 0 2px 20px var(--shadow);
    backdrop-filter: blur(10px);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }
  
  .logo {
    flex-shrink: 0;
    margin-left: 1.5rem;
    transition: transform 0.3s ease;
  }
  .logo:hover { transform: scale(1.05); }
  .logo-img { height: 48px; width: auto; display: block; }
  
  .nav-links {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  
  .nav-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.3s ease;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  
  .nav-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    stroke-width: 2.2;
  }
  
  .nav-link:hover {
    color: var(--primary);
    background: rgba(2,132,199,0.1);
    transform: translateY(-2px);
  }
  
  .header-tools {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-right: 0.5rem;
  }
  
  .tool-btn {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border: none;
    color: white;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 3px 10px rgba(2,132,199,0.3);
    flex-shrink: 0;
  }
  
  .tool-btn svg {
    width: 20px;
    height: 20px;
    stroke-width: 2.2;
  }
  
  .tool-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 20px rgba(2,132,199,0.4);
  }
  
  .tool-btn:active { transform: scale(0.95); }
  
  .icon-sun { display: none; }
  html.dark-mode .icon-moon { display: none; }
  html.dark-mode .icon-sun { display: block; }
  
  .hamburger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 3px 10px rgba(2,132,199,0.3);
    padding: 10px;
  }
  
  .hamburger-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 20px rgba(2,132,199,0.4);
  }
  
  .hamburger-btn:active { transform: scale(0.95); }
  
  .hamburger-line {
    width: 22px;
    height: 2.5px;
    background: white;
    border-radius: 3px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }
  
  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scale(0.8);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }
  
  .search-panel {
    display: none;
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    background: var(--card);
    padding: 2rem 1.5rem;
    border-bottom: 2px solid var(--border);
    z-index: 999;
    box-shadow: 0 10px 40px var(--shadow);
    animation: slideDown 0.3s ease;
  }
  
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .search-panel.active { display: block !important; }
  
  .search-container {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg);
    padding: 0.8rem 1.5rem;
    border-radius: 16px;
    border: 2px solid var(--border);
    transition: all 0.3s;
  }
  
  .search-container:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(2,132,199,0.1);
    transform: translateY(-2px);
  }
  
  .search-icon-wrapper { color: var(--primary); flex-shrink: 0; }
  .search-icon-wrapper svg { width: 22px; height: 22px; }
  
  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 1.05rem;
    font-family: var(--font-main);
    outline: none;
  }
  
  .search-input::placeholder { color: var(--text-sec); }
  
  .close-btn {
    background: #ef4444;
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    flex-shrink: 0;
  }
  
  .close-btn:hover {
    background: #dc2626;
    transform: rotate(90deg) scale(1.1);
  }
  
  .close-btn svg { width: 20px; height: 20px; }

  .search-results-box {
    max-width: 700px;
    margin: 15px auto 0;
    background: var(--card);
    border-radius: 12px;
    max-height: 400px;
    overflow-y: auto;
    box-shadow: 0 4px 20px var(--shadow);
    border: 1px solid var(--border);
  }

  .search-result-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 20px;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    transition: all 0.3s;
    background: var(--card);
    font-family: var(--font-main);
  }

  .search-result-link:hover {
    background: linear-gradient(135deg, rgba(2,132,199,0.1), rgba(56,189,248,0.1));
    color: var(--primary);
    padding-right: 25px;
    transform: translateX(5px);
  }

  .search-result-link:last-child { border-bottom: none; }
  .result-title { font-weight: 600; font-size: 1rem; }
  .result-category {
    font-size: 0.85rem;
    color: var(--text-sec);
    background: var(--bg);
    padding: 4px 10px;
    border-radius: 6px;
    font-family: var(--font-main);
  }
  .result-highlight {
    background: linear-gradient(120deg, rgba(2,132,199,0.3), rgba(56,189,248,0.3));
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }
  .no-results {
    padding: 40px 20px;
    text-align: center;
    color: var(--text-sec);
    font-size: 1.05rem;
    font-family: var(--font-main);
  }
  .search-stats {
    max-width: 700px;
    margin: 10px auto 0;
    text-align: center;
    color: var(--text-sec);
    font-size: 0.9rem;
    padding: 0.5rem;
    font-family: var(--font-main);
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    background: var(--card);
    padding: 0.8rem 1.2rem;
    border-bottom: 2px solid var(--border);
    flex-direction: column;
    z-index: 999;
    box-shadow: 0 10px 40px var(--shadow);
    animation: slideDown 0.3s ease;
    gap: 0.2rem;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    font-family: var(--font-main);
  }

  .mobile-menu::-webkit-scrollbar { width: 6px; }
  .mobile-menu::-webkit-scrollbar-track { background: rgba(2,132,199,0.1); border-radius: 3px; }
  .mobile-menu::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 3px; }
  .mobile-menu::-webkit-scrollbar-thumb:hover { background: var(--primary-light); }
  
  .mobile-menu.active { display: flex; }
  
  .mobile-link {
    color: var(--text);
    text-decoration: none;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  
  .mobile-link-primary {
    background: linear-gradient(135deg, rgba(2,132,199,0.1), rgba(56,189,248,0.1));
    border: 1.5px solid var(--border);
    margin: 0.3rem 0;
  }
  
  .mobile-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    stroke-width: 2.2;
  }
  
  .mobile-link:hover {
    background: var(--bg);
    color: var(--primary);
    padding-right: 1.5rem;
  }
  
  .mobile-link-primary:hover {
    background: linear-gradient(135deg, rgba(2,132,199,0.2), rgba(56,189,248,0.2));
    transform: translateY(-2px);
  }

  .mobile-dropdown { width: 100%; margin: 0.1rem 0; }
  
  .mobile-dropdown-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.7rem 1rem;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-main);
  }
  
  .mobile-dropdown-toggle:hover,
  .mobile-dropdown-toggle[aria-expanded="true"] {
    background: rgba(2,132,199,0.1);
    color: var(--primary);
  }
  
  .dropdown-text { display: flex; align-items: center; gap: 0.8rem; }
  .dropdown-icon { width: 19px; height: 19px; stroke-width: 2.2; }
  
  .dropdown-chevron {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
    color: var(--text-sec);
    stroke-width: 2.2;
  }
  
  .mobile-dropdown-toggle[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
    color: var(--primary);
  }
  
  .dropdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
    opacity: 0;
    background: rgba(2,132,199,0.03);
    border-radius: 0 0 8px 8px;
  }
  
  .dropdown-list.open {
    max-height: 60vh;
    opacity: 1;
    overflow-y: auto;
  }

  .dropdown-list.open::-webkit-scrollbar { width: 6px; }
  .dropdown-list.open::-webkit-scrollbar-track { background: rgba(2,132,199,0.1); border-radius: 3px; }
  .dropdown-list.open::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 3px; }
  .dropdown-list.open::-webkit-scrollbar-thumb:hover { background: var(--primary-light); }
  
  .dropdown-list li a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1.2rem 0.6rem 2.2rem;
    color: var(--text-sec);
    text-decoration: none;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    transition: all 0.2s;
    font-family: var(--font-main);
  }
  
  .dropdown-list li:last-child a { border-bottom: none; }
  
  .dropdown-list li a:hover {
    background: rgba(2,132,199,0.1);
    color: var(--primary);
    padding-right: 1.5rem;
  }
  
  .cat-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--primary);
    stroke-width: 2.2;
  }
  
  .dropdown-list li a:hover .cat-icon { color: var(--primary-light); }

  .mobile-social-section {
    margin: 0.6rem 0 0.3rem;
    padding: 0.9rem;
    background: linear-gradient(135deg, rgba(2,132,199,0.05), rgba(56,189,248,0.05));
    border-radius: 10px;
    border: 1.5px solid var(--border);
  }
  
  .mobile-social-title {
    text-align: center;
    color: var(--text);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.7rem;
  }
  
  .mobile-social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
  }
  
  .mobile-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--card);
    color: var(--text-sec);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    border: 1.5px solid var(--border);
  }
  
  .mobile-social-link svg {
    width: 18px;
    height: 18px;
