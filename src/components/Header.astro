---
---
<header class="site-header">
  <div class="container">
    <a href="/Th-tech/" class="logo">
      <img src="/Th-tech/logo1.png" alt="Th-tech" class="logo-img" />
    </a>
    
    <nav class="nav-links">
      <a href="/Th-tech/" class="nav-link">
        <span class="icon">🏠</span>
        <span>الرئيسية</span>
      </a>
      <a href="/Th-tech/articles/" class="nav-link">
        <span class="icon">📚</span>
        <span>المقالات</span>
      </a>
      <a href="/Th-tech/learning-paths/" class="nav-link">
        <span class="icon">🎯</span>
        <span>مسارات التعلم</span>
